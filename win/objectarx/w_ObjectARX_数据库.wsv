    }

    方法 置法向 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setNormal。 实测: 置 (0,1,0) 码=0 回读 0/1/0; 复位 (0,0,1) 后与 置文字方向 同轮。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 向量X <类型 = 小数>
    参数 向量Y <类型 = 小数>
    参数 向量Z <类型 = 小数>
    {
        @ (arx_db_mtext_set_normal (@<对象标识>, @<向量X>, @<向量Y>, @<向量Z>) != 0)
    }

    方法 取文字方向 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::direction, 结果写入 ARX向量3D。 实测: 新建读到 1/0/0 码=0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 结果向量 <类型 = 变整数>
    {
        @ (arx_db_mtext_direction (@<对象标识>, @<结果向量>) != 0)
    }

    方法 置文字方向 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setDirection。 实测: 置 (1,1,0) 码=0, 回读 0.707106781186547/0.707106781186547/0 且 长度=1 —— 底层单位化后才存。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 向量X <类型 = 小数>
    参数 向量Y <类型 = 小数>
    参数 向量Z <类型 = 小数>
    {
        @ (arx_db_mtext_set_direction (@<对象标识>, @<向量X>, @<向量Y>, @<向量Z>) != 0)
    }

    方法 取旋转角 <公开 静态 类型 = 小数 注释 = "对应 AcDbMText::rotation, 单位为弧度; 失败回 NaN。 实测: 新建缺省 0 自等=真 码=0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_rotation (@<对象标识>)
    }

    方法 置旋转角 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setRotation。 实测: 置 0.6 码=0 回读 0.6。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 小数>
    {
        @ (arx_db_mtext_set_rotation (@<对象标识>, @<值>) != 0)
    }

    方法 取文字宽度 <公开 静态 类型 = 小数 注释 = "对应 AcDbMText::width, 即换行宽度框; 失败回 NaN。 实测: 新建给的 30 读到 30; 空标识 NAN 码=-1; 单行文字标识当多行文字用回 NAN 码=46。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_width (@<对象标识>)
    }

    方法 置文字宽度 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setWidth。 实测: 置 55.0 码=0 回读 55。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 小数>
    {
        @ (arx_db_mtext_set_width (@<对象标识>, @<值>) != 0)
    }

    方法 取字高 <公开 静态 类型 = 小数 注释 = "对应 AcDbMText::textHeight; 失败回 NaN。 实测: 新建给的 3 读到 3。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_text_height (@<对象标识>)
    }

    方法 置字高 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setTextHeight。 实测: 置 3.75 码=0 回读 3.75。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 小数>
    {
        @ (arx_db_mtext_set_text_height (@<对象标识>, @<值>) != 0)
    }

    方法 取上伸 <公开 静态 类型 = 小数 注释 = "对应 AcDbMText::ascent, 最近一次排版的首行上伸量; 失败回 NaN。 实测: 3.75 字高下读到 4.39944134078212 自等=真 —— 随最近一次排版走, 不是字高的整数倍。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_ascent (@<对象标识>)
    }

    方法 取下伸 <公开 静态 类型 = 小数 注释 = "对应 AcDbMText::descent; 失败回 NaN。 实测: 同轮 0.74181446111869。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_descent (@<对象标识>)
    }

    方法 取实际宽度 <公开 静态 类型 = 小数 注释 = "对应 AcDbMText::actualWidth, 排版出来的实际宽度而非 取文字宽度 那个框宽; 失败回 NaN。 实测: 同轮 30.6903404543965, 比 文字宽度 55 小 —— 实排宽度而非换行框。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_actual_width (@<对象标识>)
    }

    方法 取实际高度 <公开 静态 类型 = 小数 注释 = "对应 AcDbMText::actualHeight; 失败回 NaN。 实测: 同轮 5.14125580190081, 约 上伸+下伸。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_actual_height (@<对象标识>)
    }

    方法 取附着点 <公开 静态 类型 = 整数 注释 = "对应 AcDbMText::attachmentPoint, 回 AcDbMText::AttachmentPoint 原值; dbmtext.h 150 行那张表里 1..9 才是真分档, 10..24 全标着 Reserved for future use, 失败回 -1。 实测: 新建读到 1(kTopLeft) 码=0。; 值表 10..24 在 SDK 里是 Reserved for future use, 实测写不进: 见 置附着点 的 码=3; 能落盘的只有 1..9。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_attachment (@<对象标识>)
    }

    方法 置附着点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setAttachment, 只改附着点不动插入点; 桥放行 1..24 但库只认 1..9 —— 10..24 由库拒(码=3 eInvalidInput), 0 与 25 由桥自拒(码=-3), 两种越界都不改原值。 实测: 置 3 码=0 回读 3 且插入点不动 (回读仍 45.5/-6.25/2)。; 桥放行 1..24 但 acdb 只认 1..9: 置 24 由库拒 成=假 码=3(eInvalidInput) 且原值不动(回读仍是上一轮的 3); 置 25 才由桥自拒 码=-3; 置 1 复位码=0 —— 两种越界的区别只在 取最后错误 是 3 还是 -3。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 附着点 <类型 = 整数>
    {
        @ (arx_db_mtext_set_attachment (@<对象标识>, @<附着点>) != 0)
    }

    方法 置附着点并移插入点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setAttachmentMovingLocation, 改附着点的同时把插入点搬过去(实测 5 档把 45.5/-6.25/2 搬成 24.2547562861548/-23.8992987776983/2); 越界口径与 置附着点 相同。 实测: 置 5(kMiddleCenter) 码=0 回读 5 而插入点被搬走: 45.5/-6.25/2 → 24.2547562861548/-23.8992987776983/2; 置 0 越界 成=假 码=-3 附着点仍 5。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 附着点 <类型 = 整数>
    {
        @ (arx_db_mtext_set_attachment_moving_location (@<对象标识>, @<附着点>) != 0)
    }

    方法 取文字流向 <公开 静态 类型 = 整数 注释 = "对应 AcDbMText::flowDirection, 回 AcDbMText::FlowDirection 原值 1 kLtoR / 2 kRtoL / 3 kTtoB / 4 kBtoT / 5 kByStyle, 新建读到 5; 失败回 -1。 实测: 新建读到 5(kByStyle) 码=0; 值域见 SDK dbmtext.h 1..5。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_flow_direction (@<对象标识>)
    }

    方法 置文字流向 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setFlowDirection; 桥放行 1..5, 但 2(kRtoL)与 4(kBtoT)在 SDK 里注明 not currently supported, 由库拒 码=3; 0 与 6 由桥自拒 码=-3 —— 能落盘的只有 1、3、5。 实测: 置 2(kRtoL, SDK 注明 not currently supported)被库拒: 码=3(eInvalidInput) 且回读仍 5; 置 6 由桥自拒 成=假 码=-3; 置 1 复位码=0。; 置 3(kTtoB) 成=真 码=0 回读 3 —— 1 与 3 与 5 三档可用, 2/4 由库拒(码=3), 0 与 6 由桥自拒(码=-3)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 整数>
    {
        @ (arx_db_mtext_set_flow_direction (@<对象标识>, @<值>) != 0)
    }

    方法 取行距样式 <公开 静态 类型 = 整数 注释 = "对应 AcDbMText::lineSpacingStyle, 回 AcDb::LineSpacingStyle 原值(acdb.h 408 行只有两档): 1 kAtLeast / 2 kExactly, 新建读到 1; 失败回 -1。 实测: 新建读到 1(kAtLeast) 码=0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_mtext_line_spacing_style (@<对象标识>)
    }

