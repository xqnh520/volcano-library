    {
        @ arx_db_polyline_vertex_count(@<对象标识>)
    }

    方法 取顶点二维 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbPolyline::getPointAt(index, AcGePoint2d&), 结果写入调用方已创建好的 ARX点2D。实测: 下标越界返回假且 取最后错误 = 24(eInvalidIndex), 出参保持调用前的 0,0 不被改写。" @嵌入式方法 = "">
