    }
    方法 取透明度对象尺寸 <公开 静态 类型 = 整数 注释 = "返回 sizeof(AcCmTransparency)。实测 x64 = 4, 一个 32 位联合: alpha 在低字节、方法在高字节, 所以本包用移位取方法这一手是依赖这个布局的, 换位数要重测。" @嵌入式方法 = "">
    {
        @ arx_db_sizeof_transparency ()
    }

    方法 取实体颜色对象尺寸 <公开 静态 类型 = 整数 注释 = "返回 sizeof(AcCmEntityColor)。实测 x64 = 4, 与 取透明度对象尺寸 同宽。" @嵌入式方法 = "">
    {
        @ arx_db_sizeof_entity_color ()
    }


    方法 取图层名到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_layer_name 的 字节集 缓冲档, 对应 AcDbLayerTableRecord::name。实测: 0 图层把 ASCII 0 与结束零字符写进 64 字节缓冲, 火山侧 取字节集长度 仍是 64 而 UTF8到文本 得长度 1 的 0, 即结束零字符就是读出契约。" @嵌入式方法 = "">
    参数 图层标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_layer_name(@<图层标识>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 取块记录名到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_btr_name_into 的 字节集 缓冲档, 对应 AcDbBlockTableRecord::name。实测: 模型空间写出 *Model_Space 共 12 字符加尾零, 13 字节缓冲为真, 12 字节缓冲为假。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_btr_name_into(@<块记录>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 取实体类型名到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_entity_type_name 的 字节集 缓冲档。实测: 新建直线得 AcDbLine; 已擦除实体照样返回真并写出 AcDbLine, 这条通道不走 eWasErased。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_entity_type_name(@<对象标识>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 取句柄文本到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_entity_handle_text 的 字节集 缓冲档。实测: 句柄数值 722 的直线写出 2D2, 即 取句柄数值 的十六进制文本; 16 字节缓冲够用。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_entity_handle_text(@<对象标识>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 取实体图层名到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_entity_get_layer 的 字节集 缓冲档。实测: 新建直线得 0 图层名。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_entity_get_layer(@<对象标识>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 图层是否存在自字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_layer_exists 的 字节集 入参档。实测: 文本到UTF8 的含尾零档与不含尾零档两档都为真(桥按 C 字符串读); 名字不存在时返回假且 取最后错误 = 0, 不是哨兵值。" @嵌入式方法 = "">
    参数 名称字节 <类型 = 字节集类>
    {
        @ (arx_db_layer_exists((const char*)@<名称字节>.GetPtr()) != 0)
    }

    方法 建图层自字节集 <公开 静态 类型 = 变整数 注释 = "arx_db_add_layer 的 字节集 入参档。实测: 小写名 cadarx_probe_up 建成功且 取图层名到字节集 逐字读回, AutoCAD 不折叠大小写; 中文名 火山探针层 同样建成功并逐字读回; bad<name> 与空名返回 0 且 取最后错误 = 3(eInvalidInput); 同名两次返回同一标识且 取图层数 只加 1。" @嵌入式方法 = "">
    参数 名称字节 <类型 = 字节集类>
    {
        @ arx_db_add_layer((const char*)@<名称字节>.GetPtr())
    }

    方法 置实体图层名自字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_entity_set_layer 的 字节集 入参档。实测: 置成已存在的中文名返回真且 取实体图层名 逐字读回; 不存在的名字与空名都返回假且 取最后错误 = 22(eKeyNotFound)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 名称字节 <类型 = 字节集类>
    {
        @ (arx_db_entity_set_layer(@<对象标识>, (const char*)@<名称字节>.GetPtr()) != 0)
    }

    方法 取文本通道缓冲不足错误码 <公开 静态 类型 = 逻辑型 注释 = "把 缓冲尺寸 传成 1 来专门量 缓冲不足 那一档。实测: 返回假且 取最后错误 = -4, 用完的新缓冲首字节仍是 0。" @嵌入式方法 = "">
    参数 图层标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    {
        @ (arx_db_layer_name(@<图层标识>, (char*)@<缓冲>.GetPtr(), 1) != 0)
    }

    方法 注册命令自字节集 <公开 静态 类型 = 整数 注释 = "arx_cmd_register 的 字节集 入参档。处理函数地址 必须是零参数无返回值 静态方法 的 取静态方法地址 结果。" @嵌入式方法 = "">
    参数 组名字节 <类型 = 字节集类>
    参数 全局名字节 <类型 = 字节集类>
    参数 本地名字节 <类型 = 字节集类>
    参数 标志位 <类型 = 整数>
    参数 处理函数地址 <类型 = 变整数>
    {
        @ arx_cmd_register ((const char*)@<组名字节>.GetPtr(), (const char*)@<全局名字节>.GetPtr(), (const char*)@<本地名字节>.GetPtr(), @<标志位>, (intptr_t)@<处理函数地址>)
    }

    方法 注销命令自字节集 <公开 静态 类型 = 整数 注释 = "arx_cmd_remove 的 字节集 入参档: 按 组名 + 全局名 摘一条。" @嵌入式方法 = "">
    参数 组名字节 <类型 = 字节集类>
    参数 全局名字节 <类型 = 字节集类>
    {
        @ arx_cmd_remove ((const char*)@<组名字节>.GetPtr(), (const char*)@<全局名字节>.GetPtr())
    }

    方法 清除命令组自字节集 <公开 静态 类型 = 整数 注释 = "arx_cmd_clear_group 的 字节集 入参档: 整组摘掉。" @嵌入式方法 = "">
    参数 组名字节 <类型 = 字节集类>
    {
        @ arx_cmd_clear_group ((const char*)@<组名字节>.GetPtr())
    }

    方法 查询命令自字节集 <公开 静态 类型 = 变整数 注释 = "arx_cmd_lookup 的 字节集 入参档: 全局档传真按 globalName 查, 传假按 localName 查。" @嵌入式方法 = "">
    参数 名字字节 <类型 = 字节集类>
    参数 全局档 <类型 = 整数>
    {
        @ arx_cmd_lookup ((const char*)@<名字字节>.GetPtr(), @<全局档>)
    }

    方法 取命令处理函数地址自字节集 <公开 静态 类型 = 变整数 注释 = "arx_cmd_function_addr 的 字节集 入参档: 读命令栈里存着的处理函数地址。" @嵌入式方法 = "">
    参数 名字字节 <类型 = 字节集类>
    {
        @ arx_cmd_function_addr ((const char*)@<名字字节>.GetPtr())
    }

    方法 取命令标志位自字节集 <公开 静态 类型 = 整数 注释 = "arx_cmd_flags_of 的 字节集 入参档: 查不到回 -1, 因为模态档的合法值就是 0。" @嵌入式方法 = "">
    参数 名字字节 <类型 = 字节集类>
    {
        @ arx_cmd_flags_of ((const char*)@<名字字节>.GetPtr())
    }

    方法 取命令名到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_cmd_name_into 的 字节集 缓冲档: 按 全局名 定位命令, 本地档传真写出的是 localName。" @嵌入式方法 = "">
    参数 名字字节 <类型 = 字节集类>
    参数 本地档 <类型 = 整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_cmd_name_into ((const char*)@<名字字节>.GetPtr(), @<本地档>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 计数命令组自字节集 <公开 静态 类型 = 整数 注释 = "arx_cmd_count_in_group 的 字节集 入参档: 走命令栈迭代器按组名精确比对, 已去掉迭代器对最后新增那条的重复访问。" @嵌入式方法 = "">
    参数 组名字节 <类型 = 字节集类>
    {
        @ arx_cmd_count_in_group ((const char*)@<组名字节>.GetPtr())
    }

    方法 取组内命令名字节档 <公开 静态 类型 = 整数 注释 = "arx_cmd_visit_group 的 字节集 档: 回本组去重后的命令条数, 并把第 序号 条的全局名写进缓冲。" @嵌入式方法 = "">
    参数 组名字节 <类型 = 字节集类>
    参数 序号 <类型 = 整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ arx_cmd_visit_group ((const char*)@<组名字节>.GetPtr(), @<序号>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>)
    }

    方法 安装反应器 <公开 静态 类型 = 整数 注释 = "arx_rx_install 的整数直档: 掩码位 1 编辑器 2 文档 4 数据库, 位 8 留给实体族但本档不因此注册任何东西(实体反应器只由 挂实体反应器 产生), 未知位一律忽略; 返回的是调用之后在装的家族数, 所以重复装同一位读起来就是幂等。"
            注释 = "2026-10-15 本机实测: 装 0 回 0; 装 1 回 1 且紧接着再装 1 仍回 1; 依次装 1/2/4 得 1/2/3; 装 8 回 3、装 15 回 3、装 16 回 3; 每一档 取最后错误 都是 0。" @嵌入式方法 = "">
    参数 掩码 <类型 = 整数>
    {
        @ arx_rx_install (@<掩码>)
    }

    方法 卸载反应器 <公开 静态 类型 = 整数 注释 = "arx_rx_uninstall 的整数直档: 摘掉全部家族并释放反应器对象, 返回本次摘掉的家族数; 框架不管反应器内存(rxprotevnt.h:45-49 要求模块自己摘干净), 所以模块卸载纪律就走这一档。"
            注释 = "2026-10-15 本机实测: 四族全装且挂过实体后回 4, 紧跟 反应器已安装 四族全 0; 再调一次回 0; 卸载之后 .scr 又敲了一次 CADTEST, 编辑器族计数不再变, 证明确实摘干净。"
            注释 = "实体档的兜底: 某条链的宿主对象连 erased 档都开不开时, 本档保留这条链与它的反应器并且不计入摘除数(释放仍挂在对象表上的指针会让调用方拿着野指针), 同时把打开失败的码留在 取最后错误。" @嵌入式方法 = "">
    {
        @ arx_rx_uninstall ()
    }

    方法 反应器已安装 <公开 静态 类型 = 整数 注释 = "arx_rx_is_installed 的整数直档: 家族号 1 编辑器 2 文档 3 数据库 4 实体, 回 1 或 0; 家族号 4 只看注册表里有没有链, 有一条就算 1。表外家族号回 -1 且 取最后错误 = -1, 于是不可能把「没有这一族」读成「这一族没装」。"
            注释 = "2026-10-15 本机实测: 未装时四族全 0; 装完 1/2/4 三个掩码位后 1/2/3 为 1 而 4 为 0; 挂上一条实体后 4 变 1; 卸载后四族回到全 0; 家族号 0 与 5 都回 -1 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 家族 <类型 = 整数>
    {
        @ arx_rx_is_installed (@<家族>)
    }

    方法 清零反应器计数 <公开 静态 类型 = 整数 注释 = "arx_rx_reset 的整数直档: 计数与末次负载名归零, 返回事件表槽位数; 注册状态一概不动。"
            注释 = "2026-10-15 本机实测: 回 39(表内 39 个事件号), 清完 11..17/21..31/41..49/61..72 全为 0, 且末次名称读回来是空文本。" @嵌入式方法 = "">
    {
        @ arx_rx_reset ()
    }

    方法 取反应器事件计数 <公开 静态 类型 = 整数 注释 = "arx_rx_event_count 的整数直档: 表内事件回累计次数, 表外事件号回 -1 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 事件号 <类型 = 整数>
    {
        @ arx_rx_event_count (@<事件号>)
    }

    方法 取反应器事件名自字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_rx_event_name_into 的 字节集 缓冲档: 该事件最后一次带名通知的负载名(编辑器族是命令名, 文档族是全局命令名或文档文件名, 数据库族是标题系统变量名)。"
            注释 = "2026-10-15 本机实测: 没见过带名通知的表内事件回真且文本为空(尺寸 4 的缓冲读空名: 成=真 文本=空 取最后错误=0); 缓冲尺寸传 0 回假且 取最后错误 = -2; 表外事件号 20 回假且 取最后错误 = -1 并且缓冲首字节保持 0。" @嵌入式方法 = "">
    参数 事件号 <类型 = 整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_rx_event_name_into (@<事件号>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 挂实体反应器 <公开 静态 类型 = 整数 注释 = "arx_rx_attach_object 的整数直档: 按对象标识挂一个 AcDbObjectReactor, 以只读方式打开对象(dbObject.h:358/370 的 addReactor/removeReactor 都是 const)。返回 Acad 码原值: 0 成功, -1 空标识, 23 同一标识重复挂, -4 注册表已满(上限 8 条)。"
            注释 = "2026-10-15 本机实测: 挂刚建好的直线回 0; 同一条再挂回 23; 挂块记录这类非实体对象也回 0(反应器挂在 AcDbObject 这一层); 连挂 8 条不同直线全回 0, 第 9 条回 -4; 摘掉第 8 条后第 9 条立刻能挂上(回 0); 对已擦除的实体重新挂回 80(eWasErased)。"
            注释 = "对象标识必须取自本桥先前返回的值: 实测到编造的整数(探针传 12345)会直进 acdbOpenObject 并把 AutoCAD 整个进程打成错误中断, 所以这一档不接受外来拼出来的标识。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_rx_attach_object (@<对象标识>)
    }

    方法 摘实体反应器 <公开 静态 类型 = 整数 注释 = "arx_rx_detach_object 的整数直档: 摘掉并释放该对象的反应器。注册表里没有这条链时直接回 22(eKeyNotFound), 不碰 AutoCAD。"
            注释 = "2026-10-15 本机实测: 摘一条挂着的直线回 0, 再摘同一条回 22; 摘一条从未挂过的真标识回 22; 实体被擦除之后再摘回 0(桥先按普通只读打开, 失败再以 erased 档重试), 此时再摘回 22。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_rx_detach_object (@<对象标识>)
    }
}

类 ARX数据库文本 <公开 注释 = "本包八条文本通道的公开档: 名字族一律 文本型 进、文本型 出, 字节集 只活在 ARX数据库底层 的缓冲档里。"
        注释 = "跨边界纪律(2026-10-14 本机实测): 桥写进缓冲的结束零字符就是读出契约, 火山侧 取字节集长度 不随写入变化, UTF8到文本 到结束零字符为止, 所以本层不需要回字节数; 同一缓冲先读长名再读短名时旧名残字节仍在缓冲里但进不了文本。"
        注释 = "嵌入行内同一参数最多引用一次(官方封装手册 嵌入式方法 特点8), 所以缓冲指针与缓冲尺寸分两个形参传, 尺寸由本层用 取字节集长度 供; 又因为 嵌入式方法 体内只能有嵌入行, 分配缓冲与转文本这两步必须留在本层的普通方法里, 每条通道因此是两档方法。"
        注释 = "缓冲统一 1024 字节: 名称上限 255 字符按 UTF8 最坏 765 字节加尾零仍在范围内; 越界即桥的 缓冲不足 档, 本层回空文本。">
{
    方法 取图层名 <公开 静态 类型 = 文本型 注释 = "对应 AcDbLayerTableRecord::name。实测: 按下标取图层标识(0) 得 0, 取测试图层 得 CADARX_TEST, 中文名逐字相等; 图层标识传 0 得空文本且 取最后错误 = -2。">
    参数 图层标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取图层名到字节集 (图层标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取块记录名 <公开 静态 类型 = 文本型 注释 = "对应 AcDbBlockTableRecord::name。实测: 取模型空间 得 *Model_Space, 文本长度 12。失败口径同 取图层名。">
    参数 块记录 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取块记录名到字节集 (块记录, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取实体类型名 <公开 静态 类型 = 文本型 注释 = "对应 AcDbEntity::isA()->desc()。实测: 新建直线 得 AcDbLine; 擦除实体 之后仍得 AcDbLine, 这条通道不报 eWasErased, 判存活要用 是否已擦除。失败口径同 取图层名。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取实体类型名到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取句柄文本 <公开 静态 类型 = 文本型 注释 = "对应 AcDbHandle 的 ASCII 文本形态。实测: 句柄数值 722 的直线得 2D2, 即 取句柄数值 的十六进制写法; 句柄数值本身随 DWG 与创建次序变化, 只能断言非空文本且与 取句柄数值 换算一致。失败口径同 取图层名。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取句柄文本到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取实体图层名 <公开 静态 类型 = 文本型 注释 = "对应 AcDbEntity::layerId() 再取名, 与 取图层标识 互补。实测: 新建直线 得 0。失败口径同 取图层名。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取实体图层名到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 图层是否存在 <公开 静态 类型 = 逻辑型 注释 = "对应 acdbSymbolTable::has。实测: CADARX_TEST 与 火山探针层 为真, NO_SUCH_LAYER_XYZ 为假且 取最后错误 = 0。名称按 文本到UTF8 默认档(含结束零字符)传下去, 实测不含尾零的档同样能命中。">
    参数 名称 <类型 = 文本型>
    {
        返回 (ARX数据库底层.图层是否存在自字节集 (文本到UTF8 (名称)))
    }

    方法 新建图层 <公开 静态 类型 = 变整数 注释 = "确保所给名字的图层存在并返回其对象标识, 已存在时返回同一标识(实测同名两次同一标识且 取图层数 只加 1)。实测: 小写名 cadarx_probe_up 建成功且 取图层名 逐字读回, AutoCAD 不折叠大小写; 中文名 火山探针层 同样成功; bad<name> 与空名都返回 0 且 取最后错误 = 3(eInvalidInput)。">
    参数 名称 <类型 = 文本型>
    {
        返回 (ARX数据库底层.建图层自字节集 (文本到UTF8 (名称)))
    }

    方法 置实体图层名 <公开 静态 类型 = 逻辑型 注释 = "按名字改写实体所在图层, 与 置实体图层 按标识改写互补。实测: 置成已存在的中文名返回真且 取实体图层名 逐字读回; 不存在的名字与空名都返回假且 取最后错误 = 22(eKeyNotFound)。">
    参数 对象标识 <类型 = 变整数>
    参数 名称 <类型 = 文本型>
    {
        返回 (ARX数据库底层.置实体图层名自字节集 (对象标识, 文本到UTF8 (名称)))
    }
}

类 ARX数据库命令 <公开 注释 = "命令注册通道的公开档: 组名与命令名一律 文本型 进、文本型 出, 字节集 只活在 ARX数据库底层 的九个 自字节集 档里。"
        注释 = "回调形态(2026-10-15 本机实测): ObjectARX 存的 AcRxFunctionPtr 就是 void (*)(), 自 2013 API 起不带参数, 所以 处理函数地址 只能取零参数无返回值 静态 方法的 取静态方法地址 结果。实测同一方法两次 取静态方法地址 同值、方法体各不相同的两个方法地址互异且都非零; 桥把收到的地址原样交给 addCommand, 之后 取命令处理函数地址 读回的值与传进去的逐次相等。但方法体逐字相同的两个方法会被折成同一个地址(本机实测: 三个同体回调两两同值, 换成各加各的计数器之后才互异), 所以要把两个回调区分开, 方法体必须真的不同。"
        注释 = "卸载纪律: 命令栈存的是裸函数指针, 不随模块卸载自动摘除, 所以本模块的 清除命令组 必须在镜像被 FreeLibrary 之前调用, 否则 AutoCAD 再敲该命令名就是打进已释放的代码段。"
        注释 = "标志位取值(本包不建常量类, 按 accmd-defs.h 原值传): 模态 0, 透明 1, 需选择集 2, 不可重复 0x10, 可中断 0x400000, 内部锁豁免 0x20000, 只读锁 0x80000, 独占锁 0x100000, 会话档 0x200000=2097152。"
        注释 = "错误口径: 注册/注销/清组三条直接回 Acad::ErrorStatus 原码(0 成功, 3 eInvalidInput, 22 eKeyNotFound, 23 eDuplicateKey), 只有桥自己拒收的入参回负数(-2 空指针/空地址, -4 缓冲不足), 所以负值与 Acad 码不冲突; 读档(查询/标志位/函数地址/取名)查不到时各自回 0、-1、0、空文本并把 取最后错误 置 -1。">
{
    方法 注册命令 <公开 静态 类型 = 整数 注释 = "对应 acedRegCmds->addCommand。实测: 模态档(0)注册 ZPROBE1 返回 0 且 取最后错误 = 0, 同组计数立刻为 1; 同组同名重复注册返回 23 且组计数仍是 1; 同一全局名换到另一组返回 0 且两组各计 1; 空名返回 3 且 取最后错误 = 3; 中文名 Z火山命令 与含空格名 Z PROBE 都返回 0 且随后按名查询非零; 会话档传 2097152 返回 0 且 取命令标志位 原样读回 2097152。">
    参数 组名 <类型 = 文本型>
    参数 全局名 <类型 = 文本型>
    参数 本地名 <类型 = 文本型>
    参数 标志位 <类型 = 整数>
    参数 处理函数地址 <类型 = 变整数>
    {
        返回 (ARX数据库底层.注册命令自字节集 (文本到UTF8 (组名), 文本到UTF8 (全局名), 文本到UTF8 (本地名), 标志位, 处理函数地址))
    }

    方法 注销命令 <公开 静态 类型 = 整数 注释 = "对应 acedRegCmds->removeCmd。实测: 注销刚注册的 ZPROBE3 返回 0 且 取最后错误 = 0, 之后 查询命令 得 0 且 取最后错误 = -1; 重复注销与注销一个不存在的名字都返回 22 且 取最后错误 = 22。注销之后再敲该命令名打不进回调(计数器恒 0)。">
    参数 组名 <类型 = 文本型>
    参数 全局名 <类型 = 文本型>
    {
        返回 (ARX数据库底层.注销命令自字节集 (文本到UTF8 (组名), 文本到UTF8 (全局名)))
    }

    方法 清除命令组 <公开 静态 类型 = 整数 注释 = "对应 acedRegCmds->removeGroup。实测: 清 CADARXPROBE2 返回 0 且 取最后错误 = 0, 该组计数立刻 0 而另一组仍 5; 清不存在的组名返回 22 且 取最后错误 = 22。组名大小写敏感: 传小写 cadarxprobe 计数得 0 且错误 0, 同轮传原名 CADARXPROBE 计数得 5。">
    参数 组名 <类型 = 文本型>
    {
        返回 (ARX数据库底层.清除命令组自字节集 (文本到UTF8 (组名)))
    }

    方法 查询命令 <公开 静态 类型 = 变整数 注释 = "对应 lookupGlobalCmd / lookupLocalCmd, 命令存在与否用本档判(0 就是查不到)。实测: 注册后按全局名查非零; 全局名与本地名是两个独立空间——异名注册 ZPROBE8/ZP8LOC 后, 按本地名传全局档得 0, 传本地档得非零且 取最后错误 = 0; 查不到的名字回 0 且 取最后错误 = -1。">
    参数 名称 <类型 = 文本型>
    参数 全局档 <类型 = 逻辑型>
    {
        变量 档 <类型 = 整数>
        如果 (全局档)
        {
            档 = 1
        }
        否则
        {
            档 = 0
        }
        返回 (ARX数据库底层.查询命令自字节集 (文本到UTF8 (名称), 档))
    }

    方法 取命令处理函数地址 <公开 静态 类型 = 变整数 注释 = "对应 AcEdCommand::functionAddr。实测: 注册时传进去的 取静态方法地址 结果被原样读回(等于址甲=真); 查不到的名字回 0 且 取最后错误 = -1。">
    参数 全局名 <类型 = 文本型>
    {
        返回 (ARX数据库底层.取命令处理函数地址自字节集 (文本到UTF8 (全局名)))
    }

    方法 取命令标志位 <公开 静态 类型 = 整数 注释 = "对应 AcEdCommand::commandFlags。实测: 模态档注册后读回 0, 会话档读回 2097152; 查不到的名字回 -1 且 取最后错误 = -1 —— 因为模态档的合法值本来就是 0, 所以 -1 才是唯一的查不到标记。">
    参数 全局名 <类型 = 文本型>
    {
        返回 (ARX数据库底层.取命令标志位自字节集 (文本到UTF8 (全局名)))
    }

    方法 取命令名 <公开 静态 类型 = 文本型 注释 = "对应 AcEdCommand::globalName / localName, 本地档传真读的是 localName。实测: 中文名 Z火山命令 逐字读回且 取文本长度 = 5; 异名注册 ZPROBE8/ZP8LOC 时全局档读回 [ZPROBE8] 长度 7、本地档读回 [ZP8LOC] 长度 6; 查不到的名字回空文本且 取最后错误 = -1。缓冲固定 1024 字节, 名称上限 255 字符按 UTF8 最坏 765 字节加尾零仍在范围内。">
    参数 全局名 <类型 = 文本型>
    参数 本地档 <类型 = 逻辑型>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        变量 档 <类型 = 整数>
        如果 (本地档)
        {
            档 = 1
        }
        否则
        {
            档 = 0
        }
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取命令名到字节集 (文本到UTF8 (全局名), 档, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 计数命令组 <公开 静态 类型 = 整数 注释 = "对应 AcEdCommandStack::iterator 按组名精确比对。实测: 新建组只含一条时计数 1 —— 原生迭代器会把最后新增那条读两遍, 桥内已按命令指针去重; 宿主组 CADARXTEST 恒 2; 清组后 0; 不存在的组名 0 且 取最后错误 = 0。">
    参数 组名 <类型 = 文本型>
    {
        返回 (ARX数据库底层.计数命令组自字节集 (文本到UTF8 (组名)))
    }

    方法 取组内命令名 <公开 静态 类型 = 文本型 注释 = "对应同一次迭代: 序号从 0 起取该组第 序号 条的全局名, 次序是命令栈自身的次序而非注册次序。实测: 组内只有一条时序号 0 得 ZPROBE1、序号 1 与 2 都回空文本; 宿主组序号 0 得 CADTEST、序号 1 得 TAIJI、序号 2 与 3 回空文本; 五点数的组序号 0 得含空格名 Z PROBE、序号 1 得 ZPROBE1。条数要用 计数命令组 取。">
    参数 组名 <类型 = 文本型>
    参数 序号 <类型 = 整数>
    {
        变量 缓冲 <类型 = 字节集类>
        缓冲 = 取空白字节集 (1024)
        如果 (ARX数据库底层.取组内命令名字节档 (文本到UTF8 (组名), 序号, 缓冲, 缓冲.取字节集长度 ()) == 0)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }
}

类 ARX反应器 <公开 注释 = "包A 裁定③ 的公开档: 反应器对象全部活在 cadarx_test.arx 里, 跨边界只有整数计数与一条末次负载名, 因此本类不提供「注册一个火山侧回调」那种形状。"
        注释 = "家族号(给 反应器已安装)是 1 编辑器 2 文档 3 数据库 4 实体; 安装掩码用的是位: 1 编辑器 2 文档 4 数据库, 位 8 保留。两套编号不通用, 因为 1..4 当掩码位会互相重叠(掩码 1 与家族号 3 相与非零), 本机探针实测到旧形状装 1 会连数据库族一起装上。"
        注释 = "事件号是一维整数: 11 命令将开始 12 命令已结束 13 命令被取消 14 命令失败 15 未知命令 16 Lisp 将开始 17 系统变量已变; 21 文档创建开始 22 文档创建完成 23 文档将销毁 24 文档已销毁 25 文档将激活 26 文档已激活 27 文档将失活 28 文档成当前 29 锁模式将变 30 锁模式已变 31 锁模式被否; 41 对象被加入 42 对象被移出 43 对象被重新加入 44 对象为改而打开 45 对象已修改 46 对象已擦除 47 标题变量将变 48 标题变量已变 49 数据库告别; 61 对象为改而打开 62 对象已修改 63 子对象已改 64 改动被撤销 65 对象已擦除 66 对象被移出 67 对象被重新加入 68 对象被关闭 69 对象被取消 70 对象被复制 71 XData 已改 72 对象告别。"
        注释 = "表外事件号与表外家族号一律回 -1, 不要把「没有这个事件」读成「这个事件零次」。"
        注释 = "数据库族在装载那一刻绑定当时的可用数据库, AutoCAD 不会在切换文档时把它搬走, 所以切档后它报的仍是旧数据库。批量开关文档有模态挂死风险(本机 DXFOUT 实测), 因此文档族 21..28 在回归里只作基线零次读数。">
{
    方法 安装反应器 <公开 静态 类型 = 整数 注释 = "按掩码位装家族, 返回调用之后在装的家族数。实测: 装 0 回 0; 装 1 回 1 且再装 1 仍回 1; 依次装 1/2/4 得 1/2/3; 装 8、装 15、装 16 都回 3。">
    参数 家族位掩码 <类型 = 整数>
    {
        返回 (ARX数据库底层.安装反应器 (家族位掩码))
    }

    方法 卸载反应器 <公开 静态 类型 = 整数 注释 = "摘掉全部家族并释放反应器, 返回本次摘掉的家族数。实测: 四族齐时回 4 且四族旗标随即全 0, 再调一次回 0。模块卸载前必须走这一档。">
    {
        返回 (ARX数据库底层.卸载反应器 ())
    }

    方法 反应器已安装 <公开 静态 类型 = 整数 注释 = "家族号 1/2/3/4 回 1 或 0, 表外家族号回 -1 且 取最后错误 = -1。实测: 未装四族全 0; 三个掩码位装完后 1/2/3 为 1 而 4 为 0; 挂上一条实体后 4 为 1。">
    参数 家族 <类型 = 整数>
    {
        返回 (ARX数据库底层.反应器已安装 (家族))
    }

    方法 清零反应器计数 <公开 静态 类型 = 整数 注释 = "计数与末次负载名归零, 返回事件表槽位数(实测 39), 注册状态不动。">
    {
        返回 (ARX数据库底层.清零反应器计数 ())
    }

    方法 取事件计数 <公开 静态 类型 = 整数 注释 = "该事件号自上次清零以来的累计次数; 表外事件号回 -1。">
    参数 事件号 <类型 = 整数>
    {
        返回 (ARX数据库底层.取反应器事件计数 (事件号))
    }

    方法 取事件末次名称 <公开 静态 类型 = 文本型 注释 = "该事件最后一次带名通知的负载名, 没见过时回空文本; 表外事件号也回空文本且 取最后错误 = -1。实测: 触发 ZRX1 之后读 11 得 ZRX1, 检查点里再读得 CADTEST; 空名档回空文本而缓冲首字节为 0。">
    参数 事件号 <类型 = 整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取反应器事件名自字节集 (事件号, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 挂实体反应器 <公开 静态 类型 = 整数 注释 = "给一个本桥发出去的对象标识挂实体级反应器, 回 Acad 码原值。实测: 新直线回 0, 重复挂回 23, 空标识回 -1, 注册表(上限 8 条)满时回 -4, 已擦除的实体回 80。标识一律只用 新建直线/取模型空间 这类本包返回过的值, 编造整数会让 AutoCAD 错误中断。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.挂实体反应器 (对象标识))
    }

    方法 摘实体反应器 <公开 静态 类型 = 整数 注释 = "摘掉并释放该对象的反应器。实测: 挂着时摘回 0, 同一条再摘回 22, 从未挂过的真标识回 22, 实体擦除之后再摘也回 0(桥会以 erased 档重试打开)。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.摘实体反应器 (对象标识))
    }
}

类 ARX数据库属性 <公开 注释 = "包A 必做#1 的公开档: AcDbEntity 六面图形属性 —— 颜色号、真彩、线型、线型比例、线宽、透明度。共十六条入口全部走 ARX数据库属性 这一层, 只有线型名额外有 文本型 高档。"
        注释 = "为什么这一族的读数全是纯标量: @嵌入式方法 的嵌入行没法把一个普通整数的地址交给桥(手册只给了 字节集.GetPtr() 和对象句柄两条拿地址的路), 所以桥在这里一律不用 int* 出参, 改成直接回值, 并为每一档留一个合法值取不到的哨兵 —— 颜色号/颜色方法/颜色RGB/透明度方法/透明度值 回 -1, 线型标识 回 0, 线型比例 回 NaN(火山没有 NaN 字面量, 判据是 值 == 值 为假), 线宽 回 -1000。哨兵不是唯一的失败证据: 每一次调用后 取最后错误 都还留着 Acad 原码或桥的 ARX_DB_ERR_* 标记。"
        注释 = "两套失败码的分工(2026-10-15 本机 AutoCAD 2026 属性探针实测): 桥在进 AcDb 之前自己拒的入参给负码 —— -3 表示值超出底层类型表示范围(颜色号 65536、任一 RGB 通道 256、透明度方法 3 或 -1、透明值 256 或 -1), -1 表示线型标识传 0; Acad 自己拒的给原码 —— 24 eInvalidIndex(颜色号 257/300/65535)、22 eKeyNotFound(线型名查不到, 含本环境未加载的 DASHED 与中文名)、29 eNegativeScale(线型比例 -1)、151 eInvalidLineWeight(线宽 7/300/-4)、80 eWasErased(已擦除实体的全部八条读数与五条写档)。被拒的调用都一位不改属性。"
        注释 = "三条库行为只有实测才看得出来, 本包按实测写死口径: 一、索引色不解析真彩 —— 置颜色索引 之后 取颜色RGB 恒回 0, 想拿 RGB 必须自己走真彩档; 二、真彩不反向同步颜色号 —— 置颜色RGB(255,128,0) 之后 取颜色索引 还是上一次那个数, 但置黑(0,0,0) 时底层自己折算出索引色 18; 三、置透明度 的方法半字节留不住 —— 方法传 0 或 1 加上任意 alpha 都被底层改写成 2(kByAlpha), 实测 置透0明50 读回 2/50。"
        注释 = "线型名这条文本通道与 ARX数据库文本 同一形状: 底层是 (缓冲, 缓冲尺寸) 两参的 字节集 档, 高档用 取空白字节集 (1024) + UTF8到文本 取值, 写入用 文本到UTF8; 名字要能命中, 前提是图形里已经加载了这条线型。缓冲档失败时 取最后错误 被桥覆写成 -2, 高档因此只回空文本, 想知道是查不到还是实体已擦除要读底层档。">
{
    方法 取颜色号 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::colorIndex。实测: 新建直线/圆/多段线都是 256(byLayer), 置颜色号 后原样读回; 失败回 -1(空标识 取最后错误 = -1, 已擦除 = 80)。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取颜色索引 (对象标识))
    }

    方法 置颜色号 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setColorIndex。实测: 1/7/30/255 成功且 取颜色方法 为 195, 256 成功回 192, 0 成功且方法为 193; 257/300/65535 假且 取最后错误 = 24, 负数与 65536 假且 取最后错误 = -3, 两种失败都一位不改。">
    参数 对象标识 <类型 = 变整数>
    参数 颜色号 <类型 = 整数>
    {
        返回 (ARX数据库底层.置颜色索引 (对象标识, 颜色号))
    }

    方法 取颜色方法 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::entityColor().colorMethod()。实测四档: 192 随图层, 193 byBlock, 194 真彩, 195 索引色; 失败回 -1。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取颜色方法 (对象标识))
    }

    方法 取真彩色 <公开 静态 类型 = 整数 注释 = "AcCmEntityColor 三通道拼成的 0x00RRGGBB。实测: 索引色档恒回 0(不查色板); 置真彩色(255,128,0) 回 16744448, 置真彩色(0,0,0) 回 0; 失败回 -1。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取颜色RGB (对象标识))
    }

    方法 置真彩色 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setColor(AcCmColor)。三通道各收 0..255, 越界由桥拒且 取最后错误 = -3。实测: 成功后 取颜色方法 = 194, 但 取颜色号 不同步(置橙后仍是上一次那个索引色); 置黑时 取颜色号 反而被底层折算成 18。">
    参数 对象标识 <类型 = 变整数>
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    {
        返回 (ARX数据库底层.置颜色RGB (对象标识, 红, 绿, 蓝))
    }

    方法 取线型名 <公开 静态 类型 = 文本型 注释 = "对应 AcDbEntity::linetype(AcString&)。实测: 新建实体得 ByLayer, 置线型名 Continuous 后逐字读回; 失败回空文本。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX数据库底层.取线型名到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 置线型名 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setLinetype(const ACHAR*)。实测: Continuous 与 ByLayer 成功并逐字读回; DASHED / 查不到的名字 / 空名 / 中文名 四档都假且 取最后错误 = 22(eKeyNotFound), 原名不改 —— 线型必须已经在图形的线型表里。">
    参数 对象标识 <类型 = 变整数>
    参数 名称 <类型 = 文本型>
    {
        返回 (ARX数据库底层.置线型名自字节集 (对象标识, 文本到UTF8 (名称)))
    }

    方法 取线型标识 <公开 静态 类型 = 变整数 注释 = "对应 AcDbEntity::linetypeId。实测: 新建实体即非 0(ByLayer 那条线型记录), 换线型后仍非 0; 失败回 0 且 取最后错误 = -1(空标识)或 80(已擦除)。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取线型标识 (对象标识))
    }

    方法 置线型标识 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setLinetype(AcDbObjectId), 不查线型表。实测: 取线型标识 的原值传回去即回环成功且 取线型名 不变; 线型标识传 0 由桥先拒, 假且 取最后错误 = -1。">
    参数 对象标识 <类型 = 变整数>
    参数 线型标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.置线型标识 (对象标识, 线型标识))
    }

    方法 取线型比例 <公开 静态 类型 = 小数 注释 = "对应 AcDbEntity::linetypeScale。实测: 新建实体为 1, 置 2.5/0.0/1000000.0 都原样读回。失败回 NaN, 火山侧的判据是 值 == 值 为假(空标识与已擦除实体两档如此), 0.0 是合法值且自等, 别拿它当失败。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取线型比例 (对象标识))
    }

    方法 置线型比例 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setLinetypeScale, 桥不设正数门。实测: -1.0 由 Acad 拒, 假且 取最后错误 = 29(eNegativeScale), 比例保持上一次成功值。">
    参数 对象标识 <类型 = 变整数>
    参数 比例 <类型 = 小数>
    {
        返回 (ARX数据库底层.置线型比例 (对象标识, 比例))
    }

    方法 取线宽 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::lineWeight, 百分之一毫米。实测: 新建实体为 -1(byLayer); 35 与 211 原样读回, -1/-2/-3 三个负档也都存得住。失败回 -1000(桥的 ARX_DB_NO_WEIGHT, 与四个合法负档和 Acad 码都不撞)。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取线宽 (对象标识))
    }

    方法 置线宽 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setLineWeight。实测: 白名单由 Acad 定 —— 7 与 300 与 -4 三档都假且 取最后错误 = 151(eInvalidLineWeight), 其中 -4(byDIPs) 虽然能由 取线宽 读出来却是写不进去的; 35/-1/-2/-3/211 五档真。">
    参数 对象标识 <类型 = 变整数>
    参数 线宽 <类型 = 整数>
    {
        返回 (ARX数据库底层.置线宽 (对象标识, 线宽))
    }

    方法 取透明度方法 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::transparency 的方法半字节。实测: 新建实体为 0(byLayer); 失败回 -1。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取透明度方法 (对象标识))
    }

    方法 取透明度值 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::transparency 的 alpha, 0 不透明, 255 全透明。实测: 新建实体为 255; 失败回 -1。">
    参数 对象标识 <类型 = 变整数>
    {
        返回 (ARX数据库底层.取透明度值 (对象标识))
    }

    方法 置透明度 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setTransparency(AcCmTransparency)。实测两条: 一、方法半字节留不住 —— 传 (0,50) 读回 方法=2 值=50, 传 (1,10) 读回 2/10, 只有方法 2 是原样存的; 二、方法传 3 或 -1、透明值传 256 或 -1 四档都由桥先拒, 假且 取最后错误 = -3。归零档 (0,0) 读回 2/0。">
    参数 对象标识 <类型 = 变整数>
    参数 透明方法 <类型 = 整数>
    参数 透明值 <类型 = 整数>
    {
        返回 (ARX数据库底层.置透明度 (对象标识, 透明方法, 透明值))
    }

    方法 取透明度对象尺寸 <公开 静态 类型 = 整数 注释 = "转调底层档。实测 x64 = 4, 是 取透明度方法 那一手高字节移位的前提。">
    {
        返回 (ARX数据库底层.取透明度对象尺寸 ())
    }

    方法 取实体颜色对象尺寸 <公开 静态 类型 = 整数 注释 = "转调底层档。实测 x64 = 4。">
    {
        返回 (ARX数据库底层.取实体颜色对象尺寸 ())
    }
}

类 ARX模块生命周期 <公开 注释 = "包A 裁定④ 的公开档: 运行期模块载入/卸载与镜像映射六条入口, 每条自己就是一个 @嵌入式方法 档, 本类没有底层档也没有转发档 —— 按裁定与 OCCT 范本(occt_2d.wsv 每个公开类只有嵌入档, 转发条数 0)不做重复封装。"
        注释 = "文本入参用 @<参数>.GetText() 直接递 const wchar_t*, 与 rxregsvc.h 里三条 acrx* 的 ACHAR* 同形, 所以桥里那 512 格 UTF8 缓冲已撤掉; 官方封装手册 嵌入式方法 特点4 规定嵌入式方法体内只能有嵌入行, 文本到UTF8 这类转换写不进嵌入档, GetText 是范本里唯一能单档到底的形状。"
        注释 = "读数纪律: acrxLoadModule / acrxUnloadModule / acrxUnloadApp 只回 bool (rxregsvc.h 已核) 且不留 Acad 码, 所以三档都是 逻辑型 且 取最后错误 恒 0; 只有指针参数为 NULL 才是 -2, 而 文本型 递不出 NULL, 所以本类量不到 -2。"
        注释 = "卸载安全实测(同一 acad 会话跑两轮, .scr 里 (arxunload 名字) 与 (arxload 同一路径) 夹在中间): 第一轮收尾把 4 个反应器家族和 ZUPASS 命令留着不清, 宿主 On_kUnloadAppMsg 打 detached=4 与 freed 与 mapped_after=0; 第二轮开场 取命令处理函数地址 回 0、组计数 0、反应器全表 0/0/0/0、取内核释放码 回 0, 即镜像真被换掉、命令栈里存的裸指针没有复活、静态计数不跨镜像存活。">
{
    方法 载入模块 <公开 静态 类型 = 逻辑型 注释 = "arx_module_load → acrxLoadModule(名字, printit)。名字可给全路径也可只给模块名, 打印档 非零即在命令行回显。实测四条负形: 未知名不打=假 码=0、未知名打印=假 码=0、空名=假 码=0、800 字符长名=假 码=0; 正形(真载入一个模块)会改 CAD 状态, 不在内核回归里跑, 由 .scr 的 (arxload ...) 实测过。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    参数 打印档 <类型 = 整数>
    {
        @ (arx_module_load(@<名称>.GetText(), @<打印档>) != 0)
    }

    方法 卸载模块 <公开 静态 类型 = 逻辑型 注释 = "arx_module_unload → acrxUnloadModule(名字, asCmd)。按模块文件名卸, 服务或类还有人依赖时会失败。实测四条负形: 未知名命令档0=假 码=0、未知名命令档1=假 码=0、空名=假 码=0、长名=假 码=0; 对自身 cadarx_test 的正形同样不在内核里调, 免得自毁。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    参数 命令档 <类型 = 整数>
    {
        @ (arx_module_unload(@<名称>.GetText(), @<命令档>) != 0)
    }

    方法 卸载应用 <公开 静态 类型 = 逻辑型 注释 = "arx_app_unload → acrxUnloadApp(应用名, false)。键是注册表里的逻辑应用名, 与 卸载模块 的文件名不是一回事。实测三条负形: 未知名=假 码=0、空名=假 码=0、长名=假 码=0。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    {
        @ (arx_app_unload(@<名称>.GetText()) != 0)
    }

    方法 镜像已映射 <公开 静态 类型 = 逻辑型 注释 = "arx_image_mapped → GetModuleHandleW, 纯 Win32 不碰 AcDb, 模块卸掉之后照样能读, 所以它是卸载是否真落地的唯一外部判据。实测八档: 本模块 arx 全路径=真、kernel32.dll=真、kernel32(不带扩展名)=真、user32.dll=真、kernel33.dll=假、空名=假 码=0、不存在的中文路径=假 码=0、800 字符长名=假 码=0。" @嵌入式方法 = "">
    参数 路径 <类型 = 文本型>
    {
        @ (arx_image_mapped(@<路径>.GetText()) != 0)
    }

    方法 取内核映射 <公开 静态 类型 = 整数 注释 = "arx_kernel_mapped: 火山测试内核的镜像在本进程还映射着吗 (1 在, 0 不在, -1 连路径都取不到)。内核内跑着时实测 1; 载入/卸载三档跑一整圈之后仍实测 1, 因为负形名字谁都碰不到自己。" @嵌入式方法 = "">
    {
        @ arx_kernel_mapped()
    }

    方法 取内核释放码 <公开 静态 类型 = 整数 注释 = "arx_kernel_free_code: 上一次 On_kUnloadAppMsg 里 FreeLibrary 的结果 (0 从未尝试, 1 成功, 其余是 Win32 码)。实测 两轮开场都回 0 —— 上一轮那个 1 是另一个镜像里的静态, 换镜像就没了, 这条读数本身就是 FreeLibrary 之后镜像真被卸掉的旁证; 宿主日志里那行 freed 才是 1 的落点。" @嵌入式方法 = "">
    {
        @ arx_kernel_free_code()
    }
}
类 ARX文字 <公开
        注释 = "单行文字实体 AcDbText 的公开档, 包A 必做#2 的第一层。每条入口自己就是一个 @嵌入式方法 档, 本类没有底层转发档 —— 按裁定与 OCCT 范本(occt_2d.wsv 每个公开类只有嵌入档, 转发条数 0)不做重复封装。"
        注释 = "文字入参一律 文本型 直传(档内 @<参数>.GetText() 交给桥的 const wchar_t*), 文字出参按两档: 字节集 缓冲档写 UTF8, 同类的 文本型 高档负责 取空白字节集 与 UTF8到文本。"
        注释 = "几何出参(位置、对齐点、法向、平面、包围点)跨边界的是 AcGe 桥创建的句柄, 由调用方先 创建 好 ARX点3D / ARX向量3D / ARX平面 / ARX矩阵3D 再传 对象指针。"
        注释 = "枚举参数按整数原值传, 值表写在各档注释里: 水平 0..5、垂直 0..3、整对齐 0..14, 上界与下界外侧一律由桥自拒并留 取最后错误 = -3, 库不参与越界判定。"
        注释 = "缓冲统一 1024 字节: 名称上限 255 字符按 UTF8 最坏 765 字节加尾零仍在范围内; 越界即桥的 缓冲不足 档(取最后错误 = -4), 本层回空文本。"
        注释 = "三条 新建 档与 建实体 同一轮实测: 单行文字 21 条读档、16 条写档、2 条 文本型 高档全过, 对象是 新建文字 自己建的两条文字加一条直线异物; 缺省内容 [文字ABC]、缺省位置 10/20/0、缺省字高 2.5、缺省旋转角 0.3、缺省厚度 0、缺省倾角 0、缺省宽度因子 1、缺省法向 0/0/1、缺省对齐三档 0/0/0、缺省镜像双假。"
        注释 = "失败哨兵两族口径: 普通档按返回值档别走 (小数回 NaN、整数回 -1、句柄回 0、逻辑回假), 错误槽是 -1 空标识 / 46 eNotThatKindOfClass 异物 / 80 eWasErased 已擦除; 三条 到字节集 与 文本型 高档一律 -2 (桥的 writeUtf8 空源档覆写 openObject 留下的码), 要辨成因只能用同类的普通档。">
{
    方法 是否文字 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObject::isKindOf(AcDbText::desc()), 与 是否直线/是否圆 同一口径; 空标识回假且 取最后错误 = -1。 实测: 单行文字与带样式那条都回真, 直线与多行文字回假; 空标识紧随的 取最后错误 = -1。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_is_text (@<对象标识>) != 0)
    }

    方法 新建文字 <公开 静态 类型 = 变整数 注释 = "new AcDbText(位置, 文字, 样式, 字高, 旋转角) 后 appendAcDbEntity 到块记录并 close; 样式标识传 0 即 AcDbObjectId::kNull, 内容由火山侧 文本型 直传。 实测: 建 10/20/0 字高2.5 旋转0.3 内容 文字ABC 样式标识传 0 回非零标识且 取最后错误 = 0; 样式标识传 新建样式 的标识同样建成功; 块记录传 0 回 0 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    参数 插入点X <类型 = 小数>
    参数 插入点Y <类型 = 小数>
    参数 插入点Z <类型 = 小数>
    参数 字高 <类型 = 小数>
    参数 旋转角 <类型 = 小数>
    参数 内容 <类型 = 文本型>
    参数 样式标识 <类型 = 变整数>
    {
        @ arx_db_add_text (@<块记录>, @<插入点X>, @<插入点Y>, @<插入点Z>, @<字高>, @<旋转角>, @<内容>.GetText (), @<样式标识>)
    }

    方法 取内容到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_text_string_into 的 字节集 缓冲档, 对应 AcDbText::textString(AcString&)。 实测: 1024 字节缓冲读到 [文字ABC] 长=5 字0=-26(即 UTF8 首字节 0xE6) 码=0; 8 字节缓冲装不下 90 字中文时 成=假 [] 码=-4; 空标识 成=假 [] 码=-2; 取空白字节集(0) 配 尺寸 0 成=假 空集 码=-2。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_text_string_into (@<对象标识>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 取内容原样到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_text_string_const_into 的 字节集 缓冲档, 对应 AcDbText::textStringConst, 取的是实体内部那份常量指针, 桥不另拷贝。 实测: 与 取内容到字节集 同轮同值: [文字ABC] 长=5 码=0, 改内容后两条一起跟着变。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
