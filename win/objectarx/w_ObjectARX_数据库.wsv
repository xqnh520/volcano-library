<火山程序 类型 = "通常" 版本 = 1 />

包 火山.ObjectARX.数据库 <注释 = "ObjectARX 2026 (R25) AcDb 实体读写的火山视窗封装。本版本覆盖: 模型/图纸空间块记录、AcDbLine、AcDbCircle、AcDbPolyline、AcDbCurve 公共量测接口、实体生命周期(追加/遍历/擦除/可见性)、图层表, 以及名称族文本通道(块记录名/实体类型名/图层名/句柄文本/图层存在与建图层/置实体图层), 块表与块参照(见类 ARX块表 / ARX块参照, 共四十条入口), 属性族(见类 ARX属性定义 / ARX属性实体, 外加 ARX块表 两条与 ARX块参照 一条补档, 共三十九条入口), 外加实体图形属性族(颜色号/真彩/线型名与线型标识/线型比例/线宽/透明度 共十六条入口, 见类 ARX数据库属性)。"
        注释 = "全部期望值均由本机 AutoCAD 2026 实测得到(实测环境: D:\\Program Files\\CAD2026\\AutoCAD 2026, 全新空白 DWG), 各方法注释里给出的数值就是实测口径, 不是推测。"
        注释 = "运行前提: 本包不自行加载任何 AcDb 模块。桥接实现位于 cadarx_test.arx, 因此调用方进程必须是 acad.exe, 且 cadarx_test.arx 已经通过 arxload 装入。在 acad 之外调用会直接取不到数据库(取最后错误 = 124 eNoDatabase)。"
        注释 = "跨边界纪律: 指针与数量用 变整数/整数/小数, 出参由调用方提供已创建好的 AcGe 点对象。名称族文本通道已按 字节集 桥实测放开(见类 ARX数据库文本): 读出口是 (缓冲区, 缓冲尺寸) 两参, 底层写 NUL 结尾, 火山侧靠 UTF8到文本 遇 NUL 截断取值, 取字节集长度 不会被底层回写; 写入参是 文本到UTF8(文本) 缺省带结尾 NUL 的 字节集, 只用一个参数引用一次。官方约束: @嵌入式方法 的嵌入行内每个参数最多引用一次(所以 缓冲 与 缓冲尺寸 必须分两个形参), 且嵌入行内不能写分配/转换语句, 于是每条文本通道都是 字节集 底层档 + 文本型 高层档 两层。"
        注释 = "对象标识口径: AcDbObjectId 内部只有一个 AcDbStub* 成员, x64 下实测 sizeof = 8, 与 变整数 等宽, 因此对象标识直接按位当作 变整数 传递; 0 表示空标识。"
        @视窗.头文件搜寻目录 = "arx"
        @视窗.库文件搜寻目录 = "arx\\out"
        @视窗.外部头文件 = "arx\\arx_db_bridge.h"
        @视窗.外部库.x64 = "cadarx_test.lib">

类 ARX数据库底层 <公开 注释 = "直接映射 cadarx_test.arx 导出的 AcDb C 桥接函数, 供本包其它类调用。声明为公开只为让测试内核与诊断代码能读到 取最后错误 等原始口径, 业务代码应改用本包的高层类。">
{
    方法 是否有数据库 <公开 静态 类型 = 逻辑型 注释 = "对应 acdbHostApplicationServices()->workingDatabase() 非空。" @嵌入式方法 = "">
    {
        @ (arx_db_has_database() != 0)
    }

    方法 取模型空间 <公开 静态 类型 = 变整数 注释 = "对应块表记录 *Model_Space。实测: 有当前文档时非 0, 取最后错误 = 0。" @嵌入式方法 = "">
    {
        @ arx_db_model_space()
    }

    方法 取图纸空间 <公开 静态 类型 = 变整数 注释 = "对应块表记录 *Paper_Space。实测: 有当前文档时非 0。" @嵌入式方法 = "">
    {
        @ arx_db_paper_space()
    }

    方法 取最后错误 <公开 静态 类型 = 整数 注释 = "读出本线程上一次桥接调用留下的 Acad::ErrorStatus 原值, 或本包自定义哨兵: -1 空对象标识, -2 空指针, -3 类型转换失败, -4 缓冲区不足。实测常用值: 0 eOk, 3 eInvalidInput, 13 eUnknownHandle, 22 eKeyNotFound, 24 eInvalidIndex, 46 eNotThatKindOfClass, 80 eWasErased, 124 eNoDatabase。" @嵌入式方法 = "">
    {
        @ arx_db_last_error()
    }

    方法 取实体数 <公开 静态 类型 = 整数 注释 = "遍历块表记录并跳过已擦除实体后的计数。实测: 空 DWG 的模型空间为 0; 建 3 个实体后为 3; 擦除 1 个后为 2; 全部擦除后回到 0。ObjectARX 里没有 numEntities, 只能遍历, 因此本方法为 O(n)。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    {
        @ arx_db_btr_count(@<块记录>)
    }

    方法 取实体总数 <公开 静态 类型 = 整数 注释 = "遍历块表记录且不跳过已擦除实体后的计数。实测: 空 DWG 为 0, 建 3 个实体后为 3; 全部擦除后本值不确定(实测出现过 1), 因此只用于对比 取实体数, 不参与擦除后的断言。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    {
        @ arx_db_btr_count_all(@<块记录>)
    }

    方法 取实体 <公开 静态 类型 = 变整数 注释 = "按 0 基下标取块记录内第 index 个未擦除实体, 顺序即创建顺序。实测: 越界返回 0 且 取最后错误 = -1; index 为负返回 0 且 取最后错误 = -2。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    参数 下标 <类型 = 整数>
    {
        @ arx_db_btr_entity_at(@<块记录>, @<下标>)
    }

    方法 是否布局 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::isLayout。实测: *Model_Space 为真。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    {
        @ (arx_db_btr_is_layout(@<块记录>) != 0)
    }

    方法 句柄是否有效 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObjectId::isValid。实测: 空标识返回假且不写错误码(取最后错误 保持 0); 实体擦除后本方法仍返回真, 判断擦除要用 是否已擦除。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_id_is_valid(@<对象标识>) != 0)
    }

    方法 是否直线 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObject::isKindOf(AcDbLine::desc())。实测: AcDbLine 为真, 圆与多段线为假; 空标识返回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_entity_is_line(@<对象标识>) != 0)
    }

    方法 是否圆 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObject::isKindOf(AcDbCircle::desc())。实测: AcDbCircle 为真, 直线与多段线为假。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_entity_is_circle(@<对象标识>) != 0)
    }

    方法 是否多段线 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObject::isKindOf(AcDbPolyline::desc()), 只认轻量多段线。实测: AcDbPolyline 为真, 直线与圆为假。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_entity_is_polyline(@<对象标识>) != 0)
    }

    方法 擦除实体 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::erase 后 close。实测: 首次擦除返回真且 取最后错误 = 0; 对同一实体再擦一次返回假且 取最后错误 = 80(eWasErased); 空标识返回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_entity_erase(@<对象标识>) != 0)
    }

    方法 是否已擦除 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::isErased。实测: 擦除成功后为真。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_entity_is_erased(@<对象标识>) != 0)
    }

    方法 取所有者 <公开 静态 类型 = 变整数 注释 = "对应 AcDbEntity::ownerId, 即所在块表记录。实测: 追加到模型空间后等于 取模型空间。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_owner(@<对象标识>)
    }

    方法 取图层标识 <公开 静态 类型 = 变整数 注释 = "对应 AcDbEntity::layerId。实测: 新建实体落在 0 图层, 置实体图层 后等于目标图层标识。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_layer_id(@<对象标识>)
    }

    方法 取句柄数值 <公开 静态 类型 = 变整数 注释 = "对应 AcDbHandle 转 64 位无符号整数。实测: 同一会话内稳定, 但数值随 DWG 与创建次序变化, 只能断言非 0 与 句柄转标识 回环一致, 不能断言具体数字。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_handle64(@<对象标识>)
    }

    方法 句柄转标识 <公开 静态 类型 = 变整数 注释 = "对应 acdbgetObjectId。实测: 与 取句柄数值 回环得到同一对象标识; 句柄 0 返回 0 且 取最后错误 = 13(eUnknownHandle); 句柄 1 在真实 DWG 中确实能解析到对象(返回非 0 且错误 0), 所以不能用它做失败用例。" @嵌入式方法 = "">
    参数 句柄数值 <类型 = 变整数>
    {
        @ arx_db_handle_to_id(@<句柄数值>)
    }

    方法 置实体图层 <公开 静态 类型 = 逻辑型 注释 = "按图层对象标识调用 AcDbEntity::setLayer(AcDbObjectId), 避免文本跨边界。实测: 成功后 取图层标识 等于目标图层标识。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 图层标识 <类型 = 变整数>
    {
        @ (arx_db_entity_set_layer_id(@<对象标识>, @<图层标识>) != 0)
    }

    方法 置实体可见性 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setVisibility, 入参 0 为可见 1 为不可见(与 AcDb::Visibility 实测取值一致: kVisible = 0, kInvisible = 1)。实测: 置 1 后 是否可见 为假, 置 0 后为真。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 可见性 <类型 = 整数>
    {
        @ (arx_db_entity_set_visible(@<对象标识>, @<可见性>) != 0)
    }

    方法 是否可见 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::visibility。实测: 新建实体为真。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_entity_is_visible(@<对象标识>) != 0)
    }

    方法 取颜色索引 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::colorIndex, 回 ACI 编号: 0 为 byBlock, 256 为 byLayer, 1..255 为索引色。失败一律回 -1。实测: 新建直线/圆/多段线都是 256; 置颜色索引 之后原样读回; 空标识回 -1 且 取最后错误 = -1; 已擦除实体回 -1 且 取最后错误 = 80(eWasErased)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_color_index(@<对象标识>)
    }

    方法 置颜色索引 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setColorIndex。实测: 1/7/255/30 四档都成功且 取颜色方法 变 195(kByACI), 256 成功回到 192(kByLayerColor), 0 成功且 取颜色方法 变 193(kByBlockColor)。257/300/65535 三档 Acad 自己拒 假 且 取最后错误 = 24(eInvalidIndex), 属性一位不动; -1 与 65536 由桥在进 AcDb 之前拒收, 取最后错误 = -3(ARX_DB_ERR_CAST), 所以负码与 Acad 码不冲突。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 颜色号 <类型 = 整数>
    {
        @ (arx_db_entity_set_color_index(@<对象标识>, @<颜色号>) != 0)
    }

    方法 取颜色方法 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::entityColor().colorMethod(), 取值是 AcCmEntityColor::ColorMethod 的原值: 192 kByLayerColor, 193 kByBlockColor, 194 kByColor, 195 kByACI, 196 kByPen, 197 kForeground, 198 kLayerOff, 199 kLayerFrozen, 200 kNone。失败回 -1。实测: 默认 192, 索引色 195, byBlock 193, 真彩 194。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_color_method(@<对象标识>)
    }

    方法 取颜色RGB <公开 静态 类型 = 整数 注释 = "把 AcCmEntityColor 的红绿蓝三通道拼成 0x00RRGGBB 一个整数回。失败回 -1。实测: 索引色档并不查色板, 置颜色索引 1/7/255/30 之后本档恒回 0, 只有真彩档给得出值: 置颜色RGB(255,128,0) 回 16744448(=0xFF8000), 置颜色RGB(0,0,0) 回 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_color_rgb(@<对象标识>)
    }

    方法 置颜色RGB <公开 静态 类型 = 逻辑型 注释 = "桥内用栈上 AcCmColor 调 setColor, 三通道各收 0..255 的整数, 不传结构体。任一通道越界(负数或 256)由桥先拒, 取最后错误 = -3。实测: 置真彩后 取颜色方法 = 194, 但 取颜色索引 不会跟着同步(置过色 30 再置橙, 色仍读 30); 置黑(0,0,0) 时 取颜色索引 反而变成 18, 是底层自己折算的索引色。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    {
        @ (arx_db_entity_set_color_rgb(@<对象标识>, @<红>, @<绿>, @<蓝>) != 0)
    }

    方法 取线型名到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_entity_linetype_into 的 字节集 缓冲档, 对应 AcDbEntity::linetype(AcString&)。实测: 新建实体得 ByLayer(长度 7, 首字节 66), 置线型 Continuous 后得 Continuous(长度 10, 首字节 67)。失败档有个跨边界纪律要知道: 桥的空源分支会把 取最后错误 覆写成 -2(ARX_DB_ERR_NULL_POINTER), 所以空标识与已擦除实体这两档读到的都是 -2 而不是 -1/80, 判失败请用返回值与缓冲首字节。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_entity_linetype_into(@<对象标识>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 取线型标识 <公开 静态 类型 = 变整数 注释 = "对应 AcDbEntity::linetypeId, 线型表记录的对象标识。失败回 0。实测: 新建实体就非 0(ByLayer 那条记录), 置线型 之后仍非 0; 空标识回 0 且 取最后错误 = -1, 已擦除实体回 0 且 取最后错误 = 80。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_linetype_id(@<对象标识>)
    }

    方法 置线型名自字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_entity_set_linetype 的 字节集 入参档, 对应 AcDbEntity::setLinetype(const ACHAR*)。实测: Continuous 与 ByLayer 都返回真且 取线型名到字节集 逐字读回; DASHED / NO_SUCH_LTYPE_XYZ / 空名 / 中文名虚线 四档都返回假且 取最后错误 = 22(eKeyNotFound) 且原名不改 —— 本环境未加载 DASHED, 线型名必须在图形的线型表里已经存在。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 名称字节 <类型 = 字节集类>
    {
        @ (arx_db_entity_set_linetype(@<对象标识>, (const char*)@<名称字节>.GetPtr()) != 0)
    }

    方法 置线型标识 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setLinetype(AcDbObjectId), 与按名字的档互补且不过线型表查名这一层。实测: 把 取线型标识 的原值传回去即回环成功且 取线型名 仍是 Continuous; 线型标识传 0 由桥先拒, 返回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 线型标识 <类型 = 变整数>
    {
        @ (arx_db_entity_set_linetype_id(@<对象标识>, @<线型标识>) != 0)
    }

    方法 取线型比例 <公开 静态 类型 = 小数 注释 = "对应 AcDbEntity::linetypeScale。失败回 NaN, 而火山没有 NaN 字面量, 所以判据是 值 == 值 为假。实测: 新建实体为 1; 置 2.5 后自等读回; 置 0.0 返回真且读回 0(0 == 0 仍自等); 空标识与已擦除实体那两档才是非自等。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_linetype_scale(@<对象标识>)
    }

    方法 置线型比例 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setLinetypeScale, 桥不加自己的正数门, 直接把 Acad 的答复原样回。实测: 2.5/0.0/1000000.0 三档都返回真并原样读回; -1.0 返回假且 取最后错误 = 29(eNegativeScale), 比例保持上一次的值。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 比例 <类型 = 小数>
    {
        @ (arx_db_entity_set_linetype_scale(@<对象标识>, @<比例>) != 0)
    }

    方法 取线宽 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::lineWeight, 单位是百分之一毫米, 负值档 -1 byLayer, -2 byBlock, -3 byLwDefault, -4 byDIPs。失败回 -1000(ARX_DB_NO_WEIGHT), 它刻意不占用 -1..-4 与 Acad 码区间, 所以这个哨兵不会和合法值或错误码撞车。实测: 新建实体为 -1; 35 与 211 原样读回; -1/-2/-3 三档都能存住并原样读回。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_line_weight(@<对象标识>)
    }

    方法 置线宽 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbEntity::setLineWeight, 桥把整数原样转成 AcDb::LineWeight 不做白名单。实测: 35/-1/-2/-3/211 五档返回真且 取线宽 原样读回; 7 与 300 与 -4 三档都返回假且 取最后错误 = 151(eInvalidLineWeight), 线宽仍是上一次成功的那个值 —— 能存的负档只有 -1/-2/-3, -4(byDIPs) 在这一层是拒收的。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 线宽 <类型 = 整数>
    {
        @ (arx_db_entity_set_line_weight(@<对象标识>, @<线宽>) != 0)
    }

    方法 取透明度方法 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::transparency 的方法半字节(取的是 AcCmTransparency 的高字节)。0 byLayer, 1 byBlock, 2 byAlpha; kErrorValue 那一档桥不回, 失败统一回 -1。实测: 新建实体为 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_transparency_method(@<对象标识>)
    }

    方法 取透明度值 <公开 静态 类型 = 整数 注释 = "对应 AcDbEntity::transparency 的 alpha 半字节, 0 为不透明, 255 为全透明。失败回 -1。实测: 新建实体为 255, 即默认档是全透明写法但方法走 byLayer 所以图纸上不受影响。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_entity_transparency_alpha(@<对象标识>)
    }

    方法 置透明度 <公开 静态 类型 = 逻辑型 注释 = "桥内用栈上 AcCmTransparency 依次 setMethod/setAlpha, 再把整个对象交给 AcDbEntity::setTransparency。方法传 0..2、透明值传 0..255, 越界由桥先拒且 取最后错误 = -3。实测最关键的一条: 方法传 0 或 1 而同时给了具体 alpha 时, 底层把方法改写成 2(kByAlpha), 所以 置透0明50 读回 2/50、置透1明10 读回 2/10; 想留住 byLayer/byBlock 就别指望这一档, 只有 方法 2 是原样存的。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 透明方法 <类型 = 整数>
    参数 透明值 <类型 = 整数>
    {
        @ (arx_db_entity_set_transparency(@<对象标识>, @<透明方法>, @<透明值>) != 0)
    }

    方法 新建直线 <公开 静态 类型 = 变整数 注释 = "new AcDbLine 后 appendAcDbEntity 到块记录并 close。实测: 返回的对象标识非 0、句柄有效且 是否直线 为真。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 起点Z <类型 = 小数>
    参数 终点X <类型 = 小数>
    参数 终点Y <类型 = 小数>
    参数 终点Z <类型 = 小数>
    {
        @ arx_db_add_line(@<块记录>, @<起点X>, @<起点Y>, @<起点Z>, @<终点X>, @<终点Y>, @<终点Z>)
    }

    方法 取直线起点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbLine::startPoint, 结果写入调用方已创建好的 ARX点3D。实测: 写入精确无舍入; 空标识返回假且 取最后错误 = -1; 出参指针为 0 时返回假且 取最后错误 = -2; 对圆调用返回假且 取最后错误 = 46(eNotThatKindOfClass); 对已擦除实体返回假且 取最后错误 = 80。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 结果点 <类型 = 变整数>
    {
        @ (arx_db_line_start(@<对象标识>, @<结果点>) != 0)
    }

    方法 取直线终点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbLine::endPoint, 结果写入调用方已创建好的 ARX点3D。实测口径同 取直线起点。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 结果点 <类型 = 变整数>
    {
        @ (arx_db_line_end(@<对象标识>, @<结果点>) != 0)
    }

    方法 置直线端点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbLine::set。实测: 写入后 取直线起点/取直线终点 读回同一组坐标。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 起点Z <类型 = 小数>
    参数 终点X <类型 = 小数>
    参数 终点Y <类型 = 小数>
    参数 终点Z <类型 = 小数>
    {
        @ (arx_db_line_set(@<对象标识>, @<起点X>, @<起点Y>, @<起点Z>, @<终点X>, @<终点Y>, @<终点Z>) != 0)
    }

    方法 新建圆 <公开 静态 类型 = 变整数 注释 = "new AcDbCircle 后追加。实测: 返回对象标识非 0 且 是否圆 为真。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
