        @ arx_db_curve_end_param(@<对象标识>)
    }

    方法 取参数点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbCurve::getPointAt(param, AcGePoint3d&), 结果写入调用方已创建好的 ARX点3D。实测: 直线参数 2.5 得 (1.5, 2, 0)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
