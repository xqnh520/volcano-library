        @ arx_db_circle_radius(@<对象标识>)
    }

    方法 置半径 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbCircle::setRadius。实测: 半径 2 改为 5 后 取半径 = 5, 圆周长同步由 12.5663706143592 变为 31.4159265358979。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
