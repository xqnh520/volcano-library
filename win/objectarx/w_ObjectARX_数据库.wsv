        @ (arx_db_text_bounding_at (@<对象标识>, @<下标>, @<结果点>) != 0)
    }

    方法 取内容 <公开 静态 类型 = 文本型 注释 = "取内容 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取内容到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 高档 1024 字节自分配: [改后中文DEF] 长=7 码=0, 90 字中文读回长=90; 空标识、直线标识、已擦除三类失败一律回空文本且 取最后错误 = -2。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX文字.取内容到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取内容原样 <公开 静态 类型 = 文本型 注释 = "取内容原样 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取内容原样到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 与 取内容 同轮同值 [改后中文DEF] 长=7 码=0。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX文字.取内容原样到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

}


类 ARX多行文字 <公开
        注释 = "多行文字实体 AcDbMText 的公开档, 包A 必做#2 的第二层; 形状纪律与 ARX文字 逐条相同。"
        注释 = "内容族三条(带格式代码的 contents、剥格式的 text、RTF)都是 字节集 + 文本型 两档; 写入侧 setContents 与 setContentsRTF 回的是 SDK 的 MTextReturnCode 整数码而非 Acad 码, 非零码原样留在 取最后错误 里, 配套 取返回码说明 读文本。"
        注释 = "排版量(取上伸、取下伸、取实际宽度、取实际高度)只有排版之后才有值, 缺省对象的读数见各档注释。"
        注释 = "背景族(填充、用背景色、真彩 RGB、比例、透明度)全部在 AcDbMText 自己的背景结构里, 与实体通用属性的 置背景色 不是同一件事。"
        注释 = "附着点值表(dbmtext.h 150 行): 1 TopLeft, 2 TopCenter, 3 TopRight, 4 MiddleLeft, 5 MiddleCenter, 6 MiddleRight, 7 BottomLeft, 8 BottomCenter, 9 BottomRight, 10..24 SDK 全标 Reserved for future use 且实测被库拒(码=3), 能用的是 1..9; 文字流向只有 1 kLtoR / 3 kTtoB / 5 kByStyle 落得进(2 与 4 注明不支持), 行距样式是 AcDb::LineSpacingStyle 的 1 kAtLeast 与 2 kExactly 两档。"
        注释 = "同一轮实测: 缺省内容含换行 (取内容到字节集 得 [第一行\n第二行ABC] 长=11, 纯文本档剥掉换行得长=10), 缺省插入点 40/20/0、法向 0/0/1、文字方向 1/0/0、旋转角 0、文字宽度 30(即新建给的宽度)、字高 3、附着点 1、文字流向 5(kByStyle)、行距样式 1、行距因子 1、背景三旗标全假、背景色RGB 0、背景比例 1.5、透明方式 0、Alpha 255、平面性 1。"
        注释 = "富文本两条通道都不是回原样: 置富文本({\H2x;富文本ABC}) 被底层重排成完整 RTF 文档 ({\rtf1\ansi{\fonttbl...}\pard\plain\f0\cf0\fs48 x;\u23500?\u25991?\u26412?ABC\par }), 且 {\H2x;} 的字号倍率没保住 —— 置后 取纯文本 得 [x;富文本ABC] 长=8, 反斜杠 H 段被吃掉只余 “x;”, 排版字高 fs48 仍是 24pt 量级。">
{
    方法 是否多行文字 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObject::isKindOf(AcDbMText::desc()); 空标识回假且 取最后错误 = -1。 实测: 多行文字回真, 单行文字与直线都回假; 空标识紧随的 取最后错误 = -1。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_is_mtext (@<对象标识>) != 0)
    }

    方法 新建多行文字 <公开 静态 类型 = 变整数 注释 = "new AcDbMText 后依次 setLocation / setContents / setTextHeight / setWidth / setTextStyle, 再 appendAcDbEntity 并 close; 样式标识 0 为不指定。 实测: 建 40/20/0 内容含 \r\n 字高3 宽度30 样式标识传 0 回非零且 取最后错误 = 0; 样式标识传 新建样式 标识那条读到 与样相等=真; 块记录传 0 回 0 码=-1。" @嵌入式方法 = "">
    参数 块记录 <类型 = 变整数>
    参数 插入点X <类型 = 小数>
    参数 插入点Y <类型 = 小数>
    参数 插入点Z <类型 = 小数>
    参数 内容 <类型 = 文本型>
    参数 字高 <类型 = 小数>
    参数 宽度 <类型 = 小数>
    参数 样式标识 <类型 = 变整数>
    {
        @ arx_db_add_mtext (@<块记录>, @<插入点X>, @<插入点Y>, @<插入点Z>, @<内容>.GetText (), @<字高>, @<宽度>, @<样式标识>)
    }

    方法 取内容到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_db_mtext_contents_into 的 字节集 缓冲档, 对应 AcDbMText::contents(AcString&), 含格式代码。 实测: [第一行 换行 第二行ABC] 长=11 字0=-25(0xE7) 码=0, 缓冲里带真换行符。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_mtext_contents_into (@<对象标识>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 取纯文本到字节集 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::text(AcString&), 剥掉格式代码后的纯文本。 实测: [第一行第二行ABC] 长=10 码=0 —— 与上一条差的正是被剥掉的换行。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_mtext_plain_text_into (@<对象标识>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 取富文本到字节集 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::contentsRTF(AcString&)。 实测: 初始内容就得到完整 RTF: {\rtf1\ansi{\fonttbl{\f0\fswiss\fprq2\fcharset0 Arial;}}... 长=178 字0=123 码=0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_mtext_rtf_into (@<对象标识>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 置内容 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setContents; 该档回的是 MTextReturnCode 整数码而非 Acad 码, 桥把非零码原样留在 取最后错误 里。 实测: 置 改写一\r\n改写二中文 码=0, 高档读回 [改写一\n改写二中文]。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 内容 <类型 = 文本型>
    {
        @ (arx_db_mtext_set_contents (@<对象标识>, @<内容>.GetText ()) != 0)
    }

    方法 置富文本 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setContentsRTF; 非零返回码同样留在 取最后错误 里。 实测: 置 {\H2x;富文本ABC} 码=0, 富文本档读到重排后的整篇 RTF(长=144), 纯文本档读到 [x;富文本ABC] 长=8。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 内容 <类型 = 文本型>
    {
        @ (arx_db_mtext_set_contents_rtf (@<对象标识>, @<内容>.GetText ()) != 0)
    }

    方法 取返回码说明到字节集 <公开 静态 类型 = 逻辑型 注释 = "把 setContents 族返回码翻成说明文本, 序号 0..18 定长枚举; 表外序号(实测 19 与 -1)走 writeUtf8 的空源档, 成=假 且 取最后错误 = -2, 不是桥自拒的 -3。 实测: 序号 0..18 全 成=真 码=0: 0=\~ 1=\O 2=\o 3=\L 4=\l 5=\C 6=\F 7=\H 8=\W 9=\Q 10=\T 11=\p 12=\P 13=\S 14=\A 15={ 16=} 17=\K 18=\k (前两字节含反斜杠的字面量, 15/16 是花括号); 序号 19 成=假 [] 码=-2 —— 越界先落 CAST 再被 writeUtf8 的空源档覆写成 -2。; 序号 -1 与序号 19 同一个形状: 成=假 [] 码=-2, 表外一律走空源档, 不是 CAST 的 -3。" @嵌入式方法 = "">
    参数 序号 <类型 = 整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_db_mtext_code_into (@<序号>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 取插入点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::location, 结果写入 ARX点3D。 实测: 新建给 (40,20,0) 读到 40/20/0 码=0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 结果点 <类型 = 变整数>
    {
        @ (arx_db_mtext_location (@<对象标识>, @<结果点>) != 0)
    }

    方法 置插入点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbMText::setLocation。 实测: 置 (45.5,-6.25,2.0) 码=0 回读 45.5/-6.25/2。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
