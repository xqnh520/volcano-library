    }

    方法 取曲线长度 <公开 静态 类型 = 小数 注释 = "ObjectARX 的 AcDbCurve 没有 getLength, 底层用 getEndParam + getDistAtParam 组合。实测: 直线 (0,0,0)-(3,4,0) 为 5; 开口三段多段线 (0,0)(4,0)(4,3) 为 7; 同一条置闭合后为 12; 半径 2 的圆为 12.5663706143592。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_curve_length(@<对象标识>)
    }

    方法 取曲线面积 <公开 静态 类型 = 小数 注释 = "对应 AcDbCurve::getArea。实测: 直线返回 0 且 取最后错误 = 0(即 eOk, 不是失败); 半径 2 的圆返回 12.5663706143592; 开口三段多段线返回 6, 置闭合后仍为 6。" 注释 = "注意半径 2 是 2*PI*r 与 PI*r*r 的数值重合点(同为 4*PI), 所以这条实测值只能证明 取曲线面积 对圆可用, 不能用来区分圆面积与周长两个公式; 需要区分时另取一个不同半径的圆重新实测。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_curve_area(@<对象标识>)
    }

    方法 取起始参数 <公开 静态 类型 = 小数 注释 = "对应 AcDbCurve::getStartParam。实测: 直线、圆、多段线均为 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_db_curve_start_param(@<对象标识>)
    }

    方法 取终止参数 <公开 静态 类型 = 小数 注释 = "对应 AcDbCurve::getEndParam。实测: 直线 (0,0,0)-(3,4,0) 为 5(弧长参数化, 与长度相等); 圆为 6.28318530717959(即 2*PI); 多段线按各段长度累加。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
