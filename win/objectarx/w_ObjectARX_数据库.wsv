    方法 取内容 <公开 静态 类型 = 文本型 注释 = "取内容 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取内容到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 高档读回 [x;富文本ABC] 长=8 —— 内容与纯文本同源, 置富文本 后含被吃掉的 “x;”。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX多行文字.取内容到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取纯文本 <公开 静态 类型 = 文本型 注释 = "取纯文本 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取纯文本到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: [x;富文本ABC] 长=8, 与 取内容 同值。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX多行文字.取纯文本到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取富文本 <公开 静态 类型 = 文本型 注释 = "取富文本 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取富文本到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 整篇重排 RTF 长=144, 字体表换成 {\f0\fnil\fcharset134 System;}。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX多行文字.取富文本到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取返回码说明 <公开 静态 类型 = 文本型 注释 = "取返回码说明 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取返回码说明到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 序号 0 得 [\~] 码=0; 序号 19 得空文本且 取最后错误 = -2, 与字节集档同口径。">
    参数 序号 <类型 = 整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX多行文字.取返回码说明到字节集 (序号, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

}


类 ARX文字样式 <公开
        注释 = "文字样式表 AcDbTextStyleTable 与 AcDbTextStyleTableRecord 的公开档, 包A 必做#2 的第三层; 形状纪律与前两类逐条相同。"
        注释 = "样式表活在 AcDbDatabase 的符号表里, 桥通过 db->getSymbolTable 打开, 所以本类不设表句柄入口: 表级五条(取样式数、按下标取样式、按名字取样式、样式是否存在、新建样式)直接对当前工作库答题。"
        注释 = "样式记录标识跨边界仍是 变整数, 交给 ARX文字.置样式标识 或 ARX多行文字.置样式标识 使用。"
        注释 = "字体文件名族以 ASCII 路径为主, 但仍按 UTF8 过界, 中文名照样读得回。"
        注释 = "flagBits 是 8 位原始量, 但与 是否形文件、是否竖排 两个布尔视图不共用一份位: 实测 置标志位(255) 之后两旗照旧假, 置 形/竖 旗只把 取标志位 带到 1 且清旗不回落 —— 三条通道各读各的, 谁也不许当谁的视图用。"
        注释 = "表内初始 3 条: 下标 0=[Standard] 1=[Annotative] 2=[新建样式] 的 P189样式; 新建重名两次返回同一标识且 取样式数 不再加、取最后错误 = 0; 空名新建回 0 码=3(eInvalidInput)。"
        注释 = "按名字取不存在回 0 且 取最后错误 = 22(eKeyNotFound); 样式是否存在 无论存在与否都让 取最后错误 停在 0(桥不落码), 判定只能看返回值; 按下标取样式越界(等于样式数)回 0 而码仍为 0, 负下标回 0 且码=-3。">
{
    方法 取样式数 <公开 静态 类型 = 整数 注释 = "遍历 AcDbTextStyleTable 后的记录数, 失败回 -1。 实测: 3 码=0(Standard/Annotative/新建的那条); 空标识式的失败在本档不存在, 越界判定交给 按下标取样式。" @嵌入式方法 = "">
    {
        @ arx_db_style_count ()
    }

    方法 按下标取样式 <公开 静态 类型 = 变整数 注释 = "按下标取文字样式记录标识: 下标 = 样式数 时回 0 而 取最后错误 停在 0(库自己不给码), 负下标由桥自拒 码=-3。 实测: 下标 0..2 依次得非零标识且 取样式名 读出 [Standard]/[Annotative]/[P189样式]; 下标 = 样式数 回 0 码=0; 下标 -1 回 0 码=-3。" @嵌入式方法 = "">
    参数 下标 <类型 = 整数>
    {
        @ arx_db_style_at (@<下标>)
    }

    方法 按名字取样式 <公开 静态 类型 = 变整数 注释 = "对应 acdbSymbolTable::getAt 的名字档, 不存在回 0 且 取最后错误 = 22(eKeyNotFound) —— 本类里只有这一条留 Acad 码。 实测: “Standard” 回非零码=0; 绝无名 回 0 码=22(eKeyNotFound) —— 这一条确实留 Acad 码, 与 样式是否存在 不同。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    {
        @ arx_db_style_get_at (@<名称>.GetText ())
    }

    方法 样式是否存在 <公开 静态 类型 = 逻辑型 注释 = "对应 acdbSymbolTable::has; 只以返回值表态, 存在、不存在、空名三种问法之后 取最后错误 都停在 0, 判定别看错误槽。 实测: “Standard” 真、绝无名 假、空名 假, 三次之后 取最后错误 都是 0 —— 本档只以返回值表态, 注释里原先承诺的错误码不成立。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    {
        @ (arx_db_style_exists (@<名称>.GetText ()) != 0)
    }

    方法 新建样式 <公开 静态 类型 = 变整数 注释 = "确保所给名字的文字样式存在并返回记录标识, 已存在时返回同一标识且 取样式数 不再加、码=0; 空名回 0 且 取最后错误 = 3(eInvalidInput)。 实测: “P189样式” 回非零且 取样式名 读回同名, 码=0; 同名第二次回与第一次相等的标识、码=0、样式数不变; 空名回 0 码=3。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    {
        @ arx_db_style_ensure (@<名称>.GetText ())
    }

    方法 取样式名到字节集 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbTextStyleTableRecord::name。 实测: [P189样式] 长=6 字0=80 码=0 —— 名称是 ASCII 时首字节即字母。" @嵌入式方法 = "">
    参数 样式标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
