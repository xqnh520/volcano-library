    }

    方法 取标志位 <公开 静态 类型 = 整数 注释 = "对应 AcDbTextStyleTableRecord::flagBits 的原始 8 位, 失败回 -1; 实测与 是否形文件、是否竖排 两族不同轨(位写到 255 两旗照旧双假)。 实测: 新建读到 0; 置 1 后回读 1; 置形文件标志 与 置竖排标志 之后回读仍是 1 —— 这两族不同步, 标志位 不是形/竖两旗的或值。" @嵌入式方法 = "">
    参数 样式标识 <类型 = 变整数>
    {
        @ arx_db_style_flag_bits (@<样式标识>)
    }

    方法 置标志位 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbTextStyleTableRecord::setFlagBits; 值域 0..255(255 整字节可写), 越出(实测 256 与 -1)由桥自拒且 取最后错误 = -3, 原值不动。 实测: 置 1 码=0 回读 1 而 是否形文件 与 是否竖排 都仍假。; 255 整字节可写(码=0 回读 255)而 是否形文件 与 是否竖排 依旧双假, 再次证明两族不同轨; 置 256 与 置 -1 都由桥自拒 码=-3 且原值不动。" @嵌入式方法 = "">
    参数 样式标识 <类型 = 变整数>
    参数 位 <类型 = 整数>
    {
        @ (arx_db_style_set_flag_bits (@<样式标识>, @<位>) != 0)
    }

    方法 是否形文件 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbTextStyleTableRecord::isShapeFile; 失败回假。 实测: 新建假; 置形文件标志(1) 后真; 置 0 后假。" @嵌入式方法 = "">
    参数 样式标识 <类型 = 变整数>
    {
        @ (arx_db_style_is_shape_file (@<样式标识>) != 0)
    }

    方法 置形文件标志 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbTextStyleTableRecord::setIsShapeFile; 开关 0 为关, 非 0 为开。 实测: 置 1 码=0 回读真 标志位=1; 置 0 码=0 回读假 标志位仍 1(清不掉位值)。" @嵌入式方法 = "">
    参数 样式标识 <类型 = 变整数>
    参数 开关 <类型 = 整数>
    {
        @ (arx_db_style_set_is_shape_file (@<样式标识>, @<开关>) != 0)
    }

    方法 是否竖排 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbTextStyleTableRecord::isVertical; 失败回假。 实测: 新建假; 置竖排标志(1) 后真。" @嵌入式方法 = "">
    参数 样式标识 <类型 = 变整数>
    {
        @ (arx_db_style_is_vertical (@<样式标识>) != 0)
    }

    方法 置竖排标志 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbTextStyleTableRecord::setIsVertical; 开关 0 为关, 非 0 为开。 实测: 置 1 码=0 回读真 位=1; 置 0 码=0 回读假。" @嵌入式方法 = "">
    参数 样式标识 <类型 = 变整数>
    参数 开关 <类型 = 整数>
    {
        @ (arx_db_style_set_is_vertical (@<样式标识>, @<开关>) != 0)
    }

    方法 取样式名 <公开 静态 类型 = 文本型 注释 = "取样式名 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取样式名到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 新建样式读回 [P189样式] 码=0; 空标识回空文本且 取最后错误 = -2, 与实体侧的 到字节集 高档同口径。">
    参数 样式标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX文字样式.取样式名到字节集 (样式标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取字体文件名 <公开 静态 类型 = 文本型 注释 = "取字体文件名 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取字体文件名到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 置 “simhei.ttf” 后高档读回同值; 置空串后 [] 长=0。">
    参数 样式标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX文字样式.取字体文件名到字节集 (样式标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取大字体文件名 <公开 静态 类型 = 文本型 注释 = "取大字体文件名 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取大字体文件名到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。缓冲不足(-4)与实体失败一律回空文本。 实测: 置 “simsun” 后高档读回 [simsun]。">
    参数 样式标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX文字样式.取大字体文件名到字节集 (样式标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

}

类 ARX块表 <公开
        注释 = "块表 AcDbBlockTable 与块表记录 AcDbBlockTableRecord 的公开档, 包A 必做#3 的块定义层。每条入口自己就是一个 @嵌入式方法 档, 本类没有底层转发档 —— 按裁定与 OCCT 范本(occt_2d.wsv 每个公开类只有嵌入档, 转发条数 0)不做重复封装; 只有 取注释 一条按 必做#2 的口径另配 文本型 高档。"
        注释 = "块表记录标识与实体标识是同一种跨边界形状: AcDbObjectId 按位当 变整数 传, 0 就是空标识。块记录名不在本类重复提供, 用 类 ARX数据库文本 的 取块记录名。"
        注释 = "块名与注释的文本通道两档: 入参 文本型 直接 .GetText() 交给桥的 const wchar_t*; 出参 字节集 缓冲 + UTF8到文本, 容量口径是 UTF8 字节数再加一个结束零字符, 装不下即 成=假 且 取最后错误 = -4, 同时缓冲首字节被写成 0, 因此高档回空文本。"
        注释 = "失败哨兵: 整数档回 -1, 句柄档回 0, 逻辑档回假; 空标识一律 取最后错误 = -1, 空出参指针 -2, 枚举越界由桥自拒 -3, 缓冲不足 -4, 库自己拒的按 Acad 码原值(3 eInvalidInput、22 eKeyNotFound、46 eNotThatKindOfClass、95 eDuplicateRecordName)。本轮实测过零句柄的八档同一条形状: 是否匿名块 与 置基点、置注释、擦块 回假, 取参照状态、取参照数、取缩放方式、取插入单位 回 -1, 且 取最后错误 = -1。"
        注释 = "以下全部数值出自本机 AutoCAD 2026 (R25) 全新空白 DWG 的一轮实测(探针 128 行读数, 跑完即删): 空白图块表 3 条记录, 顺序为 *Model_Space、*Paper_Space、*Paper_Space0, 三条都是 匿名=假 属性定义=假 来自参照=假 状=0 缩放=0 分解=真 单位=0 参照数=0。">
{
    方法 取块数 <公开 静态 类型 = 整数 注释 = "对应 AcDbBlockTable 遍历并跳过已擦除后的记录条数。实测: 全新空白 DWG 为 3; 每 新建块 成功一条就加 1, 每 擦块 成功一条就减 1(擦 *Model_Space 也照样减 1)。" @嵌入式方法 = "">
    {
        @ arx_blk_count()
    }

    方法 取块按下标 <公开 静态 类型 = 变整数 注释 = "按 0 基下标取块表记录标识, 顺序即块表迭代顺序。实测: 下标 0 与 取模型空间 相等, 1 的名字是 *Paper_Space, 2 的名字是 *Paper_Space0; 下标为负回 0 且 取最后错误 = -2, 越界回 0 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 下标 <类型 = 整数>
    {
        @ arx_blk_at(@<下标>)
    }

    方法 取块按名字 <公开 静态 类型 = 变整数 注释 = "对应 AcDbBlockTable::getAt(name, id)。实测: 传 *Model_Space 回到的标识与 取块按下标(0) 相等且 取最后错误 = 0; 名字不存在回 0 且 取最后错误 = 22(eKeyNotFound); 传空文本时若图里没有空名记录同样是 0 与 22, 一旦 新建块(空文本) 建出过空名记录, 空文本就能命中它并回非 0 且 码 = 0; 含空格的块名可以按原样整名寻回。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    {
        @ arx_blk_id_by_name(@<名称>.GetText())
    }

    方法 块是否存在 <公开 静态 类型 = 逻辑型 注释 = "名字是否在块表里。实测: 存在回真、不存在回假, 两种读法之后 取最后错误 都是 0, 这条档不用错误码表态; 建过空名记录后传空文本回真。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    {
        @ (arx_blk_exists(@<名称>.GetText()) != 0)
    }

    方法 新建块 <公开 静态 类型 = 变整数 注释 = "纯新建 AcDbBlockTableRecord 后 setName 再 add 入块表; 重名时不复用既有记录, 直接把请求交给 AcDb 拒。实测: 中文名 P191块甲 回非 0 且 码 = 0, 建成的记录 基点 (0,0,0)、分解=真、参照数=0; 与已有记录重名回 0 且 码 = 95(eDuplicateRecordName); 带空格的名字可建; 空文本可建, 建成的记录名就是空文本; 分号名与尖角名回 0 且 码 = 3(eInvalidInput), 竖线名可建; 256 个中文字的长名可建且读回长度仍是 256; 记录被 擦块 之后同名可以再建(码 = 0)。" @嵌入式方法 = "">
    参数 名称 <类型 = 文本型>
    {
        @ arx_blk_add(@<名称>.GetText())
    }

    方法 擦块 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObject::erase 打开块表记录后擦自身。实测: 未被参照的记录擦成功(码 = 0, 之后 块是否存在 回假); 仍被参照指向的记录也擦成功(码 = 0), 擦后 取参照数 回 -1 而留下的块参照变成悬空指向; 记录里还有实体时同样擦成功; *Model_Space 也擦得动(成=真 码=0), 本层不做任何保护, 业务侧要自己拦住; 标识传 0 回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ (arx_blk_erase(@<块标识>) != 0)
    }

    方法 是否匿名块 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::isAnonymous。实测: 三条系统记录与 新建块 建出的记录都回假, 空名记录也回假; 标识传 0 回假且 取最后错误 = -1。匿名性由 AcDb 自己维护, 本包只读不写。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ (arx_blk_is_anonymous(@<块标识>) != 0)
    }

    方法 是否含属性定义 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::hasAttributeDefinitions。实测: 空白 DWG 的三条系统记录与 新建块 建出的空记录一律回假且 码 = 0; 往里 新建属性定义 一条后回真, 擦掉记录里的一条而还剩一条时仍是真, 全部擦完回到假; 例外形状: 记录本身没有属性定义、只是它的某个块参照挂了属性实体时照样回假, 属性实体不改动记录的属性定义旗标。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ (arx_blk_has_attrib_definitions(@<块标识>) != 0)
    }

    方法 是否来自外部参照 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::isFromExternalReference。实测: 无外部参照的空白 DWG 里三条系统记录与新建记录一律回假。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ (arx_blk_is_from_xref(@<块标识>) != 0)
    }

    方法 是否来自叠加参照 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::isFromOverlayReference。实测口径同 是否来自外部参照, 无参照图里一律假。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ (arx_blk_is_from_overlay(@<块标识>) != 0)
    }

    方法 取参照状态 <公开 静态 类型 = 整数 注释 = "对应 AcDbBlockTableRecord::xrefStatus 的原值, 返回按值不返回指针。实测: 无参照时系统记录与新建记录都是 0(kNotReferenced); 标识传 0 回 -1 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ arx_blk_xref_status(@<块标识>)
    }

    方法 取基点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::origin, 结果写入调用方已创建好的 ARX点3D。实测: 新建记录读到 (0,0,0) 且 码 = 0; 置基点 后读到 (1.5,2.5,3.5) 逐分量精确相等; 出参指针传 0 回假且 取最后错误 = -2, 记录本身不动。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 结果点 <类型 = 变整数>
    {
        @ (arx_blk_origin_into(@<块标识>, @<结果点>) != 0)
    }

    方法 置基点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::setOrigin(AcGePoint3d)。实测: 置 (1.5,2.5,3.5) 回真且 码 = 0, 紧接 取基点 逐分量精确读回; 复位 (0,0,0) 同样成=真; 对 取块按名字 命中的记录同样写得进(码 = 0); 标识传 0 回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ (arx_blk_set_origin(@<块标识>, @<X>, @<Y>, @<Z>) != 0)
    }

    方法 取参照数 <公开 静态 类型 = 整数 注释 = "对应 AcDbBlockTableRecord::getBlockReferenceIds(ids, bDirectOnly=true, bGlobalOnly=false) 的条数, 即直接指向本记录且未擦除的块参照数。实测: 同一记录被建两条块参照后为 2; 没人指向的记录为 0; 对 *Model_Space 自己调用也是 0(参照计数只数指向本记录的参照, 不数本记录里的实体); 记录已擦后回 -1; 参照被 擦除实体 之后回到 0 且 码 = 0; 标识传 0 回 -1 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ arx_blk_ref_count(@<块标识>)
    }

    方法 取参照按下标 <公开 静态 类型 = 变整数 注释 = "同一份 getBlockReferenceIds 数组按 0 基下标取参照标识, 计数与取用走同一条口径。实测: 两条参照按创建顺序排在 0 与 1, 读回的标识与 新建块参照 的返回值逐条相等; 下标越界回 0 且 取最后错误 = -1, 下标为负回 0 且 取最后错误 = -2。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 下标 <类型 = 整数>
    {
        @ arx_blk_ref_at(@<块标识>, @<下标>)
    }

    方法 取注释到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_blk_comments_into 的 字节集 缓冲档, 对应 AcDbBlockTableRecord::comments(AcString&) 写出 UTF8。实测: 新建记录读到空文本(长 0, 首字节 0, 码 = 0); 置注释 块注释十二字 后逐字相等读到 长=6、首字节 -27(即 UTF8 首字节 0xE5); 128 个中文字(UTF8 共 384 字节)时 64 字节与 384 字节缓冲都 成=假 且 取最后错误 = -4 并把首字节清 0, 385 字节才成=真 读到 长=128 且第 384 字节为 0(结束零字符), 4096 字节缓冲同值; 置空文本后读到长 0。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_blk_comments_into(@<块标识>, (char*)@<缓冲>.GetPtr(), @<缓冲尺寸>) != 0)
    }

    方法 置注释 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::setComments(const ACHAR*)。实测: 中文注释与 128 字长文都 成=真 码=0; 置空文本回真且读回长 0; 标识传 0 回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 内容 <类型 = 文本型>
    {
        @ (arx_blk_set_comments(@<块标识>, @<内容>.GetText()) != 0)
    }

    方法 取注释 <公开 静态 类型 = 文本型 注释 = "取注释 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取注释到字节集、再 UTF8到文本; 结束零字符就是读出契约, 所以本档不回字节数。实测: 置 块注释十二字 后高档读回长=6 逐字相等; 置 128 字长文后高档读回长=128; 空标识一律回空文本。按 385 字节的实测容量口径推算, 1024 字节容到 341 个中文, 再长的注释要自己用 取注释到字节集 放大缓冲。">
    参数 块标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX块表.取注释到字节集 (块标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取缩放方式 <公开 静态 类型 = 整数 注释 = "对应 AcDbBlockTableRecord::blockScaling 原值, 0 kAny、1 kUniform。实测: 新建记录缺省 0; 置 1 回读 1, 置 0 回读 0; 标识传 0 回 -1 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ arx_blk_scaling(@<块标识>)
    }

    方法 置缩放方式 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::setBlockScaling。实测: 0 与 1 都 成=真 码=0 并按档回读; 2 与 -1 由桥在进库之前自拒, 成=假 且 取最后错误 = -3, 记录原值不动。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 值 <类型 = 整数>
    {
        @ (arx_blk_set_scaling(@<块标识>, @<值>) != 0)
    }

    方法 是否可分解 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::explodable。实测: 空白 DWG 三条系统记录与新建记录都是真; 置假 后读回假, 再置真 读回真, 两次都 码 = 0。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ (arx_blk_is_explodable(@<块标识>) != 0)
    }

    方法 置可分解 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::setExplodable。实测: 置假与置真都 成=真 码=0 且立刻读回同值。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_blk_set_explodable(@<块标识>, @<值>) != 0)
    }

    方法 取插入单位 <公开 静态 类型 = 整数 注释 = "对应 AcDbBlockTableRecord::blockInsertUnits, 值表是 AcDb::UnitsValue 的 0..24。实测: 新建记录缺省 0; 置 4 回读 4, 置 24 回读 24; 标识传 0 回 -1 且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ arx_blk_insert_units(@<块标识>)
    }

    方法 置插入单位 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockTableRecord::setBlockInsertUnits。实测: 4 与 24 都 成=真 码=0 并按档回读; 25 与 -1 由桥在进库之前自拒, 成=假 且 取最后错误 = -3。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 值 <类型 = 整数>
    {
        @ (arx_blk_set_insert_units(@<块标识>, @<值>) != 0)
    }

    方法 取属性定义数 <公开 静态 类型 = 整数 注释 = "遍历块表记录、只留 AcDbAttributeDefinition 且跳过已擦除后的计数, 走的是 取实体数 同一条 newIterator(true, true) 通道。实测: 新建的空记录为 0 且 码 = 0; 每 新建属性定义 成功一条加 1(建两条后为 2); 擦掉一条后回到 1, 全部擦完回到 0, 而同一条记录在全部擦完后的 取实体总数 实测仍是 1, 所以擦除后的断言只认本档。模型空间标识照样可数(往里建了一条属性定义后读到 1); 对直线标识调用回 -1 且 取最后错误 = 46(eNotThatKindOfClass), 标识传 0 回 -1 且 码 = -1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    {
        @ arx_blk_attdef_count(@<块标识>)
    }

    方法 取属性定义按下标 <公开 静态 类型 = 变整数 注释 = "同一份走查按 0 基下标取属性定义标识, 顺序即创建顺序, 计数口径与 取属性定义数 完全一致。实测: 只有一条时下标 0 非零且 码 = 0、下标 1 回 0 且 取最后错误 = -1; 建第二条后下标 1 与第二条逐位相等; 下标传负回 0 且 码 = -2; 擦掉第一条之后余下那条自动顶到 0(下标 0 等于剩下的那条且 码 = 0), 同标签的两条定义也照创建顺序排在 0 与 1。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 下标 <类型 = 整数>
    {
        @ arx_blk_attdef_at(@<块标识>, @<下标>)
    }
}

类 ARX块参照 <公开
        注释 = "块参照 AcDbBlockReference 的公开档, 包A 必做#3 的插入层。每条入口自己就是一个 @嵌入式方法 档, 无底层转发档 —— 按裁定与 OCCT 范本不做重复封装。"
        注释 = "几何出参(插入点)跨边界的是 AcGe 桥创建的句柄, 由调用方先 创建 好 ARX点3D 再传 对象指针; 比例、法向这类三分量按三条独立读档给出, 不做数组通道。"
        注释 = "失败哨兵: 整数档回 -1, 小数档回非自等值(NaN), 句柄档回 0, 逻辑档回假; 空标识 -1、空出参指针 -2、库拒按 Acad 码原值(46 eNotThatKindOfClass、153 eDegenerateGeometry)。参照标识传 0 的本轮实测过五档同一条形状: 取属性数 回 -1、取比例X 与 取旋转角 回非自等值、取指向块 回 0、置指向块 回假, 且 取最后错误 = -1。"
        注释 = "以下全部数值出自本机 AutoCAD 2026 (R25) 全新空白 DWG 同一轮实测: 新建块参照的缺省是 比例 1/1/1、旋转 0、法向 0/0/1、属性数 0, 插入点就是 新建块参照 传进去的那三个坐标。">
{
    方法 新建块参照 <公开 静态 类型 = 变整数 注释 = "new AcDbBlockReference(AcGePoint3d, 块标识) 后追加到 宿主块记录 并 close。实测: 往 *Model_Space 指向新建记录建参照回非 0 且 码 = 0, 同一记录再建第二条同样成功, 该记录的 取参照数 随之为 2; 块标识传 0 回 0 且 取最后错误 = -1, 宿主传 0 回 0 且 码 = -1; 块标识传一条直线的标识时回 0 且 取最后错误 = 46(eNotThatKindOfClass), 参照不会留下。" @嵌入式方法 = "">
    参数 宿主块 <类型 = 变整数>
    参数 块标识 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ arx_bref_add(@<宿主块>, @<块标识>, @<X>, @<Y>, @<Z>)
    }

    方法 取指向块 <公开 静态 类型 = 变整数 注释 = "对应 AcDbBlockReference::blockTableRecord。实测: 新建后读回与 新建块参照 传的块标识相等且 取最后错误 = 0; 参照标识传 0 回 0 且 码 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_block_id(@<参照标识>)
    }

    方法 置指向块 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockReference::setBlockTableRecord。实测: 改指另一条记录 成=真 码=0, 读回等于新记录, 且两条记录的 取参照数 各自跟着变成 1/1; 传 0 回假且 取最后错误 = -1, 原指向不动; 传一条直线的标识竟然 成=真 码=0 并且 取指向块 原样读回那条直线 —— 库不校验目标类型, 参照会悬空, 业务侧要自己保证传的是块表记录; 把参照指向它自己也照样 成=真 码=0; 参照标识传 0 回假且 码 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 块标识 <类型 = 变整数>
    {
        @ (arx_bref_set_block_id(@<参照标识>, @<块标识>) != 0)
    }

    方法 取插入点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockReference::position, 结果写入调用方已创建好的 ARX点3D。实测: 新建时传 (7,8,9) 读到 7/8/9 逐分量精确相等且 码 = 0; 出参指针传 0 回假且 取最后错误 = -2。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 结果点 <类型 = 变整数>
    {
        @ (arx_bref_position_into(@<参照标识>, @<结果点>) != 0)
    }

    方法 置插入点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockReference::setPosition。实测: 置 (31.5,-22.25,6) 成=真 且 码 = 0, 紧接 取插入点 逐分量精确读回同值, 读档自己也是 码 = 0。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ (arx_bref_set_position(@<参照标识>, @<X>, @<Y>, @<Z>) != 0)
    }

    方法 取比例X <公开 静态 类型 = 小数 注释 = "对应 AcDbBlockReference::scaleFactors 的 sx, 失败回 NaN(读法是 值 == 值 取假)。实测: 新建为 1; 置比例 2/3/4 后 X 与 2 精确相等((值-期望)*1e17 = 0); 负比例 -1/-2/-3 原样读回; 参照标识传 0 读到非自等值且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_scale_x(@<参照标识>)
    }

    方法 取比例Y <公开 静态 类型 = 小数 注释 = "对应 scaleFactors 的 sy, 失败回 NaN。实测口径同 取比例X: 置比例 2/3/4 后读到 3, 负档读到 -2。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_scale_y(@<参照标识>)
    }

    方法 取比例Z <公开 静态 类型 = 小数 注释 = "对应 scaleFactors 的 sz, 失败回 NaN。实测口径同 取比例X: 置比例 2/3/4 后读到 4, 负档读到 -3。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_scale_z(@<参照标识>)
    }

    方法 置比例 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockReference::setScaleFactors(AcGeScale3d)。实测: 2/3/4 与 -1/-2/-3 都 成=真 码=0 且三分量原样读回; 置 0/0/0 也返回 成=真 码=0, 但三分量读回仍是上一次的值(库把零比例整笔吃掉, 既不落库也不报错), 要清零必须自己拦; 参照标识传 0 回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ (arx_bref_set_scale(@<参照标识>, @<X>, @<Y>, @<Z>) != 0)
    }

    方法 取旋转角 <公开 静态 类型 = 小数 注释 = "对应 AcDbBlockReference::rotation, 弧度, 失败回 NaN。实测: 新建为 0 精确相等; 置 0.75 后 (值-期望)*1e17 = 0(精确); 置 0.4 读到 -5.55111512312578E-17 量级的末位差而 到文本 仍显示 0.4, 所以断言要用约等与 值 == 值; 置 -1.25 读到 5.033185307179586, 即 -1.25 加 2π, 库把负角折进 0 到 2π 区间; 参照标识传 0 读到非自等值且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_rotation(@<参照标识>)
    }

    方法 置旋转角 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockReference::setRotation。实测: 0.75、0.4、-1.25 三档都 成=真 码=0, 负档的折叠口径见 取旋转角。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 值 <类型 = 小数>
    {
        @ (arx_bref_set_rotation(@<参照标识>, @<值>) != 0)
    }

    方法 取法向X <公开 静态 类型 = 小数 注释 = "对应 AcDbBlockReference::normal 的 x, 失败回 NaN。实测: 新建为 0; 置法向 1/1/1 后读到 0.577350269189626, 即库把法向按单位向量归一化后存。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_normal_x(@<参照标识>)
    }

    方法 取法向Y <公开 静态 类型 = 小数 注释 = "对应 normal 的 y, 失败回 NaN。实测口径同 取法向X: 新建为 0, 置 1/1/1 后同为 0.577350269189626。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_normal_y(@<参照标识>)
    }

    方法 取法向Z <公开 静态 类型 = 小数 注释 = "对应 normal 的 z, 失败回 NaN。实测: 新建为 1; 置 0/0/2 读到 1(与 2 差一个整值, 因为被归一化); 置 0/0/0 被拒后仍是 1; 参照标识传 0 读到非自等值且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_normal_z(@<参照标识>)
    }

    方法 置法向 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockReference::setNormal(AcGeVector3d)。实测: 1/1/1 与 0/0/2 都 成=真 码=0 但落库的是归一化结果(见三条 取法向); 置 0/0/0 回假且 取最后错误 = 153(eDegenerateGeometry), 原法向保持 0/0/1 不动; 参照标识传 0 回假且 码 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ (arx_bref_set_normal(@<参照标识>, @<X>, @<Y>, @<Z>) != 0)
    }

    方法 取属性数 <公开 静态 类型 = 整数 注释 = "走查 AcDbBlockReference::attributeIterator 并跳过已擦除后的计数: 迭代器本身也会路过已擦除的子实体, 桥对每一条只读打开一次, 打不开的就是已擦除的那条, 于是本档与 取属性定义数 同一口径。实测: 刚 新建块参照 出来的参照属性数为 0 且 码 = 0(库里不会因为记录带属性定义就自动生成属性); 每挂上一条属性加 1; 擦掉参照名下唯一的那条属性后回到 0, 紧接着再挂一条新属性又回到 1 且 取属性按下标(0) 就是这条新属性; 对块表记录调用回 -1 且 取最后错误 = 46(eNotThatKindOfClass), 这条档只认块参照; 参照自己已擦除时回 -1 且 码 = 80(eWasErased); 参照标识传 0 回 -1 且 码 = -1。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    {
        @ arx_bref_attrib_count(@<参照标识>)
    }

    方法 取属性按下标 <公开 静态 类型 = 变整数 注释 = "同一条属性走查按 0 基下标取属性标识, 与 取属性数 共用跳过已擦除的口径, 下标形状同 ARX块表.取属性定义按下标。实测: 刚建的参照下标 0 回 0 且 取最后错误 = -1; 挂上属性后下标 0 与 新建属性 的返回值逐位相等; 实测下标传负回 0 且 码 = -2(桥在进库之前自拒); 唯一的一条属性被擦掉后下标 0 回 0 且 码 = -1, 之后新挂的那条自动顶回下标 0。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 下标 <类型 = 整数>
    {
        @ arx_bref_attrib_at(@<参照标识>, @<下标>)
    }

    方法 打开属性 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbBlockReference::openAttribute(pAtt, id, AcDb::kForRead): 本档把参照与属性两侧都按 只读 打开一次再立刻关闭, 只回答开得进开不进, 不返回对象句柄 —— 属性的每一条读写档都由桥自己开闭, 业务侧不需要先 打开 才能用。实测: 用自己的参照打开自己挂的属性 成=真 码=0; 用参照二去打开参照一名下的属性同样 成=真 码=0, 即 openAttribute 根本不校验归属, 这条档不能用来判归属, 归属要看 ARX数据库底层.取所有者 是否等于该参照; 属性标识传 0 回假且 取最后错误 = -1, 参照标识传 0 同样 -1; 参照位置传块表记录回假且 码 = 46(eNotThatKindOfClass); 属性已随参照擦掉之后回假且 码 = 80(eWasErased)。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 属性标识 <类型 = 变整数>
    {
        @ (arx_bref_open_attrib(@<参照标识>, @<属性标识>) != 0)
    }
}
类 ARX属性定义 <公开
        注释 = "属性定义 AcDbAttributeDefinition 的公开档, 包A 必做#3 的 3b 属性族定义侧。每条入口自己就是一个 @嵌入式方法 档, 本类没有底层转发档 —— 按裁定与 OCCT 范本(occt_2d.wsv 每个公开类只有嵌入档, 转发条数 0)不做重复封装; 只有 取标签 与 取提示 两条按 取注释 的口径另配 文本型 高档。"
        注释 = "属性定义是 AcDbText 的子类(dbents.h 里 AcDbAttributeDefinition 的直接基类就是 AcDbText): 内容、字高、旋转角、位置这些走 类 ARX文字 的公开档, 本类不重复提供。实测 是否文字 对一条属性定义回真、取内容 原样读到建它时传的内容、类型名档读出 AcDbAttributeDefinition 长=23; 置内容/置字高/取位置 六档同样应答(属性实体那一侧也实测过)。"
        注释 = "属性定义是块表记录里的普通实体: 计数与取下标用 ARX块表.取属性定义数 / 取属性定义按下标, 记录级旗标用 ARX块表.是否含属性定义, 擦除用 ARX数据库底层.擦除实体, 归属的宿主记录用 ARX数据库底层.取所有者。"
        注释 = "旗标读档一律折成 逻辑型, 桥的原始口径是 1/0/-1, 折法是 == 1, 所以三种失败形状全部读成假: 标识传 0 读假且 取最后错误 = -1, 拿直线或属性实体标识串档读假且 码 = 46(eNotThatKindOfClass), 已擦除的定义读假且 码 = 80(eWasErased)。要分清这三种必须紧跟一次 取最后错误, 本类不替调用方记住它。"
        注释 = "标签与提示的文本通道两档: 入参 文本型 直接 .GetText() 交桥转宽字符; 出参是 字节集 缓冲 + UTF8到文本, 容量口径是 UTF8 字节数再加一个结束零字符, 装不下即 成=假 且 码 = -4 同时首字节被清 0, 于是高档回空文本; 缓冲尺寸传 0 由桥在进库之前自拒, 成=假 且 码 = -2。"
        注释 = "以下全部数值出自本机 AutoCAD 2026 (R25) 全新空白 DWG 的一轮实测(探针 292 行读数, 跑完即删): 定义侧缺省形状是 不可见/常量/校验/预置/锁位置/MText 六个旗标全假、字段长度 0、标签与提示与位置就是 新建属性定义 传进去的那几段值。">
{
    方法 是否属性定义 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbObjectId::objectClass()->isDerivedFrom(AcDbAttributeDefinition::desc()), 与 是否直线/是否文字 同一口径。实测: 属性定义本体回真且 码 = 0; 块表记录、直线回假且 码 = 0; 标识传 0 回假且 取最后错误 = -1; 属性实体标识也回假(见 ARX属性实体.是否属性实体 的同一条实测)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_is_attribute_definition(@<对象标识>) != 0)
    }

    方法 新建属性定义 <公开 静态 类型 = 变整数 注释 = "new AcDbAttributeDefinition(AcGePoint3d, 内容, 标签, 提示, 样式) 后 appendAcDbEntity 到块记录并 close; 样式标识传 0 即 AcDbObjectId::kNull, 实测全部用 0 建成。SDK 这个构造不吃字高与旋转角, 那两档走 ARX文字.置字高 与 ARX文字.置旋转角。实测: 往 新建块 的记录建 (10,20,0) 内容 属性文字 标签 TAG1 提示 请输入提示 回非 0 且 码 = 0, 建后该记录 取属性定义数=1、是否含属性定义 真、取实体数=1; 同记录再建一条后计数为 2 且 取属性定义按下标(1) 与第二条相等; 空内容、空标签、空提示三样全空的定义照样建成(读回长度都是 0); 256 个中文字的长标签可建可读回; 两条同标签 TAG1 的定义都建成, 库不查重; 块标识传 0 回 0 且 码 = -1, 传直线标识回 0 且 码 = 46, 传 *Model_Space 竟然建成且模型空间的 取属性定义数 变 1 —— 本层不拦, 业务侧要自己挡住往模型空间塞属性定义。" @嵌入式方法 = "">
    参数 块标识 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    参数 内容 <类型 = 文本型>
    参数 标签 <类型 = 文本型>
    参数 提示 <类型 = 文本型>
    参数 样式标识 <类型 = 变整数>
    {
        @ arx_attdef_add(@<块标识>, @<X>, @<Y>, @<Z>, @<内容>.GetText (), @<标签>.GetText (), @<提示>.GetText (), @<样式标识>)
    }

    方法 取标签到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_attdef_tag_into 的 字节集 缓冲档, 对应 AcDbAttributeDefinition::tagConst 写出 UTF8。实测: 标签 TAG1 用 64 字节与 5 字节缓冲都 成=真 读到 [TAG1] 长=4 首字节 84 末字节 0(ASCII 一字一字节); 4 字节缓冲装不下(四字符加结束零要五格) 成=假 且 码 = -4 且首字节被清 0; 尺寸传 0 成=假 且 码 = -2。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_attdef_tag_into(@<对象标识>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 置标签 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setTag(const ACHAR*)。实测: 置 改TAG9 成=真 码=0, 紧接缓冲档读到 [改TAG9] 长=5 首字节 -26; 置空文本 成=真 且读回长 0(库里允许空标签); 置 256 个中文字的长标签 成=真 码=0 且高档读回长=256; 标识传 0 回假且 码 = -1; 拿属性实体标识串这条定义档回假且 码 = 46。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 标签 <类型 = 文本型>
    {
        @ (arx_attdef_set_tag(@<对象标识>, @<标签>.GetText ()) != 0)
    }

    方法 取标签 <公开 静态 类型 = 文本型 注释 = "取标签 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取标签到字节集、再 UTF8到文本; 桥写进缓冲的结束零字符就是读出契约, 所以本档不回字节数。实测: 高档读到 [SAME] 长=4 且 码 = 0; 置过 256 个中文字长标签的那条用高档直接读到 长=256 且 码 = 0(UTF8 共 768 字节, 1024 有余量); 空标签那条读到空文本且 码 = 0(成功形状); 标识传 0 读到空文本且紧跟的 取最后错误 = -2。按 UTF8 字节数加一个结束零的容量口径, 1024 字节容到 341 个中文, 更长的标签要自己用 取标签到字节集 放大缓冲。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX属性定义.取标签到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 取提示到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_attdef_prompt_into 的 字节集 缓冲档, 对应 AcDbAttributeDefinition::promptConst 写出 UTF8。实测: 提示 请输入提示 (五个中文字, UTF8 共 15 字节) 用 64 字节与 16 字节缓冲都 成=真 读到 长=5 首字节 -24(即 0xE6) 末字节 0; 15 字节缓冲差一个结束零字符, 成=假 且 码 = -4 且首字节清 0; 尺寸传 0 成=假 且 码 = -2; 空提示那条读到的是空文本(长 0, 首字节 0, 码 = 0)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_attdef_prompt_into(@<对象标识>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 置提示 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setPrompt(const ACHAR*)。实测: 置 改后提示语 成=真 码=0, 紧接缓冲档读到 长=5 首字节 -26; 置空文本照样 成=真 且读回长 0; 标识传 0 回假且 码 = -1。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 提示 <类型 = 文本型>
    {
        @ (arx_attdef_set_prompt(@<对象标识>, @<提示>.GetText ()) != 0)
    }

    方法 取提示 <公开 静态 类型 = 文本型 注释 = "取提示 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取提示到字节集、再 UTF8到文本, 读出契约同样是结束零字符。实测: 高档读到 [提示乙] 长=3 且 码 = 0, 空提示那条读到空文本且 码 = 0; 缓冲不足、空标识、串档与已擦除一律回空文本; 超过 341 个中文的提示要自己用 取提示到字节集 放大缓冲。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX属性定义.取提示到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 是否不可见 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::isInvisible, 桥的 1/0/-1 按 == 1 折成 逻辑型。实测: 新建的定义读到假且 码 = 0; 置不可见(真) 后读到真; 再 置不可见(假) 读到假。失败形状见类头的旗标折法。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attdef_is_invisible(@<对象标识>) == 1)
    }

    方法 置不可见 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setInvisible(Adesk::Boolean), 桥的整型入参非零即 kTrue(探针向底层传 2 时读回 1, 公开档只收 逻辑型)。实测: 置真与置假都 成=真 码=0 且紧跟 是否不可见 读回同值。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_attdef_set_invisible(@<对象标识>, @<值>) != 0)
    }

    方法 是否常量 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::isConstant。实测: 新建读到假; 置真读回真, 置假读回假; 关键连带: 把一条定义置成常量属性之后, 同一记录的 取属性定义数 仍是 2、是否含属性定义 仍是真, 常量旗标不会把定义从记录里摘出去。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attdef_is_constant(@<对象标识>) == 1)
    }

    方法 置常量 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setConstant(Adesk::Boolean)。实测: 置真与置假都 成=真 码=0 并按档读回, 记录的属性定义计数不受影响。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_attdef_set_constant(@<对象标识>, @<值>) != 0)
    }

    方法 是否校验 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::isVerifiable。实测: 新建读到假; 置真读回真; 底层收到 2 那一档读回 1(见 置校验)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attdef_is_verifiable(@<对象标识>) == 1)
    }

    方法 置校验 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setVerifiable(Adesk::Boolean)。实测: 置真 成=真 码=0 读回真; 桥的整型入参非零即 kTrue。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_attdef_set_verifiable(@<对象标识>, @<值>) != 0)
    }

    方法 是否预置 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::isPreset。实测: 新建读到假; 置真读回真且 码 = 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attdef_is_preset(@<对象标识>) == 1)
    }

    方法 置预置 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setPreset(Adesk::Boolean)。实测: 置真 成=真 码=0 读回真。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_attdef_set_preset(@<对象标识>, @<值>) != 0)
    }

    方法 取字段长度 <公开 静态 类型 = 整数 注释 = "对应 AcDbAttributeDefinition::fieldLength 的 UInt16 原值, 这条不折 逻辑型, 失败回 -1。实测: 新建为 0; 0、300、65535 三档写入后都按原值读回且 码 = 0; 标识传 0 读到 -1 且 码 = -1, 直线或属性实体标识读到 -1 且 码 = 46, 已擦除读到 -1 且 码 = 80。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_attdef_field_length(@<对象标识>)
    }

    方法 置字段长度 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setFieldLength(Adesk::UInt16), 合法区间 0..65535。实测: 0、300、65535 三档都 成=真 码=0 并按原值读回; -1 与 65536 由桥在进库之前自拒, 成=假 且 取最后错误 = -3(不是 Acad 码), 而且原值保持不动(置 65536 失败后仍读到 65535)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 整数>
    {
        @ (arx_attdef_set_field_length(@<对象标识>, @<值>) != 0)
    }

    方法 是否锁位置 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::lockPositionInBlock, SDK 这一档两侧都是裸 bool 而不是 Adesk::Boolean。实测: 新建读到假; 置真读回真且 码 = 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attdef_lock_position(@<对象标识>) == 1)
    }

    方法 置锁位置 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::setLockPositionInBlock(bool)。实测: 置真 成=真 码=0 读回真; 桥的整型入参按 != 0 折成 bool。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_attdef_set_lock_position(@<对象标识>, @<值>) != 0)
    }

    方法 是否MText定义 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttributeDefinition::isMTextAttributeDefinition, 本包只读不写(SDK 没有给这条旗标配公开 setter)。实测: 用 新建属性定义 的构造函数建出的四条定义(含空内容那条与两条同标签那条)一律读到假且 码 = 0, 要建 MText 型属性定义得走 AutoCAD 自己的命令侧, 本层不提供。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attdef_is_mtext(@<对象标识>) == 1)
    }
}

类 ARX属性实体 <公开
        注释 = "属性实体 AcDbAttribute 的公开档, 包A 必做#3 的 3b 属性族插入侧。每条入口自己就是一个 @嵌入式方法 档, 无底层转发档 —— 按裁定与 OCCT 范本不做重复封装; 只有 取标签 一条按 取注释 的口径另配 文本型 高档。"
        注释 = "属性实体同样是 AcDbText 的子类, 内容、字高、旋转角、位置走 类 ARX文字: 实测 是否文字 对属性实体回真, 类型名档读出 AcDbAttribute 长=13, 置内容 改后属性值 与 置字高 3.5 之后都按档读回(码 = 0)。归属与遍历走 类 ARX块参照 的 取属性数 / 取属性按下标 / 追加属性 / 打开属性。"
        注释 = "SDK 只在属性定义一侧给出 setConstant/setVerifiable/setPreset, 属性实体这一侧只有三个同名的读档, 所以本类不提供这三个 置档 —— 要改常量性、校验性、预置性必须去改块定义里的那条属性定义。"
        注释 = "两条擦除路径留下的属性状态不一样, 而且是可测出来的差别: 用 ARX数据库底层.擦除实体 直接擦掉某条属性之后, 这条属性谁都打不开(旗标读档回 -1 配 码 = 80 eWasErased, 标签缓冲档回 成=假 配 码 = -2, 打开属性 也回假配 码 = 80); 反过来随块参照一起被擦掉的那条属性照样能只读打开 —— 旗标读到当前值且 码 = 0、标签高档照样读到 [CC1] 长=3 且 码 = 0, 连写档也照样 成=真 码=0, 只有它所属参照的 取属性数 因为参照自己打不开而回 -1 配 码 = 80。所以 是否已擦除 为真不等于这条属性读不到, 判归属要认 取所有者, 判可用要认 取最后错误。"
        注释 = "旗标读档的折法与失败哨兵同 ARX属性定义: 桥回 1/0/-1, 公开档按 == 1 折成 逻辑型, 因此标识传 0 与串用属性定义档都读成假, 分别配 取最后错误 = -1 与 46(eNotThatKindOfClass); 取字段长度 不折, 失败照样回 -1。"
        注释 = "标签的文本通道两档与容量口径同 类 ARX属性定义(UTF8 字节数再加一个结束零字符, 装不下 -4 且首字节清 0, 尺寸传 0 由桥自拒 -2)。"
        注释 = "以下全部数值出自本机 AutoCAD 2026 (R25) 全新空白 DWG 同一轮实测: 属性实体缺省是 六个旗标全假、字段长度 0, 内容/标签/位置就是 新建属性 传进去的那几段值。">
{
    方法 是否属性实体 <公开 静态 类型 = 逻辑型 注释 = "对应 objectClass()->isDerivedFrom(AcDbAttribute::desc())。实测: 属性实体本体回真且 码 = 0; 属性定义标识回假且 码 = 0(两个类互不为基类, 都是 AcDbText 的兄弟子类); 块参照、直线回假且 码 = 0; 标识传 0 回假且 取最后错误 = -1。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_db_is_attribute(@<对象标识>) != 0)
    }

    方法 新建属性 <公开 静态 类型 = 变整数 注释 = "new AcDbAttribute(AcGePoint3d, 内容, 标签, 样式) 后立刻由该块参照 appendAttribute 收为子实体并 close, 一步到位不留无主实体; 样式标识传 0 即 AcDbObjectId::kNull。实测: 往参照挂 (5,6,0) 内容 属性值一 标签 AA1 回非 0 且 码 = 0, 参照的 取属性数 由 0 变 1 且 取属性按下标(0) 就是返回值; 连带不动的两笔: 块定义记录的 取属性定义数 仍是 2、模型空间的 取实体数 仍是 2(属性实体不单独计入模型空间遍历); 属性的 取所有者 等于该参照且句柄非零; 同参照同标签可以再挂第二条(计数变 2), 库不查重; 参照指向的记录里没有任何属性定义时照样挂得上(计数 0 到 1, 而 是否含属性定义 仍是假); 参照标识传 0 回 0 且 码 = -1, 传直线或块表记录标识回 0 且 码 = 46。归属一旦定了就不许改: 同一条属性再向自己的参照挂第二次 成=假 且 取最后错误 = 26(eAlreadyInDb) 且属性数不变, 想把它从参照一改挂到参照二 同样 成=假 码 = 26 且两侧计数保持 1/1(要改挂只能 擦除实体 之后重建); 挂直线、挂属性定义、挂另一个块参照都是 46, 属性标识传 0 或参照传 0 都是 -1。桥里这条显式挂接通道(arx_bref_append_attrib)因此没有开成公开档 —— 本包没有任何入口能产出一条尚无归属的属性实体, 它在火山侧只量得到上面这些失败形状。" @嵌入式方法 = "">
    参数 参照标识 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    参数 内容 <类型 = 文本型>
    参数 标签 <类型 = 文本型>
    参数 样式标识 <类型 = 变整数>
    {
        @ arx_attrib_add(@<参照标识>, @<X>, @<Y>, @<Z>, @<内容>.GetText (), @<标签>.GetText (), @<样式标识>)
    }

    方法 取标签到字节集 <公开 静态 类型 = 逻辑型 注释 = "arx_attrib_tag_into 的 字节集 缓冲档, 对应 AcDbAttribute::tagConst 写出 UTF8。实测: 标签 AA1 三个 ASCII 字符在 64、4、5 三档缓冲里都 成=真 读到 [AA1] 长=3 首字节 65 末字节 0(四字节刚好装三字符加结束零); 尺寸传 0 成=假 且 码 = -2; 被 擦除实体 直接擦掉的那条属性 成=假 且 码 = -2; 传直线标识或 0 也都是 成=假 码 = -2(打开失败由桥的写出档统一收口成 -2, 真实原因要用 取最后错误 复核另一条读档)。随参照一起擦掉的那条形同活实体: 标签缓冲档照样 成=真 码=0 读到 [CC1]。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 缓冲 <类型 = 字节集类>
    参数 缓冲尺寸 <类型 = 整数>
    {
        @ (arx_attrib_tag_into(@<对象标识>, (char*)@<缓冲>.GetPtr (), @<缓冲尺寸>) != 0)
    }

    方法 置标签 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::setTag(const ACHAR*)。实测: 置 改AA9 成=真 码=0 且缓冲档读到 长=4 首字节 -26; 置空文本 成=真 且读回长 0; 标识传 0 回假且 码 = -1; 拿属性定义标识串这条属性档回假且 取最后错误 = 46。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 标签 <类型 = 文本型>
    {
        @ (arx_attrib_set_tag(@<对象标识>, @<标签>.GetText ()) != 0)
    }

    方法 取标签 <公开 静态 类型 = 文本型 注释 = "取标签 的 文本型 高档: 分配 1024 字节缓冲、调同类的 取标签到字节集、再 UTF8到文本, 读出契约是结束零字符, 所以本档不回字节数。实测: 高档读到 [EE1] 长=3 且 码 = 0, 置成空标签的那条读到空文本且 码 = 0(这是成功形状, 别和下面的失败形状混), 随参照擦掉的那条读到 [CC1] 长=3 且 码 = 0; 标识传 0 与串档、缓冲不足一律回空文本, 空标识这一档紧跟 取最后错误 读到的是 -2。">
    参数 对象标识 <类型 = 变整数>
    {
        变量 缓冲 <类型 = 字节集类>
        变量 成 <类型 = 逻辑型>
        缓冲 = 取空白字节集 (1024)
        成 = ARX属性实体.取标签到字节集 (对象标识, 缓冲, 缓冲.取字节集长度 ())
        如果 (成 == 假)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (缓冲))
    }

    方法 是否不可见 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::isInvisible。实测: 刚 新建属性 的那条读到假且 码 = 0; 置真之后读到真且 码 = 0, 再置假读到假且 码 = 0; 拿属性定义标识串这条档读到假且 码 = 46, 标识传 0 读到假且 码 = -1; 随参照一起擦掉的那条读到假但 码 = 0(读通了, 值本来就是假)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attrib_is_invisible(@<对象标识>) == 1)
    }

    方法 置不可见 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::setInvisible(Adesk::Boolean), 属性实体这一侧只有可见性这一条是既可读又可写的旗标(锁位置那条见 置锁位置)。实测: 置真与置假都 成=真 码=0 且紧跟 是否不可见 读回同值; 拿属性定义标识串这条属性档回假且 码 = 46; 随参照一起擦掉的那条照样 成=真 码=0, 库不拦。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_attrib_set_invisible(@<对象标识>, @<值>) != 0)
    }

    方法 是否常量 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::isConstant, 只读档(SDK 这一侧没有 setConstant)。实测: 刚 新建属性 的那条七个读档一律 0 且 码 = 0, 无定义块上手工挂的那条七个读档同样全 0; 标识传 0 读假且 码 = -1, 直线标识与属性定义标识读假且 码 = 46。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attrib_is_constant(@<对象标识>) == 1)
    }

    方法 是否校验 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::isVerifiable, 只读档。实测口径同 是否常量: 刚建出的属性与无定义块上挂的属性都读到假且 码 = 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attrib_is_verifiable(@<对象标识>) == 1)
    }

    方法 是否预置 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::isPreset, 只读档。实测口径同 是否常量: 刚建出的属性与无定义块上挂的属性都读到假且 码 = 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attrib_is_preset(@<对象标识>) == 1)
    }

    方法 取字段长度 <公开 静态 类型 = 整数 注释 = "对应 AcDbAttribute::fieldLength 的 UInt16 原值, 失败回 -1。实测: 新建的属性为 0 且 码 = 0; 置 200 后读到 200; 被 擦除实体 直接擦掉的那条读到 -1 且 取最后错误 = 80(eWasErased); 随参照一起擦掉的那条读到的是当前值 0 且 码 = 0; 标识传 0 读到 -1 且 码 = -1, 属性定义标识读到 -1 且 码 = 46。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ arx_attrib_field_length(@<对象标识>)
    }

    方法 置字段长度 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::setFieldLength(Adesk::UInt16), 合法区间 0..65535。实测: 置 200 成=真 码=0 且读回 200; -1 与 65536 由桥在进库之前自拒, 成=假 且 取最后错误 = -3; 标识传 0 回假且 码 = -1, 属性定义标识回假且 码 = 46。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 整数>
    {
        @ (arx_attrib_set_field_length(@<对象标识>, @<值>) != 0)
    }

    方法 是否锁位置 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::lockPositionInBlock(bool)。实测: 新建读到假且 码 = 0; 置真后读到真且 码 = 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attrib_lock_position(@<对象标识>) == 1)
    }

    方法 置锁位置 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::setLockPositionInBlock(bool)。实测: 置真 成=真 码=0 且紧跟 是否锁位置 读到真; 随参照一起擦掉的那条照样 成=真 码=0(见类头两条擦除路径的分别)。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    参数 值 <类型 = 逻辑型>
    {
        @ (arx_attrib_set_lock_position(@<对象标识>, @<值>) != 0)
    }

    方法 是否MText属性 <公开 静态 类型 = 逻辑型 注释 = "对应 AcDbAttribute::isMTextAttribute, 只读档。实测: 刚 新建属性 的那条与无定义块上手工挂的那条都读到假且 码 = 0。" @嵌入式方法 = "">
    参数 对象标识 <类型 = 变整数>
    {
        @ (arx_attrib_is_mtext(@<对象标识>) == 1)
    }
}

类 ARX事务 <公开 注释 = "包A 必做#4 事务通道的公开档: AcDbTransactionManager / AcTransaction 这一层跨边界只有整数计数与一条按下标读回的对象标识, 十条入口每条自己就是一个 @嵌入式方法 档, 本类没有底层档也没有转发档 —— 按裁定与 OCCT 范本(occt_2d.wsv 每个公开类只有嵌入档, 转发条数 0)不做重复封装。"
        注释 = "为什么事务对象指针一条都不给: AcTransaction 与它开着的 AcDbObject 的存活期归事务管理器, end/abort 之后火山侧再拿着就是野指针, 所以本类只回 逻辑型/整数/变整数 三种标量。探针专用的 事务持住 / 事务持住两次 两条(拿对象且不 close)因此留在探针包里, 不进本类也不进安装模块。"
        注释 = "读数纪律(2026-10-16 本机实测): 写档回 逻辑型, 计数档回 整数 且 -1 是「没有当前文档」或「没有顶层事务」的哨兵, 标识档回 变整数 且 0 配 -2(下标传负)/-1(下标越界)/250(根本没有事务); 每一次调用之后必须另起一句 取最后错误 复核, 同句里绝不混写与读。"
        注释 = "哨兵与 Acad 码不会撞: Acad::ErrorStatus 全是正数, 所以 -1..-7 只可能是本桥自己写的。本包用到的三条: -5 取不到事务管理器(没有当前文档), -6 有管理器但 topTransaction() 为空, -7 startTransaction() 自己返回空。"
        注释 = "两条不进本类的持住档量出来的危害要记下: 同一事务里对同一条对象用 kForNotify 开第二次回 86(eWasOpenForNotify), 而「写+通知」或「通知+写」两种组合放弃事务之后那条对象永远停在 83(eWasOpenForWrite), 本桥不 close, 这一世就再也读不到它; 纯只读与纯写的组合放弃之后完全恢复。"
        注释 = "命令回调上下文里能用哪半张脸(2026-10-16 本机实测, 两条活命令各跑一次): 会话档(注册码带 2097152, ACRX_CMD_SESSION)回调里 开始事务 回真、取活动事务数 变 1、是否有顶层事务 变真, 但一到写就撞 320(eLockViolation) —— 置颜色号 回假且 码 = 320, 而同一句里 取颜色号 只读档反而成功读到基线值; 持住档同样回假且 码 = 320; 放弃事务 回真, 结束事务 回假且 码 = 250。模态档(注册码 0)回调里读写全正常(置 6 成功、持住 成功且 取打开对象数 变 1), 放弃之后回读基线 3, 证明回滚真生效。结论: 事务不是万能钥匙, 它不替调用者解文档锁 —— 会话上下文只能读, 要写必须走模态命令(或先取文档锁)。">
{
    方法 开始事务 <公开 静态 类型 = 逻辑型 注释 = "arx_tr_start → AcTransactionManager::startTransaction。实测: 事务外回真且 取最后错误 = 0, 紧接 取活动事务数 变 1、是否有顶层事务 变真、取打开对象数 是 0; 可以叠, 连开三层 活动=1/2/3。取不到事务管理器回假且 码 = -5, startTransaction() 回空指针回假且 码 = -7。" @嵌入式方法 = "">
    {
        @ (arx_tr_start() != 0)
    }

    方法 结束事务 <公开 静态 类型 = 逻辑型 注释 = "arx_tr_end → endTransaction(): 提交最上层那一笔。实测: 事务里 置颜色号 12 之后结束, 结后读回就是 12; 三层叠着逐次结束 活动=3/2/1/0, 退干净之后再结束回假且 码 = 250(eNoActiveTransactions)。没有当前文档回假且 码 = -5; 桥只在 Acad 码非 0 时才写下它, 所以成功那条 取最后错误 读到 0。" @嵌入式方法 = "">
    {
        @ (arx_tr_end() != 0)
    }

    方法 放弃事务 <公开 静态 类型 = 逻辑型 注释 = "arx_tr_abort → abortTransaction(): 只退最上层那一笔。实测五种写入都能退回: 置颜色号(事务内置 11 读回 11, 放后回到基线 3)、置实体图层名(事务内改成 事务探针层, 放后回到 0 层)、擦除实体(事务内 是否已擦除=真 且 取实体数 少一条, 放后两者复原)、新建直线(事务内 取实体数 多一条, 放后复原)、新建图层(事务内 取图层数 多一条且 图层是否存在=真, 放后两者复原)。内外两层各写一次再只放弃内层, 读到的是外层那一次(15 退回 14), 外层也放弃才回到基线。没有事务回假且 码 = 250, 没有当前文档回假且 码 = -5。" @嵌入式方法 = "">
    {
        @ (arx_tr_abort() != 0)
    }

    方法 取活动事务数 <公开 静态 类型 = 整数 注释 = "arx_tr_active_count → numActiveTransactions。实测: 事务外 0 且 码 = 0; 按 开始事务 的次数涨到 1/2/3, 按 结束事务/放弃事务 的次数回落, 两者混着用也照次数走(叠两层、放掉内层、结掉外层 → 1 再 0)。没有当前文档回 -1 且 码 = -5。" @嵌入式方法 = "">
    {
        @ arx_tr_active_count()
    }

    方法 取打开对象数 <公开 静态 类型 = 整数 注释 = "arx_tr_opened_count → 管理器层的 numOpenedObjects, 数的是「这一叠事务」一共开着的对象条数, 同一条被两笔事务各开一次也只算一条(实测外层与内层各持同一条: 活动=2 打开=1)。实测最关键的一条: 事务里走本包既有档 置颜色号/取颜色号/取实体数/取实体图层名 之后本档恒 0, 因为那些档自己 open 完就 close, 事务根本不接管, 只有 取打开对象标识按下标 拿得到的那条路径才让它涨。没有当前文档回 -1 且 码 = -5。" @嵌入式方法 = "">
    {
        @ arx_tr_opened_count()
    }

    方法 是否有顶层事务 <公开 静态 类型 = 逻辑型 注释 = "arx_tr_has_top → topTransaction() 是否非空。实测: 事务外假且 码 = 0; 开一笔变真且 码 = 0; 逐层退到干净又变假。桥里这一档回 -1/0/1, 折成 逻辑型 用的是 == 1, 所以「没有当前文档」(码 -5)与「有文档但没事务」(码 0)都读到假, 要分这两种状态就看 取最后错误。" @嵌入式方法 = "">
    {
        @ (arx_tr_has_top() == 1)
    }

    方法 取顶层打开对象数 <公开 静态 类型 = 整数 注释 = "arx_tr_top_opened_count → 只有最上层那一笔事务自己的 numOpenedObjects。实测: 外层持住一条线是 活动=1 打开=1 顶开=1; 再开一层内层什么都不持就是 活动=2 打开=1 顶开=0, 所以顶层读数会比总数小, 想数整叠用 取打开对象数。没有顶层事务回 -1 且 码 = -6; 没有当前文档回 -1 但 码 = -5(同一个 -1 两种码, 只能靠 取最后错误 分)。" @嵌入式方法 = "">
    {
        @ arx_tr_top_opened_count()
    }

    方法 取打开对象标识按下标 <公开 静态 类型 = 变整数 注释 = "arx_tr_opened_id_at → getAllObjects 之后按下标取回一条 AcDbObjectId。实测顺序是后持住的在前(只读持住线甲后 下0 等于线甲; 再持线乙, 下0 变线乙、下1 是线甲), 别按建立顺序指望它。失败形状三种: 下标传负回 0 且 码 = -2; 有事务但下标越界或列表为空回 0 且 码 = -1; 根本没有事务回 0 且 码 = 250。标识数值每轮换值, 只能比相等、不能钉数值。" @嵌入式方法 = "">
    参数 下标 <类型 = 整数>
    {
        @ arx_tr_opened_id_at(@<下标>)
    }

    方法 启用图形刷新 <公开 静态 类型 = 逻辑型 注释 = "arx_tr_enable_flush → AcTransactionManager::enableGraphicsFlush(on)。实测有一处反直觉: 事务外 传 1 回真且 码 = 0, 但 传 0 回假且 码 = 250, 也就是关掉刷新要求桌上有一笔活事务; 非零入参一律当开(传 2 与 传 -1 都回真且 码 = 0)。没有当前文档回假且 码 = -5。" @嵌入式方法 = "">
    参数 开关 <类型 = 整数>
    {
        @ (arx_tr_enable_flush(@<开关>) != 0)
    }

    方法 刷新图形 <公开 静态 类型 = 逻辑型 注释 = "arx_tr_flush → flushGraphics(), 原生是 void、拒不了, 所以这一档唯一可能的失败就是取不到事务管理器。实测: 事务外回真且 码 = 0, 事务内也回真且 码 = 0; 没有当前文档回假且 码 = -5。" @嵌入式方法 = "">
    {
        @ (arx_tr_flush() != 0)
    }
}
