            对象指针 = 0
        }
        对象指针 = ARX几何底层.比例2D新建统一 (比例)
        返回 (对象指针 != 0)
    }

    方法 创建分量 <公开 类型 = 逻辑型 注释 = "对应 new AcGeScale2d(xFactor, yFactor)。已存在时先释放旧对象。" 注释 = "实测: 创建分量(3, 0.5) 原样读回 (3, 0.5); 分量传 0 与 NaN 都不拦, 建得成有效句柄。">
    参数 X比例 <类型 = 小数>
    参数 Y比例 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.比例2D释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.比例2D新建分量 (X比例, Y比例)
        返回 (对象指针 != 0)
    }

    方法 创建恒等 <公开 类型 = 逻辑型 注释 = "对应 new AcGeScale2d(AcGeScale2d::kIdentity)。已存在时先释放旧对象。" 注释 = "实测: 读 (1, 1), 与 创建() 的缺省件同值。">
    {
        如果 (对象指针 != 0)
        {
