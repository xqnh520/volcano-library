# ===

类 ARX点3D <公开 注释 = "封装 ObjectARX AcGePoint3d: 三维空间中的点。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGePoint3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "按坐标创建底层 AcGePoint3d。已存在时先释放旧对象。">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        对象指针 = ARX几何底层.新建点 (X, Y, Z)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGePoint3d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点 (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 设置 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint3d::set, 就地修改坐标。">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        返回 (ARX几何底层.置点坐标 (对象指针, X, Y, Z))
    }

