    参数 原点Y <类型 = 小数>
    参数 原点Z <类型 = 小数>
    参数 VX <类型 = 小数>
    参数 VY <类型 = 小数>
    参数 VZ <类型 = 小数>
    {
        如果 (轴退化 (UX - 原点X, UY - 原点Y, UZ - 原点Z, VX - 原点X, VY - 原点Y, VZ - 原点Z))
        {
            返回 (假)
        }

        如果 (对象指针 != 0)
        {
