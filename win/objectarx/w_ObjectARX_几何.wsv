    }

    方法 容差取样点数 <公开 类型 = 整数 注释 = "对应带容差的重载 AcGeCurve3d::getSamplePoints(fromParam, toParam, approxEps, pointArray, paramArray, forceResampling), 在 下限 到 上限 的参数区间内按 容差 折线, 折出几个点由底层决定; 曲线未创建返回 0。" 注释 = "实测 AcGe25: 点数有地板档, 半径 5 的整圆在 0..2PI 上 容差 1.0、0.5、0.1 都给 34, 0.01 给 51, 0.001 给 159, 1e-4 给 498; 90度弧在 0..PI/2 上 0.1 给 10; 整椭在 0..2PI 上 0.1 给 34; 线段与无限直线任意正容差都只给两端 2 个。" 注释 = "实测危险档底层不报错只给数: 容差 0 在圆和弧上落到 65 个点的定档, 但线段在 容差 0 上给 1048577 个点; 反序区间按正序给同样点数; 下限==上限 给 2; 下限 NaN 给 0 个点, 容差 NaN 落到地板档。" 注释 = "实测 AcGe25 强制重采样: 传 0 与传 1 同读数只在每一档都比上一档细的请求串上成立(已量的 圆、弧、线段、无限直线、椭圆 的 1.0 到 1e-3 阶梯与 弧 的 0 档全是这种串), 传 2 与传 1 同档(非 0 即真); 反过来一旦请求比这一档留的底粗, 传 0 会把旧账原样还回来而传 1 重折本档, 两档读数就不再相同 —— 见下面留底条款。这一位原样交给底层, 库层不猜效果。" 注释 = "实测 AcGe25 留底条款(二维、三维同一口径): 每条曲线按 (下限, 上限) 区间各留一笔折线账, 换区间另开一槽、不挤掉旧槽; 后续请求的 容差 不细于留底、又不粗过留底的整整一百倍(100 倍含界内、101 倍出界, 99.9 倍仍复用、100.1 倍重折)时旧账原样还回来, 本次入参的 容差 根本没进折线, 于是 容差取样点数、容差取样点、容差取样参数 都可能描述另一档; 倍数说了算、点数不设上限(1e-4 落账的 498 个点能整本交给 0.01 的请求); 容差 为 0 或为负都落在窗口外一律重折。更细的请求重折并覆盖该档的账, 单纯的读数不覆盖。洗账入口: 三维只有 强制重采样 传非 0, 它无条件重采并换掉这一档的账; 二维没有这一位, 只能 释放 后重建。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    参数 容差 <类型 = 小数>
    参数 强制重采样 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D容差取样点数 (对象指针, 下限, 上限, 容差, 强制重采样))
    }

    方法 容差取样点 <公开 类型 = 逻辑型 注释 = "按下标 序号 取一个容差取样点写入已创建的 结果, 合法下标 0 到 容差取样点数-1; 序号越界、曲线未创建或 结果 未创建返回假且不碰 结果。" 注释 = "实测 AcGe25: 合法下标与 容差取样点数 完全齐平, 整圆 0..2PI 的 0.1 档 #0 与 #33 都落在 (5,0,0), 后者参数就是 上限; 序号 34 判假且出参保持调用前写进去的哨兵值不动。" 注释 = "实测 AcGe25 留底条款(二维、三维同一口径): 每条曲线按 (下限, 上限) 区间各留一笔折线账, 换区间另开一槽、不挤掉旧槽; 后续请求的 容差 不细于留底、又不粗过留底的整整一百倍(100 倍含界内、101 倍出界, 99.9 倍仍复用、100.1 倍重折)时旧账原样还回来, 本次入参的 容差 根本没进折线, 于是 容差取样点数、容差取样点、容差取样参数 都可能描述另一档; 倍数说了算、点数不设上限(1e-4 落账的 498 个点能整本交给 0.01 的请求); 容差 为 0 或为负都落在窗口外一律重折。更细的请求重折并覆盖该档的账, 单纯的读数不覆盖。洗账入口: 三维只有 强制重采样 传非 0, 它无条件重采并换掉这一档的账; 二维没有这一位, 只能 释放 后重建。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    参数 容差 <类型 = 小数>
    参数 强制重采样 <类型 = 整数>
    参数 序号 <类型 = 整数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.曲线3D容差取样点 (对象指针, 下限, 上限, 容差, 强制重采样, 序号, 结果.对象指针))
    }

    方法 容差取样参数 <公开 类型 = 小数 注释 = "取同一次容差取样的第 序号 个点所在的曲线参数; 序号越界或曲线未创建返回 NaN。" 注释 = "实测 AcGe25: 参数数组与点数组等长, 34 个点只到 #33, #34 起为 NaN; 同一次调用里点数组与参数数组必属同一笔折线账, 按同一 序号 配对; 但读数不一定重折线 —— 请求不细于留底又不粗过一百倍时底层把旧账原样还回来, 所以全部入参必须与配对的 容差取样点 一字不差才对得上。" 注释 = "实测 AcGe25 留底条款(二维、三维同一口径): 每条曲线按 (下限, 上限) 区间各留一笔折线账, 换区间另开一槽、不挤掉旧槽; 后续请求的 容差 不细于留底、又不粗过留底的整整一百倍(100 倍含界内、101 倍出界, 99.9 倍仍复用、100.1 倍重折)时旧账原样还回来, 本次入参的 容差 根本没进折线, 于是 容差取样点数、容差取样点、容差取样参数 都可能描述另一档; 倍数说了算、点数不设上限(1e-4 落账的 498 个点能整本交给 0.01 的请求); 容差 为 0 或为负都落在窗口外一律重折。更细的请求重折并覆盖该档的账, 单纯的读数不覆盖。洗账入口: 三维只有 强制重采样 传非 0, 它无条件重采并换掉这一档的账; 二维没有这一位, 只能 释放 后重建。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    参数 容差 <类型 = 小数>
    参数 强制重采样 <类型 = 整数>
    参数 序号 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D容差取样参数 (对象指针, 下限, 上限, 容差, 强制重采样, 序号))
    }

    方法 是否落在平面 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isOn(plane), 判定整条直线是否躺在 平面 内。平面必须已创建。" 注释 = "实测 AcGe25: 线在面内为真; 平行不重合为假; 斜交、垂直为假。零法向的退化平面会让它返回真, 平面法向必须先非零。">
    参数 平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.线性3D落在平面 (对象指针, 平面.对象指针))
    }

    方法 是否平行平面 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isParallelTo(plane)。" 注释 = "参数类型是 ARX平面 对象而不是 变整数, 因为底层这个重载收的是 AcGePlanarEnt 引用, 与收直线/线段的 是否平行 不同。" 注释 = "实测 AcGe25: 直线躺在平面内同样判平行(于是 是否落在平面 与本方法同时为真); 平行不重合为真; 斜交与垂直为假。">
    参数 平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.线性3D平行平面 (对象指针, 平面.对象指针))
    }

    方法 是否垂直平面 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isPerpendicularTo(plane)。" 注释 = "实测 AcGe25: 只看方向与法向是否平行, 与直线是否真的穿过该平面无关(过 (0,0,5) 沿 +Z 的直线对 z=0 面判真)。">
    参数 平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.线性3D垂直平面 (对象指针, 平面.对象指针))
    }

    方法 取平面交点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::intersectWith(plane, intPnt), 交点写入已创建的 结果 点对象。" 注释 = "与直线求交的 取交点 分开命名: 本方法收平面。" 注释 = "实测 AcGe25: 相交返回真并写入交点; 平行不重合与直线落在面内都返回假, 且这两种情形都不碰 结果, 脏值原样保留。">
    参数 平面 <类型 = ARX平面>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D求交平面 (对象指针, 平面.对象指针, 结果.对象指针))
    }

    方法 取垂面 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::getPerpPlane(pnt, plane), 求过指定点且与本直线垂直的平面, 写入已创建的 结果 平面对象。" 注释 = "本方法把平面当出参, 方向与 是否落在平面 等把平面当入参的方法相反, 传未创建的 结果 会被底层守卫拦下返回假。" 注释 = "实测 AcGe25: 结果平面的法向就是直线方向, 且严格过给定点(参考点 = 给定点); 直线躺在某个面内时也照样给出以直线方向为法向的平面。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    参数 结果 <类型 = ARX平面>
    {
        返回 (ARX几何底层.线性3D垂面 (对象指针, 点X, 点Y, 点Z, 结果.对象指针))
    }

    方法 按平面镜像 <公开 类型 = 逻辑型 注释 = "对应 AcGeEntity3d::mirror(plane), 就地关于平面做镜像。三维线性实体只收平面这一个镜像重载, 二维侧的 按直线镜像 在这里没有对应物。" 注释 = "实测 AcGe25: 参考点与方向一起镜像, 方向顺带被单位化; 镜像两次回到原处。">
    参数 平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.线性3D按平面镜像 (对象指针, 平面.对象指针))
    }

    方法 取承载平面 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::isPlanar(plane), 判定曲线是否落在某一平面内, 并把该平面写入已创建的 结果 平面对象。" 注释 = "实测 AcGe25: 恒返回真, 结果平面过直线的参考点且法向与直线方向垂直, 但挑哪一个由底层决定: 非竖直方向得到法向落在 XY 面内的承载面, 竖直方向(平行 Z 轴)得到法向 +X、V 轴 = 直线方向。方向略微扰动就会换面, 不要当稳定输出, 它也不等于 取垂面 的结果。">
    参数 结果 <类型 = ARX平面>
    {
        返回 (ARX几何底层.线性3D是平面 (对象指针, 结果.对象指针))
    }

    方法 取斜投影类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::project(plane, direction): 类方法(不需要接收者), 只问投影结果的具体类型而不取回对象, 返回 AcGe::EntityId 整数, 用于决定该先创建哪一类对象再调 接收斜投影自。" 注释 = "返回码: -1 源曲线或投影平面未创建, -2 底层抛异常, -3 底层给出空指针, -4 投影方向与平面平行或给的是零向量。" 注释 = "实测 AcGe25 的类型编号: 19 直线, 23 线段, 11 圆弧, 17 椭圆弧, 5 是 AcGe::kPosition3d 即点实体(曲线垂直于投影面时退化成了它, 用 ARX点实体3D 接)。" 注释 = "实测 AcGe25: 整体落在投影面内的曲线沿不平行的方向投影, 像就是它本身(XY 整圆沿 (1,1,1) 投到 XY 仍是 11, 圆心半径都不动)。" 注释 = "实测 AcGe25: 投影方向与平面平行(XY 面沿 (1,0,0))或方向给零向量时, 底层照样 new 出一个类型看起来正常的实体, 但里面每个分量都是 NaN/Inf 且返回的类型编号仍是 19/17; 本方法与 接收斜投影自 都在进底层前按 方向 点积 法向 拦下(口径与 矩阵.设为平面投影 一致), 所以这两条接口永远不会把 NaN 交给你。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D投影类型 (源曲线, 投影平面.对象指针, 方向X, 方向Y, 方向Z, 假))
    }

    方法 取正投影类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::orthoProject(plane) 的类型查询: 类方法(不需要接收者), 返回码口径同 取斜投影类型, 只是 -4 永不触发(正投影本就沿平面法向走, 不可能与平面平行)。" 注释 = "实测 AcGe25: 直线垂直于投影面给 5(点实体); 法向为 (0,1,1) 的斜整圆正投影到 XY 给 17(椭圆弧); 侧立整椭圆正投影到 XY 塌成 23(线段); 零长线段正投影仍是 23 而不退化成 5。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.曲线3D投影类型 (源曲线, 投影平面.对象指针, 0.0, 0.0, 0.0, 真))
    }

    方法 接收斜投影自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::project(plane, direction): 把 源曲线 沿 方向 斜投影到 投影平面, 结果写进本对象。源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D/ARX射线3D 任一类的 对象指针, 投影平面 必须是已创建的 ARX平面。" 注释 = "所有权口径: 底层 project 返回 new 出来的 AcGeEntity3d*, 而 AcGeEntity3d 的析构非虚, 因此这个句柄一律不出桥 —— 桥内用 type() 还原具体类, 类型与本对象相符才赋值, 随后在桥内释放。" 注释 = "返回假: 三个句柄任一未创建、底层给出空指针、投影方向与平面平行或给的是零向量、或投影结果的具体类型与本对象不同(后两种情形本对象都保持不变); 类型不符先用 取斜投影类型 判型再建对应对象即可避开, 退化成点(编号 5)本类接不住, 那个落点交给 ARX点实体3D 接收; 源曲线 给 ARX射线3D 时像仍是 27 型射线, 本类同样判假。" 注释 = "实测 AcGe25: 类型不符时目标原值一位不动(脏圆心 (77,77,77) 与半径 9 保持), 不会先清后置; 目标未创建或平面未创建同样判假。" 注释 = "实测 AcGe25: 投影方向与平面平行或给零向量时底层返回真且类型正常, 但像的分量全是 NaN/Inf —— 本方法进底层前先拦, 恒不会把 NaN 写进本对象。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D投影进 (源曲线, 投影平面.对象指针, 方向X, 方向Y, 方向Z, 假, 对象指针))
    }

    方法 接收正投影自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::orthoProject(plane): 沿 投影平面 法向把 源曲线 正投影进本对象, 所有权与失败口径同 接收斜投影自。" 注释 = "实测 AcGe25: 一般斜线 (1,2,3)-(4,5,6) 正投影到 XY 得到线上点 (1,2,0) 与方向 (0.7071,0.7071,0); 线段 (-2,-3,5)-(4,1,7) 得到 (-2,-3,0)-(4,1,0); 法向 (0,1,1) 半径 5 的斜整圆得到椭圆弧, 圆心 (1,2,0)、长短 5 与 3.53553390593274(即 5/根号2)、长轴 (-1,0,0)。" 注释 = "实测 AcGe25: 整圆正投影到自身所在平面后 起始角 与 终止角 被底层改写成 -PI/2 与 3PI/2(源对象是 0..2PI), 圆心半径与闭合标志不动; 零长线段投影后起点终点重合在垂足 (1,1,0), 长度 0 且 取退化类型 给 5 而 取类型编号 仍是 23。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.曲线3D投影进 (源曲线, 投影平面.对象指针, 0.0, 0.0, 0.0, 真, 对象指针))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeLine3d), 用于校验结构内存布局。" 注释 = "实测 AcGe25: 为 16, 与 ARX线段3D 相同, 也与二维侧的 ARX直线2D/ARX线段2D 相同。对象内部如何摆放下参考点与方向并未公开, 不要按字段直觉预判这个值, 也不要把指针当结构体直接读写。">
    {
        返回 (ARX几何底层.直线3D结构尺寸 ())
    }

    方法 取分割片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getSplitCurves: 类方法(不需要接收者), 只问把 源曲线 在 分割参数 处切开后 片下标 (0 为首片、1 为末片) 那片的具体类型, 返回 AcGe::EntityId 整数, 用于决定该先创建哪一类对象再调 接收分割片自。" 注释 = "返回码: -1 源曲线未创建或 片下标 不是 0/1, -2 底层抛异常, -3 底层把该片给成空指针, 其余为该片的 AcGe::EntityId。" 注释 = "实测 AcGe25: 无限直线切出的两片恒为 kRay3d(27), 与 分割参数 无关, 也不存在切不开的参数; 取区间下限 与 取区间上限 都读成 0。">
    参数 源曲线 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D分割片类型 (源曲线, 分割参数, 片下标))
    }

    方法 接收分割片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getSplitCurves(param, piece1, piece2): 把 源曲线 在 分割参数 处切成的两片中的第 片下标 片写进本对象。源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D/ARX射线3D 任一类的 对象指针。" 注释 = "所有权口径: 底层返回 new 出来的 AcGeCurve3d*, 析构非虚, 该句柄一律不出桥 —— 桥内用 type() 还原具体类, 类型与本对象相符才赋值, 随后在桥内释放两片。" 注释 = "实测 AcGe25 且永远如此: 本方法在本类上恒为假 —— 三维无限直线的两片都是 kRay3d(27), 与本类 19 型不符; 包十九A 起了射线有类, 这类片归 ARX射线3D(二维侧同类实测: 无限直线的射线片与射线源的末片交给 ARX射线2D 都判真)。把 ARX线段3D 的片(23) 交给本类同样判假; 源曲线 换成 ARX射线3D 时类方法读出的两片是 23 与 27, 与本类型号同样都不符。射线片在桥内按 AcGeRay3d 释放, 不泄漏。">
    参数 源曲线 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D分割片进 (源曲线, 分割参数, 片下标, 对象指针))
    }

    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 在 法向 所指平面内偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2 或 法向三分量全为 0 (库层挡下, 一次都不调底层 —— 实测零法向底层不报错, 而是吐出一片无人可收的 kCompositeCrv3d(47), 区间还会从源的 0..π/2 读成 0..3π/2), -2 底层抛异常; 其余是片数, 0 片是正常返回不是错误。" 注释 = "实测 AcGe25: 过 (0,0,0) 方向 (1,0,0) 的无限直线对法向 (0,0,1) 在 d=+2 给 1 片, 片区间退化 0..0、长度读 0 与源同规格、间隙 2 (二维侧另量过 d=-2 与 +10, 同样 1 片); 法向三分量全为 0 时给 -1 且不调底层。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片数 (源曲线, 偏移距离, 延伸档, 法向X, 法向Y, 法向Z))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、法向三分量全为 0 (库层挡下)、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25: 片恒为 kLine3d(19) —— 与 分割 通道相反 (那给出射线 kRay3d(27)), 所以本类收得下自己源的偏移片。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 把 源曲线 在 法向 所指平面内偏出的第 片下标 片写进本对象。源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D 任一类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve3d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。法向三分量全为 0 时库层直接判假且不调底层。" 注释 = "实测 AcGe25: 本类是 19 片的唯一接收者; d=+2 时线上点读成 (0,2,0)。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z, 对象指针))
    }

    方法 是否重叠 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::overlap(line, overlap): 判定本直线与 对方 是否有公共部分。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针, 与本类互不限制。" 注释 = "实测 AcGe25: 与 2D 同一口径, 只有共线才判真; 端点相接、内部点相交、零长退化、平行偏移、异面这五档一律判假, 且判假时不写片。异面档不抛异常。" 注释 = "实测 AcGe25: 反向参数化同样判真 —— 线 (0,0,0)+方向(10,0,0) 与 线 (5,0,0)+方向(-1,0,0) 判真。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D重叠 (对象指针, 对方) == 1)
    }

    方法 取重叠片类型 <公开 类型 = 整数 注释 = "对应 AcGeLinearEnt3d::overlap: 只问本直线与 对方 的重叠片是什么类型。" 注释 = "返回码: -1 本直线未创建或 对方 指针无效, -3 SDK 判无重叠(此时不写片), 其余是片的 AcGe::EntityId。" 注释 = "实测 AcGe25: 本类的重叠片恒为 kLine3d(19), 与对方是直线还是线段无关。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D重叠片型 (对象指针, 对方))
    }

    方法 接收重叠片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::overlap(line, overlap): 把本直线与 对方 的重叠片写回本对象自己。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针, 与本类互不限制。" 注释 = "所有权口径同 接收分割片自: 句柄不出桥, 桥内按 type() 还原后赋值再释放。" 注释 = "实测 AcGe25: 本线过 (0,0,0) 方向 (10,0,0)、对方是 (2,0,0)-(4,0,0) 的线段时, 收下的仍是无限直线, 线上点 (0,0,0)、方向单位化读 (1,0,0), 区间被改写成 0.2..0.4 —— 即公共部分落在本线参数空间下的两档。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D重叠片收 (对象指针, 对方) == 1)
    }
}

# ===

类 ARX线段3D <公开 注释 = "封装 ObjectARX AcGeLineSeg3d: 三维有限线段, 对应 AutoCAD 的 3D LINE 与多段线一段。" 注释 = "与 ARX直线3D 共用 AcGeLinearEnt3d / AcGeCurve3d 的判定与求值接口, 所以 对方 参数类型是 变整数, 传 ARX直线3D 或 ARX线段3D 的 对象指针 均可; 收平面的那批方法(含本类专有的 取平分面)参数声明为 ARX平面 对象。" 注释 = "AcGeCurve3d 基类的曲线接口在本类已全部转发(是否过参数、取周期、取面积、取退化类型, 加上原有的 取参数区间长、参数按长度、反转参数), 但直线与线段的区间口径不同: 直线是退化的 0..0 且任意参数都算过, 线段是归一化的 0..1 且按端点截断。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeLineSeg3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLineSeg3d(), 创建一条零长度缺省线段; 已存在时先释放旧对象。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建线段3D ()
        返回 (对象指针 != 0)
    }

    方法 创建过两点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLineSeg3d(startPoint, endPoint), 第一点是起点。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 甲Z <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    参数 乙Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建线段3D过两点 (甲X, 甲Y, 甲Z, 乙X, 乙Y, 乙Z)
        返回 (对象指针 != 0)
    }

    方法 创建按方向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLineSeg3d(pnt, vec), 起点是 起点XYZ, 终点是 起点 + 方向 这个向量本身。" 注释 = "与 ARX直线3D.创建按方向 不同: 这里的向量决定段长, 不是无限方向。">
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 起点Z <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建线段3D方向 (起点X, 起点Y, 起点Z, 方向X, 方向Y, 方向Z)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeLineSeg3d 对象并把 对象指针 归零。不要用 ARX直线3D.释放 处理本对象的指针。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "本线段是目标, 参数 源 是数据来源且必须已创建。">
    参数 源 <类型 = ARX线段3D>
    {
        返回 (ARX几何底层.线段3D复制 (对象指针, 源.对象指针))
    }

    方法 设置 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg3d::set(pnt, vec), 起点是指定点, 终点是 指定点 + vec。">
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 起点Z <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        返回 (ARX几何底层.线段3D设置 (对象指针, 起点X, 起点Y, 起点Z, 方向X, 方向Y, 方向Z))
    }

    方法 设过两点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg3d::set(pnt1, pnt2)。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 甲Z <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    参数 乙Z <类型 = 小数>
    {
        返回 (ARX几何底层.线段3D设过两点 (对象指针, 甲X, 甲Y, 甲Z, 乙X, 乙Y, 乙Z))
    }

    方法 取起点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg3d::startPoint, 写入调用方已创建的 结果 点对象。" 注释 = "实测 AcGe25: 起点就是构造或 设过两点 给的第一点; 反转参数 后起点与终点对调。零长度线段两端相同, 起点仍然返回真。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线段3D起点 (对象指针, 结果.对象指针))
    }

    方法 取中点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg3d::midPoint。" 注释 = "实测 AcGe25: 缺省线段 (0,0,0)-(1,0,0) 得 (0.5,0,0); 不受 反转参数 影响。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线段3D中点 (对象指针, 结果.对象指针))
    }

    方法 取终点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg3d::endPoint。" 注释 = "实测 AcGe25: 缺省线段的终点是 (1,0,0), 即底层缺省构造的是单位长线段而不是重合端点。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线段3D终点 (对象指针, 结果.对象指针))
    }

    方法 取长度 <公开 类型 = 小数 注释 = "对应 AcGeLineSeg3d::length, 即两端点距离; 句柄无效返回 NaN。" 注释 = "实测 AcGe25: (0,0,0)-(3,4,5) 得 7.07106781186548, 零长度线段得 0; 与 取参数区间长(0,1) 同值, 因为线段参数按段长归一化到 0..1。">
    {
        返回 (ARX几何底层.线段3D长度 (对象指针))
    }

    方法 取分点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg3d::baryComb(blendCoeff): 两端点的重心组合。" 注释 = "实测 AcGe25: 混合系数 0 得 取起点, 1 得 取终点, 0.5 得中点; 不受 0..1 限制, -1 会外推到 (-3,-4,-5)。与 求值点 同尺度(线段区间为 0..1), 且跟随 反转参数 后的端点定义。">
    参数 混合系数 <类型 = 小数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线段3D分点 (对象指针, 混合系数, 结果.对象指针))
    }

    方法 取线上点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::pointOnLine。" 注释 = "实测 AcGe25: 与 2D 同口径, 线段返回的参考点就是起点, 与 取起点 一致; 需要中点或终点请改用 取中点/取终点。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D线上点 (对象指针, 结果.对象指针))
    }

    方法 取方向 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::direction, 写入调用方已创建的 结果 向量对象。" 注释 = "实测 AcGe25: 返回单位向量, (0,0,0)-(3,4,5) 得 (0.424264068711929,0.565685424949238,0.707106781186547)。" 注释 = "零长度线段返回 (0,0,0), 底层不做退化保护, 拿它当轴去 绕轴旋转 会得到静默无效的结果, 请先用 取长度 排除。">
    参数 结果 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.线性3D方向 (对象指针, 结果.对象指针))
    }

    方法 是否平行 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isParallelTo。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "实测 AcGe25: 只看方向, 反向线段判真; 零长度线段与任何对象都判假(方向为 (0,0,0))。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D平行 (对象指针, 对方))
    }

    方法 是否垂直 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isPerpendicularTo。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "实测 AcGe25: 与无限直线同口径, 只看方向不看是否共面; 异面但方向正交的两条线段判真, 而它们的 取交点 判假。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D垂直 (对象指针, 对方))
    }

    方法 是否共线 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isColinearTo。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "实测 AcGe25: 判定用的是所在无限直线, 与线段长度和端点位置无关; 部分重叠的两段判真, 线段与其承载直线判真。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D共线 (对象指针, 对方))
    }

    方法 近似等于 <公开 类型 = 逻辑型 注释 = "对应 AcGeEntity3d::isEqualTo(other)。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "实测 AcGe25: 与 2D 同口径, 比的是参数化而非所在直线。两条端点完全一致的线段判真; 端点顺序互换、同起点但长度两倍, 都判假; 与 ARX直线3D 跨类型比较双向都判假。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D近似相等 (对象指针, 对方))
    }

    方法 取交点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::intersectWith(line, intPnt)。" 注释 = "实测 AcGe25: 与 2D 线段同口径, 判定按各自自身的参数范围截断而不是按所在无限直线; (0,0,0)-(2,0,0) 与 (1,-1,0)-(1,1,0) 判真得 (1,0,0), 端点相接判真, 共线部分重叠与平行错开都判假。对方 可以是 ARX直线3D, 直线与线段可混着传。" 注释 = "三维特有的脏输出风险: 两实体异面(所在直线投影后相交)时同样返回假, 但 结果 会被写成公垂线在对方那一端的点((0,0,0)-(2,0,0) 段 对 过(3,0,5)沿Y 的直线得 (3,0,5)); 只有平行时才保持调用方原值。返回假不代表 结果 可信。">
    参数 对方 <类型 = 变整数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D求交 (对象指针, 对方, 结果.对象指针))
    }

    方法 取投影交点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::projIntersectWith(line, projDir, pntOnThisLine, pntOnOtherLine)。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针, 底层按基类引用接收, 两种可混传。" 注释 = "实测 AcGe25: 判交按各自自身的端点范围截断, 而且是双向的——本方段 (0,0,0)-(2,0,0) 对 段 (1,-1,1)-(1,3,1) 沿 Z 投影判真; 本方缩成 (0,0,0)-(0.5,0,0) 判假; 对方缩成 (1,4,1)-(1,6,1) 判假; 本方换成无限直线而对方缩成 (1,0.5,1)-(1,3,1) 同样判假。交点正好压在本方端点上算相交(段 (0,0,0)-(1,0,0) 对 段 (1,-1,1)-(1,1,1) 判真)。" 注释 = "判假的其余情形: 投影方向与本实体平行(沿 X 投 X向段)、投影后两实体方向平行、任一方是零长段。" 注释 = "与 ARX直线3D.取投影交点 同一个坑: 返回真也不写 本方 与 对方点, 出参点保持调用方原值, 只有返回值可用。">
    参数 对方 <类型 = 变整数>
    参数 投影X <类型 = 小数>
    参数 投影Y <类型 = 小数>
    参数 投影Z <类型 = 小数>
    参数 本方 <类型 = ARX点3D>
    参数 对方点 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D投影求交 (对象指针, 对方, 投影X, 投影Y, 投影Z, 本方.对象指针, 对方点.对象指针))
    }

    方法 是否过点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::isOn(pnt), 使用 AcGeContext::gTol。" 注释 = "实测 AcGe25: 与 2D 线段同口径, 点必须夹在两端口点之内; (0,0,0)-(3,4,5) 对 (1.5,2,2.5) 返回真, 对延长线上的 (6,8,10) 与 (-3,-4,-5) 返回假。零长度线段只接受与那一点重合的输入。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.线性3D过点 (对象指针, 点X, 点Y, 点Z))
    }

    方法 取参数 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::paramOf(pnt)。" 注释 = "实测 AcGe25: 与 2D 线段同口径, 已按段长归一化到 0..1, 起点 0、终点 1、中点 0.5; 段外的 (6,8,10) 得 2, 不截断也不报错。零长度线段的分母为 0, 返回 NaN(显示为 -NAN(IND)), 不要拿 0 当结果用。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.线性3D参数 (对象指针, 点X, 点Y, 点Z))
    }

