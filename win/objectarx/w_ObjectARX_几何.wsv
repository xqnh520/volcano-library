类 ARX点2D <公开 注释 = "封装 ObjectARX AcGePoint2d: 二维平面(UCS/块内/多段线顶点)中的点。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGePoint2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "按坐标创建底层 AcGePoint2d。已存在时先释放旧对象。">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点2D (X, Y)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGePoint2d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点2D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 设置 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::set, 就地修改坐标。">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    {
        返回 (ARX几何底层.置点2D坐标 (对象指针, X, Y))
    }

    方法 横坐标 <公开 属性读 类型 = 小数 注释 = "对应 AcGePoint2d::x。">
    {
        返回 (ARX几何底层.取点2DX (对象指针))
    }

    方法 横坐标 <公开 属性写 注释 = "写入 AcGePoint2d::x。">
    参数 欲写入属性值 <类型 = 小数>
    {
        ARX几何底层.置点2D坐标 (对象指针, 欲写入属性值, 纵坐标)
    }

    方法 纵坐标 <公开 属性读 类型 = 小数 注释 = "对应 AcGePoint2d::y。">
    {
        返回 (ARX几何底层.取点2DY (对象指针))
    }

    方法 纵坐标 <公开 属性写 注释 = "写入 AcGePoint2d::y。">
    参数 欲写入属性值 <类型 = 小数>
    {
        ARX几何底层.置点2D坐标 (对象指针, 横坐标, 欲写入属性值)
    }

    方法 到点距离 <公开 类型 = 小数 注释 = "对应 AcGePoint2d::distanceTo, 底层对象无效时返回 -1。">
    参数 另一点 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.点2D距离 (对象指针, 另一点.对象指针))
    }

    方法 近似等于 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::isEqualTo。容差 取负值(缺省)时走 AcGeContext::gTol 的欧氏距离容差, 否则使用调用方指定的容差。" 注释 = "火山不允许同类内同名重载, 因此缺省行为用负数哨兵参数表达。">
    参数 另一点 <类型 = ARX点2D>
    参数 容差 <类型 = 小数 @默认值 = -1.0>
    {
        如果 (容差 < 0)
        {
            返回 (ARX几何底层.点2D近似相等 (对象指针, 另一点.对象指针))
        }
        返回 (ARX几何底层.点2D近似相等容差 (对象指针, 另一点.对象指针, 容差))
    }

    方法 累加向量 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::operator += (AcGeVector2d), 就地平移。">
    参数 向量 <类型 = ARX向量2D>
    {
        返回 (ARX几何底层.点2D加向量 (对象指针, 向量.对象指针))
    }

    方法 减去向量 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::operator -= (AcGeVector2d), 就地平移。">
    参数 向量 <类型 = ARX向量2D>
    {
        返回 (ARX几何底层.点2D减向量 (对象指针, 向量.对象指针))
    }

    方法 差为向量 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::operator -, 把 本点 - 另一点 写入调用方已创建的 结果 对象(结果必须是已创建的 ARX向量2D)。">
    参数 另一点 <类型 = ARX点2D>
    参数 结果 <类型 = ARX向量2D>
    {
