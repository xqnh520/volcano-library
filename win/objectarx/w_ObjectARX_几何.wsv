    方法 曲线3D投影类型 <公开 静态 类型 = 整数 注释 = "对应 project / orthoProject 的返回类型, 正投影 为真走 orthoProject。" 注释 = "返回码: -1 句柄无效, -2 底层抛异常, -3 底层返回空指针, 其余为投影结果的 AcGe::EntityId。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 平面指针 <类型 = 变整数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    参数 正投影 <类型 = 逻辑型>
    {
        @ arx_ge_curve3d_project_type(@<对象指针>, @<平面指针>, @<方向X>, @<方向Y>, @<方向Z>, @<正投影>)
    }

    方法 曲线3D投影进 <公开 静态 类型 = 逻辑型 注释 = "对应 project / orthoProject: 只有当投影结果的具体类型与 目标指针 一致时才赋值, 临时对象在桥内释放。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 平面指针 <类型 = 变整数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    参数 正投影 <类型 = 逻辑型>
    参数 目标指针 <类型 = 变整数>
    {
        @ (arx_ge_curve3d_project_into(@<对象指针>, @<平面指针>, @<方向X>, @<方向Y>, @<方向Z>, @<正投影>, @<目标指针>) == 1)
    }

    方法 曲线3D分割片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getSplitCurves(param, piece1, piece2): 只问 分割参数 处 片下标 (0 或 1) 那片的具体类型, 返回 AcGe::EntityId 的整数值。" 注释 = "返回码: -1 指针无效或 片下标 不是 0/1, -2 底层抛异常, -3 底层把该片给成空指针; 其余为该片真实的 AcGe::EntityId, 用来决定该先创建哪一类对象再调 曲线3D分割片进。两片都是底层 new 出来的对象, 问完就在桥内释放, 不交给调用方。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        @ arx_ge_curve3d_split_type(@<对象指针>, @<分割参数>, @<片下标>)
    }

    方法 曲线3D分割片进 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getSplitCurves: 取回 片下标 那片, 只有当它的具体类型与 目标指针 报的 type() 相同才赋值进 目标指针。" 注释 = "所有权口径与 曲线3D投影进 同一套: 两片一律由桥内按 type() 还原具体类后释放, 句柄不出桥 —— AcGeEntity3d 的析构非虚, 按静态类型 delete 是未定义行为。类型不符、该片为空、指针无效都返回假且目标对象一位不动。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    参数 目标指针 <类型 = 变整数>
    {
        @ (arx_ge_curve3d_split_into(@<对象指针>, @<分割参数>, @<片下标>, @<目标指针>) == 1)
    }

    方法 法向是否零向量 <公开 静态 类型 = 逻辑型 注释 = "三条分量全为 0 的法向判真, 是本包 裁剪偏移 三个三维入口共用的第一道门; 与 设为旋转 挡住零旋转轴同一口径, 判式也照抄。" 注释 = "按裁定这道门放在库层而不是桥里。实测 AcGe25 对零法向既不抛异常也不给空表, 而是吐出一片 kCompositeCrv3d(47) 的复合曲线, 该片区间还会从源的 0..π/2 读成 0..3π/2、末端求值给 indeterminate NaN —— 火山侧没有类接得了它, 所以必须在进桥之前挡掉。">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        返回 (X * X + Y * Y + Z * Z <= 0)
    }

    方法 直接曲线3D裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "不带零法向门直调 arx_ge_curve3d_trim_offset_count, 仅供 曲线3D裁剪偏移片数 转出去。" 注释 = "火山规定 @嵌入式方法 里每个参数只能被访问一次, 所以零法向的判断没法写成一条 C 条件表达式, 只能拆成本类自己的 火山 语法方法, 由本方法之外的 曲线3D裁剪偏移片数 先把门再调进来。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        @ arx_ge_curve3d_trim_offset_count(@<对象指针>, @<偏移距离>, @<延伸档>, @<法向X>, @<法向Y>, @<法向Z>)
    }

    方法 曲线3D裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 问 对象指针 所指源曲线在 法向 所指平面内偏出 偏移距离 后拿到几片, 过了 法向是否零向量 这道门才进桥。" 注释 = "返回码: -1 法向三分量全为 0 (库层挡下, 一次都不调底层)、源指针无效或 延伸档 不在 0..2, -2 底层抛异常; 其余是片数, 0 片是正常返回不是错误。其余口径同 曲线2D裁剪偏移片数。" 注释 = "法向的两条实测口径 (AcGe25): 一、不需要单位化, (0,0,2) 与 (0,0,1) 读数完全相同, 底层自己归一; 二、符号约定挂在法向上而不只挂在距离上, 法向取反与 偏移距离 取负逐位等价。偏移只是在法向所指平面内平移, 斜着的 3D 源同样精确 —— 实测 (1,2,3)-(4,6,8) 对 (0,0,1) 偏 2, 片的两端各平移了模恰好为 2 的向量。">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        如果 (ARX几何底层.法向是否零向量 (法向X, 法向Y, 法向Z))
        {
            返回 (-1)
        }
        返回 (ARX几何底层.直接曲线3D裁剪偏移片数 (对象指针, 偏移距离, 延伸档, 法向X, 法向Y, 法向Z))
    }

    方法 直接曲线3D裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "不带零法向门直调 arx_ge_curve3d_trim_offset_type, 仅供 曲线3D裁剪偏移片类型 转出去。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        @ arx_ge_curve3d_trim_offset_type(@<对象指针>, @<偏移距离>, @<延伸档>, @<片下标>, @<法向X>, @<法向Y>, @<法向Z>)
    }

    方法 曲线3D裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset 过零法向门后的口径: 只问 片下标 那片的具体类型, 返回 AcGe::EntityId 的整数值。" 注释 = "返回码: -1 法向三分量全为 0 (库层挡下)、源指针无效、延伸档 不在 0..2、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。实测 AcGe25 3D 侧的片型只有 23 线段、11 圆弧或整圆、19 无限直线 三种叶类型, 加上整椭圆偏出来的 64 偏移曲线。">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        如果 (ARX几何底层.法向是否零向量 (法向X, 法向Y, 法向Z))
        {
            返回 (-1)
        }
        返回 (ARX几何底层.直接曲线3D裁剪偏移片类型 (对象指针, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z))
    }

    方法 直接曲线3D裁剪偏移片进 <公开 静态 类型 = 逻辑型 注释 = "不带零法向门直调 arx_ge_curve3d_trim_offset_into, 仅供 曲线3D裁剪偏移片进 转出去。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 目标指针 <类型 = 变整数>
    {
        @ (arx_ge_curve3d_trim_offset_into(@<对象指针>, @<偏移距离>, @<延伸档>, @<片下标>, @<法向X>, @<法向Y>, @<法向Z>, @<目标指针>) == 1)
    }

    方法 曲线3D裁剪偏移片进 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getTrimmedOffset 过零法向门后的口径: 取回 片下标 那片, 只有当它的具体类型与 目标指针 报的 type() 相同才赋值进 目标指针。" 注释 = "法向三分量全为 0 时本方法直接返回假且不调底层。所有权口径与 曲线3D分割片进 同一套: 片一律由桥内按 type() 还原具体类后释放, 句柄不出桥。类型不符(片是 64 偏移曲线而 3D 侧只有 11/19/23 三类接收者)、该片为空、指针无效同样返回假且目标对象一位不动。">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 目标指针 <类型 = 变整数>
    {
        如果 (ARX几何底层.法向是否零向量 (法向X, 法向Y, 法向Z))
        {
            返回 (假)
        }
        返回 (ARX几何底层.直接曲线3D裁剪偏移片进 (对象指针, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z, 目标指针))
    }
    方法 新建点实体3D <公开 静态 类型 = 变整数 注释 = "对应 new AcGePosition3d()。" @嵌入式方法 = "">
    {
        @ arx_ge_position3d_new()
    }

    方法 新建点实体3D过点 <公开 静态 类型 = 变整数 注释 = "对应 new AcGePosition3d(x, y, z)。" @嵌入式方法 = "">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ arx_ge_position3d_new_pnt(@<X>, @<Y>, @<Z>)
    }

    方法 释放点实体3D <公开 静态 注释 = "对应 delete AcGePosition3d*。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
