    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D分割片进 (源曲线, 分割参数, 片下标, 对象指针))
    }

    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建或 延伸档 不在 0..2, -2 底层抛异常; 其余是片数, 0 片是正常返回不是错误。" 注释 = "实测 AcGe25 在偏移曲线源上再偏(延伸档 0): 外扩 d=-2 时线段源、90 度弧源、整圆源、整椭源各给 1 片; 内收 d=+2 时只有整圆源给 1 片, 其余全 0 片; 无限直线源与零长线段源给 0 片。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片数 (源曲线, 偏移距离, 延伸档))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数, 用来决定该先创建哪一类对象再调 接收裁剪偏移自。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25: 偏移曲线偏出来的片仍是 63, 又是一条偏移曲线。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 把 源曲线 偏出的第 片下标 片写进本对象。源曲线 传任一二维曲线类或本类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve2d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。类型不符、该片为空、指针无效都返回假且本对象一位不动。" 注释 = "包十一当年这一档在本类位置是恒假的(63 片无人可收, 类库里没有偏移曲线类), 包十七补上 ARX偏移曲线2D 之后本类成了 63 片的第二个接收者(第一个是它自己); 收进来的仍是桥内新造的私有副本, 与 复制自 同一条通道。" 注释 = "两条硬前提(实测): 一、本对象必须已创建还活着 —— 从未创建时本方法回假且 对象指针 仍是 0、是否有效 也回假; 二、片下标 越界时同样回假, 但活接收者的句柄、有效旗标与 取偏移距离 一位不动。" 注释 = "收进来以后 取偏移距离 读的是相对最初源曲线的累计值: 甲=offset(圆2,+2) 已内偏到半径 3, 它的裁偏片再内偏 2 那片 距 读 4; 甲=offset(圆2,-2) 的裁偏片 d=+2 那片 距 读 0、正好落回源圆。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 对象指针))
    }

    方法 近似等于 <公开 类型 = 逻辑型 注释 = "对应 AcGeEntity2d::isEqualTo(other), 使用继承来的缺省容差口径。" 注释 = "实测 AcGe25 恒假: 与源曲线比假, 与自己比也假, 把 偏移距离 设成 0(此时曲线与源逐位重合、到曲线距离 读 0)仍判假; 句柄无效或对方句柄无效同样假。要判两条偏移曲线是否同一状态, 请自己比 取源类型编号、取偏移距离 与几个曲线族读数。" 注释 = "两侧不同的一条(实测): 二维的分割片对父曲线判假 —— 乙=甲 的首片就躺在 甲 上、到曲线距离 读 0, 本方法仍答假; 三维同一个比对法答真(见 ARX偏移曲线3D)。别拿本方法判片与父的关系。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.曲线2D近似相等 (对象指针, 对方))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeOffsetCurve2d), 用于校验结构内存布局。" 注释 = "实测 AcGe25: 16 字节, 与 ARX直线2D、ARX平面 同宽, 也与三维侧同宽 —— 源曲线那份私有副本全挂在 pImpl 上, 这个尺寸判不出对象里有没有源。">
    {
        返回 (ARX几何底层.偏移曲线2D结构尺寸 ())
    }
}

# ===

类 ARX偏移曲线3D <公开 注释 = "封装 ObjectARX AcGeOffsetCurve3d: 空间偏移曲线对象, 底层类型编号 64 = AcGe::kOffsetCurve3d, 由 (源曲线, 法向, 偏移距离) 三元组定义, 继承链 AcGeOffsetCurve3d -> AcGeCurve3d -> AcGeEntity3d。本包十七的第 24 个公开类。" 注释 = "与二维兄弟类 ARX偏移曲线2D 的差别只有三处: 一、构造与 设法向 多一个 法向, 偏移在 法向 所指平面内进行; 二、曲线族长度那一档叫 取参数区间长(三维侧基类口径), 二维叫 取参数段长; 三、多一个恒真的 取承载平面。其余方法、所有权、符号约定与二维逐条相同, 类注释一并照二维侧写。" 注释 = "所有权(本类最重要的一条): 桥内替每个句柄按型深拷贝一份源曲线交给 SDK, 本句柄独占那份副本 —— 用户传进来的源曲线此后可以先 释放, 本对象不受影响; 反过来 释放 本对象也只销毁自己那份副本, 绝不碰用户手里那条源曲线。代价是底层 curve() 不再等于用户传入的源指针, 所以本类不提供任何 是否同一曲线 式的别名查询, 只有 取源类型编号。" 注释 = "符号与直觉相反(实测 AcGe25): 正 偏移距离 使闭合曲线向内收, 负值才外扩。半径 5 的整圆源 d=+2 得半径 3(取参数区间长 18.8495559215388、取面积 28.2743338823081), d=-2 得半径 7(43.9822971502571 与 153.9380400259), 与二维同一条曲线。" 注释 = "法向三条实测口径: 一、不需要单位化, (0,0,2) 与 (0,0,1) 读数完全相同, 底层自己归一; 二、(1,1,1) 存成三个 0.577350269189626, 法向取反与 偏移距离 取负逐位等价; 三、零向量在本类被 设法向 拦回假(实测 SDK 对零法向回真且静默不偏移: 圆3 源 n=0 时 取参数区间长 仍是源自身的 31.4159265358979、到曲线距离 读 0), 构造时的零法向不拦, 见 创建过源曲线。" 注释 = "构造门槛(桥内硬预检, 四类都回假且 对象指针 保持 0): 一、源指针无效; 二、源型克隆不了(四个三维叶型与 64 自身之外); 三、源曲线区间弧长为 0 —— 无限直线源与零长线段源都落在这里, 实测不拦会静默出垃圾(无限直线源偏 2 的 到点距离 读 6.16441400296898 而 到曲线距离 读 2.97619047619046E+18); 四、底层构造抛异常。副作用要记住: 三维无限直线源在本类一律造不出来。" 注释 = "三维侧一条只能告警不能拦的坑(实测): 缺省构造的三维圆弧(创建() 那条单位弧)向内偏 2 时 SDK 不抛, 造出来的对象 取参数区间长 读 6.28318530717959 = 源自身周长、到曲线距离 读 0, 也就是静默没偏移; 二维同一个调用经本类生产通道也不抛, 两侧同解: 半径算成 1-2=-1 后取绝对值回到 1、与源逐点重合、起止点都翻到 (-1,0,0)、这一档 取偏移距离 仍读 2 而 到曲线距离 读 0。用 取偏移距离 与 到曲线距离 核对偏移是否真生效 —— 只有后者能看出这一档其实没偏。" 注释 = "片通道口径: explode 在本类恒假且 0 片; getSplitCurves 与 getTrimmedOffset 从偏移曲线切出来的片又是一条偏移曲线(实测类型 64), 八个叶类全都拒收, 只有本类收得下, 而且这里的接收者必须已创建、还活着 —— 本类没有无参 创建, 唯一合法的起手是先 创建过源曲线 造一个占位对象再接片, 与二维同一套。接收者从未创建时两条入口一律回假、对象指针 归 0、是否有效 也回假; 接收者活着而 片下标 越界时同样回假, 但句柄非 0、仍有效、取偏移距离 保持自己的旧值。收进来的是桥内按型新建的私有副本(与 复制自 同一条通道), 每片各用一个本类对象接住并各自 释放, 父曲线 释放 之后两片照样读得出全套数(实测两片各自 长 3π)。" 注释 = "取裁剪偏移自 收进来的片, 偏移距离 是相对最初源曲线的累计值(实测): 甲3=offset(圆3,法向z,+2) 半径已收到 3, 它的裁偏片再内偏 2 那片 距 读 4; 法向不变时三维与二维逐位同解。分割片 那一档 距 保持父值 2、区间换成半圈, 半片躺在父曲线上所以对父 到曲线距离 读 0。" 注释 = "非有限入参拦在本类火山层: 取参数、求值点、到点距离、取最近点、是否过点 任一分量是 NaN 就不进桥, 回假或回 NaN。理由(实测): 偏移曲线上 isOn(NaN,NaN,NaN) 直接把进程干掉(二维同调用只回 0), 而八个叶类上同样入参都不崩 —— 所以这道门只加在本类, 不动共享的曲线族底层导出。" 注释 = "曲线族三条与叶类不同的口径(实测): 一、是否闭合 跟着源形走, 无限直线源与零长线段源也判真; 二、取周期 只有整圆源与整椭源给 6.28318530717959, 其余一律 NaN; 三、取退化类型 恒 -1, 连零长线段源也 -1。" 注释 = "使用前必须调用 创建过源曲线, 使用完毕后调用 释放 归还底层对象与本句柄那份源副本。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeOffsetCurve3d 对象地址, 0 表示尚未创建。">

    方法 创建过源曲线 <公开 类型 = 逻辑型 注释 = "对应 new AcGeOffsetCurve3d(curve, normal, distance): 源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D/ARX射线3D 任一类的 对象指针, 也可以是另一条 ARX偏移曲线3D 的 对象指针。偏移在 法向 所指平面内进行。已存在时先释放旧对象再新建。" 注释 = "所有权: 桥内立刻按型深拷贝一份 源曲线 交给 SDK, 本句柄独占那份副本, 之后 源曲线 可以先释放而不影响本对象。" 注释 = "回假的门槛见类注释: 源指针无效、源型克隆不了、源曲线区间弧长为 0(无限直线源、射线源与零长线段源, 射线源实测回假且 源类型编号 读 -1)、底层构造抛异常。法向 不在这道门里判零(与 设法向 不同), 零法向照交给底层, 实测结果是静默不偏移。失败时 对象指针 保持 0。">
    参数 源曲线 <类型 = 变整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 偏移距离 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放偏移曲线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建偏移曲线3D (源曲线, 法向X, 法向Y, 法向Z, 偏移距离)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeOffsetCurve3d 本体, 再销毁本句柄自己那份源副本, 最后把 对象指针 归零。用户手里那条源曲线不在本方法的射程内, 由调用方自己释放。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放偏移曲线3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。只看自己的句柄: 造不出来时 创建过源曲线 已把 对象指针 留在 0。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "深拷贝 源 的当前状态进本对象: 按型克隆 源 的源副本, 再搬来 偏移距离、法向 与参数区间。不走 SDK 的拷贝构造与赋值 —— 那两条只搬源指针, 会让两个句柄共用同一份副本, 与桥内『每个句柄独占一份副本』的所有权相冲。" 注释 = "因此本类每个对象的副本都唯一, 不存在两个对象共享一份的情况; 源 未创建、本对象未创建或 源 不是偏移曲线类型都回假且本对象一位不动。" 注释 = "实测 AcGe25: 副本改 设偏移距离(-1.5) 之后 源 的 取偏移距离 仍是 2, 两边互不影响。">
    参数 源 <类型 = ARX偏移曲线3D>
    {
        返回 (ARX几何底层.偏移曲线3D复制 (对象指针, 源.对象指针))
    }

    方法 设源曲线 <公开 类型 = 逻辑型 注释 = "对应 setCurve(curve): 先按型克隆新源, setCurve 之后才销毁旧副本, 所以换源失败不会把对象留在悬垂状态。回假时本对象一位不动, 门槛与 创建过源曲线 相同(源指针无效、源型克隆不了、源区间弧长为 0 都拒; 法向 仍不在这道门里)。" 注释 = "实测 AcGe25: 换源之后 取源类型编号 跟着换成新源的型(线段源克隆自报 23), 区间与长度按新源重算, 法向与 偏移距离 保持不变。">
    参数 源曲线 <类型 = 变整数>
    {
        返回 (ARX几何底层.偏移曲线3D设曲线 (对象指针, 源曲线))
    }

    方法 设偏移距离 <公开 类型 = 逻辑型 注释 = "对应 setOffsetDistance(distance): 底层这一档无返回值, 回真只表示调用走通; 句柄不是偏移曲线类型时回假。" 注释 = "符号与直觉相反: 正值内收、负值外扩(见类注释)。实测 AcGe25: 半径 5 的整圆源在 d=+2 时 取参数区间长 18.8495559215388, 改成 -2 后读 43.9822971502571。">
    参数 偏移距离 <类型 = 小数>
    {
        返回 (ARX几何底层.偏移曲线3D设距 (对象指针, 偏移距离))
    }

    方法 取偏移距离 <公开 类型 = 小数 注释 = "对应 offsetDistance(); 句柄无效或底层抛异常返回 NaN。" 注释 = "实测 AcGe25: 构造给多少读多少, 与法向是否退化无关(零法向那条仍读回 2, 只是曲线没偏)。">
    {
        返回 (ARX几何底层.偏移曲线3D取距 (对象指针))
    }

    方法 设法向 <公开 类型 = 逻辑型 注释 = "对应 setNormal(vector): 底层这一档无返回值, 回真只表示调用走通。三条分量全为 0 时本方法直接回假且不动对象 —— 复用本包 法向是否零向量 那道共享门, 与 接收裁剪偏移自 一族同一口径。" 注释 = "拦零的理由(实测): SDK 对零法向回真且静默不偏移, 圆3 源 n=0 时 取参数区间长 仍是源自身的 31.4159265358979、到曲线距离 读 0, 对象看起来正常而几何完全没动, 最难查。" 注释 = "实测三条口径: 不需要单位化(0,0,2) 与 (0,0,1) 等价; (1,1,1) 存成三个 0.577350269189626; 设法向(0,1,0) 之后 取法向 逐位回读 0,1,0。含 NaN 的分量由桥内挡回假。">
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        如果 (ARX几何底层.法向是否零向量 (法向X, 法向Y, 法向Z))
        {
            返回 (假)
        }
        返回 (ARX几何底层.偏移曲线3D设法向 (对象指针, 法向X, 法向Y, 法向Z))
    }

    方法 取法向 <公开 类型 = 逻辑型 注释 = "对应 normal(): 三个分量写进调用方已创建的 ARX向量3D; 句柄无效、出参未创建或底层抛异常回假且不碰 出参。" 注释 = "实测 AcGe25 读回的是底层归一化之后的值: 构造给 (0,0,2) 读 0,0,1; 给 (1,1,1) 读三个 0.577350269189626; 构造时给零向量则原样读 0,0,0(只有 设法向 那道门会拦零)。">
