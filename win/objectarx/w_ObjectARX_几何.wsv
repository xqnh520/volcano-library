    }

    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建或 延伸档 不在 0..2, -2 底层抛异常; 其余是片数。0 片是正常返回不是错误 —— 内偏越过临界量就拿不到片。片数配 取裁剪偏移片类型 与 接收裁剪偏移自 逐个使用, 片的句柄不出桥。" 注释 = "实测 AcGe25: 长半轴 3、短半轴 2 的整椭圆, 内偏越过短半轴 (d=+2、+5) 给 0 片, 外偏 d=-2、d=-0.5 与小内偏 d=+0.5 各给 1 片 (片长 28.4318102037522 / 19.007032242671 / 12.7238469359349, 源长 15.8654395893345); 临界量是短半轴而不是长半轴。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片数 (源曲线, 偏移距离, 延伸档))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数, 用来决定该先创建哪一类对象再调 接收裁剪偏移自。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25 且永远如此: 整椭圆偏出的片是 kOffsetCurve2d(63) 惰性偏移对象, 不是任何叶类型 —— 火山侧没有 63 对应的类。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 把 源曲线 偏出的第 片下标 片写进本对象。源曲线 传 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D 任一类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve2d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。类型不符、该片为空、指针无效都返回假且本对象一位不动。" 注释 = "实测 AcGe25 且永远如此: 本方法在本类上恒为假 —— 63 的片四个二维曲线类全都拒收; ARX偏移曲线2D 虽已封成独立类, 但它只由 创建过源曲线 自己 new 出来、从不作为片被接收, 片仍在桥内按 AcGeOffsetCurve2d 自己的类型释放, 不泄漏 (本包为此给释放分发补了 63 分支)。方法保留而不删是为了八个类接口对齐, 恒假由几何内核断言钉住。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 对象指针))
    }
}

# ===

类 ARX椭圆弧3D <公开 注释 = "封装 ObjectARX AcGeEllipArc3d: 三维空间中的椭圆弧(含整椭圆), 由圆心、长轴向量、短轴向量、长半径、短半径和起止角定义, 所在平面由两个轴向向量的叉积给出。" 注释 = "本类同时把继承自 AcGeCurve3d/AcGeEntity3d 的通用曲线接口一并暴露出来, 参数类型是 变整数 的方法可以接收 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D 的 对象指针。" 注释 = "使用前必须调用 创建 或任一 创建XX, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeEllipArc3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc3d(), 创建缺省椭圆弧; 已存在时先释放旧对象。" 注释 = "实测 AcGe25: 缺省对象就是一个单位圆整椭圆, 三轴取标准方向。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧3D ()
        返回 (对象指针 != 0)
    }

    方法 创建轴长 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc3d(cent, majorAxis, minorAxis, majorRadius, minorRadius), 起止角取缺省值即整椭圆。" 注释 = "实测 AcGe25: 只给轴向与半径时起止角自动取 0..2PI 即整椭圆, 法向由两轴叉积给出。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 圆心Z <类型 = 小数>
    参数 长轴X <类型 = 小数>
    参数 长轴Y <类型 = 小数>
    参数 长轴Z <类型 = 小数>
    参数 短轴X <类型 = 小数>
    参数 短轴Y <类型 = 小数>
    参数 短轴Z <类型 = 小数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧3D轴 (圆心X, 圆心Y, 圆心Z, 长轴X, 长轴Y, 长轴Z, 短轴X, 短轴Y, 短轴Z, 长半径, 短半径)
        返回 (对象指针 != 0)
    }

    方法 创建带角度 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc3d(cent, majorAxis, minorAxis, majorRadius, minorRadius, ang1, ang2)。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 圆心Z <类型 = 小数>
    参数 长轴X <类型 = 小数>
    参数 长轴Y <类型 = 小数>
    参数 长轴Z <类型 = 小数>
    参数 短轴X <类型 = 小数>
    参数 短轴Y <类型 = 小数>
    参数 短轴Z <类型 = 小数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    参数 起始角 <类型 = 小数>
    参数 终止角 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧3D角 (圆心X, 圆心Y, 圆心Z, 长轴X, 长轴Y, 长轴Z, 短轴X, 短轴Y, 短轴Z, 长半径, 短半径, 起始角, 终止角)
        返回 (对象指针 != 0)
    }

    方法 创建自圆弧 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc3d(arc), 把一个三维圆圆弧原样搬成椭圆弧。" 注释 = "实测 AcGe25: 连同圆弧的起止角一并带走, 非整圆时区间不再等于 0..2PI; 长短半径被写成同一个值。">
    参数 圆弧 <类型 = ARX圆弧3D>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧3D自圆弧 (圆弧.对象指针)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeEllipArc3d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "本椭圆弧是目标, 参数 源 是数据来源且必须已创建。" 注释 = "实测 AcGe25: 本对象必须已创建(对象指针 非 0)才返回真, 指针为 0 时判假且不复活指针。">
    参数 源 <类型 = ARX椭圆弧3D>
    {
        返回 (ARX几何底层.椭圆弧3D复制 (对象指针, 源.对象指针))
    }

    方法 设置轴长 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::set(cent, majorAxis, minorAxis, majorRadius, minorRadius), 就地改写, 起止角取缺省值。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 圆心Z <类型 = 小数>
    参数 长轴X <类型 = 小数>
    参数 长轴Y <类型 = 小数>
    参数 长轴Z <类型 = 小数>
    参数 短轴X <类型 = 小数>
    参数 短轴Y <类型 = 小数>
    参数 短轴Z <类型 = 小数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D设置轴 (对象指针, 圆心X, 圆心Y, 圆心Z, 长轴X, 长轴Y, 长轴Z, 短轴X, 短轴Y, 短轴Z, 长半径, 短半径))
    }

    方法 设置带角度 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::set(cent, majorAxis, minorAxis, majorRadius, minorRadius, startAngle, endAngle)。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 圆心Z <类型 = 小数>
    参数 长轴X <类型 = 小数>
    参数 长轴Y <类型 = 小数>
    参数 长轴Z <类型 = 小数>
    参数 短轴X <类型 = 小数>
    参数 短轴Y <类型 = 小数>
    参数 短轴Z <类型 = 小数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    参数 起始角 <类型 = 小数>
    参数 终止角 <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D设置角 (对象指针, 圆心X, 圆心Y, 圆心Z, 长轴X, 长轴Y, 长轴Z, 短轴X, 短轴Y, 短轴Z, 长半径, 短半径, 起始角, 终止角))
    }

    方法 设置自圆弧 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::set(arc), 就地按给定圆弧重建本椭圆弧。">
    参数 圆弧 <类型 = ARX圆弧3D>
    {
        返回 (ARX几何底层.椭圆弧3D设置自圆弧 (对象指针, 圆弧.对象指针))
    }

    方法 设圆心 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::setCenter。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 圆心Z <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D设圆心 (对象指针, 圆心X, 圆心Y, 圆心Z))
    }

    方法 设长半径 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::setMajorRadius。" 注释 = "实测 AcGe25: 负值被取绝对值且返回真, 不报错。">
    参数 半径 <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D设长半径 (对象指针, 半径))
    }

    方法 设短半径 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::setMinorRadius。" 注释 = "实测 AcGe25: 负值同样取绝对值; 短半径可以大于长半径, 底层不自动交换。">
    参数 半径 <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D设短半径 (对象指针, 半径))
    }

    方法 设轴 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::setAxes(majorAxis, minorAxis), 只改两个轴向向量, 不动两个半径。" 注释 = "实测 AcGe25: 两轴给零向量被收下并退化类型 5(kPosition3d); 两轴共线查不出来退化类型仍 -1; 非单位向量被归一化。">
    参数 长轴X <类型 = 小数>
    参数 长轴Y <类型 = 小数>
    参数 长轴Z <类型 = 小数>
    参数 短轴X <类型 = 小数>
    参数 短轴Y <类型 = 小数>
    参数 短轴Z <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D设轴向 (对象指针, 长轴X, 长轴Y, 长轴Z, 短轴X, 短轴Y, 短轴Z))
    }

    方法 设起止角 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::setAngles。" 注释 = "实测 AcGe25: 起角大于止角被规整而不是交换; 跨度超过 2PI 照收但闭合判假、周期转 NaN; 起止同角塌成点。">
    参数 起始角 <类型 = 小数>
    参数 终止角 <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D设起终角 (对象指针, 起始角, 终止角))
    }

    方法 取圆心 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::center, 结果写入已创建的 结果。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.椭圆弧3D圆心 (对象指针, 结果.对象指针))
    }

    方法 取长半径 <公开 类型 = 小数 注释 = "对应 AcGeEllipArc3d::majorRadius。">
    {
        返回 (ARX几何底层.椭圆弧3D长半径 (对象指针))
    }

    方法 取短半径 <公开 类型 = 小数 注释 = "对应 AcGeEllipArc3d::minorRadius。">
    {
        返回 (ARX几何底层.椭圆弧3D短半径 (对象指针))
    }

    方法 取长轴 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::majorAxis。">
    参数 结果 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.椭圆弧3D长轴 (对象指针, 结果.对象指针))
    }

    方法 取短轴 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::minorAxis。">
    参数 结果 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.椭圆弧3D短轴 (对象指针, 结果.对象指针))
    }

    方法 取法向 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::normal。" 注释 = "实测 AcGe25: 法向由长短轴叉积给出, 绕 Y 轴转 90 度后从 +Z 换到 +X; 变换后的分量并非精确 0/1, 比较要用容差。">
    参数 结果 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.椭圆弧3D法向 (对象指针, 结果.对象指针))
    }

    方法 取起始角 <公开 类型 = 小数 注释 = "对应 AcGeEllipArc3d::startAng。">
    {
