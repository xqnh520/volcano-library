    }

    方法 容差取样点数 <公开 类型 = 整数 注释 = "对应带容差的重载 AcGeCurve2d::getSamplePoints(fromParam, toParam, approxEps, pointArray, paramArray), 在 下限 到 上限 的参数区间内按 容差 折线, 折出几个点由底层决定; 曲线未创建返回 0。" 注释 = "实测 AcGe25: 点数有地板档, 半径 5 的整圆在 0..2PI 上 容差 1.0、0.5、0.1 都给 34, 0.01 给 51, 0.001 给 159, 1e-4 给 498; 90度弧在 0..PI/2 上 0.1 给 10; 整椭在 0..2PI 上 0.1 给 34; 线段与无限直线任意正容差都只给两端 2 个。" 注释 = "实测危险档底层不报错只给数: 容差 0 在圆和弧上落到 65 个点的定档, 但线段在 容差 0 上给 1048577 个点; 反序区间按正序给同样点数; 下限==上限 给 2; 下限 NaN 给 0 个点, 容差 NaN 落到地板档。" 注释 = "实测 AcGe25 留底条款(二维、三维同一口径): 每条曲线按 (下限, 上限) 区间各留一笔折线账, 换区间另开一槽、不挤掉旧槽; 后续请求的 容差 不细于留底、又不粗过留底的整整一百倍(100 倍含界内、101 倍出界, 99.9 倍仍复用、100.1 倍重折)时旧账原样还回来, 本次入参的 容差 根本没进折线, 于是 容差取样点数、容差取样点、容差取样参数 都可能描述另一档; 倍数说了算、点数不设上限(1e-4 落账的 498 个点能整本交给 0.01 的请求); 容差 为 0 或为负都落在窗口外一律重折。更细的请求重折并覆盖该档的账, 单纯的读数不覆盖。洗账入口: 三维只有 强制重采样 传非 0, 它无条件重采并换掉这一档的账; 二维没有这一位, 只能 释放 后重建。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    参数 容差 <类型 = 小数>
    {
        返回 (ARX几何底层.曲线2D容差取样点数 (对象指针, 下限, 上限, 容差))
    }

    方法 容差取样点 <公开 类型 = 逻辑型 注释 = "按下标 序号 取一个容差取样点写入已创建的 结果, 合法下标 0 到 容差取样点数-1; 序号越界、曲线未创建或 结果 未创建返回假且不碰 结果。" 注释 = "实测 AcGe25: 合法下标与 容差取样点数 完全齐平, 整圆 0..2PI 的 0.1 档 #0 与 #33 都落在 (5,0), 后者参数就是 上限; 序号 34 判假且出参保持调用前写进去的哨兵值不动。" 注释 = "实测 AcGe25 留底条款(二维、三维同一口径): 每条曲线按 (下限, 上限) 区间各留一笔折线账, 换区间另开一槽、不挤掉旧槽; 后续请求的 容差 不细于留底、又不粗过留底的整整一百倍(100 倍含界内、101 倍出界, 99.9 倍仍复用、100.1 倍重折)时旧账原样还回来, 本次入参的 容差 根本没进折线, 于是 容差取样点数、容差取样点、容差取样参数 都可能描述另一档; 倍数说了算、点数不设上限(1e-4 落账的 498 个点能整本交给 0.01 的请求); 容差 为 0 或为负都落在窗口外一律重折。更细的请求重折并覆盖该档的账, 单纯的读数不覆盖。洗账入口: 三维只有 强制重采样 传非 0, 它无条件重采并换掉这一档的账; 二维没有这一位, 只能 释放 后重建。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    参数 容差 <类型 = 小数>
    参数 序号 <类型 = 整数>
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.曲线2D容差取样点 (对象指针, 下限, 上限, 容差, 序号, 结果.对象指针))
    }

    方法 容差取样参数 <公开 类型 = 小数 注释 = "取同一次容差取样的第 序号 个点所在的曲线参数; 二维侧带参数数组的重载只有这一条, 所以 取样参数 读不到的东西这里读得到; 序号越界或曲线未创建返回 NaN。" 注释 = "实测 AcGe25: 参数数组与点数组等长, 34 个点只到 #33, #34 起为 NaN; 同一次调用里点数组与参数数组必属同一笔折线账, 按同一 序号 配对; 但读数不一定重折线 —— 请求不细于留底又不粗过一百倍时底层把旧账原样还回来, 所以全部入参必须与配对的 容差取样点 一字不差才对得上。" 注释 = "实测 AcGe25 留底条款(二维、三维同一口径): 每条曲线按 (下限, 上限) 区间各留一笔折线账, 换区间另开一槽、不挤掉旧槽; 后续请求的 容差 不细于留底、又不粗过留底的整整一百倍(100 倍含界内、101 倍出界, 99.9 倍仍复用、100.1 倍重折)时旧账原样还回来, 本次入参的 容差 根本没进折线, 于是 容差取样点数、容差取样点、容差取样参数 都可能描述另一档; 倍数说了算、点数不设上限(1e-4 落账的 498 个点能整本交给 0.01 的请求); 容差 为 0 或为负都落在窗口外一律重折。更细的请求重折并覆盖该档的账, 单纯的读数不覆盖。洗账入口: 三维只有 强制重采样 传非 0, 它无条件重采并换掉这一档的账; 二维没有这一位, 只能 释放 后重建。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    参数 容差 <类型 = 小数>
    参数 序号 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D容差取样参数 (对象指针, 下限, 上限, 容差, 序号))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeLineSeg2d), 用于校验结构内存布局。">
    {
        返回 (ARX几何底层.线段2D结构尺寸 ())
    }

    方法 取分割片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getSplitCurves: 类方法(不需要接收者), 只问把 源曲线 在 分割参数 处切开后 片下标 (0 为首片、1 为末片) 那片的具体类型, 返回 AcGe::EntityId 整数, 用于决定该先创建哪一类对象再调 接收分割片自。" 注释 = "返回码: -1 源曲线未创建或 片下标 不是 0/1, -2 底层抛异常, -3 底层把该片给成空指针, 其余为该片的 AcGe::EntityId。" 注释 = "实测 AcGe25: 线段在区间中点切出的两片都是 kLineSeg2d(22), 与 片下标 无关; 参数正好落在 0 或 1、越出 0..1、或源线段退化成零长时两片都给成空指针, 返回 -3, 而 0.001 与 0.999 这种贴着端点的参数照样切得出 22; 源句柄为 0 或 片下标 不是 0/1 返回 -1。">
    参数 源曲线 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D分割片类型 (源曲线, 分割参数, 片下标))
    }

    方法 接收分割片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getSplitCurves(param, piece1, piece2): 把 源曲线 在 分割参数 处切成的两片中的第 片下标 片写进本对象。源曲线 传 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D/ARX射线2D 任一类的 对象指针。" 注释 = "所有权口径: 底层返回 new 出来的 AcGeCurve2d*, 析构非虚, 该句柄一律不出桥 —— 桥内用 type() 还原具体类, 类型与本对象相符才赋值, 随后在桥内释放两片。" 注释 = "实测 AcGe25: 只有另一个 ARX线段2D 收得下, 交给 ARX直线2D / ARX圆弧2D / ARX椭圆弧2D 一律判假且不碰接收者一位; 收进来的片重新参数化回 0..1 (源 1,2 到 4,6 在 0.5 处的首片是 1,2 到 2.5,4、末片 2.5,4 到 4,6, 各长 2.5), 两片长度之和等于源长; 射线片(26) 本类收不下 (包十九A 起归 ARX射线2D; 实测 源曲线 给 ARX射线2D 时末片正是 26, 交给本类判假); 分割不消耗源曲线, 连切三次源的端点、长度与区间一字不改。">
    参数 源曲线 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D分割片进 (源曲线, 分割参数, 片下标, 对象指针))
    }

    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建或 延伸档 不在 0..2, -2 底层抛异常; 其余是片数。0 片是正常返回不是错误 —— 内偏越过临界量就拿不到片。片数配 取裁剪偏移片类型 与 接收裁剪偏移自 逐个使用, 片的句柄不出桥。" 注释 = "实测 AcGe25: 线段 (1,2)-(4,6) 在 d=+3、-2、+10 都只给 1 片, 片长恒等于源长 5、区间仍是 0..1; 零长线段 (2,3)-(2,3) 同样给 1 片、区间 0..1、长度 0、间隙 0。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片数 (源曲线, 偏移距离, 延伸档))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数, 用来决定该先创建哪一类对象再调 接收裁剪偏移自。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25: 线段偏出的片恒为 kLineSeg2d(22), 与 偏移距离 的正负和大小无关, 零长线段也不例外。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 把 源曲线 偏出的第 片下标 片写进本对象。源曲线 传 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D/ARX射线2D 任一类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve2d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。类型不符、该片为空、指针无效都返回假且本对象一位不动。" 注释 = "实测 AcGe25: 本类是 22 片的唯一接收者 (源曲线 给 ARX射线2D 时偏出的片是 26 型, 本类判假); 线段偏移是纯平移, d=+3 时源方向 (0.6,0.8) 的偏移向量为 (-2.4,1.8), 即左手法向乘 |d|, 片的两端各平移同一向量。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 对象指针))
    }

    方法 是否重叠 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::overlap(line, overlap): 判定本线段与 对方 是否有公共部分。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针, 与本类互不限制。" 注释 = "实测 AcGe25: 只有共线(同一条轴上)的两条直线族对象才判真。端点相接、两线段在内部点垂直相交、相交但不共线的两条无限直线、零长线段落在对方身上、平行偏移这五档一律判假; 判假时底层连片也不写, 所以 是否重叠 判假与 取重叠片类型 给 -3 之间没有第三种情况。" 注释 = "本方法只看几何不看方向: 反向参数化的同一条线照样判真 (实测 段 (0,0)-(10,0) 与 段 (10,0)-(0,0) 判真, 无限直线 (0,0)+方向(1,0) 与 (5,0)+方向(-1,0) 判真)。" 注释 = "实测 AcGe25: 本类与 ARX直线2D 同用这一组接口, 但判定的是几何本身 —— 线段被无限直线穿过时判真, 公共部分就是本线段自己。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D重叠 (对象指针, 对方) == 1)
    }

    方法 取重叠片类型 <公开 类型 = 整数 注释 = "对应 AcGeLinearEnt2d::overlap: 只问本线段与 对方 的重叠片是什么类型。" 注释 = "返回码: -1 本线段未创建或 对方 指针无效, -3 SDK 判无重叠(此时不写片), 其余是片的 AcGe::EntityId。" 注释 = "实测 AcGe25: 本类的重叠片恒为 kLineSeg2d(22), 哪怕 对方 是无限承载直线也一样 —— 片的类型跟着接收者走。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D重叠片型 (对象指针, 对方))
    }

    方法 接收重叠片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::overlap(line, overlap): 把本线段与 对方 的重叠片写回本对象自己, 本线段因此被裁成公共部分。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针, 与本类互不限制。" 注释 = "所有权口径同 接收分割片自: 句柄不出桥, 桥内按 type() 还原后赋值再释放。" 注释 = "实测 AcGe25: 本段 (0,0)-(10,0) 对 段 (2,0)-(4,0) 取回起点 (2,0) 终点 (4,0) 长 2; 对 段 (6,0)-(14,0) 取回 (6,0)-(10,0); 对 段 (11,0)-(14,0) 判假且本段一位不动; 对无限承载直线取回本段自己 (0,0)-(10,0)。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D重叠片收 (对象指针, 对方) == 1)
    }
}

类 ARX圆弧2D <公开 注释 = "封装 ObjectARX AcGeCircArc2d: 二维圆弧(含整圆), 对应 AutoCAD 的 ARC 与整圆 CIRCLE。" 注释 = "本类同时把继承自 AcGeCurve2d/AcGeEntity2d 的通用曲线接口一并暴露出来, 参数类型是 变整数 的方法可以接收 ARX直线2D/ARX线段2D/ARX圆弧2D 的 对象指针。" 注释 = "使用前必须调用 创建 或任一 创建XX, 使用完毕后调用 释放 归还底层对象。" 注释 = "三条最容易踩的实测口径(细节见对应方法注释): 一、曲线参数一律取 取区间下限/取区间上限 的返回值, 不要抄 到文本 的打印值 —— 它只给约 15 位, 整圆上限打印成 6.28318530717959 而真实值是 6.283185307179586, 回传就越界约 4e-15, 此时 取面积 直接给 NaN 而 取参数段长 仍绕回给正确值。二、是否内含点 与 到点距离/取最近点/取切线 都按整圆算不看角域, 只有 是否过点、取圆弧交点、取直线交点 会按弧段截断。三、共线三点走 设过三点 会返回真但把对象改成退化弧, 点在圆上或圆内走 取切线 会返回真却不写结果直线 —— 可行性检查请用 创建过三点错误 与 取切线错误码。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeCircArc2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeCircArc2d(), 创建缺省圆弧; 已存在时先释放旧对象。" 注释 = "实测 AcGe25: 缺省圆弧是圆心 (0,0)、半径 1、参考向量 (1,0) 的整圆, 起始角 0、终止角 2*PI、区间 [0, 2*PI]、周期 2*PI、是否闭合 真、退化类型 -1、是否顺时针 假、取类型编号 10、取结构尺寸 16; 弧起点与弧终点都是有起点与有终点的同一个点 (1,0)。取所在直线 判假。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放圆弧2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建圆弧2D ()
        返回 (对象指针 != 0)
    }

    方法 创建圆 <公开 类型 = 逻辑型 注释 = "对应 new AcGeCircArc2d(cent, radius), 起止角取缺省值即整圆。" 注释 = "实测 AcGe25: 整圆的 取起始角/取终止角 是 0 与 2*PI 而不是两个 0, 弧起点与弧终点都是圆心正右方那个点(圆心 (2,3) 半径 5 得 (7,3)), 全区间 取参数段长 是周长 31.4159265358979、取面积 是 78.5398163397448。" 注释 = "半径给 0 底层不报错, 得到 取退化类型 4、是否闭合 真、区间仍是 0..2*PI 的点圆, 它的 到点距离 与 是否内含点 按整圆口径工作。半径给负值同样不报错: 半径存绝对值, 参考向量被取反成 (-1,0), 于是弧起点落到圆心左侧。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 半径 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放圆弧2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建圆弧2D圆 (圆心X, 圆心Y, 半径)
        返回 (对象指针 != 0)
    }

    方法 创建带角度 <公开 类型 = 逻辑型 注释 = "对应 new AcGeCircArc2d(cent, radius, startAngle, endAngle), 参考向量取 X 轴、逆时针。" 注释 = "实测 AcGe25: 起始角大于终止角时底层既不报错也不交换, 而是把终止角补上一整个周期取那侧大角(起始 3 终止 1 得到 3..7.28318530717959、弧长 21.4159265358979)。两角相等得到 取退化类型 4、是否闭合 假、取周期 NaN、区间 [1,1] 的零角弧, 但它照样 是否有起点 真并且 到点距离 与 是否内含点 仍按整圆算。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 半径 <类型 = 小数>
    参数 起始角 <类型 = 小数>
    参数 终止角 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放圆弧2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建圆弧2D角度 (圆心X, 圆心Y, 半径, 起始角, 终止角, 1.0, 0.0, 假)
        返回 (对象指针 != 0)
    }

