    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeBoundedPlane), 用于校验结构内存布局。" 注释 = "实测 AcGe25: 为 16, 与 ARX平面 相同 —— 边界不占壳内空间, 全在 pImpl 里, 所以 16 字节不能用来判断有没有建立边界。">
    {
        返回 (ARX几何底层.有界平面结构尺寸 ())
    }
}

# ===

类 ARX直线3D <公开 注释 = "封装 ObjectARX AcGeLine3d: 三维无限直线, 由线上一点加方向定义, 对应 AutoCAD 的 3D 构造线与参照线。" 注释 = "判定与求值类方法在 ObjectARX 里按 AcGeLinearEnt3d / AcGeCurve3d 基类引用接收参数, 直线与线段共用同一组接口, 因此这些方法的 对方 参数类型是 变整数, 直接传 ARX直线3D 或 ARX线段3D 的 对象指针 即可, 两者可混用。收平面的那批方法(是否落在平面/是否平行平面/是否垂直平面/取平面交点/取垂面/按平面镜像/取承载平面)参数声明为 ARX平面 对象。" 注释 = "AcGeCurve3d 基类的曲线接口在本类已全部转发: 是否过参数、取周期、取面积、取退化类型, 以及原有的 取参数区间长、参数按长度、反转参数。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeLine3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLine3d(), 创建一条缺省直线; 已存在时先释放旧对象。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放直线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建直线3D ()
        返回 (对象指针 != 0)
    }

    方法 创建过两点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLine3d(pnt1, pnt2), 第一点是参考点。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 甲Z <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    参数 乙Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放直线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建直线3D过两点 (甲X, 甲Y, 甲Z, 乙X, 乙Y, 乙Z)
        返回 (对象指针 != 0)
    }

    方法 创建按方向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLine3d(pnt, vec)。">
    参数 基点X <类型 = 小数>
    参数 基点Y <类型 = 小数>
    参数 基点Z <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放直线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建直线3D方向 (基点X, 基点Y, 基点Z, 方向X, 方向Y, 方向Z)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeLine3d 对象并把 对象指针 归零。线段与直线的底层析构不同, 不要用 ARX线段3D.释放 处理本对象的指针。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放直线3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "本直线是目标, 参数 源 是数据来源且必须已创建。">
    参数 源 <类型 = ARX直线3D>
    {
        返回 (ARX几何底层.直线3D复制 (对象指针, 源.对象指针))
    }

    方法 设置 <公开 类型 = 逻辑型 注释 = "对应 AcGeLine3d::set(pnt, vec), 就地重设直线。">
    参数 基点X <类型 = 小数>
    参数 基点Y <类型 = 小数>
    参数 基点Z <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        返回 (ARX几何底层.直线3D设置 (对象指针, 基点X, 基点Y, 基点Z, 方向X, 方向Y, 方向Z))
    }

    方法 设过两点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLine3d::set(pnt1, pnt2), 就地重设直线。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 甲Z <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    参数 乙Z <类型 = 小数>
    {
        返回 (ARX几何底层.直线3D设过两点 (对象指针, 甲X, 甲Y, 甲Z, 乙X, 乙Y, 乙Z))
    }

    方法 取线上点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::pointOnLine, 把直线自身参考点写入调用方已创建的 结果 点对象。" 注释 = "实测 AcGe25: 与 2D 同口径, 参考点就是构造时给的第一点; 过两点(1,2,3)-(4,6,8) 取到 (1,2,3), 缺省直线取到 (0,0,0)。它不是垂足也不是区间中点。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D线上点 (对象指针, 结果.对象指针))
    }

    方法 取方向 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::direction, 写入调用方已创建的 结果 向量对象。" 注释 = "实测 AcGe25: 永远返回单位向量, 用 (3,4,5) 构造得到 (0.424264068711929,0.565685424949238,0.707106781186547)。但 求值点 与 取参数 用的是底层未归一化的原始方向, 两套口径尺度不同, 不要拿本方法的返回值去换算参数。">
    参数 结果 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.线性3D方向 (对象指针, 结果.对象指针))
    }

    方法 是否平行 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isParallelTo(line), 走 AcGeContext::gTol。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "收平面的同签名重载是另一个方法: 是否平行平面。" 注释 = "实测 AcGe25: 只看方向, 方向放大两倍与方向反向都判真。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D平行 (对象指针, 对方))
    }

    方法 是否垂直 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isPerpendicularTo(line)。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "实测 AcGe25: 只判方向是否正交, 与两直线是否共面无关; X轴(z=0) 与 Y轴(z=1) 这对异面直线判真, 而同这对直线的 取交点 判假。需要真正相交的垂直, 请再断言 取交点。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D垂直 (对象指针, 对方))
    }

    方法 是否共线 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::isColinearTo, 平行且能互相通过才算共线。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D共线 (对象指针, 对方))
    }

    方法 近似等于 <公开 类型 = 逻辑型 注释 = "对应 AcGeEntity3d::isEqualTo(other), 用进程级缺省容差比较两条三维线性实体。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "实测 AcGe25: 与 2D 同口径, 比的是参数化本身(参考点 + 未归一化方向), 不是几何上的同一条无限直线。偏移平行线、方向放大两倍、方向反向、参考点挪到同一根直线上的点全部判假, 只有参数化一致才判真, 因此本方法不等价于 是否共线。" 注释 = "跨类型比较双向都为假: 直线与承载它的线段互相判不等。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D近似相等 (对象指针, 对方))
    }

    方法 取交点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::intersectWith(line, intPnt), 交点写入已创建的 结果 点对象。" 注释 = "实测 AcGe25: 参数声明为基类引用, 直线与线段可混着传; 只在两线共面且有唯一交点时返回真, 平行、共线、异面三种情形都返回假。" 注释 = "与 2D 相反的关键差异: 异面时虽然返回假, 结果 仍会被写成公垂线在对方那一端的点(X轴 与 过(3,0,5)沿Y 的直线给出 (3,0,5)), 平行时才保持调用方原值。因此不能凭返回值判断 结果 是否可信, 复用同一个点对象前必须自己清脏值, 也不要把异面时的 结果 当交点用。">
    参数 对方 <类型 = 变整数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D求交 (对象指针, 对方, 结果.对象指针))
    }

    方法 取投影交点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::projIntersectWith(line, projDir, pntOnThisLine, pntOnOtherLine): 沿 投影方向 把对方投到本直线判是否有交。" 注释 = "这是三维特有的接口, 二维版没有。" 注释 = "实测 AcGe25: 只做判交开关用。X轴(z=0) 与 过(1,-1,1)沿Y 的直线 沿 Z 投影判真; 投影方向与本直线平行(沿 X 投 X轴)判假; 同一条直线自交(共线没有唯一交点)判假。对方是线段时交点还必须落在对方段的端点范围内, 否则判假(见 ARX线段3D.取投影交点)。" 注释 = "重要: 返回真也不写 本方 与 对方点。跨 3 个进程 24 例实测, 出参点全部保持调用方原值(只有一例偶然写出且无法复现), 这两个出参按废弃处理, 要交点请用 取交点 或 取曲线最近点。">
    参数 对方 <类型 = 变整数>
    参数 投影X <类型 = 小数>
    参数 投影Y <类型 = 小数>
    参数 投影Z <类型 = 小数>
    参数 本方 <类型 = ARX点3D>
    参数 对方点 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D投影求交 (对象指针, 对方, 投影X, 投影Y, 投影Z, 本方.对象指针, 对方点.对象指针))
    }

    方法 是否过点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::isOn(pnt), 使用 AcGeContext::gTol。" 注释 = "实测 AcGe25: 无限直线不做区间截断, 参考点(1,2,3) 原始方向(3,4,5) 的直线对 (7,10,13) 与 (31,42,53) 都返回真; 不在直线上的 (1,2,4) 返回假。与 ARX线段3D.是否过点 相反, 线段会做端点截断。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.线性3D过点 (对象指针, 点X, 点Y, 点Z))
    }

    方法 取参数 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::paramOf(pnt), 契约要求点确实落在曲线上, 否则结果无意义。" 注释 = "实测 AcGe25: 与 2D 同口径, t = ((pnt - 参考点) · 原始方向) / (原始方向 · 原始方向), 分母是未归一化方向的长度平方。参考点(1,2,3) 原始方向(3,4,5) 的直线对 (4,6,8) 得 1, 对 (7,10,13) 得 2, 对 (-2,-2,-2) 得 -1; 不落在直线上的点会静默给出垂足参数((1,2,4) 得 5/50 = 0.1), 不会报错。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.线性3D参数 (对象指针, 点X, 点Y, 点Z))
    }

    方法 到点距离 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::distanceTo(pnt); 句柄无效返回 NaN(与 ARX点3D/ARX向量3D 的 -1 约定不同)。" 注释 = "实测 AcGe25: 无限直线按垂距计算, 不受 getInterval 报告的 0..0 退化区间影响。参考点(1,2,3) 原始方向(3,4,5) 的直线到 (1,2,4) 距离 0.707106781186547(垂足 (1.3,2.4,3.5)); X轴到 (5,3,4) 距离 5。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.线性3D点距离 (对象指针, 点X, 点Y, 点Z))
    }

    方法 到曲线距离 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::distanceTo(curve), 两条三维曲线之间的最短距离; 句柄无效返回 NaN。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "这是三维特有的接口: 二维的 AcGeCurve2d 没有 curve-curve distance。" 注释 = "实测 AcGe25: 偏移平行的两条 X轴直线得 2; X轴(z=0) 与 Y轴(z=1) 这对异面直线得公垂线长 1; 共面相交直线得 0。距离不受 是否平行 与 取交点 返回值影响, 是三维下判定两线关系最可靠的一档。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D曲线距离 (对象指针, 对方))
    }

    方法 取最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::closestPointTo(pnt), 曲线上离指点最近的点写入已创建的 结果。" 注释 = "实测 AcGe25: 无限直线落到垂足, 参考点(1,2,3) 原始方向(3,4,5) 的直线对 (1,2,4) 得 (1.3,2.4,3.5); X轴对 (5,3,4) 得 (5,0,0)。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D最近点 (对象指针, 点X, 点Y, 点Z, 结果.对象指针))
    }

    方法 取曲线最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::closestPointTo(curve, pntOnOtherCrv): 本曲线上的最近点写入 本方, 对方曲线上的对应点写入 对方点。" 注释 = "异面直线的公垂线两端点就是这个结果, 与 到曲线距离 配套使用。" 注释 = "实测 AcGe25: X轴(z=0) 与 过(3,0,5)沿Y 的直线判真, 本方 (3,0,0) 对方 (3,0,5), 与 取交点 判假时写进 结果 的那个点正好是对方端。">
    参数 对方 <类型 = 变整数>
    参数 本方 <类型 = ARX点3D>
    参数 对方点 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D曲线最近点 (对象指针, 对方, 本方.对象指针, 对方点.对象指针))
    }

    方法 取投影最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::projClosestPointTo(pnt, projectDirection): 沿指定投影方向离指点最近的本曲线点, 写入已创建的 结果。" 注释 = "实测 AcGe25: X轴对 (5,3,4) 沿 Z 投影得 (5,0,0); 投影方向与本直线平行(沿 X 投)时退化, 返回真但落到参考点 (0,0,0), 调用方需自行排除平行方向。" 注释 = "实测 AcGe25: 直线侧也只有精确平行才走退化, 近似平行不退化而是把数算飞 —— X轴 (0,0,0)+(1,0,0) 对 (5,3,4): 方向 (1,0.1,0) 给 (-25,0,0)、(1,0.001,0) 给 (-2995,0,0)、(1,1e-10,0) 给 (-29999999995,0,0), 全程返回真、落到 5 减 3 除以方向Y分量 的外推点上, 夹角越小越离谱, 既不报错也不退回参考点。因此排除平行方向必须由调用方自己按容差判, 不能指望底层兜底; 只有与 取方向 逐位相同的精确平行才给 (0,0,0)。沿 (0,1,0) 与 (0,0,1) 这类真正相交的方向才给正常垂足 (5,0,0)。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    参数 投影X <类型 = 小数>
    参数 投影Y <类型 = 小数>
    参数 投影Z <类型 = 小数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D投影最近点 (对象指针, 点X, 点Y, 点Z, 投影X, 投影Y, 投影Z, 结果.对象指针))
    }

    方法 求值点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::evalPoint(param), 按参数取点写入已创建的 结果。" 注释 = "实测 AcGe25: 与 2D 同口径, 取 参考点 + 曲线参数 * 未归一化原始方向。参考点(1,2,3) 原始方向(3,4,5) 的直线 求值点(1) 得 (4,6,8), 求值点(5) 得 (16,22,28), 求值点(-1) 得 (-2,-2,-2); 参数可取任意正负值, 与区间无关。">
    参数 曲线参数 <类型 = 小数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.线性3D求值点 (对象指针, 曲线参数, 结果.对象指针))
    }

    方法 取参数区间长 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::length(fromParam, toParam), 返回两参数之间的曲线长度; 句柄无效返回 NaN。" 注释 = "本方法位于 AcGeCurve3d 基类, 直线与线段都能调用, 不像 取长度 那样只属于线段。" 注释 = "实测 AcGe25: 返回真实弧长。原始方向(3,4,5) 的直线 取参数区间长(0,1) 得 7.07106781186548 = |原始方向|, (1,3) 得 14.142135623731, 反向 (0,-1) 同样得正值。">
    参数 起始参数 <类型 = 小数>
    参数 结束参数 <类型 = 小数>
    {
        返回 (ARX几何底层.线性3D区间长度 (对象指针, 起始参数, 结束参数))
    }

    方法 参数按长度 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::paramAtLength(datumParam, length), 从基准参数出发沿正向走指定长度后的参数; 句柄无效返回 NaN。" 注释 = "实测 AcGe25: 长度按真实弧长计, 结果 = 基准参数 + 长度 / |原始方向|。原始方向(3,4,5) 的直线 参数按长度(0, 7.0710678118654755) 得 1, 参数按长度(0,1) 得 0.14142135623731, 长度取负得负参数; 与 取参数区间长 互为逆运算。">
    参数 基准参数 <类型 = 小数>
    参数 长度 <类型 = 小数>
    {
        返回 (ARX几何底层.线性3D参数按长度 (对象指针, 基准参数, 长度))
    }

    方法 按矩阵变换 <公开 类型 = 逻辑型 注释 = "对应 AcGeEntity3d::transformBy(mat), 就地变换; 矩阵未创建时返回假。">
