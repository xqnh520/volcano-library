    }

    方法 求值点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::evalPoint(param)。">
    参数 曲线参数 <类型 = 小数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.曲线3D求值点 (对象指针, 曲线参数, 结果.对象指针))
    }

    方法 到点距离 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::distanceTo(pnt)。" 注释 = "实测 AcGe25: 弧段截断时给的是驻点距离而不是全局最近距离, 半椭圆对 (1,-28,3) 给 33。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D点距离 (对象指针, 点X, 点Y, 点Z))
    }

    方法 到曲线距离 <公开 类型 = 小数 注释 = "对应 AcGeCurve3d::distanceTo(curve)。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.曲线3D曲线距离 (对象指针, 对方))
    }

    方法 取最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::closestPointTo(pnt)。" 注释 = "实测 AcGe25: 与 到点距离 同一口径, 弧段外的点落到弧的端点上。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
