    方法 接收重叠片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::overlap(line, overlap): 把本射线与 对方 的重叠片写回本对象自己。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针, 与本类互不限制。" 注释 = "所有权口径同 接收分割片自: 片是底层 new 出来的 AcGeLinearEnt2d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放该片。" 注释 = "SDK 判假、片为空、类型不符、指针无效都返回假, 且本对象一位不动。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D重叠片收 (对象指针, 对方) == 1)
    }
}

# ===

类 ARX射线3D <公开 注释 = "封装 ObjectARX AcGeRay3d: 三维射线(半直线), 由一个端点加一个方向定义, 只沿方向那一侧无限延伸, 反向到头就是端点本身。" 注释 = "AcGeRay3d 在 SDK 里只自带四个构造函数、两个 set 与一个赋值运算符, 其余接口全部继承自 AcGeLinearEnt3d / AcGeCurve3d / AcGeEntity3d, 因此本类与 ARX直线3D 走的是同一批底层入口, 只是句柄换成本类的射线对象。" 注释 = "判定类方法(是否平行/是否垂直/是否共线/取交点/近似等于)在 ObjectARX 里按 AcGeLinearEnt3d 基类引用接收参数, 直线、线段与射线共用同一组接口, 所以这些方法的 对方 参数类型是 变整数, 三类句柄可混用。" 注释 = "AcGeCurve3d 基类的曲线接口在本类已全部转发: 是否过参数、取周期、取参数区间长、参数按长度、取面积、到曲线距离、取曲线最近点、反转参数、取退化类型。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeRay3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeRay3d(); 已存在时先释放旧对象。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放射线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建射线3D ()
        返回 (对象指针 != 0)
    }

    方法 创建过两点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeRay3d(pnt1, pnt2): 端点取 甲, 方向取 甲 指向 乙。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 甲Z <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    参数 乙Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放射线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建射线3D过两点 (甲X, 甲Y, 甲Z, 乙X, 乙Y, 乙Z)
        返回 (对象指针 != 0)
    }

    方法 创建按方向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeRay3d(pnt, vec)。">
    参数 基点X <类型 = 小数>
    参数 基点Y <类型 = 小数>
    参数 基点Z <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放射线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建射线3D方向 (基点X, 基点Y, 基点Z, 方向X, 方向Y, 方向Z)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeRay3d 对象并把 对象指针 归零。直线、线段与射线的底层析构各不相同, 不要用 ARX直线3D.释放 处理本对象的指针。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放射线3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "对应 AcGeRay3d::operator=。本射线是目标, 参数 源 是数据来源且必须已创建。">
