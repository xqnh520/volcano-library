    {
        返回 (ARX几何底层.点上曲线2D接收最近对 (对象指针, 对方.对象指针, 本侧曲线, 对方曲线))
    }

    方法 接收法向点自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getNormalPoint(point, poc): 方向同 接收最近点自 —— 曲线是入参, 本对象是被写的那一个; 源曲线 口径同 创建过曲线。本批三条入口一律不带容差形参, 走缺省 gTol。" 注释 = "搜索种子 = 本对象已存的参数, 形参里没有种子位; 要换分支先 创建过曲线参数 预置。实测 圆2 求 (1,2): 种子 0 / 1.2 / 6.28318530717959 / 1000000000 都回 1.10714871779409, 种子 3.14159265358979 或 -1 回对侧的 4.24874137138388; 椭2 求 (1,2) 同口径 —— 1.23974359755826 对 3.6372401808631。" 注释 = "实测各叶曲线求 (3,4): 线2 = 过(0,0)(1,0) → 参数 3; 段2 = (1,2)-(4,6) → 0.56、点 (2.68,4.24); 圆2 与 弧2 → 0.927295218001612、点 (3,4); 椭2 → 0.927295218001616、点 (1.79999999999999,1.6); 零段2 → 参数 0、点 (2,3); 微圆2 → 0.927295218001612、点 (0.0006,0.0008)。" 注释 = "答假档实测只有一类 —— 圆心: 圆2 求 (0,0) 与 微圆2 求 (0,0) 都假, 而 椭2 的中心 (0,0) 回真、参数 0。答假时本对象一字不改: 预置 圆2 在参数 3.0 后拿圆心求, 参数仍 3.0、点仍 (-4.94996248300223,0.705600040299336); 微圆2 同理仍回 微圆2 在参数 3.0 = (-0.000989992496600446,0.000141120008059867)。" 注释 = "垂足落在弧域外也回真, 给的是对侧而不是端点: 弧2 求 (-4,-4) → 0.785398163397448、点 (3.53553390593274,3.53553390593274)。本方法不动别名, 与 接收最近点自 那一族不同(见类注释)。">
    参数 源曲线 <类型 = 变整数>
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线2D接收法向 (对象指针, 源曲线, 点X, 点Y))
    }

    方法 接收局部最近点自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getLocalClosestPoints(point, poc, nbhd): 局部求解器, 曲线是入参、本对象被改写。SDK 这一档没有返回值, 所以回真只表示调用走通, 不表示有解、更不表示是全局最小 —— 全局那一档是 接收最近点自。" 注释 = "邻域档 = 整数旗标: 0 = 不给区间, 1 = 用 (邻域下限,邻域上限) 由桥内现造一个 AcGeInterval 传进去; 其余值桥内直接拒, 回假且不动本对象。AcGeInterval 不另封类, 所以形参就是两个 小数。" 注释 = "实测解的落点只有三种 —— 区间内的真解、下限、上限。圆2 求 (1,2)(真垂足 1.10714871779409): [-7.0,1.2] 与 [-7.0,2.0] → 真解; [-7.0,1.0] 与 [1.0,100.0] → 1.0; [1.2,7.0] → 1.2; [-1.0,7.0] 与 [0.0,7.0] 与 [-100.0,7.0] 与 [-7.0,7.0] → 7.0; [0.0,6.28318530717959] 与 [-7.0,6.28318530717959] → 6.28318530717959。" 注释 = "区间端点不归一到曲线域: 圆2 的 [-100.0,0.0] 把 -100.0 原样写进参数。上下限写反的 [4.0,1.0] 行为与 [1.0,4.0] 相同(照样给真解); [0.0,0.0] → 0。段2 求 (0,5): [-100.0,100.0] → 0.360000000000009、[3.0,20.0] → 3.0; 线2 求 (3,4): [1.0,2.0] → 2.0、[10.0,12.0] → 10.0、[-7.0,7.0] 与 [2.0,4.0] → 3.0、[-100.0,100.0] → 3.00000000000001。" 注释 = "不给区间时周期曲线与直线会退化到起点: 无区间档下 线2 求 (3,4)、圆2 与 椭2 与 微圆2 求 (1,2) 全回参数 0(同点给宽区间 [-7.0,7.0] 分别回 3 / 7 / 7 / 7); 非周期的 段2、弧2 无区间时直接给真解 0.36、0.785398163397448; 零段2 无区间 → 参数 1。">
    参数 源曲线 <类型 = 变整数>
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 邻域档 <类型 = 整数>
    参数 邻域下限 <类型 = 小数>
    参数 邻域上限 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线2D接收局部最近 (对象指针, 源曲线, 点X, 点Y, 邻域档, 邻域下限, 邻域上限))
    }

    方法 接收局部曲线间最近点自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getLocalClosestPoints(crvB, pocA, pocB, nbhd1, nbhd2): 两条曲线之间的局部最近点, 两个接收者都被改写; 对方 与两条曲线 都必须已创建。SDK 无返回值, 回真只表示调用走通。" 注释 = "邻域档 是位旗标: 位0 = 本侧区间 (本侧下限,本侧上限) 生效, 位1 = 对方区间 (对方下限,对方上限) 生效, 0 = 两侧都不给, 3 = 两侧都给; 0..3 之外桥内直接拒。" 注释 = "实测 段2 x 椭2: 两侧都不给 → 甲 0、乙 0; 只给本侧 [0.2,0.4] → 甲 0.2、乙 0; 只给对方 [3.0,3.5] → 甲 0、乙 3.0; 两侧都给 → 甲 0.2、乙 3.0。圆2 x 椭2 同四档: 0 与 0、0.2 与 0、0 与 3.14159265358979、0.2 与 3.14144416999841。两条平行线 [0.2,0.4] x [3.0,3.5]: 只给本侧 → 甲 0.2 乙 0、只给对方 → 甲 0 乙 3、两侧都给 → 甲 0.4 乙 3。" 注释 = "两侧各自的已存参数就是两侧各自的种子, 会换解: 段2 x 椭2 把 乙 预置成 3.0 得 2.69353094889216、预置成 0 得 0; 同一对曲线换 甲 的种子 0 / 1.0 / 3.0 时 乙 分别为 0 / 1.25677764534175 / 0。圆2 与它自己求 → 两侧都 参数 0、点 (5,0)。" 注释 = "本方法不动两侧别名; 别名 不是 被解曲线 时连解都不自洽(见类注释), 所以调用方要保证 poc 绑的就是传进来的那两条曲线。">
    参数 对方 <类型 = ARX点上曲线2D>
    参数 本侧曲线 <类型 = 变整数>
    参数 对方曲线 <类型 = 变整数>
    参数 邻域档 <类型 = 整数>
    参数 本侧下限 <类型 = 小数>
    参数 本侧上限 <类型 = 小数>
    参数 对方下限 <类型 = 小数>
    参数 对方上限 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线2D接收局部最近对 (对象指针, 对方.对象指针, 本侧曲线, 对方曲线, 邻域档, 本侧下限, 本侧上限, 对方下限, 对方上限))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回 sizeof(AcGePointOnCurve2d), 用于核对内存布局。" 注释 = "实测 AcGe25: 为 16, 与 ARX平面 / ARX包围块2D 同宽 —— 曲线别名与参数就占这么宽, 别按它判断对象里绑了几条曲线。">
    {
        返回 (ARX几何底层.点上曲线2D结构尺寸 ())
    }
}

# ===

类 ARX点上曲线3D <公开 注释 = "封装 ObjectARX AcGePointOnCurve3d: 空间曲线上一个点的位置, 由 (所绑曲线, 参数) 二元组表达, 是 AcGeCurve3d::getClosestPointTo 与 getProjClosestPointTo 的出参类型。" 注释 = "比二维兄弟类 ARX点上曲线2D 多两条投影入口(接收斜投影最近点自 / 接收斜投影曲线间最近点自) —— AcGeCurve2d 侧根本没有 getProjClosestPointTo 这一族; 其余方法一一对应, 出参换成 ARX点3D / ARX向量3D。" 注释 = "使用前必须调用 创建(或 创建过曲线 / 创建过曲线参数 / 接收最近点自 之一), 使用完毕后调用 释放 归还底层对象。" 注释 = "所有权: 本类只借曲线不持有 —— 底层存的是 const AcGeCurve3d&, 所绑曲线必须先于本对象释放, 否则 curve() 就是悬垂指针, 底层不拦也不崩, 后果自负。" 注释 = "实测 AcGe25 口径: (1) 缺省构造不是空对象, curve() 指向一条 AcGeLine3d(类型编号 19), 且三维侧每个缺省对象各绑一条(与二维侧共用同一条不同), parameter() 读 0; 是否有效 只看自己的句柄。 (2) 参数不夹取。 (3) 接收…自 一族改写本对象。 (4) 拷贝赋值是浅的, 参数、点、别名一起搬; 取类型编号 恒 7。 (5) 本类的 取曲率 与 是否奇点 走真 SDK 导出, 二维那两档是桥内算的。" 注释 = "(6) 带参档写回本对象这一条与二维完全同口径 —— 设成 2.5 后调 取导数在参数(0.4)、取点在参数(0.9)、取曲率在参数(1.4) 回读分别成 0.4、0.9、1.4, 而无参 取曲率 与 设曲线 都保持 2.5。" 注释 = "(7) 包十五B 三条入口 接收法向点自 / 接收局部最近点自 / 接收局部曲线间最近点自 与 接收…自 一族不同: 它们不动别名, 解完之后只有 参数 被改写, 别名不一致时 取点 的来源也不自洽。三维实测与二维同口径 —— 甲绑圆3、拿段3 求 (3,4,5): 法向点档写进段3 的解 0.48, 点是 被解曲线 上的 (2.44,3.92,5.4) 而 是否同一曲线(圆3) 仍真、(段3) 假; 点档写的是 别名 圆3 自己的解 0.927295218001612 配点 (3,4,0); 曲线对档两侧别名都不动、写进 甲 1 与 乙 0, 两点各按别名解成 圆3@1 = (2.7015115293407,4.20735492403948,0) 与 椭3@0 = (3,0,0)。要把点和别名对齐, 得再调一次 设参数 (0.48 → 点回到 (4.43497461389642,2.30889587770741,0)) 或 设曲线(段3) (点回到 (2.44,3.92,5.4)、参数仍 0.48)。" 注释 = "(8) 这三条解完之后 取曲率 不可信 —— 派生缓存没跟着参数刷新, 而且三维侧比二维更彻底: 法向点档解完 取曲率 直接回 NAN(二维回的是错数 0.12), 把同一个参数再 设参数 一遍才回 圆3 的 0.2, 补 设曲线(段3) 后回 0。断言只用 取参数 / 是否同一曲线, 别名与被解曲线一致时才用 取点, 一律不用 取曲率。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGePointOnCurve3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnCurve3d(), 缺省构造。已存在时先释放旧对象。" 注释 = "实测: 缺省构造也绑着一条曲线 —— 类型编号 19 的 AcGeLine3d, 且每个缺省对象各绑一条; 参数 0、取点 (0,0,0)、isSingular 假。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲线3D ()
        返回 (对象指针 != 0)
    }

    方法 创建过曲线 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnCurve3d(crv), 源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D/ARX射线3D 任一类的 对象指针。已存在时先释放旧对象。" 注释 = "实测与二维同口径: 圆3 上参数落 0、别名换成它, 取曲率 = 0.2、是否奇点 假、取类型编号 = 7; 源曲线 给 ARX射线3D 同样判真、参数落 0、取类型编号 = 7。">
    参数 源曲线 <类型 = 变整数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲线3D过曲线 (源曲线)
        返回 (对象指针 != 0)
    }

    方法 创建过曲线参数 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnCurve3d(crv, param), 源曲线 口径同 创建过曲线。已存在时先释放旧对象。" 注释 = "实测: 种子原样存不夹取, 与二维侧同口径 —— 椭3 上给 0.7 得 |deriv(1)| = 2.46476817221202、点 (2.29452656185347,1.28843537447538,0), 与二维读数逐位相同。">
    参数 源曲线 <类型 = 变整数>
    参数 参数值 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲线3D过参数 (源曲线, 参数值)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGePointOnCurve3d 对象并把 对象指针 归零。所绑曲线是借来的, 本方法不碰它, 由调用方自己释放。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。" 注释 = "只看句柄: 底层 curve() 恒不为空(缺省对象也各有一条曲线), 别拿曲线在不在当判空依据。">
    {
        返回 (对象指针 != 0)
    }

