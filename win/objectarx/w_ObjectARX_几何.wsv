    {
        返回 (ARX几何底层.矩阵设单位 (对象指针))
    }

    方法 设为平移 <公开 类型 = 逻辑型 注释 = "对应 setToTranslation, 把矩阵重置为纯平移。">
    参数 位移X <类型 = 小数>
    参数 位移Y <类型 = 小数>
    参数 位移Z <类型 = 小数>
    {
        返回 (ARX几何底层.矩阵设平移 (对象指针, 位移X, 位移Y, 位移Z))
    }

    方法 取平移 <公开 类型 = 逻辑型 注释 = "读取 本矩阵 的平移分量, 写入参数对象; 参数对象必须已创建。">
    参数 结果 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.矩阵取平移 (对象指针, 结果.对象指针))
    }

    方法 设为旋转 <公开 类型 = 逻辑型 注释 = "对应 setToRotation(angle, axis, wrtPoint), 角度使用弧度, 缺省绕 Z 轴过原点旋转。" 注释 = "旋转轴为零向量时直接返回假, 不进入底层。">
    参数 弧度 <类型 = 小数>
    参数 轴X <类型 = 小数 @默认值 = 0.0>
    参数 轴Y <类型 = 小数 @默认值 = 0.0>
    参数 轴Z <类型 = 小数 @默认值 = 1.0>
    参数 中心X <类型 = 小数 @默认值 = 0.0>
    参数 中心Y <类型 = 小数 @默认值 = 0.0>
    参数 中心Z <类型 = 小数 @默认值 = 0.0>
    {
        如果 (轴X * 轴X + 轴Y * 轴Y + 轴Z * 轴Z <= 0)
        {
            返回 (假)
        }
        返回 (ARX几何底层.矩阵设旋转 (对象指针, 弧度, 轴X, 轴Y, 轴Z, 中心X, 中心Y, 中心Z))
    }

    方法 设为缩放 <公开 类型 = 逻辑型 注释 = "对应 setToScaling(scaleAll, center), 均匀缩放。">
    参数 比例 <类型 = 小数>
    参数 中心X <类型 = 小数 @默认值 = 0.0>
    参数 中心Y <类型 = 小数 @默认值 = 0.0>
    参数 中心Z <类型 = 小数 @默认值 = 0.0>
    {
        返回 (ARX几何底层.矩阵设缩放 (对象指针, 比例, 中心X, 中心Y, 中心Z))
    }

    方法 设为镜像 <公开 类型 = 逻辑型 注释 = "对应 setToMirroring(AcGePoint3d), 关于指定点中心对称。">
    参数 镜X <类型 = 小数 @默认值 = 0.0>
    参数 镜Y <类型 = 小数 @默认值 = 0.0>
    参数 镜Z <类型 = 小数 @默认值 = 0.0>
    {
        返回 (ARX几何底层.矩阵设镜像 (对象指针, 镜X, 镜Y, 镜Z))
    }

    方法 设为平面镜像 <公开 类型 = 逻辑型 注释 = "对应 setToMirroring(AcGePlane), 生成关于一个平面的反射矩阵。平面必须已创建。" 注释 = "与 设为镜像(关于点) 是两个不同的重载, 点镜像在三维里是中心对称。" 注释 = "实测 AcGe25: 生成 I-2*n*nT 配上平移 -2*d*n(n 为单位法向, d 为平面常数项), 行列式恒为 -1; 是否奇异 假, 是否正交缩放 与 是否均匀正交缩放 都为真; 连用两次回到原处, 面上的点保持不变。">
    参数 平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.矩阵设平面镜像 (对象指针, 平面.对象指针))
    }

    方法 设为平面投影 <公开 类型 = 逻辑型 注释 = "对应 setToProjection(projectionPlane, projectDir), 沿 方向X/Y/Z 斜投影到平面上。" 注释 = "实测 AcGe25: 正常投影得到行列式为 0 的降维矩阵(水平面沿 +Z 得 diag(1,1,0); 沿 (1,0,-1) 斜投到 z=0 时 x 分量变成 x+z, 点 (0,0,5) 落到 (5,0,0))。" 注释 = "投影方向与平面平行(投不上去)时底层不报错, 而是写进一个全是 NaN/Inf 的矩阵, 且 是否奇异 对这种矩阵返回假。本方法进底层前先算 方向 点积 法向, 为零或方向为零向量时返回假并保留矩阵原内容。">
    参数 平面 <类型 = ARX平面>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        返回 (ARX几何底层.矩阵设平面投影 (对象指针, 平面.对象指针, 方向X, 方向Y, 方向Z))
    }

    方法 设为世界到平面 <公开 类型 = 逻辑型 注释 = "对应 setToWorldToPlane(plane), 把世界坐标变换到以该平面为 XY 面的局部坐标系。" 注释 = "实测 AcGe25: 与 设为平面到世界 互为逆矩阵(两个次序相乘都得到单位阵), 行列式 1、是否均匀正交缩放 真; 平面原点送到局部原点, 法向落到局部 +Z, 而 U/V 谁映射到 X、谁映射到 Y 由底层决定(样本里 U 落到局部 Y、V 落到局部 -X), 不要写死, 需要时用 取坐标系 反算。缺省平面得到单位阵。">
    参数 平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.矩阵设世界到平面 (对象指针, 平面.对象指针))
    }

    方法 设为平面到世界 <公开 类型 = 逻辑型 注释 = "对应 setToPlaneToWorld(plane), 把平面局部坐标变换回世界坐标。" 注释 = "实测 AcGe25: 与 设为世界到平面 互为逆矩阵, 相乘两个次序都回到单位阵; 它是把平面的 U/V/法向铺回世界坐标的那一侧。">
    参数 平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.矩阵设平面到世界 (对象指针, 平面.对象指针))
    }

    方法 转为局部坐标系 <公开 类型 = 逻辑型 注释 = "对应 convertToLocal(normal, elev) 的返回值与两个引用参数: 局部二维矩阵写入 结果矩阵; 法向 是就地读写的双向参数 —— 它当前的三个分量作为入参送进底层, 调用成功后底层改写过的法向再写回本对象。本矩阵保持不变。" 注释 = "实测 AcGe25: 法向 就地单位化后写回本对象 (给 (0,0,5) 调用后读到 (0,0,1)); 结果矩阵取本矩阵落在面内的部分, 平移分量按轴搬进对应列; 法向长度不为 1 时二维矩阵的一行整体按 |法向| 放大 (单位阵配 (0,0,5) 第二行变 0,5,0)。本矩阵保持不变。">
    参数 结果矩阵 <类型 = ARX矩阵2D>
    参数 法向 <类型 = ARX向量3D>
    {
        如果 (法向.是否零向量 ())
        {
            返回 (假)
        }
        返回 (ARX几何底层.矩阵转局部坐标系 (对象指针, 法向.分量X, 法向.分量Y, 法向.分量Z, 0.0, 结果矩阵.对象指针, 法向.对象指针))
    }

    方法 取局部高度 <公开 类型 = 小数 注释 = "对应 convertToLocal 的 elev 就地结果: 法向 的三个分量与 高度初值 一起送进底层, 返回底层改写后的值; 矩阵或 法向 未创建返回 NaN。" 注释 = "与 转为局部坐标系 各跑一次底层调用, 两个读数分开取就是两遍, 与 ARX平面 那侧的包络六个读数同一口径。" 注释 = "实测 AcGe25: 高度 = 高度初值 * 本矩阵 Z 轴长度 + 平移列在单位法向上的投影 —— 缩放2 右乘 平移(0,0,5) 后平移列已是 (0,0,10), 初值 0 读 10、初值 777 读 1564 = 777*2+10; 法向长度不进这个公式; 法向为零向量时结果抹成 0, 连初值也回不来。陷阱: 先调 转为局部坐标系 会把 法向 就地单位化, 之后本方法看到的已是单位法向。">
    参数 法向 <类型 = ARX向量3D>
    参数 高度初值 <类型 = 小数 @默认值 = 0.0>
    {
        返回 (ARX几何底层.矩阵局部高度 (对象指针, 法向.分量X, 法向.分量Y, 法向.分量Z, 高度初值))
    }

    方法 设为乘积 <公开 类型 = 逻辑型 注释 = "对应 setToProduct(mat1, mat2), 本矩阵 = 左 * 右。">
    参数 左 <类型 = ARX矩阵3D>
    参数 右 <类型 = ARX矩阵3D>
    {
        返回 (ARX几何底层.矩阵设乘积 (对象指针, 左.对象指针, 右.对象指针))
    }

    方法 右乘 <公开 类型 = 逻辑型 注释 = "对应 postMultBy, 本矩阵 = 本矩阵 * 矩阵。">
    参数 矩阵 <类型 = ARX矩阵3D>
    {
        返回 (ARX几何底层.矩阵右乘 (对象指针, 矩阵.对象指针))
    }

    方法 左乘 <公开 类型 = 逻辑型 注释 = "对应 preMultBy, 本矩阵 = 矩阵 * 本矩阵。">
    参数 矩阵 <类型 = ARX矩阵3D>
    {
        返回 (ARX几何底层.矩阵左乘 (对象指针, 矩阵.对象指针))
    }

    方法 求逆 <公开 类型 = 逻辑型 注释 = "就地求逆。先用 isSingular 判定, 奇异时返回假且矩阵内容不变。">
    {
        返回 (ARX几何底层.矩阵求逆 (对象指针))
    }

    方法 取逆 <公开 类型 = 逻辑型 注释 = "求 本矩阵 的逆并写入参数对象; 参数对象必须已创建。本矩阵奇异或参数未创建时返回假。">
    参数 结果 <类型 = ARX矩阵3D>
