# ===

类 ARX射线2D <公开 注释 = "封装 ObjectARX AcGeRay2d: 二维射线(半直线), 由一个端点加一个方向定义, 只沿方向那一侧无限延伸, 反向到头就是端点本身。" 注释 = "AcGeRay2d 在 SDK 里只自带四个构造函数、两个 set 与一个赋值运算符, 其余接口全部继承自 AcGeLinearEnt2d / AcGeCurve2d / AcGeEntity2d, 因此本类与 ARX直线2D 走的是同一批底层入口, 只是句柄换成本类的射线对象。" 注释 = "判定类方法(是否平行/是否垂直/是否共线/取交点/近似等于)在 ObjectARX 里按 AcGeLinearEnt2d 基类引用接收参数, 直线、线段与射线共用同一组接口, 所以这些方法的 对方 参数类型是 变整数, 三类句柄可混用。" 注释 = "AcGeCurve2d 基类的曲线接口在本类已全部转发: 是否过参数、取周期、取参数段长、参数按长度、取面积、到曲线距离、取曲线最近点、反转参数、取退化类型。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeRay2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeRay2d(); 已存在时先释放旧对象。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放射线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建射线2D ()
        返回 (对象指针 != 0)
    }

    方法 创建过两点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeRay2d(pnt1, pnt2): 端点取 甲, 方向取 甲 指向 乙。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放射线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建射线2D过两点 (甲X, 甲Y, 乙X, 乙Y)
        返回 (对象指针 != 0)
    }

    方法 创建按方向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeRay2d(pnt, vec)。">
    参数 基点X <类型 = 小数>
    参数 基点Y <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    {
