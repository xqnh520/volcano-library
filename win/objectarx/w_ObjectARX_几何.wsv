    }

    方法 转为向量 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::asVector, 把 (x, y) 写入调用方已创建的 结果 向量对象。">
    参数 结果 <类型 = ARX向量2D>
    {
        返回 (ARX几何底层.点2D转为向量 (对象指针, 结果.对象指针))
    }

    方法 设为点加向量 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::setToSum(pnt, vec), 本对象为输出, 两个参数为输入且都必须已创建。">
    参数 起点 <类型 = ARX点2D>
    参数 向量 <类型 = ARX向量2D>
    {
        返回 (ARX几何底层.点2D设和 (对象指针, 起点.对象指针, 向量.对象指针))
    }

    方法 缩放 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::scaleBy(scale, wrtPoint), 中心缺省为原点。">
    参数 比例 <类型 = 小数>
    参数 中心X <类型 = 小数 @默认值 = 0.0>
    参数 中心Y <类型 = 小数 @默认值 = 0.0>
    {
        返回 (ARX几何底层.点2D缩放 (对象指针, 比例, 中心X, 中心Y))
    }

    方法 绕点旋转 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::rotateBy(angle, wrtPoint), 角度使用弧度, 旋转中心缺省为原点。">
    参数 弧度 <类型 = 小数>
    参数 中心X <类型 = 小数 @默认值 = 0.0>
    参数 中心Y <类型 = 小数 @默认值 = 0.0>
    {
        返回 (ARX几何底层.点2D旋转 (对象指针, 弧度, 中心X, 中心Y))
    }

    方法 按矩阵变换 <公开 类型 = 逻辑型 注释 = "对应 AcGePoint2d::transformBy(mat), 就地变换, 含平移分量。矩阵未创建时返回假。">
    参数 矩阵 <类型 = ARX矩阵2D>
    {
        返回 (ARX几何底层.点2D按矩阵变换 (对象指针, 矩阵.对象指针))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGePoint2d), 用于校验结构内存布局。">
    {
        返回 (ARX几何底层.点2D结构尺寸 ())
    }
}

