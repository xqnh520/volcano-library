    方法 接收法向点自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getNormalPoint(point, poc): 方向同 接收最近点自 —— 曲线是入参, 本对象是被写的那一个; 源曲线 口径同 创建过曲线。不带容差形参, 走缺省 gTol。" 注释 = "三维侧的答假档比二维宽: 凡是点不在曲线平面内就假。实测 圆3 = 圆心(0,0,0) 法向(0,0,1) 半径 5 与 弧3、微圆3 求 (3,4,5) 全假, 圆心 (0,0,0) 与轴上点 (0,0,7) 也假, 而面内的 (5,0,0) 真; 线3、段3、零段3、椭3 求 (3,4,5) 都真。" 注释 = "实测各叶曲线求 (3,4,5) 的真解: 线3 = 过(0,0,0)(1,0,0) → 参数 3、点 (3,0,0); 段3 = (1,2,3)-(4,6,8) → 0.48、点 (2.44,3.92,5.4); 椭3 = 圆心(0,0,0) 长 3 短 2 → 0.927295218001616、点 (1.79999999999999,1.6,0); 零段3 → 参数 0、点 (2,3,4)。椭3 的中心 (0,0,0) 回真、参数 0; 弧3 的域外垂足同样回真给对侧 0.785398163397448。" 注释 = "答假时本对象一字不改, 与二维同口径: 圆3 的种子 1.2 与 3.14159265358979 两档答假后参数仍分别是 1.2、3.14159265358979。种子选支也照旧: 椭3 求 (1,2,3) 时 种子 0 与 0.7 → 1.23974359755826, 种子 3.14159265358979 与 -1 → 3.6372401808631。">
    参数 源曲线 <类型 = 变整数>
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线3D接收法向 (对象指针, 源曲线, 点X, 点Y, 点Z))
    }

    方法 接收局部最近点自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getLocalClosestPoints(point, poc, nbhd): 局部求解器, 曲线是入参、本对象被改写。SDK 这一档没有返回值, 所以回真只表示调用走通, 不表示有解、更不表示是全局最小。" 注释 = "邻域档 = 整数旗标: 0 = 不给区间, 1 = 用 (邻域下限,邻域上限) 由桥内现造一个 AcGeInterval 传进去; 其余值桥内直接拒, 回假且不动本对象。" 注释 = "落界规则与二维一致 —— 解只有三种: 区间内的真解、下限、上限, 端点不归一到曲线域, 上下限写反按写正处理。实测 线3 求 (3,4,5): [1.0,2.0] → 2.0、[3.0,4.5] → 3.0、[-7.0,7.0] → 3.0、[10.0,12.0] → 10.0、[4.0,1.0] → 3.0; 段3 求 (0,5,9): [1.0,2.0] → 1.0、[3.0,4.5] → 3.0、[-7.0,7.0] → 0.78、[10.0,12.0] → 10.0; 圆3 求 (1,2,3): [1.0,2.0] → 1.10714871779409、[3.0,4.5] → 3.0、[-7.0,7.0] → 7.0、[10.0,12.0] → 12.0、[4.0,1.0] → 1.10714871779409; 椭3 求 (1,2,0): [1.0,2.0] → 1.23974359755826、[3.0,4.5] → 4.5、[-7.0,7.0] → 7.0、[10.0,12.0] → 12.0。" 注释 = "无区间档同样退化: 线3 求 (3,4,5) 无区间 → 参数 0(宽区间给 3); 段3 与 弧3 无区间直接给真解 0.78、0.785398163397448; 圆3 与 椭3 无区间 → 参数 0。">
    参数 源曲线 <类型 = 变整数>
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    参数 邻域档 <类型 = 整数>
    参数 邻域下限 <类型 = 小数>
    参数 邻域上限 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线3D接收局部最近 (对象指针, 源曲线, 点X, 点Y, 点Z, 邻域档, 邻域下限, 邻域上限))
    }

    方法 接收局部曲线间最近点自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getLocalClosestPoints(crvB, pocA, pocB, nbhd1, nbhd2): 两条空间曲线之间的局部最近点, 两个接收者都被改写; 对方 与两条曲线 都必须已创建。SDK 无返回值, 回真只表示调用走通。" 注释 = "邻域档 是位旗标: 位0 = 本侧区间生效, 位1 = 对方区间生效, 0 = 两侧都不给, 3 = 两侧都给; 0..3 之外桥内直接拒。" 注释 = "实测 段3 x 椭3 区间 [0.2,0.4] x [3.0,3.5]: 两侧都不给 → 甲 0、乙 0; 只给本侧 → 甲 0.2、乙 0; 只给对方 → 甲 0、乙 3.0; 两侧都给 → 甲 0.2、乙 3.0。异面两线 线3 x 线3b 同四档: 0 与 0、0.2 与 0、0 与 3、0.2 与 3。" 注释 = "曲线对档不靠种子换解这一条与二维不同: 段3 x 椭3 把 乙 预置成 0 / 1.0 / 3.0 三档都回 甲 0、乙 0; 异面两线换种子三档也全为 0 与 0。平行 / 相交 / 有界 / 退化 / 自身各档实测同二维口径, 求解器答的都不是全局最近(全局那一档回 -4 的是 接收曲线间最近点自)。" 注释 = "本方法不动两侧别名; 别名 不是 被解曲线 时连解都不自洽(见类注释), 所以调用方要保证 poc 绑的就是传进来的那两条曲线。">
    参数 对方 <类型 = ARX点上曲线3D>
    参数 本侧曲线 <类型 = 变整数>
    参数 对方曲线 <类型 = 变整数>
    参数 邻域档 <类型 = 整数>
    参数 本侧下限 <类型 = 小数>
    参数 本侧上限 <类型 = 小数>
    参数 对方下限 <类型 = 小数>
    参数 对方上限 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线3D接收局部最近对 (对象指针, 对方.对象指针, 本侧曲线, 对方曲线, 邻域档, 本侧下限, 本侧上限, 对方下限, 对方上限))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回 sizeof(AcGePointOnCurve3d), 用于核对内存布局。" 注释 = "实测 AcGe25: 为 16, 与二维兄弟类 ARX点上曲线2D 同宽 —— 曲线别名与参数就占这么宽, 别按它判断对象里绑了几条曲线。">
    {
        返回 (ARX几何底层.点上曲线3D结构尺寸 ())
    }
}

# ===

类 ARX偏移曲线2D <公开 注释 = "封装 ObjectARX AcGeOffsetCurve2d: 二维偏移曲线对象, 底层类型编号 63 = AcGe::kOffsetCurve2d, 由 (源曲线, 偏移距离) 二元组定义, 继承链 AcGeOffsetCurve2d -> AcGeCurve2d -> AcGeEntity2d。本包十七的第 23 个公开类。" 注释 = "与包十一那条 接收裁剪偏移自 通道的区别: 那一通道把偏移结果裁成一条新的叶曲线(圆弧、线段)交给叶类, 本类是偏移曲线这个对象本身, 偏移量存在对象里可以改, 源曲线也一直是活的依赖。" 注释 = "所有权(本类最重要的一条): 桥内替每个句柄按型深拷贝一份源曲线交给 SDK, 本句柄独占那份副本 —— 用户传进来的源曲线此后可以先 释放, 本对象不受影响; 反过来 释放 本对象也只销毁自己那份副本, 绝不碰用户手里那条源曲线。代价是底层 curve() 不再等于用户传入的源指针, 所以本类不提供任何 是否同一曲线 式的别名查询, 只有 取源类型编号。" 注释 = "符号与直觉相反(实测 AcGe25): 正 偏移距离 使闭合曲线向内收, 负值才外扩。半径 5 的整圆源 d=+2 得半径 3(取参数段长 18.8495559215388、取面积 28.2743338823081), d=-2 得半径 7(43.9822971502571 与 153.9380400259)。" 注释 = "构造门槛(桥内硬预检, 四类都回假且 对象指针 保持 0): 一、源指针无效; 二、源型克隆不了(四个二维叶型与 63 自身之外); 三、源曲线区间弧长为 0 —— 无限直线源(区间 0..0)与零长线段源都落在这里, 实测这两类源不拦会静默出垃圾(无限直线源偏 2 塌成点 (0,2)、到点距离(3,4) 给 3.60555127546399; 零长线段源偏 2 中点 NaN 而 到点距离(3,4) 给 1.4142135623731); 四、底层构造抛异常 —— 桥内 try/catch 兜底, 实测经本类生产通道时这一档没有源触发过它。副作用要记住: 二维无限直线源在本类一律造不出来。" 注释 = "缺省构造的二维圆弧(创建() 那条单位半径弧)向内偏 2 这一档要单独记住(实测经生产通道): 桥内先深拷贝过源以后 new 不抛了, 构造答真、句柄有效、取偏移距离 读回 2、源型 10、区间照抄源的 0..2π, 但半径被算成 1-2=-1 再取绝对值回到 1 —— 长 2π、面积 π、与源逐点重合所以 到曲线距离 给 0、起止点都翻到 (-1,0)、取样只给 4 个、裁剪偏移这一档给 0 片。第一轮探针(源指针直传 SDK、桥内没有副本)同一调用回的是 句柄 -1, 那道抛只存在于旧通道, 不要拿它当本类的门槛。" 注释 = "不拦的退化(实测): 长半轴 3、短半轴 2 的整椭 d=+2 内偏越过短半轴, 底层不抛也不报, 但读数已失真 —— 取参数段长 5.90765926696209、取面积 -0.314952642684178(负面积); 同一条 d=-2 那侧正常(长 28.4318102037522、面积 63.1468057142956 约等于 5×4)。" 注释 = "线段源可用且区间归一化(实测 (1,2)-(4,6) d=+2): 区间 0..1、取参数段长 5、是否有起点 给出 (-0.6,3.2)、是否有终点 给出 (2.4,7.2)、取参数(3,4) = 0.56; d=-2 那两个端点换成 (2.6,0.8) 与 (5.6,4.8)。" 注释 = "片通道口径: explode 在本类恒假且 0 片; getSplitCurves 与 getTrimmedOffset 从偏移曲线切出来的片又是一条偏移曲线(实测类型 63), 八个叶类全都拒收, 只有本类收得下, 而且这里的接收者必须已创建、还活着 —— 本类没有无参 创建, 唯一合法的起手是先 创建过源曲线 造一个占位对象再接片。接收者从未创建时两条入口一律回假、对象指针 归 0、是否有效 也回假、目标一位不动; 接收者活着而 片下标 越界时同样回假, 但句柄非 0、仍有效、取偏移距离 保持自己的旧值 —— 收不到片就不搬走一位。收进来的是桥内按型新建的私有副本(与 复制自 同一条通道), 每片各用一个本类对象接住并各自 释放, 父曲线 释放 之后两片照样读得出全套数。" 注释 = "取裁剪偏移自 收进来的片, 偏移距离 是相对最初源曲线的累计值(实测): 甲=offset(圆2,+2) 半径已收到 3, 它的裁偏片再内偏 2 那片 距 读 4、半径 1; 甲=offset(圆2,-2) 半径已扩到 7, 它的裁偏片 d=+2 那片 距 读 0、正好落回源圆。分割片 那一档 距 保持父值 2、区间各换半圈。" 注释 = "非有限入参拦在本类火山层: 取参数、求值点、到点距离、取最近点、是否过点 任一分量是 NaN 就不进桥, 回假或回 NaN。理由(实测): 三维偏移曲线上 isOn(NaN,NaN,NaN) 直接把进程干掉, 二维同调用只回 0, 而八个叶类上同样入参都不崩 —— 所以这道门只加在本类, 不动共享的曲线族底层导出。" 注释 = "曲线族三条与叶类不同的口径(实测): 一、是否闭合 跟着源形走, 无限直线源与零长线段源也判真; 二、取周期 只有整圆源与整椭源给 6.28318530717959, 其余一律 NaN; 三、取退化类型 恒 -1, 连零长线段源也 -1。" 注释 = "使用前必须调用 创建过源曲线, 使用完毕后调用 释放 归还底层对象与本句柄那份源副本。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeOffsetCurve2d 对象地址, 0 表示尚未创建。">

    方法 创建过源曲线 <公开 类型 = 逻辑型 注释 = "对应 new AcGeOffsetCurve2d(curve, distance): 源曲线 传 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D/ARX射线2D 任一类的 对象指针, 也可以是另一条 ARX偏移曲线2D 的 对象指针(实测嵌套源可用)。已存在时先释放旧对象再新建。" 注释 = "所有权: 桥内立刻按型深拷贝一份 源曲线 交给 SDK, 本句柄独占那份副本, 之后 源曲线 可以先释放, 也可以就地释放而不影响本对象。" 注释 = "回假的四类门槛见类注释: 源指针无效、源型克隆不了、源曲线区间弧长为 0(无限直线源、射线源与零长线段源, 射线源实测回假且 源类型编号 读 -1)、底层构造抛异常。失败时 对象指针 保持 0。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放偏移曲线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建偏移曲线2D (源曲线, 偏移距离)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeOffsetCurve2d 本体, 再销毁本句柄自己那份源副本, 最后把 对象指针 归零。用户手里那条源曲线不在本方法的射程内, 由调用方自己释放。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放偏移曲线2D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。只看自己的句柄: 造不出来时 创建过源曲线 已把 对象指针 留在 0。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "深拷贝 源 的当前状态进本对象: 按型克隆 源 的源副本, 再搬来 偏移距离 与参数区间。不走 SDK 的拷贝构造与赋值 —— 那两条只搬源指针, 会让两个句柄共用同一份副本, 与桥内『每个句柄独占一份副本』的所有权相冲。" 注释 = "因此本类每个对象的副本都唯一, 不存在两个对象共享一份的情况; 源 未创建、本对象未创建或 源 不是偏移曲线类型都回假且本对象一位不动。" 注释 = "实测 AcGe25: 副本改 设偏移距离(-1.5) 之后 源 的 取偏移距离 仍是 2、副本的 取参数段长 读 40.8407044966673, 两边互不影响。">
    参数 源 <类型 = ARX偏移曲线2D>
    {
        返回 (ARX几何底层.偏移曲线2D复制 (对象指针, 源.对象指针))
    }

    方法 设源曲线 <公开 类型 = 逻辑型 注释 = "对应 setCurve(curve): 先按型克隆新源, setCurve 之后才销毁旧副本, 所以换源失败不会把对象留在悬垂状态。回假时本对象一位不动, 门槛与 创建过源曲线 相同(源指针无效、源型克隆不了、源区间弧长为 0 都拒)。" 注释 = "实测 AcGe25: 半径 5 整圆源换成 (1,2)-(4,6) 线段源后 取源类型编号 从 10 变 22、区间从 0..6.28318530717959 变 0..1、取参数段长 从 18.8495559215388 变 5; 另有一条早先建在旧源上的偏移曲线不受这次换源影响, 仍读 18.8495559215388。">
    参数 源曲线 <类型 = 变整数>
    {
        返回 (ARX几何底层.偏移曲线2D设曲线 (对象指针, 源曲线))
    }

    方法 设偏移距离 <公开 类型 = 逻辑型 注释 = "对应 setOffsetDistance(distance): 底层这一档无返回值, 回真只表示调用走通; 句柄不是偏移曲线类型时回假。" 注释 = "符号与直觉相反: 正值内收、负值外扩(见类注释)。实测 AcGe25: 半径 5 整圆源上的副本从 2 改成 -1.5 后 取参数段长 读 40.8407044966673, 而 源 对象仍是 18.8495559215388。">
    参数 偏移距离 <类型 = 小数>
    {
        返回 (ARX几何底层.偏移曲线2D设距 (对象指针, 偏移距离))
    }

    方法 取偏移距离 <公开 类型 = 小数 注释 = "对应 offsetDistance(); 句柄无效或底层抛异常返回 NaN。" 注释 = "实测 AcGe25: 构造给多少读多少(2、-2、-1.5 都逐位回读), 偏移距离 为 0 时读 0 且曲线与源逐位重合(半径 5 的源取参数段长 仍是 31.4159265358979)。">
    {
        返回 (ARX几何底层.偏移曲线2D取距 (对象指针))
    }

    方法 取参数方向 <公开 类型 = 逻辑型 注释 = "对应 paramDirection(); 句柄无效或抛异常回假。" 注释 = "实测 AcGe25 恒真: 七个二维源与六个三维源上全读 1, 反转参数 之后也仍读 1。这一档在本类上没有可观察的状态, 挂出来只为与八个叶类接口对齐。">
    {
        返回 (ARX几何底层.偏移曲线2D参数方向 (对象指针))
    }

    方法 是否单位变换 <公开 类型 = 逻辑型 注释 = "把 transformation() 的九个元素与单位阵逐位比一遍, 全等才回真; 句柄无效或抛异常回假。" 注释 = "实测 AcGe25 恒真: 偏移曲线不带自己的变换, 全部源型上都读真。SDK 那一档返回的是 AcGeMatrix2d 引用, 本类不打算素矩阵入库, 只把这一档降档成逻辑型, 要看单个元素用 取变换元素。">
    {
        返回 (ARX几何底层.偏移曲线2D是否单位变换 (对象指针))
    }

    方法 取变换元素 <公开 类型 = 小数 注释 = "读 transformation().entry[行][列], 合法下标 0..2; 越界、句柄无效或抛异常返回 NaN。" 注释 = "实测 AcGe25: 对角三个元素读 1, 非对角读 0, 与 是否单位变换 恒真相合。">
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    {
        返回 (ARX几何底层.偏移曲线2D变换元素 (对象指针, 行, 列))
    }

    方法 取源类型编号 <公开 类型 = 整数 注释 = "读 curve() 所指对象的 type(): 桥内存的是按型克隆的私有副本, 副本自报的型与源一致(实测 半径 5 的整圆克隆回 10), 所以这一档读出来就是当初传进来的那个类型编号 —— 18 直线, 22 线段, 10 圆弧, 17 椭圆弧, 63 另一条偏移曲线。句柄无效或抛异常回 -1。" 注释 = "本类没有 是否同一曲线 这一档: 深拷贝之后底层 curve() 恒不等于用户手里的源指针, 那是所有权设计的代价, 想核对源换了没有只能比这一档的型。">
    {
        返回 (ARX几何底层.偏移曲线2D源类型 (对象指针))
    }

    方法 取类型编号 <公开 类型 = 整数 注释 = "对应 AcGeEntity2d::type, AcGe::kOffsetCurve2d; 句柄无效返回 -1。" 注释 = "实测 AcGe25 恒 63, 与源是圆、线段还是另一条偏移曲线无关。">
    {
        返回 ARX几何底层.曲线2D类型编号 (对象指针)
    }

    方法 取区间下限 <公开 类型 = 小数 注释 = "对应 AcGeCurve2d::getInterval 的 lowerBound; 句柄无效返回 NaN。" 注释 = "实测 AcGe25: 区间跟着源, 线段源与零长线段源 0..1, 90 度弧源 0..1.5707963267949, 整圆源与整椭源 0..6.28318530717959。">
    {
        返回 (ARX几何底层.曲线2D区间下限 (对象指针))
    }

    方法 取区间上限 <公开 类型 = 小数 注释 = "对应 AcGeCurve2d::getInterval 的 upperBound; 句柄无效返回 NaN。" 注释 = "实测 AcGe25: 口径同 取区间下限。整圆与整椭的上限真实双精度是 6.283185307179586 而 到文本 打印成 6.28318530717959, 抄打印值回传就越界约 4e-15 让 取面积 直接返回 NaN, 一律用本方法的返回值。">
    {
        返回 (ARX几何底层.曲线2D区间上限 (对象指针))
    }

    方法 设参数区间 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::setInterval(AcGeInterval&) 的有限闭区间档: 两个小数在桥内现构区间对象, AcGeInterval 不入库, 零新类; 它只挪参数窗口, 不裁几何。" 注释 = "实测 AcGe25(半径 5 整圆源 d=+2): 设 (0.3,1.2) 回真, 区间回读 0.3..1.2, 取参数段长 读 2.7 = 内收后的半径 3 乘以角度差。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    {
