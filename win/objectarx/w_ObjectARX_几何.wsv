    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    参数 结果 <类型 = ARX直线3D>
    {
        返回 ARX几何底层.圆弧3D切线错误 (对象指针, 点X, 点Y, 点Z, 结果.对象指针)
    }

    方法 取直线交点 <公开 类型 = 整数 注释 = "对应 AcGeCircArc3d::intersectWith(line, intn, p1, p2), 返回交点个数, -1 表示底层判假或句柄无效。对方 可传 ARX直线3D 或 ARX线段3D 的 对象指针。" 注释 = "实测 AcGe25: 半径 5 的整圆与过圆心的水平线得 2 个交点, 与切线得 1 且只写 点一, 与同面但不相交的直线得 -1。异面直线按无解处理返回 -1, 不做投影。对方是线段时按线段端点截断: 覆盖圆的长线段仍得 2, 只盖住一个交点的短线段得 1, 完全错开得 -1。90 度弧只按其角域裁剪, 够不着的直线得 -1。本方或对方句柄无效同样 -1。返回 -1 或只找到一个交点时 点二 保持调用方原值, 复用点对象前要先清脏值。">
    参数 对方 <类型 = 变整数>
    参数 点一 <类型 = ARX点3D>
    参数 点二 <类型 = ARX点3D>
    {
        返回 ARX几何底层.圆弧3D交直线 (对象指针, 对方, 点一.对象指针, 点二.对象指针)
    }

    方法 取圆弧交点 <公开 类型 = 整数 注释 = "对应 AcGeCircArc3d::intersectWith(arc, intn, p1, p2), 返回交点个数, -1 表示底层判假或句柄无效。" 注释 = "实测 AcGe25: 同面两圆相交 2; 外切与内切都只给 1 且仅写 点一, 点二 保持调用方原值; 相离、同心不等半径、完全重合、以及两圆所在面平行都返回 -1。对方是圆弧时按其角域裁剪, 首尾相接的两段弧只交于那个公共端点。本方或对方句柄无效同样 -1。返回 -1 时两个出参点都不被改写, 复用点对象前要先清脏值。">
    参数 对方 <类型 = ARX圆弧3D>
    参数 点一 <类型 = ARX点3D>
    参数 点二 <类型 = ARX点3D>
    {
        返回 ARX几何底层.圆弧3D交圆弧 (对象指针, 对方.对象指针, 点一.对象指针, 点二.对象指针)
    }

    方法 取平面交点 <公开 类型 = 整数 注释 = "对应 AcGeCircArc3d::intersectWith(planarEnt, intn, p1, p2), 返回交点个数, -1 表示底层判假或句柄无效。二维侧没有该接口。" 注释 = "实测 AcGe25: 把圆面切开的平面给 2 个交点; 与圆面无公共点的平面给 -1; 平面恰好就是圆弧自身所在的那个面也给 -1, 不会因为整面重合而报无穷多解。本方或平面句柄无效同样 -1。返回 -1 时 点一/点二 都保留上一次调用留下的值, 复用点对象前要先清脏值。">
    参数 平面 <类型 = ARX平面>
    参数 点一 <类型 = ARX点3D>
    参数 点二 <类型 = ARX点3D>
    {
        返回 ARX几何底层.圆弧3D交平面 (对象指针, 平面.对象指针, 点一.对象指针, 点二.对象指针)
    }

    方法 取投影交点 <公开 类型 = 整数 注释 = "对应 AcGeCircArc3d::projIntersectWith(line, projDir, i, arcP1, arcP2, lineP1, lineP2): 沿 投影方向 把直线投到本圆弧, 返回交点个数, -1 表示底层判假或句柄无效。" 注释 = "弧上的交点写入 弧上点一/弧上点二, 直线上的对应点写入 线上点一/线上点二, 四者都必须是已创建的 ARX点3D。二维侧没有该接口。" 注释 = "实测 AcGe25: 沿 Z 把面外直线投到圆面得 2 时四个出参点成对写满, 弧上点的 z 落在圆面上而线上点保留其原始高度。投影后正好相切得 1, 此时只写 弧上点一 与 线上点一, 弧上点二 保持调用方原值。投影后仍无交点得 -1, 四个出参点一个都不碰。投影方向与直线自身平行时按无解处理返回 -1。对方传线段指针时同样按端点截断。本方或对方句柄无效返回 -1。复用点对象前要先清脏值。">
    参数 直线 <类型 = 变整数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    参数 弧上点一 <类型 = ARX点3D>
    参数 弧上点二 <类型 = ARX点3D>
    参数 线上点一 <类型 = ARX点3D>
    参数 线上点二 <类型 = ARX点3D>
    {
        返回 ARX几何底层.圆弧3D投影交 (对象指针, 直线, 方向X, 方向Y, 方向Z, 弧上点一.对象指针, 弧上点二.对象指针, 线上点一.对象指针, 线上点二.对象指针)
    }

    方法 取平面最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGeCircArc3d::closestPointToPlane(plane, pntOnPlane): 圆弧上离平面最近的点写入 结果, 平面上的垂足写入 平面点。二维侧没有该接口。">
    参数 平面 <类型 = ARX平面>
    参数 结果 <类型 = ARX点3D>
    参数 平面点 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.圆弧3D平面最近点 (对象指针, 平面.对象指针, 结果.对象指针, 平面点.对象指针))
    }

    方法 设为圆角 <公开 类型 = 逻辑型 注释 = "对应 AcGeCircArc3d::set(curve1, curve2, radius, param1, param2, success), 成功时本圆弧变成两曲线间指定半径的圆角, 两个切点分别写入 切点一 与 切点二。" 注释 = "底层给的 param1/param2 是两条曲线上的曲线参数, 桥接层已按参数求值成空间点再写出, 因此 切点一/切点二 是 ARX点3D 而不是参数值。" 注释 = "实测 AcGe25 适用边界: 只有两条曲线都是有限长线段(ARX线段3D)时才可能成功, 线段配无限直线、直线配直线、以及拿圆弧当输入都判假。成功弧恒为 起始角 = 区间下限 = 0、终止角 = 区间上限 = 两段夹角, 法向朝向使参考向量落在两段夹角角平分线的垂向上。" 注释 = "坑: 判假时本圆弧的全套属性与两个切点出参一律不改, 唯一例外是 半径 传 0 会把对象的半径真改成 0, 因此不要用 0 半径试探可行性。">
    参数 曲线一 <类型 = 变整数>
    参数 曲线二 <类型 = 变整数>
    参数 半径 <类型 = 小数>
    参数 切点一 <类型 = ARX点3D>
    参数 切点二 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.圆弧3D圆角 (对象指针, 曲线一, 曲线二, 半径, 切点一.对象指针, 切点二.对象指针))
    }

    方法 设为三切圆 <公开 类型 = 逻辑型 注释 = "对应 AcGeCircArc3d::set(curve1, curve2, curve3, param1, param2, param3, success), 成功时本圆弧与三条曲线都相切, 三个切点写入 切点一/切点二/切点三。" 注释 = "实测 AcGe25: 三线段直角三角形、z=5 平面上三线段、三平行线段、两直线加一线段、平行线加共线段五组输入全部判假, 本机构建下按不可用接口对待, 不要在其上依赖任何结果。判假时本圆弧属性与三个切点出参都不改写。">
