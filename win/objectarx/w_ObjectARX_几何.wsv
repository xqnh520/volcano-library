    方法 曲线2D分割片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getSplitCurves(param, piece1, piece2): 只问 分割参数 处 片下标 (0 或 1) 那片的具体类型, 返回 AcGe::EntityId 的整数值。" 注释 = "返回码: -1 指针无效或 片下标 不是 0/1, -2 底层抛异常, -3 底层把该片给成空指针; 其余为该片真实的 AcGe::EntityId, 用来决定该先创建哪一类对象再调 曲线2D分割片进。两片都是底层 new 出来的对象, 问完就在桥内释放, 不交给调用方。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        @ arx_ge_curve2d_split_type(@<对象指针>, @<分割参数>, @<片下标>)
    }

    方法 曲线2D分割片进 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getSplitCurves: 取回 片下标 那片, 只有当它的具体类型与 目标指针 报的 type() 相同才赋值进 目标指针。" 注释 = "所有权口径: 两片一律由桥内按 type() 还原具体类后释放, 句柄不出桥 —— AcGeEntity2d 的析构非虚, 按静态类型 delete 是未定义行为。类型不符、该片为空、指针无效都返回假且目标对象一位不动。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    参数 目标指针 <类型 = 变整数>
    {
        @ (arx_ge_curve2d_split_into(@<对象指针>, @<分割参数>, @<片下标>, @<目标指针>) == 1)
    }

    方法 曲线2D裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 问 偏移距离 偏出的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 分别是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "底层这个重载返回 void, 片数是唯一的成败信号: -1 指针无效或 延伸档 不在 0..2, -2 底层抛异常; 不小于 0 就是片数, 而 0 片是正常返回不是错误 —— 实测 AcGe25 上整椭圆内偏越过短半轴、圆弧与整圆内偏越过半径都给 0 片。三档延伸在单条叶曲线上读数完全相同(实测), 这个参数只对复合曲线源才有意义, 按裁定原样开放。片是底层新 new 出来的独立对象, 问完就在桥内释放, 句柄不出桥。" 注释 = "符号与量值口径(实测 AcGe25): d=+2 使半径 5 的圆弧与整圆收进成 3、d=-2 放大成 7, 即正值为向心; 片的参数区间恒等于源区间(线段 0..1、弧 0..π/2、整圆与整椭圆 0..2π、无限直线退化成 0..0); 片长只在线段上等于源长(线段 (1,2)-(4,6) 偏 +3、-2 与 +10 都还是 5), 圆弧按半径同比缩放 (半径 5 的 0..π/2 弧 d=+2 后弧长 4.71238898038469 对源 7.85398163397448), 整椭圆变化更大 (a=3 b=2 的整椭圆 d=-2 偏出 28.4318102037522 对源 15.8654395893345); 中点间隙恒精确等于 |偏移距离|。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    {
        @ arx_ge_curve2d_trim_offset_count(@<对象指针>, @<偏移距离>, @<延伸档>)
    }

    方法 曲线2D裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset: 只问 片下标 那片的具体类型, 返回 AcGe::EntityId 的整数值, 用来决定该先创建哪一类对象再调 曲线2D裁剪偏移片进。" 注释 = "返回码: -1 指针无效、延伸档 不在 0..2、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。实测 AcGe25 2D 侧的片型只有 22 线段、10 圆弧或整圆、18 无限直线 三种叶类型, 加上整椭圆偏出来的 63 偏移曲线 —— 63 在火山侧没有对应类, 所以 椭圆弧2D 接不了自己源的偏移片。问完就在桥内释放。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        @ arx_ge_curve2d_trim_offset_type(@<对象指针>, @<偏移距离>, @<延伸档>, @<片下标>)
    }

    方法 曲线2D裁剪偏移片进 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getTrimmedOffset: 取回 片下标 那片, 只有当它的具体类型与 目标指针 报的 type() 相同才赋值进 目标指针。" 注释 = "所有权口径与 曲线2D分割片进 同一套: 片一律由桥内按 type() 还原具体类后释放, 句柄不出桥 —— AcGeEntity2d 的析构非虚, 按静态类型 delete 是未定义行为。类型不符(片是 63 偏移曲线而 2D 侧只有 10/18/22 三类接收者)、该片为空、指针无效都返回假且目标对象一位不动。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    参数 目标指针 <类型 = 变整数>
    {
        @ (arx_ge_curve2d_trim_offset_into(@<对象指针>, @<偏移距离>, @<延伸档>, @<片下标>, @<目标指针>) == 1)
    }
