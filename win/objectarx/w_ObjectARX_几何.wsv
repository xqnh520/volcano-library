    }

    方法 取平面最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGePlanarEnt::closestPointToPlanarEnt(other, pointOnOther)。本面上的点写入 结果, 对方面上的点写入 对方点。对方 可以是 ARX平面 或 ARX有界平面 的 对象指针。" 注释 = "实测 AcGe25: 两片平行时各自夹到最近的角(矩形片 对 z=9 的单位方片 得 本面 (1,2,3)、对方 (1,1,9))。">
    参数 对方 <类型 = 变整数>
    参数 结果 <类型 = ARX点3D>
    参数 对方点 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.平面平面最近点 (对象指针, 对方, 结果.对象指针, 对方点.对象指针))
    }

    方法 是否过点 <公开 类型 = 逻辑型 注释 = "对应 AcGeSurface::isOn(pnt), 走 AcGeContext::gTol。" 注释 = "实测 AcGe25: 按矩形片判, 点仍在无限面上但越界就判假(矩形片 对 (10,10,3)、只越一条边的 (4,3,3) 与 (2,6,3) 都判假)。角点和边上的点算片内((1,2,3)、(3,5,3) 判真); 片内但带高的 (2,3.5,4) 判假。" 注释 = "创建() 的缺省对象没有边界, 界外点也判真 —— 本方法是分辨缺省对象与真实有界片最省事的探针。未创建判假。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.平面过点 (对象指针, 点X, 点Y, 点Z))
    }

    方法 取最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGeSurface::closestPointTo(pnt), 写入已创建的 结果 点对象。" 注释 = "实测 AcGe25: 结果夹在矩形片上, 与 取距离 同一套裁剪 —— 矩形片 对 (10,10,3) 给角 (3,5,3), 对 (4,3,3) 给边上的 (3,3,3), 对片内带高的 (2,3.5,9) 给正下方 (2,3.5,3)。创建() 的缺省对象不夹。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.平面最近点 (对象指针, 点X, 点Y, 点Z, 结果.对象指针))
    }

    方法 取距离 <公开 类型 = 小数 注释 = "对应 AcGeSurface::distanceTo(pnt); 未创建返回 NaN。" 注释 = "实测 AcGe25: 给的是点到矩形片的真实距离, 界外点先夹到片上再量 —— 矩形片 对 (10,10,3) 得 8.60232526704263(= sqrt(74), 到角 (3,5,3)), 对 (4,3,3) 与 (2,6,3) 各得 1(到边), 对片内带高的 (2,3.5,4) 得 1。创建() 的缺省对象没有边界, 界外点给 0。本类没有 取有向距离, 那是 AcGePlane 专有的。">
    参数 点X <类型 = 小数>
