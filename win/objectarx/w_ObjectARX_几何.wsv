    }

    方法 求并 <公开 类型 = 逻辑型 注释 = "对应 getMerge(other, result): 并集写进 结果(必须是已创建的 ARX区间), 本方法先替 结果 做一次 设无界 复位。回假 = 任一句柄无效。" 注释 = "实测三条要记住: (1) 结果容差跟左件, 右件的容差被丢掉。(2) 隔开的两件并成外缘且不报警, 1..3 并 10..12 得 1..12。(3) 并上无界件时形状转无界但界值可能留着, 而且方向不同留的东西不同 —— 1..3 并 无界 留着 1..3, 无界 并 1..3 读 0..0。">
    参数 对方 <类型 = ARX区间>
    参数 结果 <类型 = ARX区间>
    {
        结果.设无界 ()
        返回 (ARX几何底层.区间求并 (对象指针, 对方.对象指针, 结果.对象指针))
    }

    方法 接收差片段 <公开 类型 = 整数 注释 = "对应 subtract(other, resLeft, resRight): 差集写进 左片 与 右片(都必须是已创建的 ARX区间), 本方法先替两片各做一次 设无界 复位; 返回 0..2 是实际片数, 句柄无效返回 -1。" 注释 = "实测: 0..10 减 1..3 回 2 片 0..1 与 3..10; 只咬掉一侧的回 1 片且只写 左片; 隔开的对方照样回 1 片, 这一档的 左片 是本件整件复制, 连本件自己的容差一起带过来。回 0 片只有四档: 与对方全等、本件被对方整个包住、对方无界、本件自己反序 —— 0 片档 左片 与 右片 一个字不写, 停在库层的复位态。半无界件参与时会回一个仍然半无界的片。">
    参数 对方 <类型 = ARX区间>
    参数 左片 <类型 = ARX区间>
    参数 右片 <类型 = ARX区间>
    {
        左片.设无界 ()
        右片.设无界 ()
        返回 (ARX几何底层.区间求差 (对象指针, 对方.对象指针, 左片.对象指针, 右片.对象指针))
    }

    方法 求交 <公开 类型 = 逻辑型 注释 = "对应 intersectWith(other, result): 交集写进 结果(必须是已创建的 ARX区间), 本方法先替 结果 做一次 设无界 复位; 回真才表示 结果 可用。" 注释 = "实测警告: 判假时底层仍会把 结果 改写成反序垃圾件(1..3 交 10..12 写成 10..3, 长度 -7), 复位也挡不住 —— 本方法的返回码是唯一可信的判据, 判假一律别读 结果。" 注释 = "实测判真档: 1..3 交 2..4 得 2..3; 全等件得自身; 无界件交有界件得那个有界件; 半无界 交 1..3 得 2..3。">
    参数 对方 <类型 = ARX区间>
    参数 结果 <类型 = ARX区间>
    {
        结果.设无界 ()
        返回 (ARX几何底层.区间求交 (对象指针, 对方.对象指针, 结果.对象指针))
    }

    方法 求上侧重叠 <公开 类型 = 逻辑型 注释 = "对应 isOverlapAtUpper(other, result): 是 是否上端连续 的补集, 判真时把重叠段写进 结果(必须是已创建的 ARX区间), 本方法先替 结果 做一次 设无界 复位。" 注释 = "实测: 交叠件 1..3 与 2..4 判真且写出 2..3; 首尾正相接与全等两档都判假且不写 结果。">
    参数 对方 <类型 = ARX区间>
    参数 结果 <类型 = ARX区间>
    {
        结果.设无界 ()
        返回 (ARX几何底层.区间上侧重叠 (对象指针, 对方.对象指针, 结果.对象指针))
    }

    方法 是否周期内 <公开 类型 = 逻辑型 注释 = "对应 isPeriodicallyOn(period, val) 的返回位; 折算后的值请另调 取周期折叠值, 两档同参。" 注释 = "实测不改对象: 三档试下来 0..2PI 上 7 回真、1..3 上 -1 回假、无界件与半无界件回真, 每次读完界值与容差都原样。">
    参数 周期 <类型 = 小数>
    参数 值 <类型 = 小数>
    {
        返回 (ARX几何底层.区间周期内 (对象指针, 周期, 值))
    }

    方法 取周期折叠值 <公开 类型 = 小数 注释 = "对应 isPeriodicallyOn(period, val) 的出参位: 把 值 送进底层再取回它写出的那个数; 句柄无效返回非数。" 注释 = "实测: 落在区间内才折 —— 0..2PI 上 7 折成 0.716814692820414; 判假时原样透传(1..3 上 -1 回 -1), 无界件(0.5 回 0.5)、半无界件(2.5 回 2.5)与整圆(3.5 回 3.5)也都原样透传。本方法与 是否周期内 是两次独立调用, 底层不缓存。">
    参数 周期 <类型 = 小数>
    参数 值 <类型 = 小数>
    {
