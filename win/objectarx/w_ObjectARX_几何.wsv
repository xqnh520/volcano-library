        返回 (ARX几何底层.包围块3D内含 (对象指针, 点.对象指针))
    }

    方法 互不相交 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundBlock3d::isDisjoint(block), 对方对象必须已创建。" 注释 = "实测: 走轴对齐包络长方体是否分离, 边界刚好相接不算不相交; 对 isBox 为假的块同样可用。">
    参数 对方 <类型 = ARX包围块3D>
    {
        返回 (ARX几何底层.包围块3D不相交 (对象指针, 对方.对象指针))
    }

    方法 是否盒 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundBlock3d::isBox()。" 注释 = "实测: 块自己存着的标志, 与几何是否真的轴对齐无关; 曲线送来的块只有 orthoBoundBlock 为真。">
    {
        返回 (ARX几何底层.包围块3D是盒 (对象指针))
    }

    方法 设为盒 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundBlock3d::setToBox(Adesk::kTrue/kFalse), 就地改写 isBox 标志。" 注释 = "实测(2D 同口径): 只翻标志、不碰几何, 但标志决定后续 extend 走哪套算法, 真盒置假再 extend 会毁掉边向量。">
    参数 值 <类型 = 逻辑型>
    {
        如果 (值)
        {
            返回 (ARX几何底层.包围块3D设为盒 (对象指针, 1))
        }
        返回 (ARX几何底层.包围块3D设为盒 (对象指针, 0))
    }

    方法 取类型编号 <公开 类型 = 整数 注释 = "对应 AcGeEntity3d::type(), 底层句柄无效时返回 -1。" 注释 = "AcGe::kBoundBlock3d = 62。实测三维块无论来历都是 62。">
    {
        返回 (ARX几何底层.包围块3D类型编号 (对象指针))
    }

    方法 接收包围块自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::boundBlock(), 把 源曲线 的外接平行六面体写进本对象。源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D/ARX射线3D 任一类的 对象指针。" 注释 = "实测: 结果的 isBox 为假, 类型编号 62; 平面曲线(含圆弧/椭圆弧)的 向三 是零向量, 只有 向一/向二 承载尺寸; 源曲线 给 ARX射线3D 同样判真拿到块且 isBox 为假。">
    参数 源曲线 <类型 = 变整数>
    {
        返回 (ARX几何底层.包围块3D从曲线 (对象指针, 源曲线, 0, 0, 0.0, 0.0))
    }

    方法 接收正交包围块自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::orthoBoundBlock(), 把 源曲线 的轴对齐外接长方体写进本对象。源曲线 口径同 接收包围块自。" 注释 = "实测: isBox 恒为真, 三边轴对齐; 平面曲线的 向三 长度就是该曲线的 z 向厚度(常为 0)。">
    参数 源曲线 <类型 = 变整数>
    {
        返回 (ARX几何底层.包围块3D从曲线 (对象指针, 源曲线, 1, 0, 0.0, 0.0))
    }

    方法 接收包围块区间自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::boundBlock(AcGeInterval(下限, 上限)), 只取曲线上 [下限, 上限] 这段的外接平行六面体。源曲线 口径同 接收包围块自。" 注释 = "实测: 下限 > 上限 时底层不重排而是翻转方向(基点落到高端、向量取负); 下限 == 上限 得到退化块。">
    参数 源曲线 <类型 = 变整数>
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    {
        返回 (ARX几何底层.包围块3D从曲线 (对象指针, 源曲线, 0, 1, 下限, 上限))
    }

    方法 接收正交包围块区间自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::orthoBoundBlock(AcGeInterval(下限, 上限)), 只取曲线上 [下限, 上限] 这段的轴对齐外接长方体。源曲线 口径同 接收包围块自。" 注释 = "实测: isBox 恒为真, 其余边界行为同 接收包围块区间自。">
    参数 源曲线 <类型 = 变整数>
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    {
        返回 (ARX几何底层.包围块3D从曲线 (对象指针, 源曲线, 1, 1, 下限, 上限))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回 sizeof(AcGeBoundBlock3d), 用于核对内存布局。" 注释 = "实测 AcGe25: 为 16, 与二维兄弟类 ARX包围块2D 以及 ARX平面 同宽, 基点与三条棱同样不占壳内空间。">
    {
        返回 (ARX几何底层.包围块3D结构尺寸 ())
    }
}

# ===

类 ARX点上曲线2D <公开 注释 = "封装 ObjectARX AcGePointOnCurve2d: 曲线上一个点的位置, 由 (所绑曲线, 参数) 二元组表达, 是 AcGeCurve2d::getClosestPointTo 的出参类型。" 注释 = "使用前必须调用 创建(或 创建过曲线 / 创建过曲线参数 / 接收最近点自 之一), 使用完毕后调用 释放 归还底层对象。" 注释 = "所有权: 本类只借曲线不持有 —— 底层存的是 const AcGeCurve2d&, 所绑曲线必须先于本对象释放, 否则 curve() 就是悬垂指针, 底层不拦也不崩, 后果自负; 释放本对象也绝不会碰那条曲线。" 注释 = "实测 AcGe25 四条口径, 用的时候要记住: (1) 缺省构造不是空对象 —— curve() 指向一条 AcGeLine2d(类型编号 18), 而且所有缺省对象共用同一条, parameter() 读 0; 所以 是否有效 只看自己的句柄, 绝不能用曲线是否为零判空。 (2) 参数不夹取: 段2 = (1,2)-(4,6) 上给种子 5 就存 5, 取点外插成 (16,22)。 (3) 接收…自 一族是改写本对象, 不是返回值: 预置在段2 上的对象经圆2 求解后曲线与参数一起被搬走。 (4) 拷贝赋值是浅的, 参数、点、别名一起搬, 副本仍与原对象指向同一条曲线; 取类型编号 恒 6。" 注释 = "(5) 三个带参档 取点在参数 / 取导数在参数 / 取曲率在参数 都会先把 参数值 写回本对象再算 —— 实测把参数设成 2.5 后分别调 0.9、0.4、1.4, 回读就成了 0.9、0.4、1.4; 无参的 取点 / 取导数 / 取曲率 与两个静态档都不动。要按别的参数算又不改本对象, 走 取曲线点 / 取曲线导数。" 注释 = "(6) 包十五B 三条入口 接收法向点自 / 接收局部最近点自 / 接收局部曲线间最近点自 与 接收…自 一族不同: 它们不动别名 —— 解完之后 是否同一曲线 仍指本对象原来绑的那条, 只有 参数 被改写; 想对齐得再调一次 设曲线 或 创建过曲线。实测 甲绑圆2、拿段2 求 (3,4): 法向点档写进段2 的解 0.56 但 是否同一曲线(圆2) 仍真、(段2) 假; 点档写的却是 0.927295218001612 = 圆2 自己的解; 曲线对档两侧别名都不动、写进 甲 1 与 乙 0。别名不一致时 取点 的来源都不自洽 —— 法向点档给被解曲线上的 (2.68,4.24), 点档给别名曲线上的 (3,4)。" 注释 = "(7) 这三条解完之后 取曲率 不可信, 派生缓存没跟着参数刷新: 圆2 上解出 0.56 后 取曲率 回 0.12 或 0.109605902711782(应为 0.2)、微圆2 回 600(应为 1000)、零段2 回 NAN; 把同一个参数再 设参数 一遍才回 0.2, 且点重算成 圆2 在参数 0.56 = (4.23627555506708,2.65593098960442)。断言只用 取参数 / 是否同一曲线, 别名与被解曲线一致时才用 取点, 一律不用 取曲率。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGePointOnCurve2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnCurve2d(), 缺省构造。已存在时先释放旧对象。" 注释 = "实测: 缺省构造也绑着一条曲线 —— 类型编号 18 的 AcGeLine2d, 且所有缺省对象共用同一条; 参数 0、取点 (0,0)、|deriv(1)| = 1 因而 是否奇点 为假。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲线2D ()
        返回 (对象指针 != 0)
    }

    方法 创建过曲线 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnCurve2d(crv), 源曲线 传 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D/ARX射线2D 任一类的 对象指针。已存在时先释放旧对象。" 注释 = "实测: 只给曲线时参数落 0、别名即换成该曲线, 后续求值全从参数 0 起步 —— 圆2 上 取点 = (5,0)、取曲率 = 0.2、是否奇点 假, 是否同一曲线 查圆2 真而查段2 假; 源曲线 给 ARX射线2D 也建得成(判真、参数落 0、取点 就是射线的端点)。">
    参数 源曲线 <类型 = 变整数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲线2D过曲线 (源曲线)
        返回 (对象指针 != 0)
    }

    方法 创建过曲线参数 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnCurve2d(crv, param), 源曲线 口径同 创建过曲线。已存在时先释放旧对象。" 注释 = "实测: 种子原样存, 不夹取也不取模 —— 段2 上给 5 回读 5 且 取点 外插成 (16,22); 椭2 上给 0.7 与 2.4 分别得 |deriv(1)| = 2.46476817221202 与 2.5062427139847; 负种子 -3 同样存得住。">
    参数 源曲线 <类型 = 变整数>
    参数 参数值 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲线2D过参数 (源曲线, 参数值)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGePointOnCurve2d 对象并把 对象指针 归零。所绑曲线是借来的, 本方法不碰它, 由调用方自己释放。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲线2D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。" 注释 = "只看句柄: 底层 curve() 恒不为空(缺省对象也有曲线), 别拿曲线在不在当判空依据。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::operator=(const AcGePointOnCurve2d&), 源对象必须已创建且本对象也已创建。" 注释 = "实测: 浅拷贝 —— 参数与点原样搬(圆2 上 0.982793723247329 与 (2.77350098112615,4.16025147168922)), 副本 是否同一曲线 指回原对象绑的那条曲线, 类型编号仍为 6。">
    参数 源 <类型 = ARX点上曲线2D>
    {
        返回 (ARX几何底层.点上曲线2D复制 (对象指针, 源.对象指针))
    }

    方法 设曲线 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::setCurve(crv), 源曲线 口径同 创建过曲线。" 注释 = "实测: 只换别名不动参数 —— 先把参数设成 2.5 再 设曲线(段2), 回读参数仍是 2.5 而 是否同一曲线(段2) 已为真; 曲线句柄传 0 时返回假且参数与别名都不动。新建对象上设完读到 0, 那是构造的初值不是本方法清的。">
    参数 源曲线 <类型 = 变整数>
    {
        返回 (ARX几何底层.点上曲线2D设曲线 (对象指针, 源曲线))
    }

    方法 设参数 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::setParameter(param), 原样存不夹取。" 注释 = "实测: 线2 上给 -2、段2 上给 5 都原样回读; 缺省对象上没设过曲线也存得住 1.2, 且它的曲线仍是那条缺省线。">
    参数 参数值 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线2D设参数 (对象指针, 参数值))
    }

    方法 是否同一曲线 <公开 类型 = 逻辑型 注释 = "对应 curve() == &给定曲线, 是本类唯一的别名查询入口 —— 裸曲线指针不出桥。源曲线 传曲线的 对象指针。" 注释 = "实测: 带参构造之后、设曲线之后、接收最近点自 之后都能用它验证别名换没换; 句柄无效返回假。它不是判空手段。">
    参数 源曲线 <类型 = 变整数>
    {
        返回 (ARX几何底层.点上曲线2D同曲线 (对象指针, 源曲线))
    }

    方法 取参数 <公开 类型 = 小数 注释 = "对应 AcGePointOnCurve2d::parameter(), 句柄无效返回 NaN(比较 X != X 判 NaN)。" 注释 = "实测各叶曲线上的读数见 接收最近点自。">
    {
        返回 (ARX几何底层.点上曲线2D读参数 (对象指针))
    }

    方法 取类型编号 <公开 类型 = 整数 注释 = "对应 AcGePointOnCurve2d::type(), 句柄无效返回 -1。" 注释 = "AcGe::kPointOnCurve2d = 6。实测恒为 6: 缺省对象、带曲线、拷贝之后都是 6, 与所绑的是圆还是线段无关。">
    {
        返回 (ARX几何底层.点上曲线2D类型编号 (对象指针))
    }

    方法 取点 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::point(), 结果写进调用方已创建的 结果(ARX点2D)。" 注释 = "实测: 段2 上参数 0.28 → (1.84,3.12); 零段2 = (2,3)-(2,3) 上参数 0 → (2,3); 缺省对象 → (0,0); 不夹取的外插照给 —— 段2 上参数 5 → (16,22)。">
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.点上曲线2D取点 (对象指针, 结果.对象指针))
    }

    方法 取点在参数 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::point(param)。" 注释 = "实测两条: 圆2 自有参数 1.2 → (1.81178877238337,4.66019542983613), 用本方法在同一参数处拿到的点与之逐位相同; 但它不是纯查询 —— 先把参数设成 2.5 再调本方法取 0.9, 回读参数就成了 0.9。要按别的参数算又不动本对象, 用静态档 取曲线点。">
    参数 结果 <类型 = ARX点2D>
    参数 参数值 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线2D取点于 (对象指针, 参数值, 结果.对象指针))
    }

    方法 取曲线点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::point(crv, param)。桥内在临时对象上调用, 因此不需要本对象, 结果与接收者无关。" 注释 = "实测: 圆2 + 1.2 → (1.81178877238337,4.66019542983613), 与 取点 / 取点在参数 三档逐位相同。">
    参数 结果 <类型 = ARX点2D>
    参数 源曲线 <类型 = 变整数>
    参数 参数值 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线2D曲线取点 (源曲线, 参数值, 结果.对象指针))
    }

    方法 取导数 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::deriv(order), 结果写进调用方已创建的 结果(ARX向量2D)。" 注释 = "实测: 阶数 0 回 (0,0); 圆2 上参数 0.982793723247329 处 deriv(1) = (-4.16025147168922,2.77350098112615)、deriv(2) = (-2.77350098112615,-4.16025147168922), 即对角度参数的切向与曲率向。">
    参数 结果 <类型 = ARX向量2D>
    参数 阶数 <类型 = 整数>
    {
        返回 (ARX几何底层.点上曲线2D取导 (对象指针, 阶数, 结果.对象指针))
    }

    方法 取导数在参数 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnCurve2d::deriv(order, param)。" 注释 = "实测两条: 圆2 上 deriv(1,1.2) = (-4.66019542983613,1.81178877238337), 与该对象把参数设成 1.2 之后的 取导数 逐位相同; 本方法与 point(param) 同口径, 会先把 参数值 写进本对象 —— 设成 2.5 后调本方法取 0.4, 回读参数就是 0.4。">
    参数 结果 <类型 = ARX向量2D>
    参数 阶数 <类型 = 整数>
    参数 参数值 <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲线2D取导于 (对象指针, 阶数, 参数值, 结果.对象指针))
    }

