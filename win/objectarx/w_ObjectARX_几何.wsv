    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeScale3d), 用于校验结构内存布局。" 注释 = "实测 AcGe25: 24 字节, 就是 sx、sy、sz 三个 double。">
    {
