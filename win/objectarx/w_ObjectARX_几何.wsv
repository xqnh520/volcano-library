    }

    方法 取有向距离 <公开 类型 = 小数 注释 = "对应 AcGePlane::signedDistanceTo(pnt), 平面未创建返回 NaN。" 注释 = "实测 AcGe25: 返回值就是 a*x+b*y+c*z+d, 因系数已单位化故等于带符号的真实距离, 沿法向一侧为正; 过 (0,0,2) 法向 +Z 的平面上, 原点返回 -2。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.平面有向距离 (对象指针, 点X, 点Y, 点Z))
    }

    方法 取距离 <公开 类型 = 小数 注释 = "对应 AcGeSurface::distanceTo(pnt), 无符号距离; 平面未创建返回 NaN。" 注释 = "实测 AcGe25: 与 取有向距离 绝对值相同且恒非负。零法向的退化平面上 取有向距离 给 0、本方法给 NaN, 别拿它们判退化。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.平面距离 (对象指针, 点X, 点Y, 点Z))
    }

    方法 取交点 <公开 类型 = 逻辑型 注释 = "对应 AcGePlane::intersectWith(linearEnt, resultPnt), 写入已创建的 结果 点对象。" 注释 = "对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针, 底层按 AcGeLinearEnt3d 基类引用接收, 两种可混传。" 注释 = "实测 AcGe25: 相交(垂直或斜交)返回真并写入交点; 平行不重合、以及直线整个躺在面内(解有无穷多)都返回假, 这两种情形都不碰 结果, 脏值原样保留。" 注释 = "对方是线段时按端点截断, 且存在返回假却仍写入延长线交点的情形(见 ARX线段3D.取平面交点), 返回假就不要读 结果。对方是射线时同样只按射线自己那一侧算: 实测 射线整条躺在面内、以及射线沿背离面的方向走, 都返回假。">
    参数 对方 <类型 = 变整数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.平面交直线 (对象指针, 对方, 结果.对象指针))
    }

    方法 取交线 <公开 类型 = 逻辑型 注释 = "对应 AcGePlane::intersectWith(otherPlane, resultLine), 交线写入已创建的 ARX直线3D 对象。" 注释 = "结果参数是具体类 AcGeLine3d 引用, 类型固定为 ARX直线3D, 不能传线段。" 注释 = "实测 AcGe25: 相交返回真, 方向是两法向的叉积(已单位化), 正负号由底层定(z=0 与 y=0 得到方向 (-1,0,0)、参考点 (0,0,0)), 不要假定与 取法向 的先后次序有关。平行不重合与两平面完全重合都返回假且不碰 结果。">
    参数 对方 <类型 = ARX平面>
    参数 结果 <类型 = ARX直线3D>
    {
        返回 (ARX几何底层.平面交平面 (对象指针, 对方.对象指针, 结果.对象指针))
    }

    方法 取有界平面交线段 <公开 类型 = 逻辑型 注释 = "对应 AcGePlane::intersectWith(boundedPlane, resultLineSeg), 交线段写入已创建的 ARX线段3D 对象。" 注释 = "实测 AcGe25: 相交返回真, 交线已按 对方 的矩形边界截成一段写入 结果(z=3 的无限面交 矩形片 得 (3,3.5,3)-(1,3.5,3), 与对方 取平面交线段 对同一对对象给出同一组端点); 两平面平行、完全重合、或交线落在对方边界外, 都返回假且不碰 结果, 脏值原样保留。与 取交线 的差别只在结果类型与被截断, 取交线 给的是无限直线。对方若是 创建() 出来的未指定边界缺省片, 本方法返回真但得到零长退化线段。">
    参数 对方 <类型 = ARX有界平面>
