    }

    方法 接收分割片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getSplitCurves(param, piece1, piece2): 把 源曲线 在 分割参数 处切成的两片中的第 片下标 片写进本对象。源曲线 传 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D/ARX射线2D 任一类的 对象指针。" 注释 = "所有权口径: 底层返回 new 出来的 AcGeCurve2d*, 析构非虚, 该句柄一律不出桥 —— 桥内用 type() 还原具体类, 类型与本对象相符才赋值, 随后在桥内释放两片。" 注释 = "实测 AcGe25 且永远如此: 本方法在本类上恒为假 —— 无限直线的两片都是 kRay2d(26), 与本类 18 型不符; 射线片自包十九A 起由 ARX射线2D 接收(实测那张片交给 ARX射线2D 判真)。反方向同样, 把 ARX线段2D 的片(22) 与 ARX射线2D 的片(22/26) 交给本类也都判假, 且被拒后本线的线上点(1,2) 与方向(0,1) 一位不动。射线片仍在桥内按 AcGeRay2d 自己的类型释放, 不泄漏。">
    参数 源曲线 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D分割片进 (源曲线, 分割参数, 片下标, 对象指针))
    }

    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建或 延伸档 不在 0..2, -2 底层抛异常; 其余是片数。0 片是正常返回不是错误 —— 内偏越过临界量就拿不到片。片数配 取裁剪偏移片类型 与 接收裁剪偏移自 逐个使用, 片的句柄不出桥。" 注释 = "实测 AcGe25: 过 (0,0) 方向 (1,0) 的无限直线在 d=+2、-2、+10 三档都只给 1 片, 片自身区间退化成 0..0、长度读 0 与源同规格, 平移量精确 |d| (d=+2 时线上点读成 (0,2)、d=+100 读成 (0,100))。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片数 (源曲线, 偏移距离, 延伸档))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve2d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数, 用来决定该先创建哪一类对象再调 接收裁剪偏移自。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25: 无限直线偏出的片恒为 kLine2d(18) —— 这一点与 分割 通道相反 (getSplitCurves 给出的是射线 kRay2d(26), 只有 ARX射线2D 收得下), 偏移不产生射线, 所以本类收得下自己源的偏移片。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::getTrimmedOffset(distance, pieces, extensionType): 把 源曲线 偏出的第 片下标 片写进本对象。源曲线 传 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D/ARX射线2D 任一类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve2d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。类型不符、该片为空、指针无效都返回假且本对象一位不动。" 注释 = "实测 AcGe25: 本类是 18 片的唯一接收者; 无限直线的偏移片仍是无限直线, 方向不变、只把线上点平移 |d|; 源曲线 换成 ARX射线2D 时只偏出一张片且类型是 26 (与分割通道同一走向), 交给本类判假、本线类型编号原样, 那张片只有 ARX射线2D 收得下。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线2D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 对象指针))
    }

    方法 是否重叠 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::overlap(line, overlap): 判定本直线与 对方 是否有一段实打实的公共部分。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针, 与本类互不限制。" 注释 = "实测 AcGe25: 只有共线(同一条轴上)的两条直线族对象才判真。端点相接、两线段在内部点垂直相交、相交但不共线的两条无限直线、零长线段落在对方身上、平行偏移这五档一律判假; 判假时底层连片也不写, 所以 是否重叠 判假与 取重叠片类型 给 -3 之间没有第三种情况。" 注释 = "本方法只看几何不看方向: 反向参数化的同一条线照样判真 (实测 段 (0,0)-(10,0) 与 段 (10,0)-(0,0) 判真, 无限直线 (0,0)+方向(1,0) 与 (5,0)+方向(-1,0) 判真)。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D重叠 (对象指针, 对方) == 1)
    }

    方法 取重叠片类型 <公开 类型 = 整数 注释 = "对应 AcGeLinearEnt2d::overlap: 只问本直线与 对方 的重叠片是什么类型, 用来在 接收重叠片自 之前先看清底层给了什么。" 注释 = "返回码: -1 本直线未创建或 对方 指针无效, -3 SDK 判无重叠(此时不写片), 其余是片的 AcGe::EntityId。" 注释 = "实测 AcGe25: 本类的重叠片恒为 kLine2d(18) —— 片的类型跟着接收者走, 与对方是直线还是线段无关, 所以本类永远收得下自己的重叠片。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D重叠片型 (对象指针, 对方))
    }

    方法 接收重叠片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::overlap(line, overlap): 把本直线与 对方 的重叠片写回本对象自己。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针, 与本类互不限制。" 注释 = "所有权口径同 接收分割片自: 片是底层 new 出来的 AcGeLinearEnt2d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放该片。" 注释 = "实测 AcGe25: 无限直线收下的片仍是无限直线, 参考点与原始方向复刻本对象, 只有区间被改写成重叠范围在本对象参数空间下的两档。本线过 (5,0) 方向 (-4,0)、对方是 (0,0)-(10,0) 的线段时, 区间读 -1.25..1.25, 求值点(-1.25) 落 (10,0)、求值点(1.25) 落 (0,0); 同一条线参考点取 (0,0)、方向取 (1,0) 时区间读 0..10。" 注释 = "SDK 判假、片为空、类型不符、指针无效都返回假, 且本对象一位不动。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D重叠片收 (对象指针, 对方) == 1)
    }
}

# ===

类 ARX线段2D <公开 注释 = "封装 ObjectARX AcGeLineSeg2d: 二维有限线段, 对应 AutoCAD 的 LINE/多段线一段。" 注释 = "与 ARX直线2D 共用 AcGeLinearEnt2d 的判定接口, 所以 对方 参数类型是 变整数, 传 ARX直线2D 或 ARX线段2D 的 对象指针 均可。" 注释 = "AcGeCurve2d 基类的曲线接口在本类已全部转发(是否过参数、取周期、取参数段长、参数按长度、取面积、到曲线距离、取曲线最近点、反转参数、取退化类型), 但口径与 ARX直线2D 并不相同: 直线不看区间、线段按 0..1 截断, 同一接口在圆弧类上另有自己的读数, 不要用一处的实测值套到另一处。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeLineSeg2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLineSeg2d(), 创建一条零长度缺省线段; 已存在时先释放旧对象。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建线段2D ()
        返回 (对象指针 != 0)
    }

    方法 创建过两点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLineSeg2d(startPoint, endPoint), 第一点是起点。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建线段2D过两点 (甲X, 甲Y, 乙X, 乙Y)
        返回 (对象指针 != 0)
    }

    方法 创建按方向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLineSeg2d(pnt, vec): 起点是 pnt, 终点是 pnt + vec, 向量长度直接决定段长。">
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建线段2D方向 (起点X, 起点Y, 方向X, 方向Y)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeLineSeg2d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放线段2D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "本线段是目标, 参数 源 是数据来源且必须已创建。">
    参数 源 <类型 = ARX线段2D>
    {
        返回 (ARX几何底层.线段2D复制 (对象指针, 源.对象指针))
    }

    方法 设置 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg2d::set(pnt, vec), 起点为 pnt, 终点为 pnt + vec。">
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    {
        返回 (ARX几何底层.线段2D设置 (对象指针, 起点X, 起点Y, 方向X, 方向Y))
    }

    方法 设过两点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg2d::set(pnt1, pnt2)。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    {
        返回 (ARX几何底层.线段2D设过两点 (对象指针, 甲X, 甲Y, 乙X, 乙Y))
    }

    方法 取起点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg2d::startPoint。">
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.线段2D起点 (对象指针, 结果.对象指针))
    }

    方法 取中点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg2d::midPoint, 即参数区间的中心。">
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.线段2D中点 (对象指针, 结果.对象指针))
    }

    方法 取终点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg2d::endPoint。">
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.线段2D终点 (对象指针, 结果.对象指针))
    }

    方法 取长度 <公开 类型 = 小数 注释 = "对应 AcGeLineSeg2d::length, 线段自身的欧氏长度, 与继承自 AcGeCurve2d 的按参数求长是两回事。">
    {
        返回 (ARX几何底层.线段2D长度 (对象指针))
    }

    方法 取参数段长 <公开 类型 = 小数 注释 = "对应 AcGeLineSeg2d::length(fromParam, toParam), 按参数区间求弧长, 使用底层缺省容差。">
    参数 起参数 <类型 = 小数>
    参数 止参数 <类型 = 小数>
    {
        返回 (ARX几何底层.线段2D区间长度 (对象指针, 起参数, 止参数))
    }

    方法 取分点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg2d::baryComb(blendCoeff), 端点的重心组合: 系数 0 得起点, 1 得终点, 0.5 得中点。" 注释 = "实测 AcGe25: 系数不受 0..1 限制, 2 会外插到终点之外, 且与 求值点(同一数值) 结果一致, 因为线段的参数区间本身就是 0..1。">
    参数 系数 <类型 = 小数>
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.线段2D分点 (对象指针, 系数, 结果.对象指针))
    }

    方法 取平分线 <公开 类型 = 逻辑型 注释 = "对应 AcGeLineSeg2d::getBisector(AcGeLine2d&), 把线段的垂直平分线写入已创建的 结果 直线对象。" 注释 = "实测 AcGe25: 结果直线过线段中点且与线段垂直, 方向是线段方向左转 90 度(段方向 (0.6,0.8) 得 (-0.8,0.6))。输出类型被底层签名固定为 AcGeLine2d, 不能传线段。">
    参数 结果 <类型 = ARX直线2D>
    {
        返回 (ARX几何底层.线段2D平分线 (对象指针, 结果.对象指针))
    }

    方法 转为直线 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::isLinear(AcGeLine2d&): 判定该曲线是否落在一条直线上, 同时把承载直线写入 结果。线段返回真, 结果直线与线段共线。" 注释 = "实测 AcGe25: 承载直线的参考点就是线段起点, 方向已单位化, 参数区间退化为 0..0, 因此它是无限直线, 长度信息只保留在线段自己身上。">
    参数 结果 <类型 = ARX直线2D>
    {
        返回 (ARX几何底层.线性2D是直线 (对象指针, 结果.对象指针))
    }

    方法 反转参数 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve2d::reverseParam, 就地翻转参数化方向, 会改变起点/终点的对应关系。" 注释 = "实测 AcGe25: 反转后 取起点 得到原终点, 原起点的 取参数 由 0 变 1, 长度与中点不变, 区间仍报告 0..1。句柄无效时返回假。">
    {
        返回 (ARX几何底层.线性2D反转参数 (对象指针))
    }

    方法 取线上点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::pointOnLine(基类实现)。" 注释 = "实测 AcGe25: 线段返回的参考点就是起点, 与 取起点 一致; 需要中点或终点请改用 取中点/取终点。">
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.线性2D线上点 (对象指针, 结果.对象指针))
    }

    方法 取方向 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::direction, 单位方向向量写入已创建的 结果。">
    参数 结果 <类型 = ARX向量2D>
    {
        返回 (ARX几何底层.线性2D方向 (对象指针, 结果.对象指针))
    }

    方法 是否平行 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::isParallelTo。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D平行 (对象指针, 对方))
    }

    方法 是否垂直 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::isPerpendicularTo。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D垂直 (对象指针, 对方))
    }

    方法 是否共线 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::isColinearTo。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针。" 注释 = "共线只看所在直线, 两段互不重叠的共线线段同样返回真。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D共线 (对象指针, 对方))
    }

    方法 近似等于 <公开 类型 = 逻辑型 注释 = "对应 AcGeEntity2d::isEqualTo(other)。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针。" 注释 = "实测 AcGe25: 比较的是参数化而非所在直线。两条全等线段判真; 端点顺序互换(反向参数化)、同起点但长度不同, 都判假; 与 ARX直线2D 跨类型比较双向都判假。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性2D近似相等 (对象指针, 对方))
    }

    方法 取交点 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt2d::intersectWith(line, intPnt)。对方 传 ARX直线2D、ARX线段2D 或 ARX射线2D 的 对象指针。" 注释 = "实测 AcGe25: 判定按各自自身的参数范围截断, 不是按所在的无限直线。两线段只有真正相交(含端点相接)才返回真; 所在直线相交但线段错开、共线重叠或共线包含, 一律返回假。与无限直线求交同样要求交点落在线段范围内。返回假时 结果 点保持调用方原值。">
    参数 对方 <类型 = 变整数>
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.线性2D求交 (对象指针, 对方, 结果.对象指针))
