    }

    方法 取参数 <公开 类型 = 逻辑型 注释 = "对应 AcGeSurface::paramOf(pnt), 结果写入调用方已创建的 ARX点2D 对象。" 注释 = "实测 AcGe25: 参数域是以原点为 (0,0)、两条原始边界向量为边的 [0,1]x[0,1] —— 矩形片 的右上角 (3,5,3) 得 (1,1), 中心 (2,3.5,3) 得 (0.5,0.5); 非正交轴也按原始向量解(u=(2,0,0)、v=(1,1,0) 时 (3,1,0) 得 (1,1))。" 注释 = "参数不看边界也不夹不判假: 单位方片 上界外点 (10,10,0) 仍返回真并给 (10,10)。参数也不看 反转法向。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.平面参数 (对象指针, 点X, 点Y, 点Z, 结果.对象指针))
    }

    方法 取参数点 <公开 类型 = 逻辑型 注释 = "对应 AcGeSurface::evalPoint(param), 把二维参数换算回三维点, 写入已创建的 结果 点对象。" 注释 = "实测 AcGe25: 与 取参数 同一套参数域, (0,0) 得原点角、(1,0)/(0,1)/(1,1) 得另外三个角(矩形片 依次 (1,2,3)、(3,2,3)、(1,5,3)、(3,5,3))。不限制在 0..1, (2,0) 外推到 (5,2,3)。">
