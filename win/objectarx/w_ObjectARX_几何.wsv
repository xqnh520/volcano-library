    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 在 法向 所指平面内偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2 或 法向三分量全为 0 (库层挡下, 一次都不调底层 —— 实测零法向底层不报错, 而是吐出一片无人可收的 kCompositeCrv3d(47), 区间还会从源的 0..π/2 读成 0..3π/2), -2 底层抛异常; 其余是片数, 0 片是正常返回不是错误。" 注释 = "实测 AcGe25: 长半轴 3、短半轴 2 的整椭圆对法向 (0,0,1), 外偏 d=-2 与小内偏 d=+0.5 各给 1 片 (片长 28.4318102037522 / 12.7238469359349), 内偏越过短半轴 (d=+2) 给 0 片。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片数 (源曲线, 偏移距离, 延伸档, 法向X, 法向Y, 法向Z))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、法向三分量全为 0 (库层挡下)、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25 且永远如此: 片是 kOffsetCurve3d(64), 不是任何叶类型。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 把 源曲线 在 法向 所指平面内偏出的第 片下标 片写进本对象。源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D 任一类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve3d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。法向三分量全为 0 时库层直接判假且不调底层。" 注释 = "实测 AcGe25 且永远如此: 本方法在本类上恒为假 —— 64 的片四个三维曲线类全都拒收; 片在桥内按 AcGeOffsetCurve3d 自己的类型释放, 不泄漏。恒假由几何内核断言钉住。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z, 对象指针))
    }
}

# ===

类 ARX包围块2D <公开 注释 = "封装 ObjectARX AcGeBoundBlock2d: 二维平行四边形包围块, 由 基点 + 向一 + 向二 参数化, 是 AcGeCurve2d::boundBlock / orthoBoundBlock 的返回类型。" 注释 = "使用前必须调用 创建(或 创建过两点 / 创建基向 / 接收包围块自 之一), 使用完毕后调用 释放 归还底层对象。" 注释 = "实测 AcGe25 三条口径, 用的时候要记住: (1) isBox 与 type() 都是实例自己的状态, 不反映来历 —— 缺省构造与基点向量化构造即便方向正好轴对齐, isBox 仍为假; 点点对构造和 set(点,点) 为真; 曲线送来的块只有 orthoBoundBlock 和退化块(min==max)为真, 普通 boundBlock 为假; 拷贝赋值连 type() 一起搬, 所以手工构造的块是 61, 曲线送来的块是 62。 (2) contains 是在 (基点, 向一, 向二) 参数空间里做闭区间判定, 不是几何包含: 斜的 boundBlock 会漏掉真在它平行四边形内部的点, 也会收进不在其内的点。要几何判定请先用 取低高点 拿轴对齐包络。 (3) extend 按 isBox 标志选算法: 标志为真时逐分量取包络、不换边; 标志为假时会重排甚至改写 向一/向二, 结果可能超出期望。需要可预测的扩展就先 设为盒(真), 但注意那只是翻标志, 不改几何。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeBoundBlock2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundBlock2d(), 缺省构造。已存在时先释放旧对象。" 注释 = "实测: 缺省构造的块 isBox 为假。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放包围块2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建包围块2D ()
        返回 (对象指针 != 0)
    }

    方法 创建过两点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundBlock2d(point1, point2), 两点按分量归一化取对角, 先后顺序无关。已存在时先释放旧对象。" 注释 = "实测: 这样构造出的块 isBox 为真。">
    参数 X一 <类型 = 小数>
    参数 Y一 <类型 = 小数>
    参数 X二 <类型 = 小数>
    参数 Y二 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放包围块2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建包围块2D过两点 (X一, Y一, X二, Y二)
        返回 (对象指针 != 0)
    }

    方法 创建基向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundBlock2d(base, dir1, dir2), 平行四边形参数化构造。已存在时先释放旧对象。" 注释 = "实测: 这样构造出的块 isBox 恒为假, 即使三个向量正好轴对齐也不变。">
    参数 基X <类型 = 小数>
    参数 基Y <类型 = 小数>
    参数 向一X <类型 = 小数>
    参数 向一Y <类型 = 小数>
    参数 向二X <类型 = 小数>
    参数 向二Y <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放包围块2D (对象指针)
