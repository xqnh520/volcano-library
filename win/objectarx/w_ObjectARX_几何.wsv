# ===

类 ARX点实体3D <公开 注释 = "封装 ObjectARX AcGePosition3d: 三维点实体, 继承链 AcGePosition3d -> AcGePointEnt3d -> AcGeEntity3d, 底层类型编号 5 (AcGe::kPosition3d)。" 注释 = "本类是为了接住投影退化成点的那个像而存在的: 曲线垂直于投影面时 project / orthoProject 返回的不是 AcGePoint3d 而是这个点实体。ARX点3D 封的 AcGePoint3d 并不继承 AcGeEntity3d, 当不了投影接收者, 拿它接会得到类型编号 5 与它不符; 想把落点取回来就用本类 接收…投影自, 再用 取坐标 交回 ARX点3D。" 注释 = "使用前必须调用 创建 或 创建过点, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGePosition3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGePosition3d(), 创建一个缺省点实体; 已存在时先释放旧对象。" 注释 = "实测 AcGe25: 缺省点实体落在 (0,0,0), 取类型编号 5, 不是未初始化垃圾。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点实体3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点实体3D ()
        返回 (对象指针 != 0)
    }

    方法 创建过点 <公开 类型 = 逻辑型 注释 = "对应 new AcGePosition3d(x, y, z), 按坐标创建; 已存在时先释放旧对象。">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点实体3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点实体3D过点 (X, Y, Z)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGePosition3d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点实体3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 取类型编号 <公开 类型 = 整数 注释 = "对应 AcGeEntity3d::type(), 本类对象的编号。句柄未创建返回 -1。" 注释 = "实测 AcGe25: 创建 与 创建过点 得到的对象都是 5 (AcGe::kPosition3d), 与投影退化成点时 取正投影类型 报的 5 同一个值, 这也是判断该用哪一类接收者的依据。">
    {
        返回 (ARX几何底层.点实体3D类型编号 (对象指针))
    }

    方法 取坐标 <公开 类型 = 逻辑型 注释 = "对应 AcGePointEnt3d::point3d(): 把本点实体的坐标复制进已创建的 点。本方法只读不写本对象。" 注释 = "实测 AcGe25: 本对象未创建、点 未创建都返回假且不碰 点; 正常复制后 点 的三分量与本对象逐位相同。">
    参数 点 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.点实体3D取点 (对象指针, 点.对象指针))
    }

    方法 取斜投影类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::project(plane, direction) 的类型查询, 与 ARX直线3D.取斜投影类型 走同一个底层函数、同一套返回码(-1 句柄无效, -2 抛异常, -3 空指针, -4 方向与平面平行或零向量)。" 注释 = "本类的特别之处只在于: 它是库里唯一能接住返回 5 (点实体) 的接收类, 其余四类见到 5 都判假。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D投影类型 (源曲线, 投影平面.对象指针, 方向X, 方向Y, 方向Z, 假))
    }

    方法 取正投影类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::orthoProject(plane) 的类型查询, 返回码口径同 取斜投影类型, 只是 -4 永不触发。" 注释 = "实测 AcGe25: 直线垂直于投影面时这里给 5, 那个像就是本类要接的东西。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.曲线3D投影类型 (源曲线, 投影平面.对象指针, 0.0, 0.0, 0.0, 真))
    }

    方法 接收斜投影自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::project(plane, direction): 把 源曲线 沿 方向 斜投影到 投影平面, 结果写进本对象。源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D/ARX射线3D 任一类的 对象指针。" 注释 = "所有权口径: 底层返回 new 出来的 AcGeEntity3d*, 析构非虚, 该句柄一律不出桥 —— 桥内用 type() 还原具体类, 类型与本对象相符才赋值, 随后在桥内释放。" 注释 = "与其余五类同一套失败口径: 只有投影结果的类型编号是 5 时本方法才返回真 (实测 源曲线 给 ARX射线3D 时像是 27 型, 本类判假且本对象不动); 像仍是直线/线段/圆弧/椭圆弧、投影方向与平面平行或给零向量(-4)、任一对象未创建, 都返回假且本对象内容一位不动。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D投影进 (源曲线, 投影平面.对象指针, 方向X, 方向Y, 方向Z, 假, 对象指针))
    }

    方法 接收正投影自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::orthoProject(plane): 沿 投影平面 法向把 源曲线 正投影进本对象, 所有权与失败口径同 接收斜投影自。" 注释 = "实测 AcGe25: 垂线 (2,3,0)-(2,3,10) 正投影到 XY 得到落点 (2,3,0); 平行于投影方向的直线 (1,1,0)-(4,4,3) 沿 (1,1,1) 斜投影得到落点 (1,1,0) —— 这两条就是四类三维曲线接不住、必须由本类接的那两个像。" 注释 = "实测 AcGe25: 一般斜线 (1,2,3)-(4,5,6) 给 19、法向 (0,1,1) 的斜整圆给 17、零长线段给 23, 本方法对这三个源一律判假, 且本对象原值一位不动(脏值 (7,8,9) 保持)。">
    参数 源曲线 <类型 = 变整数>
    参数 投影平面 <类型 = ARX平面>
    {
        返回 (ARX几何底层.曲线3D投影进 (源曲线, 投影平面.对象指针, 0.0, 0.0, 0.0, 真, 对象指针))
    }
}

