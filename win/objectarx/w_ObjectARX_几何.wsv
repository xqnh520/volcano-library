    方法 取承载平面 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::isPlanar(plane), 把承载平面写入已创建的 结果。平面 是出参不是入参, 与 ARX直线3D.是否落在平面 那个把平面当入参的重载不同。" 注释 = "实测 AcGe25 恒真: 六个三维源上全回真 —— 偏移曲线的源本身是平面曲线, 偏移又限制在 法向 所指平面内, 所以结果一定躺在某个平面里。句柄无效或 结果 未创建回假。">
    参数 结果 <类型 = ARX平面>
    {
        返回 (ARX几何底层.曲线3D转平面 (对象指针, 结果.对象指针))
    }

    方法 反转参数 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::reverseParam。" 注释 = "实测口径同二维侧: 回真而区间与求值看不出变化。">
    {
        返回 (ARX几何底层.曲线3D反向 (对象指针))
    }

    方法 取退化类型 <公开 类型 = 整数 注释 = "对应 AcGeCurve3d::isDegenerate(degenerateType), 句柄无效或底层判为不退化时返回 -1。" 注释 = "实测 AcGe25 恒 -1: 六个三维源全 -1, 连零长线段源(它自己退化成点)也报 -1 —— 这一档在偏移曲线上不反映源的退化。">
    {
        返回 ARX几何底层.曲线3D退化类型 (对象指针)
    }

    方法 取样点数 <公开 类型 = 整数 注释 = "对应 AcGeCurve3d::getSamplePoints(numSample, points), 返回底层实际给出的点数; 曲线未创建或 取样个数 非正返回 0。" 注释 = "实测 AcGe25 在 取样个数 = 5 下: 线段源与 90 度弧源给 5; 整圆源、整椭源、零长线段源、无限直线源都给 4 —— 与二维同一条口径。">
    参数 取样个数 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D取样点数 (对象指针, 取样个数))
    }

    方法 取样点 <公开 类型 = 逻辑型 注释 = "按下标 序号 取一个取样点写入已创建的 结果, 合法下标 0 到 取样点数-1; 序号越界、曲线未创建、结果未创建或 取样个数 非正返回假且不碰 结果。" 注释 = "取样点在自身参数区间内等步长铺开, 闭合曲线丢掉与起点重合的末点, 口径同二维侧 ARX偏移曲线2D.取样点。">
    参数 取样个数 <类型 = 整数>
    参数 序号 <类型 = 整数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.曲线3D取样点 (对象指针, 取样个数, 序号, 结果.对象指针))
    }

    方法 取分割片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getSplitCurves: 类方法(不需要接收者), 只问把 源曲线 在 分割参数 处切开后 片下标 (0 为首片、1 为末片) 那片的具体类型, 返回 AcGe::EntityId 整数, 用于决定该先创建哪一类对象再调 接收分割片自。" 注释 = "返回码: -1 源曲线未创建或 片下标 不是 0/1, -2 底层抛异常, -3 底层把该片给成空指针, 其余为该片的 AcGe::EntityId。" 注释 = "实测 AcGe25: 源是偏移曲线时两片恒为 64 —— 偏移曲线的片又是一条偏移曲线, 八个叶类全都拒收, 只有本类收得下。">
    参数 源曲线 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D分割片类型 (源曲线, 分割参数, 片下标))
    }

    方法 接收分割片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getSplitCurves(param, piece1, piece2): 把 源曲线 在 分割参数 处切成的两片中的第 片下标 片写进本对象。源曲线 传任一三维曲线类或本类的 对象指针。" 注释 = "所有权口径: 片是底层 new 出来的 AcGeCurve3d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放两片。本类收到 64 片时走的是与 复制自 完全相同的通道: 桥内按型新建一份私有副本, 再搬 偏移距离、法向 与区间, 所以两片各需要一个本类对象来接、各自 释放。" 注释 = "实测 AcGe25: 偏移曲线切出来的两片都是 64(见 取分割片类型), 因此本方法是 64 片的唯一接收者; 源是叶曲线时片是叶型, 交给本类判假且本对象一位不动。">
    参数 源曲线 <类型 = 变整数>
    参数 分割参数 <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D分割片进 (源曲线, 分割参数, 片下标, 对象指针))
    }

    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 在 法向 所指平面内偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2 或 法向三分量全为 0 (库层挡下, 一次都不调底层), -2 底层抛异常; 其余是片数, 0 片是正常返回不是错误。" 注释 = "实测口径与八个叶类同一套: 法向不需要单位化, 零法向被库层挡成 -1。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片数 (源曲线, 偏移距离, 延伸档, 法向X, 法向Y, 法向Z))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、法向三分量全为 0(库层挡下)、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25: 偏移曲线偏出来的片仍是 64, 又是一条偏移曲线。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 把 源曲线 在 法向 所指平面内偏出的第 片下标 片写进本对象。源曲线 传任一三维曲线类或本类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve3d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。法向三分量全为 0 时库层直接判假且不调底层; 类型不符、该片为空、指针无效都返回假且本对象一位不动。" 注释 = "包十一当年这一档在偏移曲线位置是恒假的(64 片无人可收), 包十七补上 ARX偏移曲线3D 之后本类成了 64 片的接收者; 收进来的仍是桥内新造的私有副本, 与 复制自 同一条通道。" 注释 = "两条硬前提(实测与二维同口径): 一、本对象必须已创建还活着 —— 从未创建时本方法回假且 对象指针 仍是 0、是否有效 也回假; 二、片下标 越界时同样回假, 但活接收者的句柄、有效旗标与 取偏移距离 一位不动。" 注释 = "收进来以后 取偏移距离 读的是相对最初源曲线的累计值: 甲3=offset(圆3,法向z,+2) 已内偏到半径 3, 它的裁偏片再内偏 2 那片 距 读 4、半径 1、长回到整圈 2π。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z, 对象指针))
    }

    方法 近似等于 <公开 类型 = 逻辑型 注释 = "对应 AcGeEntity3d::isEqualTo(other), 使用继承来的缺省容差口径。" 注释 = "实测 AcGe25: 与源曲线比假, 与自己比也假, 把 偏移距离 设成 0(此时曲线与源逐位重合、到曲线距离 读 0)仍判假; 句柄无效或对方句柄无效同样假。要判两条偏移曲线是否同一状态, 请自己比 取源类型编号、取偏移距离、取法向 与几个曲线族读数。" 注释 = "三维侧唯一为真的比对法(实测): 分割片对父曲线答真 —— 乙3=甲3 的首片与 丙3=甲3 的末片 对 甲3 都回真; 而裁偏片(偏移距离 已累计成 4、半径变了)对 甲3 判假。二维同一个首片对父曲线判假, 两侧不同, 别照抄。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.曲线3D近似相等 (对象指针, 对方))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeOffsetCurve3d), 用于校验结构内存布局。" 注释 = "实测 AcGe25: 16 字节, 与二维侧同宽 —— 法向与源曲线那份私有副本都挂在 pImpl 上, 这个尺寸判不出对象里有没有源。">
    {
        返回 (ARX几何底层.偏移曲线3D结构尺寸 ())
    }
}

# ===

类 ARX区间 <公开 注释 = "封装 ObjectARX AcGeInterval: 一维参数区间, 自带容差, 是十二条曲线 取区间下限 与 取区间上限 背后那个对象。" 注释 = "使用前必须调用 创建 六档之一(创建 / 创建容差 / 创建界 / 创建界容差 / 创建半界 / 创建半界容差), 使用完毕后调用 释放 归还底层对象。" 注释 = "结构实测 AcGe25: sizeof(AcGeInterval) = 16, 只有 mpImpInt 与 mDelInt 两个成员, 界值与容差全挂在 pImpl 上, 所以拷贝构造与赋值是真值语义 —— 改副本的上限、改副本的容差、副本走无参 set 都不带动原件, 半无界副本补上界不把有界性串回原件, 释放副本原件完好, 自赋值安全。" 注释 = "本类不提供 取类型编号: AcGeInterval 没有 type() 方法, ObjectARX 2026 的 AcGe::ValueType 枚举(CDROM1/inc/gegblge.h 第 40 到 109 行)里也没有区间条目 —— 它不在 AcGeEntity 与 AcGeCurve 的继承链上。" 注释 = "形状只能问五个判据, 不能从界值猜: 创建半界(真, 2.0) 与 创建界(2.0, 2.0) 的 取区间下限 与 取区间上限 都读 2.0, 但 是否相等 判假、是否单点 也只对后者答真; 两条路造出来的同一个半无界件反而判等, 说明比的是状态不是出身。" 注释 = "取区间下限 与 取区间上限 无条件原样报底层值, 不置非数也不报错: 无界件两侧都读 0, 半无界件读 0 与 界值, 反序件照读原值。所以两侧同值不等于单点, 必须问判据。" 注释 = "取区间长度 允许为负: 反序件 创建界(9.0, 5.0) 读 -4、创建界(5.0, 2.0) 读 -3, 底层不回正。更要记住它会跟无界件的 -1 撞车 —— 创建界(2.0, 1.0) 的长度是 -1, 缺省无界件的长度也是 -1, 判形状一律用 是否无界。" 注释 = "本类只出 是否相等 与 是否不等 两个关系判据。SDK 的 小于 / 小于等于 / 大于 / 大于等于 一族十二个运算符在 AcGe25 上全部不可用, 永久不封: 区间对区间任何一档都读假, 连 甲 小于等于 甲 与 甲 大于等于 甲 都假; 区间对小数只比一端, 上限档只问 上限 加 容差、下限档只问 下限 减 容差 —— 2.5 落在 1..3 中间时对 大于 与 小于 双假, 而 3.4 对 大于 假、对 大于等于 真。" 注释 = "编辑族四条(求并 / 接收差片段 / 求交 / 求上侧重叠)的结果件必须是已创建的 ARX区间; 库层在调底层之前先把结果件 设无界 洗一遍, 好让 没写 这件事读得出来 —— 求差与求上侧重叠判假时底层确实一个字都不写, 但求交判假时底层仍会把结果件改成反序垃圾件, 复位挡不住, 所以求交只信返回码。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeInterval 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeInterval(), 容差走 SDK 缺省。已存在时先释放旧对象。" 注释 = "实测: 造出来是无界件 —— 两侧界值都 0、容差 1e-12、取区间长度 -1, 五个形状判据里只有 是否无界 答真; 两个只差容差的无界件照样判等。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.区间释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.区间新建 ()
        返回 (对象指针 != 0)
    }

    方法 创建容差 <公开 类型 = 逻辑型 注释 = "对应 new AcGeInterval(tol), 只换容差不换形状。已存在时先释放旧对象。" 注释 = "实测: 容差 0.5 的缺省件仍是 0..0 无界, 取区间长度 -1。">
    参数 容差 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.区间释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.区间新建容差 (容差)
        返回 (对象指针 != 0)
    }

    方法 创建界 <公开 类型 = 逻辑型 注释 = "对应 new AcGeInterval(lower, upper), 容差走 SDK 缺省。已存在时先释放旧对象。" 注释 = "实测: 1..3 读 下限1 上限3 长度2, 是否有界 与 是否有上界 与 是否有下界 全真、是否无界 与 是否单点 假; 反序 5..2 照收不误, 长度 -3; 两侧同值 2..2 时 是否单点 答真。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.区间释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.区间新建界 (下限, 上限)
        返回 (对象指针 != 0)
    }

    方法 创建界容差 <公开 类型 = 逻辑型 注释 = "对应 new AcGeInterval(lower, upper, tol)。已存在时先释放旧对象。" 注释 = "实测: 跨度 1e-13 配容差 1e-12 会判成单点, 同一跨度配容差 1e-20 判成普通闭区间, 而两件的界值读数一模一样 —— 是否单点 看的是 跨度 与 容差 的关系。">
    参数 下限 <类型 = 小数>
    参数 上限 <类型 = 小数>
    参数 容差 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.区间释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.区间新建界容差 (下限, 上限, 容差)
        返回 (对象指针 != 0)
    }

    方法 创建半界 <公开 类型 = 逻辑型 注释 = "对应 new AcGeInterval(boundedBelow, bound), 容差走 SDK 缺省; 下有界 真 = 封下端开上端, 假 = 开下端封上端。已存在时先释放旧对象。" 注释 = "实测: 构造只写封闭那一侧 —— 真 档读 下限2 长度-1, 假 档读 上限2 元素2 长度-1, 五个形状判据两档都恒确定(各自只有那一侧的 是否有界 答真)。开口那一侧的原始读数不初始化: 同一个 假 档换一个新对象, 下限实测读到过 0、1、2、3 四种值, 全看堆位残渣, 不许拿它判形状。">
    参数 下有界 <类型 = 逻辑型>
    参数 界值 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.区间释放 (对象指针)
            对象指针 = 0
        }
        如果 (下有界)
        {
            对象指针 = ARX几何底层.区间新建半界 (1, 界值)
            返回 (对象指针 != 0)
        }
        对象指针 = ARX几何底层.区间新建半界 (0, 界值)
        返回 (对象指针 != 0)
    }

    方法 创建半界容差 <公开 类型 = 逻辑型 注释 = "对应 new AcGeInterval(boundedBelow, bound, tol)。已存在时先释放旧对象。" 注释 = "口径与 创建半界 完全同档, 只是容差换成给定值: 真 档读 下限2 长度-1 容差0.5, 假 档读 上限2 元素2 长度-1 容差0.5, 形状判据两边都恒确定。开口那一侧同样不初始化, 下限读数随堆位变, 与两参档一样不许断言。">
    参数 下有界 <类型 = 逻辑型>
    参数 界值 <类型 = 小数>
    参数 容差 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.区间释放 (对象指针)
            对象指针 = 0
        }
        如果 (下有界)
        {
            对象指针 = ARX几何底层.区间新建半界容差 (1, 界值, 容差)
            返回 (对象指针 != 0)
        }
        对象指针 = ARX几何底层.区间新建半界容差 (0, 界值, 容差)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeInterval 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.区间释放 (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "对应 operator=(const AcGeInterval&), 源对象与本对象都必须已创建。" 注释 = "实测: 真值语义 —— 1..3 容差0.5 赋进一个无界件后逐位相同且 是否相等 判真; 之后改赋值件的下限为 -4, 原件不动; 自己赋自己也安全。源句柄无效或本句柄无效回假。">
    参数 源 <类型 = ARX区间>
    {
        返回 (ARX几何底层.区间复制 (对象指针, 源.对象指针))
    }

    方法 取区间下限 <公开 类型 = 小数 注释 = "对应 lowerBound(); 句柄无效返回非数。" 注释 = "实测原样报值不置哨兵: 无界件 0, 半无界(真,2.0) 读 2, 反序件 9..5 读 9。但开口那一侧的底层槽不初始化 —— 原生 半无界(假,2.0) 的下限实测读到过 0、1、2、3, 随堆位变, 只有用 设上限 / 设区间 显式写过的件才读得出确定的 0。两侧读数一律不能判形状。">
    {
        返回 (ARX几何底层.区间下限 (对象指针))
    }

    方法 取区间上限 <公开 类型 = 小数 注释 = "对应 upperBound(); 句柄无效返回非数。" 注释 = "实测: 整圆灌进来的区间读 6.283185307179586, 无限直线读 0, 半无界(真,2.0)读 2, 反序件 9..5 读 5。半无界(真,2.0) 这一档试了几块新堆位都读到界值, 但它处在开口那一侧, 与 取区间下限 的 假 档同险, 别把它当可靠依据。">
    {
        返回 (ARX几何底层.区间上限 (对象指针))
    }

    方法 取区间元素 <公开 类型 = 小数 注释 = "对应 element(); 句柄无效返回非数。" 注释 = "实测每一件都读出 上限 的值, 包括反序件 —— 9..5 读 5、1..3 读 3、无界件读 0, 它不是两侧绝对值取大, 名字里的 largest 不成立。">
    {
        返回 (ARX几何底层.区间元素 (对象指针))
    }

    方法 取区间长度 <公开 类型 = 小数 注释 = "对应 length(); 句柄无效返回非数。" 注释 = "实测: 1..3 读 2; 反序件读负数, 9..5 读 -4; 无界件与半无界件读 -1; 跨度不大于容差的单点件读 0 —— 1..3 把容差设成 7 之后这里回 0 而不是 2。因为 -1 既是无界件的读数也是反序件的读数, 本方法不能用来判形状。">
    {
        返回 (ARX几何底层.区间长度 (对象指针))
    }

    方法 取区间容差 <公开 类型 = 小数 注释 = "对应 tolerance(); 句柄无效返回非数。" 注释 = "实测: 只有 创建容差 / 创建界容差 / 创建半界容差 / 设容差 四条会动它, 界值一族(set / setUpper / setLower / 无参 set)全程保持原值。四条编辑入口里只有 求并 会改写结果件的容差并且取的是左件那一份, 求交 / 接收差片段 / 求上侧重叠 都保留结果件自己原有的容差。">
    {
