    }
}

# ===

类 ARX圆弧3D <公开 注释 = "封装 ObjectARX AcGeCircArc3d: 三维空间中的圆弧(含整圆), 由圆心、法向、参考向量、半径和起止角定义。" 注释 = "本类同时把继承自 AcGeCurve3d/AcGeEntity3d 的通用曲线接口一并暴露出来, 参数类型是 变整数 的方法可以接收 ARX直线3D/ARX线段3D/ARX圆弧3D 的 对象指针。" 注释 = "与二维侧 ARX圆弧2D 的接口差异: 一、没有 取余弧、设参考向量、按凸度 三组接口, 3D 用 设轴 一次改写法向与参考向量。二、多出 取平面交点、取投影交点、取平面最近点、与对方共面、取承载平面 五个三维特有接口。三、构造与 set 的可行性检查只有 创建过三点错误 与 取切线错误码 两处。" 注释 = "使用前必须调用 创建 或任一 创建XX, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeCircArc3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeCircArc3d(), 创建缺省圆弧; 已存在时先释放旧对象。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放圆弧3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建圆弧3D ()
        返回 (对象指针 != 0)
    }

    方法 创建圆 <公开 类型 = 逻辑型 注释 = "对应 new AcGeCircArc3d(cent, nrm, radius), 起止角取缺省值即整圆。" 注释 = "法向决定圆弧所在平面的朝向, 零向量不会被底层拦下, 调用方应自行保证非零。">
