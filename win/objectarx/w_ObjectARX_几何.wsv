    }

    方法 取终止角 <公开 类型 = 小数 注释 = "对应 AcGeEllipArc3d::endAng。">
    {
        返回 (ARX几何底层.椭圆弧3D终止角 (对象指针))
    }

    方法 取弧起点 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::startPoint, 注意与继承的 是否有起点 是两套口径。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.椭圆弧3D起点 (对象指针, 结果.对象指针))
    }

    方法 取弧终点 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::endPoint。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.椭圆弧3D终点 (对象指针, 结果.对象指针))
    }

    方法 取所在平面 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::getPlane, 把椭圆弧承载平面写入已创建的 结果 平面对象。" 注释 = "与继承来的 取承载平面 分开: getPlane 无返回值恒成功, isPlanar 是判定接口。">
    参数 结果 <类型 = ARX平面>
    {
        返回 (ARX几何底层.椭圆弧3D所在平面 (对象指针, 结果.对象指针))
    }

    方法 是否圆形 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::isCircular(), 用进程级缺省容差判长半径与短半径是否够接近。">
    {
        返回 (ARX几何底层.椭圆弧3D圆形 (对象指针))
    }

    方法 是否圆形容差 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::isCircular(tol), 容差 作为 AcGeTol 的向量容差分量传入。">
    参数 容差 <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D圆形容差 (对象指针, 容差))
    }

    方法 是否内含点 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::isInside(pnt), 头文件注明按整椭圆判定, 不看起止角。" 注释 = "实测 AcGe25: 先看是否落在法向平面内, 平面外点一律判假; 平面内按整椭圆算而不看起止角, 边界点判假。">
    参数 点X <类型 = 小数>
    参数 点Y <类型 = 小数>
    参数 点Z <类型 = 小数>
    {
        返回 (ARX几何底层.椭圆弧3D内含 (对象指针, 点X, 点Y, 点Z))
    }

    方法 取直线交点 <公开 类型 = 整数 注释 = "对应 AcGeEllipArc3d::intersectWith(line, intn, p1, p2), 返回交点个数, -1 表示底层判假或句柄无效。对方 可传 ARX直线3D 或 ARX线段3D 的 对象指针。" 注释 = "实测 AcGe25: 判 -1 时完全不碰出参; 对方是线段时按端点截断。">
    参数 对方 <类型 = 变整数>
    参数 点一 <类型 = ARX点3D>
    参数 点二 <类型 = ARX点3D>
    {
        返回 ARX几何底层.椭圆弧3D交直线 (对象指针, 对方, 点一.对象指针, 点二.对象指针)
    }

    方法 取平面交点 <公开 类型 = 整数 注释 = "对应 AcGeEllipArc3d::intersectWith(planarEnt, intn, p1, p2), 返回交点个数, -1 表示底层判假或句柄无效。二维侧没有该接口。" 注释 = "实测 AcGe25: 与自身所在平面重合或平行的平面一律判 -1, 只有割平面才给交点。">
    参数 平面 <类型 = ARX平面>
    参数 点一 <类型 = ARX点3D>
    参数 点二 <类型 = ARX点3D>
    {
        返回 ARX几何底层.椭圆弧3D交平面 (对象指针, 平面.对象指针, 点一.对象指针, 点二.对象指针)
    }

    方法 取投影交点 <公开 类型 = 整数 注释 = "对应 AcGeEllipArc3d::projIntersectWith(line, projDir, numInt, pntOnEllipse1, pntOnEllipse2, pntOnLine1, pntOnLine2): 沿 方向 把直线投到本椭圆弧, 返回交点个数, -1 表示底层判假或句柄无效。" 注释 = "实测 AcGe25: 投影方向落在长轴方向上时整条曲线都是像, 判 -1; 投影方向平行于对方直线仍给 2。">
    参数 直线 <类型 = 变整数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    参数 椭圆上点一 <类型 = ARX点3D>
    参数 椭圆上点二 <类型 = ARX点3D>
    参数 线上点一 <类型 = ARX点3D>
    参数 线上点二 <类型 = ARX点3D>
    {
        返回 ARX几何底层.椭圆弧3D投影交 (对象指针, 直线, 方向X, 方向Y, 方向Z, 椭圆上点一.对象指针, 椭圆上点二.对象指针, 线上点一.对象指针, 线上点二.对象指针)
    }

    方法 取平面最近点 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc3d::closestPointToPlane(plane, pntOnPlane): 椭圆弧上离平面最近的点写入 结果, 平面上的垂足写入 平面点。二维侧没有该接口。" 注释 = "实测 AcGe25: 割面情形两点重合在交点上; 共面情形两点都留在曲线平面内。">
    参数 平面 <类型 = ARX平面>
    参数 结果 <类型 = ARX点3D>
    参数 平面点 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.椭圆弧3D平面最近点 (对象指针, 平面.对象指针, 结果.对象指针, 平面点.对象指针))
    }

