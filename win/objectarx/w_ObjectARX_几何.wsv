    }

    方法 取重叠片类型 <公开 类型 = 整数 注释 = "对应 AcGeLinearEnt3d::overlap: 只问本射线与 对方 的重叠片是什么类型。" 注释 = "返回码: -1 本射线未创建或 对方 指针无效, -3 SDK 判无重叠(此时不写片), 其余是片的 AcGe::EntityId。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D重叠片型 (对象指针, 对方))
    }

    方法 接收重叠片自 <公开 类型 = 逻辑型 注释 = "对应 AcGeLinearEnt3d::overlap(line, overlap): 把本射线与 对方 的重叠片写回本对象自己。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针, 与本类互不限制。" 注释 = "所有权口径同 接收分割片自: 句柄不出桥, 桥内按 type() 还原后赋值再释放。">
    参数 对方 <类型 = 变整数>
    {
        返回 (ARX几何底层.线性3D重叠片收 (对象指针, 对方) == 1)
    }
}

类 ARX点上曲面 <公开 注释 = "封装 ObjectARX AcGePointOnSurface: 曲面上一个点的位置, 由 (所绑曲面, 一对参数 u/v) 二元组表达。本包十九B 的公开类, 类库里第 28 个公开类。" 注释 = "继承链 AcGePointOnSurface -> AcGePointEnt3d -> AcGeEntity3d(CDROM1/inc/geponsrf.h:25), 挂在点实体层而不是曲线链上, 所以曲线族那一整批接口(是否过参数 / 取周期 / 取面积 / 反转参数 / 取退化类型 等)在本类一条都不转发; 继承层只借到 AcGePointEnt3d::point3d() 一条, 它与自有 point() 实测逐位同值, 因此本类不再另开一个入口。" 注释 = "类库里能当曲面传进来的只有 ARX平面 与 ARX有界平面 两类句柄(25 与 9) —— AcGeSurface 以下再没有别的派生类有导出符号(球面、环面、锥面只存在于头文件), 所以本类 源曲面 参数的 变整数 不做按型分发, 两类句柄都能直传, 读数按各自那套轴算。" 注释 = "使用前必须调用 创建(或 创建过曲面 / 创建过曲面参数 / 复制自 之一), 使用完毕后调用 释放 归还底层对象。" 注释 = "所有权: 本类只借曲面不持有 —— 底层存的是 const AcGeSurface&, 源曲面必须先于本对象释放。实测源面先 释放 之后本对象 取类型编号 仍读 8, 别名探针读 -1, 而 取点 / 取法向 / 取U向导数 全部判假且不碰出参(哨兵原样留着), 进程不崩 —— 桥内 try/catch 兜住了 SDK 的悬垂调用。释放本对象也绝不会碰源曲面。" 注释 = "求值用的是曲面的原始参数架, 也就是 ARX平面/ARX有界平面 的 取点与两轴 那一组轴, 不是 取坐标系 那组单位正交轴。实测 原点(1,2,3)、U(1,1,0)、V(0,0,1) 的斜面在参数 (2,3): 取点 = (3,4,6) = 原点 + 2*U + 3*V, 取U向导数(阶1) = (1,1,0) 保持原长不单位化; 同一个平面上 ARX平面.取坐标系 读回的 U 是 (0.707106781186547,0.707106781186547,0), 而 ARX平面.取参数点(2,3) 与本类 取点 逐位相同 —— 两条通道同一套轴。" 注释 = "缺省构造不是空对象: 实测 surface() 指着一个 AcGePlane(别名类型 25), 参数 (0,0)、取点 (0,0,0)、法向 (0,0,1)、取U向导数(1) (1,0,0)、取V向导数(1) (0,1,0), 即世界 XY 面。所以 是否有效 只看自己的句柄, 不能拿别名在不在判空; 是否同一曲面 对用户自己的面与片一律答假, 它也不是判空手段。" 注释 = "参数不夹取、非有限入参不拦(按包十九A 越界入参不拦 的同一裁定): 实测 设参数(NaN,NaN) 返回真且此后本对象全部读数都是 NaN, 创建过曲面参数 传 NaN 照样建成有效句柄; ARX有界平面 的边界不参与判定, 单位片上给越界参数 (5,6) 照存照算成 (11,20,3)。" 注释 = "阶数档只有 0 与 1 有意义, 而且两族不对称: 取U向导数(阶0) 回的是点本身(实测 世界面上 (7,8) → (7,8,0), 斜面 (2,3) → (3,4,6), 片 (0.5,0.25) → (2,2.75,3)), 取V向导数(阶0) 回 (0,0,0)。阶数 2 及以上与负数底层都不校验, 返回未初始化值 —— 三轮探针读到过 (0,0,0)、(0,1,0)、(0,0,7)、(8,0,0) 四种: 同一轮里换对象往往照旧重复(第二轮 阶3 在三个新对象上都读 (0,0,0)、阶(-1) 的 U 族三对象都读 (8,0,0)), 换一轮就变(阶3 第一轮读 (0,1,0)), 说明它随调用栈残留而定而不随对象而定, 所以封装面不给期望值, 断言只断判真与出参被写。" 注释 = "带参档会写回本对象: point(param)、normal(param)、uDeriv(order,param)、vDeriv(order,param)、mixedPartial(param)、tangentVector(vec,param)、inverseTangentVector(vec,param) 七条都先把对象存的参数改成传入的 (参数U,参数V) 再算 —— 逐条坐实: 取点于(7,8) 之后 取参数 读 (7,8), 取法向在参数(1,2) 读 (1,2), 取U向导数在参数(3.5,-0.5) 读 (3.5,-0.5), 取V向导数在参数(4.5,-1.5) 读 (4.5,-1.5), 取混合偏导在参数(5,6) 读 (5,6), 取切向量在参数(5.5,-2.5) 读 (5.5,-2.5), 取切向量反演在参数(7,8) 读 (7,8)。静态档在桥内临时对象上算, 不碰任何用户对象 —— 实测 七个静态档全跑完之后本对象参数仍读 (2.5,-1.25); 而 源曲面 传 0 时七档一律判假且不碰出参。" 注释 = "反转法向 只动法向这一件: 实测 斜面 与 有界片 各自 反转法向 之后, 本类 取法向 反向(斜面由 (0.7071,-0.7071,0) 变 (-0.7071,0.7071,0), 片由 (0,0,1) 变 (0,0,-1)), 而 取点 / 取U向导数 / 取V向导数 / 取混合偏导 / 取切向量 逐项不变, 静态档法向跟着反(它读的是活着的别名)。" 注释 = "结构实测: sizeof(AcGePointOnSurface) = 16, 类型编号恒 8 = AcGe::kPointOnSurface(缺省对象、带参构造、复制之后都读 8, 句柄无效读 -1), 底层只导出非虚析构, 句柄一律不出桥。" 注释 = "底层依赖: ObjectARX SDK inc / lib-x64, 运行时需 acge25.dll。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGePointOnSurface 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnSurface(), 缺省构造。已存在时先释放旧对象。" 注释 = "实测: 缺省构造也带着一个曲面 —— 类型 25 的 AcGePlane 且就是世界 XY 面, 参数 (0,0)、取点 (0,0,0)、法向 (0,0,1)、取U向导数(1) (1,0,0)、取V向导数(1) (0,1,0)、取混合偏导 (0,0,0)。别名不是空指针, 判空一律用 是否有效。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲面 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲面 ()
        返回 (对象指针 != 0)
    }

    方法 创建过曲面 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnSurface(surf), 源曲面 传 ARX平面 或 ARX有界平面 的 对象指针。已存在时先释放旧对象。" 注释 = "实测: 只给曲面时参数落 (0,0), 取点 就是那个曲面的参考点 —— 世界面得 (0,0,0), 原点(1,2,3) 的斜面与片都得 (1,2,3); 别名即该曲面, 是否同一曲面 查它真; 取U向导数(1) 给该曲面的原始 U 轴(片 (2,0,0), 斜面 (1,1,0))。曲面句柄传 0 时返回 0 句柄、本对象保持未创建。">
    参数 源曲面 <类型 = 变整数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲面 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲面过曲面 (源曲面)
        返回 (对象指针 != 0)
    }

    方法 创建过曲面参数 <公开 类型 = 逻辑型 注释 = "对应 new AcGePointOnSurface(surf, param), 源曲面 口径同 创建过曲面。已存在时先释放旧对象。" 注释 = "实测: 种子原样存, 不夹取也不看曲面边界 —— 世界面 (2.5,-1.25) → 取点 (2.5,-1.25,0); 片(原点(1,2,3), U(2,0,0), V(0,3,0)) 上 (0.5,0.25) → (2,2.75,3), 越界的 (5,6) 照算成 (11,20,3); 负参数 (-3,-4) 照存。NaN 不拦: 传 (NaN,1.0) 建得成有效句柄且参数就存成 (NaN,1.0)。">
    参数 源曲面 <类型 = 变整数>
    参数 参数U <类型 = 小数>
    参数 参数V <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲面 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建点上曲面过参数 (源曲面, 参数U, 参数V)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGePointOnSurface 对象并把 对象指针 归零。所绑曲面是借来的, 本方法不碰它, 由调用方自己释放。句柄为 0 时不崩也不报错。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放点上曲面 (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。" 注释 = "只看句柄: 缺省对象的别名也恒不为空(那条世界 XY 面), 别拿曲面在不在当判空依据。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnSurface::operator=(const AcGePointOnSurface&), 源对象必须已创建且本对象也已创建。" 注释 = "实测: 浅拷贝 —— 参数与别名一起搬, 副本 是否同一曲面 指回源对象绑的那一片(源是 (0.5,0.25) 的片时, 复制后参数读 (0.5,0.25) 且 是否同一曲面(那片) 为真), 类型编号仍是 8。副本与原件共用同一个曲面别名, 所以源曲面释放之后两边一起变悬垂。">
    参数 源 <类型 = ARX点上曲面>
    {
        返回 (ARX几何底层.点上曲面复制 (对象指针, 源.对象指针))
    }

    方法 设曲面 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnSurface::setSurface(surf), 源曲面 口径同 创建过曲面。" 注释 = "实测: 只换别名不动参数 —— 片上参数 (0.5,0.25) 的对象 设曲面(世界面) 之后参数仍读 (0.5,0.25), 而 取点 变成世界面上的 (0.5,0.25,0)。曲面句柄传 0 时返回假, 别名与参数两样都不动 —— 实测 世界面上参数 (2.5,-1.25) 的对象 设曲面(0) 判假, 之后 是否同一曲面(那张世界面) 仍读真, 取参数 仍读 (2.5,-1.25)。">
    参数 源曲面 <类型 = 变整数>
    {
        返回 (ARX几何底层.点上曲面设曲面 (对象指针, 源曲面))
    }

    方法 设参数 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnSurface::setParameter(param), 两个分量原样存, 不夹取也不看曲面边界。" 注释 = "实测: 世界面上 (2.5,-1.25) 与 (-3,-4) 都原样回读; 设成 (1e6,-1e6) 也照存; 设成 (NaN,NaN) 返回真, 此后 取点 与全部派生读数都是 NaN, 库层不拦也不报。句柄无效返回假。">
    参数 参数U <类型 = 小数>
    参数 参数V <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲面设参数 (对象指针, 参数U, 参数V))
    }

    方法 是否同一曲面 <公开 类型 = 逻辑型 注释 = "对应 surface() == &给定曲面, 是本类唯一的别名查询入口 —— 裸曲面指针不出桥。源曲面 传 ARX平面 或 ARX有界平面 的 对象指针。" 注释 = "实测: 带参构造之后、设曲面 之后、复制自 之后都能用它验证别名换没换; 比较的是指针同一性而不是几何 —— 两片几何相同的平面互判假, 缺省对象对用户自己的面与片都判假。句柄无效返回假。它不是判空手段。">
    参数 源曲面 <类型 = 变整数>
    {
        返回 (ARX几何底层.点上曲面同曲面 (对象指针, 源曲面))
    }

    方法 取参数 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnSurface::parameter(), 本对象存的那一对 (u,v) 写进调用方已创建的 结果(ARX点2D)。" 注释 = "与 ARX平面.取参数 不是一回事: 那一条是 AcGeSurface::paramOf(点) —— 拿一个三维点反解参数; 本条只是把对象里存着的二维参数原样读出来, 不做任何计算, 因此也不要求点落在哪。" 注释 = "实测: 种子 (2.5,-1.25) 读回 (2.5,-1.25), 越界的 (5,6) 与 (1e6,-1e6) 都原样读回; 句柄无效或 结果 未创建都判假且不碰出参。">
    参数 结果 <类型 = ARX点2D>
    {
        返回 (ARX几何底层.点上曲面读参数 (对象指针, 结果.对象指针))
    }

    方法 取类型编号 <公开 类型 = 整数 注释 = "对应 AcGePointOnSurface::type(), 句柄无效返回 -1。" 注释 = "AcGe::kPointOnSurface = 8。实测恒为 8: 缺省对象、带曲面构造、带参构造、复制之后都读 8, 与所绑的是无限面(25)还是有界片(9)无关。本方法报的永远是本对象自己的编号 —— 别名那个编号不出桥, 想知道绑的是哪一片只能用 是否同一曲面 逐个比对。">
    {
        返回 (ARX几何底层.点上曲面类型编号 (对象指针))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "sizeof(AcGePointOnSurface), 桥内取, 供结构与内存核对用。" 注释 = "实测 AcGe25 x64: 为 16, 与 ARX平面、ARX包围块2D/3D、ARX点上曲线2D 同宽。这个值只说明壳里放的是句柄级别的两三个成员, 不能按它预判对象里存了几个分量, 也不要据此推断二维参数是内联还是间接存的。">
    {
        返回 (ARX几何底层.点上曲面结构尺寸 ())
    }

    方法 取点 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnSurface::point(), 结果写进调用方已创建的 结果(ARX点3D)。" 注释 = "实测: 世界面 (2.5,-1.25) → (2.5,-1.25,0); 斜面(原点(1,2,3), U(1,1,0), V(0,0,1)) (2,3) → (3,4,6) = 原点 + 2*U + 3*V; 片(U(2,0,0), V(0,3,0)) (0.5,0.25) → (2,2.75,3), 越界 (5,6) → (11,20,3)。参数是 NaN 时三个分量全 NaN, 不报错。句柄无效与 结果 未创建都判假且不碰出参; 源曲面已被释放时同样判假(见类注释的生命周期条)。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.点上曲面取点 (对象指针, 结果.对象指针))
    }

    方法 取点在参数 <公开 类型 = 逻辑型 注释 = "对应 AcGePointOnSurface::point(param)。" 注释 = "实测: 世界面 (2.5,-1.25) 上调 (7,8) 得 (7,8,0), 与 设参数 之后 取点 同值; 但它不是纯查询 —— 调完本对象存的参数就成了 (7,8)。要按别的参数算又不动本对象, 走静态档 取曲面点。">
    参数 结果 <类型 = ARX点3D>
    参数 参数U <类型 = 小数>
    参数 参数V <类型 = 小数>
    {
        返回 (ARX几何底层.点上曲面取点于 (对象指针, 参数U, 参数V, 结果.对象指针))
    }

    方法 取曲面点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePointOnSurface::point(surf, param)。桥内在临时对象上调用, 因此不需要本对象句柄, 也不碰任何用户对象。源曲面 传 ARX平面/ARX有界平面 的 对象指针。" 注释 = "实测: 斜面 + (2,3) 与 本对象上的 取点 逐位相同 (3,4,6); 世界面 + (1,2) 得 (1,2,0)。曲面句柄传 0 判假且不碰 结果。">
    参数 结果 <类型 = ARX点3D>
    参数 源曲面 <类型 = 变整数>
    参数 参数U <类型 = 小数>
