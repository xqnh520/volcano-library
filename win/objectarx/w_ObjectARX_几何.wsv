    }

    方法 取裁剪偏移片数 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 类方法(不需要接收者), 问 源曲线 在 法向 所指平面内偏出 偏移距离 后的裁剪偏移曲线被底层拆成几片; 延伸档 0/1/2 是 AcGe::kFillet/kChamfer/kExtend。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2 或 法向三分量全为 0 (库层挡下, 一次都不调底层 —— 实测零法向底层不报错, 而是吐出一片无人可收的 kCompositeCrv3d(47), 区间还会从源的 0..π/2 读成 0..3π/2), -2 底层抛异常; 其余是片数, 0 片是正常返回不是错误。" 注释 = "实测 AcGe25: 圆心 0,0,0、法向 0,0,1、半径 5 的 0..π/2 弧与整圆在 d=±2 各给 1 片, 内偏越过半径 (d=+5) 给 0 片。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片数 (源曲线, 偏移距离, 延伸档, 法向X, 法向Y, 法向Z))
    }

    方法 取裁剪偏移片类型 <公开 静态 类型 = 整数 注释 = "对应 AcGeCurve3d::getTrimmedOffset: 类方法(不需要接收者), 只问 源曲线 偏出的第 片下标 片(从 0 数)的具体类型, 返回 AcGe::EntityId 整数。" 注释 = "返回码: -1 源曲线未创建、延伸档 不在 0..2、法向三分量全为 0 (库层挡下)、片下标 越出 0..片数-1 或底层把该片给成空指针, -2 该片 type() 抛异常; 其余为该片真实类型。" 注释 = "实测 AcGe25: 片恒为 kCircArc3d(11), 片长随半径同比缩放 (与二维侧同一批读数 4.71238898038469 对 7.85398163397448)。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片类型 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z))
    }

    方法 接收裁剪偏移自 <公开 类型 = 逻辑型 注释 = "对应 AcGeCurve3d::getTrimmedOffset(distance, planeNormal, pieces, extensionType): 把 源曲线 在 法向 所指平面内偏出的第 片下标 片写进本对象。源曲线 传 ARX直线3D/ARX线段3D/ARX圆弧3D/ARX椭圆弧3D 任一类的 对象指针。" 注释 = "所有权口径与 接收分割片自 同一套: 片是底层 new 出来的 AcGeCurve3d*, 析构非虚, 句柄一律不出桥 —— 桥内按 type() 还原具体类, 与本对象类型相符才赋值, 随后在桥内释放全部片。法向三分量全为 0 时库层直接判假且不调底层。" 注释 = "实测 AcGe25: 本类是 11 片的唯一接收者; 法向三条口径 —— 不需要单位化 ((0,0,2) 与 (0,0,1) 读数完全相同)、法向取反与 偏移距离 取负逐位等价 ((0,0,-1) 配 d=+2 与 (0,0,1) 配 d=-2 同为半径 7)、与源平面平行的 (1,1,0) 也照给 (0,0,1) 的结果; 三分量全为 0 被库层挡成假且目标一位不动。">
    参数 源曲线 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    参数 延伸档 <类型 = 整数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 片下标 <类型 = 整数>
    {
        返回 (ARX几何底层.曲线3D裁剪偏移片进 (源曲线, 偏移距离, 延伸档, 片下标, 法向X, 法向Y, 法向Z, 对象指针))
    }
}

# ===

类 ARX椭圆弧2D <公开 注释 = "封装 ObjectARX AcGeEllipArc2d: 二维椭圆弧(含整椭圆), 由圆心、长轴向量、短轴向量、长半径、短半径和起止角定义, 对应 AutoCAD 的 ELLIPSE 实体。" 注释 = "本类同时把继承自 AcGeCurve2d/AcGeEntity2d 的通用曲线接口一并暴露出来, 参数类型是 变整数 的方法可以接收 ARX直线2D/ARX线段2D/ARX圆弧2D/ARX椭圆弧2D 的 对象指针。" 注释 = "使用前必须调用 创建 或任一 创建XX, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeEllipArc2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc2d(), 创建缺省椭圆弧; 已存在时先释放旧对象。" 注释 = "实测 AcGe25: 缺省对象就是一个单位圆整椭圆: 长短半径都是 1、角度与区间都是 0..2PI、闭合且不退化。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧2D ()
        返回 (对象指针 != 0)
    }

    方法 创建轴长 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc2d(cent, majorAxis, minorAxis, majorRadius, minorRadius), 起止角取缺省值即整椭圆。" 注释 = "实测 AcGe25: 只给轴向与半径时起止角自动取 0..2PI 即整椭圆, 闭合为真、周期 2PI、退化类型 -1。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 长轴X <类型 = 小数>
    参数 长轴Y <类型 = 小数>
    参数 短轴X <类型 = 小数>
    参数 短轴Y <类型 = 小数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧2D轴 (圆心X, 圆心Y, 长轴X, 长轴Y, 短轴X, 短轴Y, 长半径, 短半径)
        返回 (对象指针 != 0)
    }

    方法 创建带角度 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc2d(cent, majorAxis, minorAxis, majorRadius, minorRadius, startAngle, endAngle)。">
    参数 圆心X <类型 = 小数>
    参数 圆心Y <类型 = 小数>
    参数 长轴X <类型 = 小数>
    参数 长轴Y <类型 = 小数>
    参数 短轴X <类型 = 小数>
    参数 短轴Y <类型 = 小数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    参数 起始角 <类型 = 小数>
    参数 终止角 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧2D角 (圆心X, 圆心Y, 长轴X, 长轴Y, 短轴X, 短轴Y, 长半径, 短半径, 起始角, 终止角)
        返回 (对象指针 != 0)
    }

    方法 创建自圆弧 <公开 类型 = 逻辑型 注释 = "对应 new AcGeEllipArc2d(arc), 把一个二维圆圆弧原样搬成椭圆弧。" 注释 = "实测 AcGe25: 连同圆弧的起止角一并带走, 非整圆时区间不再等于 0..2PI; 长短半径被写成同一个值。">
    参数 圆弧 <类型 = ARX圆弧2D>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建椭圆弧2D自圆弧 (圆弧.对象指针)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeEllipArc2d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放椭圆弧2D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "本椭圆弧是目标, 参数 源 是数据来源且必须已创建。" 注释 = "实测 AcGe25: 本对象必须已创建(对象指针 非 0)才返回真, 指针为 0 时判假且不复活指针。">
    参数 源 <类型 = ARX椭圆弧2D>
    {
        返回 (ARX几何底层.椭圆弧2D复制 (对象指针, 源.对象指针))
    }

    方法 设置轴长 <公开 类型 = 逻辑型 注释 = "对应 AcGeEllipArc2d::set(cent, majorAxis, minorAxis, majorRadius, minorRadius), 就地改写, 起止角取缺省值。" 注释 = "实测 AcGe25: 就地改写同样把起止角重置为 0..2PI, 即使本对象原先是一段弧。">
    参数 圆心X <类型 = 小数>
