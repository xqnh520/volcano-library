    }

    方法 取类型编号 <公开 类型 = 整数 注释 = "对应 AcGeEntity3d::type, 返回 AcGe::EntityId 的整数值; 未创建返回 -1。" 注释 = "实测 AcGe25: AcGePlane 返回 25, 即 AcGe::kPlane(枚举 AcGe::EntityId 从 kEntity2d=0 起算, 见 gegblge.h)。">
    {
        返回 (ARX几何底层.平面类型编号 (对象指针))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGePlane), 用于校验结构内存布局。" 注释 = "实测 AcGe25: 为 16, 与 ARX直线3D/ARX线段3D 相同。">
    {
        返回 (ARX几何底层.平面结构尺寸 ())
    }
}

# ===

类 ARX有界平面 <公开 注释 = "封装 ObjectARX AcGeBoundedPlane: 带矩形边界的有向平面片, 与 AcGePlane 同为 AcGePlanarEnt 的兄弟类(不是父子), 底层类型编号 9 = AcGe::kBoundedPlane, 结构尺寸 16 与 ARX平面 相同(两类都不带数据成员, 几何量在 pImpl 里)。" 注释 = "底层继承链是 AcGeBoundedPlane -> AcGePlanarEnt -> AcGeSurface -> AcGeEntity3d。本类暴露的读接口(取法向/取面上点/系数/取坐标系/平行垂直共面判定/最近点/是否过点/取参数/取参数点/反转法向/按矩阵变换)都声明在 AcGePlanarEnt、AcGeSurface 或 AcGeEntity3d 上, 与 ARX平面 命中的是同一份 AcGe25 实现, 因此走同一批底层导出。" 注释 = "本类比 ARX平面 多出来的是自身重声明的三个 intersectWith 重载(取直线交点/取平面交线段/取有界平面交线段), 它们是隐藏而非重写基类的同名函数, 口径见各方法注释; 本类比 ARX平面 少的是 AcGePlane 专有的 创建法向、创建系数、设系数、取有向距离。" 注释 = "不要把本类的 对象指针 传给任何声明收 ARX平面 的方法或任何 AcGePlane 专有导出: 那会按 AcGePlane 的重载静态派发到一个并非 AcGePlane 的对象上。" 注释 = "实测 AcGe25 最容易踩的一条: 边界只在 创建轴 / 创建三点 / 复制自 / 设轴 / 设三点 之后才建立。单独的 创建() 缺省对象读数与世界 XY 面一模一样, 却按无限平面答题(是否过点 对 (10,10,0) 判真、取距离 给 0、取最近点 不夹紧), 而 创建轴 用同样数据造出的单位方片对同一个点判假、距离 12.7279220613579、最近点夹到 (1,1,0)。要使用有界语义就必须给轴。" 注释 = "本类与 ARX平面 共用一批底层导出, 但 取点与两轴 / 取三点 的含义不同: 本类保留构造时给的两条原始边界向量(不单位化、不正交化), ARX平面 存的是单位正交轴, 同一个 AcGePlanarEnt::get 在两类上读出的是边界角点与单位轴两套东西。" 注释 = "一条 SDK 层面的事实而非实测: AcGeBoundedPlane 没有只改边界不动平面的接口, 它的 set 只有 (origin, uVec, vVec) 与 (p1, origin, p2) 两个重载, 所以 设轴/设三点 一定把所在无限平面与矩形边界一起重设, 想单独挪边界只能先 取点与两轴 读回两条原始边、改完再整体 设轴。" 注释 = "使用前必须调用 创建 或任一 创建XX, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeBoundedPlane 对象地址, 0 表示尚未创建。">

    方法 向量为零 <静态 类型 = 逻辑型 注释 = "三分量平方和为 0, 即零向量。">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        返回 (X * X + Y * Y + Z * Z <= 0)
    }

    方法 轴退化 <静态 类型 = 逻辑型 注释 = "两向量叉积为零向量, 涵盖任一向量为零、以及两向量平行(含反平行)三种情形。">
    参数 UX <类型 = 小数>
    参数 UY <类型 = 小数>
    参数 UZ <类型 = 小数>
    参数 VX <类型 = 小数>
    参数 VY <类型 = 小数>
    参数 VZ <类型 = 小数>
    {
        变量 叉X <类型 = 小数>
        变量 叉Y <类型 = 小数>
        变量 叉Z <类型 = 小数>
        叉X = UY * VZ - UZ * VY
        叉Y = UZ * VX - UX * VZ
        叉Z = UX * VY - UY * VX
        返回 (叉X * 叉X + 叉Y * 叉Y + 叉Z * 叉Z <= 0)
    }

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundedPlane(), 创建缺省有界平面; 已存在时先释放旧对象。" 注释 = "实测 AcGe25: 缺省对象的坐标读数就是世界 XY 面(原点 (0,0,0)、u=(1,0,0)、v=(0,1,0)、法向 (0,0,1)、系数 (0,0,1,0)), 但边界没有建立: 是否过点(10,10,0) 判真、取距离 给 0、取最近点 不夹紧。它只适合当 复制自 / 设轴 / 设三点 的目标, 不能直接当有界片用。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.有界平面释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建有界平面 ()
        返回 (对象指针 != 0)
    }

    方法 创建轴 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundedPlane(origin, uVec, vVec), 原点加两个轴向量。参数顺序与 ARX平面.创建轴 一致。" 注释 = "实测 AcGe25: 原点就是平行四边形的一个角, u/v 是从该角出发的两条邻边, 片覆盖 origin + a*u + b*v 且 a、b 各取 0..1; 法向 = u 叉积 v 单位化, 系数随法向与原点重算(原点 (1,2,3)、u=(2,0,0)、v=(0,3,0) 得 法向 (0,0,1)、系数 (0,0,1,-3))。两轴不必正交也不必单位长(给 u=(2,0,0)、v=(1,1,0) 得到法向 (0,0,1), 边界向量原样保留)。" 注释 = "任一向量为零或两轴平行时本方法在进入底层前就返回假, 对象指针 保持原值不变。">
    参数 原点X <类型 = 小数>
    参数 原点Y <类型 = 小数>
    参数 原点Z <类型 = 小数>
    参数 UX <类型 = 小数>
    参数 UY <类型 = 小数>
    参数 UZ <类型 = 小数>
    参数 VX <类型 = 小数>
    参数 VY <类型 = 小数>
    参数 VZ <类型 = 小数>
    {
        如果 (轴退化 (UX, UY, UZ, VX, VY, VZ))
        {
            返回 (假)
        }

        如果 (对象指针 != 0)
        {
            ARX几何底层.有界平面释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建有界平面轴 (原点X, 原点Y, 原点Z, UX, UY, UZ, VX, VY, VZ)
        返回 (对象指针 != 0)
    }

    方法 创建三点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundedPlane(p1, origin, p2), 参数顺序是 U 侧点、原点、V 侧点, 与 ARX平面.创建三点 一致。" 注释 = "实测 AcGe25: 等价于 创建轴(origin, p1-origin, p2-origin) —— 用 (3,2,3)/(1,2,3)/(1,5,3) 造出的片与用 原点(1,2,3)+u(2,0,0)+v(0,3,0) 轴造出的片, 法向、坐标系、边界、求交读数全部一致。三点共线或与原点重合时叉积为零, 本方法返回假。">
    参数 UX <类型 = 小数>
    参数 UY <类型 = 小数>
    参数 UZ <类型 = 小数>
    参数 原点X <类型 = 小数>
    参数 原点Y <类型 = 小数>
    参数 原点Z <类型 = 小数>
    参数 VX <类型 = 小数>
    参数 VY <类型 = 小数>
    参数 VZ <类型 = 小数>
    {
        如果 (轴退化 (UX - 原点X, UY - 原点Y, UZ - 原点Z, VX - 原点X, VY - 原点Y, VZ - 原点Z))
        {
            返回 (假)
        }

        如果 (对象指针 != 0)
        {
            ARX几何底层.有界平面释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建有界平面三点 (UX, UY, UZ, 原点X, 原点Y, 原点Z, VX, VY, VZ)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeBoundedPlane 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.有界平面释放 (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "本有界平面是目标, 参数 源 是数据来源且必须已创建。对应 AcGeBoundedPlane::operator=。" 注释 = "源必须是 ARX有界平面: 本类与 ARX平面 是兄弟类, 底层没有跨类赋值可用。" 注释 = "实测 AcGe25: 平面数据与边界一起搬, 复制后本对象按新边界答题 —— 把 矩形片 复制进一个 创建() 的目标, 界外点 (10,10,3) 就从判真变成判假。目标未创建、源未创建都判假。">
    参数 源 <类型 = ARX有界平面>
    {
        返回 (ARX几何底层.有界平面复制 (对象指针, 源.对象指针))
    }

    方法 设轴 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundedPlane::set(origin, uVec, vVec), 参数顺序与口径同 创建轴。" 注释 = "实测 AcGe25: 在 创建() 的缺省对象上设轴会把边界一并建立起来(设完 是否过点(10,10,3) 判假、取距离 给 8.60232526704263), 与新建等价。" 注释 = "本方法不清除 反转法向 留下的朝向标志, 也不像 ARX平面 那样把坐标系的 V 轴反号, 详见 反转法向。退化轴(零向量或两轴平行)在进底层前被拦下返回假。">
    参数 原点X <类型 = 小数>
    参数 原点Y <类型 = 小数>
    参数 原点Z <类型 = 小数>
    参数 UX <类型 = 小数>
    参数 UY <类型 = 小数>
    参数 UZ <类型 = 小数>
    参数 VX <类型 = 小数>
    参数 VY <类型 = 小数>
    参数 VZ <类型 = 小数>
    {
        如果 (轴退化 (UX, UY, UZ, VX, VY, VZ))
        {
            返回 (假)
        }

        返回 (ARX几何底层.有界平面设轴 (对象指针, 原点X, 原点Y, 原点Z, UX, UY, UZ, VX, VY, VZ))
    }

    方法 设三点 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundedPlane::set(p1, origin, p2), 参数顺序与口径同 创建三点。" 注释 = "实测 AcGe25: 与 设轴 同一条路径, 由 原点、p1-原点、p2-原点 定出平行四边形并建立边界; 目标未创建判假, 三点共线时本方法在进入底层前返回假。">
    参数 UX <类型 = 小数>
    参数 UY <类型 = 小数>
    参数 UZ <类型 = 小数>
    参数 原点X <类型 = 小数>
    参数 原点Y <类型 = 小数>
    参数 原点Z <类型 = 小数>
    参数 VX <类型 = 小数>
    参数 VY <类型 = 小数>
    参数 VZ <类型 = 小数>
    {
        如果 (轴退化 (UX - 原点X, UY - 原点Y, UZ - 原点Z, VX - 原点X, VY - 原点Y, VZ - 原点Z))
        {
            返回 (假)
        }

        返回 (ARX几何底层.有界平面设三点 (对象指针, UX, UY, UZ, 原点X, 原点Y, 原点Z, VX, VY, VZ))
    }

    方法 取法向 <公开 类型 = 逻辑型 注释 = "对应 AcGePlanarEnt::normal, 写入调用方已创建的 结果 向量对象。">
    参数 结果 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.平面法向 (对象指针, 结果.对象指针))
    }

    方法 取面上点 <公开 类型 = 逻辑型 注释 = "对应 AcGePlanarEnt::pointOnPlane, 写入调用方已创建的 结果 点对象。">
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.平面点 (对象指针, 结果.对象指针))
    }

    方法 系数A <公开 属性读 类型 = 小数 注释 = "一般方程 a*x + b*y + c*z + d = 0 的 a; 未创建返回 NaN。">
    {
        返回 (ARX几何底层.平面系数A (对象指针))
    }

    方法 系数B <公开 属性读 类型 = 小数 注释 = "一般方程的 b; 未创建返回 NaN。">
    {
        返回 (ARX几何底层.平面系数B (对象指针))
    }

    方法 系数C <公开 属性读 类型 = 小数 注释 = "一般方程的 c; 未创建返回 NaN。">
    {
        返回 (ARX几何底层.平面系数C (对象指针))
    }

    方法 系数D <公开 属性读 类型 = 小数 注释 = "一般方程的 d; 未创建返回 NaN。">
    {
        返回 (ARX几何底层.平面系数D (对象指针))
    }

    方法 取坐标系 <公开 类型 = 逻辑型 注释 = "对应 AcGePlanarEnt::getCoordSystem(origin, axis1, axis2), 三个出参对象都必须已创建。" 注释 = "实测 AcGe25: 这里给的是单位正交坐标架, 与构造时的边界向量长度和夹角无关 —— u=(2,0,0)、v=(0,3,0) 读到 U=(1,0,0)、V=(0,1,0), 非正交的 v=(1,1,0) 也被正交化成 (0,1,0)。想拿原始边界请用 取点与两轴。" 注释 = "反转法向 不改本方法读数(U 叉积 V 因此不再等于 取法向), 这一点与 ARX平面 上 反转后重设会反号 V 的行为不同。">
    参数 原点 <类型 = ARX点3D>
    参数 U轴 <类型 = ARX向量3D>
    参数 V轴 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.平面坐标系 (对象指针, 原点.对象指针, U轴.对象指针, V轴.对象指针))
    }

    方法 取点与两轴 <公开 类型 = 逻辑型 注释 = "对应 AcGePlanarEnt::get(pnt, uVec, vVec), 与 取坐标系 是同一份数据的两种写法, 出参对象都必须已创建。" 注释 = "实测 AcGe25: 三个出参是 原点(片的一个角) 与两条原始边界向量, 不单位化也不正交化 —— u=(2,0,0)、v=(0,3,0) 原样读回, 非正交的 v=(1,1,0) 也原样读回。这是本类读边界的主入口, 片的四个角 = 原点、原点+U、原点+V、原点+U+V, 与 取坐标系 的单位轴是两套读数。出参对象未创建判假且不碰出参。">
    参数 点 <类型 = ARX点3D>
    参数 U轴 <类型 = ARX向量3D>
    参数 V轴 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.平面取轴 (对象指针, 点.对象指针, U轴.对象指针, V轴.对象指针))
    }

    方法 取三点 <公开 类型 = 逻辑型 注释 = "对应 AcGePlanarEnt::get(pnt, origin, pnt), 三个出参全是点对象。" 注释 = "实测 AcGe25: 三点依次是 原点+u、原点、原点+v, 即平行四边形的两个相邻角加公共角(矩形片 读到 (3,2,3)、(1,2,3)、(1,5,3))。同一份实现作用在 ARX平面 上时两轴已单位化, 读出的只是相邻的两个单位点。">
    参数 点 <类型 = ARX点3D>
    参数 原点 <类型 = ARX点3D>
    参数 点二 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.平面取三点 (对象指针, 点.对象指针, 原点.对象指针, 点二.对象指针))
    }

    方法 取包络U下限 <公开 类型 = 小数 注释 = "对应 AcGeSurface::getEnvelope(intrvlU, intrvlV) 里 U 向区间的 lowerBound。读的是参数域而不是世界尺寸, 与 取点与两轴 读回的两条原始边界向量是两套东西; 片未创建返回 NaN。" 注释 = "实测 AcGe25: 边界一经建立就是 0, 与 取包络U上限 的 1 合成参数域 0..1 —— 单位方片、u=(2,0,0)v=(0,3,0) 的矩形片、u=(20,0,0)v=(0,30,0) 的二十倍大片、三点构造片、非正交的斜轴片五样读数逐字相同, 可见读的是归一化参数而不是世界尺寸; 与 取参数点(2,0) 外推到 (5,2,3) 那条实测自洽, 参数域确实是 0..1。">
    {
        返回 (ARX几何底层.平面包络U下限 (对象指针))
    }

    方法 取包络U上限 <公开 类型 = 小数 注释 = "对应 getEnvelope 里 U 向区间的 upperBound; 片未创建返回 NaN。" 注释 = "实测 AcGe25: 有边界时恒为 1; 单独的 创建() 缺省对象给 0, 退化成与 ARX平面 一模一样的 0..0, 因为那一侧根本没有 envelope。">
    {
        返回 (ARX几何底层.平面包络U上限 (对象指针))
    }

    方法 取包络V下限 <公开 类型 = 小数 注释 = "对应 getEnvelope 里 V 向区间的 lowerBound; 片未创建返回 NaN。" 注释 = "实测 AcGe25: 与 U 向同步, 有边界时为 0, 缺省对象为 0。">
    {
        返回 (ARX几何底层.平面包络V下限 (对象指针))
    }

    方法 取包络V上限 <公开 类型 = 小数 注释 = "对应 getEnvelope 里 V 向区间的 upperBound; 片未创建返回 NaN。" 注释 = "实测 AcGe25: 与 U 向同步, 有边界时为 1, 缺省对象为 0。四个界都不含片的世界尺寸信息, 要尺寸请用 取点与两轴 的两条原始边。">
    {
        返回 (ARX几何底层.平面包络V上限 (对象指针))
    }

    方法 U向包络有界 <公开 类型 = 逻辑型 注释 = "对应 getEnvelope 里 U 向区间的 isBounded(); 片未创建返回假。" 注释 = "实测 AcGe25: 这是分辨缺省对象与真实有界片的第二条独立判据 —— 创建轴/创建三点/复制自/设轴 之后为真, 单独的 创建() 为假(此时四个界读数与 ARX平面 完全一致), 与 是否过点 那条判据互相印证。反转法向 之后照旧为真, 按矩阵变换(平移 10X、均匀缩放 3 倍)之后也照旧为真, 即本判据不随这些操作翻转。">
    {
        返回 (ARX几何底层.平面包络U有界 (对象指针) == 1)
    }

    方法 V向包络有界 <公开 类型 = 逻辑型 注释 = "对应 getEnvelope 里 V 向区间的 isBounded(); 片未创建返回假。" 注释 = "实测 AcGe25: 与 U向包络有界 同步, 本包量过的每一个对象(含未建立边界的缺省片与三种无限平面)都没有出现 U/V 一真一假的情形。">
    {
        返回 (ARX几何底层.平面包络V有界 (对象指针) == 1)
    }

    方法 U向闭合 <公开 类型 = 逻辑型 注释 = "对应 AcGeSurface::isClosedInU(), 问片的参数域 U 向首尾是否接合成一条缝; 片未创建返回假。" 注释 = "实测 AcGe25: 恒为假。缺省无边界的片、建立边界后的单位片/矩形片/二十倍大片/三点片/斜轴片, 以及 复制自 / 设轴 / 反转法向 / 平移 / 均匀缩放 之后全都报不闭合 —— 矩形片的对边不重合, 参数域首尾接不上。" 注释 = "与 U向包络有界 是两条互不替代的判据: 单位片 包络有界为真 而 U向闭合为假。基类口径与非虚分派见 ARX平面.U向闭合。">
    {
        返回 (ARX几何底层.平面U向闭合 (对象指针) == 1)
    }

    方法 V向闭合 <公开 类型 = 逻辑型 注释 = "对应 AcGeSurface::isClosedInV(), 问片的参数域 V 向首尾是否接合; 片未创建返回假。" 注释 = "实测 AcGe25: 与 U向闭合 逐档同步, 量过的每一档两个方向都是假; 口径见 U向闭合。">
    {
        返回 (ARX几何底层.平面V向闭合 (对象指针) == 1)
    }

    方法 取直线交点 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundedPlane::intersectWith(linearEnt, point), 写入已创建的 结果 点对象。对方 传 ARX直线3D、ARX线段3D 或 ARX射线3D 的 对象指针。" 注释 = "这是有界平面自己重声明的那一个, 与基类 AcGePlanarEnt 的同签名版本不是同一份实现。" 注释 = "实测 AcGe25: 先按无限面求交、再用本片边界裁 —— 交点在片内返回真并写点(过 (2,2) 的竖线交 矩形片 得 (2,2,3)); 交点在片外返回假, 但仍然把无限面交点写进了 结果(过 (10,10) 的竖线判假却写出 (10,10,3)); 直线躺在面内返回假且不碰 结果。判假时不要读 结果。对方是线段时按它所在的无限直线判, 不按端点截断: 从 z=10 走到 z=6、够不到片的竖段判假却照样写出 (2,2,3), 整个躺在面内的线段判假且不碰 结果。创建() 的缺省对象没有边界, 界外的竖线也照样判真, 并按它所在的 z=0 面给点(得 (10,10,0))。">
    参数 对方 <类型 = 变整数>
    参数 结果 <类型 = ARX点3D>
    {
        返回 (ARX几何底层.有界平面交直线 (对象指针, 对方, 结果.对象指针))
    }

    方法 取平面交线段 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundedPlane::intersectWith(plane, resultLineSeg), 结果线段写入已创建的 ARX线段3D 对象。" 注释 = "结果参数是具体类 AcGeLineSeg3d 引用, 类型固定为 ARX线段3D, 不能传直线。" 注释 = "实测 AcGe25: 相交返回真, 交线已按本片边界截成一段(矩形片 与 y=3.5 面 得 (3,3.5,3)-(1,3.5,3)); 交线落在片外、两平面平行或完全重合都返回假且不碰 结果, 脏值原样保留。端点次序与调用方向无关: 换成 对方侧 的 ARX平面.取有界平面交线段, 或三点构造的同一片交同一面, 都读出 起点(3,3.5,3)、终点(1,3.5,3) 这一组端点。创建() 的缺省对象没有边界时本方法仍返回真, 但写出的是零长线段 (0,3.5,0)-(0,3.5,0), 不能当交线用。">
    参数 对方 <类型 = ARX平面>
    参数 结果 <类型 = ARX线段3D>
    {
        返回 (ARX几何底层.有界平面交平面 (对象指针, 对方.对象指针, 结果.对象指针))
    }

    方法 取有界平面交线段 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundedPlane::intersectWith(boundedPlane, resultLineSeg), 两个边界一起决定结果线段的长短。" 注释 = "实测 AcGe25: 矩形片 与 横片 得 (3,3.5,3)-(1,3.5,3), 正好是矩形片的整条宽, 说明结果被两片同时裁住; 把 横片 抬高到交线落在它自己界外就返回假。共面、平行、交线在任一方界外三种情形都返回假且不动 结果。由 横片 侧反过来调用读出同一组端点, 次序与调用方向无关。">
    参数 对方 <类型 = ARX有界平面>
    参数 结果 <类型 = ARX线段3D>
    {
        返回 (ARX几何底层.有界平面交有界平面 (对象指针, 对方.对象指针, 结果.对象指针))
    }

