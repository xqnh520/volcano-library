    {
        返回 (ARX几何底层.全局向量容差 ())
    }
}

# ===

类 ARX矩阵3D <公开 注释 = "封装 ObjectARX AcGeMatrix3d: 齐次坐标空间中的通用三维变换矩阵。" 注释 = "元素下标从 0 到 3, 按 行/列 定位 entry[行][列], 与底层内存布局一致。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeMatrix3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建底层 AcGeMatrix3d, 内容等价于单位矩阵。">
    {
        对象指针 = ARX几何底层.新建矩阵 ()
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeMatrix3d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放矩阵 (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "用另一个已创建的矩阵覆盖本矩阵。">
    参数 源 <类型 = ARX矩阵3D>
    {
        返回 (ARX几何底层.矩阵复制 (对象指针, 源.对象指针))
    }

    方法 取元素 <公开 类型 = 小数 注释 = "读取 entry[行][列], 行或列越界时返回 NaN。">
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    {
        返回 (ARX几何底层.取矩阵元素 (对象指针, 行, 列))
    }

    方法 设元素 <公开 类型 = 逻辑型 注释 = "写入 entry[行][列], 行或列越界时返回假。">
