# ===

类 ARX矩阵2D <公开 注释 = "封装 ObjectARX AcGeMatrix2d: 二维齐次坐标变换矩阵, 用于 UCS、块内坐标与平面变换。" 注释 = "元素下标从 0 到 2, 按 行/列 定位 entry[行][列], 平移分量位于 entry[行][2], 与底层内存布局一致。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeMatrix2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建底层 AcGeMatrix2d, 内容等价于单位矩阵。">
    {
        对象指针 = ARX几何底层.新建矩阵2D ()
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeMatrix2d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放矩阵2D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "本矩阵是目标, 参数 源 是数据来源且必须已创建。">
    参数 源 <类型 = ARX矩阵2D>
    {
        返回 (ARX几何底层.矩阵2D复制 (对象指针, 源.对象指针))
    }

    方法 取元素 <公开 类型 = 小数 注释 = "读取 entry[行][列], 合法下标 0..2; 行或列越界时返回 NaN。">
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    {
        返回 (ARX几何底层.矩阵2D取元素 (对象指针, 行, 列))
    }

    方法 设元素 <公开 类型 = 逻辑型 注释 = "写入 entry[行][列], 合法下标 0..2; 行或列越界时返回假。">
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    参数 元素值 <类型 = 小数>
    {
        返回 (ARX几何底层.矩阵2D设元素 (对象指针, 行, 列, 元素值))
    }

    方法 设为单位 <公开 类型 = 逻辑型 注释 = "对应 setToIdentity。">
    {
        返回 (ARX几何底层.矩阵2D设单位 (对象指针))
    }

    方法 设为平移 <公开 类型 = 逻辑型 注释 = "对应 setToTranslation, 把矩阵重置为纯平移, 原有的旋转缩放分量会被丢弃。">
    参数 位移X <类型 = 小数>
    参数 位移Y <类型 = 小数>
    {
        返回 (ARX几何底层.矩阵2D设平移 (对象指针, 位移X, 位移Y))
    }

    方法 取平移 <公开 类型 = 逻辑型 注释 = "读取 本矩阵 的平移分量并写入参数对象; 参数对象必须已创建, 本矩阵保持不变。">
    参数 结果 <类型 = ARX向量2D>
    {
        返回 (ARX几何底层.矩阵2D取平移 (对象指针, 结果.对象指针))
    }

    方法 设为旋转 <公开 类型 = 逻辑型 注释 = "对应 setToRotation(angle, wrtPoint), 角度使用弧度, 缺省绕原点旋转。" 注释 = "二维平面只有绕 Z 轴(即平面内)旋转这一种情况, 因此不提供旋转轴参数。">
    参数 弧度 <类型 = 小数>
    参数 中心X <类型 = 小数 @默认值 = 0.0>
    参数 中心Y <类型 = 小数 @默认值 = 0.0>
    {
