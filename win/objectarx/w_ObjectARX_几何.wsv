# ===

类 ARX包围块3D <公开 注释 = "封装 ObjectARX AcGeBoundBlock3d: 三维平行六面体包围块, 由 基点 + 向一 + 向二 + 向三 参数化, 是 AcGeCurve3d::boundBlock / orthoBoundBlock 的返回类型。" 注释 = "使用前必须调用 创建(或 创建基向 / 接收包围块自 之一), 使用完毕后调用 释放 归还底层对象。" 注释 = "与 2D 兄弟类的差异: 本类没有点点对构造, 只有 set(点,点) 这个成员。" 注释 = "实测 AcGe25 三条口径同 2D: (1) isBox 与 type() 是实例状态, 缺省/基向构造即使轴对齐也是假, 曲线送来的块只有 orthoBoundBlock 为真, 且三维曲线送来的块类型编号恒为 62; 拷贝赋值连 type() 一起搬。 (2) contains 走 (基点, 向一, 向二, 向三) 参数空间闭区间, 不是几何包含。 (3) extend 按 isBox 选算法, 标志为假时会把旧 向一 挤进 向三 重排整个参数化。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeBoundBlock3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundBlock3d(), 缺省构造。已存在时先释放旧对象。" 注释 = "实测: 缺省构造的块 isBox 为假。本类没有点点对构造, 要轴对齐长方体请用 设置两点 或 接收正交包围块自。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放包围块3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建包围块3D ()
        返回 (对象指针 != 0)
    }

    方法 创建基向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeBoundBlock3d(base, dir1, dir2, dir3), 平行六面体参数化构造。已存在时先释放旧对象。" 注释 = "实测: 这样构造出的块 isBox 恒为假, 即使三个方向正好轴对齐也不变。">
    参数 基X <类型 = 小数>
    参数 基Y <类型 = 小数>
    参数 基Z <类型 = 小数>
    参数 向一X <类型 = 小数>
    参数 向一Y <类型 = 小数>
    参数 向一Z <类型 = 小数>
    参数 向二X <类型 = 小数>
    参数 向二Y <类型 = 小数>
    参数 向二Z <类型 = 小数>
    参数 向三X <类型 = 小数>
    参数 向三Y <类型 = 小数>
    参数 向三Z <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放包围块3D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建包围块3D基向 (基X, 基Y, 基Z, 向一X, 向一Y, 向一Z, 向二X, 向二Y, 向二Z, 向三X, 向三Y, 向三Z)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeBoundBlock3d 对象并把 对象指针 归零。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放包围块3D (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
    {
        返回 (对象指针 != 0)
    }

    方法 复制自 <公开 类型 = 逻辑型 注释 = "对应 AcGeBoundBlock3d::operator=(const AcGeBoundBlock3d&), 源对象必须已创建且本对象也已创建。" 注释 = "实测: 拷贝赋值把底层 type() 一起搬过来, 三维块恒为 62。几何与 isBox 标志逐分量原样复制, 无归一化。">
