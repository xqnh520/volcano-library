<火山程序 类型 = "通常" 版本 = 1 />

包 火山.ObjectARX.几何 <注释 = "ObjectARX 2026 (R25) AcGe 几何库的火山视窗封装。本版本覆盖 AcGePoint3d、AcGeVector3d、AcGeMatrix3d、AcGePoint2d、AcGeVector2d、AcGeMatrix2d、AcGeLine2d、AcGeLineSeg2d、AcGeLine3d、AcGeLineSeg3d、AcGePlane、AcGeBoundedPlane、AcGeCircArc2d、AcGeCircArc3d、AcGeEllipArc2d、AcGeEllipArc3d、AcGePosition3d、AcGeRay2d、AcGeRay3d 与 AcGeTol。AcGeCurve2d 与 AcGeCurve3d 基类的曲线接口 (是否过参数、取周期、取面积、取退化类型、参数按长度、反转参数等) 已在两个圆弧类、两个椭圆弧类、四个直线/线段类与两个射线类上全部转发。全部数值均由 Autodesk 的 AcGe25 实现计算。" 注释 = "AcGeCurve3d::project / orthoProject 已按 取斜投影类型 / 取正投影类型 / 接收斜投影自 / 接收正投影自 四个方法封装在五个三维曲线类与 ARX点实体3D 上: 底层返回的 AcGeEntity3d* 一律不出桥, 在桥内还原具体类型、赋给同类型目标后就地释放。曲线投影后退化成点(编号 5 = AcGe::kPosition3d)的像四个三维叶曲线类都判假接不住, 由 ARX点实体3D 专门接收, 坐标再用 取坐标 交回 ARX点3D。AcGeBoundedPlane 已封成 ARX有界平面, AcGePlanarEnt::get 的两个重载也已作为 取点与两轴 / 取三点 同时挂在 ARX平面 与 ARX有界平面 上; AcGeSurface::getEnvelope(AcGeInterval&, AcGeInterval&) 也已按 取包络U下限 / 取包络U上限 / 取包络V下限 / 取包络V上限 / U向包络有界 / V向包络有界 六个读数挂在同一对类上 —— AcGeInterval 虽已另封成 ARX区间, 这条通道仍不把区间对象交出去, 两个区间在桥内摊平成小数, 与曲线一侧的 取区间下限 / 取区间上限 同一口径。实测这条 envelope 读的是归一化参数域 0..1(有边界时)或 0..0 开口(无限面与未建立边界的缺省片), 不含世界尺寸, 片有多大仍只能从 取点与两轴 读回的两条原始边复原。" 注释 = "AcGeSurface::isClosedInU 与 isClosedInV 已按 U向闭合 / V向闭合 挂在 ARX平面 与 ARX有界平面 这一对面类上, 走的是与 取包络* 同一通道同一口径: 两个函数都是 AcGeSurface 上的非虚成员, 平面族没有一个类重声明它们, 所以一次 arx_planar 上转就覆盖两个类; 带 AcGeTol 的重载刻意不接, 因为 ARX容差 在本库是只读的。" 注释 = "实测 AcGe25: 14 档对象两个方向恒假, 未创建与释放后按 -1 判假。本包把 SDK 全部导入库扫了一遍, 除平面族以外没有任何别的 AcGeSurface 派生类有导出符号(球面、环面、锥面只存在于头文件), 类库里造不出一个可闭合的面, 因此这对方法在封装面上取不到真值。按包十对恒假判定入口的同一处置保留方法、把恒假写进注释并作为断言用例固化, 它是口径而不是巧合。恒假与包络有界互不替代: 单位片 包络有界为真而闭合为假。" 注释 = "底层依赖: ObjectARX SDK inc / lib-x64 目录, 运行时需 acge25.dll。"
        注释 = "getSamplePoints 已按 取样点数 / 取样点 / 取样参数 三个读数挂在八个曲线类上: AcGePoint2dArray 与 AcGePoint3dArray 一律不出桥, 取样集在桥内每次读数时重建, 跨边界只有指针与标量; 参数数组的重载只在三维侧存在, 所以 取样参数 只挂在五个三维曲线类上。实测开口曲线给满 取样个数 个点, 整圆与整椭因末点与起点重合只给 取样个数 减 1 个。"
        注释 = "getSplitCurves 已按 取分割片类型 (类方法, 只问片是什么类) 与 接收分割片自 (实例方法, 把片收进本对象) 挂在十个曲线类上: 两片的 AcGeCurve2d* / AcGeCurve3d* 一律不出桥, 桥内用 type() 还原具体类、类型相符才赋值, 随后把两片就地释放 (射线也按 AcGeRay2d / AcGeRay3d 自己的类型释放, 不泄漏)。实测 AcGe25: 分割的片类型由源曲线决定, 有源两片同类 —— 线段给 22/23、圆弧与整圆给 10/11、椭圆弧与整椭圆给 16/17; 两档例外都与射线有关: 无限直线切出的两片同为射线 kRay2d(26) / kRay3d(27), 射线自己切出的是首片线段 22/23 加末片射线 26/27 (两片不同类)。包十九A 起了射线有类, 射线片有了接收者 —— 实测 无限直线的射线片交给 ARX射线2D 判真且收后区间仍读 0..0, 射线源的末片(26)交给 ARX射线2D 也判真(它随后读出方向 0.6,0.8); 片型与接收者不符时一律判假且不碰接收者, 因此 ARX直线2D 与 ARX直线3D 的 接收分割片自 仍恒假(两片是 26/27, 与 18/19 不符), 两条方法保留以维持曲线类形状一致。段的几何口径: 线段片重新参数化回 0..1, 圆弧与椭圆弧片沿用父曲线的角度子区间并保住圆心、半径、法向与长短半径, 整圆与整椭圆切出的片不再闭合; 只有参数落在区间两端、越界或源曲线退化时底层才把两片都留成空指针。分割不消耗源曲线, 也不碰被拒的接收者。"
        注释 = "部署要求: AcGe25.dll 依赖 AutoCAD 2026 安装目录下的同级运行库, 独立进程必须先把该目录加入 PATH 再启动, 否则加载失败。"
        @视窗.头文件搜寻目录 = "sdk\\inc\r\nnative"
        @视窗.库文件搜寻目录 = "sdk\\lib-x64"
        @视窗.外部头文件 = "native\\arx_ge_bridge.h"
        @视窗.外部源文件 = "native\\arx_ge_bridge.cpp"
        @视窗.外部库.x64 = "acge25.lib">

类 ARX几何底层 <注释 = "内部类: 直接映射 ObjectARX AcGe 的 C 桥接函数, 供本包其它类调用, 不建议外部直接使用。">
{
    方法 新建点 <公开 静态 类型 = 变整数 注释 = "对应 new AcGePoint3d(x, y, z)。" @嵌入式方法 = "">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ arx_ge_point_new(@<X>, @<Y>, @<Z>)
    }

    方法 释放点 <公开 静态 注释 = "对应 delete AcGePoint3d*。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_point_free(@<对象指针>)
    }

    方法 取点X <公开 静态 类型 = 小数 @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_point_x(@<对象指针>)
    }

    方法 取点Y <公开 静态 类型 = 小数 @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_point_y(@<对象指针>)
    }

    方法 取点Z <公开 静态 类型 = 小数 @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_point_z(@<对象指针>)
    }

    方法 置点坐标 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::set。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ (arx_ge_point_set(@<对象指针>, @<X>, @<Y>, @<Z>) != 0)
    }

    方法 点到点距离 <公开 静态 类型 = 小数 注释 = "对应 AcGePoint3d::distanceTo, 指针无效时返回 -1。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    {
        @ arx_ge_point_distance_to(@<对象指针>, @<另一点指针>)
    }

    方法 点近似相等 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::isEqualTo(使用 AcGe 默认容差)。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    {
        @ (arx_ge_point_is_equal_to(@<对象指针>, @<另一点指针>) != 0)
    }

    方法 点加向量 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::operator +=。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 向量指针 <类型 = 变整数>
    {
        @ (arx_ge_point_add_vector(@<对象指针>, @<向量指针>) != 0)
    }

    方法 点减向量 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::operator -=。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 向量指针 <类型 = 变整数>
    {
        @ (arx_ge_point_sub_vector(@<对象指针>, @<向量指针>) != 0)
    }

    方法 点减点 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::operator -, 结果写入已创建的向量指针。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    参数 结果向量指针 <类型 = 变整数>
    {
        @ (arx_ge_point_sub_point(@<对象指针>, @<另一点指针>, @<结果向量指针>) != 0)
    }

    方法 点改变换向量 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::asVector, 结果写入已创建的向量指针。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 结果向量指针 <类型 = 变整数>
    {
        @ (arx_ge_point_as_vector(@<对象指针>, @<结果向量指针>) != 0)
    }

    方法 点缩放 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::scaleBy。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 比例 <类型 = 小数>
    参数 基准X <类型 = 小数>
    参数 基准Y <类型 = 小数>
    参数 基准Z <类型 = 小数>
    {
        @ (arx_ge_point_scale_by(@<对象指针>, @<比例>, @<基准X>, @<基准Y>, @<基准Z>) != 0)
    }

    方法 点旋转 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGePoint3d::rotateBy(angle, axis, wrtPoint), 角度为弧度。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 弧度 <类型 = 小数>
    参数 轴X <类型 = 小数>
    参数 轴Y <类型 = 小数>
    参数 轴Z <类型 = 小数>
    参数 中心X <类型 = 小数>
    参数 中心Y <类型 = 小数>
    参数 中心Z <类型 = 小数>
    {
        @ (arx_ge_point_rotate_by(@<对象指针>, @<弧度>, @<轴X>, @<轴Y>, @<轴Z>, @<中心X>, @<中心Y>, @<中心Z>) != 0)
    }

    方法 点结构尺寸 <公开 静态 类型 = 整数 注释 = "返回 sizeof(AcGePoint3d)。" @嵌入式方法 = "">
    {
        @ arx_ge_point_struct_size()
    }

    方法 新建向量 <公开 静态 类型 = 变整数 注释 = "对应 new AcGeVector3d(x, y, z)。" @嵌入式方法 = "">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ arx_ge_vector_new(@<X>, @<Y>, @<Z>)
    }

    方法 释放向量 <公开 静态 注释 = "对应 delete AcGeVector3d*。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_vector_free(@<对象指针>)
    }

    方法 取向量X <公开 静态 类型 = 小数 @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_vector_x(@<对象指针>)
    }

    方法 取向量Y <公开 静态 类型 = 小数 @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_vector_y(@<对象指针>)
    }

    方法 取向量Z <公开 静态 类型 = 小数 @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_vector_z(@<对象指针>)
    }

    方法 置向量分量 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::set。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    参数 Z <类型 = 小数>
    {
        @ (arx_ge_vector_set(@<对象指针>, @<X>, @<Y>, @<Z>) != 0)
    }

    方法 向量长度 <公开 静态 类型 = 小数 注释 = "对应 AcGeVector3d::length。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_vector_length(@<对象指针>)
    }

    方法 向量长度平方 <公开 静态 类型 = 小数 注释 = "对应 AcGeVector3d::lengthSqrd。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ arx_ge_vector_length_sqrd(@<对象指针>)
    }

    方法 向量单位化 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::normalize。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_normalize(@<对象指针>) != 0)
    }

    方法 向量点积 <公开 静态 类型 = 小数 注释 = "对应 AcGeVector3d::dotProduct。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    {
        @ arx_ge_vector_dot_product(@<对象指针>, @<另一点指针>)
    }

    方法 向量叉积 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::crossProduct, 结果写入已创建的向量指针。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    参数 结果向量指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_cross_product(@<对象指针>, @<另一点指针>, @<结果向量指针>) != 0)
    }

    方法 向量夹角 <公开 静态 类型 = 小数 注释 = "对应 AcGeVector3d::angleTo, 返回弧度。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    {
        @ arx_ge_vector_angle_to(@<对象指针>, @<另一点指针>)
    }

    方法 向量平行 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::isParallelTo。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_is_parallel_to(@<对象指针>, @<另一点指针>) != 0)
    }

    方法 向量垂直 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::isPerpendicularTo。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_is_perpendicular_to(@<对象指针>, @<另一点指针>) != 0)
    }

    方法 向量取反 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::negate。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_negate(@<对象指针>) != 0)
    }

    方法 向量相加 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::operator +=。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 另一点指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_add(@<对象指针>, @<另一点指针>) != 0)
    }

    方法 向量数乘 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::operator *=。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 比例 <类型 = 小数>
    {
        @ (arx_ge_vector_scale(@<对象指针>, @<比例>) != 0)
    }

    方法 向量垂向 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::perpVector, 结果写入已创建的向量指针。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 结果向量指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_perp_vector(@<对象指针>, @<结果向量指针>) != 0)
    }

    方法 向量旋转 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::rotateBy(angle, axis), 角度为弧度。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 弧度 <类型 = 小数>
    参数 轴X <类型 = 小数>
    参数 轴Y <类型 = 小数>
    参数 轴Z <类型 = 小数>
    {
        @ (arx_ge_vector_rotate_by(@<对象指针>, @<弧度>, @<轴X>, @<轴Y>, @<轴Z>) != 0)
    }

    方法 向量旋转到矩阵 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::rotateTo(vec), 旋转轴用底层缺省值, 结果矩阵写入已创建的矩阵指针。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 目标指针 <类型 = 变整数>
    参数 结果矩阵指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_rotate_to(@<对象指针>, @<目标指针>, @<结果矩阵指针>) != 0)
    }

    方法 向量旋转到矩阵全参 <公开 静态 类型 = 逻辑型 注释 = "对应 AcGeVector3d::rotateTo(vec, axis), 结果矩阵写入已创建的矩阵指针。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 目标指针 <类型 = 变整数>
    参数 轴X <类型 = 小数>
    参数 轴Y <类型 = 小数>
    参数 轴Z <类型 = 小数>
    参数 结果矩阵指针 <类型 = 变整数>
    {
        @ (arx_ge_vector_rotate_to_axis(@<对象指针>, @<目标指针>, @<轴X>, @<轴Y>, @<轴Z>, @<结果矩阵指针>) != 0)
    }

    方法 向量平面上夹角 <公开 静态 类型 = 小数 注释 = "对应 AcGeVector3d::angleOnPlane(pln)。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 变整数>
    参数 平面指针 <类型 = 变整数>
    {
