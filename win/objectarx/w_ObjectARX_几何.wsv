        返回 (ARX几何底层.矩阵2D设对齐坐标系 (对象指针, 源原点X, 源原点Y, 源E0X, 源E0Y, 源E1X, 源E1Y, 目标原点X, 目标原点Y, 目标E0X, 目标E0Y, 目标E1X, 目标E1Y))
    }

    方法 是否保形 <公开 类型 = 逻辑型 注释 = "对应 isConformal 的返回值本身: 矩阵能拆成 比例 + 转角(可带一次镜像) 时为真; 矩阵未创建返回假。" 注释 = "四个读数 取保形比例 / 取保形转角 / 是否镜像保形 / 取保形反射轴 各自重跑一次底层调用, 与 ARX平面 那侧的包络六个读数同一口径。" 注释 = "实测 AcGe25: 单位阵/转30度/缩放2/纯平移/点镜像/直线镜像 六个用例全判真, 只把 entry[0][1] 置 1 的剪切判假; 平移列不参与判定。">
    {
        返回 (ARX几何底层.矩阵2D是否保形 (对象指针))
    }

    方法 取保形比例 <公开 类型 = 小数 注释 = "对应 isConformal 的 scale 出参; 矩阵未创建返回 NaN。" 注释 = "实测 AcGe25: 缩放2 读 2, 其余保形用例读 1; 保形判假时这个出参仍被写值 (剪切用例读到 1)。">
    {
        返回 (ARX几何底层.矩阵2D保形比例 (对象指针))
    }

    方法 取保形转角 <公开 类型 = 小数 注释 = "对应 isConformal 的 angle 出参; 矩阵未创建返回 NaN。" 注释 = "实测 AcGe25: 转 30 度读 0.523598775598299, 关于原点的点镜像读 PI 而不是 0; 保形判假时不写出参, 读到 NaN。">
    {
        返回 (ARX几何底层.矩阵2D保形转角 (对象指针))
    }

    方法 是否镜像保形 <公开 类型 = 逻辑型 注释 = "对应 isConformal 的 isMirror 出参; 矩阵未创建返回假。" 注释 = "实测 AcGe25: 六个保形用例里只有 设为直线镜像 判真; 关于点的镜像判假, 它被拆成 转角 PI 的旋转。">
    {
        返回 (ARX几何底层.矩阵2D保形镜像 (对象指针) == 1)
    }

    方法 取保形反射轴 <公开 类型 = 逻辑型 注释 = "对应 isConformal 的 reflex 出参, 写入已创建的 结果 二维向量对象; 矩阵或 结果 未创建返回假。" 注释 = "实测 AcGe25: 只有镜像那一路才写出参 (y=x 直线镜像得 (0.707106781186548,0.707106781186547)); 非镜像时底层返回真而反射轴被写成 NaN, 所以读它之前先看 是否镜像保形。">
    参数 结果 <类型 = ARX向量2D>
    {
        返回 (ARX几何底层.矩阵2D保形反射轴 (对象指针, 结果.对象指针))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeMatrix2d), 用于校验结构内存布局。">
    {
        返回 (ARX几何底层.矩阵2D结构尺寸 ())
    }
}

# ===

类 ARX直线2D <公开 注释 = "封装 ObjectARX AcGeLine2d: 二维无限直线, 由线上一点加方向定义, 对应 AutoCAD 的构造线/参照线。" 注释 = "判定类方法(是否平行/是否垂直/是否共线/取交点/近似等于)在 ObjectARX 里按 AcGeLinearEnt2d 基类引用接收参数, 直线与线段共用同一组接口, 因此这些方法的 对方 参数类型是 变整数, 直接传 ARX直线2D 或 ARX线段2D 的 对象指针 即可, 两者可混用。" 注释 = "AcGeCurve2d 基类的曲线接口在本类已全部转发: 是否过参数、取周期、取参数段长、参数按长度、取面积、到曲线距离、取曲线最近点、反转参数、取退化类型。" 注释 = "使用前必须调用 创建, 使用完毕后调用 释放 归还底层对象。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeLine2d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLine2d(), 创建一条未指定期望点与方向的缺省直线; 已存在时先释放旧对象。缺省内容见 取线上点 与 取方向 的实测注释。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放直线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建直线2D ()
        返回 (对象指针 != 0)
    }

    方法 创建过两点 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLine2d(pnt1, pnt2), 两点重合时底层会退化成一条方向不可靠的直线。">
    参数 甲X <类型 = 小数>
    参数 甲Y <类型 = 小数>
    参数 乙X <类型 = 小数>
    参数 乙Y <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.释放直线2D (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.新建直线2D过两点 (甲X, 甲Y, 乙X, 乙Y)
        返回 (对象指针 != 0)
    }

    方法 创建按方向 <公开 类型 = 逻辑型 注释 = "对应 new AcGeLine2d(pnt, vec)。">
