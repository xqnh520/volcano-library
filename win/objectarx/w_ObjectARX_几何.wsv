    }

    方法 设为乘积 <公开 类型 = 逻辑型 注释 = "对应 setToProduct(sclVec1, sclVec2), 本比例 = 左 * 右, 三个对象都必须已创建。" 注释 = "实测: (2,3) 与 (5,7) 写入第三个件得 (10,21), 两个操作数都不动; 左操作数就是本对象自己时判真且读数正确(别名安全)。任一侧无效判假且本件内容不动。">
    参数 左 <类型 = ARX比例2D>
    参数 右 <类型 = ARX比例2D>
    {
        返回 (ARX几何底层.比例2D设乘积 (对象指针, 左.对象指针, 右.对象指针))
    }

    方法 设为乘积系数 <公开 类型 = 逻辑型 注释 = "对应 setToProduct(sclVec, double), 本比例 = 源 * 系数。" 注释 = "实测: 源 (6,8) 配系数 0.5 得 (3,4), 源不动; 本件就是源时判真且写回正确。源或本件任一无效判假。">
    参数 源 <类型 = ARX比例2D>
    参数 系数 <类型 = 小数>
    {
        返回 (ARX几何底层.比例2D设乘积系数 (对象指针, 源.对象指针, 系数))
    }

    方法 求逆 <公开 类型 = 逻辑型 注释 = "对应 invert(), 就地逐分量取倒数。" 注释 = "实测: (2,8) 得 (0.5, 0.125), 连求两次还原; 1e-11 得 100000000000; (-4,2) 得 (-0.25, 0.5); 含 0 的分量得 正无穷 且仍判真(0 档不拦), 正无穷分量再求逆回 0; 句柄无效判假。">
    {
        返回 (ARX几何底层.比例2D求逆 (对象指针))
    }

    方法 取逆 <公开 类型 = 逻辑型 注释 = "对应 inverse() 的返回值写进 结果, 本比例保持不变; 两个对象都必须已创建。" 注释 = "实测: 源 (4,9) 得 结果 (0.25, 0.111111111111111) 且源不动; 结果 与源是同一对象时判真并按同一口径取逆; 源含 0 时 结果 读 正无穷 仍判真; 源或结果任一无效判假且不碰出参。">
    参数 结果 <类型 = ARX比例2D>
    {
        返回 (ARX几何底层.比例2D取逆到 (对象指针, 结果.对象指针))
    }

    方法 是否相等 <公开 类型 = 逻辑型 注释 = "对应 operator==; 头文件第 102-106 行是 inline 转发到 isEqualTo 的缺省容差档。" 注释 = "实测: 差 1e-9 与差 1e-4 都判假(gTol 向量容差实测为 0, 缺省档就是逐位比); 两侧同为 NaN 判假; 任一句柄无效判假。">
    参数 对方 <类型 = ARX比例2D>
    {
        返回 (ARX几何底层.比例2D相等 (对象指针, 对方.对象指针))
    }

    方法 是否不等 <公开 类型 = 逻辑型 注释 = "对应 operator!=; 头文件第 110-114 行是 isEqualTo 的逻辑取反。" 注释 = "实测: 与 是否相等 严格互补(两侧同 NaN 时它判真), 但任一句柄无效时两条都判假, 所以不能把本方法当 是否相等 取反用。">
    参数 对方 <类型 = ARX比例2D>
    {
        返回 (ARX几何底层.比例2D不等 (对象指针, 对方.对象指针))
    }

    方法 是否近似相等 <公开 类型 = 逻辑型 注释 = "对应 isEqualTo(scaleVec) 的缺省容差档, 按无穷范数比较。" 注释 = "实测: SDK 只有这一条比较实现, 因此与 是否相等 与 是否不等 三档同判, 差 1e-4 就判假; 带 AcGeTol 的档位桥侧没有导入符号, 公开面不提供调用方指定容差的形式。">
    参数 对方 <类型 = ARX比例2D>
    {
        返回 (ARX几何底层.比例2D容差等 (对象指针, 对方.对象指针))
    }

    方法 是否成比例 <公开 类型 = 逻辑型 注释 = "对应 isProportional() 的缺省容差档: 判两个分量彼此是否相等, 也就是能否当均匀缩放用。" 注释 = "实测: (2,2)、(-2,-2)、(0,0)、创建统一(任何有限值) 判真; (2,3)、(2,4)、(0,2) 判假; 含 NaN 或 正无穷 分量的件判假; 句柄无效判假。">
    {
        返回 (ARX几何底层.比例2D成比例 (对象指针))
    }

    方法 是否恒等 <公开 类型 = 逻辑型 注释 = "对应 isEqualTo(AcGeScale2d::kIdentity), 桥内直接与常量比较。" 注释 = "实测: (1,1)、创建()、创建恒等()、创建统一(1) 判真; (1, 1+1e-9)、(0,0)、创建统一(-2)、含 NaN 与 正无穷 的件全判假。">
    {
        返回 (ARX几何底层.比例2D恒等 (对象指针))
    }

    方法 取矩阵 <公开 类型 = 逻辑型 注释 = "对应 getMatrix(mat), 把本比例铺成二维齐次对角矩阵写进已创建的 结果矩阵。" 注释 = "实测: (2,3) 得 entry[0][0]=2、entry[1][1]=3、entry[2][2]=1, 其余六格 0; 与 SDK 的 operator AcGeMatrix2d() 九个元素逐位一致, 按裁定只保留本入口。本比例与 结果矩阵 任一无效判假且不碰出参。">
    参数 结果矩阵 <类型 = ARX矩阵2D>
    {
        返回 (ARX几何底层.比例2D取矩阵 (对象指针, 结果矩阵.对象指针))
    }

    方法 抽取自矩阵 <公开 类型 = 逻辑型 注释 = "对应 extractScale(mat), 把矩阵的缩放分量抽进本比例; 本比例原有值一律不参与, 矩阵不被修改。" 注释 = "实测的二维符号规则: 分量X = 行列式符号 × 第一列长度, 分量Y = 第二列长度(恒正)。diag(2,3) 得 (2,3); diag(2,-3) 得 (-2,3); diag(-1,-1) 行列式正 得 (1,1); 副对角行列式负 得 (-1,1); 旋转阵 得 (1.4142135623731, 1.4142135623731); 纯平移阵 得 (1,1); 镜像 diag(-2,3) 得 (-2,3); 剪切阵 得 (2, 3.16227766016838); 奇异阵 得 (0,0); NaN 阵 得 (非数, 1)。抽取前后矩阵的行列式与对角元都逐位不动。">
    参数 源矩阵 <类型 = ARX矩阵2D>
    {
        返回 (ARX几何底层.比例2D抽取自矩阵 (对象指针, 源矩阵.对象指针))
    }

    方法 从矩阵去除 <公开 类型 = 逻辑型 注释 = "对应 removeScale(mat), 会同时改本对象与 目标矩阵: 先把本对象覆写成刚从该矩阵抽出的比例, 再把矩阵每一列除以对应分量。" 注释 = "实测: 纯缩放 diag(2,3) 去除后本件得 (2,3)、矩阵变单位阵; 剪切阵去除后 entry[0][0]=1、entry[0][1]=0.316227766016838、entry[1][1]=0.948683298050514、entry[2][2]=1; 本件原为 (0,3) 时同样判真、矩阵变 diag(1,1), 没有除零路径; 恒等件去除后矩阵对角仍 1。本件与矩阵任一无效判假且不碰矩阵。">
    参数 目标矩阵 <类型 = ARX矩阵2D>
    {
        返回 (ARX几何底层.比例2D从矩阵去除 (对象指针, 目标矩阵.对象指针))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeScale2d), 用于校验结构内存布局。" 注释 = "实测 AcGe25: 16 字节, 就是 sx 与 sy 两个 double。">
    {
        返回 (ARX几何底层.比例2D结构尺寸 ())
    }
}

# ===

类 ARX比例3D <公开 注释 = "封装 ObjectARX AcGeScale3d: 三维缩放变换, 结构里只有 sx、sy、sz 三个裸 double(gescl3d.h 第 82 行), 不在 AcGeEntity 与 AcGeCurve 的继承链上, 与 ARX矩阵3D 的缩放分量那一片同源。本包二十的公开类, 类库里第 30 个公开类。" 注释 = "本类不提供 取类型编号: gescl3d.h 全文没有 type() 成员, 也没有任何曲线与实体接口, 判形状只能问 是否恒等 与 是否成比例 两条。" 注释 = "结构实测 AcGe25: sizeof(AcGeScale3d) = 24, kIdentity 读 (1, 1, 1); 类内没有声明析构与赋值运算符, 拷贝构造与赋值都是编译器生成的平凡形式, 所以是真值语义 —— 改副本不带动原件。" 注释 = "头文件第 99-100 行写明 operator[] 的口径: sx 是 0、sy 是 1、sz 是 2, 实现是 inline *(&sx+i) 因而自身不校验下标, 越界拦截全部在桥内: 实测 下标 3 与 -1 读非数, 写越界判假且 分量Z 仍读 8。写 NaN 与 0 都放行 —— 实测 写[1]=非数 判真且 分量Y 读非数、分量Z 不动, 设置(0, 0, 0) 判真且 分量Z 读 0, 底层不管。" 注释 = "gescl3d.h 第 15-16 行的契约写着『分量不得为 0 或近 0(在浮点容差内)』, 但底层不强制: 实测 (0,2,3) 求逆 判真 且 分量X 读 正无穷、(0,0,0) 求逆 判真 且 分量X 与 分量Z 都读 正无穷, 不抛不拦, 库层按同一裁定也不拦, 契约由调用方自己守。" 注释 = "构造四档实测: 创建() 造出 (1, 1, 1), 三个新建件的 分量X、分量Y、分量Z 都逐位读到 1 且 是否恒等 判真; 创建统一(2.5) 读到 分量X = 2.5 与 分量Z = 2.5; 创建分量(3, 0.5, 7) 三个分量原样读回 3、0.5、7; 创建恒等() 读到 分量X = 1 与 分量Z = 1 且 是否恒等 判真; 创建拷贝 的 源 句柄传 0 时回 0 句柄(句柄非0 判假)、本对象保持未创建, 源有效时读到 分量X = 3 与 分量Z = 7 且与原件 是否相等 判真。" 注释 = "比较三档在 SDK 里本就是同一条 isEqualTo(gescl3d.h 第 85-97 行两个 inline 转发), 实测同值一件上三条读数是 相等 真 / 不等 假 / 近似相等 真; 差 1e-4 落在 Z 侧时 相等 与 近似相等 都判假, 差 1e-9 落在 X 侧时 近似相等 判假; 两侧同为 NaN 时 相等 假、不等 真、近似相等 假。但句柄无效时 是否相等 与 是否不等 双双判假, 不能把后者当成前者取反。" 注释 = "SDK 的带 AcGeTol 档(gescl3d.h 第 58 行与第 64-65 行)在桥侧没有导入符号, 公开面只走缺省 gTol。实测 AcGe25 的 gTol 点容差与向量容差都是 0, 所以缺省档等价于逐位严格比较; 探针另证这一族吃的是向量容差而不是点容差 —— 差 1e-4 时只填向量容差 1e-3 判真、只填点容差 1e-3 判假, 只填向量容差 1e-5 与只填点容差 1e-12 配差 1e-9 都判假, 也就是按头文件第 60 行的无穷范数逐分量比。" 注释 = "是否成比例 判的是三个分量彼此是否相等: 实测 (2,2,2)、(-2,-2,-2)、(0,0,0)、创建统一(-2) 判真; (2,3,4)、(2,4,8) 判假; 含 NaN 的件与含 正无穷 分量的件判假; 句柄无效判假。是否恒等 只认 (1,1,1): (1,1,1)、创建()、创建恒等()、创建统一(1) 判真; (1,1,1+1e-9)、(1,1,2)、(0,0,0)、创建统一(-2)、含 NaN 的件、含 正无穷 分量的件全判假。" 注释 = "乘法族四条按分量逐位相乘且口径一致: 源 (2,3,4) 对 (5,7,11) 实测 乘以 与 设为乘积 档读到 分量X = 10、分量Z = 44, 左乘 与 右乘 档读到 分量X = 10、分量Y = 21; 乘以系数(4) 后 分量Z 读 16, 紧接着 乘以系数(0) 后 分量X 读 0; 设为乘积系数(0.5) 后 分量X 读 3、分量Z 读 5。乘比例 算完 对方 的 分量X 仍读 5; 出口件就是左操作数自己时 设为乘积 判真且读到 分量X = 10、分量Z = 44(别名档)。" 注释 = "求逆是逐分量取倒数: (2,8,16) 实测 分量X = 0.5、分量Z = 0.0625; (4,9,16) 的 取逆 三槽读 (0.25, 0.111111111111111, 0.0625); 含 0 的分量得 正无穷 且仍判真(0 档不拦) —— (0,2,3) 读 分量X = 正无穷 与 分量Y = 0.5, (0,0,0) 读 分量X 与 分量Z 都是 正无穷; 统一(-2) 的件求逆后 分量X 读 -0.5, 负分量照取倒数; 正无穷分量再求逆 分量X 回 0、分量Y 读 2, 正无穷乘 0 得非数; (NaN,1,1) 判真且 分量X 留非数、分量Z 仍读 1。取逆 的 结果 必须是已创建对象, 源 分量X 不动; 结果 与源是同一对象时判真且三槽读数与就地档一致。" 注释 = "取矩阵 只写对角: (2,3,4) 的十六格读到 entry[0][0]=2、entry[1][1]=3、entry[2][2]=4、entry[3][3]=1, 其余十二格实测为 0; 与 SDK 的 operator AcGeMatrix3d() 逐格比对, 十六格 两档逐位一致 全判真, 按裁定只开 取矩阵 一条入口, 转换运算符不镜像。含 NaN 的件判真并写出 entry[0][0] 非数、entry[3][3] 仍是 1。" 注释 = "抽取自矩阵 的三维符号规则与二维那一侧相反, 实测为: 分量X 与 分量Y = 各自列长度(恒正、不看符号), 分量Z = 行列式符号 × 第三列长度。负 列0 就是这个差口的直接证据: 列0=(-2,-1) 的二维矩阵读到 分量X = -2.23606797749979, 列0=(-2,-1,0) 的三维矩阵读到 分量X = 2.23606797749979。坐实用例(只列真读到的槽位): diag(2,3,4) 三槽读 (2, 3, 4); diag(2,-3,-4) 行列式正 三槽读 (2, 3, 4); diag(-1,1,1)、diag(1,-1,1)、diag(-1,-1,-1) 行列式负 三槽都读 (1, 1, -1); diag(-1,1,-1) 行列式正而 z 对角元为负 三槽仍读 (1, 1, 1), diag(-1,-1,1) 同样只读到 分量X = 1 与 分量Z = 1; diag(-2,1,1) 行列式负 读到 分量X = 2 与 分量Z = -1 —— 符号取自行列式而不是该对角元; 列2=(0,0,-4) 读到 分量Z = -4 与 分量Y = 1; 列2=(3,0,-4) 读到 分量Z = -5; 列0=(0,-1,0) 读到 分量X = 1.4142135623731 与 分量Y = 1; 纯平移阵 读到 分量X = 1 与 分量Z = 1; 镜像阵 读到 分量X = 2(二维同型矩阵读 -2); 剪切阵 读到 分量X = 2 与 分量Y = 3.16227766016838; 全零阵 读到 分量X = 0 与 分量Z = 0。本档不改矩阵: 抽取前后 行列式不变, 纯缩放阵 抽取后 (0,0) 仍是 2, 负 列0 的阵 抽取后 (0,0) 仍是 -2, 列2=(3,0,-4) 的阵 抽取后 (0,2) 仍是 3。" 注释 = "从矩阵去除 会同时改本对象与矩阵: 先把本对象覆写成刚从该矩阵抽出的比例, 再把矩阵每一列除以对应分量 —— 实测本件调用前被写成 (-98765, -98765, -98765) 的哨兵值, 调用后 分量X 与 分量Z 读的都是该矩阵抽出的比例, 原值不参与。纯缩放 diag(2,3,4) 去除后本件读 分量X = 2 与 分量Z = 4、entry[0][0]、entry[1][1]、entry[2][2]、entry[3][3] 全部变 1; 剪切阵去除后 entry[0][0]=1、entry[0][1]=0.316227766016838、entry[1][1]=0.948683298050514、entry[2][2]=1 且本件 分量X 读 2; 本件原为 (0, 3, 4) 时同样判真、entry[0][0] 与 entry[1][1] 变 1, 走的是刚抽出的比例而不是含 0 的原值, 没有除零路径。" 注释 = "复制自 是真值语义: 复制后改源的分量, 副本的 分量Z 不动; 目标或源任一句柄无效判假; 自己赋给自己判真且 分量Z 仍读 7; 拷贝件与原件 是否相等 与 是否近似相等 都判真。" 注释 = "句柄无效时的全线口径: 写档与判档一律假, 读数档回非数; 出参侧实测到 取矩阵、取逆到 与 转换档 在任一侧句柄无效时判假; 失败乘比例、失败取逆到、失败抽取之后本件 分量X 仍读 2, 内容不动; 释放(0) 什么都不做也不崩。" 注释 = "三条不镜像的 SDK 接口按裁定记录在案: 四条 const 乘法(operator*(比例,比例)、operator*(比例,系数)、operator*(系数,比例) 与 friend)有导入符号但不镜像, 与 ARX矩阵3D 的镜像同一口径 —— 只开 *= / preMultBy / postMultBy / setToProduct, 乘积一律以本对象为出口; gescl3d.h 第 75 行的 operator AcGeMatrix3d() 与 getMatrix 实测逐位同值, 只留 取矩阵; 三维这一侧头文件里根本没有通往 AcGeScale2d 的向下转换, 降档只能由调用方自己丢 Z 分量。" 注释 = "底层依赖: ObjectARX SDK inc/gescl3d.h、acge25.lib 与 acge25.dll, 桥导出前缀 arx_ge_sc3_, 底层透传前缀 比例3D。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "底层 AcGeScale3d 对象地址, 0 表示尚未创建。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "对应 new AcGeScale3d(), 缺省构造。已存在时先释放旧对象。" 注释 = "实测: 缺省构造就是恒等件 (1, 1, 1), 三个新建件逐位相同, 是否恒等 判真。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.比例3D释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.比例3D新建 ()
        返回 (对象指针 != 0)
    }

    方法 创建统一 <公开 类型 = 逻辑型 注释 = "对应 new AcGeScale3d(factor), 三个分量取同一个值。已存在时先释放旧对象。" 注释 = "实测: 创建统一(2.5) 读到 分量X = 2.5 与 分量Z = 2.5; 创建统一(-2) 的 分量X 读 -2 且 取矩阵 后 entry[0][0] 读 -2, 该件 是否成比例 判真而 是否恒等 判假。">
    参数 比例 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.比例3D释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.比例3D新建统一 (比例)
        返回 (对象指针 != 0)
    }

    方法 创建分量 <公开 类型 = 逻辑型 注释 = "对应 new AcGeScale3d(xFact, yFact, zFact)。已存在时先释放旧对象。" 注释 = "实测: 创建分量(3, 0.5, 7) 三个分量原样读回 3、0.5、7。">
    参数 X比例 <类型 = 小数>
    参数 Y比例 <类型 = 小数>
    参数 Z比例 <类型 = 小数>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.比例3D释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.比例3D新建分量 (X比例, Y比例, Z比例)
        返回 (对象指针 != 0)
    }

    方法 创建恒等 <公开 类型 = 逻辑型 注释 = "对应 new AcGeScale3d(AcGeScale3d::kIdentity)。已存在时先释放旧对象。" 注释 = "实测: 读到 分量X = 1 与 分量Z = 1, 且 是否恒等 判真, 与 创建() 的缺省件走同一条判据。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.比例3D释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.比例3D新建恒等 ()
        返回 (对象指针 != 0)
    }

    方法 创建拷贝 <公开 类型 = 逻辑型 注释 = "对应 new AcGeScale3d(const AcGeScale3d&), 源对象必须已创建。已存在时先释放旧对象。" 注释 = "实测: 源有效时读到 分量X = 3 与 分量Z = 7, 拷贝件与原件 是否相等 与 是否近似相等 都判真; 源句柄传 0 时回 0 句柄(句柄非0 判假)、本对象保持未创建。">
    参数 源 <类型 = ARX比例3D>
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.比例3D释放 (对象指针)
            对象指针 = 0
        }
        对象指针 = ARX几何底层.比例3D新建拷贝 (源.对象指针)
        返回 (对象指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁底层 AcGeScale3d 对象并把 对象指针 归零。句柄为 0 时什么都不做, 实测不崩。">
    {
        如果 (对象指针 != 0)
        {
            ARX几何底层.比例3D释放 (对象指针)
            对象指针 = 0
        }
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "底层对象是否已创建。">
