    参数 原点X <类型 = 小数 @默认值 = 0.0>
    参数 原点Y <类型 = 小数 @默认值 = 0.0>
    参数 原点Z <类型 = 小数 @默认值 = 0.0>
    参数 XX <类型 = 小数 @默认值 = 1.0>
    参数 XY <类型 = 小数 @默认值 = 0.0>
    参数 XZ <类型 = 小数 @默认值 = 0.0>
    参数 YX <类型 = 小数 @默认值 = 0.0>
    参数 YY <类型 = 小数 @默认值 = 1.0>
    参数 YZ <类型 = 小数 @默认值 = 0.0>
    参数 ZX <类型 = 小数 @默认值 = 0.0>
    参数 ZY <类型 = 小数 @默认值 = 0.0>
    参数 ZZ <类型 = 小数 @默认值 = 1.0>
    {
        返回 (ARX几何底层.矩阵设坐标系 (对象指针, 原点X, 原点Y, 原点Z, XX, XY, XZ, YX, YY, YZ, ZX, ZY, ZZ))
    }

    方法 取坐标系 <公开 类型 = 逻辑型 注释 = "对应 getCoordSystem, 四个结果对象都必须已创建。">
    参数 原点 <类型 = ARX点3D>
    参数 X轴 <类型 = ARX向量3D>
    参数 Y轴 <类型 = ARX向量3D>
    参数 Z轴 <类型 = ARX向量3D>
    {
        返回 (ARX几何底层.矩阵取坐标系 (对象指针, 原点.对象指针, X轴.对象指针, Y轴.对象指针, Z轴.对象指针))
    }

    方法 设为对齐坐标系 <公开 类型 = 逻辑型 注释 = "对应 setToAlignCoordSys(fromOrigin, fromXAxis, fromYAxis, fromZAxis, toOrigin, toXAxis, toYAxis, toZAxis), 结果为把源坐标系映射到目标坐标系的三维变换矩阵。" 注释 = "实测 AcGe25: 目标三个轴进矩阵的列、目标原点进平移列; 源轴带长度时长度被折成缩放 (源轴 2/3/4 配世界目标得 diag(0.5,0.333333333333333,0.25)); 源原点 (1,1,1) 配目标原点 0 折成 -1 平移; 世界->世界 得单位阵。">
    参数 源原点X <类型 = 小数>
    参数 源原点Y <类型 = 小数>
    参数 源原点Z <类型 = 小数>
    参数 源X轴X <类型 = 小数>
    参数 源X轴Y <类型 = 小数>
    参数 源X轴Z <类型 = 小数>
    参数 源Y轴X <类型 = 小数>
    参数 源Y轴Y <类型 = 小数>
    参数 源Y轴Z <类型 = 小数>
    参数 源Z轴X <类型 = 小数>
    参数 源Z轴Y <类型 = 小数>
    参数 源Z轴Z <类型 = 小数>
    参数 目标原点X <类型 = 小数>
    参数 目标原点Y <类型 = 小数>
    参数 目标原点Z <类型 = 小数>
    参数 目标X轴X <类型 = 小数>
    参数 目标X轴Y <类型 = 小数>
    参数 目标X轴Z <类型 = 小数>
    参数 目标Y轴X <类型 = 小数>
    参数 目标Y轴Y <类型 = 小数>
    参数 目标Y轴Z <类型 = 小数>
    参数 目标Z轴X <类型 = 小数>
    参数 目标Z轴Y <类型 = 小数>
    参数 目标Z轴Z <类型 = 小数>
    {
        返回 (ARX几何底层.矩阵设对齐坐标系 (对象指针, 源原点X, 源原点Y, 源原点Z, 源X轴X, 源X轴Y, 源X轴Z, 源Y轴X, 源Y轴Y, 源Y轴Z, 源Z轴X, 源Z轴Y, 源Z轴Z, 目标原点X, 目标原点Y, 目标原点Z, 目标X轴X, 目标X轴Y, 目标X轴Z, 目标Y轴X, 目标Y轴Y, 目标Y轴Z, 目标Z轴X, 目标Z轴Y, 目标Z轴Z))
    }

    方法 取结构尺寸 <公开 静态 类型 = 整数 注释 = "返回底层 sizeof(AcGeMatrix3d), 用于校验结构内存布局。">
    {
        返回 (ARX几何底层.矩阵结构尺寸 ())
    }
