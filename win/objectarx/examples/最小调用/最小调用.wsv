<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

类 启动类 <公开 基础类 = 窗口程序类>
{
    变量 主窗口对象 <类型 = 最小示例窗口>

    方法 启动方法 <公开 类型 = 整数>
    {
        主窗口对象.创建主窗口 ()
        返回 (1)
    }
}

类 最小示例窗口 <基础类 = 窗口 注释 = "从用户模块 ObjectARX几何 取用的最小示例: 只用 点3D 的创建/读数/距离/释放, 证明模块路径解析、桥接源编译与 acge25 链接全部成立。" @视窗.布局 = "client_size = \"480, 320\"" 标题 = "ObjectARX模块最小示例">
{
    变量 日志框 <类型 = 编辑框 隐藏值属性 = "0" @视窗.布局 = "id = 101\r\npos = \"12, 12, 456, 296\"" 是否允许多行 = 真 滚动条 = 横向及纵向滚动条>

    方法 最小示例窗口_创建完毕 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = 最小示例窗口>
    参数 标记值 <类型 = 整数>
    {
        运行示例 ()
        返回 (0)
    }

    方法 运行示例
    {
        变量 甲 <类型 = ARX点3D>
        变量 乙 <类型 = ARX点3D>
        变量 默认容差 <类型 = 小数>
        变量 容差为正 <类型 = 逻辑型>
        日志框.加入文本行 ("=== ObjectARX几何 用户模块最小示例 ===")
        如果 (甲.创建 (0.0, 0.0, 0.0) == 假)
        {
            日志框.加入文本行 ("失败: ARX点3D.创建 返回假")
            返回 ()
        }
        乙.创建 (3.0, 4.0, 0.0)
        日志框.加入文本行 ("甲.是否有效 = " + 到文本 (甲.是否有效 ()))
        日志框.加入文本行 ("乙.横坐标 = " + 到文本 (乙.横坐标))
        日志框.加入文本行 ("乙.纵坐标 = " + 到文本 (乙.纵坐标))
        日志框.加入文本行 ("甲.到点距离(乙) = " + 到文本 (甲.到点距离 (乙)))
        默认容差 = ARX容差.取默认点容差 ()
        容差为正 = 默认容差 > 0
        日志框.加入文本行 ("默认点容差 大于 0 = " + 到文本 (容差为正))
        日志框.加入文本行 ("(到文本 会把小数截断, 所以不直接打印 默认容差)")
        甲.释放 ()
        乙.释放 ()
        日志框.加入文本行 ("释放后 甲.是否有效 = " + 到文本 (甲.是否有效 ()))
        日志框.加入文本行 ("=== 示例结束 ===")
    }
}
