类 AnyCAD基础_材质模板 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.MaterialTemplate。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 添加定义 <公开 静态 注释 = "添加定义。参数 键=文本型; 值=文本型。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_材质模板句柄">
    参数 键 <类型 = 文本型 注释 = "key">
    参数 值 <类型 = 文本型 注释 = "value">
    {
        @ af_material_template_add_define((void*)@<句柄>, @<键>.GetText(), @<值>.GetText())
    }

    方法 添加映射_文本型 <公开 静态 注释 = "添加映射_文本型。参数 映射标识=文本型; encodeing=整数; 映射关系=整数。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_材质模板句柄">
    参数 映射标识 <类型 = 文本型 注释 = "mapId">
    参数 encodeing <类型 = 整数 注释 = "encodeing">
    参数 映射关系 <类型 = 整数 注释 = "mapping">
    {
        @ af_material_template_add_map((void*)@<句柄>, @<映射标识>.GetText(), @<encodeing>, @<映射关系>)
    }

    方法 添加映射_文本型_2 <公开 静态 注释 = "添加映射_文本型_2。参数 映射标识=文本型; encodeing=整数; 映射关系=整数; 面尺寸=整数。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_材质模板句柄">
    参数 映射标识 <类型 = 文本型 注释 = "mapId">
    参数 encodeing <类型 = 整数 注释 = "encodeing">
    参数 映射关系 <类型 = 整数 注释 = "mapping">
    参数 面尺寸 <类型 = 整数 注释 = "faceSize">
    {
        @ af_material_template_add_map_2((void*)@<句柄>, @<映射标识>.GetText(), @<encodeing>, @<映射关系>, @<面尺寸>)
    }

    方法 强制转换 <公开 静态 类型 = 变整数 注释 = "强制转换。参数 obj=变整数句柄。返回新句柄, 用完必须调用 AnyCAD基础_材质模板.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 obj <类型 = 变整数 注释 = "obj">
    {
        @ (intptr_t)(af_material_template_cast((void*)@<obj>))
    }

    方法 计算哈希代码 <公开 静态 类型 = 文本型 注释 = "计算哈希代码。失败返回空文本并置错误码; 文本仅本次赋值有效, 不要缓存指针。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_材质模板句柄">
    {
        @ af_material_template_compute_hash_code((void*)@<句柄>)
    }

    方法 取透明度测试 <公开 静态 类型 = 整数 注释 = "取透明度测试。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
