    {
        @ (intptr_t)(af_sketch_element_ctor())
    }

    方法 创建_对象标识 <公开 静态 类型 = 变整数 注释 = "创建_对象标识: 构造新对象。参数 草图标识=变整数句柄。返回新句柄, 用完必须调用 AnyCAD设计_草图元素.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 草图标识 <类型 = 变整数 注释 = "sketchId">
    {
        @ (intptr_t)(af_sketch_element_ctor_2((void*)@<草图标识>))
    }

    方法 强制转换 <公开 静态 类型 = 变整数 注释 = "强制转换。参数 obj=变整数句柄。返回新句柄, 用完必须调用 AnyCAD设计_草图元素.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 obj <类型 = 变整数 注释 = "obj">
    {
        @ (intptr_t)(af_sketch_element_cast((void*)@<obj>))
    }

    方法 创建_文档 <公开 静态 类型 = 变整数 注释 = "创建_文档。参数 文档=变整数句柄。返回新句柄, 用完必须调用 AnyCAD设计_草图元素.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 文档 <类型 = 变整数 注释 = "pDoc">
    {
        @ (intptr_t)(af_sketch_element_create((void*)@<文档>))
    }

    方法 取类标识 <公开 静态 类型 = 变整数 注释 = "取类标识。返回新句柄, 用完必须调用 AnyCAD设计_草图元素.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD设计_草图元素句柄">
    {
        @ (intptr_t)(af_sketch_element_get_class_id((void*)@<句柄>))
    }

    方法 取约束状态 <公开 静态 类型 = 整数 注释 = "取约束状态。失败返回 -1 并置错误码。" 折叠 @嵌入式方法 = "">
