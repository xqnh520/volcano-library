        @ af_sketch_element_set_constraint_status((void*)@<句柄>, @<值>)
    }

    方法 置草图标识 <公开 静态 类型 = 整数 注释 = "置草图标识。参数 值=变整数句柄。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
