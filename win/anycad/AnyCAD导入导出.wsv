<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 文件导入导出。格式由扩展名决定: .step .stp .iges .igs .stl .brep。中文路径可直接使用 (桥接层内部走 ASCII 临时目录中转)。">

类 AnyCAD导入导出 <公开 注释 = "模型文件读写。中文目录与中文文件名都支持 (桥接层内部把路径映射到临时 ASCII 目录再回写)。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 打开文件 <公开 静态 类型 = 变整数 注释 = "按扩展名读取模型文件, 返回新形状句柄 (需用 AnyCAD形状.释放 () 归还); 文件不存在或格式不支持返回 0 并置错误码 1006, 可用 AnyCAD内核.取错误文本 () 查看详情。支持 .step .stp .iges .igs .stl .brep。" 折叠 @嵌入式方法 = "">
    参数 文件路径 <类型 = 文本型>
    {
        @ (intptr_t)ac_io_open(@<文件路径>.GetText())
    }

    方法 保存文件 <公开 静态 类型 = 整数 注释 = "按扩展名保存形状, 返回 1 成功 0 失败 (失败置错误码 1006: 扩展名不支持或无写权限)。支持 .step .stp .iges .igs .stl .brep。中文路径可用。用法要点: 先把返回值存进变量 (例如 结果 = AnyCAD导入导出.保存文件 (...)), 再单独调用 AnyCAD内核.取错误码 (); 火山表达式从右往左求值, 写在同一个表达式里会取到旧错误码。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 文件路径 <类型 = 文本型>
    {
        @ ac_io_save((void*)@<形状>, @<文件路径>.GetText())
    }
}
