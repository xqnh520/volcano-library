类 AnyCAD基础_图框控件 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.FrameWidget。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 开始拖动 <公开 静态 类型 = 整数 注释 = "开始拖动。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_图框控件句柄">
    {
        @ af_frame_widget_begin_drag((void*)@<句柄>)
    }

    方法 强制转换 <公开 静态 类型 = 变整数 注释 = "强制转换。参数 obj=变整数句柄。返回新句柄, 用完必须调用 AnyCAD基础_图框控件.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 obj <类型 = 变整数 注释 = "obj">
    {
        @ (intptr_t)(af_frame_widget_cast((void*)@<obj>))
    }

    方法 取中心 <公开 静态 类型 = 变整数 注释 = "取中心。返回新句柄, 用完必须调用 AnyCAD基础_图框控件.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_图框控件句柄">
    {
        @ (intptr_t)(af_frame_widget_get_center((void*)@<句柄>))
    }

    方法 取方向 <公开 静态 类型 = 变整数 注释 = "取方向。返回新句柄, 用完必须调用 AnyCAD基础_图框控件.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_图框控件句柄">
    {
        @ (intptr_t)(af_frame_widget_get_direction((void*)@<句柄>))
    }

