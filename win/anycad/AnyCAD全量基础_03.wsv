    }

    方法 取拖动夹点 <公开 静态 类型 = 长整数 注释 = "取拖动夹点。失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_可拖动控件句柄">
    {
