<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 全量封装 - 按程序集分域的分片 (自动生成, 请勿手改)。"
        @视窗.库文件搜寻目录.x64 = "native\\lib"
        @视窗.外部库.x64 = "AnyCADBridge.lib">

类 AnyCAD基础_可拖动控件 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.DraggableWidget。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 之前渲染 <公开 静态 注释 = "之前渲染。参数 ctx=变整数句柄。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_可拖动控件句柄">
    参数 ctx <类型 = 变整数 注释 = "ctx">
    {
        @ af_draggable_widget_before_rendering((void*)@<句柄>, (void*)@<ctx>)
    }

    方法 开始拖动 <公开 静态 类型 = 整数 注释 = "开始拖动。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_可拖动控件句柄">
    {
        @ af_draggable_widget_begin_drag((void*)@<句柄>)
    }

    方法 强制转换 <公开 静态 类型 = 变整数 注释 = "强制转换。参数 obj=变整数句柄。返回新句柄, 用完必须调用 AnyCAD基础_可拖动控件.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 obj <类型 = 变整数 注释 = "obj">
    {
        @ (intptr_t)(af_draggable_widget_cast((void*)@<obj>))
    }

    方法 拖动 <公开 静态 类型 = 整数 注释 = "拖动。参数 拾取=变整数句柄。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_可拖动控件句柄">
    参数 拾取 <类型 = 变整数 注释 = "pick">
    {
        @ af_draggable_widget_dragging((void*)@<句柄>, (void*)@<拾取>)
