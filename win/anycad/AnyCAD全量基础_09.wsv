类 AnyCAD基础_灯光 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.Light。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建: 构造新对象。参数 clr=变整数句柄。返回新句柄, 用完必须调用 AnyCAD基础_灯光.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 clr <类型 = 变整数 注释 = "clr">
    {
        @ (intptr_t)(af_light_ctor((void*)@<clr>))
    }

    方法 强制转换 <公开 静态 类型 = 变整数 注释 = "强制转换。参数 obj=变整数句柄。返回新句柄, 用完必须调用 AnyCAD基础_灯光.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 obj <类型 = 变整数 注释 = "obj">
    {
        @ (intptr_t)(af_light_cast((void*)@<obj>))
    }

    方法 取类型转换阴影 <公开 静态 类型 = 整数 注释 = "取类型转换阴影。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_灯光句柄">
    {
        @ af_light_get_cast_shadow((void*)@<句柄>)
    }

    方法 取颜色 <公开 静态 类型 = 变整数 注释 = "取颜色。返回新句柄, 用完必须调用 AnyCAD基础_灯光.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_灯光句柄">
    {
        @ (intptr_t)(af_light_get_color((void*)@<句柄>))
    }

    方法 取强度 <公开 静态 类型 = 小数 注释 = "取强度。失败返回 NaN (值 != 值)。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_灯光句柄">
    {
        @ af_light_get_intensity((void*)@<句柄>)
    }

    方法 取位置 <公开 静态 类型 = 变整数 注释 = "取位置。返回新句柄, 用完必须调用 AnyCAD基础_灯光.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_灯光句柄">
    {
        @ (intptr_t)(af_light_get_position((void*)@<句柄>))
    }

    方法 置类型转换阴影 <公开 静态 注释 = "置类型转换阴影。参数 值=逻辑型。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
