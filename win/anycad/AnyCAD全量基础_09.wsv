类 AnyCAD基础_标尺控件设置项 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.RulerWidgetSetting。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建: 构造新对象。参数 查看器=变整数句柄。返回新句柄, 用完必须调用 AnyCAD基础_标尺控件设置项.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 查看器 <类型 = 变整数 注释 = "viewer">
    {
        @ (intptr_t)(af_ruler_widget_setting_ctor((void*)@<查看器>))
    }

    方法 置标记颜色 <公开 静态 注释 = "置标记颜色。参数 颜色=变整数句柄。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_标尺控件设置项句柄">
    参数 颜色 <类型 = 变整数 注释 = "color">
    {
        @ af_ruler_widget_setting_set_mark_color((void*)@<句柄>, (void*)@<颜色>)
    }

    方法 置数量颜色 <公开 静态 注释 = "置数量颜色。参数 颜色=变整数句柄。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_标尺控件设置项句柄">
    参数 颜色 <类型 = 变整数 注释 = "color">
    {
        @ af_ruler_widget_setting_set_number_color((void*)@<句柄>, (void*)@<颜色>)
    }

    方法 置标尺控件 <公开 静态 注释 = "置标尺控件。参数 类型=整数。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_标尺控件设置项句柄">
    参数 类型 <类型 = 整数 注释 = "type">
    {
        @ af_ruler_widget_setting_set_ruler_widget((void*)@<句柄>, @<类型>)
    }

}

类 AnyCAD基础_标签尺寸节点 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.TagDimensionNode。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 创建_无参 <公开 静态 类型 = 变整数 注释 = "创建_无参: 构造新对象。返回新句柄, 用完必须调用 AnyCAD基础_标签尺寸节点.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    {
