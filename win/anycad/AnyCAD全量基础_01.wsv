类 AnyCAD基础_内存图像 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.MemoryImage。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建: 构造新对象。参数 数组缓冲区=变整数句柄; 宽度=整数; 高度=整数; 内部格式=整数; 格式=整数; 数据类型=整数。返回新句柄, 用完必须调用 AnyCAD基础_内存图像.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 数组缓冲区 <类型 = 变整数 注释 = "arrayBuffer">
    参数 宽度 <类型 = 整数 注释 = "width">
    参数 高度 <类型 = 整数 注释 = "height">
    参数 内部格式 <类型 = 整数 注释 = "internalFormat">
    参数 格式 <类型 = 整数 注释 = "format">
    参数 数据类型 <类型 = 整数 注释 = "dataType">
    {
        @ (intptr_t)(af_memory_image_ctor((void*)@<数组缓冲区>, @<宽度>, @<高度>, @<内部格式>, @<格式>, @<数据类型>))
    }

    方法 取数据 <公开 静态 类型 = 变整数 注释 = "取数据。返回新句柄, 用完必须调用 AnyCAD基础_内存图像.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_内存图像句柄">
    {
        @ (intptr_t)(af_memory_image_get_data((void*)@<句柄>))
    }

}

