<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD Rapid 2026.10.24.1110 三维几何建模封装。v1 只含几何、布尔、特征、变换与文件导入导出, 不含任何渲染与界面代码。"
        注释 = "使用前必须先调用 AnyCAD内核.初始化 (), 返回 1 表示可用; 返回 0 时用 AnyCAD内核.取错误文本 () 查看原因 (多为 native\\runtime 目录缺 DLL)。"
        注释 = "句柄一律用 变整数 表示: 由 创建/造型/取子形状/克隆 等返回的句柄必须由调用方用对应的 释放 方法归还, 否则泄漏。"
        注释 = "数值失败哨兵: 小数返回 NaN (用 值 != 值 判断), 整数返回 -1 或 0, 句柄返回 0, 文本返回空文本。失败后可用 取错误文本/取错误码 定位。"
        注释 = "单位与 AnyCAD 文档一致 (默认 mm); 角度一律为弧度。索引一律 0 基。"
        @视窗.库文件搜寻目录.x64 = "native\\lib"
        @视窗.外部库.x64 = "AnyCADBridge.lib"
        @视窗.附属文件.x64 = "native\\runtime">

类 AnyCAD内核 <公开 注释 = "内核入口: 初始化、版本信息与错误状态 (每线程独立)。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 取版本 <公开 静态 类型 = 文本型 注释 = "返回桥接/AnyCAD/.NET 三段版本的单行文本, 用于报障。失败返回空文本 (几乎不会失败)。" 折叠 @嵌入式方法 = "">
    {
        @ ac_version()
    }

    方法 初始化 <公开 静态 类型 = 整数 注释 = "首次使用前必须调用一次。返回 1 成功, 0 失败 (失败多为 native\\runtime 目录缺 DLL, 用 取错误文本 查原因)。内部会初始化文件读写引擎并做一次造型探活。" 折叠 @嵌入式方法 = "">
    {
        @ ac_init()
    }

    方法 取错误文本 <公开 静态 类型 = 文本型 注释 = "取本线程最近一次错误的完整文本 (带 [错误码] 前缀)。无错误时返回空文本。失败后请立即读取。" 折叠 @嵌入式方法 = "">
    {
        @ ac_last_error()
    }

    方法 取错误码 <公开 静态 类型 = 整数 注释 = "取本线程最近一次错误的错误码, 0 表示无错误。1001 句柄无效 / 1002 句柄类型不符 / 1003 参数非法 (类型名、CSV、越界) / 1004 几何层拒绝 (类型不支持或运算无结果) / 1005 托管异常 / 1006 文件错误 / 1008 初始化失败; 1007、1009、1010 为预留码, v1 不会出现。重要: 必须先执行操作并把返回值存进变量, 再单独调用本方法; 不要写成 取错误码() 与操作调用同处一个表达式, 火山表达式从右往左求值, 会先取到旧值。" 折叠 @嵌入式方法 = "">
    {
        @ ac_last_error_code()
    }

    方法 清空错误 <公开 静态 注释 = "清空本线程的错误状态 (错误码归 0, 文本归空)。长流程中需要重新判断时可先调用。" 折叠 @嵌入式方法 = "">
    {
        @ ac_clear_error()
    }

    方法 转储枚举 <公开 静态 类型 = 文本型 注释 = "诊断用: 返回多行文本, 逐行给出各枚举成员的真实数值, 以及 [render] 渲染能力与 [gbbox] 包围盒成员自检结果。失败返回空文本。" 折叠 @嵌入式方法 = "">
    {
        @ ac_dump_enums()
    }
}
