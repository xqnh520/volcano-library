<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 形状句柄上的几何查询: 类型、面积、体积、边长、重心、包围盒、子形状、克隆、BREP 文本。">

类 AnyCAD形状 <公开 注释 = "形状句柄 (变整数) 上的只读查询与释放。所有 变整数 返回值为新句柄时, 都必须由调用方用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 是否有效 <公开 静态 类型 = 整数 注释 = "1 有效, 0 无效。空句柄、已释放的句柄、空形状都返回 0, 且不设置错误码。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_is_valid((void*)@<形状>)
    }

    方法 取形状类型 <公开 静态 类型 = 文本型 注释 = "返回 COMPOUND / COMPSOLID / SOLID / SHELL / FACE / WIRE / EDGE / VERTEX / SHAPE 之一; 失败返回空文本并置错误码 1001。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_type_name((void*)@<形状>)
    }

    方法 取面积 <公开 静态 类型 = 小数 注释 = "表面积 (当前文档单位平方)。实体按全部 FACE 逐个累加求得, 不是用实体级 API 直接取。失败返回 NaN (值 != 值)。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_area((void*)@<形状>)
    }

    方法 取体积 <公开 静态 类型 = 小数 注释 = "体积 (当前文档单位立方)。只对 SOLID / COMPSOLID / COMPOUND 有意义; 对 FACE / WIRE / EDGE / VERTEX 返回 NaN 并置错误码 1004。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_volume((void*)@<形状>)
    }

    方法 取边长 <公开 静态 类型 = 小数 注释 = "边长/周长 (当前文档单位)。按全部 EDGE 逐个累加求得, 例如半径 5 的圆返回 31.4159。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_edge_length((void*)@<形状>)
    }

    方法 取重心横坐标 <公开 静态 类型 = 小数 注释 = "重心的 X 分量。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_com_x((void*)@<形状>)
    }

    方法 取重心纵坐标 <公开 静态 类型 = 小数 注释 = "重心的 Y 分量。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_com_y((void*)@<形状>)
    }

    方法 取重心竖坐标 <公开 静态 类型 = 小数 注释 = "重心的 Z 分量。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_com_z((void*)@<形状>)
    }

    方法 取最小横坐标 <公开 静态 类型 = 小数 注释 = "轴对齐包围盒的 minX。失败或无有限包围盒时返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_bbox_min_x((void*)@<形状>)
    }

    方法 取最小纵坐标 <公开 静态 类型 = 小数 注释 = "轴对齐包围盒的 minY。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_bbox_min_y((void*)@<形状>)
    }

    方法 取最小竖坐标 <公开 静态 类型 = 小数 注释 = "轴对齐包围盒的 minZ。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_bbox_min_z((void*)@<形状>)
    }

    方法 取最大横坐标 <公开 静态 类型 = 小数 注释 = "轴对齐包围盒的 maxX。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_bbox_max_x((void*)@<形状>)
    }

    方法 取最大纵坐标 <公开 静态 类型 = 小数 注释 = "轴对齐包围盒的 maxY。失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_bbox_max_y((void*)@<形状>)
    }

    方法 取最大竖坐标 <公开 静态 类型 = 小数 注释 = "轴对齐包围盒的 maxZ。失败返回 NaN。尺寸请用 取最大* 减 取最小* 自行相减。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_bbox_max_z((void*)@<形状>)
    }

    方法 取子形状数 <公开 静态 类型 = 整数 注释 = "返回指定类型的子形状个数; 失败返回 -1。类型文本取值同 取形状类型 (如 FACE 或 EDGE)。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 类型文本 <类型 = 文本型>
    {
        @ ac_shape_child_count((void*)@<形状>, @<类型文本>.GetText())
    }

    方法 取子形状列表 <公开 静态 类型 = 变整数 注释 = "返回包含全部指定类型子形状的新列表句柄 (需用 AnyCAD形状列表.释放 () 归还); 失败返回 0。列表持有强引用, 原形状可先释放。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 类型文本 <类型 = 文本型>
    {
        @ (intptr_t)ac_shape_children((void*)@<形状>, @<类型文本>.GetText())
    }

    方法 取子形状 <公开 静态 类型 = 变整数 注释 = "返回第 序号 个子形状的新形状句柄 (需用 释放 () 归还); 越界或失败返回 0 并置错误码 1003。序号 0 基, 顺序与 取子形状列表 完全一致。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 类型文本 <类型 = 文本型>
    参数 序号 <类型 = 整数>
    {
        @ (intptr_t)ac_shape_child((void*)@<形状>, @<类型文本>.GetText(), @<序号>)
    }

    方法 克隆 <公开 静态 类型 = 变整数 注释 = "返回几何等价且完全独立的新形状句柄 (需用 释放 () 归还); 失败返回 0。修改克隆不影响原形状。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ (intptr_t)ac_shape_clone((void*)@<形状>)
    }

    方法 导出BREP文本 <公开 静态 类型 = 文本型 注释 = "返回形状的 BREP 文本, 复杂模型可达数百 KB。失败返回空文本并置错误码 1001。文本仅本次赋值有效, 不要缓存指针。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_to_brep((void*)@<形状>)
    }

    方法 释放 <公开 静态 注释 = "释放形状句柄。空句柄与重复释放均安全。释放后建议把变量置 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ ac_shape_free((void*)@<形状>)
    }
}
