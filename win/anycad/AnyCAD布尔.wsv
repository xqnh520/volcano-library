<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 布尔运算: 交集、差集、并集、合并面、分割、缝合、简化。全部返回新形状句柄, 必须用 AnyCAD形状.释放 () 归还。">

类 AnyCAD布尔 <公开 注释 = "布尔与拓扑清理。返回的新形状句柄都需用 AnyCAD形状.释放 () 归还。交集无结果时返回的是空壳句柄 (不是 0), 请用 AnyCAD形状.是否有效 () 判断。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 交集 <公开 静态 类型 = 变整数 注释 = "两个实体的公共部分。无交时 AnyCAD 返回空壳而不是空句柄, 请再用 AnyCAD形状.是否有效 () 判断。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状1 <类型 = 变整数>
    参数 形状2 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_common((void*)@<形状1>, (void*)@<形状2>)
    }

    方法 差集 <公开 静态 类型 = 变整数 注释 = "形状1 减去 形状2。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状1 <类型 = 变整数>
    参数 形状2 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_cut((void*)@<形状1>, (void*)@<形状2>)
    }

    方法 差集列表 <公开 静态 类型 = 变整数 注释 = "从 形状 中一次减去 形状列表 里的全部工具体。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 形状列表 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_cut_list((void*)@<形状>, (void*)@<形状列表>)
    }

    方法 并集 <公开 静态 类型 = 变整数 注释 = "两个实体求并。结果是未合并碎面的形状, 需要干净结果时请再接 合并面。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状1 <类型 = 变整数>
    参数 形状2 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_fuse2((void*)@<形状1>, (void*)@<形状2>)
    }

    方法 并集列表 <公开 静态 类型 = 变整数 注释 = "列表内全部实体求并; 列表至少要有 2 个形状。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状列表 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_fuse_list((void*)@<形状列表>)
    }

    方法 合并面 <公开 静态 类型 = 变整数 注释 = "清理布尔运算留下的碎面与碎边。三个逻辑参数按序为 合并相邻边 / 合并共面 / 拼接样条。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 合并相邻边 <类型 = 逻辑型>
    参数 合并共面 <类型 = 逻辑型>
    参数 拼接样条 <类型 = 逻辑型>
    {
        @ (intptr_t)ac_bool_unify((void*)@<形状>, @<合并相邻边>, @<合并共面>, @<拼接样条>)
    }

    方法 分割 <公开 静态 类型 = 变整数 注释 = "用 工具形状 分割 被分割形状。结果常为 COMPOUND, 可用 AnyCAD形状.取子形状列表 () 拆开。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 被分割形状 <类型 = 变整数>
    参数 工具形状 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_split((void*)@<被分割形状>, (void*)@<工具形状>)
    }

    方法 缝合 <公开 静态 类型 = 变整数 注释 = "把两个面片缝合为壳或实体。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状1 <类型 = 变整数>
    参数 形状2 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_sewing2((void*)@<形状1>, (void*)@<形状2>)
    }

    方法 缝合列表 <公开 静态 类型 = 变整数 注释 = "把列表里的多个面片缝合为壳或实体。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状列表 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_sewing_list((void*)@<形状列表>)
    }

    方法 简化 <公开 静态 类型 = 变整数 注释 = "等价于 合并面 且三个开关全开, 是最常用的清理快捷方式。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ (intptr_t)ac_bool_simplify((void*)@<形状>)
    }
}
