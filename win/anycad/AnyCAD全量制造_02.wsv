类 AnyCAD制造_标签集修饰 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Manufacturing.TagsDressup。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建: 构造新对象。返回新句柄, 用完必须调用 AnyCAD制造_标签集修饰.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)(af_tags_dressup_ctor())
    }

    方法 应用 <公开 静态 类型 = 整数 注释 = "应用。参数 路径=变整数句柄。失败返回 -1 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD制造_标签集修饰句柄">
    参数 路径 <类型 = 变整数 注释 = "path">
    {
        @ af_tags_dressup_apply((void*)@<句柄>, (void*)@<路径>)
    }

    方法 取最小长度 <公开 静态 类型 = 小数 注释 = "取最小长度。失败返回 NaN (值 != 值)。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD制造_标签集修饰句柄">
    {
        @ af_tags_dressup_get_min_length((void*)@<句柄>)
    }

    方法 取名称 <公开 静态 类型 = 文本型 注释 = "取名称。失败返回空文本并置错误码; 文本仅本次赋值有效, 不要缓存指针。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD制造_标签集修饰句柄">
    {
        @ af_tags_dressup_get_name((void*)@<句柄>)
    }

    方法 取页签数量 <公开 静态 类型 = 整数 注释 = "取页签数量。失败返回 -1 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD制造_标签集修饰句柄">
    {
        @ af_tags_dressup_get_tab_count((void*)@<句柄>)
    }

    方法 取页签高度 <公开 静态 类型 = 小数 注释 = "取页签高度。失败返回 NaN (值 != 值)。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD制造_标签集修饰句柄">
    {
        @ af_tags_dressup_get_tab_height((void*)@<句柄>)
    }

    方法 取页签宽度 <公开 静态 类型 = 小数 注释 = "取页签宽度。失败返回 NaN (值 != 值)。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD制造_标签集修饰句柄">
    {
        @ af_tags_dressup_get_tab_width((void*)@<句柄>)
    }

    方法 置最小长度 <公开 静态 注释 = "置最小长度。参数 值=小数。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD制造_标签集修饰句柄">
    参数 值 <类型 = 小数 注释 = "val">
    {
        @ af_tags_dressup_set_min_length((void*)@<句柄>, @<值>)
    }

    方法 置页签数量 <公开 静态 注释 = "置页签数量。参数 值=整数。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
