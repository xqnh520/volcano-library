<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 特征造型: 拉伸、旋转、放样、扫掠、圆角、倒角、抽壳、偏移、加厚。全部返回新形状句柄, 必须用 AnyCAD形状.释放 () 归还。">

类 AnyCAD特征 <公开 注释 = "特征造型。角度一律为弧度, 整周传 6.283185307179586。轮廓传线框 (EDGE/WIRE) 也可以, 内部会自动转成平面面。返回的新形状句柄都需用 AnyCAD形状.释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 拉伸 <公开 静态 类型 = 变整数 注释 = "把轮廓沿 方向X,Y,Z 拉伸 高度。轮廓可传 FACE 或 WIRE/EDGE (传线框时自动转面, 不必先调 AnyCAD草图.转平面片); 高度为负表示反向。返回新形状句柄 (需释放); 失败返回 0 并置错误码 1004。" 折叠 @嵌入式方法 = "">
    参数 轮廓 <类型 = 变整数>
    参数 高度 <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    {
        @ (intptr_t)ac_feat_extrude((void*)@<轮廓>, @<高度>, @<方向X>, @<方向Y>, @<方向Z>)
    }

    方法 旋转 <公开 静态 类型 = 变整数 注释 = "把轮廓绕轴 (轴点X..Z, 轴向X..Z) 旋转 角度 弧度。轮廓传线框同样会自动转面。返回新形状句柄 (需释放); 失败返回 0 并置错误码 1004。" 折叠 @嵌入式方法 = "">
    参数 轮廓 <类型 = 变整数>
    参数 轴点X <类型 = 小数>
    参数 轴点Y <类型 = 小数>
    参数 轴点Z <类型 = 小数>
    参数 轴向X <类型 = 小数>
    参数 轴向Y <类型 = 小数>
    参数 轴向Z <类型 = 小数>
    参数 角度 <类型 = 小数>
    {
        @ (intptr_t)ac_feat_revolve((void*)@<轮廓>, @<轴点X>, @<轴点Y>, @<轴点Z>, @<轴向X>, @<轴向Y>, @<轴向Z>, @<角度>)
    }

    方法 放样 <公开 静态 类型 = 变整数 注释 = "在两个轮廓之间放样。是否成体 为真时尝试生成实体。内部对 FACE 入参会先降级为外环 WIRE 重试 (实测直接吃 FACE 返回空), 这是设计行为, 请勿删除该回退。返回新形状句柄 (需释放); 失败返回 0 并置错误码 1004。" 折叠 @嵌入式方法 = "">
    参数 轮廓1 <类型 = 变整数>
    参数 轮廓2 <类型 = 变整数>
    参数 是否成体 <类型 = 逻辑型>
    {
        @ (intptr_t)ac_feat_loft2((void*)@<轮廓1>, (void*)@<轮廓2>, @<是否成体>)
    }

    方法 放样列表 <公开 静态 类型 = 变整数 注释 = "按形状列表的顺序在多轮廓之间放样; 列表至少要有 2 个轮廓。是否成体 为真时尝试生成实体。内部对 FACE 入参会先降级为外环 WIRE 重试, 这是设计行为, 请勿删除该回退。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状列表 <类型 = 变整数>
    参数 是否成体 <类型 = 逻辑型>
    参数 是否校验兼容 <类型 = 逻辑型>
    {
        @ (intptr_t)ac_feat_loft_list((void*)@<形状列表>, @<是否成体>, @<是否校验兼容>)
    }

    方法 扫掠 <公开 静态 类型 = 变整数 注释 = "把 截面 沿 路径 扫掠。过渡模式文本 取值 ROUND / RIGHT / TRANSFORMED, 未知取值返回 0 并置错误码 1003。是否成体 为真时尝试生成实体。返回新形状句柄 (需释放)。" 折叠 @嵌入式方法 = "">
    参数 截面 <类型 = 变整数>
    参数 路径 <类型 = 变整数>
    参数 过渡模式文本 <类型 = 文本型>
    参数 是否成体 <类型 = 逻辑型>
    {
        @ (intptr_t)ac_feat_sweep((void*)@<截面>, (void*)@<路径>, @<过渡模式文本>.GetText(), @<是否成体>)
    }

    方法 圆角 <公开 静态 类型 = 变整数 注释 = "对全部边等半径倒圆; 半径必须大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 半径 <类型 = 小数>
    {
        @ (intptr_t)ac_feat_fillet_all((void*)@<形状>, @<半径>)
    }

    方法 指定边圆角 <公开 静态 类型 = 变整数 注释 = "对指定边倒圆, 统一使用同一个半径。边序号表 用逗号分隔, 序号 0 基, 例如 0,2,5。返回新形状句柄 (需释放); 序号表非法返回 0 并置错误码 1003。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 边序号表 <类型 = 文本型>
    参数 半径 <类型 = 小数>
    {
        @ (intptr_t)ac_feat_fillet_edges((void*)@<形状>, @<边序号表>.GetText(), @<半径>)
    }

    方法 倒角 <公开 静态 类型 = 变整数 注释 = "对全部边倒角, 两个距离相等即等距倒角; 两个距离都必须大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 距离1 <类型 = 小数>
    参数 距离2 <类型 = 小数>
    {
        @ (intptr_t)ac_feat_chamfer((void*)@<形状>, @<距离1>, @<距离2>)
    }

    方法 抽壳 <公开 静态 类型 = 变整数 注释 = "把实体抽成薄壁, 并去掉面序号表 里列出的面形成开口。面序号表 用逗号分隔, 序号 0 基, 例如 0 或 0,3; 必须至少指定 1 个面, 空文本返回 0 并置错误码 1003。偏移 为壁厚 (当前文档单位)。返回新形状句柄 (需释放)。用法要点: 先 结果 = AnyCAD特征.抽壳 (...), 再单独调 AnyCAD内核.取错误码 (); 火山表达式从右往左求值, 写在一个表达式里会先取到旧值。" 折叠 @嵌入式方法 = "">
    参数 实体 <类型 = 变整数>
    参数 偏移 <类型 = 小数>
    参数 面序号表 <类型 = 文本型>
    {
        @ (intptr_t)ac_feat_thickness((void*)@<实体>, @<偏移>, @<面序号表>.GetText())
    }

    方法 偏移 <公开 静态 类型 = 变整数 注释 = "把面或壳整体偏移 偏移距离; 负数向内。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 偏移距离 <类型 = 小数>
    {
        @ (intptr_t)ac_feat_offset((void*)@<形状>, @<偏移距离>)
    }

    方法 加厚 <公开 静态 类型 = 变整数 注释 = "把平面片或壳按 厚度 加厚成实体; 入参必须是 FACE 或 SHELL, 否则返回 0 并置错误码 1004。返回新形状句柄 (需释放)。" 折叠 @嵌入式方法 = "">
    参数 面 <类型 = 变整数>
    参数 厚度 <类型 = 小数>
    {
        @ (intptr_t)ac_feat_thicken((void*)@<面>, @<厚度>)
    }
}
