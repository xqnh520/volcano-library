<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 集合类型: 形状列表 (用于布尔/放样/缝合的批量入参) 与点列 (用于多边形/折线/样条)。">

类 AnyCAD形状列表 <公开 注释 = "形状列表句柄 (变整数)。用于 布尔.并集列表 / 差集列表 / 缝合列表、特征.放样列表 等批量入参。用完必须调用 释放 ()。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建空列表, 返回列表句柄 (需用 释放 () 归还); 失败返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)ac_list_new()
    }

    方法 加入 <公开 静态 类型 = 整数 注释 = "把形状加入列表, 返回加入后的元素数; 失败返回 -1。列表持有强引用, 形状句柄加入后可立即释放。" 折叠 @嵌入式方法 = "">
    参数 列表 <类型 = 变整数>
    参数 形状 <类型 = 变整数>
    {
        @ ac_list_add((void*)@<列表>, (void*)@<形状>)
    }

    方法 取数量 <公开 静态 类型 = 整数 注释 = "返回元素个数; 失败返回 -1。" 折叠 @嵌入式方法 = "">
    参数 列表 <类型 = 变整数>
    {
        @ ac_list_count((void*)@<列表>)
    }

    方法 取形状 <公开 静态 类型 = 变整数 注释 = "返回第 序号 个元素的新形状句柄 (需用 AnyCAD形状.释放 () 归还); 越界或失败返回 0 并置错误码 1003。序号 0 基。" 折叠 @嵌入式方法 = "">
    参数 列表 <类型 = 变整数>
    参数 序号 <类型 = 整数>
    {
        @ (intptr_t)ac_list_get((void*)@<列表>, @<序号>)
    }

    方法 清空 <公开 静态 类型 = 整数 注释 = "清空全部元素, 返回 1 成功 0 失败。" 折叠 @嵌入式方法 = "">
    参数 列表 <类型 = 变整数>
    {
        @ ac_list_clear((void*)@<列表>)
    }

    方法 删除 <公开 静态 类型 = 整数 注释 = "删除第 序号 个元素 (0 基), 返回删除后的元素数; 越界或失败返回 -1 并置错误码 1003。" 折叠 @嵌入式方法 = "">
    参数 列表 <类型 = 变整数>
    参数 序号 <类型 = 整数>
    {
        @ ac_list_remove((void*)@<列表>, @<序号>)
    }

    方法 释放 <公开 静态 注释 = "释放列表句柄。空句柄与重复释放均安全。" 折叠 @嵌入式方法 = "">
    参数 列表 <类型 = 变整数>
    {
        @ ac_list_free((void*)@<列表>)
    }
}

类 AnyCAD点列 <公开 注释 = "点列句柄 (变整数)。用于 草图.取多边形 / 取多段线 / 取样条曲线 / 取贝塞尔曲线。用完必须调用 释放 ()。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建空点列, 返回点列句柄 (需用 释放 () 归还); 失败返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)ac_ptl_new()
    }

    方法 加入点 <公开 静态 类型 = 整数 注释 = "追加一个点, 返回加入后的点数; 失败返回 -1。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 竖坐标 <类型 = 小数>
    {
        @ ac_ptl_add((void*)@<点列>, @<横坐标>, @<纵坐标>, @<竖坐标>)
    }

    方法 取数量 <公开 静态 类型 = 整数 注释 = "返回点数; 失败返回 -1。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    {
        @ ac_ptl_count((void*)@<点列>)
    }

    方法 清空 <公开 静态 类型 = 整数 注释 = "清空全部点, 返回 1 成功 0 失败。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    {
        @ ac_ptl_clear((void*)@<点列>)
    }

    方法 释放 <公开 静态 注释 = "释放点列句柄。空句柄与重复释放均安全。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    {
        @ ac_ptl_free((void*)@<点列>)
    }
    方法 取横坐标 <公开 静态 类型 = 小数 注释 = "取指定点 (0 基) 的横坐标; 失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    参数 序号 <类型 = 整数>
    {
        @ ac_ptl_x((void*)@<点列>, @<序号>)
    }

    方法 取纵坐标 <公开 静态 类型 = 小数 注释 = "取指定点 (0 基) 的纵坐标; 失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    参数 序号 <类型 = 整数>
    {
        @ ac_ptl_y((void*)@<点列>, @<序号>)
    }

    方法 取竖坐标 <公开 静态 类型 = 小数 注释 = "取指定点 (0 基) 的竖坐标; 失败返回 NaN。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    参数 序号 <类型 = 整数>
    {
        @ ac_ptl_z((void*)@<点列>, @<序号>)
    }
}

