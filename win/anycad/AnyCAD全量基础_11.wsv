类 AnyCAD基础_默认应用事件监听器 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.DefaultAppEventListener。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建: 构造新对象。返回新句柄, 用完必须调用 AnyCAD基础_默认应用事件监听器.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)(af_default_app_event_listener_ctor())
    }

    方法 调试消息时 <公开 静态 注释 = "调试消息时。参数 msg=文本型。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_默认应用事件监听器句柄">
    参数 msg <类型 = 文本型 注释 = "msg">
    {
        @ af_default_app_event_listener_on_debug_message((void*)@<句柄>, @<msg>.GetText())
    }

    方法 消息时 <公开 静态 注释 = "消息时。参数 evt=整数; msg=文本型; 内容=变整数句柄。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_默认应用事件监听器句柄">
    参数 evt <类型 = 整数 注释 = "evt">
    参数 msg <类型 = 文本型 注释 = "msg">
    参数 内容 <类型 = 变整数 注释 = "content">
    {
        @ af_default_app_event_listener_on_message((void*)@<句柄>, @<evt>, @<msg>.GetText(), (void*)@<内容>)
    }

}

