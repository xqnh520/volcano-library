<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 分析类: 距离查询与曲线的参数化访问。返回点的接口统一用 点列 (变整数) 承载, 用 点列.取横坐标/取纵坐标/取竖坐标 读取。">

类 AnyCAD分析 <公开 注释 = "距离与曲线分析: 两形状最小距离、最近点对、点到面距离与投影点、曲线参数范围与取点/切向。所有返回的点列句柄都需用 点列.释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 取两形状距离 <公开 静态 类型 = 小数 注释 = "两形状之间的最小距离。公差必须大于 0 (建议 0.001)。失败返回 NaN 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 形状甲 <类型 = 变整数>
    参数 形状乙 <类型 = 变整数>
    参数 公差 <类型 = 小数>
    {
        @ ac_ana_shape_distance((void*)@<形状甲>, (void*)@<形状乙>, @<公差>)
    }

    方法 取最近点对 <公开 静态 类型 = 变整数 注释 = "两形状的最近点对, 返回含 2 个点的点列句柄 (需用 点列.释放 () 归还): 序号 0 在 形状甲 上, 序号 1 在 形状乙 上。失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状甲 <类型 = 变整数>
    参数 形状乙 <类型 = 变整数>
    参数 公差 <类型 = 小数>
    {
        @ (intptr_t)ac_ana_shape_closest((void*)@<形状甲>, (void*)@<形状乙>, @<公差>)
    }

    方法 取点到面距离 <公开 静态 类型 = 小数 注释 = "三维点到指定面 (必须是 FACE) 的最小距离。公差必须大于 0。失败返回 NaN 并置错误码 (非 FACE 时为 1003)。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 竖坐标 <类型 = 小数>
    参数 面 <类型 = 变整数>
    参数 公差 <类型 = 小数>
    {
        @ ac_ana_point_face_distance(@<横坐标>, @<纵坐标>, @<竖坐标>, (void*)@<面>, @<公差>)
    }

    方法 取点到面最近点 <公开 静态 类型 = 变整数 注释 = "三维点在指定面上的最近点 (投影点), 返回含 1 个点的点列句柄 (需用 点列.释放 () 归还)。失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 竖坐标 <类型 = 小数>
    参数 面 <类型 = 变整数>
    参数 公差 <类型 = 小数>
    {
        @ (intptr_t)ac_ana_point_face_closest(@<横坐标>, @<纵坐标>, @<竖坐标>, (void*)@<面>, @<公差>)
    }

    方法 取曲线参数范围 <公开 静态 类型 = 变整数 注释 = "取曲线 (EDGE 或 WIRE) 的参数范围, 返回含 1 个点的点列句柄 (需用 点列.释放 () 归还): 横坐标 = 起始参数, 纵坐标 = 结束参数。失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 曲线 <类型 = 变整数>
    {
        @ (intptr_t)ac_curve_param_range((void*)@<曲线>)
    }

    方法 取曲线上点 <公开 静态 类型 = 变整数 注释 = "取曲线在参数 参数 处的点, 返回含 1 个点的点列句柄 (需用 点列.释放 () 归还)。参数必须落在 取曲线参数范围 之内, 否则返回 0 并置错误码 1003。" 折叠 @嵌入式方法 = "">
    参数 曲线 <类型 = 变整数>
    参数 参数 <类型 = 小数>
    {
        @ (intptr_t)ac_curve_value((void*)@<曲线>, @<参数>)
    }

    方法 取曲线切向 <公开 静态 类型 = 变整数 注释 = "取曲线在参数 参数 处的单位切向量, 返回含 1 个点的点列句柄 (需用 点列.释放 () 归还): 三个坐标即单位切向量的 XYZ 分量。失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 曲线 <类型 = 变整数>
    参数 参数 <类型 = 小数>
    {
        @ (intptr_t)ac_curve_tangent((void*)@<曲线>, @<参数>)
    }
}
