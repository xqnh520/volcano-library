<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 刚体变换: 平移、旋转、缩放、镜像、复制。全部返回新形状句柄 (入参形状不变), 必须用 AnyCAD形状.释放 () 归还。">

类 AnyCAD变换 <公开 注释 = "几何变换。每个方法都返回新形状, 入参形状保持不变; 返回的新形状句柄需用 AnyCAD形状.释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 平移 <公开 静态 类型 = 变整数 注释 = "按位移量平移, 返回新形状句柄 (需释放), 入参不变; 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 位移X <类型 = 小数>
    参数 位移Y <类型 = 小数>
    参数 位移Z <类型 = 小数>
    {
        @ (intptr_t)ac_tr_translate((void*)@<形状>, @<位移X>, @<位移Y>, @<位移Z>)
    }

    方法 旋转 <公开 静态 类型 = 变整数 注释 = "绕任意轴 (轴点X..Z, 轴向X..Z) 旋转 角度 弧度, 返回新形状句柄 (需释放), 入参不变; 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 轴点X <类型 = 小数>
    参数 轴点Y <类型 = 小数>
    参数 轴点Z <类型 = 小数>
    参数 轴向X <类型 = 小数>
    参数 轴向Y <类型 = 小数>
    参数 轴向Z <类型 = 小数>
    参数 角度 <类型 = 小数>
    {
        @ (intptr_t)ac_tr_rotate((void*)@<形状>, @<轴点X>, @<轴点Y>, @<轴点Z>, @<轴向X>, @<轴向Y>, @<轴向Z>, @<角度>)
    }

    方法 缩放 <公开 静态 类型 = 变整数 注释 = "以 中心 为基点按 比例 均匀缩放; 比例不得为 0, 大于 1 为放大。返回新形状句柄 (需释放), 入参不变; 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 中心X <类型 = 小数>
    参数 中心Y <类型 = 小数>
    参数 中心Z <类型 = 小数>
    参数 比例 <类型 = 小数>
    {
        @ (intptr_t)ac_tr_scale((void*)@<形状>, @<中心X>, @<中心Y>, @<中心Z>, @<比例>)
    }

    方法 镜像 <公开 静态 类型 = 变整数 注释 = "关于过 (轴点X..Z) 沿 (轴向X..Z) 的直线做镜像 (旋转体对称常用)。返回新形状句柄 (需释放), 入参不变; 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    参数 轴点X <类型 = 小数>
    参数 轴点Y <类型 = 小数>
    参数 轴点Z <类型 = 小数>
    参数 轴向X <类型 = 小数>
    参数 轴向Y <类型 = 小数>
    参数 轴向Z <类型 = 小数>
    {
        @ (intptr_t)ac_tr_mirror((void*)@<形状>, @<轴点X>, @<轴点Y>, @<轴点Z>, @<轴向X>, @<轴向Y>, @<轴向Z>)
    }

    方法 复制 <公开 静态 类型 = 变整数 注释 = "深拷贝, 得到几何等价且完全独立的新形状。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 形状 <类型 = 变整数>
    {
        @ (intptr_t)ac_tr_copy((void*)@<形状>)
    }
}
