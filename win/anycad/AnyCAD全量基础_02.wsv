类 AnyCAD基础_参数化几何 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.ParametricGeometry。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 取标识 <公开 静态 类型 = 整数 注释 = "取标识。失败返回 -1 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_参数化几何句柄">
    {
        @ af_parametric_geometry_get_id((void*)@<句柄>)
    }

    方法 取点值 <公开 静态 类型 = 变整数 注释 = "取点值。参数 顶点=变整数句柄。返回新句柄, 用完必须调用 AnyCAD基础_参数化几何.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 顶点 <类型 = 变整数 注释 = "vertex">
    {
        @ (intptr_t)(af_parametric_geometry_get_point_value((void*)@<顶点>))
    }

    方法 取形状 <公开 静态 类型 = 变整数 注释 = "取形状。返回新句柄, 用完必须调用 AnyCAD基础_参数化几何.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_参数化几何句柄">
    {
        @ (intptr_t)(af_parametric_geometry_get_shape((void*)@<句柄>))
    }

    方法 初始化 <公开 静态 类型 = 整数 注释 = "初始化。参数 形状=变整数句柄。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_参数化几何句柄">
    参数 形状 <类型 = 变整数 注释 = "shape">
    {
        @ af_parametric_geometry_initialize((void*)@<句柄>, (void*)@<形状>)
    }

    方法 是否有效几何_无参 <公开 静态 类型 = 整数 注释 = "是否有效几何_无参。1 成功, 0 失败并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_参数化几何句柄">
    {
        @ af_parametric_geometry_is_valid_geometry((void*)@<句柄>)
    }

    方法 是否有效几何_小数 <公开 静态 类型 = 整数 注释 = "是否有效几何_小数。参数 公差=小数。1 成功, 0 失败并置错误码。单位: 当前文档单位 (默认 mm)。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_参数化几何句柄">
    参数 公差 <类型 = 小数 注释 = "tol">
    {
        @ af_parametric_geometry_is_valid_geometry_2((void*)@<句柄>, @<公差>)
    }

    方法 置标识 <公开 静态 注释 = "置标识。参数 值=整数。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_参数化几何句柄">
    参数 值 <类型 = 整数 注释 = "val">
    {
        @ af_parametric_geometry_set_id((void*)@<句柄>, @<值>)
    }

