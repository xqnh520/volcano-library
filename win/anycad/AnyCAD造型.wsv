<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 基本体造型: 立方体、球、圆柱、圆锥、圆环、棱锥、圆管。全部返回新形状句柄, 必须用 AnyCAD形状.释放 () 归还。">

类 AnyCAD造型 <公开 注释 = "基本体造型。基准面用 (位置X,位置Y,位置Z) + (法向X,法向Y,法向Z) 表示; 传 0,0,0,0,0,1 即世界 XY 平面过原点。长度单位为当前文档单位 (默认 mm)。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 取立方体 <公开 静态 类型 = 变整数 注释 = "按基准面和长宽高生成立方体。基准面 = (位置X..Z, 法向X..Z); 长宽高必须都大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 长 <类型 = 小数>
    参数 宽 <类型 = 小数>
    参数 高 <类型 = 小数>
    {
        @ (intptr_t)ac_make_box(@<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>, @<长>, @<宽>, @<高>)
    }

    方法 取球体 <公开 静态 类型 = 变整数 注释 = "按球心与半径生成球体; 半径必须大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 中心X <类型 = 小数>
    参数 中心Y <类型 = 小数>
    参数 中心Z <类型 = 小数>
    参数 半径 <类型 = 小数>
    {
        @ (intptr_t)ac_make_sphere(@<中心X>, @<中心Y>, @<中心Z>, @<半径>)
    }

    方法 取圆柱 <公开 静态 类型 = 变整数 注释 = "按基准面、半径、高度和圆心角生成圆柱; 圆心角为弧度, 整圆传 6.283185307179586。半径与高度必须大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 半径 <类型 = 小数>
    参数 高 <类型 = 小数>
    参数 圆心角 <类型 = 小数>
    {
        @ (intptr_t)ac_make_cylinder(@<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>, @<半径>, @<高>, @<圆心角>)
    }

    方法 取圆锥 <公开 静态 类型 = 变整数 注释 = "按基准面、底半径、顶半径、高度和圆心角生成圆锥或圆台; 圆心角为弧度, 整圆传 6.283185307179586; 顶半径传 0 即尖锥。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 底半径 <类型 = 小数>
    参数 顶半径 <类型 = 小数>
    参数 高 <类型 = 小数>
    参数 圆心角 <类型 = 小数>
    {
        @ (intptr_t)ac_make_cone(@<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>, @<底半径>, @<顶半径>, @<高>, @<圆心角>)
    }

    方法 取圆环 <公开 静态 类型 = 变整数 注释 = "按主半径、次半径和基准面生成圆环; 主半径必须大于次半径, 两者都大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 主半径 <类型 = 小数>
    参数 次半径 <类型 = 小数>
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    {
        @ (intptr_t)ac_make_torus(@<主半径>, @<次半径>, @<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>)
    }

    方法 取棱锥 <公开 静态 类型 = 变整数 注释 = "按基准面、边数、外接圆半径和高度生成正棱锥; 边数不得小于 3。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 边数 <类型 = 整数>
    参数 外接圆半径 <类型 = 小数>
    参数 高 <类型 = 小数>
    {
        @ (intptr_t)ac_make_pyramid(@<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>, @<边数>, @<外接圆半径>, @<高>)
    }

    方法 取圆管 <公开 静态 类型 = 变整数 注释 = "按起点、方向、内半径、壁厚和长度生成空心直管; 内半径、壁厚、长度都必须大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 起点Z <类型 = 小数>
    参数 方向X <类型 = 小数>
    参数 方向Y <类型 = 小数>
    参数 方向Z <类型 = 小数>
    参数 内半径 <类型 = 小数>
    参数 壁厚 <类型 = 小数>
    参数 长度 <类型 = 小数>
    {
        @ (intptr_t)ac_make_tube(@<起点X>, @<起点Y>, @<起点Z>, @<方向X>, @<方向Y>, @<方向Z>, @<内半径>, @<壁厚>, @<长度>)
    }
}
