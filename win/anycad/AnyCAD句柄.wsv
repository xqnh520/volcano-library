<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 全量封装的统一根类与诊断类 (手写, 不参与生成)。"
        @视窗.库文件搜寻目录.x64 = "native\\lib"
        @视窗.外部库.x64 = "AnyCADBridge.lib"
        注释 = "本文件的 AnyCAD句柄 必须是 anycad.vgrp 里的第一个 file 条目: 全部分片的类型类都以 基础类 = AnyCAD句柄 继承它。"
        注释 = "命名说明: 不用 对象 这个词, 因为它是火山的保留类型名, 类名里含它的文件会被静默丢弃 (T01 实测)。">

类 AnyCAD句柄 <公开 注释 = "全部 AnyCAD 句柄类型的根基类。句柄是 变整数, 新句柄需用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 是否有效 <公开 静态 类型 = 整数 注释 = "1 有效; 0 空句柄、已释放或底层实例为空。不设置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "待检查的句柄">
    {
        @ af_obj_is_valid((void*)@<句柄>)
    }

    方法 取类型全名 <公开 静态 类型 = 文本型 注释 = "句柄背后托管实例的 .NET 类型全名, 用于排错。失败返回空文本。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "待查询的句柄">
    {
        @ af_obj_type_name((void*)@<句柄>)
    }

    方法 释放 <公开 静态 类型 = 整数 注释 = "释放句柄。重复释放与传 0 都安全; 释放后句柄永久失效 (错误码 1001)。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "要归还的句柄">
    {
        @ af_obj_free((void*)@<句柄>)
    }

    方法 判等 <公开 静态 类型 = 整数 注释 = "两个句柄是否指向同一个托管实例。失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 句柄1 <类型 = 变整数 注释 = "第一个句柄">
    参数 句柄2 <类型 = 变整数 注释 = "第二个句柄">
    {
        @ af_obj_same((void*)@<句柄1>, (void*)@<句柄2>)
    }
}

类 AnyCAD全量诊断 <公开 注释 = "生成层诊断: 活动句柄计数、按类型分类报告、句柄真实类型名。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 取活动句柄数 <公开 静态 类型 = 整数 注释 = "当前句柄表里的活动句柄数。抽样程序开头取 n0, 全部释放后再取 n1, n1 == n0 才算无泄漏。" 折叠 @嵌入式方法 = "">
    {
        @ af_diag_live_handle_count()
    }

    方法 取活动句柄报告 <公开 静态 类型 = 文本型 注释 = "按托管类型名分类的句柄计数, 每行 类型名=数量。" 折叠 @嵌入式方法 = "">
    {
        @ af_diag_live_handle_report()
    }

    方法 取句柄类型名 <公开 静态 类型 = 文本型 注释 = "某个句柄背后托管实例的真实 .NET 类型全名; 无效句柄返回空文本。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "待查询的句柄">
    {
        @ af_diag_type_name((void*)@<句柄>)
    }
}
