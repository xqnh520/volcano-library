    {
        @ (intptr_t)(af_class_id_ctor(@<名称>.GetText(), @<ver>, (void*)@<父级>))
    }

    方法 取名称 <公开 静态 类型 = 文本型 注释 = "取名称。失败返回空文本并置错误码; 文本仅本次赋值有效, 不要缓存指针。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_类标识句柄">
