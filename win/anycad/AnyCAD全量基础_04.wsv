类 AnyCAD基础_多相切事件 <公开 基础类 = AnyCAD句柄 注释 = "对应 AnyCAD.Foundation.MultiTouchEvent。句柄类型; 新句柄用完必须调用 释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_full_bridge.h">
{
    方法 创建 <公开 静态 类型 = 变整数 注释 = "创建: 构造新对象。返回新句柄, 用完必须调用 AnyCAD基础_多相切事件.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)(af_multi_touch_event_ctor())
    }

    方法 添加点 <公开 静态 注释 = "添加点。参数 positon=变整数句柄。失败时无返回值, 用 取错误码 () 判断。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_多相切事件句柄">
    参数 positon <类型 = 变整数 注释 = "positon">
    {
        @ af_multi_touch_event_add_point((void*)@<句柄>, (void*)@<positon>)
    }

    方法 取数量 <公开 静态 类型 = 整数 注释 = "取数量。失败返回 -1 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_多相切事件句柄">
    {
        @ af_multi_touch_event_get_count((void*)@<句柄>)
    }

    方法 取点 <公开 静态 类型 = 变整数 注释 = "取点。参数 序号=整数。返回新句柄, 用完必须调用 AnyCAD基础_多相切事件.释放 () 归还; 失败返回 0 并置错误码。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "目标AnyCAD基础_多相切事件句柄">
    参数 序号 <类型 = 整数 注释 = "idx">
    {
        @ (intptr_t)(af_multi_touch_event_get_point((void*)@<句柄>, @<序号>))
    }

}

