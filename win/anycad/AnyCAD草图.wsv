<火山程序 类型 = "通常" 版本 = 1 />

包 火山.AnyCAD <注释 = "AnyCAD 草图曲线与平面片。曲线返回的是 EDGE 或 WIRE, 不是面; 要变成实体请先转平面片 (或直接交给 AnyCAD特征.拉伸, 它会自动转面)。">

类 AnyCAD草图 <公开 注释 = "二维/三维草图构造。除 取顶点 外都返回 EDGE 或 WIRE; 返回的新形状句柄都需用 AnyCAD形状.释放 () 归还。"
        @视窗.外部头文件 = "native\\anycad_bridge.h">
{
    方法 取顶点 <公开 静态 类型 = 变整数 注释 = "生成单点 (VERTEX)。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 竖坐标 <类型 = 小数>
    {
        @ (intptr_t)ac_make_vertex(@<横坐标>, @<纵坐标>, @<竖坐标>)
    }

    方法 取直线 <公开 静态 类型 = 变整数 注释 = "按两点生成直线段 (EDGE); 两点不得重合, 否则返回 0 并置错误码 1004。返回新形状句柄 (需释放)。" 折叠 @嵌入式方法 = "">
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 起点Z <类型 = 小数>
    参数 终点X <类型 = 小数>
    参数 终点Y <类型 = 小数>
    参数 终点Z <类型 = 小数>
    {
        @ (intptr_t)ac_make_line(@<起点X>, @<起点Y>, @<起点Z>, @<终点X>, @<终点Y>, @<终点Z>)
    }

    方法 取圆 <公开 静态 类型 = 变整数 注释 = "按平面 (位置X..Z, 法向X..Z) 和半径生成圆, 返回的是 EDGE 不是面。要做实体请再过 转平面片。半径须大于 0。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 半径 <类型 = 小数>
    {
        @ (intptr_t)ac_make_circle(@<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>, @<半径>)
    }

    方法 转平面片 <公开 静态 类型 = 变整数 注释 = "草图与特征之间的必需连接件: 把闭合的 EDGE 或 WIRE 转成平面 FACE, 之后才能 旋转/放样 或按面操作。不闭合或非平面时返回 0 并置错误码 1004。传入已是 FACE 的形状会返回一个独立副本。返回新形状句柄 (需释放)。" 折叠 @嵌入式方法 = "">
    参数 轮廓 <类型 = 变整数>
    {
        @ (intptr_t)ac_make_face((void*)@<轮廓>)
    }

    方法 取三点圆弧 <公开 静态 类型 = 变整数 注释 = "按三点生成圆弧。参数顺序为 起点 到 终点 再给 中间点 (与 AnyCAD 一致, 不是起-中-终)。三点共线时返回 0 并置错误码 1004。返回新形状句柄 (需释放)。" 折叠 @嵌入式方法 = "">
    参数 起点X <类型 = 小数>
    参数 起点Y <类型 = 小数>
    参数 起点Z <类型 = 小数>
    参数 终点X <类型 = 小数>
    参数 终点Y <类型 = 小数>
    参数 终点Z <类型 = 小数>
    参数 中间点X <类型 = 小数>
    参数 中间点Y <类型 = 小数>
    参数 中间点Z <类型 = 小数>
    {
        @ (intptr_t)ac_make_arc3p(@<起点X>, @<起点Y>, @<起点Z>, @<终点X>, @<终点Y>, @<终点Z>, @<中间点X>, @<中间点Y>, @<中间点Z>)
    }

    方法 取矩形 <公开 静态 类型 = 变整数 注释 = "按平面 (位置X..Z, 法向X..Z)、长、宽、圆角半径生成矩形; 圆角半径传 0 即直角。是否填充 为真时直接得到 FACE (可直接拉伸), 为假时得到 WIRE。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 长 <类型 = 小数>
    参数 宽 <类型 = 小数>
    参数 圆角半径 <类型 = 小数>
    参数 是否填充 <类型 = 逻辑型>
    {
        @ (intptr_t)ac_make_rectangle(@<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>, @<长>, @<宽>, @<圆角半径>, @<是否填充>)
    }

    方法 取正多边形 <公开 静态 类型 = 变整数 注释 = "按平面、边数和外接圆半径生成正多边形轮廓 (WIRE); 边数不得小于 3。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 位置X <类型 = 小数>
    参数 位置Y <类型 = 小数>
    参数 位置Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 边数 <类型 = 整数>
    参数 外接圆半径 <类型 = 小数>
    {
        @ (intptr_t)ac_make_polygon_n(@<位置X>, @<位置Y>, @<位置Z>, @<法向X>, @<法向Y>, @<法向Z>, @<边数>, @<外接圆半径>)
    }

    方法 取多边形 <公开 静态 类型 = 变整数 注释 = "按点列生成多边形轮廓 (WIRE); 点数不得小于 3, 是否闭合 决定首尾是否相连。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    参数 是否闭合 <类型 = 逻辑型>
    {
        @ (intptr_t)ac_make_polygon_pts((void*)@<点列>, @<是否闭合>)
    }

    方法 取多段线 <公开 静态 类型 = 变整数 注释 = "按点列顺序连成折线; 点数不得小于 2。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    {
        @ (intptr_t)ac_make_polyline((void*)@<点列>)
    }

    方法 取样条曲线 <公开 静态 类型 = 变整数 注释 = "按点列生成 B 样条曲线; 点数不得小于 2。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    {
        @ (intptr_t)ac_make_bspline((void*)@<点列>)
    }

    方法 取贝塞尔曲线 <公开 静态 类型 = 变整数 注释 = "按控制点生成贝塞尔曲线; 点数不得小于 2。返回新形状句柄 (需释放); 失败返回 0。" 折叠 @嵌入式方法 = "">
    参数 点列 <类型 = 变整数>
    {
        @ (intptr_t)ac_make_bezier((void*)@<点列>)
    }
}
