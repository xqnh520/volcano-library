<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui 中文封装：基础数值类型" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp">

类 二维坐标值 <公开 注释 = "对应 ImGui 的 ImVec2，用两个单精度小数表示坐标、尺寸或比例。本类型为本地值类型，可直接与 C++ 的 ImVec2 互换。" 折叠
        折叠2 @文档 = "category = \"基础类型\"" @别名 = "ImVec2" @别名类型 = 本地值类型>
{
    变量 横坐标 <公开 类型 = 单精度小数 @输出名 = "x" @属性变量 = 真 注释 = "横坐标（宽度）分量">
    变量 纵坐标 <公开 类型 = 单精度小数 @输出名 = "y" @属性变量 = 真 注释 = "纵坐标（高度）分量">

    方法 创建 <公开 静态 类型 = 二维坐标值 注释 = "按给定的横纵分量创建坐标值。" 折叠 @嵌入式方法 = "">
    参数 横坐标值 <注释 = "横坐标分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 纵坐标值 <注释 = "纵坐标分量" @默认值 = 0 @匹配类型 = 通用数值型>
    {
        @ ImVec2((float)@<横坐标值>, (float)@<纵坐标值>)
    }

    方法 取零值 <公开 静态 类型 = 二维坐标值 注释 = "返回 (0, 0)。" 折叠 @嵌入式方法 = "">
    {
        @ ImVec2(0.0f, 0.0f)
    }

    方法 取单位值 <公开 静态 类型 = 二维坐标值 注释 = "返回 (1, 1)。" 折叠 @嵌入式方法 = "">
    {
        @ ImVec2(1.0f, 1.0f)
    }

    方法 置值 <公开 静态 注释 = "同时修改坐标值的两个分量。" 折叠 @嵌入式方法 = "">
    参数 欲操作的坐标 <类型 = 二维坐标值 @视窗.后缀文本 = "&" 注释 = "被修改的坐标值">
    参数 横坐标值 <注释 = "新的横坐标分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 纵坐标值 <注释 = "新的纵坐标分量" @默认值 = 0 @匹配类型 = 通用数值型>
    {
        @ @<欲操作的坐标>.x = (float)@<横坐标值>;
        @ @<欲操作的坐标>.y = (float)@<纵坐标值>;
    }

    方法 相加 <公开 静态 类型 = 二维坐标值 注释 = "返回两个坐标值相加后的新坐标值。" 折叠 @嵌入式方法 = "">
    参数 坐标甲 <类型 = 二维坐标值 注释 = "第一个坐标值">
    参数 坐标乙 <类型 = 二维坐标值 注释 = "第二个坐标值">
    {
        @ ImVec2(@<坐标甲>.x + @<坐标乙>.x, @<坐标甲>.y + @<坐标乙>.y)
    }

    方法 相减 <公开 静态 类型 = 二维坐标值 注释 = "返回两个坐标值相减后的新坐标值。" 折叠 @嵌入式方法 = "">
    参数 坐标甲 <类型 = 二维坐标值 注释 = "被减坐标值">
    参数 坐标乙 <类型 = 二维坐标值 注释 = "减数坐标值">
    {
        @ ImVec2(@<坐标甲>.x - @<坐标乙>.x, @<坐标甲>.y - @<坐标乙>.y)
    }

    方法 相乘 <公开 静态 类型 = 二维坐标值 注释 = "返回坐标值乘以一个系数的结果。" 折叠 @嵌入式方法 = "">
    参数 坐标 <类型 = 二维坐标值 注释 = "参与计算的坐标值">
    参数 系数 <注释 = "相乘的系数" @默认值 = 1 @匹配类型 = 通用数值型>
    {
        @ ImVec2(@<坐标>.x * (float)@<系数>, @<坐标>.y * (float)@<系数>)
    }
}

类 四维数值 <公开 注释 = "对应 ImGui 的 ImVec4，常用于表示带透明度的颜色 (红, 绿, 蓝, 透明)。" 折叠
        折叠2 @文档 = "category = \"基础类型\"" @别名 = "ImVec4" @别名类型 = 本地值类型>
{
    变量 红色 <公开 类型 = 单精度小数 @输出名 = "x" @属性变量 = 真 注释 = "红色分量，范围 0.0-1.0">
    变量 绿色 <公开 类型 = 单精度小数 @输出名 = "y" @属性变量 = 真 注释 = "绿色分量，范围 0.0-1.0">
    变量 蓝色 <公开 类型 = 单精度小数 @输出名 = "z" @属性变量 = 真 注释 = "蓝色分量，范围 0.0-1.0">
    变量 透明度 <公开 类型 = 单精度小数 @输出名 = "w" @属性变量 = 真 注释 = "透明度分量，范围 0.0-1.0">

    方法 创建 <公开 静态 类型 = 四维数值 注释 = "按给定的四个分量创建数值。" 折叠 @嵌入式方法 = "">
    参数 红色值 <注释 = "红色分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 绿色值 <注释 = "绿色分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 蓝色值 <注释 = "蓝色分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 透明度值 <注释 = "透明度分量" @默认值 = 1 @匹配类型 = 通用数值型>
    {
        @ ImVec4((float)@<红色值>, (float)@<绿色值>, (float)@<蓝色值>, (float)@<透明度值>)
    }

    方法 创建自整数色 <公开 静态 类型 = 四维数值 注释 = "把一个 32 位打包颜色值（AABBGGRR）拆分为四个分量。" 折叠 @嵌入式方法 = "">
    参数 打包颜色 <类型 = 整数 注释 = "32 位打包颜色值">
    {
        @ ImGui::ColorConvertU32ToFloat4((ImU32)@<打包颜色>)
    }

    方法 转为整数色 <公开 静态 类型 = 整数 注释 = "把四个分量打包为 32 位颜色值（AABBGGRR）。" 折叠 @嵌入式方法 = "">
    参数 欲转换的颜色 <类型 = 四维数值 @视窗.后缀文本 = "&" 注释 = "被转换的颜色值">
    {
        @ ImGui::ColorConvertFloat4ToU32(@<欲转换的颜色>)
    }
}
