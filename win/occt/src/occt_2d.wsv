    }

    方法 读取DXF形状 <公开 静态 类型 = 变整数 注释 = "读取基础 AutoCAD DXF 文件并返回通用 TopoDS_Shape 句柄。" 折叠 @嵌入式方法 = "">
    参数 文件名 <类型 = 文本型>
    {
        @ (intptr_t)occt2d_read_shape_dxf(@<文件名>.GetText())
    }
}

类 OCCT绘图命令 <公开 注释 = "二维 CAD 视图命令编号。按钮、快捷键、菜单和工具条都可以统一传递这些命令值。" 折叠>
{
    常量 无 <公开 类型 = 整数 值 = 0 注释 = "没有匹配到有效命令。">
    常量 绘制矩形 <公开 类型 = 整数 值 = 1 注释 = "显示矩形线框。">
    常量 绘制圆 <公开 类型 = 整数 值 = 2 注释 = "显示圆曲线。">
    常量 绘制贝塞尔 <公开 类型 = 整数 值 = 3 注释 = "显示四点 Bezier 曲线。">
    常量 绘制组合 <公开 类型 = 整数 值 = 4 注释 = "显示矩形、圆、Bezier 和辅助线组合图。">
    常量 绘制填充矩形 <公开 类型 = 整数 值 = 5 注释 = "显示带填充色的闭合矩形。">
    常量 放大 <公开 类型 = 整数 值 = 10 注释 = "放大当前视图。">
    常量 缩小 <公开 类型 = 整数 值 = 11 注释 = "缩小当前视图。">
    常量 适配全部 <公开 类型 = 整数 值 = 12 注释 = "适配全部显示对象。">
    常量 切换背景 <公开 类型 = 整数 值 = 13 注释 = "切换高层视图背景颜色。">
    常量 清空 <公开 类型 = 整数 值 = 14 注释 = "清空当前显示对象和草图。">
    常量 低层初始化 <公开 类型 = 整数 值 = 20 注释 = "初始化 V3d_View/WNT_Window/OpenGl_GraphicDriver 低层视图。">
    常量 低层背景 <公开 类型 = 整数 值 = 21 注释 = "切换低层 V3d 视图背景。">
    常量 低层缩放 <公开 类型 = 整数 值 = 22 注释 = "测试低层 V3d 视图缩放。">
    常量 低层绘图 <公开 类型 = 整数 值 = 23 注释 = "在低层 V3d 视图中显示当前二维草图。">
    常量 保存DXF <公开 类型 = 整数 值 = 30 注释 = "保存 CAD DXF 文件。">
    常量 打开DXF <公开 类型 = 整数 值 = 31 注释 = "打开 CAD DXF 文件。">
    常量 保存BREP <公开 类型 = 整数 值 = 32 注释 = "保存 OCCT BREP 文件。">
    常量 打开BREP <公开 类型 = 整数 值 = 33 注释 = "打开 OCCT BREP 文件。">
    常量 打开3D <公开 类型 = 整数 值 = 34 注释 = "打开 STEP/IGES/BREP 三维文件并显示到低层 V3d 视图。">
    常量 取消 <公开 类型 = 整数 值 = 90 注释 = "取消当前绘图或视图交互状态。">
    常量 重复上一命令 <公开 类型 = 整数 值 = 91 注释 = "重复上一条已执行命令。">
}

类 OCCT命令调度器 <公开 注释 = "把键盘快捷键、菜单命令和按钮动作统一为 OCCT绘图命令 编号，并记录当前命令/上一命令。" 折叠>
{
    变量 当前命令 <公开 类型 = 整数 值 = 0 注释 = "当前正在执行或等待执行的命令编号。">
    变量 上一命令 <公开 类型 = 整数 值 = 0 注释 = "最近一次执行成功的普通命令编号，用于重复执行。">

    方法 快捷键转命令 <公开 类型 = 整数 注释 = "把键代码和 Ctrl/Shift/Alt 状态转换为 OCCT绘图命令 编号。" 折叠 @嵌入式方法 = "">
    参数 键代码 <类型 = 整数>
    参数 Ctrl按下 <类型 = 逻辑型>
    参数 Shift按下 <类型 = 逻辑型>
    参数 Alt按下 <类型 = 逻辑型>
    {
        @ occt2d_command_from_key(@<键代码>, @<Ctrl按下>, @<Shift按下>, @<Alt按下>)
    }

    方法 命令名称 <公开 类型 = 文本型 注释 = "返回命令编号对应的中文名称。" 折叠 @嵌入式方法 = "">
    参数 命令编号 <类型 = 整数>
    {
        @ occt2d_command_name(@<命令编号>)
    }

    方法 命令快捷键文本 <公开 类型 = 文本型 注释 = "返回命令编号对应的默认快捷键文本。" 折叠 @嵌入式方法 = "">
    参数 命令编号 <类型 = 整数>
    {
        @ occt2d_command_shortcut(@<命令编号>)
    }

    方法 由快捷键取命令 <公开 类型 = 整数 注释 = "使用事件给出的键代码和当前 Ctrl/Shift/Alt 状态转换为命令编号。" 折叠>
    参数 键代码 <类型 = 整数 注释 = "窗口组件.按下某键 事件传入的键代码。">
    {
        返回 (快捷键转命令 (键代码, OCCT二维原生桥接.Ctrl键按下 (), OCCT二维原生桥接.Shift键按下 (), OCCT二维原生桥接.Alt键按下 ()))
    }

    方法 设置当前命令 <公开 类型 = 整数 注释 = "设置当前命令编号。" 折叠>
    参数 命令编号 <类型 = 整数>
    {
        当前命令 = 命令编号
        返回 (当前命令)
    }

    方法 取消当前命令 <公开 类型 = 整数 注释 = "清除当前命令并返回无命令。" 折叠>
    {
        当前命令 = OCCT绘图命令.无
        返回 (当前命令)
    }

    方法 记录已执行命令 <公开 类型 = 整数 注释 = "记录已经执行完成的命令，取消和重复命令本身不会覆盖上一命令。" 折叠>
    参数 命令编号 <类型 = 整数>
    {
        如果 (命令编号 != OCCT绘图命令.无 && 命令编号 != OCCT绘图命令.取消 && 命令编号 != OCCT绘图命令.重复上一命令)
        {
            上一命令 = 命令编号
        }
        当前命令 = 命令编号
        返回 (上一命令)
    }

    方法 取重复命令 <公开 类型 = 整数 注释 = "返回上一条可重复命令，如果不存在则返回无命令。" 折叠>
    {
        返回 (上一命令)
    }
}

类 OCCT二维对象 <公开 注释 = "二维封装对象基类。对象创建后需要调用释放，避免原生内存泄漏。" 折叠>
{
    变量 对象指针 <公开 类型 = 变整数 值 = 0 注释 = "原生对象指针。">
    变量 对象类型 <公开 类型 = 文本型 值 = "" 注释 = "原生对象类型标记。">

    方法 是否为空 <公开 类型 = 逻辑型 注释 = "返回当前对象是否没有绑定原生指针。" 折叠>
    {
        返回 (对象指针 == 0)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "释放原生对象。" 折叠>
    {
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = OCCT二维原生桥接.释放 (对象类型, 对象指针)
        如果 (结果)
        {
            对象指针 = 0
            对象类型 = ""
        }
        返回 (结果)
    }
}

