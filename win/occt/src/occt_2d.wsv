类 OCCT二维视图器 <公开 基础类 = OCCT二维对象
        注释 = "V3d/AIS/OpenGL 二维视图器。头文件：V3d_View.hxx、V3d_Viewer.hxx、AIS_InteractiveContext.hxx、AIS_Shape.hxx、WNT_Window.hxx、OpenGl_GraphicDriver.hxx"
        折叠>
{
    方法 绑定窗口 <公开 类型 = 逻辑型 注释 = "绑定火山窗口或窗口组件的 Win32 HWND，创建二维 CAD 视图器。" 折叠>
    参数 窗口句柄 <类型 = 变整数 注释 = "调用窗口或组件的取窗口句柄获得。">
    {
        如果 (对象指针 != 0)
        {
            关闭 ()
        }
        对象指针 = OCCT二维原生桥接.创建视图器 (窗口句柄)
        对象类型 = "viewer"
        返回 (对象指针 != 0)
    }

    方法 关闭 <公开 类型 = 逻辑型 注释 = "关闭并释放 V3d/AIS 视图器。" 折叠>
    {
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        变量 成功 <类型 = 逻辑型>
        成功 = OCCT二维原生桥接.关闭视图器 (对象指针)
        如果 (成功)
        {
            对象指针 = 0
            对象类型 = ""
        }
        返回 (成功)
    }

    方法 调整尺寸 <公开 类型 = 逻辑型 注释 = "宿主窗口尺寸变化后调用，通知 V3d_View 更新视口。" 折叠>
    {
        返回 (OCCT二维原生桥接.视图调整尺寸 (对象指针))
    }

    方法 重绘 <公开 类型 = 逻辑型 注释 = "重绘当前 OCCT 视图。" 折叠>
    {
        返回 (OCCT二维原生桥接.视图重绘 (对象指针))
    }

    方法 适配全部 <公开 类型 = 逻辑型 注释 = "让视图缩放到包含所有显示对象。" 折叠>
    {
        返回 (OCCT二维原生桥接.视图适配全部 (对象指针))
    }

    方法 清空显示 <公开 类型 = 逻辑型 注释 = "清空当前所有 AIS 显示对象。" 折叠>
    {
        返回 (OCCT二维原生桥接.视图清空显示 (对象指针))
    }

