    }

    方法 按比例缩放 <公开 类型 = 逻辑型 注释 = "按比例缩放视图，数值大于 1 表示放大，小于 1 表示缩小。" 折叠>
    参数 缩放比例 <类型 = 小数 注释 = "例如 1.2 放大，0.8 缩小。">
    {
        返回 (OCCT二维原生桥接.视图按比例缩放 (对象指针, 缩放比例))
    }

    方法 屏幕点到模型点 <公开 类型 = OCCT二维点 注释 = "把视图客户区屏幕坐标转换为 XY 平面模型点，便于鼠标绘制。" 折叠>
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        变量 点对象 <类型 = OCCT二维点>
        点对象.对象指针 = OCCT二维原生桥接.视图屏幕点到模型点 (对象指针, 横坐标, 纵坐标)
        点对象.对象类型 = "point"
        返回 (点对象)
    }

    方法 移动检测 <公开 类型 = 整数 注释 = "鼠标移动时执行 AIS 动态检测，返回检测状态码。" 折叠>
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        返回 (OCCT二维原生桥接.视图移动检测 (对象指针, 横坐标, 纵坐标))
    }

    方法 选择检测项 <公开 类型 = 整数 注释 = "选择最近一次移动检测到的对象，返回选择状态码。" 折叠>
    {
        返回 (OCCT二维原生桥接.视图选择检测项 (对象指针))
    }

    方法 显示形状 <公开 类型 = 逻辑型 注释 = "显示从 BREP 文件读取的通用形状。颜色为 0-255 的红、绿、蓝。" 折叠>
    参数 形状 <类型 = OCCT二维形状>
    参数 红色 <类型 = 整数>
    参数 绿色 <类型 = 整数>
    参数 蓝色 <类型 = 整数>
    参数 线宽 <类型 = 小数>
    {
        返回 (OCCT二维原生桥接.视图显示形状 (对象指针, 形状.对象指针, 红色, 绿色, 蓝色, 线宽))
    }

    方法 保存图片指针 <公开 静态 类型 = 逻辑型 注释 = "把当前高层 V3d/AIS 视图保存为图片；格式由文件扩展名决定，JPG 可用于图纸预览导出。" 折叠 @嵌入式方法 = "">
    参数 视图器指针 <类型 = 变整数 注释 = "OCCT二维视图器.对象指针。">
    参数 文件名 <类型 = 文本型 注释 = "输出文件名，如 door_window.jpg。">
    参数 缓冲类型 <类型 = 整数 注释 = "使用 OCCTV3d截图缓冲类型 常量，常用 RGB。">
    {
        @ occt2d_viewer_dump_image((void*)@<视图器指针>, @<文件名>.GetText(), @<缓冲类型>)
    }
}

类 OCCT门窗设计文档 <公开 注释 = "面向门窗平面设计的轻量文档对象：保存外框、分格线、选中外边，并支持外边长度修改和 PDF/JPG 导出。内部使用 gp、BRepBuilderAPI、V3d/AIS 和 GDI+。" 折叠>
{
    方法 创建指针 <公开 静态 类型 = 变整数 注释 = "创建默认门窗设计文档指针；释放时使用 OCCT二维原生桥接.释放(\"window_design\", 指针)。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)occt2d_window_design_new()
    }

    方法 清空 <公开 静态 类型 = 逻辑型 注释 = "清空设计文档中的所有线段和当前选择。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    {
        @ occt2d_window_design_clear((void*)@<文档指针>)
    }

    方法 创建窗示例 <公开 静态 类型 = 逻辑型 注释 = "创建一个带竖梃和横梃的窗平面示例；单位可按毫米理解。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 宽度 <类型 = 小数 注释 = "窗外框宽度。">
    参数 高度 <类型 = 小数 注释 = "窗外框高度。">
    {
        @ occt2d_window_design_set_window_sample((void*)@<文档指针>, @<宽度>, @<高度>)
    }

    方法 创建门示例 <公开 静态 类型 = 逻辑型 注释 = "创建一个带门扇线和开启弧线的门平面示例。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 宽度 <类型 = 小数 注释 = "门洞宽度。">
    参数 高度 <类型 = 小数 注释 = "门洞高度。">
    {
        @ occt2d_window_design_set_door_sample((void*)@<文档指针>, @<宽度>, @<高度>)
    }

    方法 线段数量 <公开 静态 类型 = 整数 注释 = "返回当前设计文档中的显示线段数量。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    {
        @ occt2d_window_design_edge_count((void*)@<文档指针>)
    }

    方法 选中外边 <公开 静态 类型 = 整数 注释 = "返回当前选中的外边编号；1=下边，2=右边，3=上边，4=左边，0=未选中。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    {
        @ occt2d_window_design_selected_edge((void*)@<文档指针>)
    }

    方法 置选中外边 <公开 静态 类型 = 逻辑型 注释 = "按编号设置当前选中外边；传 0 取消选择。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 外边编号 <类型 = 整数 注释 = "1=下边，2=右边，3=上边，4=左边，0=未选中。">
    {
        @ occt2d_window_design_select_edge((void*)@<文档指针>, @<外边编号>)
    }

    方法 命中外边 <公开 静态 类型 = 整数 注释 = "用模型坐标命中测试外框边，并自动更新当前选中外边。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 X <类型 = 小数 注释 = "模型 X 坐标。">
    参数 Y <类型 = 小数 注释 = "模型 Y 坐标。">
    参数 容差 <类型 = 小数 注释 = "模型单位容差，如 35。">
    {
        @ occt2d_window_design_hit_outer_edge((void*)@<文档指针>, @<X>, @<Y>, @<容差>)
    }

    方法 外边长度 <公开 静态 类型 = 小数 注释 = "返回指定外边或线段的长度；外边编号 1 到 4 可修改。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 外边编号 <类型 = 整数 注释 = "外边编号或线段编号。">
    {
        @ occt2d_window_design_edge_length((void*)@<文档指针>, @<外边编号>)
    }

    方法 置外边长度 <公开 静态 类型 = 逻辑型 注释 = "修改选中外边长度；下/上边修改整体宽度，左/右边修改整体高度。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 外边编号 <类型 = 整数 注释 = "1=下边，2=右边，3=上边，4=左边。">
    参数 长度 <类型 = 小数 注释 = "新的外边长度，必须大于 1。">
    {
        @ occt2d_window_design_set_outer_edge_length((void*)@<文档指针>, @<外边编号>, @<长度>)
    }

    方法 置选中外边长度文本 <公开 静态 类型 = 逻辑型 注释 = "把输入文本中的第一个数值作为当前选中外边的新长度。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 长度文本 <类型 = 文本型 注释 = "来自输入框的长度文本。">
    {
        @ occt2d_window_design_set_selected_length_text((void*)@<文档指针>, @<长度文本>.GetText())
    }

    方法 宽度 <公开 静态 类型 = 小数 注释 = "返回当前门窗外框宽度。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    {
        @ occt2d_window_design_width((void*)@<文档指针>)
    }

    方法 高度 <公开 静态 类型 = 小数 注释 = "返回当前门窗外框高度。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    {
        @ occt2d_window_design_height((void*)@<文档指针>)
    }

    方法 生成形状指针 <公开 静态 类型 = 变整数 注释 = "把当前设计线段生成通用 TopoDS_Shape 指针；释放类型为 shape。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_window_design_shape((void*)@<文档指针>)
    }

    方法 显示到视图 <公开 静态 类型 = 逻辑型 注释 = "把门窗设计显示到 OCCT二维视图器；选中外边会用高亮颜色绘制。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 视图器指针 <类型 = 变整数 注释 = "OCCT二维视图器.对象指针。">
    参数 边红色 <类型 = 整数>
    参数 边绿色 <类型 = 整数>
    参数 边蓝色 <类型 = 整数>
    参数 填充红色 <类型 = 整数>
    参数 填充绿色 <类型 = 整数>
    参数 填充蓝色 <类型 = 整数>
    参数 高亮红色 <类型 = 整数>
    参数 高亮绿色 <类型 = 整数>
    参数 高亮蓝色 <类型 = 整数>
    参数 线宽 <类型 = 小数>
    参数 线型 <类型 = 整数 注释 = "使用 OCCT线型 常量。">
    参数 启用填充 <类型 = 逻辑型>
    {
        @ occt2d_window_design_display((void*)@<文档指针>, (void*)@<视图器指针>, @<边红色>, @<边绿色>, @<边蓝色>, @<填充红色>, @<填充绿色>, @<填充蓝色>, @<高亮红色>, @<高亮绿色>, @<高亮蓝色>, @<线宽>, @<线型>, @<启用填充>)
    }

    方法 导出PDF <公开 静态 类型 = 逻辑型 注释 = "把当前门窗设计导出为矢量 PDF 文件。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 文件名 <类型 = 文本型 注释 = "输出 PDF 文件名。">
    {
        @ occt2d_window_design_export_pdf((void*)@<文档指针>, @<文件名>.GetText())
    }

    方法 导出JPG <公开 静态 类型 = 逻辑型 注释 = "把当前门窗设计导出为 JPG 图片，不依赖当前屏幕视图状态。" 折叠 @嵌入式方法 = "">
    参数 文档指针 <类型 = 变整数>
    参数 文件名 <类型 = 文本型 注释 = "输出 JPG 文件名。">
    参数 图片宽度 <类型 = 整数 注释 = "输出图片宽度像素。">
    参数 图片高度 <类型 = 整数 注释 = "输出图片高度像素。">
    {
        @ occt2d_window_design_export_jpg((void*)@<文档指针>, @<文件名>.GetText(), @<图片宽度>, @<图片高度>)
    }
}

类 OCCTGCC限定位置 <公开 注释 = "GccEnt_Position：GCC 相切构造中曲线限定关系常量。头文件：GccEnt_Position.hxx" 折叠>
{
    常量 未限定 <公开 类型 = 整数 值 = 0 注释 = "GccEnt_unqualified：不限定内外关系。">
    常量 包含参数 <公开 类型 = 整数 值 = 1 注释 = "GccEnt_enclosing：结果包含参数曲线。">
    常量 被参数包含 <公开 类型 = 整数 值 = 2 注释 = "GccEnt_enclosed：结果被参数曲线包含。">
    常量 参数外部 <公开 类型 = 整数 值 = 3 注释 = "GccEnt_outside：结果与参数曲线外切。">
    常量 无限定结果 <公开 类型 = 整数 值 = 4 注释 = "GccEnt_noqualifier：查询未限定参数时返回。">
}

