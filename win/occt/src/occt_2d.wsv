类 OCCTBRepLib工具 <公开 注释 = "BRepLib：BRep 通用工具函数。头文件：BRepLib.hxx" 折叠>
{
    方法 设置精度 <公开 静态 类型 = 逻辑型 注释 = "设置 BRepLib 默认精度。" 折叠 @嵌入式方法 = "">
    参数 精度 <类型 = 小数>
    {
        @ (occt2d_breplib_set_precision(@<精度>), true)
    }

    方法 精度 <公开 静态 类型 = 小数 注释 = "读取 BRepLib 默认精度。" 折叠 @嵌入式方法 = "">
    {
        @ occt2d_breplib_precision()
    }

    方法 检查同范围 <公开 静态 类型 = 逻辑型 注释 = "检查 TopoDS_Edge 是否同参数范围；形状指针必须是边。" 折叠 @嵌入式方法 = "">
    参数 边形状指针 <类型 = 变整数>
    参数 混淆精度 <类型 = 小数>
    {
        @ occt2d_breplib_check_same_range((void*)@<边形状指针>, @<混淆精度>)
    }

    方法 统一范围 <公开 静态 类型 = 逻辑型 注释 = "调用 BRepLib.SameRange 统一边的参数范围。" 折叠 @嵌入式方法 = "">
    参数 边形状指针 <类型 = 变整数>
    参数 容差 <类型 = 小数>
    {
        @ occt2d_breplib_same_range((void*)@<边形状指针>, @<容差>)
    }

    方法 构建三维曲线 <公开 静态 类型 = 逻辑型 注释 = "为边补建 3D 曲线；连续性使用 GeomAbs_Shape 整数值。" 折叠 @嵌入式方法 = "">
    参数 边形状指针 <类型 = 变整数>
    参数 容差 <类型 = 小数>
    参数 连续性 <类型 = 整数>
    参数 最大次数 <类型 = 整数>
    参数 最大分段 <类型 = 整数>
    {
        @ occt2d_breplib_build_curve3d((void*)@<边形状指针>, @<容差>, @<连续性>, @<最大次数>, @<最大分段>)
    }

    方法 构建形状三维曲线 <公开 静态 类型 = 逻辑型 注释 = "为形状内所有边补建 3D 曲线。" 折叠 @嵌入式方法 = "">
    参数 形状指针 <类型 = 变整数>
    参数 容差 <类型 = 小数>
    参数 连续性 <类型 = 整数>
    参数 最大次数 <类型 = 整数>
    参数 最大分段 <类型 = 整数>
    {
