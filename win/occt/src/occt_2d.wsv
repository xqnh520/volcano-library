    方法 创建 <公开 静态 类型 = OCCT二维正弦波曲线 注释 = "按局部坐标轴、振幅、角频率和相位创建正弦波曲线。" 折叠>
    参数 坐标轴 <类型 = OCCT二维坐标轴>
    参数 振幅 <类型 = 小数>
    参数 角频率 <类型 = 小数>
    参数 相位 <类型 = 小数>
    {
        变量 曲线 <类型 = OCCT二维正弦波曲线>
        曲线.对象指针 = 创建指针 (坐标轴.对象指针, 振幅, 角频率, 相位)
        曲线.对象类型 = "curve"
        返回 (曲线)
    }

    方法 创建指针 <静态 类型 = 变整数 注释 = "内部方法：创建 SineWaveCurve。" 折叠 @嵌入式方法 = "">
    参数 坐标轴指针 <类型 = 变整数>
    参数 振幅 <类型 = 小数>
    参数 角频率 <类型 = 小数>
    参数 相位 <类型 = 小数>
    {
        @ (intptr_t)occt2d_sine_wave_new((void*)@<坐标轴指针>, @<振幅>, @<角频率>, @<相位>)
    }

    方法 位置 <公开 类型 = OCCT二维坐标轴 注释 = "返回曲线局部坐标轴。" 折叠>
    {
        变量 坐标轴 <类型 = OCCT二维坐标轴>
        坐标轴.对象指针 = 位置指针 ()
        坐标轴.对象类型 = "axis"
        返回 (坐标轴)
    }

    方法 位置指针 <类型 = 变整数 注释 = "内部方法：返回局部坐标轴。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)occt2d_sine_wave_position((void*)@sn<this>.@n<OCCT二维对象.对象指针>)
    }

    方法 振幅 <公开 类型 = 小数 注释 = "返回正弦波振幅。" 折叠 @嵌入式方法 = "">
    {
        @ occt2d_sine_wave_amplitude((void*)@sn<this>.@n<OCCT二维对象.对象指针>)
    }

    方法 角频率 <公开 类型 = 小数 注释 = "返回角频率 Omega。" 折叠 @嵌入式方法 = "">
    {
        @ occt2d_sine_wave_omega((void*)@sn<this>.@n<OCCT二维对象.对象指针>)
    }

    方法 相位 <公开 类型 = 小数 注释 = "返回相位。" 折叠 @嵌入式方法 = "">
