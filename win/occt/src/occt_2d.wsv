    常量 无效枚举 <公开 类型 = 整数 值 = 0x0500 注释 = "GL_INVALID_ENUM。">
    常量 无效值 <公开 类型 = 整数 值 = 0x0501 注释 = "GL_INVALID_VALUE。">
    常量 无效操作 <公开 类型 = 整数 值 = 0x0502 注释 = "GL_INVALID_OPERATION。">
    常量 内存不足 <公开 类型 = 整数 值 = 0x0505 注释 = "GL_OUT_OF_MEMORY。">
}

