类 OCCTBRepLib边错误 <公开 注释 = "BRepLib_EdgeError：BRepLib 边构建错误枚举。头文件：BRepLib_EdgeError.hxx" 折叠>
{
    常量 完成 <公开 类型 = 整数 值 = 0 注释 = "BRepLib_EdgeDone。">
    常量 点投影失败 <公开 类型 = 整数 值 = 1 注释 = "BRepLib_PointProjectionFailed。">
    常量 参数超界 <公开 类型 = 整数 值 = 2 注释 = "BRepLib_ParameterOutOfRange。">
    常量 闭合曲线上点不同 <公开 类型 = 整数 值 = 3 注释 = "BRepLib_DifferentPointsOnClosedCurve。">
    常量 点参数无限 <公开 类型 = 整数 值 = 4 注释 = "BRepLib_PointWithInfiniteParameter。">
    常量 点与参数不一致 <公开 类型 = 整数 值 = 5 注释 = "BRepLib_DifferentsPointAndParameter。">
    常量 重合点成线 <公开 类型 = 整数 值 = 6 注释 = "BRepLib_LineThroughIdenticPoints。">

    方法 名称 <公开 静态 类型 = 文本型 注释 = "返回 BRepLib_EdgeError 的英文名称。" 折叠 @嵌入式方法 = "">
    参数 错误码 <类型 = 整数>
    {
        @ occt2d_breplib_edge_error_name(@<错误码>)
    }
}

