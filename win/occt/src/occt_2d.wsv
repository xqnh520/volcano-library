    }

    方法 取OpenGL结构 <公开 静态 类型 = 变整数 注释 = "由 Graphic3d_Structure 取 OpenGl_Structure 封装指针。" 折叠 @嵌入式方法 = "">
    参数 结构指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_structure_from_graphic3d((void*)@<结构指针>)
    }

    方法 取OpenGL外观 <公开 静态 类型 = 变整数 注释 = "由 Graphic3d_Aspects 取 OpenGl_Aspects 封装指针。" 折叠 @嵌入式方法 = "">
    参数 外观指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_aspects_from_graphic3d((void*)@<外观指针>)
    }

    方法 新建图形组 <公开 静态 类型 = 变整数 注释 = "在图形结构上创建 Graphic3d_Group 封装指针。" 折叠 @嵌入式方法 = "">
    参数 结构指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_graphic3d_group_new((void*)@<结构指针>)
    }

    方法 取组所属结构 <公开 静态 类型 = 变整数 注释 = "取组所属的 Graphic3d_Structure 封装指针。" 折叠 @嵌入式方法 = "">
    参数 组指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_graphic3d_group_get_structure((void*)@<组指针>)
    }

    方法 取OpenGL组 <公开 静态 类型 = 变整数 注释 = "由 Graphic3d_Group 取 OpenGl_Group 封装指针。" 折叠 @嵌入式方法 = "">
    参数 组指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_group_from_graphic3d((void*)@<组指针>)
    }

    方法 创建点 <公开 静态 类型 = 变整数 注释 = "创建 gp_Pnt2d 原生点对象。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ (intptr_t)occt2d_point_new(@<横坐标>, @<纵坐标>)
    }

    方法 点横坐标 <公开 静态 类型 = 小数 注释 = "读取 gp_Pnt2d.X。" 折叠 @嵌入式方法 = "">
    参数 指针 <类型 = 变整数>
    {
        @ occt2d_point_x((void*)@<指针>)
    }

    方法 点纵坐标 <公开 静态 类型 = 小数 注释 = "读取 gp_Pnt2d.Y。" 折叠 @嵌入式方法 = "">
    参数 指针 <类型 = 变整数>
    {
        @ occt2d_point_y((void*)@<指针>)
    }

    方法 置点 <公开 静态 注释 = "修改 gp_Pnt2d 坐标。" 折叠 @嵌入式方法 = "">
    参数 指针 <类型 = 变整数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ occt2d_point_set((void*)@<指针>, @<横坐标>, @<纵坐标>)
    }

    方法 点距离 <公开 静态 类型 = 小数 注释 = "计算两个 gp_Pnt2d 的距离。" 折叠 @嵌入式方法 = "">
    参数 点1 <类型 = 变整数>
    参数 点2 <类型 = 变整数>
    {
        @ occt2d_point_distance((void*)@<点1>, (void*)@<点2>)
    }

    方法 平移点 <公开 静态 类型 = 变整数 注释 = "按偏移量返回新的 gp_Pnt2d。" 折叠 @嵌入式方法 = "">
    参数 点 <类型 = 变整数>
    参数 横向偏移 <类型 = 小数>
    参数 纵向偏移 <类型 = 小数>
    {
        @ (intptr_t)occt2d_point_translated((void*)@<点>, @<横向偏移>, @<纵向偏移>)
    }

    方法 变换点 <公开 静态 类型 = 变整数 注释 = "按 gp_Trsf2d 返回新的 gp_Pnt2d。" 折叠 @嵌入式方法 = "">
    参数 点 <类型 = 变整数>
    参数 变换 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_point_transformed((void*)@<点>, (void*)@<变换>)
    }

    方法 创建向量 <公开 静态 类型 = 变整数 注释 = "创建 gp_Vec2d 原生向量对象。" 折叠 @嵌入式方法 = "">
    参数 横分量 <类型 = 小数>
    参数 纵分量 <类型 = 小数>
    {
        @ (intptr_t)occt2d_vec_new(@<横分量>, @<纵分量>)
    }

    方法 点到点向量 <公开 静态 类型 = 变整数 注释 = "由起点和终点创建 gp_Vec2d。" 折叠 @嵌入式方法 = "">
    参数 点1 <类型 = 变整数>
    参数 点2 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_vec_from_points((void*)@<点1>, (void*)@<点2>)
    }

    方法 向量横分量 <公开 静态 类型 = 小数 注释 = "读取 gp_Vec2d.X。" 折叠 @嵌入式方法 = "">
    参数 指针 <类型 = 变整数>
    {
