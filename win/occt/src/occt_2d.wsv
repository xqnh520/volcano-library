<火山程序 类型 = "通常" 版本 = 1 />

包 火山.OCCT二维 <注释 = "Open CASCADE Technology 8.0 二维CAD核心封装。" 注释 = "PIV风格：火山类保存原生指针，实际调用进入 native/occt_2d_bridge.cpp。"
        注释 = "版本8：封装 V3d_View、WNT_Window、OpenGl_GraphicDriver 低层模块，支持用户自行组合 OCCT 渲染管线。" @视窗.头文件搜寻目录 = "..\\native"
        @视窗.头文件搜寻目录 = "..\\lib\\opencascade-8.0.0-vc14-64\\inc" "@视窗.外部头文件.全局-100" = "occt_2d_bridge.hpp"
        @视窗.外部源文件 = "..\\native\\occt_2d_bridge.cpp" @视窗.预定义宏 = "UNICODE,_UNICODE,OCCT2D_VOLCANO"
        @视窗.附加编译参数 = "cpp: /std:c++17 /FS" @视窗.库文件搜寻目录.x64 = "..\\lib\\opencascade-8.0.0-vc14-64\\win64\\vc14\\lib"
        @视窗.外部库.x64 = "TKernel.lib,TKMath.lib,TKG2d.lib,TKG3d.lib,TKGeomBase.lib,TKGeomAlgo.lib,TKBRep.lib,TKTopAlgo.lib,TKBO.lib,TKPrim.lib,TKMesh.lib,TKFillet.lib,TKOffset.lib,TKShHealing.lib,TKFeat.lib,TKHLR.lib,TKService.lib,TKV3d.lib,TKOpenGl.lib,TKViewerTest.lib,TKXSBase.lib,TKDESTEP.lib,TKDEIGES.lib,TKDESTL.lib,TKDEPLY.lib,TKDEOBJ.lib,TKRWMesh.lib,TKLCAF.lib,TKCDF.lib,TKCAF.lib,TKXCAF.lib,TKDraw.lib,Gdiplus.lib,opengl32.lib"
        @视窗.附属文件.x64 = "..\\lib\\opencascade-8.0.0-vc14-64\\win64\\vc14\\bin"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\tbb-2021.13.0-x64\\bin"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\jemalloc-vc14-64\\bin"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\openvr-1.14.15-64\\bin\\win64"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\freeimage-3.18.0-x64\\bin"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\ffmpeg-3.3.4-64\\bin"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\freetype-2.13.3-x64\\bin"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\tcltk-8.6.15-x64\\bin"
        @视窗.附属文件.x64 = "..\\lib\\3rdparty-vc14-64\\msvc-vc14-64">

类 OCCT二维原生桥接 <公开 注释 = "原生桥接入口。通常不直接使用，外层类会调用这些方法。">
{
    方法 版本 <公开 静态 类型 = 文本型 注释 = "返回 OCCT 版本。" 折叠 @嵌入式方法 = "">
    {
        @ occt2d_version()
    }

    方法 置键盘焦点 <公开 静态 类型 = 逻辑型 注释 = "把键盘输入焦点设置到指定 HWND，绘图窗口收到鼠标事件后可调用本方法以便接收快捷键。" 折叠 @嵌入式方法 = "">
    参数 窗口句柄 <类型 = 变整数 注释 = "需要接收键盘事件的窗口或组件 HWND。">
    {
        @ occt2d_focus_window((void*)@<窗口句柄>)
    }

    方法 按键是否按下 <公开 静态 类型 = 逻辑型 注释 = "读取指定虚拟键是否处于按下状态。" 折叠 @嵌入式方法 = "">
    参数 键代码 <类型 = 整数 注释 = "Win32 虚拟键代码，也可直接传入火山按键码事件参数。">
    {
        @ occt2d_key_down(@<键代码>)
    }

    方法 Ctrl键按下 <公开 静态 类型 = 逻辑型 注释 = "返回 Ctrl 键当前是否按下。" 折叠 @嵌入式方法 = "">
    {
        @ occt2d_ctrl_down()
    }

    方法 Shift键按下 <公开 静态 类型 = 逻辑型 注释 = "返回 Shift 键当前是否按下。" 折叠 @嵌入式方法 = "">
    {
        @ occt2d_shift_down()
    }

    方法 Alt键按下 <公开 静态 类型 = 逻辑型 注释 = "返回 Alt 键当前是否按下。" 折叠 @嵌入式方法 = "">
    {
        @ occt2d_alt_down()
    }

    方法 释放 <公开 静态 类型 = 逻辑型 注释 = "按类型释放原生对象。" 折叠 @嵌入式方法 = "">
    参数 类型名 <类型 = 文本型>
    参数 指针 <类型 = 变整数>
    {
        @ occt2d_delete(@<类型名>.GetText(), (void*)@<指针>)
    }

    方法 取图形驱动共享上下文 <公开 静态 类型 = 变整数 注释 = "获取 OpenGl_GraphicDriver 共享的 OpenGl_Context 指针（非拥有引用）。" 折叠 @嵌入式方法 = "">
    参数 驱动指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_driver_shared_context((void*)@<驱动指针>)
    }

    方法 取OpenGL视图 <公开 静态 类型 = 变整数 注释 = "从 V3d_View 获取 OpenGl_View 封装指针。" 折叠 @嵌入式方法 = "">
    参数 视图指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_view_from_v3d_view((void*)@<视图指针>)
    }

    方法 取OpenGL窗口 <公开 静态 类型 = 变整数 注释 = "从 OpenGl_View 获取 OpenGl_Window 封装指针。" 折叠 @嵌入式方法 = "">
    参数 视图指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_view_gl_window((void*)@<视图指针>)
    }

    方法 取窗口设备上下文 <公开 静态 类型 = 变整数 注释 = "从 OpenGl_Window 获取 OpenGl_Context 指针（非拥有引用）。" 折叠 @嵌入式方法 = "">
    参数 窗口指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_window_get_gl_context((void*)@<窗口指针>)
    }

    方法 取着色器管理器 <公开 静态 类型 = 变整数 注释 = "从 OpenGl_Context 获取 OpenGl_ShaderManager 封装指针。" 折叠 @嵌入式方法 = "">
    参数 上下文指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_opengl_shader_manager_from_context((void*)@<上下文指针>)
    }

    方法 新建着色器程序 <公开 静态 类型 = 变整数 注释 = "创建空的 OpenGl_ShaderProgram 封装指针。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)occt2d_opengl_shader_program_new()
    }

    方法 新建纹理 <公开 静态 类型 = 变整数 注释 = "创建空的 OpenGl_Texture 封装指针。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)occt2d_opengl_texture_new()
    }

    方法 新建帧缓冲 <公开 静态 类型 = 变整数 注释 = "创建空的 OpenGl_FrameBuffer 封装指针。" 折叠 @嵌入式方法 = "">
    {
        @ (intptr_t)occt2d_opengl_framebuffer_new()
    }

    方法 取结构管理器 <公开 静态 类型 = 变整数 注释 = "从 V3d_Viewer 取 Graphic3d_StructureManager 封装指针。" 折叠 @嵌入式方法 = "">
    参数 查看器指针 <类型 = 变整数>
