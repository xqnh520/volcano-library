    }

    方法 向量叉积 <公开 静态 类型 = 小数 注释 = "计算两个 gp_Vec2d 的二维叉积值。" 折叠 @嵌入式方法 = "">
    参数 向量1 <类型 = 变整数>
    参数 向量2 <类型 = 变整数>
    {
        @ occt2d_vec_crossed((void*)@<向量1>, (void*)@<向量2>)
    }

    方法 单位化向量 <公开 静态 类型 = 变整数 注释 = "返回单位化后的新 gp_Vec2d。" 折叠 @嵌入式方法 = "">
    参数 指针 <类型 = 变整数>
    {
        @ (intptr_t)occt2d_vec_normalized((void*)@<指针>)
    }

