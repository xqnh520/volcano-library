    }

    方法 向量纵分量 <公开 静态 类型 = 小数 注释 = "读取 gp_Vec2d.Y。" 折叠 @嵌入式方法 = "">
    参数 指针 <类型 = 变整数>
    {
        @ occt2d_vec_y((void*)@<指针>)
    }

