类 OCCT快速缝合状态 <公开 注释 = "BRepBuilderAPI_FastSewing::FS_Statuses 状态位常量。头文件：BRepBuilderAPI_FastSewing.hxx" 折叠>
{
    常量 正常 <公开 类型 = 整数 值 = 0 注释 = "FS_OK：无错误。">
    常量 退化 <公开 类型 = 整数 值 = 1 注释 = "FS_Degenerated：存在退化拓扑。">
    常量 查找顶点错误 <公开 类型 = 整数 值 = 2 注释 = "FS_FindVertexError：查找顶点失败。">
    常量 查找边错误 <公开 类型 = 整数 值 = 4 注释 = "FS_FindEdgeError：查找边失败。">
    常量 空曲面面 <公开 类型 = 整数 值 = 8 注释 = "FS_FaceWithNullSurface：面缺少曲面。">
    常量 非自然边界面 <公开 类型 = 整数 值 = 16 注释 = "FS_NotNaturalBoundsFace：面不是自然边界。">
    常量 无限曲面 <公开 类型 = 整数 值 = 32 注释 = "FS_InfiniteSurface：存在无限曲面。">
    常量 空输入 <公开 类型 = 整数 值 = 64 注释 = "FS_EmptyInput：没有可缝合输入。">
    常量 异常 <公开 类型 = 整数 值 = 128 注释 = "FS_Exception：算法执行中捕获异常。">

    方法 包含 <公开 静态 类型 = 逻辑型 注释 = "判断状态位中是否包含指定 FastSewing 状态。" 折叠 @嵌入式方法 = "">
    参数 状态位 <类型 = 整数>
    参数 状态 <类型 = 整数>
    {
        @ ((@<状态位> & @<状态>) != 0)
    }
}

