类 OCCT二维坐标系 <公开 基础类 = OCCT二维对象 注释 = "gp_Ax22d：二维正交坐标系。头文件：gp_Ax22d.hxx" 折叠>
{
    方法 创建 <公开 静态 类型 = OCCT二维坐标系 注释 = "按原点、X方向、Y方向创建 gp_Ax22d。">
    参数 原点X <类型 = 小数>
    参数 原点Y <类型 = 小数>
    参数 X方向X <类型 = 小数>
    参数 X方向Y <类型 = 小数>
    参数 Y方向X <类型 = 小数>
    参数 Y方向Y <类型 = 小数>
    {
        变量 坐标系 <类型 = OCCT二维坐标系>
        坐标系.对象指针 = OCCT几何算法补充模块.CallAx22dNew (原点X, 原点Y, X方向X, X方向Y, Y方向X, Y方向Y)
        坐标系.对象类型 = "ax22d"
        返回 (坐标系)
    }

    方法 位置 <公开 类型 = OCCT二维点 注释 = "返回坐标系原点。">
    {
        变量 点 <类型 = OCCT二维点>
        点.对象指针 = OCCT几何算法补充模块.CallAx22dLocation (对象指针)
        点.对象类型 = "point"
        返回 (点)
    }

    方法 X轴 <公开 类型 = OCCT二维坐标轴 注释 = "返回 X 轴。">
    {
        变量 坐标轴 <类型 = OCCT二维坐标轴>
        坐标轴.对象指针 = OCCT几何算法补充模块.CallAx22dXaxis (对象指针)
        坐标轴.对象类型 = "axis"
        返回 (坐标轴)
    }

    方法 Y轴 <公开 类型 = OCCT二维坐标轴 注释 = "返回 Y 轴。">
    {
        变量 坐标轴 <类型 = OCCT二维坐标轴>
        坐标轴.对象指针 = OCCT几何算法补充模块.CallAx22dYaxis (对象指针)
        坐标轴.对象类型 = "axis"
        返回 (坐标轴)
    }
}

类 OCCT三维标准圆 <公开 基础类 = OCCT二维对象 注释 = "gp_Circ：三维圆。头文件：gp_Circ.hxx" 折叠>
{
    方法 创建 <公开 静态 类型 = OCCT三维标准圆 注释 = "按中心、法向和半径创建 gp_Circ。">
    参数 中心X <类型 = 小数>
    参数 中心Y <类型 = 小数>
    参数 中心Z <类型 = 小数>
    参数 法向X <类型 = 小数>
    参数 法向Y <类型 = 小数>
    参数 法向Z <类型 = 小数>
    参数 半径 <类型 = 小数>
    {
        变量 圆 <类型 = OCCT三维标准圆>
        圆.对象指针 = OCCT几何算法补充模块.CallCirc3dNew (中心X, 中心Y, 中心Z, 法向X, 法向Y, 法向Z, 半径)
        圆.对象类型 = "circ3d"
        返回 (圆)
    }

    方法 半径 <公开 类型 = 小数 注释 = "返回圆半径。">
    {
        返回 (OCCT几何算法补充模块.CallCirc3dRadius (对象指针))
    }

    方法 置半径 <公开 类型 = 逻辑型 注释 = "设置圆半径；非法半径返回假。">
    参数 半径 <类型 = 小数>
    {
        返回 (OCCT几何算法补充模块.CallCirc3dSetRadius (对象指针, 半径))
    }

    方法 面积 <公开 类型 = 小数 注释 = "返回圆面积。">
    {
        返回 (OCCT几何算法补充模块.CallCirc3dArea (对象指针))
    }

    方法 周长 <公开 类型 = 小数 注释 = "返回圆周长。">
    {
        返回 (OCCT几何算法补充模块.CallCirc3dLength (对象指针))
    }

    方法 位置 <公开 类型 = OCCT三维点 注释 = "返回圆心位置。">
    {
        变量 点 <类型 = OCCT三维点>
        点.对象指针 = OCCT几何算法补充模块.CallCirc3dLocation (对象指针)
        点.对象类型 = "pnt3d"
        返回 (点)
    }
}

