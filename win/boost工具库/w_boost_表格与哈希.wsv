<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——CSV 表格文档与 SHA1/MD5 哈希部分。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 CSV文档类 <公开 折叠 折叠2 注释 = "CSV 表格文档（自研解析器）：先「解析」，再按行列读写单元格，最后可用「转文本」输出。字段以双引号开头即引号字段，内部连续两个双引号表示一个双引号，引号内可以出现分隔符与换行（多行字段）。各行列数可以不相等；完全空的行会被跳过，行尾多余的尾随空列会保留。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层表格句柄，0 表示尚未解析。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            CSV释放 (句柄)
            句柄 = 0
        }
    }

    方法 取CSV句柄 <公开 静态 类型 = 变整数 注释 = "底层解析 CSV 文本，返回句柄（供本类内部使用）。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 文本 <类型 = 文本型 注释 = "待解析的 CSV 文本，换行符可以是 CRLF、LF 或 CR，也可以混用。">
    参数 分隔符 <类型 = 文本型 注释 = "字段分隔符；为空文本时用英文逗号，多字符只看第一个字符。">
    {
        @ FB_csv_parse (@<文本>, @<分隔符>)
    }

    方法 CSV释放 <公开 静态 类型 = 逻辑型 注释 = "释放表格句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 表格句柄 <类型 = 变整数 注释 = "CSV 表格句柄。">
    {
        @ (FB_csv_free (@<表格句柄>) != 0)
    }

    方法 解析 <公开 类型 = 逻辑型 注释 = "解析 CSV 文本装入本对象；会先释放上一次的内容（先算后换，解析失败时旧内容保持不变）。" 返回值注释 = "解析成功返回真；空文本也算成功（得到 0 行）。底层出错返回假。" 折叠>
    参数 文本 <类型 = 文本型 注释 = "待解析的 CSV 文本。">
    参数 分隔符 <类型 = 文本型 注释 = "字段分隔符；为空文本时用英文逗号。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取CSV句柄 (文本, 分隔符)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            CSV释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 取行数 <公开 类型 = 整数 注释 = "返回表格的行数；句柄未建立时返回 -1。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (-1)
        }
        返回 (取表格行数 (句柄))
    }

    方法 取表格行数 <公开 静态 类型 = 整数 注释 = "底层取行数，句柄无效返回 -1。" 折叠 @嵌入式方法 = "">
    参数 表格句柄 <类型 = 变整数 注释 = "CSV 表格句柄。">
    {
        @ FB_csv_rows (@<表格句柄>)
    }

    方法 取列数 <公开 类型 = 整数 注释 = "返回指定行的列数（各行可以不相等）。" 返回值注释 = "行号越界返回 0；句柄未建立返回 -1。" 折叠>
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    {
        如果 (句柄 == 0)
        {
            返回 (-1)
        }
        返回 (取表格列数 (句柄, 行号))
    }

    方法 取表格列数 <公开 静态 类型 = 整数 注释 = "底层取某一行的列数。" 折叠 @嵌入式方法 = "">
    参数 表格句柄 <类型 = 变整数 注释 = "CSV 表格句柄。">
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    {
        @ FB_csv_cols (@<表格句柄>, @<行号>)
    }

    方法 取单元格 <公开 类型 = 文本型 注释 = "读取指定行列的单元格内容。" 返回值注释 = "行号或列号越界、句柄未建立时返回空文本。" 折叠>
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    参数 列号 <类型 = 整数 注释 = "列号，从 0 开始。">
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (取表格单元格 (句柄, 行号, 列号))
    }

    方法 取表格单元格 <公开 静态 类型 = 文本型 注释 = "底层读取单元格。" 折叠 @嵌入式方法 = "">
    参数 表格句柄 <类型 = 变整数 注释 = "CSV 表格句柄。">
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    参数 列号 <类型 = 整数 注释 = "列号，从 0 开始。">
    {
        @ CWString(FB_csv_cell (@<表格句柄>, @<行号>, @<列号>))
    }

    方法 取整行 <公开 类型 = 文本型 注释 = "把整行用分隔符连接成一段文本；不做任何转义，只做连接。分隔符只取首字符，与「解析」侧一致，所以结果可以按同一分隔符再解析回去。" 返回值注释 = "行号越界或句柄未建立时返回空文本。" 折叠>
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    参数 分隔符 <类型 = 文本型 注释 = "连接用的分隔符；为空文本时用英文逗号，多字符只取第一个字符。">
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (取表格整行 (句柄, 行号, 分隔符))
    }

    方法 取表格整行 <公开 静态 类型 = 文本型 注释 = "底层把整行连接成文本。" 折叠 @嵌入式方法 = "">
    参数 表格句柄 <类型 = 变整数 注释 = "CSV 表格句柄。">
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    参数 分隔符 <类型 = 文本型 注释 = "连接用的分隔符。">
    {
        @ CWString(FB_csv_row_text (@<表格句柄>, @<行号>, @<分隔符>))
    }

    方法 设置单元格 <公开 类型 = 逻辑型 注释 = "改写指定行列的单元格内容；不会自动增加列。" 返回值注释 = "写入成功返回真；行号或列号越界、句柄未建立返回假。" 折叠>
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    参数 列号 <类型 = 整数 注释 = "列号，从 0 开始。">
    参数 新文本 <类型 = 文本型 注释 = "要写入的内容，可以含分隔符与换行。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (写入表格单元格 (句柄, 行号, 列号, 新文本))
    }

    方法 写入表格单元格 <公开 静态 类型 = 逻辑型 注释 = "底层写入单元格。" 折叠 @嵌入式方法 = "">
    参数 表格句柄 <类型 = 变整数 注释 = "CSV 表格句柄。">
    参数 行号 <类型 = 整数 注释 = "行号，从 0 开始。">
    参数 列号 <类型 = 整数 注释 = "列号，从 0 开始。">
    参数 新文本 <类型 = 文本型 注释 = "要写入的内容。">
    {
        @ (FB_csv_set (@<表格句柄>, @<行号>, @<列号>, @<新文本>) != 0)
    }

    方法 转文本 <公开 类型 = 文本型 注释 = "把整张表格输出为 CSV 文本：字段含分隔符、双引号、换行或首尾空白时自动加引号，内部的双引号写成两个。" 返回值注释 = "句柄未建立时返回空文本；空表格返回空文本。" 折叠>
    参数 分隔符 <类型 = 文本型 注释 = "输出用的分隔符；为空文本时用英文逗号，多字符只取第一个字符（与解析侧一致，保证输出能被原样读回）。">
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (输出CSV文本 (句柄, 分隔符))
    }

    方法 输出CSV文本 <公开 静态 类型 = 文本型 注释 = "底层输出 CSV 文本。" 折叠 @嵌入式方法 = "">
    参数 表格句柄 <类型 = 变整数 注释 = "CSV 表格句柄。">
    参数 分隔符 <类型 = 文本型 注释 = "输出用的分隔符。">
    {
        @ CWString(FB_csv_dump (@<表格句柄>, @<分隔符>))
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "立即释放底层表格；对象销毁时也会自动释放。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = CSV释放 (句柄)
        句柄 = 0
        返回 (结果)
    }
}

类 哈希工具 <公开 折叠 折叠2 注释 = "哈希摘要（SHA1 与 MD5）。全部为静态方法，直接用类名调用。文本一律按 UTF-8 字节计算，因此英文结果与 RFC 3174 / RFC 1321 的标准测试向量逐字相同，中文也与其它工具算出的结果一致。底层使用 boost/uuid/detail 下的实现头，属 boost 内部实现（详见 README 第十节）。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 取SHA1 <公开 静态 类型 = 文本型 注释 = "计算文本的 SHA1 摘要，按 UTF-8 字节计算。" 返回值注释 = "返回 40 位小写十六进制文本；空文本返回空文本的 SHA1（da39a3ee...）。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要计算摘要的文本，中文会先转成 UTF-8 字节。">
    {
        @ CWString(FB_hash_sha1_text (@<原文本>))
    }

    方法 取SHA1文件 <公开 静态 类型 = 文本型 注释 = "计算文件内容的 SHA1 摘要；分块读取，大文件也不占内存。" 返回值注释 = "返回 40 位小写十六进制文本；文件打不开或读失败时返回空文本，原因见「文字工具.取错误说明 ()」。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 文件路径 <类型 = 文本型 注释 = "要计算摘要的文件路径，支持中文路径。">
    {
        @ CWString(FB_hash_sha1_file (@<文件路径>))
    }

    方法 取MD5 <公开 静态 类型 = 文本型 注释 = "计算文本的 MD5 摘要，按 UTF-8 字节计算。" 返回值注释 = "返回 32 位小写十六进制文本；空文本返回空文本的 MD5（d41d8cd9...）。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要计算摘要的文本，中文会先转成 UTF-8 字节。">
    {
        @ CWString(FB_hash_md5_text (@<原文本>))
    }

    方法 取MD5文件 <公开 静态 类型 = 文本型 注释 = "计算文件内容的 MD5 摘要；分块读取，大文件也不占内存。" 返回值注释 = "返回 32 位小写十六进制文本；文件打不开或读失败时返回空文本，原因见「文字工具.取错误说明 ()」。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 文件路径 <类型 = 文本型 注释 = "要计算摘要的文件路径，支持中文路径。">
    {
        @ CWString(FB_hash_md5_file (@<文件路径>))
    }
}
