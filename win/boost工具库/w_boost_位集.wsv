<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——位集（boost/dynamic_bitset）部分：任意长度的二进制位集合，支持按位读写、翻转、定长调整、与或异或与非四则运算，以及二进制与十六进制文本互转。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 位集类 <公开 折叠 折叠2 注释 = "任意长度的位集合（boost/dynamic_bitset）：先「建立」或「从文本建立」，再按位读写、翻转、调整长度，最后用「转二进制文本」「转十六进制文本」输出。★位序约定（务必记住）：第 0 位是二进制文本里**最右**的那个字符。所以「从文本建立 (#1010)」之后，取位 (1) 得到 1、取位 (0) 得到 0；转二进制文本 () 会还原成 #1010 。转十六进制文本 () 从低位开始每 4 位一组、去掉前导 0，全 0 时返回 #0 。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层位集句柄，0 表示尚未建立。">

    常量 与运算 <公开 类型 = 整数 值 = 0 注释 = "运算类型：按位与（1 与 1 才为 1）。">
    常量 或运算 <公开 类型 = 整数 值 = 1 注释 = "运算类型：按位或（有 1 即为 1）。">
    常量 异或运算 <公开 类型 = 整数 值 = 2 注释 = "运算类型：按位异或（不同才为 1）。">
    常量 与非运算 <公开 类型 = 整数 值 = 3 注释 = "运算类型：本对象与另一位集取反后相与（本对象为 1 且对方为 0 才为 1，即差集）。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            位集释放 (句柄)
            句柄 = 0
        }
    }

    方法 取新建句柄 <公开 静态 类型 = 变整数 注释 = "底层新建一个指定长度的全 0 位集，返回句柄（供本类内部与高级用法使用）。" 折叠 @嵌入式方法 = "">
    参数 位数 <类型 = 长整数 注释 = "位集长度；负数按 0 处理。">
    {
        @ FB_bitset_new (@<位数>)
    }

    方法 取解析句柄 <公开 静态 类型 = 变整数 注释 = "底层把二进制文本解析成位集，返回句柄（供本类内部与高级用法使用）。支持 0b 前缀与 b 后缀；含非法字符时返回 0。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 位文本 <类型 = 文本型 注释 = "只含 0 与 1 的文本，例如 「1010」、「0b1010」、「1010b」。">
    {
        @ FB_bitset_from_text (@<位文本>)
    }

    方法 取运算句柄 <公开 静态 类型 = 变整数 注释 = "底层对两个位集做运算，返回新位集句柄（供本类内部与高级用法使用）；长度不同或句柄无效时返回 0。" 折叠 @嵌入式方法 = "">
    参数 句柄甲 <类型 = 变整数 注释 = "第一个位集句柄。">
    参数 句柄乙 <类型 = 变整数 注释 = "第二个位集句柄，长度必须与第一个相同。">
    参数 运算类型 <类型 = 整数 注释 = "0=与 1=或 2=异或 3=甲与乙非（差集）。">
    {
        @ FB_bitset_op (@<句柄甲>, @<句柄乙>, @<运算类型>)
    }

    方法 取副本句柄 <公开 静态 类型 = 变整数 注释 = "底层复制一个位集，返回新句柄（供本类内部与高级用法使用）。" 折叠 @嵌入式方法 = "">
    参数 源句柄 <类型 = 变整数 注释 = "要复制的位集句柄。">
    {
        @ FB_bitset_clone (@<源句柄>)
    }

    方法 位集释放 <公开 静态 类型 = 逻辑型 注释 = "释放位集句柄；重复释放返回假但不会出错。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "要释放的位集句柄。">
    {
        @ (FB_bitset_free (@<目标句柄>) != 0)
    }

    方法 建立 <公开 类型 = 逻辑型 注释 = "建立一个新的全 0 位集并装入本对象；会先释放上一次的内容（先算后换，失败时旧内容保持不变）。" 返回值注释 = "成功返回真；位数过大导致内存不足时返回假。" 折叠>
    参数 位数 <类型 = 长整数 注释 = "位集长度；负数按 0 处理。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取新建句柄 (位数)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            位集释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 从文本建立 <公开 类型 = 逻辑型 注释 = "把二进制文本解析成位集并装入本对象；会先释放上一次的内容（先算后换）。最右边的字符是第 0 位。" 返回值注释 = "成功返回真；文本为空、含 0 与 1 以外的字符时返回假，原因见「文字工具.取错误说明 ()」。" 折叠>
    参数 位文本 <类型 = 文本型 注释 = "只含 0 与 1 的文本，允许 0b 前缀或 b 后缀。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取解析句柄 (位文本)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            位集释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 取位数 <公开 类型 = 整数 注释 = "取位集的长度（位数）。" 返回值注释 = "句柄未建立时返回 -1。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (-1)
        }
        返回 (取底层位数 (句柄))
    }

    方法 取底层位数 <公开 静态 类型 = 整数 注释 = "底层取位数，句柄无效返回 -1。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    {
        @ FB_bitset_count (@<目标句柄>)
    }

    方法 取真值个数 <公开 类型 = 整数 注释 = "取位集里 1 的个数。" 返回值注释 = "句柄未建立时返回 -1。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (-1)
        }
        返回 (取底层真值个数 (句柄))
    }

    方法 取底层真值个数 <公开 静态 类型 = 整数 注释 = "底层取 1 的个数，句柄无效返回 -1。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    {
        @ FB_bitset_true_count (@<目标句柄>)
    }

    方法 取位 <公开 类型 = 整数 注释 = "读取某一位的值（第 0 位是最右边的字符）。" 返回值注释 = "该位为 1 返回 1，为 0 返回 0；位号越界或句柄未建立返回 -1。" 折叠>
    参数 位序号 <类型 = 长整数 注释 = "位号，从 0 开始（0 是最低位）。">
    {
        如果 (句柄 == 0)
        {
            返回 (-1)
        }
        返回 (取底部位值 (句柄, 位序号))
    }

    方法 取底部位值 <公开 静态 类型 = 整数 注释 = "底层读取某一位，越界或句柄无效返回 -1。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    参数 位序号 <类型 = 长整数 注释 = "位号，从 0 开始。">
    {
        @ FB_bitset_test (@<目标句柄>, @<位序号>)
    }

    方法 设位 <公开 类型 = 逻辑型 注释 = "把某一位设为指定值。越界不会自动扩容，需要扩容请先调用「调整长度」。" 返回值注释 = "写入成功返回真；位号越界或句柄未建立返回假。" 折叠>
    参数 位序号 <类型 = 长整数 注释 = "位号，从 0 开始。">
    参数 新值 <类型 = 逻辑型 注释 = "为真时置 1，为假时置 0。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (写入底部位 (句柄, 位序号, 新值))
    }

    方法 写入底部位 <公开 静态 类型 = 逻辑型 注释 = "底层写入某一位，越界或句柄无效返回假。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    参数 位序号 <类型 = 长整数 注释 = "位号，从 0 开始。">
    参数 置位值 <类型 = 逻辑型 注释 = "为真时置 1，为假时置 0。">
    {
        @ (FB_bitset_set (@<目标句柄>, @<位序号>, (@<置位值> ? 1 : 0)) != 0)
    }

    方法 翻转位 <公开 类型 = 逻辑型 注释 = "把某一位取反（0 变 1，1 变 0）。" 返回值注释 = "成功返回真；位号越界或句柄未建立返回假。" 折叠>
    参数 位序号 <类型 = 长整数 注释 = "位号，从 0 开始。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (翻转底部位 (句柄, 位序号))
    }

    方法 翻转底部位 <公开 静态 类型 = 逻辑型 注释 = "底层翻转某一位，越界或句柄无效返回假。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    参数 位序号 <类型 = 长整数 注释 = "位号，从 0 开始。">
    {
        @ (FB_bitset_flip (@<目标句柄>, @<位序号>) != 0)
    }

    方法 全部翻转 <公开 类型 = 逻辑型 注释 = "把所有位一起取反（0 全变 1，1 全变 0）。" 返回值注释 = "成功返回真；句柄未建立返回假。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (翻转全部位 (句柄))
    }

    方法 翻转全部位 <公开 静态 类型 = 逻辑型 注释 = "底层全部翻转，句柄无效返回假。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    {
        @ (FB_bitset_flip_all (@<目标句柄>) != 0)
    }

    方法 调整长度 <公开 类型 = 逻辑型 注释 = "把位集长度改成指定值：变长时新增的高位填指定的值，变短时丢掉高位。" 返回值注释 = "成功返回真；目标长度为负数、句柄未建立或内存不足时返回假。" 折叠>
    参数 新位数 <类型 = 长整数 注释 = "新的位集长度，不能为负数。">
    参数 填充值 <类型 = 逻辑型 注释 = "变长时新增位的取值：为真填 1，为假填 0。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (调整底层长度 (句柄, 新位数, 填充值))
    }

    方法 调整底层长度 <公开 静态 类型 = 逻辑型 注释 = "底层调整长度，失败返回假。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    参数 新位数 <类型 = 长整数 注释 = "新的长度。">
    参数 填充值 <类型 = 逻辑型 注释 = "变长时新增位的取值。">
    {
        @ (FB_bitset_resize (@<目标句柄>, @<新位数>, (@<填充值> ? 1 : 0)) != 0)
    }

    方法 转二进制文本 <公开 类型 = 文本型 注释 = "输出二进制文本：高位在左，长度正好等于位数（全 0 的 8 位就是 #00000000 ，不会是空文本）。" 返回值注释 = "句柄未建立时返回空文本。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (取二进制文本 (句柄))
    }

    方法 取二进制文本 <公开 静态 类型 = 文本型 注释 = "底层输出二进制文本。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    {
        @ CWString(FB_bitset_to_binary (@<目标句柄>))
    }

    方法 转十六进制文本 <公开 类型 = 文本型 注释 = "输出十六进制文本：从低位开始每 4 位一组，去掉前导 0；全 0 时返回 #0 ，位数为 5 时会补成两位（例如 #10000 得到 #10 ）。" 返回值注释 = "句柄未建立时返回空文本。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (取十六进制文本 (句柄))
    }

    方法 取十六进制文本 <公开 静态 类型 = 文本型 注释 = "底层输出十六进制文本。" 折叠 @嵌入式方法 = "">
    参数 目标句柄 <类型 = 变整数 注释 = "位集句柄。">
    {
        @ CWString(FB_bitset_to_hex (@<目标句柄>))
    }

    方法 运算 <公开 类型 = 逻辑型 注释 = "与另一个位集做按位运算，结果替换本对象的内容（先算后换，失败时本对象保持不变）。两个位集的长度必须相同。" 返回值注释 = "成功返回真；任一对象未建立、长度不同或运算类型非法时返回假，原因见「文字工具.取错误说明 ()」。" 折叠>
    参数 另一位集 <类型 = 位集类 注释 = "参与运算的另一个位集对象。">
    参数 运算类型 <类型 = 整数 注释 = "0=与 1=或 2=异或 3=与非（差集）；可直接写本类的常量「与运算」「或运算」「异或运算」「与非运算」。">
    {
        如果 (句柄 == 0 || 另一位集.句柄 == 0)
        {
            返回 (假)
        }
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取运算句柄 (句柄, 另一位集.句柄, 运算类型)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        位集释放 (句柄)
        句柄 = 新句柄
        返回 (真)
    }

    方法 复制到 <公开 类型 = 逻辑型 注释 = "把本对象的内容复制给另一个位集对象（目标对象原来的内容会被释放）。复制后两个对象各自独立，改一个不影响另一个。" 返回值注释 = "成功返回真；本对象未建立或内存不足时返回假。" 折叠>
    参数 目标位集 <类型 = 位集类 注释 = "接收内容的位集对象。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取副本句柄 (句柄)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (目标位集.句柄 != 0)
        {
            位集释放 (目标位集.句柄)
        }
        目标位集.句柄 = 新句柄
        返回 (真)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "立即释放底层位集；对象销毁时也会自动释放。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = 位集释放 (句柄)
        句柄 = 0
        返回 (结果)
    }
}
