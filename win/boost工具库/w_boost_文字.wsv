<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——文字、正则、日期时间、校验、统计、大整数、JSON、INI 配置、双向映射表。所有方法名、参数名与注释均为中文；底层经 native\\VolcanoBoostBridge.dll 调用 boost 1.86.0。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 文字工具 <公开 折叠 折叠2 注释 = "文字处理底层（boost/algorithm/string、boost/lexical_cast）。全部为静态方法，直接用类名调用。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 取版本 <公开 静态 类型 = 文本型 注释 = "返回本模块及底层 boost 的版本文本。" 折叠 @嵌入式方法 = "">
    {
        @ CWString(FB_version ())
    }

    方法 取错误说明 <公开 静态 类型 = 文本型 注释 = "返回最近一次底层调用失败的中文原因。" 折叠 @嵌入式方法 = "">
    {
        @ CWString(FB_error_text ())
    }

    方法 去首尾空白 <公开 静态 类型 = 文本型 注释 = "删除文本首尾的空格、制表符、回车与换行。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    {
        @ CWString(FB_text_trim (@<原文本>))
    }

    方法 去左侧空白 <公开 静态 类型 = 文本型 注释 = "只删除文本首部的空白字符。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    {
        @ CWString(FB_text_trim_left (@<原文本>))
    }

    方法 去右侧空白 <公开 静态 类型 = 文本型 注释 = "只删除文本尾部的空白字符。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    {
        @ CWString(FB_text_trim_right (@<原文本>))
    }

    方法 去指定字符 <公开 静态 类型 = 文本型 注释 = "删除文本首尾出现在指定字符集合中的任意字符。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    参数 字符集合 <类型 = 文本型 注释 = "要去除的字符集合，例如 「,;」 表示逗号与分号都算；留空等同去空白。">
    {
        @ CWString(FB_text_trim_chars (@<原文本>, @<字符集合>))
    }

    方法 转大写 <公开 静态 类型 = 文本型 注释 = "把英文字母转为大写，中文等字符不变。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待转换的文本。">
    {
        @ CWString(FB_text_upper (@<原文本>))
    }

    方法 转小写 <公开 静态 类型 = 文本型 注释 = "把英文字母转为小写，中文等字符不变。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待转换的文本。">
    {
        @ CWString(FB_text_lower (@<原文本>))
    }

    方法 全部替换 <公开 静态 类型 = 文本型 注释 = "把文本中所有出现的子文本替换为另一段文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    参数 查找文本 <类型 = 文本型 注释 = "要被替换掉的子文本；为空时不作替换。">
    参数 替换文本 <类型 = 文本型 注释 = "替换为的新文本，可为空文本即删除。">
    {
        @ CWString(FB_text_replace_all (@<原文本>, @<查找文本>, @<替换文本>))
    }

    方法 首次替换 <公开 静态 类型 = 文本型 注释 = "只替换文本中第一次出现的子文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    参数 查找文本 <类型 = 文本型 注释 = "要被替换掉的子文本。">
    参数 替换文本 <类型 = 文本型 注释 = "替换为的新文本。">
    {
        @ CWString(FB_text_replace_first (@<原文本>, @<查找文本>, @<替换文本>))
    }

    方法 删除所有 <公开 静态 类型 = 文本型 注释 = "删除文本中所有出现的指定子文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    参数 查找文本 <类型 = 文本型 注释 = "要删除的子文本。">
    {
        @ CWString(FB_text_erase_all (@<原文本>, @<查找文本>))
    }

    方法 忽略大小写包含 <公开 静态 类型 = 逻辑型 注释 = "判断文本中是否包含指定子文本，忽略英文大小写。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "被查找的文本。">
    参数 查找文本 <类型 = 文本型 注释 = "要查找的子文本。">
    {
        @ (FB_text_icontains (@<原文本>, @<查找文本>) != 0)
    }

    方法 忽略大小写开头 <公开 静态 类型 = 逻辑型 注释 = "判断文本是否以指定子文本开头，忽略英文大小写。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "被判断的文本。">
    参数 查找文本 <类型 = 文本型 注释 = "作为前缀的子文本。">
    {
        @ (FB_text_istarts_with (@<原文本>, @<查找文本>) != 0)
    }

    方法 忽略大小写结尾 <公开 静态 类型 = 逻辑型 注释 = "判断文本是否以指定子文本结尾，忽略英文大小写。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "被判断的文本。">
    参数 查找文本 <类型 = 文本型 注释 = "作为后缀的子文本。">
    {
        @ (FB_text_iends_with (@<原文本>, @<查找文本>) != 0)
    }

    方法 忽略大小写相等 <公开 静态 类型 = 逻辑型 注释 = "比较两段文本是否相等，忽略英文大小写。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 甲文本 <类型 = 文本型 注释 = "参与比较的第一段文本。">
    参数 乙文本 <类型 = 文本型 注释 = "参与比较的第二段文本。">
    {
        @ (FB_text_iequals (@<甲文本>, @<乙文本>) != 0)
    }

    方法 取子文本位置 <公开 静态 类型 = 整数 注释 = "返回子文本第一次出现的位置，从 0 开始计数。" 返回值注释 = "找到返回位置下标；未找到返回 -1。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "被查找的文本。">
    参数 查找文本 <类型 = 文本型 注释 = "要查找的子文本。">
    {
        @ FB_text_index_of (@<原文本>, @<查找文本>)
    }

    方法 取长度 <公开 静态 类型 = 整数 注释 = "返回文本包含的字符数（中文、英文都按一个字符计）。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待统计的文本。">
    {
        @ FB_text_length (@<原文本>)
    }

    方法 取左文本 <公开 静态 类型 = 文本型 注释 = "从文本最左边取指定个数的字符。" 返回值注释 = "个数超过文本长度时返回整段文本；个数小于等于 0 时返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待截取的文本。">
    参数 个数 <类型 = 整数 注释 = "要取出的字符个数。">
    {
        @ CWString(FB_text_left (@<原文本>, @<个数>))
    }

    方法 取右文本 <公开 静态 类型 = 文本型 注释 = "从文本最右边取指定个数的字符。" 返回值注释 = "个数超过文本长度时返回整段文本；个数小于等于 0 时返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待截取的文本。">
    参数 个数 <类型 = 整数 注释 = "要取出的字符个数。">
    {
        @ CWString(FB_text_right (@<原文本>, @<个数>))
    }

    方法 取中间文本 <公开 静态 类型 = 文本型 注释 = "从指定下标开始取指定个数的字符，越界部分自动截断。" 返回值注释 = "起始下标越界或个数小于等于 0 时返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待截取的文本。">
    参数 起始下标 <类型 = 整数 注释 = "从 0 开始的起始字符下标。">
    参数 取字符数 <类型 = 整数 注释 = "要取出的字符个数。">
    {
        @ CWString(FB_text_mid (@<原文本>, @<起始下标>, @<取字符数>))
    }

    方法 重复文本 <公开 静态 类型 = 文本型 注释 = "把文本重复拼接指定次数。" 返回值注释 = "次数小于等于 0 时返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "被重复的文本。">
    参数 次数 <类型 = 整数 注释 = "重复次数；结果总字符数受底层上限保护。">
    {
        @ CWString(FB_text_repeat (@<原文本>, @<次数>))
    }

    方法 压缩连续空白 <公开 静态 类型 = 文本型 注释 = "去掉文本首尾空白，并把中间的每一段连续空白（空格、制表符、回车、换行）压缩成一个空格。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待规整的文本。">
    {
        @ CWString(FB_text_trim_dup_spaces (@<原文本>))
    }

    方法 去连续重复字符 <公开 静态 类型 = 文本型 注释 = "把连续出现的相同字符压缩成一个，例如 「aaabbb」变成「ab」；不相邻的相同字符不受影响。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待去重的文本。">
    {
        @ CWString(FB_text_unique (@<原文本>))
    }

    方法 取分词句柄 <公开 静态 类型 = 变整数 注释 = "按分隔符集合切分文本，返回内部结果句柄（一般由「分词结果类」调用）。" 返回值注释 = "成功返回非 0 句柄，失败返回 0。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待切分的文本。">
    参数 分隔符 <类型 = 文本型 注释 = "分隔符集合：其中任意一个字符都算分隔符，例如 「,;」 。">
    {
        @ FB_split_create (@<原文本>, @<分隔符>)
    }

    方法 取分行句柄 <公开 静态 类型 = 变整数 注释 = "按行切分文本（回车换行与单独换行都算行分隔），返回内部结果句柄（一般由「分词结果类」调用）。" 返回值注释 = "成功返回非 0 句柄。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待按行切分的文本。">
    {
        @ FB_lines_create (@<原文本>)
    }

    方法 取分词数量 <公开 静态 类型 = 整数 注释 = "返回分词句柄中的成员数量。" 返回值注释 = "句柄无效返回 -1。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "分词结果句柄。">
    {
        @ FB_split_count (@<句柄>)
    }

    方法 取分词项 <公开 静态 类型 = 文本型 注释 = "取出分词句柄中指定序号的一项。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "分词结果句柄。">
    参数 序号 <类型 = 整数 注释 = "从 0 开始的成员序号。">
    {
        @ CWString(FB_split_get (@<句柄>, @<序号>))
    }

    方法 合并分词 <公开 静态 类型 = 文本型 注释 = "把分词句柄中的全部成员用指定连接符合并成一段文本。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "分词结果句柄。">
    参数 连接符 <类型 = 文本型 注释 = "成员之间的连接文本，可为空。">
    {
        @ CWString(FB_split_join (@<句柄>, @<连接符>))
    }

    方法 释放分词 <公开 静态 类型 = 逻辑型 注释 = "释放分词句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 句柄 <类型 = 变整数 注释 = "分词结果句柄。">
    {
        @ (FB_split_free (@<句柄>) != 0)
    }

    方法 文本转长整数 <公开 静态 类型 = 长整数 注释 = "把文本严格解析为长整数（boost/lexical_cast）。" 返回值注释 = "解析失败返回长整数最小值，可用「上次转换成功」判断。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "只允许数字与可选的正负号，带空格或杂字符即失败。">
    {
        @ FB_text_to_int64 (@<原文本>)
    }

    方法 文本转小数 <公开 静态 类型 = 小数 注释 = "把文本严格解析为小数（boost/lexical_cast）。" 返回值注释 = "解析失败返回 NaN，可用「上次转换成功」判断。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "支持小数与科学计数法文本。">
    {
        @ FB_text_to_double (@<原文本>)
    }

    方法 小数转文本 <公开 静态 类型 = 文本型 注释 = "把小数按指定位数转换为文本。" 折叠 @嵌入式方法 = "">
    参数 数值 <类型 = 小数 注释 = "待转换的小数。">
    参数 保留位数 <类型 = 整数 注释 = "小数点后保留位数；小于 0 表示按默认方式输出。">
    {
        @ CWString(FB_number_to_text (@<数值>, @<保留位数>))
    }

    方法 上次转换成功 <公开 静态 类型 = 逻辑型 注释 = "判断最近一次文本与数值互转是否成功。" 折叠 @嵌入式方法 = "">
    {
        @ (FB_last_ok () != 0)
    }

    方法 通配符匹配 <公开 静态 类型 = 逻辑型 注释 = "用 shell 风格的通配符判断整段文本是否匹配：* 顶任意多个字符，? 顶一个字符，[abc] 是字符集合，[!abc] 是排除集合。**区分大小写**；模式里除这三种以外的字符一律按字面量处理（例如 a.txt 里的点不是「任意字符」），所以它比正则更适合筛文件名。" 返回值注释 = "匹配返回真；不匹配或模式非法（例如方括号没有闭合）返回假，模式非法时原因见「文字工具.取错误说明 ()」。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要判断的文本，例如文件名。">
    参数 模式 <类型 = 文本型 注释 = "通配符模式，例如 「*.txt」、「报告?.doc」、「[abc]*」、「[!a]*」。">
    {
        @ (FB_text_glob (@<原文本>, @<模式>) == 1)
    }

    方法 进制转换 <公开 静态 类型 = 文本型 注释 = "把一段数字文本从一种进制换算成另一种进制，进制范围 2~36（大于 10 的位用字母，输出小写）。前导负号会保留，前导正号会被去掉；底层用任意精度整数计算，因此几十位也不会截断。" 返回值注释 = "成功返回目标进制的文本；文本为空、只有符号、含非法字符、某一位超出源进制、或进制不在 2~36 时返回空文本并写错误说明。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 数字文本 <类型 = 文本型 注释 = "要换算的数字文本，可带前导负号，例如 「255」、「ff」、「-10」。">
    参数 源进制 <类型 = 整数 注释 = "这段文本当前使用的进制，2~36。">
    参数 目标进制 <类型 = 整数 注释 = "要换算到的进制，2~36。">
    {
        @ CWString(FB_text_convert_base (@<数字文本>, @<源进制>, @<目标进制>))
    }

    方法 按宽度补齐 <公开 静态 类型 = 文本型 注释 = "按**显示宽度**在文本两侧补空格，让控制台输出或日志的列能对齐。汉字、韩文、全角符号按 2 格计算，其余按 1 格（区间表见 README 第十一节）。已经达到或超过目标宽度时原样返回，**不会截断**——截断会把内容变成错误的数据。" 返回值注释 = "返回补齐后的文本；文本本来就够宽时返回原文。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要补齐的文本。">
    参数 宽度 <类型 = 整数 注释 = "目标显示宽度（按格计，不是字符数）。小于等于 0 时原样返回。">
    参数 模式 <类型 = 整数 注释 = "0=左对齐（右侧补空格） 1=右对齐（左侧补空格） 2=居中（左右均分，差为奇数时左边少一格）；其它值按 0 处理。">
    {
        @ CWString(FB_text_pad_display (@<原文本>, @<宽度>, @<模式>))
    }
}

类 正则工具 <公开 折叠 折叠2 注释 = "正则表达式处理（boost/regex），默认使用 Perl 语法并区分大小写。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 整体匹配 <公开 静态 类型 = 逻辑型 注释 = "判断整段文本是否完全匹配正则表达式。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待匹配的文本。">
    参数 表达式 <类型 = 文本型 注释 = "正则表达式文本。">
    {
        @ (FB_regex_match (@<原文本>, @<表达式>) == 1)
    }

    方法 包含匹配 <公开 静态 类型 = 逻辑型 注释 = "判断文本中是否存在与正则表达式匹配的片段。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待匹配的文本。">
    参数 表达式 <类型 = 文本型 注释 = "正则表达式文本。">
    {
        @ (FB_regex_search (@<原文本>, @<表达式>) == 1)
    }

    方法 取匹配结果 <公开 静态 类型 = 文本型 注释 = "返回第一个匹配到的片段，或指定捕获组的内容。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待匹配的文本。">
    参数 表达式 <类型 = 文本型 注释 = "正则表达式文本。">
    参数 捕获组 <类型 = 整数 注释 = "0 表示整个匹配，1 表示第一个括号捕获组，以此类推。">
    {
        @ CWString(FB_regex_find (@<原文本>, @<表达式>, @<捕获组>))
    }

    方法 正则替换 <公开 静态 类型 = 文本型 注释 = "把所有匹配片段替换为指定文本，替换文本中可用 $1 引用捕获组。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待处理的文本。">
    参数 表达式 <类型 = 文本型 注释 = "正则表达式文本。">
    参数 替换文本 <类型 = 文本型 注释 = "替换内容，例如 「[$1]」。">
    {
        @ CWString(FB_regex_replace (@<原文本>, @<表达式>, @<替换文本>))
    }

    方法 取正则分词句柄 <公开 静态 类型 = 变整数 注释 = "按正则表达式切分文本，返回分词结果句柄。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "待切分的文本。">
    参数 表达式 <类型 = 文本型 注释 = "用作分隔的正则表达式文本。">
    {
        @ FB_regex_split (@<原文本>, @<表达式>)
    }
}

类 分词结果类 <公开 折叠 折叠2 注释 = "文本切分结果的容器：先调用「按分隔符切分」或「按正则切分」装入内容，再逐项读取。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层分词结果句柄，0 表示尚未装入内容。">

    方法 类_清理 <注释 = "对象销毁时自动释放底层句柄。">
    {
        如果 (句柄 != 0)
        {
            文字工具.释放分词 (句柄)
            句柄 = 0
        }
    }

    方法 按分隔符切分 <公开 类型 = 逻辑型 注释 = "按分隔符集合切分文本，结果装入本对象；会先释放上一次的内容。" 返回值注释 = "装入成功返回真。" 折叠>
    参数 原文本 <类型 = 文本型 注释 = "待切分的文本。">
    参数 分隔符 <类型 = 文本型 注释 = "分隔符集合，其中任意一个字符都算分隔符，例如 「,;」 。">
    {
        如果 (句柄 != 0)
        {
            文字工具.释放分词 (句柄)
            句柄 = 0
        }
        句柄 = 文字工具.取分词句柄 (原文本, 分隔符)
        返回 (句柄 != 0)
    }

    方法 按正则切分 <公开 类型 = 逻辑型 注释 = "按正则表达式切分文本，结果装入本对象；会先释放上一次的内容。" 返回值注释 = "装入成功返回真（表达式非法时为假）。" 折叠>
    参数 原文本 <类型 = 文本型 注释 = "待切分的文本。">
    参数 表达式 <类型 = 文本型 注释 = "用作分隔的正则表达式文本。">
    {
        如果 (句柄 != 0)
        {
            文字工具.释放分词 (句柄)
            句柄 = 0
        }
        句柄 = 正则工具.取正则分词句柄 (原文本, 表达式)
        返回 (句柄 != 0)
    }

    方法 按行切分 <公开 类型 = 逻辑型 注释 = "按行切分文本（回车换行与单独换行都算行分隔），结果装入本对象；会先释放上一次的内容。" 返回值注释 = "装入成功返回真。" 折叠>
    参数 原文本 <类型 = 文本型 注释 = "待按行切分的文本。">
    {
        如果 (句柄 != 0)
        {
            文字工具.释放分词 (句柄)
            句柄 = 0
        }
        句柄 = 文字工具.取分行句柄 (原文本)
        返回 (句柄 != 0)
    }

    方法 装入目录列表 <公开 类型 = 逻辑型 注释 = "把指定目录下的条目装入本对象，每项一个完整路径（按文本排序，顺序稳定）；会先释放上一次的内容。" 返回值注释 = "装入成功返回真；目录不存在或不是目录时返回假。" 折叠>
    参数 目录 <类型 = 文本型 注释 = "要枚举的目录路径。">
    参数 是否递归 <类型 = 逻辑型 注释 = "为真时连同各级子目录一起枚举。">
    参数 是否只列目录 <类型 = 逻辑型 注释 = "为真时只收目录，不收文件。">
    {
        如果 (句柄 != 0)
        {
            文字工具.释放分词 (句柄)
            句柄 = 0
        }
        句柄 = 文件工具.取目录句柄 (目录, 是否递归, 是否只列目录)
        返回 (句柄 != 0)
    }

    方法 取数量 <公开 类型 = 整数 注释 = "返回当前包含的成员数量，未装入内容时为 0。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (0)
        }
        返回 (文字工具.取分词数量 (句柄))
    }

    方法 取成员 <公开 类型 = 文本型 注释 = "取出指定序号的成员文本。" 返回值注释 = "序号越界时返回空文本。" 折叠>
    参数 序号 <类型 = 整数 注释 = "从 0 开始的成员序号。">
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (文字工具.取分词项 (句柄, 序号))
    }

    方法 合并 <公开 类型 = 文本型 注释 = "把所有成员用连接符合并为一段文本。" 折叠>
    参数 连接符 <类型 = 文本型 注释 = "成员之间的连接文本，可为空。">
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (文字工具.合并分词 (句柄, 连接符))
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "立即释放底层内容；对象销毁时也会自动释放。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = 文字工具.释放分词 (句柄)
        句柄 = 0
        返回 (结果)
    }
}

类 格式化类 <公开 折叠 折叠2 注释 = "文本格式化（boost/format）：先创建格式，再按顺序追加参数，最后取结果。格式中 %1% 表示第 1 个参数，%2% 表示第 2 个。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层格式化器句柄，0 表示尚未创建。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            格式化释放 (句柄)
            句柄 = 0
        }
    }

    方法 格式化释放 <公开 静态 类型 = 逻辑型 注释 = "释放格式器句柄。" 折叠 @嵌入式方法 = "">
    参数 格式句柄 <类型 = 变整数 注释 = "格式化器句柄。">
    {
        @ (FB_fmt_free (@<格式句柄>) != 0)
    }

    方法 设置格式串 <公开 类型 = 逻辑型 注释 = "按格式串重建格式化器；会先释放上一次的格式。" 返回值注释 = "创建成功返回真。" 折叠>
    参数 格式串 <类型 = 文本型 注释 = "例如 「%1% 有 %2% 个成员」 。">
    {
        如果 (句柄 != 0)
        {
            格式化释放 (句柄)
            句柄 = 0
        }
        句柄 = 取格式句柄 (格式串)
        返回 (句柄 != 0)
    }

    方法 取格式句柄 <公开 静态 类型 = 变整数 注释 = "底层创建格式器，返回句柄（供本类内部使用）。" 折叠 @嵌入式方法 = "">
    参数 格式串 <类型 = 文本型 注释 = "格式串文本。">
    {
        @ FB_fmt_create (@<格式串>)
    }

    方法 加入文本 <公开 类型 = 逻辑型 注释 = "向格式串追加一段文本参数。" 折叠>
    参数 内容 <类型 = 文本型 注释 = "要填入的文本。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (追加文本 (句柄, 内容))
    }

    方法 追加文本 <公开 静态 类型 = 逻辑型 注释 = "底层追加文本参数。" 折叠 @嵌入式方法 = "">
    参数 格式句柄 <类型 = 变整数 注释 = "格式化器句柄。">
    参数 内容 <类型 = 文本型 注释 = "要填入的文本。">
    {
        @ (FB_fmt_add_text (@<格式句柄>, @<内容>) != 0)
    }

    方法 加入整数 <公开 类型 = 逻辑型 注释 = "向格式串追加一个整数参数。" 折叠>
    参数 数值 <类型 = 长整数 注释 = "要填入的整数。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (追加整数 (句柄, 数值))
    }

    方法 追加整数 <公开 静态 类型 = 逻辑型 注释 = "底层追回整数参数。" 折叠 @嵌入式方法 = "">
    参数 格式句柄 <类型 = 变整数 注释 = "格式化器句柄。">
    参数 数值 <类型 = 长整数 注释 = "要填入的整数。">
    {
        @ (FB_fmt_add_int (@<格式句柄>, @<数值>) != 0)
    }

    方法 加入小数 <公开 类型 = 逻辑型 注释 = "向格式串追加一个小数参数。" 折叠>
    参数 数值 <类型 = 小数 注释 = "要填入的小数。">
    参数 保留位数 <类型 = 整数 注释 = "小数点后位数；小于 0 表示按默认输出。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (追加小数 (句柄, 数值, 保留位数))
    }

    方法 追加小数 <公开 静态 类型 = 逻辑型 注释 = "底层追加小数参数。" 折叠 @嵌入式方法 = "">
    参数 格式句柄 <类型 = 变整数 注释 = "格式化器句柄。">
    参数 数值 <类型 = 小数 注释 = "要填入的小数。">
    参数 保留位数 <类型 = 整数 注释 = "小数点后位数。">
    {
        @ (FB_fmt_add_double (@<格式句柄>, @<数值>, @<保留位数>) != 0)
    }

    方法 取结果 <公开 类型 = 文本型 注释 = "生成并返回格式化后的完整文本。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (取格式化结果 (句柄))
    }

    方法 取格式化结果 <公开 静态 类型 = 文本型 注释 = "底层取格式化结果。" 折叠 @嵌入式方法 = "">
    参数 格式句柄 <类型 = 变整数 注释 = "格式化器句柄。">
    {
        @ CWString(FB_fmt_result (@<格式句柄>))
    }
}
