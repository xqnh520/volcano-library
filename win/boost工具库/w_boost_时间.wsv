<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——日期、时间与校验部分。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 日期工具 <公开 折叠 折叠2 注释 = "日期处理（boost/gregorian）。日期在参数与返回值中统一使用「压缩日期」：形如 20261028 的长整数，0 表示无效日期。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 取今天 <公开 静态 类型 = 长整数 注释 = "返回本机当天日期，压缩为 20261028 这种形式。" 折叠 @嵌入式方法 = "">
    {
        @ FB_date_today ()
    }

    方法 建立日期 <公开 静态 类型 = 长整数 注释 = "用年、月、日组成压缩日期，自动校验是否真实存在。" 返回值注释 = "日期不存在（例如 2 月 30 日）时返回 0。" 折叠 @嵌入式方法 = "">
    参数 年份 <类型 = 整数 注释 = "四位年份，例如 2026。">
    参数 月份 <类型 = 整数 注释 = "1 到 12。">
    参数 日 <类型 = 整数 注释 = "1 到 31，超出当月天数即失败。">
    {
        @ FB_date_make (@<年份>, @<月份>, @<日>)
    }

    方法 转文本 <公开 静态 类型 = 文本型 注释 = "把压缩日期转为 yyyy-mm-dd 格式的文本。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ CWString(FB_date_text (@<日期>))
    }

    方法 解析文本 <公开 静态 类型 = 长整数 注释 = "把 yyyy-mm-dd 格式的文本解析为压缩日期。" 返回值注释 = "格式不符或日期不存在时返回 0。" 折叠 @嵌入式方法 = "">
    参数 日期文本 <类型 = 文本型 注释 = "形如 2026-10-28 的文本。">
    {
        @ FB_date_parse (@<日期文本>)
    }

    方法 加天数 <公开 静态 类型 = 长整数 注释 = "在日期上加减天数，自动跨月跨年。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "起始压缩日期。">
    参数 天数 <类型 = 整数 注释 = "正数向后推，负数向前推。">
    {
        @ FB_date_add_days (@<日期>, @<天数>)
    }

    方法 相差天数 <公开 静态 类型 = 整数 注释 = "返回两个日期相差的天数（前者减后者）。" 折叠 @嵌入式方法 = "">
    参数 甲日期 <类型 = 长整数 注释 = "被减的压缩日期。">
    参数 乙日期 <类型 = 长整数 注释 = "减去的压缩日期。">
    {
        @ FB_date_diff_days (@<甲日期>, @<乙日期>)
    }

    方法 取年 <公开 静态 类型 = 整数 注释 = "返回日期的年份部分。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ FB_date_year (@<日期>)
    }

    方法 取月 <公开 静态 类型 = 整数 注释 = "返回日期的月份部分。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ FB_date_month (@<日期>)
    }

    方法 取日 <公开 静态 类型 = 整数 注释 = "返回日期的日部分。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ FB_date_day (@<日期>)
    }

    方法 取星期 <公开 静态 类型 = 整数 注释 = "返回该日期是星期几：0 为星期日，1 到 6 依次为星期一至星期六。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ FB_date_weekday (@<日期>)
    }

    方法 是否闰年 <公开 静态 类型 = 逻辑型 注释 = "判断指定年份是否为闰年。" 折叠 @嵌入式方法 = "">
    参数 年份 <类型 = 整数 注释 = "四位年份。">
    {
        @ (FB_date_is_leap (@<年份>) != 0)
    }

    方法 取当月天数 <公开 静态 类型 = 整数 注释 = "返回指定年月共有多少天，已考虑闰年。" 折叠 @嵌入式方法 = "">
    参数 年份 <类型 = 整数 注释 = "四位年份。">
    参数 月份 <类型 = 整数 注释 = "1 到 12。">
    {
        @ FB_date_days_in_month (@<年份>, @<月份>)
    }

    方法 格式化 <公开 静态 类型 = 文本型 注释 = "按自定义格式输出日期，例如 %Y年%m月%d日 或 %A 。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    参数 格式串 <类型 = 文本型 注释 = "%Y 年、%m 月、%d 日、%A 星期全名、%a 星期缩写；留空等同 %Y-%m-%d 。">
    {
        @ CWString(FB_date_format (@<日期>, @<格式串>))
    }

    方法 取本月首日 <公开 静态 类型 = 长整数 注释 = "返回该日期所在月份的第一天。" 返回值注释 = "日期无效时返回 0。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ FB_date_first_of_month (@<日期>)
    }

    方法 取本月末日 <公开 静态 类型 = 长整数 注释 = "返回该日期所在月份的最后一天，已考虑大小月与闰年。" 返回值注释 = "日期无效时返回 0。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ FB_date_last_of_month (@<日期>)
    }

    方法 加月 <公开 静态 类型 = 长整数 注释 = "在日期上加减月份，自动做「月末对齐」：1 月 31 日加 1 个月得到 2 月的最后一天。" 返回值注释 = "日期无效时返回 0。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "起始压缩日期。">
    参数 月数 <类型 = 整数 注释 = "正数向后推，负数向前推。">
    {
        @ FB_date_add_months (@<日期>, @<月数>)
    }

    方法 加年 <公开 静态 类型 = 长整数 注释 = "在日期上加减年份，闰日加年时对齐到当月最后一天（2 月 29 日加 1 年得到 2 月 28 日）。" 返回值注释 = "日期无效时返回 0。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "起始压缩日期。">
    参数 年数 <类型 = 整数 注释 = "正数向后推，负数向前推。">
    {
        @ FB_date_add_years (@<日期>, @<年数>)
    }

    方法 转毫秒时间戳 <公开 静态 类型 = 长整数 注释 = "把日期转为当天 00:00:00 的毫秒时间戳，可直接交给「时间工具」使用。" 返回值注释 = "日期无效时返回 0。" 折叠 @嵌入式方法 = "">
    参数 日期 <类型 = 长整数 注释 = "压缩日期。">
    {
        @ FB_date_to_time_ms (@<日期>)
    }
}

类 时间工具 <公开 折叠 折叠2 注释 = "时间点处理（boost/posix_time）。时间点统一使用毫秒时间戳（自 1970-01-01 00:00:00 起的毫秒数，本机时区）。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 取当前毫秒 <公开 静态 类型 = 长整数 注释 = "返回本机当前时间的毫秒时间戳。" 折叠 @嵌入式方法 = "">
    {
        @ FB_time_now_ms ()
    }

    方法 转文本 <公开 静态 类型 = 文本型 注释 = "把毫秒时间戳转为 yyyy-mm-dd hh:mm:ss 文本。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ CWString(FB_time_text (@<毫秒>))
    }

    方法 格式化 <公开 静态 类型 = 文本型 注释 = "按自定义格式输出时间点，例如 %Y/%m/%d %H:%M 。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    参数 格式串 <类型 = 文本型 注释 = "%Y 年 %m 月 %d 日 %H 时 %M 分 %S 秒；留空等同 yyyy-mm-dd hh:mm:ss 。">
    {
        @ CWString(FB_time_format (@<毫秒>, @<格式串>))
    }

    方法 加毫秒 <公开 静态 类型 = 长整数 注释 = "在毫秒时间戳上加减毫秒数。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "起始毫秒时间戳。">
    参数 增量 <类型 = 长整数 注释 = "正数向后、负数向前；一天为 86400000。">
    {
        @ FB_time_add_ms (@<毫秒>, @<增量>)
    }

    方法 解析文本 <公开 静态 类型 = 长整数 注释 = "把 yyyy-mm-dd hh:mm:ss 文本解析为毫秒时间戳。" 返回值注释 = "格式不符时返回 0。" 折叠 @嵌入式方法 = "">
    参数 时间文本 <类型 = 文本型 注释 = "形如 2026-10-28 09:30:00 的文本。">
    {
        @ FB_time_from_text (@<时间文本>)
    }

    方法 取年 <公开 静态 类型 = 整数 注释 = "返回时间点的年份。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_year (@<毫秒>)
    }

    方法 取月 <公开 静态 类型 = 整数 注释 = "返回时间点的月份。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_month (@<毫秒>)
    }

    方法 取日 <公开 静态 类型 = 整数 注释 = "返回时间点的日。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_day (@<毫秒>)
    }

    方法 取时 <公开 静态 类型 = 整数 注释 = "返回时间点的小时（0 到 23）。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_hour (@<毫秒>)
    }

    方法 取分 <公开 静态 类型 = 整数 注释 = "返回时间点的分钟（0 到 59）。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_minute (@<毫秒>)
    }

    方法 取秒 <公开 静态 类型 = 整数 注释 = "返回时间点的秒（0 到 59）。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_second (@<毫秒>)
    }

    方法 转日期 <公开 静态 类型 = 长整数 注释 = "把毫秒时间戳转为压缩日期，可直接交给「日期工具」使用。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_to_date (@<毫秒>)
    }

    方法 秒转毫秒 <公开 静态 类型 = 长整数 注释 = "把秒数换算为毫秒数。" 返回值注释 = "数值过大溢出时返回 0。" 折叠 @嵌入式方法 = "">
    参数 秒数 <类型 = 长整数 注释 = "要换算的秒数。">
    {
        @ FB_time_seconds_to_ms (@<秒数>)
    }

    方法 毫秒转秒 <公开 静态 类型 = 长整数 注释 = "把毫秒数换算为秒数，小数部分向零取整。" 折叠 @嵌入式方法 = "">
    参数 毫秒数 <类型 = 长整数 注释 = "要换算的毫秒数。">
    {
        @ FB_time_ms_to_seconds (@<毫秒数>)
    }

    方法 取当天零点 <公开 静态 类型 = 长整数 注释 = "返回该时间点所在当天 00:00:00 的毫秒时间戳。" 折叠 @嵌入式方法 = "">
    参数 毫秒 <类型 = 长整数 注释 = "毫秒时间戳。">
    {
        @ FB_time_day_start_ms (@<毫秒>)
    }
}

类 校验工具 <公开 折叠 折叠2 注释 = "校验与唯一标识（boost/crc、boost/uuid）。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 计算校验值 <公开 静态 类型 = 长整数 注释 = "计算文本的 CRC32 校验值（按文本的 UTF-8 字节计算，取值范围 0 到 4294967295）。" 折叠 @嵌入式方法 = "">
    参数 原文本 <类型 = 文本型 注释 = "参与校验的文本。">
    {
        @ FB_crc32 (@<原文本>)
    }

    方法 生成唯一标识 <公开 静态 类型 = 文本型 注释 = "生成一个随机唯一标识（UUID v4），形如 3f2504e0-4f89-41d3-9a0c-0305e82c3301 。" 折叠 @嵌入式方法 = "">
    {
        @ CWString(FB_uuid_new ())
    }

    方法 是否有效标识 <公开 静态 类型 = 逻辑型 注释 = "判断文本是否为合法的唯一标识串。" 折叠 @嵌入式方法 = "">
    参数 标识文本 <类型 = 文本型 注释 = "待检查的文本。">
    {
        @ (FB_uuid_valid (@<标识文本>) != 0)
    }
}
