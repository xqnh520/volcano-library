<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——随机数与高精度小数部分。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 随机工具 <公开 折叠 折叠2 注释 = "随机数与随机打乱（boost/random，mt19937 引擎）。全部为静态方法，直接用类名调用。引擎是线程局部的：置随机种子 只重置当前线程的引擎；同一个种子在同一线程上可复现同一条随机序列，不同线程之间互不影响。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 置随机种子 <公开 静态 类型 = 逻辑型 注释 = "用固定种子重置当前线程的随机引擎，之后产生的序列可复现。" 返回值注释 = "固定返回真。" 折叠 @嵌入式方法 = "">
    参数 种子 <类型 = 长整数 注释 = "种子值，取低 32 位参与播种。">
    {
        @ (FB_random_seed (@<种子>) != 0)
    }

    方法 取随机整数 <公开 静态 类型 = 长整数 注释 = "在闭区间内均匀取一个整数；下限大于上限时自动交换两者。" 折叠 @嵌入式方法 = "">
    参数 下限 <类型 = 长整数 注释 = "闭区间下界（含）。">
    参数 上限 <类型 = 长整数 注释 = "闭区间上界（含）。">
    {
        @ FB_random_int (@<下限>, @<上限>)
    }

    方法 取随机小数 <公开 静态 类型 = 小数 注释 = "在左闭右开区间内均匀取一个小数；下限大于上限时自动交换两者。" 折叠 @嵌入式方法 = "">
    参数 下限 <类型 = 小数 注释 = "区间下界（含）。">
    参数 上限 <类型 = 小数 注释 = "区间上界（不含）。">
    {
        @ FB_random_double (@<下限>, @<上限>)
    }

    方法 取正态随机数 <公开 静态 类型 = 小数 注释 = "按正态分布取一个随机数，大样本的平均值接近所给的均值。" 折叠 @嵌入式方法 = "">
    参数 均值 <类型 = 小数 注释 = "正态分布的均值。">
    参数 标准差 <类型 = 小数 注释 = "正态分布的标准差，不能为负数。">
    {
        @ FB_random_normal (@<均值>, @<标准差>)
    }

    方法 取随机布尔 <公开 静态 类型 = 逻辑型 注释 = "按概率取真假：概率小于等于 0 时恒假，大于等于 1 时恒真。" 折叠 @嵌入式方法 = "">
    参数 概率 <类型 = 小数 注释 = "0 到 1 之间的概率。">
    {
        @ (FB_random_bool (@<概率>) != 0)
    }

    方法 从列表抽取 <公开 静态 类型 = 文本型 注释 = "从逗号分隔的列表里随机取出一项。" 返回值注释 = "列表为空时返回空文本。" 折叠 @嵌入式方法 = "">
    参数 列表文本 <类型 = 文本型 注释 = "逗号分隔的列表，例如 「甲,乙,丙」 。">
    {
        @ CWString(FB_random_pick (@<列表文本>))
    }

    方法 取打乱句柄 <公开 静态 类型 = 变整数 注释 = "底层把逗号分隔的列表打乱，返回分词结果句柄（供本类内部使用）。" 折叠 @嵌入式方法 = "">
    参数 列表文本 <类型 = 文本型 注释 = "逗号分隔的列表。">
    {
        @ FB_random_shuffle (@<列表文本>)
    }

    方法 打乱列表 <公开 静态 类型 = 文本型 注释 = "把逗号分隔的列表打乱，返回打乱后用逗号连接的文本；调用方不需要管理任何句柄。" 返回值注释 = "列表为空时返回空文本。" 折叠>
    参数 列表文本 <类型 = 文本型 注释 = "逗号分隔的列表，例如 「甲,乙,丙」 。">
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 取打乱句柄 (列表文本)
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        变量 结果 <类型 = 文本型>
        结果 = 文字工具.合并分词 (句柄, ",")
        文字工具.释放分词 (句柄)
        返回 (结果)
    }
}

类 高精度小数类 <公开 折叠 折叠2 注释 = "高精度十进制小数（boost/multiprecision cpp_dec_float_50，50 位十进制有效数字）：0.1 加 0.2 精确等于 0.3。二元运算先算后换，结果对象与任一操作数是同一个对象时也正确。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层高精度小数句柄，0 表示尚未装入数值。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            高精度释放 (句柄)
            句柄 = 0
        }
    }

    方法 取高精度句柄 <公开 静态 类型 = 变整数 注释 = "底层按文本建立高精度小数，返回句柄。" 折叠 @嵌入式方法 = "">
    参数 数字文本 <类型 = 文本型 注释 = "十进制小数文本，可带正负号与科学计数法。">
    {
        @ FB_dec_from_text (@<数字文本>)
    }

    方法 高精度释放 <公开 静态 类型 = 逻辑型 注释 = "释放高精度小数句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 小数句柄 <类型 = 变整数 注释 = "高精度小数句柄。">
    {
        @ (FB_dec_free (@<小数句柄>) != 0)
    }

    方法 高精度文本 <公开 静态 类型 = 文本型 注释 = "底层把高精度小数转为文本。" 折叠 @嵌入式方法 = "">
    参数 小数句柄 <类型 = 变整数 注释 = "高精度小数句柄。">
    参数 小数位数 <类型 = 整数 注释 = "小数点后保留的位数；小于 0 表示按 50 位有效数字输出。">
    {
        @ CWString(FB_dec_text (@<小数句柄>, @<小数位数>))
    }

    方法 从文本创建 <公开 类型 = 逻辑型 注释 = "按十进制文本装入数值；会先释放上一次的值。" 返回值注释 = "文本不是合法数字时返回假，原值保持不变。" 折叠>
    参数 数字文本 <类型 = 文本型 注释 = "十进制小数文本，例如 0.1 。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取高精度句柄 (数字文本)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            高精度释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 转文本 <公开 类型 = 文本型 注释 = "返回当前数值的文本；未装入数值时返回空文本。" 折叠>
    参数 小数位数 <类型 = 整数 注释 = "小数点后保留的位数（四舍五入）；小于 0 表示按 50 位有效数字输出。">
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (高精度文本 (句柄, 小数位数))
    }

    方法 相加 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 + 另一个」。" 返回值注释 = "任一方未装入数值时返回假，本对象内容保持不变。" 折叠>
    参数 另一个 <类型 = 高精度小数类 注释 = "参与相加的另一个高精度小数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 0))
    }

    方法 相减 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 - 另一个」。" 折叠>
    参数 另一个 <类型 = 高精度小数类 注释 = "参与相减的另一个高精度小数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 1))
    }

    方法 相乘 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 × 另一个」。" 折叠>
    参数 另一个 <类型 = 高精度小数类 注释 = "参与相乘的另一个高精度小数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 2))
    }

    方法 相除 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 ÷ 另一个」。" 返回值注释 = "除数为零时返回假，本对象内容保持不变。" 折叠>
    参数 另一个 <类型 = 高精度小数类 注释 = "除数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 3))
    }

    方法 改为二元结果 <类型 = 逻辑型 注释 = "先算出新值，再释放旧值并换入，保证结果对象与任一操作数是同一个对象时也正确。">
    参数 乙句柄 <类型 = 变整数 注释 = "右操作数句柄。">
    参数 运算代号 <类型 = 整数 注释 = "0 相加、1 相减、2 相乘、3 相除。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        如果 (乙句柄 == 0)
        {
            返回 (假)
        }
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取运算句柄 (句柄, 乙句柄, 运算代号)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        高精度释放 (句柄)
        句柄 = 新句柄
        返回 (真)
    }

    方法 取运算句柄 <公开 静态 类型 = 变整数 注释 = "底层二元运算，返回新句柄。" 折叠 @嵌入式方法 = "">
    参数 甲句柄 <类型 = 变整数 注释 = "左操作数句柄。">
    参数 乙句柄 <类型 = 变整数 注释 = "右操作数句柄。">
    参数 运算代号 <类型 = 整数 注释 = "0 相加、1 相减、2 相乘、3 相除。">
    {
        @ FB_dec_op (@<甲句柄>, @<乙句柄>, @<运算代号>)
    }

    方法 四舍五入 <公开 类型 = 逻辑型 注释 = "把本对象改为四舍五入到指定小数位的结果；位数为负时对整数部分舍入（例如 -2 表示舍入到百位）。" 折叠>
    参数 小数位数 <类型 = 整数 注释 = "保留的小数位数，可为负数。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取舍入句柄 (句柄, 小数位数)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        高精度释放 (句柄)
        句柄 = 新句柄
        返回 (真)
    }

    方法 取舍入句柄 <公开 静态 类型 = 变整数 注释 = "底层四舍五入，返回新句柄。" 折叠 @嵌入式方法 = "">
    参数 小数句柄 <类型 = 变整数 注释 = "高精度小数句柄。">
    参数 小数位数 <类型 = 整数 注释 = "保留的小数位数。">
    {
        @ FB_dec_round (@<小数句柄>, @<小数位数>)
    }

    方法 取绝对值 <公开 类型 = 逻辑型 注释 = "把本对象改为自身绝对值。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取绝对值句柄 (句柄)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        高精度释放 (句柄)
        句柄 = 新句柄
        返回 (真)
    }

    方法 取绝对值句柄 <公开 静态 类型 = 变整数 注释 = "底层取绝对值，返回新句柄。" 折叠 @嵌入式方法 = "">
    参数 小数句柄 <类型 = 变整数 注释 = "高精度小数句柄。">
    {
        @ FB_dec_abs (@<小数句柄>)
    }

    方法 比较 <公开 类型 = 整数 注释 = "比较本对象与另一个高精度小数的大小。" 返回值注释 = "本对象较小返回 -1，相等返回 0，较大返回 1，任一未装入数值返回 -2。" 折叠>
    参数 另一个 <类型 = 高精度小数类 注释 = "参与比较的另一个高精度小数对象。">
    {
        返回 (取比较结果 (句柄, 另一个.句柄))
    }

    方法 取比较结果 <公开 静态 类型 = 整数 注释 = "底层比较两个高精度小数句柄。" 折叠 @嵌入式方法 = "">
    参数 甲句柄 <类型 = 变整数 注释 = "左操作数句柄。">
    参数 乙句柄 <类型 = 变整数 注释 = "右操作数句柄。">
    {
        @ FB_dec_cmp (@<甲句柄>, @<乙句柄>)
    }

    方法 取符号 <公开 类型 = 整数 注释 = "返回数值符号。" 返回值注释 = "负数 -1，零 0，正数 1，未装入数值 -2。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (-2)
        }
        返回 (取句柄符号 (句柄))
    }

    方法 取句柄符号 <公开 静态 类型 = 整数 注释 = "底层取数值符号。" 折叠 @嵌入式方法 = "">
    参数 小数句柄 <类型 = 变整数 注释 = "高精度小数句柄。">
    {
        @ FB_dec_sign (@<小数句柄>)
    }

    方法 取小数值 <公开 类型 = 小数 注释 = "把当前数值转成普通小数（双精度）。" 返回值注释 = "未装入数值时返回 NaN。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (0.0 / 0.0)
        }
        返回 (取双精度值 (句柄))
    }

    方法 取双精度值 <公开 静态 类型 = 小数 注释 = "底层转成普通小数。" 折叠 @嵌入式方法 = "">
    参数 小数句柄 <类型 = 变整数 注释 = "高精度小数句柄。">
    {
        @ FB_dec_to_double (@<小数句柄>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "立即释放底层数值；对象销毁时也会自动释放。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = 高精度释放 (句柄)
        句柄 = 0
        返回 (结果)
    }
}
