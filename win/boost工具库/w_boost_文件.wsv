<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——文件与目录、文本文件读写（GBK/UTF-8/UTF-16 自动判定）、Base64 与十六进制编码、URL 编码与查询串部分。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 文件工具 <公开 折叠 折叠2 注释 = "文件与目录操作（boost/filesystem），以及文本文件的内容读写（底层用 Win32 代码页转换，v1.5 新增）。全部为静态方法，直接用类名调用。路径参数一律用宽字符传给底层，因此含中文的路径可以正常使用；所有方法都不抛异常，失败时返回哨兵值（假、-1、空文本、0 句柄）并把中文原因写进「文字工具.取错误说明 ()」。读写的编码参数用「文件编码」类的常量。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 是否存在 <公开 静态 类型 = 逻辑型 注释 = "判断指定路径是否存在（文件或目录都算存在）。" 返回值注释 = "存在返回真；路径为空或底层出错返回假。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要判断的路径，可以是相对路径。">
    {
        @ (FB_fs_exists (@<路径>) != 0)
    }

    方法 是否为目录 <公开 静态 类型 = 逻辑型 注释 = "判断指定路径是否存在且是一个目录。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要判断的路径。">
    {
        @ (FB_fs_is_dir (@<路径>) != 0)
    }

    方法 是否为文件 <公开 静态 类型 = 逻辑型 注释 = "判断指定路径是否存在且是一个普通文件（目录不算）。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要判断的路径。">
    {
        @ (FB_fs_is_file (@<路径>) != 0)
    }

    方法 取尺寸 <公开 静态 类型 = 长整数 注释 = "取文件的字节数。" 返回值注释 = "成功返回字节数；路径不存在、目标是目录或底层出错返回 -1。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要取尺寸的文件路径。">
    {
        @ FB_fs_size (@<路径>)
    }

    方法 取修改时间 <公开 静态 类型 = 长整数 注释 = "取文件的最后修改时间，单位毫秒，与「时间工具」使用同一个基准（1970-01-01 起算）。" 返回值注释 = "成功返回毫秒时间戳；取不到返回 0。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要查询的文件或目录路径。">
    {
        @ FB_fs_modified_ms (@<路径>)
    }

    方法 取绝对路径 <公开 静态 类型 = 文本型 注释 = "把相对路径转成绝对路径；不做规范化，也不要求路径真实存在。" 返回值注释 = "失败返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要转换的路径。">
    {
        @ CWString(FB_fs_absolute (@<路径>))
    }

    方法 合并路径 <公开 静态 类型 = 文本型 注释 = "把两段路径拼成一段：自动补上目录分隔符，子路径是绝对路径时直接顶掉前一段。" 返回值注释 = "失败返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 目录 <类型 = 文本型 注释 = "前一段路径，例如 「C:\\数据」 。">
    参数 子路径 <类型 = 文本型 注释 = "后一段路径，可为空（为空时原样返回前一段）。">
    {
        @ CWString(FB_fs_join (@<目录>, @<子路径>))
    }

    方法 取文件名 <公开 静态 类型 = 文本型 注释 = "取路径的最后一段，含扩展名。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要拆分的路径，例如 「C:\\数据\\报告.txt」 。">
    {
        @ CWString(FB_fs_filename (@<路径>))
    }

    方法 取主文件名 <公开 静态 类型 = 文本型 注释 = "取路径最后一段去掉扩展名后的部分。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要拆分的路径。">
    {
        @ CWString(FB_fs_stem (@<路径>))
    }

    方法 取扩展名 <公开 静态 类型 = 文本型 注释 = "取扩展名，含前面的点，例如 「.txt」 。" 返回值注释 = "没有扩展名时返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要拆分的路径。">
    {
        @ CWString(FB_fs_extension (@<路径>))
    }

    方法 取父目录 <公开 静态 类型 = 文本型 注释 = "取路径所在目录的部分。" 返回值注释 = "没有上级目录时返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要拆分的路径。">
    {
        @ CWString(FB_fs_parent (@<路径>))
    }

    方法 建立目录 <公开 静态 类型 = 逻辑型 注释 = "递归建立目录，中间缺失的层级会一起建立。" 返回值注释 = "成功或目录已存在都返回真；同名文件占位或底层出错返回假。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 目录 <类型 = 文本型 注释 = "要建立的目录路径。">
    {
        @ (FB_fs_make_dir (@<目录>) != 0)
    }

    方法 删除文件 <公开 静态 类型 = 逻辑型 注释 = "删除一个文件。重复调用是安全的：文件本来就不存在时也返回真。" 返回值注释 = "删除成功或本来就不存在返回真；目标是目录或底层出错返回假。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要删除的文件路径。">
    {
        @ (FB_fs_remove_file (@<路径>) != 0)
    }

    方法 删除目录 <公开 静态 类型 = 逻辑型 注释 = "删除一个空目录（不会递归删除里面的内容）。重复调用是安全的：目录本来就不存在时也返回真。" 返回值注释 = "删除成功或本来就不存在返回真；目录非空、目标是文件或底层出错返回假。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 目录 <类型 = 文本型 注释 = "要删除的目录路径。">
    {
        @ (FB_fs_remove_dir (@<目录>) != 0)
    }

    方法 复制文件 <公开 静态 类型 = 逻辑型 注释 = "把文件复制到另一个位置。" 返回值注释 = "复制成功返回真；源文件不存在、目标已存在且覆盖为假、底层出错返回假。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 源路径 <类型 = 文本型 注释 = "要复制的源文件路径。">
    参数 目标路径 <类型 = 文本型 注释 = "复制到的目标文件路径（含文件名）。">
    参数 覆盖 <类型 = 逻辑型 注释 = "为真时目标文件已存在会被覆盖；为假时目标已存在即失败。">
    {
        @ (FB_fs_copy_file (@<源路径>, @<目标路径>, (@<覆盖> ? 1 : 0)) != 0)
    }

    方法 移动文件 <公开 静态 类型 = 逻辑型 注释 = "把文件改名或移动到另一个位置（同一次操作完成重命名与移动）。" 返回值注释 = "成功返回真；源不存在、目标已存在或底层出错返回假。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 源路径 <类型 = 文本型 注释 = "原来的路径。">
    参数 目标路径 <类型 = 文本型 注释 = "新的路径；目标已存在时不会被覆盖，直接失败。">
    {
        @ (FB_fs_rename (@<源路径>, @<目标路径>) != 0)
    }

    方法 取目录句柄 <公开 静态 类型 = 变整数 注释 = "枚举目录，把结果装进内部的「分词句柄表」并返回句柄（每项一个完整路径）。一般不需要直接用它，用「枚举目录」即可。" 返回值注释 = "成功返回非 0 句柄；目录不存在或不是目录返回 0。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 目录 <类型 = 文本型 注释 = "要枚举的目录路径。">
    参数 是否递归 <类型 = 逻辑型 注释 = "为真时连同各级子目录一起枚举。">
    参数 是否只列目录 <类型 = 逻辑型 注释 = "为真时只收目录，不收文件。">
    {
        @ FB_fs_list (@<目录>, (@<是否递归> ? 1 : 0), (@<是否只列目录> ? 1 : 0))
    }

    方法 枚举目录 <公开 静态 类型 = 文本型 注释 = "枚举目录下的条目，返回一段文本，每行一个完整路径（按文本排序，顺序稳定）。调用方不需要管理任何句柄。" 返回值注释 = "目录不存在或不是目录时返回空文本。" 折叠>
    参数 目录 <类型 = 文本型 注释 = "要枚举的目录路径。">
    参数 是否递归 <类型 = 逻辑型 注释 = "为真时连同各级子目录一起枚举，每项仍是完整路径。">
    参数 是否只列目录 <类型 = 逻辑型 注释 = "为真时只收目录，不收文件。">
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 取目录句柄 (目录, 是否递归, 是否只列目录)
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        变量 结果 <类型 = 文本型>
        结果 = 文字工具.合并分词 (句柄, "\n")
        文字工具.释放分词 (句柄)
        返回 (结果)
    }

    方法 取临时目录 <公开 静态 类型 = 文本型 注释 = "返回系统临时目录的路径；实测**不带尾分隔符**，拼路径请用「合并路径」而不要自己补反斜杠。" 返回值注释 = "失败返回空文本。" 折叠 @嵌入式方法 = "">
    {
        @ CWString(FB_fs_temp_dir ())
    }

    方法 取当前目录 <公开 静态 类型 = 文本型 注释 = "返回进程的当前工作目录。" 返回值注释 = "失败返回空文本。" 折叠 @嵌入式方法 = "">
    {
        @ CWString(FB_fs_current_dir ())
    }

    方法 读文本文件 <公开 静态 类型 = 文本型 注释 = "读取整个文本文件的内容，编码转换全部在底层完成，返回的永远是正常文本（不会出现乱码字节串）。自动判定顺序是「BOM 优先，其次严格试解 UTF-8，最后回退 GBK」，因此 GBK 的老 CSV / INI 直接就能读进来。文件大于 64 MiB 时拒绝读取并返回空文本，不会把内存吃光。注意两个已知边界：一段字节同时是合法 UTF-8 与合法 GBK 时**一律判 UTF-8**（这种 GBK 文件必须显式传 2）；文件里混了非法 UTF-8 字节时自动判定会**回退 GBK 而不报错**，结果是静默乱码，只有显式传 1 才会报「不是合法的 UTF-8」。" 返回值注释 = "成功返回文件全文（BOM 不进入结果）；路径不存在、没有读取权限、显式指定 UTF-8 但内容不是合法 UTF-8、文件超过 64 MiB 时返回空文本，原因见「文字工具.取错误说明 ()」。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要读取的文件路径，支持中文路径。">
    参数 编码 <类型 = 整数 注释 = "编码编号，见「文件编码」类的常量：0=自动 1=UTF-8 2=GBK 3=UTF-16LE 4=UTF-16BE。读取不接受 5（它只在写入时有意义）。">
    {
        @ CWString(FB_file_read_text (@<路径>, @<编码>))
    }

    方法 写文本文件 <公开 静态 类型 = 逻辑型 注释 = "把文本写入文件（覆盖原有内容，文件不存在时自动创建）。编码 0 与 1 都写不带 BOM 的 UTF-8，2 写 GBK，3 与 4 写带 BOM 的 UTF-16。**GBK（编码 2）是严格的**：文本里只要有 GBK 表示不了的字符（emoji、CJK 扩展区汉字等），整个调用直接失败且一个字节都不写，原文件保持不变——静默丢数据比报错难查得多。确实需要替换成问号时用编码 5。" 返回值注释 = "成功返回真；路径为空、目录不存在、没有写入权限、磁盘已满、或目标编码表示不了文本中的字符时返回假，原因见「文字工具.取错误说明 ()」。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要写入的文件路径，支持中文路径；所在目录必须已经存在。">
    参数 文本 <类型 = 文本型 注释 = "要写入的文本内容，可以含换行。">
    参数 编码 <类型 = 整数 注释 = "编码编号：0=自动（等同 UTF-8 且不写 BOM） 1=UTF-8 2=GBK（严格，表示不了就失败） 3=UTF-16LE 4=UTF-16BE 5=GBK 宽松（表示不了的字符替换成 ?）。">
    {
        @ (FB_file_write_text (@<路径>, @<文本>, @<编码>) != 0)
    }

    方法 追加文本文件 <公开 静态 类型 = 逻辑型 注释 = "把文本追加到文件末尾；文件不存在时自动创建。BOM 只在文件为空（新建）时写入一次，所以反复追加不会在文件中间留下多余的 BOM。编码的严格/宽松规则与「写文本文件」完全一致。**不做编码一致性检查**：给 UTF-8 文件追加 GBK 内容不会报错，但文件会变成混编、读出来是乱码，追加的编码必须与文件现有编码一致。" 返回值注释 = "成功返回真；路径为空、目录不存在、没有写入权限、磁盘已满、或目标编码表示不了文本中的字符时返回假，原因见「文字工具.取错误说明 ()」。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要追加的文件路径，支持中文路径。">
    参数 文本 <类型 = 文本型 注释 = "要追加的文本内容。">
    参数 编码 <类型 = 整数 注释 = "编码编号：0=自动（等同 UTF-8 且不写 BOM） 1=UTF-8 2=GBK（严格） 3=UTF-16LE 4=UTF-16BE 5=GBK 宽松；应与文件的现有编码一致。">
    {
        @ (FB_file_append_text (@<路径>, @<文本>, @<编码>) != 0)
    }

    方法 取文件编码 <公开 静态 类型 = 整数 注释 = "判定一个文本文件的实际编码，不返回文件内容。规则与「读文本文件」的自动判定完全一致：先看 BOM（EF BB BF / FF FE / FE FF），没有 BOM 时严格试解 UTF-8，失败才判为 GBK。纯 ASCII 文件会返回 1（UTF-8）——ASCII 本身是合法 UTF-8，两种解释解出的字符相同。" 返回值注释 = "返回 1=UTF-8 2=GBK 3=UTF-16LE 4=UTF-16BE；文件不存在、读不了或超过 64 MiB 时返回 -1。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 路径 <类型 = 文本型 注释 = "要判定的文件路径，支持中文路径。">
    {
        @ FB_file_detect_encoding (@<路径>)
    }
}

类 文件编码 <公开 折叠 折叠2 注释 = "文本文件编码编号常量。本类只有常量、没有方法，用于「文件工具」里读写文本文件时的编码参数：写「文件编码.自动」即可。火山没有枚举，因此用常量类代替。注意「自动」在**读**的时候会真正去判定（BOM → UTF-8 → GBK），在**写**的时候等同于 UTF-8 且不写 BOM。GBK 写入默认是**严格**的：遇到码表里没有的字符（emoji、扩展区汉字等）整个调用直接失败、一个字节都不落盘；只有显式用「GBK宽松」才允许把它们替换成问号。">
{
    常量 自动 <公开 类型 = 整数 值 = 0 注释 = "自动：读时先看 BOM，再严格试解 UTF-8，都不成立按 GBK；写时等同 UTF-8 且不写 BOM。">
    常量 UTF8 <公开 类型 = 整数 值 = 1 注释 = "UTF-8，不带 BOM。能表示所有字符，写 emoji 与生僻字都不会失败。">
    常量 GBK <公开 类型 = 整数 值 = 2 注释 = "GBK（Windows 简体中文代码页 936），不带 BOM。**写入默认严格**：文本里有 GBK 表示不了的字符时返回假、不写文件、原文件保持不变。">
    常量 UTF16LE <公开 类型 = 整数 值 = 3 注释 = "UTF-16 小端，写盘时带 FF FE 前缀，读取时该前缀会被自动剥掉。">
    常量 UTF16BE <公开 类型 = 整数 值 = 4 注释 = "UTF-16 大端，写盘时带 FE FF 前缀，读取时该前缀会被自动剥掉。">
    常量 GBK宽松 <公开 类型 = 整数 值 = 5 注释 = "GBK 宽松：**只对写入有效**。GBK 表示不了的字符被替换成问号（一个 UTF-16 码元换一个 ?，所以一个 emoji 变两个 ?），仍然返回真，但「文字工具.取错误说明 ()」里会留一条「已按目标编码（GBK）替换 N 处不可表示字符」的提示。读取传 5 会被当成非法参数（读 GBK 本来就不做严格校验，没有严格/宽松之分）。">
}

类 编码工具 <公开 折叠 折叠2 注释 = "文本编码转换：Base64（boost 序列化迭代器）、十六进制（手写实现）、URL 百分号编码与查询串取值。全部为静态方法，直接用类名调用。Base64 与 URL 编码都按文本的 UTF-8 字节计算，因此英文结果与 RFC 4648 完全一致，中文也能原样往返。" @别名 = "//" @别名类型 = 本地类 @类用途 = 访问静态成员>
{
    方法 Base64编码 <公开 静态 类型 = 文本型 注释 = "把文本按 UTF-8 字节编成 Base64 文本，结果补齐到 4 的倍数（必要时追加等号）。" 返回值注释 = "空文本返回空文本；失败返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要编码的文本，中文会先转成 UTF-8 字节再编码。">
    {
        @ CWString(FB_b64_encode (@<原文本>))
    }

    方法 Base64解码 <公开 静态 类型 = 文本型 注释 = "把 Base64 文本解码回文本，尾部填充符可有可无。" 返回值注释 = "含非法字符、长度为非法余 1、或解码结果不是合法 UTF-8 时返回空文本并写错误说明。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要解码的 Base64 文本，只允许 A-Z a-z 0-9 + / 与尾部等号。">
    {
        @ CWString(FB_b64_decode (@<原文本>))
    }

    方法 十六进制编码 <公开 静态 类型 = 文本型 注释 = "把文本按 UTF-8 字节编成小写十六进制文本（每个字节两位）。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要编码的文本。">
    {
        @ CWString(FB_hex_encode (@<原文本>))
    }

    方法 十六进制解码 <公开 静态 类型 = 文本型 注释 = "把小写或大写的十六进制文本解码回文本。" 返回值注释 = "字符个数为奇数、含非十六进制字符、或解码结果不是合法 UTF-8 时返回空文本并写错误说明。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要解码的十六进制文本，大小写都可以。">
    {
        @ CWString(FB_hex_decode (@<原文本>))
    }

    方法 URL编码 <公开 静态 类型 = 文本型 注释 = "把文本按 UTF-8 字节做百分号编码：A-Z a-z 0-9 与 - _ . ~ 原样保留，空格编成 %20，其余字节编成 %XX（十六进制字母大写）。" 返回值注释 = "空文本返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要编码的文本，中文会先转成 UTF-8 字节再逐字节编码。">
    {
        @ CWString(FB_url_encode (@<原文本>))
    }

    方法 URL编码表单 <公开 静态 类型 = 文本型 注释 = "与「URL编码」相同，但空格编成加号（表单提交的写法）。" 返回值注释 = "空文本返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要编码的文本。">
    {
        @ CWString(FB_url_encode_form (@<原文本>))
    }

    方法 URL解码 <公开 静态 类型 = 文本型 注释 = "把百分号编码的文本解码回来：%XX 还原成字节，加号还原成空格。非法的百分号序列原样保留，不会崩也不会吞字符。" 返回值注释 = "还原出的字节不是合法 UTF-8 时按字节逐个还原（不丢数据）。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 原文本 <类型 = 文本型 注释 = "要解码的文本，例如 a%20b%26c 。">
    {
        @ CWString(FB_url_decode (@<原文本>))
    }

    方法 取参数个数 <公开 静态 类型 = 整数 注释 = "统计查询串里有多少个参数（按与号分段，空段跳过），可以带前导问号。" 返回值注释 = "空文本返回 0。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 查询串 <类型 = 文本型 注释 = "查询串，例如 a=1&b=2 ，也可以写成 ?a=1&b=2 。">
    {
        @ FB_url_query_count (@<查询串>)
    }

    方法 取参数名 <公开 静态 类型 = 文本型 注释 = "取第 N 个参数的名字（已做 URL 解码）。" 返回值注释 = "序号越界返回空文本；该段没有等号时整段都是名字。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 查询串 <类型 = 文本型 注释 = "查询串。">
    参数 序号 <类型 = 整数 注释 = "参数序号，从 0 开始，按出现顺序。">
    {
        @ CWString(FB_url_query_key_at (@<查询串>, @<序号>))
    }

    方法 取参数值 <公开 静态 类型 = 文本型 注释 = "取第 N 个参数的值（已做 URL 解码）。" 返回值注释 = "序号越界或该段没有等号时返回空文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 查询串 <类型 = 文本型 注释 = "查询串。">
    参数 序号 <类型 = 整数 注释 = "参数序号，从 0 开始，按出现顺序。">
    {
        @ CWString(FB_url_query_value_at (@<查询串>, @<序号>))
    }

    方法 取参数 <公开 静态 类型 = 文本型 注释 = "按键取参数值：在查询串里找第一个同名参数并返回它的值（键和值都做 URL 解码）。没有等号的参数算「键存在、值为空」，返回空文本而不是默认值，这样「有没有」和「取不取得到」始终一致。" 返回值注释 = "键确实不存在时才返回所给的默认文本。" 折叠 @嵌入式方法 = "req_str_param_text_pointer = 真">
    参数 查询串 <类型 = 文本型 注释 = "查询串，可以带前导问号。">
    参数 键 <类型 = 文本型 注释 = "要找的参数名，写解码后的明文即可。">
    参数 默认值 <类型 = 文本型 注释 = "找不到时返回的内容，可为空文本。">
    {
        @ CWString(FB_url_query_get (@<查询串>, @<键>, @<默认值>))
    }
}
