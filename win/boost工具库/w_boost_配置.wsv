<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——配置文件与双向映射表部分。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 INI文档类 <公开 折叠 折叠2 注释 = "INI 配置文件读写（boost/property_tree）：先「解析」，再用「路径」读取或改写配置项。路径写法为「段名.键名」，例如 主窗口.标题 。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层配置树句柄，0 表示尚未解析。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            INI释放 (句柄)
            句柄 = 0
        }
    }

    方法 取INI句柄 <公开 静态 类型 = 变整数 注释 = "底层解析 INI 文本，返回句柄。" 折叠 @嵌入式方法 = "">
    参数 INI文本 <类型 = 文本型 注释 = "待解析的 INI 文本。">
    {
        @ FB_ini_parse (@<INI文本>)
    }

    方法 INI释放 <公开 静态 类型 = 逻辑型 注释 = "释放配置句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "配置树句柄。">
    {
        @ (FB_ini_free (@<文档句柄>) != 0)
    }

    方法 查询存在 <公开 静态 类型 = 整数 注释 = "底层查询配置项是否存在：1 存在、0 不存在、-1 句柄无效。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "配置树句柄。">
    参数 路径 <类型 = 文本型 注释 = "配置项路径，形如 段名.键名 。">
    {
        @ FB_ini_has (@<文档句柄>, @<路径>)
    }

    方法 取节点文本 <公开 静态 类型 = 文本型 注释 = "底层读取配置项的文本值。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "配置树句柄。">
    参数 路径 <类型 = 文本型 注释 = "配置项路径。">
    参数 默认文本 <类型 = 文本型 注释 = "取不到时返回的内容。">
    {
        @ CWString(FB_ini_text (@<文档句柄>, @<路径>, @<默认文本>))
    }

    方法 取节点整数 <公开 静态 类型 = 长整数 注释 = "底层读取配置项的整数值。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "配置树句柄。">
    参数 路径 <类型 = 文本型 注释 = "配置项路径。">
    参数 默认值 <类型 = 长整数 注释 = "取不到时返回的数值。">
    {
        @ FB_ini_int (@<文档句柄>, @<路径>, @<默认值>)
    }

    方法 写入节点文本 <公开 静态 类型 = 逻辑型 注释 = "底层写入配置项。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "配置树句柄。">
    参数 路径 <类型 = 文本型 注释 = "配置项路径。">
    参数 新文本 <类型 = 文本型 注释 = "要写入的文本。">
    {
        @ (FB_ini_set (@<文档句柄>, @<路径>, @<新文本>) != 0)
    }

    方法 输出INI文本 <公开 静态 类型 = 文本型 注释 = "底层输出 INI 文本。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "配置树句柄。">
    {
        @ CWString(FB_ini_dump (@<文档句柄>))
    }

    方法 解析 <公开 类型 = 逻辑型 注释 = "解析 INI 文本装入本对象；会先释放上一次的内容。同一节内出现重复键会导致整份解析失败（可用 文字工具.取错误说明 () 查看行号），请先清理重复键；跨节同名键是允许的。" 返回值注释 = "文本不是合法 INI 时返回假，可用文字工具.取错误说明 查看原因。" 折叠>
    参数 INI文本 <类型 = 文本型 注释 = "待解析的 INI 文本，段用方括号括起，键值用等号分隔。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取INI句柄 (INI文本)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            INI释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 是否存在 <公开 类型 = 逻辑型 注释 = "判断指定路径的配置项是否存在。" 返回值注释 = "存在真、不存在假，句柄无效返回假。" 折叠>
    参数 路径 <类型 = 文本型 注释 = "配置项路径，形如 段名.键名 。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (查询存在 (句柄, 路径) == 1)
    }

    方法 取文本值 <公开 类型 = 文本型 注释 = "读取指定路径的文本值。" 返回值注释 = "配置项不存在时返回所提供的默认文本。" 折叠>
    参数 路径 <类型 = 文本型 注释 = "配置项路径。">
    参数 默认文本 <类型 = 文本型 注释 = "取不到时返回的内容，可为空文本。">
    {
        如果 (句柄 == 0)
        {
            返回 (默认文本)
        }
        返回 (取节点文本 (句柄, 路径, 默认文本))
    }

    方法 取整数值 <公开 类型 = 长整数 注释 = "读取指定路径的整数值。" 返回值注释 = "配置项不存在或不是整数时返回默认值。" 折叠>
    参数 路径 <类型 = 文本型 注释 = "配置项路径。">
    参数 默认值 <类型 = 长整数 注释 = "取不到时返回的数值。">
    {
        如果 (句柄 == 0)
        {
            返回 (默认值)
        }
        返回 (取节点整数 (句柄, 路径, 默认值))
    }

    方法 设置文本值 <公开 类型 = 逻辑型 注释 = "把指定路径的配置项改写为文本值；路径不存在时自动创建。" 返回值注释 = "成功返回真。" 折叠>
    参数 路径 <类型 = 文本型 注释 = "配置项路径。">
    参数 新文本 <类型 = 文本型 注释 = "要写入的文本。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (写入节点文本 (句柄, 路径, 新文本))
    }

    方法 转文本 <公开 类型 = 文本型 注释 = "把整棵配置树重新输出为 INI 文本。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (输出INI文本 (句柄))
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "立即释放底层配置树；对象销毁时也会自动释放。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = INI释放 (句柄)
        句柄 = 0
        返回 (结果)
    }
}

类 映射表类 <公开 折叠 折叠2 注释 = "名称与数值的双向映射表（boost::container::flat_map）：既可按名称取数值，也可按数值反查名称。名称重复加入时覆盖旧数值并保留原加入次序。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层映射表句柄，0 表示尚未建立。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            映射释放 (句柄)
            句柄 = 0
        }
    }

    方法 取映射句柄 <公开 静态 类型 = 变整数 注释 = "底层新建映射表，返回句柄（供本类内部使用）。" 折叠 @嵌入式方法 = "">
    {
        @ FB_map_create ()
    }

    方法 映射释放 <公开 静态 类型 = 逻辑型 注释 = "释放映射表句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 映射句柄 <类型 = 变整数 注释 = "映射表句柄。">
    {
        @ (FB_map_free (@<映射句柄>) != 0)
    }

    方法 加入项 <公开 静态 类型 = 逻辑型 注释 = "底层把一个名称与数值的对应关系写入映射表。" 折叠 @嵌入式方法 = "">
    参数 映射句柄 <类型 = 变整数 注释 = "映射表句柄。">
    参数 名称 <类型 = 文本型 注释 = "名称，不能为空。">
    参数 数值 <类型 = 长整数 注释 = "与该名称对应的数值。">
    {
        @ (FB_map_put (@<映射句柄>, @<名称>, @<数值>) != 0)
    }

    方法 查询名称 <公开 静态 类型 = 整数 注释 = "底层查询名称是否存在：1 存在、0 不存在。" 折叠 @嵌入式方法 = "">
    参数 映射句柄 <类型 = 变整数 注释 = "映射表句柄。">
    参数 名称 <类型 = 文本型 注释 = "要查询的名称。">
    {
        @ FB_map_has (@<映射句柄>, @<名称>)
    }

    方法 取项数值 <公开 静态 类型 = 长整数 注释 = "底层按名称取数值。" 折叠 @嵌入式方法 = "">
    参数 映射句柄 <类型 = 变整数 注释 = "映射表句柄。">
    参数 名称 <类型 = 文本型 注释 = "要查询的名称。">
    参数 默认值 <类型 = 长整数 注释 = "名称不存在时返回的数值。">
    {
        @ FB_map_get (@<映射句柄>, @<名称>, @<默认值>)
    }

    方法 反查名称 <公开 静态 类型 = 文本型 注释 = "底层按数值反查名称。" 折叠 @嵌入式方法 = "">
    参数 映射句柄 <类型 = 变整数 注释 = "映射表句柄。">
    参数 数值 <类型 = 长整数 注释 = "要反查的数值。">
    参数 默认文本 <类型 = 文本型 注释 = "数值不存在时返回的名称。">
    {
        @ CWString(FB_map_reverse_get (@<映射句柄>, @<数值>, @<默认文本>))
    }

    方法 取项数量 <公开 静态 类型 = 整数 注释 = "底层取映射表项数。" 折叠 @嵌入式方法 = "">
    参数 映射句柄 <类型 = 变整数 注释 = "映射表句柄。">
    {
        @ FB_map_count (@<映射句柄>)
    }

    方法 按序号查名 <公开 静态 类型 = 文本型 注释 = "底层按加入次序取名称。" 折叠 @嵌入式方法 = "">
    参数 映射句柄 <类型 = 变整数 注释 = "映射表句柄。">
    参数 序号 <类型 = 整数 注释 = "从 0 开始的加入序号。">
    {
        @ CWString(FB_map_name_at (@<映射句柄>, @<序号>))
    }

    方法 建立 <公开 类型 = 逻辑型 注释 = "建立一个新的空映射表；会先释放上一次的内容。" 返回值注释 = "建立成功返回真。" 折叠>
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取映射句柄 ()
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            映射释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 加入 <公开 类型 = 逻辑型 注释 = "把一个名称与数值的对应关系写入映射表；名称已存在时覆盖旧数值并保留原加入次序。" 返回值注释 = "成功返回真，名称为空或映射表未建立时返回假。" 折叠>
    参数 名称 <类型 = 文本型 注释 = "名称，不能为空。">
    参数 数值 <类型 = 长整数 注释 = "与该名称对应的数值。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (加入项 (句柄, 名称, 数值))
    }

    方法 是否存在 <公开 类型 = 逻辑型 注释 = "判断映射表中是否存在指定名称。" 返回值注释 = "存在真、不存在假，映射表未建立时返回假。" 折叠>
    参数 名称 <类型 = 文本型 注释 = "要查询的名称。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (查询名称 (句柄, 名称) == 1)
    }

    方法 取数值 <公开 类型 = 长整数 注释 = "按名称取对应的数值。" 返回值注释 = "名称不存在时返回默认数值。" 折叠>
    参数 名称 <类型 = 文本型 注释 = "要查询的名称。">
    参数 默认值 <类型 = 长整数 注释 = "取不到时返回的数值。">
    {
        如果 (句柄 == 0)
        {
            返回 (默认值)
        }
        返回 (取项数值 (句柄, 名称, 默认值))
    }

    方法 按数值取名 <公开 类型 = 文本型 注释 = "按数值反查名称；同一个数值被多个名称占用时返回最后写入的那个名称。" 返回值注释 = "数值不存在时返回默认文本。" 折叠>
    参数 数值 <类型 = 长整数 注释 = "要反查的数值。">
    参数 默认文本 <类型 = 文本型 注释 = "取不到时返回的名称。">
    {
        如果 (句柄 == 0)
        {
            返回 (默认文本)
        }
        返回 (反查名称 (句柄, 数值, 默认文本))
    }

    方法 取数量 <公开 类型 = 整数 注释 = "返回映射表中现有的项数。" 返回值注释 = "映射表未建立时返回 0。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (0)
        }
        返回 (取项数量 (句柄))
    }

    方法 按序号取名 <公开 类型 = 文本型 注释 = "按加入次序取出名称，用于遍历整张映射表。" 返回值注释 = "序号越界时返回空文本。" 折叠>
    参数 序号 <类型 = 整数 注释 = "从 0 开始的加入序号。">
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (按序号查名 (句柄, 序号))
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "立即释放底层映射表；对象销毁时也会自动释放。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = 映射释放 (句柄)
        句柄 = 0
        返回 (结果)
    }
}
