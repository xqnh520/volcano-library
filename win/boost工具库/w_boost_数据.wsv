类 XML文档类 <公开 折叠 折叠2 注释 = "XML 解析与读写（boost/property_tree/xml_parser）：先「解析」，再用「路径」读取或改写节点。路径用句点分隔，例如 根.子 ；XML 的属性在属性树里是一组名为 <xmlattr> 的子节点，因此元素的 id 属性要写成 根.子.<xmlattr>.id 。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层 XML 树句柄，0 表示尚未解析。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            XML释放 (句柄)
            句柄 = 0
        }
    }

    方法 取XML句柄 <公开 静态 类型 = 变整数 注释 = "底层解析 XML 文本，返回句柄。" 折叠 @嵌入式方法 = "">
    参数 XML文本 <类型 = 文本型 注释 = "待解析的 XML 文本，带不带 xml 声明都可以。">
    {
        @ FB_xml_parse (@<XML文本>)
    }

    方法 XML释放 <公开 静态 类型 = 逻辑型 注释 = "释放 XML 句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "XML 树句柄。">
    {
        @ (FB_xml_free (@<文档句柄>) != 0)
    }

    方法 解析 <公开 类型 = 逻辑型 注释 = "解析 XML 文本装入本对象；会先释放上一次的内容。" 返回值注释 = "文本不是合法 XML 时返回假，可用文字工具.取错误说明 查看原因。" 折叠>
    参数 XML文本 <类型 = 文本型 注释 = "待解析的 XML 文本。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取XML句柄 (XML文本)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            XML释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 是否存在 <公开 类型 = 逻辑型 注释 = "判断指定路径的节点是否存在。" 返回值注释 = "存在真、不存在假，句柄无效返回假。" 折叠>
    参数 路径 <类型 = 文本型 注释 = "用句点分隔的节点路径；属性路径中间要插入一节 <xmlattr> 。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (查询存在 (句柄, 路径) == 1)
    }

    方法 查询存在 <公开 静态 类型 = 整数 注释 = "底层查询节点是否存在：1 存在、0 不存在、-1 句柄无效。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "XML 树句柄。">
    参数 路径 <类型 = 文本型 注释 = "节点路径。">
    {
        @ FB_xml_has (@<文档句柄>, @<路径>)
    }

