<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Boost工具库 <注释 = "Boost 工具库（视窗版）——统计、大整数与 JSON 部分。" 折叠2 @视窗.外部头文件 = "native\\VolcanoBoostBridge.h" @视窗.外部库 = "native\\VolcanoBoostBridge.lib" @视窗.附属文件 = "native\\VolcanoBoostBridge.dll">

类 数列类 <公开 折叠 折叠2 注释 = "数值统计（boost/accumulators）：先「建立」，再逐个「加入数值」，最后取各项统计量。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层数列句柄，0 表示尚未建立。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            数列释放 (句柄)
            句柄 = 0
        }
    }

    方法 取数列句柄 <公开 静态 类型 = 变整数 注释 = "底层新建数列，返回句柄（供本类内部使用）。" 折叠 @嵌入式方法 = "">
    {
        @ FB_series_create ()
    }

    方法 数列释放 <公开 静态 类型 = 逻辑型 注释 = "释放数列句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ (FB_series_free (@<数列句柄>) != 0)
    }

    方法 压入数值 <公开 静态 类型 = 逻辑型 注释 = "底层追加一个数值。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    参数 数值 <类型 = 小数 注释 = "要加入的数值（NaN 会被忽略）。">
    {
        @ (FB_series_push (@<数列句柄>, @<数值>) != 0)
    }

    方法 建立 <公开 类型 = 逻辑型 注释 = "建立一个新的空数列；会先释放上一次的数据。" 返回值注释 = "建立成功返回真。" 折叠>
    {
        如果 (句柄 != 0)
        {
            数列释放 (句柄)
            句柄 = 0
        }
        句柄 = 取数列句柄 ()
        返回 (句柄 != 0)
    }

    方法 加入数值 <公开 类型 = 逻辑型 注释 = "向数列追加一个数值。" 返回值注释 = "句柄未建立或数值为 NaN 时返回假。" 折叠>
    参数 数值 <类型 = 小数 注释 = "要加入的数值。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (压入数值 (句柄, 数值))
    }

    方法 清空 <公开 类型 = 逻辑型 注释 = "清空数列中的全部数值，句柄保留。" 返回值注释 = "清空成功返回真。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (清空数值 (句柄))
    }

    方法 清空数值 <公开 静态 类型 = 逻辑型 注释 = "底层清空数列。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ (FB_series_clear (@<数列句柄>) != 0)
    }

    方法 取数量 <公开 类型 = 整数 注释 = "返回已加入的数值个数。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (0)
        }
        返回 (取数列数量 (句柄))
    }

    方法 取数列数量 <公开 静态 类型 = 整数 注释 = "底层取数值个数。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_count (@<数列句柄>)
    }

    方法 取合计 <公开 类型 = 小数 注释 = "返回全部数值之和。" 返回值注释 = "数列为空时返回 NaN。" 折叠>
    {
        返回 (求合计 (句柄))
    }

    方法 求合计 <公开 静态 类型 = 小数 注释 = "底层求合计。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_sum (@<数列句柄>)
    }

    方法 取平均 <公开 类型 = 小数 注释 = "返回算术平均值。" 返回值注释 = "数列为空时返回 NaN。" 折叠>
    {
        返回 (求平均 (句柄))
    }

    方法 求平均 <公开 静态 类型 = 小数 注释 = "底层求平均值。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_mean (@<数列句柄>)
    }

    方法 取方差 <公开 类型 = 小数 注释 = "返回总体方差（除以个数 N，不是样本方差）。" 返回值注释 = "数列为空时返回 NaN。" 折叠>
    {
        返回 (求方差 (句柄))
    }

    方法 求方差 <公开 静态 类型 = 小数 注释 = "底层求总体方差。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_variance (@<数列句柄>)
    }

    方法 取标准差 <公开 类型 = 小数 注释 = "返回总体标准差（方差的平方根）。" 返回值注释 = "数列为空时返回 NaN。" 折叠>
    {
        返回 (求标准差 (句柄))
    }

    方法 求标准差 <公开 静态 类型 = 小数 注释 = "底层求标准差。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_stddev (@<数列句柄>)
    }

    方法 取中位数 <公开 类型 = 小数 注释 = "返回中位数；个数为偶数时取中间两个的平均值。" 返回值注释 = "数列为空时返回 NaN。" 折叠>
    {
        返回 (求中位数 (句柄))
    }

    方法 求中位数 <公开 静态 类型 = 小数 注释 = "底层求中位数。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_median (@<数列句柄>)
    }

    方法 取最小 <公开 类型 = 小数 注释 = "返回最小值。" 返回值注释 = "数列为空时返回 NaN。" 折叠>
    {
        返回 (求最小 (句柄))
    }

    方法 求最小 <公开 静态 类型 = 小数 注释 = "底层求最小值。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_min (@<数列句柄>)
    }

    方法 取最大 <公开 类型 = 小数 注释 = "返回最大值。" 返回值注释 = "数列为空时返回 NaN。" 折叠>
    {
        返回 (求最大 (句柄))
    }

    方法 求最大 <公开 静态 类型 = 小数 注释 = "底层求最大值。" 折叠 @嵌入式方法 = "">
    参数 数列句柄 <类型 = 变整数 注释 = "数列句柄。">
    {
        @ FB_series_max (@<数列句柄>)
    }

    方法 是否有效数值 <公开 静态 类型 = 逻辑型 注释 = "判断一个小数是否为有效数值；取统计量得到 NaN 时本方法返回假。">
    参数 数值 <类型 = 小数 注释 = "待判断的小数。">
    {
        返回 (数值 == 数值)
    }
}

类 大整数类 <公开 折叠 折叠2 注释 = "任意精度整数（boost/multiprecision）：可以做超出 64 位范围的加减乘除与阶乘。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层大整数句柄，0 表示尚未装入数值。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            大整数释放 (句柄)
            句柄 = 0
        }
    }

    方法 取大整数句柄 <公开 静态 类型 = 变整数 注释 = "底层按文本建立大整数，返回句柄。" 折叠 @嵌入式方法 = "">
    参数 数字文本 <类型 = 文本型 注释 = "十进制整数文本，可带正负号。">
    {
        @ FB_big_from_text (@<数字文本>)
    }

    方法 大整数释放 <公开 静态 类型 = 逻辑型 注释 = "释放大整数句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 大整数句柄 <类型 = 变整数 注释 = "大整数句柄。">
    {
        @ (FB_big_free (@<大整数句柄>) != 0)
    }

    方法 大整数文本 <公开 静态 类型 = 文本型 注释 = "底层把大整数转为十进制文本。" 折叠 @嵌入式方法 = "">
    参数 大整数句柄 <类型 = 变整数 注释 = "大整数句柄。">
    {
        @ CWString(FB_big_text (@<大整数句柄>))
    }

    方法 从文本创建 <公开 类型 = 逻辑型 注释 = "按十进制文本装入数值；会先释放上一次的值。" 返回值注释 = "文本非法时返回假。" 折叠>
    参数 数字文本 <类型 = 文本型 注释 = "十进制整数文本，例如 123456789012345678901234567890 。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取大整数句柄 (数字文本)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            大整数释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 置阶乘 <公开 类型 = 逻辑型 注释 = "把本对象置为指定整数的阶乘。" 返回值注释 = "参数超范围（0 到 100000）时返回假。" 折叠>
    参数 阶数 <类型 = 整数 注释 = "0 到 100000 之间的整数。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取阶乘句柄 (阶数)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            大整数释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 取阶乘句柄 <公开 静态 类型 = 变整数 注释 = "底层计算阶乘并返回句柄。" 折叠 @嵌入式方法 = "">
    参数 阶数 <类型 = 整数 注释 = "阶乘参数。">
    {
        @ FB_big_fact (@<阶数>)
    }

    方法 转文本 <公开 类型 = 文本型 注释 = "返回当前数值的十进制文本；未装入数值时返回空文本。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 ("")
        }
        返回 (大整数文本 (句柄))
    }

    方法 相加 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 + 另一个」。" 返回值注释 = "任一方未装入数值时返回假，本对象内容保持不变。" 折叠>
    参数 另一个 <类型 = 大整数类 注释 = "参与相加的另一个大整数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 0))
    }

    方法 相减 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 - 另一个」。" 折叠>
    参数 另一个 <类型 = 大整数类 注释 = "参与相减的另一个大整数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 1))
    }

    方法 相乘 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 × 另一个」。" 折叠>
    参数 另一个 <类型 = 大整数类 注释 = "参与相乘的另一个大整数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 2))
    }

    方法 相除 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 ÷ 另一个」的整数商。" 返回值注释 = "除数为零时返回假。" 折叠>
    参数 另一个 <类型 = 大整数类 注释 = "除数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 3))
    }

    方法 取余 <公开 类型 = 逻辑型 注释 = "把本对象改为「本对象 ÷ 另一个」的余数。" 返回值注释 = "除数为零时返回假。" 折叠>
    参数 另一个 <类型 = 大整数类 注释 = "除数对象。">
    {
        返回 (改为二元结果 (另一个.句柄, 4))
    }

    方法 改为二元结果 <类型 = 逻辑型 注释 = "先算出新值，再释放旧值并换入，保证结果对象与任一操作数是同一个对象时也正确。">
    参数 乙句柄 <类型 = 变整数 注释 = "右操作数句柄。">
    参数 运算代号 <类型 = 整数 注释 = "0 相加、1 相减、2 相乘、3 相除、4 取余。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        如果 (乙句柄 == 0)
        {
            返回 (假)
        }
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取运算句柄 (句柄, 乙句柄, 运算代号)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        大整数释放 (句柄)
        句柄 = 新句柄
        返回 (真)
    }

    方法 取运算句柄 <公开 静态 类型 = 变整数 注释 = "底层二元运算，返回新句柄。" 折叠 @嵌入式方法 = "">
    参数 甲句柄 <类型 = 变整数 注释 = "左操作数句柄。">
    参数 乙句柄 <类型 = 变整数 注释 = "右操作数句柄。">
    参数 运算代号 <类型 = 整数 注释 = "0 相加、1 相减、2 相乘、3 相除、4 取余。">
    {
        @ FB_big_op (@<甲句柄>, @<乙句柄>, @<运算代号>)
    }

    方法 乘方 <公开 类型 = 逻辑型 注释 = "把本对象改为自身的指定次幂。" 折叠>
    参数 指数 <类型 = 整数 注释 = "非负整数。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取乘方句柄 (句柄, 指数)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        大整数释放 (句柄)
        句柄 = 新句柄
        返回 (真)
    }

    方法 取乘方句柄 <公开 静态 类型 = 变整数 注释 = "底层幂运算，返回新句柄。" 折叠 @嵌入式方法 = "">
    参数 大整数句柄 <类型 = 变整数 注释 = "底数句柄。">
    参数 指数 <类型 = 整数 注释 = "幂指数。">
    {
        @ FB_big_pow (@<大整数句柄>, @<指数>)
    }

    方法 比较 <公开 类型 = 整数 注释 = "比较本对象与另一个大整数的大小。" 返回值注释 = "本对象较小返回 -1，相等返回 0，较大返回 1，任一未装入数值返回 -2。" 折叠>
    参数 另一个 <类型 = 大整数类 注释 = "参与比较的另一个大整数对象。">
    {
        返回 (取比较结果 (句柄, 另一个.句柄))
    }

    方法 取比较结果 <公开 静态 类型 = 整数 注释 = "底层比较两个大整数句柄。" 折叠 @嵌入式方法 = "">
    参数 甲句柄 <类型 = 变整数 注释 = "左操作数句柄。">
    参数 乙句柄 <类型 = 变整数 注释 = "右操作数句柄。">
    {
        @ FB_big_cmp (@<甲句柄>, @<乙句柄>)
    }

    方法 取符号 <公开 类型 = 整数 注释 = "返回数值符号。" 返回值注释 = "负数 -1，零 0，正数 1，未装入数值 -2。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (-2)
        }
        返回 (取数值符号 (句柄))
    }

    方法 取数值符号 <公开 静态 类型 = 整数 注释 = "底层取数值符号。" 折叠 @嵌入式方法 = "">
    参数 大整数句柄 <类型 = 变整数 注释 = "大整数句柄。">
    {
        @ FB_big_sign (@<大整数句柄>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "立即释放底层数值；对象销毁时也会自动释放。" 折叠>
    {
        如果 (句柄 == 0)
        {
            返回 (真)
        }
        变量 结果 <类型 = 逻辑型>
        结果 = 大整数释放 (句柄)
        句柄 = 0
        返回 (结果)
    }
}

类 JSON文档类 <公开 折叠 折叠2 注释 = "JSON 解析与读写（boost/property_tree）：先「解析」，再用「路径」读取或改写节点。路径用句点分隔，例如 data.items ；数组用空名称占位，例如 data.items..name 。">
{
    变量 句柄 <公开 类型 = 变整数 值 = 0 注释 = "底层 JSON 树句柄，0 表示尚未解析。">

    方法 类_清理
    {
        如果 (句柄 != 0)
        {
            JSON释放 (句柄)
            句柄 = 0
        }
    }

    方法 取JSON句柄 <公开 静态 类型 = 变整数 注释 = "底层解析 JSON 文本，返回句柄。" 折叠 @嵌入式方法 = "">
    参数 JSON文本 <类型 = 文本型 注释 = "待解析的 JSON 文本。">
    {
        @ FB_json_parse (@<JSON文本>)
    }

    方法 JSON释放 <公开 静态 类型 = 逻辑型 注释 = "释放 JSON 句柄；重复释放不会出错。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "JSON 树句柄。">
    {
        @ (FB_json_free (@<文档句柄>) != 0)
    }

    方法 解析 <公开 类型 = 逻辑型 注释 = "解析 JSON 文本装入本对象；会先释放上一次的内容。" 返回值注释 = "文本不是合法 JSON 时返回假，可用文字工具.取错误说明 查看原因。" 折叠>
    参数 JSON文本 <类型 = 文本型 注释 = "待解析的 JSON 文本。">
    {
        变量 新句柄 <类型 = 变整数>
        新句柄 = 取JSON句柄 (JSON文本)
        如果 (新句柄 == 0)
        {
            返回 (假)
        }
        如果 (句柄 != 0)
        {
            JSON释放 (句柄)
        }
        句柄 = 新句柄
        返回 (真)
    }

    方法 是否存在 <公开 类型 = 逻辑型 注释 = "判断指定路径的节点是否存在。" 返回值注释 = "存在真、不存在假，句柄无效返回假。" 折叠>
    参数 路径 <类型 = 文本型 注释 = "用句点分隔的节点路径。">
    {
        如果 (句柄 == 0)
        {
            返回 (假)
        }
        返回 (查询存在 (句柄, 路径) == 1)
    }

    方法 查询存在 <公开 静态 类型 = 整数 注释 = "底层查询节点是否存在：1 存在、0 不存在、-1 句柄无效。" 折叠 @嵌入式方法 = "">
    参数 文档句柄 <类型 = 变整数 注释 = "JSON 树句柄。">
    参数 路径 <类型 = 文本型 注释 = "节点路径。">
    {
        @ FB_json_has (@<文档句柄>, @<路径>)
    }

