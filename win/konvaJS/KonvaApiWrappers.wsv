        节点ID = 欲ID
        返回 (画布.执行命令 ("{\"method\":\"newKonva\",\"args\":{\"className\":\"Line\",\"id\":\"" + 节点ID + "\",\"args\":" + 构造参数JSON + ",\"addTo\":\"" + 加入目标 + "\"}}", 3000))
    }

