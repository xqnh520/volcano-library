类 Konva图形 <公开 注释 = "封装本地 konva.js 中的 Konva.Shape 类。共生成 449 个公开原型方法。">
{
    变量 画布 <类型 = Konva画布框 注释 = "承载 Konva 页面的 WebView2 画布封装对象。调用任何方法前必须先绑定。">
    变量 节点ID <公开 类型 = 文本型 值 = "" 注释 = "Konva 节点 ID。为空时部分方法会作用于当前选中节点；Stage/Layer/Transformer 使用特殊 ID。">

    方法 绑定画布 <公开 类型 = 逻辑型 注释 = "绑定 Konva画布框，后续 Konva.Shape 方法都会转发到该画布。">
    参数 欲绑定画布 <类型 = Konva画布框 注释 = "已绑定 Edge浏览框 的 Konva画布框。">
    {
        画布 = 欲绑定画布
        返回 (真)
    }

    方法 绑定节点 <公开 类型 = 逻辑型 注释 = "绑定已经存在的 Konva.Shape 节点 ID，不创建新节点。">
    参数 欲ID <类型 = 文本型 注释 = "已有 Konva 节点 ID；可用 $stage、$layer、$transformer 表示内置对象。">
    {
        节点ID = 欲ID
        返回 (真)
    }

    方法 创建 <公开 类型 = 文本型 注释 = "创建 Konva.Shape 节点实例并保存 ID。构造参数来自本地 konva.js；通常传 [{...attrs...}]。">
    参数 欲ID <类型 = 文本型 注释 = "新节点 ID。">
    参数 构造参数JSON <类型 = 文本型 注释 = "构造函数参数数组 JSON，例如 [{\"x\":10,\"y\":10}]。" @默认值 = "[]">
    参数 加入目标 <类型 = 文本型 注释 = "加入目标。默认 layer；可填 stage、none 或某个 Group 节点 ID。" @默认值 = "layer">
    {
        节点ID = 欲ID
        返回 (画布.执行命令 ("{\"method\":\"newKonva\",\"args\":{\"className\":\"Shape\",\"id\":\"" + 节点ID + "\",\"args\":" + 构造参数JSON + ",\"addTo\":\"" + 加入目标 + "\"}}", 3000))
    }

    方法 取节点ID <公开 类型 = 文本型 注释 = "返回当前 Konva.Shape 封装对象绑定的节点 ID。">
    {
        返回 (节点ID)
    }

