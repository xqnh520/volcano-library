类 Konva路径文本 <公开 注释 = "封装本地 konva.js 中的 Konva.TextPath 类。共生成 487 个公开原型方法。">
{
    变量 画布 <类型 = Konva画布框 注释 = "承载 Konva 页面的 WebView2 画布封装对象。调用任何方法前必须先绑定。">
    变量 节点ID <公开 类型 = 文本型 值 = "" 注释 = "Konva 节点 ID。为空时部分方法会作用于当前选中节点；Stage/Layer/Transformer 使用特殊 ID。">

    方法 绑定画布 <公开 类型 = 逻辑型 注释 = "绑定 Konva画布框，后续 Konva.TextPath 方法都会转发到该画布。">
    参数 欲绑定画布 <类型 = Konva画布框 注释 = "已绑定 Edge浏览框 的 Konva画布框。">
    {
        画布 = 欲绑定画布
        返回 (真)
