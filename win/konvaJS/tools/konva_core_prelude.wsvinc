类 Konva绘图工具 <公开 注释 = "Konva画布框.置绘图工具 使用的工具名常量。" 折叠>
{
    常量 选择 <公开 类型 = 文本型 值 = "select" 注释 = "选择、拖放、缩放和旋转图形。">
    常量 矩形 <公开 类型 = 文本型 值 = "rect" 注释 = "按下鼠标并拖动绘制矩形。">
    常量 圆形 <公开 类型 = 文本型 值 = "circle" 注释 = "按下鼠标并拖动绘制圆形。">
    常量 椭圆 <公开 类型 = 文本型 值 = "ellipse" 注释 = "按下鼠标并拖动绘制椭圆。">
    常量 直线 <公开 类型 = 文本型 值 = "line" 注释 = "按下鼠标并拖动绘制直线。">
    常量 自由画笔 <公开 类型 = 文本型 值 = "free" 注释 = "按住鼠标自由绘制折线。">
}

类 Konva画布框 <公开 注释 = "对 Edge浏览框 中的 Konva 页面进行命令封装。每一个公开方法都会发送 JSON 命令到 assets\\konva_bridge.js。"
        @视窗.附属文件 = "..\\assets > assets" 折叠>
{
    变量 浏览框 <类型 = Edge浏览框 注释 = "被绑定的 WebView2 浏览框。外部不要直接修改，调用 绑定浏览框 设置。">
    变量 是否就绪 <公开 类型 = 逻辑型 注释 = "页面是否已经发回 ready 消息。收到 ready 后测试窗口会置为真。">
    变量 虚拟主机 <公开 类型 = 文本型 值 = "konva.local" 注释 = "WebView2 虚拟主机名，用来以 HTTPS 地址加载本地 assets。">
    变量 资源目录 <公开 类型 = 文本型 值 = "assets" 注释 = "映射给 WebView2 的本地资源目录。">
    变量 首页文件 <公开 类型 = 文本型 值 = "AppStartPage.html" 注释 = "Konva 承载页文件名。">

    方法 绑定浏览框 <公开 类型 = 逻辑型 注释 = "绑定一个 Edge浏览框。必须先绑定，后续所有命令才知道发往哪个 WebView2 控件。">
    参数 欲绑定浏览框 <类型 = Edge浏览框 注释 = "窗口上的 Edge浏览框 组件。">
    {
        浏览框 = 欲绑定浏览框
        返回 (真)
    }

    方法 加载本地页面 <公开 类型 = 逻辑型 注释 = "把 assets 目录映射为 HTTPS 虚拟站点，并导航到 Konva 承载页。通常在 Edge浏览框.浏览器创建完毕 事件中调用。">
    参数 主机名 <类型 = 文本型 注释 = "虚拟主机名，如 konva.local。">
    参数 映射目录 <类型 = 文本型 注释 = "输出目录中的资源目录，如 assets。">
    参数 页面文件 <类型 = 文本型 注释 = "入口 HTML 文件名，如 AppStartPage.html。">
    {
        虚拟主机 = 主机名
        资源目录 = 映射目录
        首页文件 = 页面文件
        浏览框.置虚拟主机文件映射 (虚拟主机, 资源目录, )
        浏览框.链接地址 = "https://" + 虚拟主机 + "/" + 首页文件
        返回 (真)
    }

    方法 加载运行目录页面 <公开 类型 = 逻辑型 注释 = "把运行目录下的 assets 子目录映射给 WebView2，并加载指定页面。发布程序时推荐使用本方法，配合 @视窗.附属文件 自动复制 assets。">
    参数 主机名 <类型 = 文本型 注释 = "虚拟主机名，如 konva.local。">
    参数 页面文件 <类型 = 文本型 注释 = "入口 HTML 文件名，如 AppStartPage.html。">
    {
        返回 (加载本地页面 (主机名, 取运行目录 () + "assets", 页面文件))
    }

    方法 加载调试目录页面 <公开 类型 = 逻辑型 注释 = "把开发目录中的 assets 绝对路径映射给 WebView2，避免调试时编译输出目录没有复制资源而出现未找到文件。">
    参数 主机名 <类型 = 文本型 注释 = "虚拟主机名，如 konva.local。">
    参数 页面文件 <类型 = 文本型 注释 = "入口 HTML 文件名，如 AppStartPage.html。">
    {
        返回 (加载本地页面 (主机名, "C:\\Users\\bmy\\Documents\\Konvajs封装\\assets", 页面文件))
    }

    方法 发送命令 <公开 类型 = 逻辑型 注释 = "发送一段完整 JSON 命令到前端桥接层。命令格式为 {\"method\":\"方法名\",\"args\":{...}}。高级调用可直接使用本方法。">
    参数 命令JSON <类型 = 文本型 注释 = "完整 JSON 命令文本。">
    {
        返回 (浏览框.发送Json信息 (命令JSON))
    }

    方法 执行命令 <公开 类型 = 文本型 注释 = "同步执行 JS 命令并返回 WebView2 的文本结果。适合读取 JSON 或导出 PNG 等有返回值的操作。">
    参数 命令JSON <类型 = 文本型 注释 = "完整 JSON 命令文本。">
    参数 超时毫秒 <类型 = 整数 注释 = "等待 JS 返回值的最长时间。" @默认值 = 1000>
    {
        返回 (浏览框.运行JS ("JSON.stringify(window.KonvaBridge.run(" + 命令JSON + "))", 超时毫秒, ))
    }

    方法 初始化画布 <公开 类型 = 逻辑型 注释 = "初始化 Konva Stage。页面默认会自动初始化，火山侧需要重建指定尺寸画布时可调用本方法。">
    参数 宽度 <类型 = 整数 注释 = "画布宽度，单位像素。">
    参数 高度 <类型 = 整数 注释 = "画布高度，单位像素。">
    {
        返回 (发送命令 ("{\"method\":\"init\",\"args\":{\"containerId\":\"container\",\"width\":" + 到文本 (宽度) + ",\"height\":" + 到文本 (高度) + "}}"))
    }

    方法 调整画布尺寸 <公开 类型 = 逻辑型 注释 = "修改 Konva Stage 的宽度和高度。窗口尺寸变化或外部需要固定画布尺寸时调用。">
    参数 宽度 <类型 = 整数 注释 = "新的画布宽度。">
    参数 高度 <类型 = 整数 注释 = "新的画布高度。">
    {
        返回 (发送命令 ("{\"method\":\"resizeStage\",\"args\":{\"width\":" + 到文本 (宽度) + ",\"height\":" + 到文本 (高度) + "}}"))
    }

    方法 置绘图工具 <公开 类型 = 逻辑型 注释 = "切换鼠标交互模式。选择模式可拖放和变换图形；绘图模式可在画布上拖动绘制新图形。">
    参数 工具名 <类型 = 文本型 注释 = "使用 Konva绘图工具 常量，如 Konva绘图工具.矩形。">
    参数 填充色 <类型 = 文本型 注释 = "新图形填充色，使用 CSS 颜色文本。" @默认值 = "#2f80ed">
    参数 线条色 <类型 = 文本型 注释 = "新图形描边色，使用 CSS 颜色文本。" @默认值 = "#1f2937">
    {
        返回 (发送命令 ("{\"method\":\"setTool\",\"args\":{\"tool\":\"" + 工具名 + "\",\"fill\":\"" + 填充色 + "\",\"stroke\":\"" + 线条色 + "\"}}"))
    }

    方法 添加矩形 <公开 类型 = 逻辑型 注释 = "在画布中添加一个可拖放矩形。图形会自动注册点击、拖动、变换事件并回传到火山。">
    参数 ID <类型 = 文本型 注释 = "图形唯一 ID。">
    参数 X <类型 = 整数 注释 = "左上角 X 坐标。">
    参数 Y <类型 = 整数 注释 = "左上角 Y 坐标。">
    参数 宽度 <类型 = 整数 注释 = "矩形宽度。">
    参数 高度 <类型 = 整数 注释 = "矩形高度。">
    参数 填充色 <类型 = 文本型 注释 = "CSS 填充色。">
    参数 可拖放 <类型 = 逻辑型 注释 = "是否允许鼠标拖放。" @默认值 = 真>
    {
        返回 (发送命令 ("{\"method\":\"addRect\",\"args\":{\"id\":\"" + ID + "\",\"x\":" + 到文本 (X) + ",\"y\":" + 到文本 (Y) + ",\"width\":" + 到文本 (宽度) + ",\"height\":" + 到文本 (高度) + ",\"fill\":\"" + 填充色 + "\",\"draggable\":" + 选择 (可拖放, "true", "false") + "}}"))
    }

    方法 添加圆形 <公开 类型 = 逻辑型 注释 = "在画布中添加一个可拖放圆形。">
    参数 ID <类型 = 文本型 注释 = "图形唯一 ID。">
    参数 圆心X <类型 = 整数 注释 = "圆心 X 坐标。">
    参数 圆心Y <类型 = 整数 注释 = "圆心 Y 坐标。">
    参数 半径 <类型 = 整数 注释 = "圆半径。">
    参数 填充色 <类型 = 文本型 注释 = "CSS 填充色。">
    参数 可拖放 <类型 = 逻辑型 注释 = "是否允许鼠标拖放。" @默认值 = 真>
    {
        返回 (发送命令 ("{\"method\":\"addCircle\",\"args\":{\"id\":\"" + ID + "\",\"x\":" + 到文本 (圆心X) + ",\"y\":" + 到文本 (圆心Y) + ",\"radius\":" + 到文本 (半径) + ",\"fill\":\"" + 填充色 + "\",\"draggable\":" + 选择 (可拖放, "true", "false") + "}}"))
    }

    方法 添加椭圆 <公开 类型 = 逻辑型 注释 = "在画布中添加一个可拖放椭圆。">
    参数 ID <类型 = 文本型 注释 = "图形唯一 ID。">
    参数 中心X <类型 = 整数 注释 = "中心 X 坐标。">
    参数 中心Y <类型 = 整数 注释 = "中心 Y 坐标。">
    参数 半径X <类型 = 整数 注释 = "横向半径。">
    参数 半径Y <类型 = 整数 注释 = "纵向半径。">
    参数 填充色 <类型 = 文本型 注释 = "CSS 填充色。">
    {
        返回 (发送命令 ("{\"method\":\"addEllipse\",\"args\":{\"id\":\"" + ID + "\",\"x\":" + 到文本 (中心X) + ",\"y\":" + 到文本 (中心Y) + ",\"radiusX\":" + 到文本 (半径X) + ",\"radiusY\":" + 到文本 (半径Y) + ",\"fill\":\"" + 填充色 + "\",\"draggable\":true}}"))
    }

    方法 添加文本 <公开 类型 = 逻辑型 注释 = "在画布中添加一个可拖放文本对象。">
    参数 ID <类型 = 文本型 注释 = "文本对象唯一 ID。">
    参数 X <类型 = 整数 注释 = "文本 X 坐标。">
    参数 Y <类型 = 整数 注释 = "文本 Y 坐标。">
    参数 文本 <类型 = 文本型 注释 = "显示内容。注意: 当前简化封装假定文本中不包含英文双引号。">
    参数 字号 <类型 = 整数 注释 = "字体大小。">
    参数 颜色 <类型 = 文本型 注释 = "CSS 文本颜色。">
    {
        返回 (发送命令 ("{\"method\":\"addText\",\"args\":{\"id\":\"" + ID + "\",\"x\":" + 到文本 (X) + ",\"y\":" + 到文本 (Y) + ",\"text\":\"" + 文本 + "\",\"fontSize\":" + 到文本 (字号) + ",\"fill\":\"" + 颜色 + "\",\"draggable\":true}}"))
    }

    方法 修改图形尺寸 <公开 类型 = 逻辑型 注释 = "修改指定图形尺寸。矩形按宽高设置；圆按宽度折算半径；椭圆按宽高折算两个半径。">
    参数 ID <类型 = 文本型 注释 = "图形 ID。传空文本时修改当前选中图形。">
    参数 宽度 <类型 = 整数 注释 = "目标宽度。">
    参数 高度 <类型 = 整数 注释 = "目标高度。">
    {
        返回 (发送命令 ("{\"method\":\"setNodeSize\",\"args\":{\"id\":\"" + ID + "\",\"width\":" + 到文本 (宽度) + ",\"height\":" + 到文本 (高度) + "}}"))
    }

    方法 修改图形属性 <公开 类型 = 逻辑型 注释 = "用 Konva 属性 JSON 修改指定图形，如 {\"fill\":\"red\",\"rotation\":30}。">
    参数 ID <类型 = 文本型 注释 = "图形 ID。">
    参数 属性JSON <类型 = 文本型 注释 = "attrs 对象 JSON，不包含外层 attrs 字段。">
    {
        返回 (发送命令 ("{\"method\":\"updateNode\",\"args\":{\"id\":\"" + ID + "\",\"attrs\":" + 属性JSON + "}}"))
    }

    方法 删除图形 <公开 类型 = 逻辑型 注释 = "删除指定图形。ID 为空时删除当前选中图形。">
    参数 ID <类型 = 文本型 注释 = "图形 ID。">
    {
        返回 (发送命令 ("{\"method\":\"deleteNode\",\"args\":{\"id\":\"" + ID + "\"}}"))
    }

    方法 清空画布 <公开 类型 = 逻辑型 注释 = "删除画布中的所有用户图形并取消选择。">
    {
        返回 (发送命令 ("{\"method\":\"clear\",\"args\":{}}"))
    }

    方法 取画布JSON <公开 类型 = 文本型 注释 = "同步读取 Konva Stage 的 JSON 序列化文本，可用于保存或调试。">
    {
        返回 (执行命令 ("{\"method\":\"getJson\",\"args\":{}}", 2000))
    }

    方法 导出PNG数据URL <公开 类型 = 文本型 注释 = "同步导出当前画布为 PNG Data URL。可保存为文件前先去掉 data:image/png;base64, 前缀。">
    {
        返回 (执行命令 ("{\"method\":\"exportPng\",\"args\":{}}", 5000))
    }

    方法 取文本 <公开 类型 = 文本型 注释 = "ECharts 风格别名。将当前 Konva Stage 序列化为 JSON 文本，等同于 取画布JSON。">
    {
        返回 (取画布JSON ())
    }

    方法 清空参数 <公开 类型 = 逻辑型 注释 = "ECharts 风格别名。清空当前画布中的用户图形和选择状态，等同于 清空画布。">
    {
        返回 (清空画布 ())
    }

    方法 画图 <公开 类型 = 文本型 注释 = "ECharts 风格方法。立即要求默认图层执行 draw()，适合手动刷新当前画布。">
    {
        返回 (执行命令 ("{\"method\":\"callNode\",\"args\":{\"id\":\"$layer\",\"method\":\"draw\",\"args\":[]}}", 2000))
    }

    方法 更新重画 <公开 类型 = 文本型 注释 = "ECharts 风格方法。要求默认图层执行 batchDraw()，适合连续修改多个图形属性后的合并刷新。">
    {
        返回 (执行命令 ("{\"method\":\"callNode\",\"args\":{\"id\":\"$layer\",\"method\":\"batchDraw\",\"args\":[]}}", 2000))
    }

    方法 执行JS脚本 <公开 类型 = 文本型 注释 = "ECharts 风格调试出口。直接在 WebView2 页面环境执行一段 JS 脚本并返回文本结果。">
    参数 JS文本 <类型 = 文本型 注释 = "要执行的 JavaScript 文本。">
    参数 超时毫秒 <类型 = 整数 注释 = "等待 JS 返回值的最长时间。" @默认值 = 2000>
    {
        返回 (浏览框.运行JS (JS文本, 超时毫秒, ))
    }

    方法 执行JS脚本2 <公开 类型 = 文本型 注释 = "ECharts 风格调试出口。把 JS 文本包入立即执行函数；需要返回值时在 JS 文本中使用 return。">
    参数 JS文本 <类型 = 文本型 注释 = "函数体形式的 JavaScript 文本，例如 return window.Konva.version。">
    参数 超时毫秒 <类型 = 整数 注释 = "等待 JS 返回值的最长时间。" @默认值 = 2000>
    {
        返回 (浏览框.运行JS ("(function(){" + JS文本 + "})()", 超时毫秒, ))
    }

    方法 截图 <公开 类型 = 文本型 注释 = "ECharts 风格截图方法。返回 PNG Data URL 文本，等同于 导出PNG数据URL。">
    {
        返回 (导出PNG数据URL ())
    }

    方法 取版本 <公开 类型 = 文本型 注释 = "读取当前页面加载的本地 Konva.version。">
    {
        返回 (执行命令 ("{\"method\":\"getKonvaValue\",\"args\":{\"path\":\"version\"}}", 2000))
    }

    方法 取参数 <公开 类型 = 文本型 注释 = "ECharts 风格方法。读取 Konva 全局配置或公开值，参数名使用 Konva 命名空间点路径，如 version、pixelRatio、dragDistance。">
    参数 参数名 <类型 = 文本型 注释 = "Konva 下的点分路径，不含开头 Konva。">
    {
        返回 (执行命令 ("{\"method\":\"getKonvaValue\",\"args\":{\"path\":\"" + 参数名 + "\"}}", 2000))
    }

    方法 置参数 <公开 类型 = 逻辑型 注释 = "ECharts 风格方法。写入 Konva 全局配置值，参数值必须是 JSON 值文本，如 true、2、\"文本\"。">
    参数 参数名 <类型 = 文本型 注释 = "Konva 下的点分路径，不含开头 Konva。">
    参数 参数值JSON <类型 = 文本型 注释 = "要写入的 JSON 值文本。文本值需要自行包含英文双引号。">
    {
        返回 (发送命令 ("{\"method\":\"setKonvaValue\",\"args\":{\"path\":\"" + 参数名 + "\",\"value\":" + 参数值JSON + "}}"))
    }

    方法 取图形参数 <公开 类型 = 文本型 注释 = "ECharts 风格方法。读取指定图形节点的属性或无参方法值；ID 为空时读取当前选中图形。">
    参数 ID <类型 = 文本型 注释 = "图形 ID。为空时读取当前选中图形；也可用 $stage、$layer、$transformer。">
    参数 参数名 <类型 = 文本型 注释 = "Konva 节点属性或无参方法名，如 x、y、width、height、rotation、fill。">
    {
        返回 (执行命令 ("{\"method\":\"getNodeValue\",\"args\":{\"id\":\"" + ID + "\",\"name\":\"" + 参数名 + "\"}}", 2000))
    }

    方法 置图形参数 <公开 类型 = 逻辑型 注释 = "ECharts 风格方法。设置指定图形节点的单个 attrs 参数；ID 为空时设置当前选中图形。">
    参数 ID <类型 = 文本型 注释 = "图形 ID。为空时设置当前选中图形。">
    参数 参数名 <类型 = 文本型 注释 = "Konva attrs 参数名，如 fill、stroke、rotation、opacity、draggable。">
    参数 参数值JSON <类型 = 文本型 注释 = "参数值 JSON 文本，如 30、true、\"#ff0000\"。文本值需要自行包含英文双引号。">
    {
        返回 (发送命令 ("{\"method\":\"updateNode\",\"args\":{\"id\":\"" + ID + "\",\"attrs\":{\"" + 参数名 + "\":" + 参数值JSON + "}}}"))
    }

    方法 重置 <公开 类型 = 逻辑型 注释 = "ECharts 风格方法。清空画布并恢复为选择工具，适合测试或重新开始绘制。">
    {
        清空画布 ()
        返回 (置绘图工具 (Konva绘图工具.选择, "#2f80ed", "#1f2937"))
    }

    方法 取Konva接口清单 <公开 类型 = 文本型 注释 = "返回当前本地 konva.js 实际暴露的静态成员、类名和类原型方法 JSON，用于查询哪些 Konva 函数可通过通用网关调用。">
    {
        返回 (执行命令 ("{\"method\":\"getApiMap\",\"args\":{}}", 5000))
    }

    方法 调用Konva静态函数 <公开 类型 = 文本型
            注释 = "调用 Konva 命名空间下任意静态函数。路径示例: Util.getRandomColor、Easings.EaseIn；参数JSON必须是数组文本，如 [] 或 [100]。">
    参数 路径 <类型 = 文本型 注释 = "Konva 下的点分路径，不含开头 Konva，如 Util.getRandomColor。">
    参数 参数JSON <类型 = 文本型 注释 = "传给函数的参数数组 JSON，如 []、[0.5]。">
    参数 超时毫秒 <类型 = 整数 注释 = "等待 JS 返回值的最长时间。" @默认值 = 2000>
    {
        返回 (执行命令 ("{\"method\":\"callKonva\",\"args\":{\"path\":\"" + 路径 + "\",\"args\":" + 参数JSON + "}}", 超时毫秒))
    }

    方法 读Konva值 <公开 类型 = 文本型 注释 = "读取 Konva 命名空间下任意公开值或对象摘要。路径示例: version、pixelRatio、dragDistance。">
    参数 路径 <类型 = 文本型 注释 = "Konva 下的点分路径，不含开头 Konva。">
    {
        返回 (执行命令 ("{\"method\":\"getKonvaValue\",\"args\":{\"path\":\"" + 路径 + "\"}}", 2000))
    }

    方法 写Konva值 <公开 类型 = 逻辑型 注释 = "写入 Konva 命名空间下任意可写配置值。常用于设置 pixelRatio、dragDistance、showWarnings 等全局选项。">
    参数 路径 <类型 = 文本型 注释 = "Konva 下的点分路径，不含开头 Konva。">
    参数 值JSON <类型 = 文本型 注释 = "要写入的 JSON 值，如 true、false、2、\"文本\"。">
    {
        返回 (发送命令 ("{\"method\":\"setKonvaValue\",\"args\":{\"path\":\"" + 路径 + "\",\"value\":" + 值JSON + "}}"))
    }

    方法 创建Konva对象 <公开 类型 = 文本型 注释 = "创建任意 Konva 类实例。节点类会自动加入图层并返回节点快照，非节点对象会返回 objectId 供 调用Konva对象方法 使用。">
    参数 类名 <类型 = 文本型 注释 = "Konva 类名或点分路径，如 Rect、Star、RegularPolygon、Tween、Animation。">
    参数 构造参数JSON <类型 = 文本型 注释 = "构造参数数组 JSON。普通图形通常写成 [{\"x\":10,\"y\":10,...}]。">
    参数 加入目标 <类型 = 文本型 注释 = "节点加入目标。默认 layer；可填 stage、none、或某个 Group 的 ID。">
    {
        返回 (执行命令 ("{\"method\":\"newKonva\",\"args\":{\"className\":\"" + 类名 + "\",\"args\":" + 构造参数JSON + ",\"addTo\":\"" + 加入目标 + "\"}}", 3000))
    }

    方法 调用图形方法 <公开 类型 = 文本型 注释 = "调用任意 Stage、Layer、Transformer 或图形节点方法。ID 为空表示当前选中节点；特殊 ID: $stage、$layer、$transformer。">
    参数 ID <类型 = 文本型 注释 = "节点 ID。为空时使用当前选中节点。">
    参数 方法名 <类型 = 文本型 注释 = "Konva 节点方法名，如 x、y、move、rotate、scale、opacity、fill、stroke。">
    参数 参数JSON <类型 = 文本型 注释 = "方法参数数组 JSON。如 [30]、[{\"x\":10,\"y\":10}]。">
    参数 超时毫秒 <类型 = 整数 注释 = "等待 JS 返回值的最长时间。" @默认值 = 2000>
    {
        返回 (执行命令 ("{\"method\":\"callNode\",\"args\":{\"id\":\"" + ID + "\",\"method\":\"" + 方法名 + "\",\"args\":" + 参数JSON + "}}", 超时毫秒))
    }

    方法 读图形值 <公开 类型 = 文本型 注释 = "读取任意 Stage、Layer、Transformer 或图形节点的属性/无参方法值。ID 为空表示当前选中节点；特殊 ID: $stage、$layer、$transformer。">
    参数 ID <类型 = 文本型 注释 = "节点 ID。为空时使用当前选中节点。">
    参数 名称 <类型 = 文本型 注释 = "属性或无参方法名，如 x、y、width、height、rotation、opacity。">
    {
        返回 (执行命令 ("{\"method\":\"getNodeValue\",\"args\":{\"id\":\"" + ID + "\",\"name\":\"" + 名称 + "\"}}", 2000))
    }

    方法 调用Konva对象方法 <公开 类型 = 文本型 注释 = "调用 创建Konva对象 或 调用Konva静态函数 返回的非节点 objectId 上的方法，适合 Transform、Tween、Animation 等对象。">
    参数 对象ID <类型 = 文本型 注释 = "桥接层返回的 objectId。">
    参数 方法名 <类型 = 文本型 注释 = "对象方法名。">
    参数 参数JSON <类型 = 文本型 注释 = "方法参数数组 JSON。">
    参数 超时毫秒 <类型 = 整数 注释 = "等待 JS 返回值的最长时间。" @默认值 = 2000>
    {
        返回 (执行命令 ("{\"method\":\"callObject\",\"args\":{\"objectId\":\"" + 对象ID + "\",\"method\":\"" + 方法名 + "\",\"args\":" + 参数JSON + "}}", 超时毫秒))
    }

    方法 释放Konva对象 <公开 类型 = 逻辑型 注释 = "释放桥接层保存的非节点 objectId 引用，避免长期保存 Transform、Tween 等临时对象。">
    参数 对象ID <类型 = 文本型 注释 = "桥接层返回的 objectId。">
    {
        返回 (发送命令 ("{\"method\":\"releaseObject\",\"args\":{\"objectId\":\"" + 对象ID + "\"}}"))
    }
}
