类 B2计数器 <公开 注释 = "计数器 · b2Counters" @别名 = "b2Counters" @别名类型 = 本地结构>
{
    变量 字节数量 <公开 类型 = 长整数 注释 = "字节数量 · b2Counters.byteCount" @输出名 = "byteCount">
    变量 刚体数量 <公开 类型 = 整数 注释 = "刚体数量 · b2Counters.bodyCount" @输出名 = "bodyCount">
    变量 形状数量 <公开 类型 = 整数 注释 = "形状数量 · b2Counters.shapeCount" @输出名 = "shapeCount">
    变量 接触数量 <公开 类型 = 整数 注释 = "接触数量 · b2Counters.contactCount" @输出名 = "contactCount">
    变量 关节数量 <公开 类型 = 整数 注释 = "关节数量 · b2Counters.jointCount" @输出名 = "jointCount">
    变量 岛屿数量 <公开 类型 = 整数 注释 = "岛屿数量 · b2Counters.islandCount" @输出名 = "islandCount">
    变量 栈使用量 <公开 类型 = 整数 注释 = "栈使用量 · b2Counters.stackUsed" @输出名 = "stackUsed">
    变量 静态树高度 <公开 类型 = 整数 注释 = "静态树高度 · b2Counters.staticTreeHeight" @输出名 = "staticTreeHeight">
    变量 树高度 <公开 类型 = 整数 注释 = "树高度 · b2Counters.treeHeight" @输出名 = "treeHeight">
    变量 任务数量 <公开 类型 = 整数 注释 = "任务数量 · b2Counters.taskCount" @输出名 = "taskCount">
    变量 唤醒接触数量 <公开 类型 = 整数 注释 = "本次碰撞处理触及的接触数量 · b2Counters.awakeContactCount" @输出名 = "awakeContactCount">
    变量 回收接触数量 <公开 类型 = 整数 注释 = "最近一步中回收的接触数量 · b2Counters.recycledContactCount" @输出名 = "recycledContactCount">

    方法 取颜色计数 <公开 静态 类型 = 整数 注释 = "读取颜色计数数组字段的一个元素 · b2vol_counters_getColorCount" @嵌入式方法 = "">
    参数 定义 <类型 = B2计数器>
    参数 序号 <类型 = 整数>
    {
        @ b2vol_counters_getColorCount(&@<定义>, @<序号>)
    }

    方法 置颜色计数 <公开 静态 注释 = "写入颜色计数数组字段的一个元素 · b2vol_counters_setColorCount" @嵌入式方法 = "">
    参数 定义 <类型 = B2计数器>
    参数 序号 <类型 = 整数>
    参数 新值 <类型 = 整数>
    {
        @ b2vol_counters_setColorCount(&@<定义>, @<序号>, @<新值>)
    }

}

