类 B2世界标识 <公开 注释 = "世界标识 · b2WorldId" @别名 = "b2WorldId" @别名类型 = 本地结构>
{
    变量 索引值 <公开 类型 = 短整数 注释 = "索引值 · b2WorldId.index1" @输出名 = "index1">
    变量 代数 <公开 类型 = 短整数 注释 = "代数 · b2WorldId.generation" @输出名 = "generation">
}

