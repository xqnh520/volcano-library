    变量 碰撞耗时 <公开 类型 = 单精度小数 注释 = "碰撞耗时 · b2Profile.collide" @输出名 = "collide">
    变量 求解耗时 <公开 类型 = 单精度小数 注释 = "求解耗时 · b2Profile.solve" @输出名 = "solve">
    变量 求解器准备耗时 <公开 类型 = 单精度小数 注释 = "求解器准备耗时 · b2Profile.solverSetup" @输出名 = "solverSetup">
    变量 约束耗时 <公开 类型 = 单精度小数 注释 = "约束耗时 · b2Profile.constraints" @输出名 = "constraints">
    变量 约束准备耗时 <公开 类型 = 单精度小数 注释 = "约束准备耗时 · b2Profile.prepareConstraints" @输出名 = "prepareConstraints">
    变量 速度积分耗时 <公开 类型 = 单精度小数 注释 = "速度积分耗时 · b2Profile.integrateVelocities" @输出名 = "integrateVelocities">
    变量 热启动耗时 <公开 类型 = 单精度小数 注释 = "热启动耗时 · b2Profile.warmStart" @输出名 = "warmStart">
    变量 求解冲量耗时 <公开 类型 = 单精度小数 注释 = "求解冲量耗时 · b2Profile.solveImpulses" @输出名 = "solveImpulses">
    变量 位置积分耗时 <公开 类型 = 单精度小数 注释 = "位置积分耗时 · b2Profile.integratePositions" @输出名 = "integratePositions">
    变量 松弛冲量耗时 <公开 类型 = 单精度小数 注释 = "松弛冲量耗时 · b2Profile.relaxImpulses" @输出名 = "relaxImpulses">
    变量 恢复系数 <公开 类型 = 单精度小数 注释 = "恢复系数 · b2Profile.restitution" @输出名 = "restitution">
    变量 存储冲量耗时 <公开 类型 = 单精度小数 注释 = "存储冲量耗时 · b2Profile.storeImpulses" @输出名 = "storeImpulses">
    变量 划分岛屿耗时 <公开 类型 = 单精度小数 注释 = "划分岛屿耗时 · b2Profile.splitIslands" @输出名 = "splitIslands">
    变量 变换耗时 <公开 类型 = 单精度小数 注释 = "变换耗时 · b2Profile.transforms" @输出名 = "transforms">
    变量 传感器命中耗时 <公开 类型 = 单精度小数 注释 = "传感器命中耗时 · b2Profile.sensorHits" @输出名 = "sensorHits">
    变量 关节事件耗时 <公开 类型 = 单精度小数 注释 = "关节事件耗时 · b2Profile.jointEvents" @输出名 = "jointEvents">
    变量 撞击事件耗时 <公开 类型 = 单精度小数 注释 = "撞击事件耗时 · b2Profile.hitEvents" @输出名 = "hitEvents">
    变量 重建耗时 <公开 类型 = 单精度小数 注释 = "重建耗时 · b2Profile.refit" @输出名 = "refit">
