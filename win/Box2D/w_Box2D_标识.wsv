<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Box2D <注释 = "标识与小结构：6 个标识类型、容量、过滤、材质、质量数据、计数器 · Box2D 3.2.0 单精度" @视窗.头文件搜寻目录 = "include"
        @视窗.外部头文件 = "b2vol.h" @视窗.库文件搜寻目录 = "lib/x64"
