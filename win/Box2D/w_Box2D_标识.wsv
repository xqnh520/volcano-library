类 B2表面材质 <公开 注释 = "表面材质 · b2SurfaceMaterial" @别名 = "b2SurfaceMaterial" @别名类型 = 本地结构>
{
    变量 摩擦系数 <公开 类型 = 单精度小数 注释 = "库仑干摩擦系数，通常在 0 到 1 之间 · b2SurfaceMaterial.friction" @输出名 = "friction">
    变量 恢复系数 <公开 类型 = 单精度小数 注释 = "恢复系数（弹性），通常在 0 到 1 之间 · b2SurfaceMaterial.restitution" @输出名 = "restitution">
    变量 滚动阻力 <公开 类型 = 单精度小数 注释 = "滚动阻力，通常在 0 到 1 之间 · b2SurfaceMaterial.rollingResistance" @输出名 = "rollingResistance">
    变量 切向速度 <公开 类型 = 单精度小数 注释 = "传送带所用的切向速度 · b2SurfaceMaterial.tangentSpeed" @输出名 = "tangentSpeed">
    变量 用户材质标识 <公开 类型 = 长整数 注释 = "用户材质标识 · b2SurfaceMaterial.userMaterialId" @输出名 = "userMaterialId">
    变量 自定义颜色 <公开 类型 = 整数 注释 = "自定义调试绘制颜色 · b2SurfaceMaterial.customColor" @输出名 = "customColor">
    方法 取默认定义 <公开 静态 类型 = B2表面材质 注释 = "用此函数初始化表面材质 · b2DefaultSurfaceMaterial" @嵌入式方法 = "">
    {
        @ b2DefaultSurfaceMaterial()
    }

}

