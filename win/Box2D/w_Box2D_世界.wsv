<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Box2D <注释 = "世界、事件、录制与接触 · Box2D 3.2.0 单精度" @视窗.头文件搜寻目录 = "include"
        @视窗.外部头文件 = "b2vol.h" @视窗.库文件搜寻目录 = "lib/x64"
        @视窗.外部库 = "box2d$(d).lib">

类 B2任务回调 <公开 注释 = "任务回调 · b2TaskCallbackFcn" @别名 = "b2TaskCallbackFcn*" @别名类型 = 本地整数基本类型 @有效值范围 = "">
{
    常量 空指针 <公开 类型 = B2任务回调 注释 = "空指针 · @nullptr" 值 = @nullptr>

    方法 回调模板 <公开 静态 注释 = "并行任务函数 · b2TaskCallbackFcn">
    参数 任务上下文 <类型 = 变整数>
    {
    }

    方法 创建 <公开 静态 类型 = B2任务回调 注释 = "创建回调值 · b2TaskCallbackFcn*" @嵌入式方法 = "">
    参数 回调函数 <@匹配方法 = "回调模板">
    {
        @ (b2TaskCallbackFcn*)&@<回调函数>
    }

}

类 B2射线结果 <公开 注释 = "射线结果 · b2RayResult" @别名 = "b2RayResult" @别名类型 = 本地结构>
{
    变量 形状标识 <公开 类型 = B2形状标识 注释 = "被命中的形状 · b2RayResult.shapeId" @输出名 = "shapeId">
    变量 点 <公开 类型 = B2向量 注释 = "命中形状表面上的接触点 · b2RayResult.point" @输出名 = "point">
    变量 法线 <公开 类型 = B2向量 注释 = "接触点处的单位法线 · b2RayResult.normal" @输出名 = "normal">
    变量 比例 <公开 类型 = 单精度小数 注释 = "输入射线上的比例 · b2RayResult.fraction" @输出名 = "fraction">
    变量 节点访问数 <公开 类型 = 整数 注释 = "访问的层次包围盒节点数量 · b2RayResult.nodeVisits" @输出名 = "nodeVisits">
    变量 叶子访问数 <公开 类型 = 整数 注释 = "访问的层次包围盒叶节点数量 · b2RayResult.leafVisits" @输出名 = "leafVisits">
    变量 是否撞击 <公开 类型 = 逻辑型 注释 = "射线是否命中 · b2RayResult.hit" @输出名 = "hit">
}

类 B2世界定义 <公开 注释 = "世界定义 · b2WorldDef" @别名 = "b2WorldDef" @别名类型 = 本地结构>
{
    变量 重力 <公开 类型 = B2向量 注释 = "重力向量 · b2WorldDef.gravity" @输出名 = "gravity">
    变量 恢复系数阈值 <公开 类型 = 单精度小数 注释 = "恢复系数的速度阈值，通常以米每秒计 · b2WorldDef.restitutionThreshold" @输出名 = "restitutionThreshold">
    变量 恢复系数迭代数 <公开 类型 = 整数 注释 = "恢复系数求解器的迭代次数 · b2WorldDef.restitutionIterations" @输出名 = "restitutionIterations">
    变量 启用恢复系数传播 <公开 类型 = 逻辑型 注释 = "在恢复系数求解器中启用完整接触传播 · b2WorldDef.enableRestitutionPropagation" @输出名 = "enableRestitutionPropagation">
    变量 撞击事件阈值 <公开 类型 = 单精度小数 注释 = "撞击事件的速度阈值 · b2WorldDef.hitEventThreshold" @输出名 = "hitEventThreshold">
    变量 接触赫兹 <公开 类型 = 单精度小数 注释 = "接触刚度 · b2WorldDef.contactHertz" @输出名 = "contactHertz">
    变量 接触阻尼比 <公开 类型 = 单精度小数 注释 = "接触弹性 · b2WorldDef.contactDampingRatio" @输出名 = "contactDampingRatio">
    变量 接触速度 <公开 类型 = 单精度小数 注释 = "控制重叠消除速度的参数，单位通常为米每秒 · b2WorldDef.contactSpeed" @输出名 = "contactSpeed">
    变量 最大线速度 <公开 类型 = 单精度小数 注释 = "最大线速度 · b2WorldDef.maximumLinearSpeed" @输出名 = "maximumLinearSpeed">
    变量 启用休眠 <公开 类型 = 逻辑型 注释 = "是否允许刚体休眠以提升性能 · b2WorldDef.enableSleep" @输出名 = "enableSleep">
    变量 启用连续碰撞 <公开 类型 = 逻辑型 注释 = "启用连续碰撞 · b2WorldDef.enableContinuous" @输出名 = "enableContinuous">
    变量 工作线程数量 <公开 类型 = 整数 注释 = "多线程使用的工作线程数量 · b2WorldDef.workerCount" @输出名 = "workerCount">
    变量 容量 <公开 类型 = B2容量 注释 = "可选的初始容量 · b2WorldDef.capacity" @输出名 = "capacity">
    变量 内部值 <公开 类型 = 整数 注释 = "内部用，检测定义是否有效 · b2WorldDef.internalValue" @输出名 = "internalValue">

    方法 取用户任务上下文指针 <公开 静态 类型 = 变整数 注释 = "读取用户任务上下文字段指针 · b2vol_worldDef_getUserTaskContext" @嵌入式方法 = "">
