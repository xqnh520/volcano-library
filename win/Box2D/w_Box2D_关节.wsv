<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Box2D <注释 = "关节定义与 9 种关节共 151 个接口 · Box2D 3.2.0 单精度" @视窗.头文件搜寻目录 = "include"
        @视窗.外部头文件 = "b2vol.h" @视窗.库文件搜寻目录 = "lib/x64"
        @视窗.外部库 = "box2d$(d).lib">

类 B2关节定义 <公开 注释 = "关节定义 · b2JointDef" @别名 = "b2JointDef" @别名类型 = 本地结构>
{
    变量 刚体标识甲 <公开 类型 = B2刚体标识 注释 = "第一个相连的刚体 · b2JointDef.bodyIdA" @输出名 = "bodyIdA">
    变量 刚体标识乙 <公开 类型 = B2刚体标识 注释 = "第二个相连的刚体 · b2JointDef.bodyIdB" @输出名 = "bodyIdB">
    变量 局部坐标系甲 <公开 类型 = B2变换 注释 = "第一个关节的局部坐标系 · b2JointDef.localFrameA" @输出名 = "localFrameA">
    变量 局部坐标系乙 <公开 类型 = B2变换 注释 = "第二个关节的局部坐标系 · b2JointDef.localFrameB" @输出名 = "localFrameB">
    变量 力阈值 <公开 类型 = 单精度小数 注释 = "关节事件的力阈值 · b2JointDef.forceThreshold" @输出名 = "forceThreshold">
    变量 扭矩阈值 <公开 类型 = 单精度小数 注释 = "关节事件的扭矩阈值 · b2JointDef.torqueThreshold" @输出名 = "torqueThreshold">
    变量 约束赫兹 <公开 类型 = 单精度小数 注释 = "约束刚度，高级选项 · b2JointDef.constraintHertz" @输出名 = "constraintHertz">
    变量 约束阻尼比 <公开 类型 = 单精度小数 注释 = "约束阻尼比，高级选项 · b2JointDef.constraintDampingRatio" @输出名 = "constraintDampingRatio">
    变量 绘制倍率 <公开 类型 = 单精度小数 注释 = "调试绘制缩放 · b2JointDef.drawScale" @输出名 = "drawScale">
    变量 允许连接体碰撞 <公开 类型 = 逻辑型 注释 = "相连两刚体之间是否互相碰撞 · b2JointDef.collideConnected" @输出名 = "collideConnected">

    方法 取用户数据指针 <公开 静态 类型 = 变整数 注释 = "读取用户数据字段指针 · b2vol_jointDef_getUserData" @嵌入式方法 = "">
    参数 定义 <类型 = B2关节定义>
    {
        @ (intptr_t)b2vol_jointDef_getUserData(&@<定义>)
    }

    方法 置用户数据指针 <公开 静态 注释 = "写入用户数据字段指针 · b2vol_jointDef_setUserData" @嵌入式方法 = "">
    参数 定义 <类型 = B2关节定义>
    参数 新值 <类型 = 变整数>
    {
        @ b2vol_jointDef_setUserData(&@<定义>, (void*)@<新值>)
    }

}

类 B2距离关节定义 <公开 注释 = "距离关节定义 · b2DistanceJointDef" @别名 = "b2DistanceJointDef" @别名类型 = 本地结构>
{
    变量 基础定义 <公开 类型 = B2关节定义 注释 = "关节基础定义 · b2DistanceJointDef.base" @输出名 = "base">
    变量 长度值 <公开 类型 = 单精度小数 注释 = "该关节的静止长度 · b2DistanceJointDef.length" @输出名 = "length">
    变量 启用弹簧 <公开 类型 = 逻辑型 注释 = "让距离约束表现为弹簧 · b2DistanceJointDef.enableSpring" @输出名 = "enableSpring">
    变量 下弹簧力 <公开 类型 = 单精度小数 注释 = "弹簧力下限，控制可承受的最大拉力 · b2DistanceJointDef.lowerSpringForce" @输出名 = "lowerSpringForce">
    变量 上弹簧力 <公开 类型 = 单精度小数 注释 = "弹簧力上限，控制可承受的最大压力 · b2DistanceJointDef.upperSpringForce" @输出名 = "upperSpringForce">
    变量 赫兹 <公开 类型 = 单精度小数 注释 = "弹簧线性刚度，单位为每秒周期数 · b2DistanceJointDef.hertz" @输出名 = "hertz">
    变量 阻尼比 <公开 类型 = 单精度小数 注释 = "弹簧线性阻尼比，无量纲 · b2DistanceJointDef.dampingRatio" @输出名 = "dampingRatio">
    变量 启用限制 <公开 类型 = 逻辑型 注释 = "启用或禁用关节限制 · b2DistanceJointDef.enableLimit" @输出名 = "enableLimit">
    变量 最小长度 <公开 类型 = 单精度小数 注释 = "限制所用的最小长度 · b2DistanceJointDef.minLength" @输出名 = "minLength">
    变量 最大长度 <公开 类型 = 单精度小数 注释 = "限制所用的最大长度 · b2DistanceJointDef.maxLength" @输出名 = "maxLength">
    变量 启用马达 <公开 类型 = 逻辑型 注释 = "启用或禁用关节马达 · b2DistanceJointDef.enableMotor" @输出名 = "enableMotor">
    变量 最大马达力 <公开 类型 = 单精度小数 注释 = "马达最大力，单位为牛顿 · b2DistanceJointDef.maxMotorForce" @输出名 = "maxMotorForce">
    变量 马达速度 <公开 类型 = 单精度小数 注释 = "期望的马达速度，单位为米每秒 · b2DistanceJointDef.motorSpeed" @输出名 = "motorSpeed">
    变量 内部值 <公开 类型 = 整数 注释 = "内部用，检测定义是否有效 · b2DistanceJointDef.internalValue" @输出名 = "internalValue">
    方法 取默认定义 <公开 静态 类型 = B2距离关节定义 注释 = "用此函数初始化距离关节定义 · b2DefaultDistanceJointDef" @嵌入式方法 = "">
    {
        @ b2DefaultDistanceJointDef()
    }

}

