类 B2基础功能 <公开 注释 = "基础功能 · 接口包装类">
{
    方法 置分配器 <公开 静态 注释 = "允许用户替换内存分配函数 · b2SetAllocator" @嵌入式方法 = "">
    参数 值甲 <类型 = B2分配回调>
    参数 值乙 <类型 = B2释放回调>
    {
        @ b2SetAllocator(@<值甲>, @<值乙>)
    }

    方法 取已分配字节数 <公开 静态 类型 = 长整数 注释 = "返回本库已分配的总字节数 · b2GetByteCount" @嵌入式方法 = "">
    {
        @ (int64_t)b2GetByteCount()
    }

    方法 置断言回调 <公开 静态 注释 = "替换默认的断言函数 · b2SetAssertCallback" @嵌入式方法 = "">
    参数 值甲 <类型 = B2断言回调>
    {
        @ b2SetAssertCallback(@<值甲>)
    }

    方法 置日志回调 <公开 静态 注释 = "替换默认的日志函数 · b2SetLogCallback" @嵌入式方法 = "">
    参数 值甲 <类型 = B2日志回调>
    {
        @ b2SetLogCallback(@<值甲>)
    }

    方法 取版本 <公开 静态 类型 = B2版本 注释 = "取当前库版本 · b2GetVersion" @嵌入式方法 = "">
    {
        @ b2GetVersion()
    }

    方法 是否双精度 <公开 静态 类型 = 逻辑型 注释 = "库是否以双精度（大世界模式）编译 · b2IsDoublePrecision" @嵌入式方法 = "">
    {
        @ (b2IsDoublePrecision() != 0)
    }

    方法 是否支持高级向量扩展2 <公开 静态 类型 = 逻辑型 注释 = "当前处理器是否支持高级向量扩展2指令集 · b2IsAVX2Available" @嵌入式方法 = "">
    {
        @ (b2IsAVX2Available() != 0)
    }

    方法 内部断言 <公开 静态 类型 = 整数 注释 = "内部断言 · b2InternalAssert" @嵌入式方法 = "">
    参数 值甲 <类型 = 变整数>
    参数 值乙 <类型 = 变整数>
    参数 行号 <类型 = 整数>
    {
        @ b2vol_internalAssert((const char*)@<值甲>, (const char*)@<值乙>, @<行号>)
    }

    方法 取刻度 <公开 静态 类型 = 长整数 注释 = "取系统计数的绝对值 · b2GetTicks" @嵌入式方法 = "">
    {
        @ (int64_t)b2GetTicks()
    }

    方法 取毫秒 <公开 静态 类型 = 小数 注释 = "取从某个起始计数起经过的毫秒数 · b2GetMilliseconds" @嵌入式方法 = "">
    参数 刻度数 <类型 = 长整数>
    {
        @ b2GetMilliseconds(@<刻度数>)
    }

    方法 取毫秒数并重置 <公开 静态 类型 = 小数 注释 = "取从起始计数起经过的毫秒数并重置起点 · b2GetMillisecondsAndReset">
    {
        变量 返回结果 <类型 = 小数>
        @ @<返回结果> = b2vol_getMillisecondsAndReset();
        返回 (返回结果)
    }

    方法 取上次重置刻度 <公开 静态 类型 = 长整数 注释 = "取从起始计数起经过的毫秒数并重置起点 · b2GetMillisecondsAndReset">
    {
        变量 返回刻度 <类型 = 长整数>
        @ @<返回刻度> = (INT64)b2vol_getResetTicks();
        返回 (返回刻度)
    }

    方法 让出 <公开 静态 注释 = "让出处理器，供忙等待循环使用 · b2Yield" @嵌入式方法 = "">
    {
        @ b2Yield()
    }

    方法 哈希 <公开 静态 类型 = 整数 注释 = "简易哈希函数，用于确定性测试 · b2Hash" @嵌入式方法 = "">
    参数 哈希值 <类型 = 整数>
    参数 值乙 <类型 = 变整数>
    参数 数量 <类型 = 整数>
    {
        @ b2Hash(@<哈希值>, (const uint8_t*)@<值乙>, @<数量>)
    }

}

