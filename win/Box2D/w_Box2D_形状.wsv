        @ b2Shape_SetUserMaterial(@<形状标识>, @<材质>)
    }

    方法 取用户材质 <公开 静态 类型 = 长整数 注释 = "取用户材质标识 · b2Shape_GetUserMaterial" @嵌入式方法 = "">
