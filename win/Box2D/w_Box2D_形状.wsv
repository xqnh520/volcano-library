}

类 B2形状 <公开 注释 = "形状 · 接口包装类">
{
    方法 创建圆形状 <公开 静态 类型 = B2形状标识 注释 = "创建圆形形状并挂到刚体上 · b2CreateCircleShape" @嵌入式方法 = "">
    参数 刚体标识 <类型 = B2刚体标识>
    参数 定义 <类型 = B2形状定义>
    参数 圆 <类型 = B2圆>
    {
        @ b2CreateCircleShape(@<刚体标识>, &@<定义>, &@<圆>)
    }

    方法 创建片段形状 <公开 静态 类型 = B2形状标识 注释 = "创建线段形状并挂到刚体上 · b2CreateSegmentShape" @嵌入式方法 = "">
    参数 刚体标识 <类型 = B2刚体标识>
    参数 定义 <类型 = B2形状定义>
    参数 线段 <类型 = B2线段>
    {
        @ b2CreateSegmentShape(@<刚体标识>, &@<定义>, &@<线段>)
    }

    方法 创建链条片段形状 <公开 静态 类型 = B2形状标识 注释 = "创建链条线段形状并挂到刚体上 · b2CreateChainSegmentShape" @嵌入式方法 = "">
    参数 刚体标识 <类型 = B2刚体标识>
    参数 定义 <类型 = B2形状定义>
    参数 链条段 <类型 = B2链条段>
    {
        @ b2CreateChainSegmentShape(@<刚体标识>, &@<定义>, &@<链条段>)
    }

    方法 创建胶囊形状 <公开 静态 类型 = B2形状标识 注释 = "创建胶囊形状并挂到刚体上 · b2CreateCapsuleShape" @嵌入式方法 = "">
    参数 刚体标识 <类型 = B2刚体标识>
    参数 定义 <类型 = B2形状定义>
    参数 胶囊 <类型 = B2胶囊>
    {
        @ b2CreateCapsuleShape(@<刚体标识>, &@<定义>, &@<胶囊>)
    }

    方法 创建多边形形状 <公开 静态 类型 = B2形状标识 注释 = "创建多边形形状并挂到刚体上 · b2CreatePolygonShape" @嵌入式方法 = "">
    参数 刚体标识 <类型 = B2刚体标识>
    参数 定义 <类型 = B2形状定义>
    参数 多边形 <类型 = B2多边形>
    {
        @ b2CreatePolygonShape(@<刚体标识>, &@<定义>, &@<多边形>)
    }

    方法 销毁形状 <公开 静态 注释 = "销毁形状 · b2DestroyShape" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    参数 更新质量 <类型 = 逻辑型>
    {
        @ b2DestroyShape(@<形状标识>, (@<更新质量> != 0))
    }

    方法 是否有效 <公开 静态 类型 = 逻辑型 注释 = "校验形状标识是否有效 · b2Shape_IsValid" @嵌入式方法 = "">
    参数 标识 <类型 = B2形状标识>
    {
        @ (b2Shape_IsValid(@<标识>) != 0)
    }

    方法 取类型 <公开 静态 类型 = 整数 注释 = "取形状类型 · b2Shape_GetType" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ (int)b2Shape_GetType(@<形状标识>)
    }

    方法 取刚体 <公开 静态 类型 = B2刚体标识 注释 = "取形状所挂刚体的标识 · b2Shape_GetBody" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ b2Shape_GetBody(@<形状标识>)
    }

    方法 取世界 <公开 静态 类型 = B2世界标识 注释 = "取拥有该形状的世界 · b2Shape_GetWorld" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ b2Shape_GetWorld(@<形状标识>)
    }

    方法 是否传感器 <公开 静态 类型 = 逻辑型 注释 = "该形状是否为传感器 · b2Shape_IsSensor" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ (b2Shape_IsSensor(@<形状标识>) != 0)
    }

    方法 置用户数据 <公开 静态 注释 = "设置形状的用户数据 · b2Shape_SetUserData" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    参数 用户数据 <类型 = 变整数>
    {
        @ b2Shape_SetUserData(@<形状标识>, (void*)@<用户数据>)
    }

    方法 取用户数据 <公开 静态 类型 = 变整数 注释 = "取形状的用户数据 · b2Shape_GetUserData" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ (intptr_t)b2Shape_GetUserData(@<形状标识>)
    }

    方法 置密度 <公开 静态 注释 = "设置形状的质量密度，通常以千克每平方米计 · b2Shape_SetDensity" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    参数 密度 <类型 = 单精度小数>
    参数 更新质量 <类型 = 逻辑型>
    {
        @ b2Shape_SetDensity(@<形状标识>, (float)@<密度>, (@<更新质量> != 0))
    }

    方法 取密度 <公开 静态 类型 = 小数 注释 = "取形状密度，通常以千克每平方米计 · b2Shape_GetDensity" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ b2Shape_GetDensity(@<形状标识>)
    }

    方法 置摩擦 <公开 静态 注释 = "设置形状摩擦系数 · b2Shape_SetFriction" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    参数 摩擦系数 <类型 = 单精度小数>
    {
        @ b2Shape_SetFriction(@<形状标识>, (float)@<摩擦系数>)
    }

    方法 取摩擦 <公开 静态 类型 = 小数 注释 = "取形状摩擦系数 · b2Shape_GetFriction" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ b2Shape_GetFriction(@<形状标识>)
    }

    方法 置恢复系数 <公开 静态 注释 = "设置形状恢复系数（弹性） · b2Shape_SetRestitution" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    参数 恢复系数 <类型 = 单精度小数>
    {
        @ b2Shape_SetRestitution(@<形状标识>, (float)@<恢复系数>)
    }

    方法 取恢复系数 <公开 静态 类型 = 小数 注释 = "取形状恢复系数 · b2Shape_GetRestitution" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    {
        @ b2Shape_GetRestitution(@<形状标识>)
    }

    方法 置用户材质 <公开 静态 注释 = "设置用户材质标识 · b2Shape_SetUserMaterial" @嵌入式方法 = "">
    参数 形状标识 <类型 = B2形状标识>
    参数 材质 <类型 = 长整数>
