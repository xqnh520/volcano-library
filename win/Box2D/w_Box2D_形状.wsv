<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Box2D <注释 = "形状与链条定义及 55 个形状接口 · Box2D 3.2.0 单精度" @视窗.头文件搜寻目录 = "include"
        @视窗.外部头文件 = "b2vol.h" @视窗.库文件搜寻目录 = "lib/x64"
        @视窗.外部库 = "box2d$(d).lib">

类 B2形状定义 <公开 注释 = "形状定义 · b2ShapeDef" @别名 = "b2ShapeDef" @别名类型 = 本地结构>
{
    变量 材质 <公开 类型 = B2表面材质 注释 = "该形状的表面材质 · b2ShapeDef.material" @输出名 = "material">
    变量 密度 <公开 类型 = 单精度小数 注释 = "密度，通常以千克每平方米计 · b2ShapeDef.density" @输出名 = "density">
    变量 过滤器 <公开 类型 = B2过滤 注释 = "碰撞过滤数据 · b2ShapeDef.filter" @输出名 = "filter">
    变量 启用自定义过滤 <公开 类型 = 逻辑型 注释 = "启用自定义过滤 · b2ShapeDef.enableCustomFiltering" @输出名 = "enableCustomFiltering">
    变量 是否传感器 <公开 类型 = 逻辑型 注释 = "传感器形状只产生重叠事件，不产生碰撞响应 · b2ShapeDef.isSensor" @输出名 = "isSensor">
    变量 启用传感器事件 <公开 类型 = 逻辑型 注释 = "为该形状启用传感器事件 · b2ShapeDef.enableSensorEvents" @输出名 = "enableSensorEvents">
    变量 启用接触事件 <公开 类型 = 逻辑型 注释 = "为该形状启用接触事件 · b2ShapeDef.enableContactEvents" @输出名 = "enableContactEvents">
    变量 启用撞击事件 <公开 类型 = 逻辑型 注释 = "为该形状启用撞击事件 · b2ShapeDef.enableHitEvents" @输出名 = "enableHitEvents">
    变量 启用预求解事件 <公开 类型 = 逻辑型 注释 = "为该形状启用求解前接触事件 · b2ShapeDef.enablePreSolveEvents" @输出名 = "enablePreSolveEvents">
    变量 调用接触创建 <公开 类型 = 逻辑型 注释 = "形状创建后下一时间步即扫描环境查找碰撞 · b2ShapeDef.invokeContactCreation" @输出名 = "invokeContactCreation">
    变量 更新刚体质量 <公开 类型 = 逻辑型 注释 = "创建该形状时是否让刚体重算质量属性 · b2ShapeDef.updateBodyMass" @输出名 = "updateBodyMass">
    变量 内部值 <公开 类型 = 整数 注释 = "内部用，检测定义是否有效 · b2ShapeDef.internalValue" @输出名 = "internalValue">

    方法 取用户数据指针 <公开 静态 类型 = 变整数 注释 = "读取用户数据字段指针 · b2vol_shapeDef_getUserData" @嵌入式方法 = "">
    参数 定义 <类型 = B2形状定义>
    {
        @ (intptr_t)b2vol_shapeDef_getUserData(&@<定义>)
    }

    方法 置用户数据指针 <公开 静态 注释 = "写入用户数据字段指针 · b2vol_shapeDef_setUserData" @嵌入式方法 = "">
    参数 定义 <类型 = B2形状定义>
    参数 新值 <类型 = 变整数>
    {
        @ b2vol_shapeDef_setUserData(&@<定义>, (void*)@<新值>)
    }

    方法 取默认定义 <公开 静态 类型 = B2形状定义 注释 = "用此函数初始化形状定义 · b2DefaultShapeDef" @嵌入式方法 = "">
    {
        @ b2DefaultShapeDef()
    }

}

类 B2链条定义 <公开 注释 = "链条定义 · b2ChainDef" @别名 = "b2ChainDef" @别名类型 = 本地结构>
{
    变量 点数量 <公开 类型 = 整数 注释 = "点数量 · b2ChainDef.pointCount" @输出名 = "pointCount">
    变量 虚拟点甲 <公开 类型 = B2向量 注释 = "开放链条首端的幽灵点 · b2ChainDef.ghost1" @输出名 = "ghost1">
    变量 虚拟点乙 <公开 类型 = B2向量 注释 = "开放链条末端的幽灵点 · b2ChainDef.ghost2" @输出名 = "ghost2">
    变量 材质数量 <公开 类型 = 整数 注释 = "材质数量 · b2ChainDef.materialCount" @输出名 = "materialCount">
    变量 过滤器 <公开 类型 = B2过滤 注释 = "接触过滤数据 · b2ChainDef.filter" @输出名 = "filter">
    变量 是否闭合 <公开 类型 = 逻辑型 注释 = "首尾点相连构成闭环链条 · b2ChainDef.isLoop" @输出名 = "isLoop">
    变量 启用传感器事件 <公开 类型 = 逻辑型 注释 = "允许传感器检测该链条 · b2ChainDef.enableSensorEvents" @输出名 = "enableSensorEvents">
    变量 内部值 <公开 类型 = 整数 注释 = "内部用，检测定义是否有效 · b2ChainDef.internalValue" @输出名 = "internalValue">

    方法 取用户数据指针 <公开 静态 类型 = 变整数 注释 = "读取用户数据字段指针 · b2vol_chainDef_getUserData" @嵌入式方法 = "">
