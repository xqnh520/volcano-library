<火山程序 类型 = "通常" 版本 = 1 />

包 火山.ThorVG <注释 = "ThorVG 1.1.0 矢量图形渲染库封装(火山视窗, 64 位)。ThorVG 是平台无关的矢量图形与动画引擎, 本模块封装其 CPU 软件光栅引擎, 以及 SVG / PNG / JPG / WebP / TTF / OTF / Lottie 加载能力与 GIF 保存能力。"
        注释 = "基本流程: ThorVG引擎.初始化 () -> 画布.创建 (宽, 高) -> 形状.创建 () 并追加几何与颜色 -> 画布.加入形状 (形状) -> 画布.刷新 () -> 画布.绘制 () -> 画布.取位图数据 () 交给 位图对象类.载入位图数据 显示。"
        注释 = "所有权约定(重要): 绘制对象(形状/场景/图片/文本)一经 画布.加入xxx 放入画布, 所有权即转移给画布 —— 画布销毁时一并销毁, 调用方不要再调用它们的 释放; 需要单独销毁请用 画布.移除xxx, 移除的同时对象即被销毁且火山侧句柄自动清零。渐变对象在 应用到填充 / 应用到描边 之后所有权转移给形状, 同样不可再释放、不可给第二个形状复用。"
        注释 = "坐标单位为像素, 原点在左上角, Y 轴向下; 角度单位为度, 顺时针为正。颜色分量为 0~255 整数, 透明度 255 表示不透明。"
        @视窗.头文件搜寻目录 = "deps\\thorvg\\include"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "thorvg_bridge.hpp"
        "@视窗.外部头文件.全局-101" = "ui_bridge.hpp"
        @视窗.外部源文件 = "native\\thorvg_bridge.cpp"
        @视窗.外部源文件 = "native\\ui_bridge.cpp"
        @视窗.预定义宏 = "TVG_STATIC,NOMINMAX,_CRT_SECURE_NO_WARNINGS"
        @视窗.附加编译参数 = "cpp: /std:c++17 /bigobj /FS"
        @视窗.库文件搜寻目录.x64 = "deps\\thorvg\\lib"
        @视窗.外部库.x64 = "thorvg-1$(d).lib">

类 ThorVG引擎 <公开 注释 = "引擎生命周期与全局信息。整个进程只需初始化一次(可重复调用, 内部按引用计数处理), 与 终止 成对使用。">
{
    方法 初始化 <公开 静态 类型 = 逻辑型 注释 = "初始化引擎; 线程数 小于等于 0 表示由 ThorVG 自动决定线程数。成功返回真。" 折叠 @嵌入式方法 = "">
    参数 线程数 <类型 = 整数 @默认值 = 0>
    {
        @ (thorgw_init(@<线程数>) == 0)
    }

    方法 终止 <公开 静态 注释 = "终止引擎并释放内部线程池; 重复调用无副作用。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_term()
    }

    方法 版本 <公开 静态 类型 = 文本型 注释 = "返回封装层与 ThorVG 原生库版本文本。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_version()
    }

    方法 错误说明 <公开 静态 类型 = 文本型 注释 = "把原生调用返回的错误码翻译成中文说明(0 成功; 1 参数无效; 2 条件不足; 3 分配失败; 4 内存损坏; 5 不支持; 255 未知; -1 句柄无效)。" 折叠 @嵌入式方法 = "">
    参数 错误码 <类型 = 整数>
    {
        @ thorgw_result_text(@<错误码>)
    }
}

类 ThorVG画布 <公开 注释 = "软件光栅画布: 内部持有一块「宽 x 高」的 ARGB 像素缓冲, 绘制对象加入后由 绘制 一次性光栅化, 再通过 取位图数据 / 取像素字节集 取出结果。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "内部画布句柄, 请勿手工修改。">
    变量 画布宽 <类型 = 整数>
    变量 画布高 <类型 = 整数>

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建软件画布。色彩空间: 0 ABGR8888, 1 ARGB8888(默认, 可直接交给 GDI 显示), 2 ABGR8888 非预乘, 3 ARGB8888 非预乘, 4 灰度8。成功返回真。">
    参数 宽 <类型 = 整数 注释 = "画布宽度(像素), 必须大于 0。">
    参数 高 <类型 = 整数 注释 = "画布高度(像素), 必须大于 0。">
    参数 色彩空间 <类型 = 整数 @默认值 = 1>
    {
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)thorgw_canvas_new(@<宽>, @<高>, @<色彩空间>);
        如果 (新指针 == 0)
        {
            返回 (假)
        }
        对象指针 = 新指针
        画布宽 = 宽
        画布高 = 高
        返回 (真)
    }

    方法 释放 <公开 注释 = "销毁画布及其全部子对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        旧指针 = 对象指针
        @ thorgw_canvas_free((void*)@<旧指针>);
        对象指针 = 0
        画布宽 = 0
        画布高 = 0
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "画布是否已创建。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<ThorVG画布.对象指针> != 0)
    }

    方法 宽度 <公开 属性读 类型 = 整数 注释 = "画布宽度(像素); 无效画布返回 0。">
    {
        返回 (画布宽)
    }

    方法 高度 <公开 属性读 类型 = 整数 注释 = "画布高度(像素); 无效画布返回 0。">
    {
        返回 (画布高)
    }

    方法 像素字节数 <公开 属性读 类型 = 整数 注释 = "像素缓冲字节数(32 位色彩空间为 宽 x 高 x 4); 无效画布返回 -1。">
    {
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        变量 尺寸 <类型 = 整数>
        @ @<尺寸> = thorgw_canvas_pixel_bytes((void*)@<画布句柄>);
        返回 (尺寸)
    }

    方法 填满颜色 <公开 类型 = 逻辑型 注释 = "用指定颜色填满整块像素缓冲, 常用于铺不透明背景(填充后画布即为不透明)。" 折叠 @嵌入式方法 = "">
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    参数 透明度 <类型 = 整数 @默认值 = 255>
    {
        @ (thorgw_canvas_fill((void*)@sn<this>.@n<ThorVG画布.对象指针>, @<红>, @<绿>, @<蓝>, @<透明度>) == 0)
    }

    方法 清除 <公开 类型 = 逻辑型 注释 = "把像素缓冲清成全透明黑(不做混合)。" 折叠 @嵌入式方法 = "">
    {
        @ (thorgw_canvas_clear((void*)@sn<this>.@n<ThorVG画布.对象指针>) == 0)
    }

    方法 刷新 <公开 类型 = 逻辑型 注释 = "通知画布场景已变化; 增删对象或修改对象属性后、绘制 之前调用。" 折叠 @嵌入式方法 = "">
    {
        @ (thorgw_canvas_update((void*)@sn<this>.@n<ThorVG画布.对象指针>) == 0)
    }

    方法 绘制 <公开 类型 = 逻辑型 注释 = "执行光栅化并等待渲染完成; 是否清屏 为真时先清成透明黑。成功返回真。" 折叠 @嵌入式方法 = "">
    参数 是否清屏 <类型 = 逻辑型 @默认值 = 假>
    {
        @ (thorgw_canvas_draw((void*)@sn<this>.@n<ThorVG画布.对象指针>, @<是否清屏> ? 1 : 0) == 0)
    }

    方法 置视口 <公开 类型 = 逻辑型 注释 = "设置绘制视口(只渲染该矩形范围内的内容)。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    参数 宽 <类型 = 整数>
    参数 高 <类型 = 整数>
    {
        @ (thorgw_canvas_viewport((void*)@sn<this>.@n<ThorVG画布.对象指针>, @<横坐标>, @<纵坐标>, @<宽>, @<高>) == 0)
    }

    方法 清空对象 <公开 类型 = 逻辑型 注释 = "移出画布内全部绘制对象(移出即销毁)。" 折叠 @嵌入式方法 = "">
    {
        @ (thorgw_canvas_remove((void*)@sn<this>.@n<ThorVG画布.对象指针>, nullptr) == 0)
    }

    方法 调整尺寸 <公开 类型 = 逻辑型 注释 = "改变画布尺寸并重建像素缓冲(画布内的绘制对象保留)。">
    参数 宽 <类型 = 整数>
    参数 高 <类型 = 整数>
    {
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ (thorgw_canvas_resize((void*)@<画布句柄>, @<宽>, @<高>) == 0);
        画布宽 = 宽
        画布高 = 高
        返回 (真)
    }

    方法 加入形状 <公开 类型 = 逻辑型 注释 = "把形状放入画布。加入后形状归画布所有, 请勿再调用形状的 释放。">
    参数 形状 <类型 = ThorVG形状>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_add((void*)@<画布句柄>, (void*)@<形状>.@n<ThorVG形状.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        形状.已交付 = 真
        返回 (真)
    }

    方法 加入场景 <公开 类型 = 逻辑型 注释 = "把场景放入画布。加入后场景归画布所有, 请勿再调用场景的 释放。">
    参数 场景 <类型 = ThorVG场景>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_add((void*)@<画布句柄>, (void*)@<场景>.@n<ThorVG场景.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        场景.已交付 = 真
        返回 (真)
    }

    方法 加入图片 <公开 类型 = 逻辑型 注释 = "把图片放入画布。加入后图片归画布所有, 请勿再调用图片的 释放。">
    参数 图片 <类型 = ThorVG图片>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_add((void*)@<画布句柄>, (void*)@<图片>.@n<ThorVG图片.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        图片.已交付 = 真
        返回 (真)
    }

    方法 加入文本 <公开 类型 = 逻辑型 注释 = "把文本放入画布。加入后文本归画布所有, 请勿再调用文本的 释放。">
    参数 文本 <类型 = ThorVG文本>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_add((void*)@<画布句柄>, (void*)@<文本>.@n<ThorVG文本.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        文本.已交付 = 真
        返回 (真)
    }

    方法 移除形状 <公开 类型 = 逻辑型 注释 = "从画布移除形状并立即销毁它(ThorVG 语义), 形状句柄自动清零。">
    参数 形状 <类型 = ThorVG形状>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_remove((void*)@<画布句柄>, (void*)@<形状>.@n<ThorVG形状.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        形状.对象指针 = 0
        形状.已交付 = 假
        返回 (真)
    }

    方法 移除场景 <公开 类型 = 逻辑型 注释 = "从画布移除场景并立即销毁它, 场景句柄自动清零。">
    参数 场景 <类型 = ThorVG场景>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_remove((void*)@<画布句柄>, (void*)@<场景>.@n<ThorVG场景.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        场景.对象指针 = 0
        场景.已交付 = 假
        返回 (真)
    }

    方法 移除图片 <公开 类型 = 逻辑型 注释 = "从画布移除图片并立即销毁它, 图片句柄自动清零。">
    参数 图片 <类型 = ThorVG图片>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_remove((void*)@<画布句柄>, (void*)@<图片>.@n<ThorVG图片.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        图片.对象指针 = 0
        图片.已交付 = 假
        返回 (真)
    }

    方法 移除文本 <公开 类型 = 逻辑型 注释 = "从画布移除文本并立即销毁它, 文本句柄自动清零。">
    参数 文本 <类型 = ThorVG文本>
    {
        变量 结果 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<结果> = thorgw_canvas_remove((void*)@<画布句柄>, (void*)@<文本>.@n<ThorVG文本.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        文本.对象指针 = 0
        文本.已交付 = 假
        返回 (真)
    }

    方法 取像素字节集 <公开 类型 = 字节集类 注释 = "复制整块像素缓冲(每像素 4 字节, 内存序为 蓝/绿/红/透明度); 无效画布返回空字节集。">
    {
        变量 数据 <类型 = 字节集类>
        变量 尺寸 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        @ @<尺寸> = thorgw_canvas_pixel_bytes((void*)@<画布句柄>);
        如果 (尺寸 <= 0)
        {
            返回 (取空白字节集 (0))
        }
        数据 = 取空白字节集 (尺寸)
        @ thorgw_canvas_copy_pixels((void*)@<画布句柄>, (char*)@<数据>.GetPtr(), @<尺寸>);
        返回 (数据)
    }

    方法 取位图数据 <公开 类型 = 字节集类 注释 = "把当前画面打包成 32 位 BMP 文件数据, 可直接交给 位图对象类.载入位图数据 显示; 无效画布返回空字节集。">
    {
        变量 数据 <类型 = 字节集类>
        变量 所需 <类型 = 整数>
        变量 画布句柄 <类型 = 变整数>
        画布句柄 = 对象指针
        数据 = 取空白字节集 (0)
        @ @<所需> = 0 - thorgw_canvas_make_bmp((void*)@<画布句柄>, nullptr, 0);
        如果 (所需 <= 0)
        {
            返回 (取空白字节集 (0))
        }
        数据 = 取空白字节集 (所需)
        @ thorgw_canvas_make_bmp((void*)@<画布句柄>, (char*)@<数据>.GetPtr(), @<所需>);
        返回 (数据)
    }

    方法 保存位图 <公开 类型 = 逻辑型 注释 = "把当前画面保存为 32 位 BMP 文件。">
    参数 文件名 <类型 = 文本型>
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取位图数据 ()
        如果 (取字节集长度 (数据) <= 0)
        {
            返回 (假)
        }
        返回 (写到文件 (文件名, 数据))
    }
}

类 ThorVG矩阵 <公开 注释 = "2D 仿射矩阵工具(3x3, 实际只有前两行参与 2D 变换)。矩阵以 36 字节(9 个单精度小数)保存, 可直接传给绘制对象的 变换 方法。">
{
    方法 单位 <公开 静态 类型 = 字节集类 注释 = "返回单位矩阵(不做任何变换)。">
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取空白字节集 (36)
        @ thorgw_matrix_build((float*)@<数据>.GetPtr(), 0, 0.0, 0.0);
        返回 (数据)
    }

    方法 平移 <公开 静态 类型 = 字节集类 注释 = "返回平移矩阵。">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取空白字节集 (36)
        @ thorgw_matrix_build((float*)@<数据>.GetPtr(), 1, (float)@<横位移>, (float)@<纵位移>);
        返回 (数据)
    }

    方法 缩放 <公开 静态 类型 = 字节集类 注释 = "返回缩放矩阵。">
    参数 横向比例 <类型 = 小数>
    参数 纵向比例 <类型 = 小数>
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取空白字节集 (36)
        @ thorgw_matrix_build((float*)@<数据>.GetPtr(), 2, (float)@<横向比例>, (float)@<纵向比例>);
        返回 (数据)
    }

    方法 旋转 <公开 静态 类型 = 字节集类 注释 = "返回旋转矩阵(角度, 顺时针为正)。">
    参数 角度 <类型 = 小数>
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取空白字节集 (36)
        @ thorgw_matrix_build((float*)@<数据>.GetPtr(), 3, (float)@<角度>, 0.0);
        返回 (数据)
    }

    方法 组合 <公开 静态 类型 = 字节集类 注释 = "组合两个矩阵: 结果表示「先施加 甲矩阵, 再施加 乙矩阵」。例如先缩放再平移: 组合 (缩放矩阵, 平移矩阵)。">
    参数 甲矩阵 <类型 = 字节集类>
    参数 乙矩阵 <类型 = 字节集类>
    {
        变量 结果 <类型 = 字节集类>
        结果 = 取空白字节集 (36)
        如果 (取字节集长度 (甲矩阵) < 36)
        {
            返回 (结果)
        }
        如果 (取字节集长度 (乙矩阵) < 36)
        {
            返回 (结果)
        }
        @ thorgw_matrix_multiply((float*)@<结果>.GetPtr(), (const float*)@<乙矩阵>.GetPtr(), (const float*)@<甲矩阵>.GetPtr());
        返回 (结果)
    }

    方法 取分量 <公开 静态 类型 = 小数 注释 = "读取矩阵第 下标(0-8, 行优先) 个分量。">
    参数 矩阵数据 <类型 = 字节集类>
    参数 下标 <类型 = 整数>
    {
        如果 (下标 < 0)
        {
            返回 (0.0)
        }
        如果 (下标 > 8)
        {
            返回 (0.0)
        }
        返回 (取字节集单精度小数 (矩阵数据, 下标 * 4))
    }
}
