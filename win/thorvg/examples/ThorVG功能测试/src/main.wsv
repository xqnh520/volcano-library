<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

类 启动类 <公开 基础类 = 窗口程序类 注释 = "ThorVG 类库功能测试(窗口程序)。">
{
    变量 主窗口对象 <类型 = 我的主窗口 标题 = "ThorVG 功能测试">

    方法 启动方法 <公开 类型 = 整数>
    {
        主窗口对象.创建主窗口 ()
        返回 (1)
    }
}

# ================

类 我的主窗口 <基础类 = 窗口 注释 = "主窗口: 左侧为自测报告, 右侧为矢量图形演示画板。" @视窗.布局 = "client_size = \"1360, 860\"" 标题 = "ThorVG 功能测试">
{
    变量 画板1 <类型 = 画板 @视窗.布局 = "id = 100\r\npos = \"400, 8, 950, 840\"">
    变量 运行按钮 <类型 = 按钮 @视窗.布局 = "id = 101\r\npos = \"8, 8, 120, 32\"" 标题 = "重新运行">
    变量 状态标签 <类型 = 标签 @视窗.布局 = "id = 102\r\npos = \"140, 15, 250, 18\"" 标题 = "准备中">
    变量 报告框 <类型 = 编辑框 @视窗.布局 = "id = 103\r\npos = \"8, 48, 384, 800\"" 是否允许多行 = 真 滚动条 = 纵向滚动条>
    变量 报告文本 <类型 = 文本型>
    变量 失败数 <类型 = 整数>
    变量 检查数 <类型 = 整数>
    变量 画布对象 <类型 = ThorVG画布>
    变量 界面就绪 <类型 = 逻辑型>
    变量 图片已贴 <类型 = 逻辑型>
    变量 演示图片 <类型 = ThorVG图片>

    方法 我的主窗口_创建完毕 <接收事件 类型 = 整数 注释 = "窗口创建完毕: 只做引擎与字体初始化, 画面留到首次激活后再渲染(那时画板尺寸才是最终值)。">
    参数 来源对象 <类型 = 我的主窗口>
    参数 标记值 <类型 = 整数>
    {
        画板1.自动重画 = 真
        画板1.画板背景色 = 颜色类.黑色
        报告框.内容 = "正在初始化 ThorVG 引擎..."
        返回 (0)
    }

    方法 我的主窗口_首次激活 <接收事件 类型 = 整数 注释 = "窗口完全显示、画板尺寸确定后, 渲染演示画面并贴到画板上。">
    参数 来源对象 <类型 = 我的主窗口>
    参数 标记值 <类型 = 整数>
    {
        如果 (界面就绪)
        {
            贴图到画板 ()
            返回 (0)
        }
        界面就绪 = 真
        运行自测 ()
        贴图到画板 ()
        返回 (0)
    }

    方法 画板_绘画 <接收事件 类型 = 整数 注释 = "画板重绘时重新贴一次图, 保证窗口被遮挡后恢复仍能看到画面。">
    参数 来源对象 <类型 = 画板>
    参数 标记值 <类型 = 整数>
    参数 重画区 <类型 = 矩形类>
    {
        如果 (界面就绪 == 假)
        {
            返回 (0)
        }
        贴图到画板 ()
        返回 (0)
    }

    方法 贴图到画板 <公开 注释 = "把画布当前像素导出为 32 位 BMP, 载入位图对象并绘制到画板。">
    {
        如果 (画布对象.已创建 () == 假)
        {
            返回 ()
        }
        变量 数据 <类型 = 字节集类>
        数据 = 画布对象.取位图数据 ()
        如果 (取字节集长度 (数据) <= 0)
        {
            返回 ()
        }
        变量 位图 <类型 = 位图对象类>
        位图 = 位图对象类.载入位图数据 (数据)
        如果 (位图.为空 ())
        {
            返回 ()
        }
        画板1.清除 ()
        画板1.画图片 (位图, 0, 0, 画板1.取用户区宽度 (), 画板1.取用户区高度 ())
        图片已贴 = 真
    }

    方法 按钮_被单击 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = 按钮>
    参数 标记值 <类型 = 整数>
    {
        运行自测 ()
        返回 (0)
    }

    # ================= 自测主流程 =================

    方法 运行自测 <公开 注释 = "初始化引擎, 渲染演示画面, 输出自测报告与画面文件。">
    {
        报告文本 = ""
        失败数 = 0
        检查数 = 0

        写报告 ("==== ThorVG 类库功能测试 ====")
        写报告 ("版本: " + ThorVG引擎.版本 ())
        检查 ("引擎初始化", ThorVG引擎.初始化 (2))
        检查 ("载入中文字体", ThorVG文本.载入字体文件 ("C:\\Windows\\Fonts\\simhei.ttf"))

        变量 宽 <类型 = 整数>
        变量 高 <类型 = 整数>
        宽 = 画板1.取用户区宽度 ()
        高 = 画板1.取用户区高度 ()
        如果 (宽 < 100)
        {
            宽 = 950
        }
        如果 (高 < 100)
        {
            高 = 840
        }

        画布对象.释放 ()
        检查 ("创建画布 " + 到文本 (宽) + "x" + 到文本 (高), 画布对象.创建 (宽, 高, 1))
        如果 (画布对象.已创建 () == 假)
        {
            写报告 ("画布创建失败, 中止测试")
            返回 ()
        }
        检查 ("画布宽度属性", 画布对象.宽度 == 宽)
        检查 ("画布像素字节数", 画布对象.像素字节数 == 宽 * 高 * 4)
        检查 ("填满背景色", 画布对象.填满颜色 (28, 34, 46, 255))

        画标题 (30, 36, "ThorVG 矢量图形引擎 · 火山视窗封装")

        写报告 ("")
        写报告 ("-- 基本图元 --")
        测试基本图元 ()

        写报告 ("")
        写报告 ("-- 渐变填充 --")
        测试渐变 ()

        写报告 ("")
        写报告 ("-- 描边样式 --")
        测试描边 ()

        写报告 ("")
        写报告 ("-- 遮罩 裁剪 混合 --")
        测试组合 ()

        写报告 ("")
        写报告 ("-- 场景 变换 矩阵 --")
        测试场景 ()

        写报告 ("")
        写报告 ("-- 图片加载 --")
        测试图片 ()

        检查 ("刷新画布", 画布对象.刷新 ())
        检查 ("绘制画布", 画布对象.绘制 ())

        变量 像素 <类型 = 字节集类>
        像素 = 画布对象.取像素字节集 ()
        检查 ("取像素字节集长度", 取字节集长度 (像素) == 宽 * 高 * 4)

        画板1.重画 ()
        状态标签.标题 = "检查 " + 到文本 (检查数) + " 项, 失败 " + 到文本 (失败数) + " 项"
        报告文本 = 报告文本 + "\r\n检查 " + 到文本 (检查数) + " 项, 失败 " + 到文本 (失败数) + " 项"
        报告框.内容 = 报告文本

        变量 输出目录 <类型 = 文本型>
        输出目录 = 取运行目录 ()
        写到文件 (输出目录 + "\\thorvg_test_report.txt", 文本到UTF8 (报告文本))
        画布对象.保存位图 (输出目录 + "\\thorvg_test_canvas.bmp")
    }

    # ================= 各功能区块 =================

    方法 测试基本图元 <公开>
    {
        变量 矩形 <类型 = ThorVG形状>
        检查 ("创建矩形", 矩形.创建 ())
        检查 ("追加矩形(圆角)", 矩形.追加矩形 (30, 76, 200, 110, 16, 16))
        检查 ("填充红色", 矩形.填充颜色 (220, 70, 70))
        检查 ("矩形路径命令数大于0", 矩形.路径命令数 > 0)
        检查 ("取包围盒", 取字节集长度 (矩形.取包围盒 ()) == 16)
        检查 ("矩形包围盒宽度为200", 取整 (矩形.取包围盒宽度 ()) == 200)
        检查 ("矩形加入画布", 画布对象.加入形状 (矩形))

        变量 圆 <类型 = ThorVG形状>
        圆.创建 ()
        圆.追加圆 (330, 131, 55)
        圆.填充颜色 (60, 190, 120)
        检查 ("圆加入画布", 画布对象.加入形状 (圆))

        变量 圆环 <类型 = ThorVG形状>
        圆环.创建 ()
        检查 ("追加圆环(奇偶填充)", 圆环.追加圆环 (470, 131, 62, 34))
        圆环.填充颜色 (90, 200, 240)
        检查 ("圆环加入画布", 画布对象.加入形状 (圆环))

        变量 星形 <类型 = ThorVG形状>
        星形.创建 ()
        检查 ("追加星形", 星形.追加星形 (610, 131, 62, 26, 5))
        星形.填充颜色 (250, 220, 80)
        星形.描边宽度 (4)
        星形.描边颜色 (255, 255, 255)
        星形.描边拐角 (1)
        检查 ("星形加入画布", 画布对象.加入形状 (星形))

        变量 折线 <类型 = ThorVG形状>
        折线.创建 ()
        变量 点数据 <类型 = 字节集类>
        点数据 = 取空白字节集 (5 * 8)
        置字节集单精度小数 (点数据, 0, 720.0)
        置字节集单精度小数 (点数据, 4, 190.0)
        置字节集单精度小数 (点数据, 8, 780.0)
        置字节集单精度小数 (点数据, 12, 80.0)
        置字节集单精度小数 (点数据, 16, 840.0)
        置字节集单精度小数 (点数据, 20, 190.0)
        置字节集单精度小数 (点数据, 24, 700.0)
        置字节集单精度小数 (点数据, 28, 140.0)
        置字节集单精度小数 (点数据, 32, 860.0)
        置字节集单精度小数 (点数据, 36, 150.0)
        检查 ("追加折线", 折线.追加折线 (点数据, 真))
        折线.填充颜色 (120, 160, 255)
        检查 ("折线加入画布", 画布对象.加入形状 (折线))

        变量 弧 <类型 = ThorVG形状>
        弧.创建 ()
        检查 ("追加圆弧", 弧.追加圆弧 (330, 360, 60, 200, 140))
        弧.描边宽度 (8)
        弧.描边颜色 (255, 200, 0)
        弧.描边端点 (1)
        检查 ("圆弧加入画布", 画布对象.加入形状 (弧))
    }

    方法 测试渐变 <公开>
    {
        变量 矩形 <类型 = ThorVG形状>
        矩形.创建 ()
        矩形.追加矩形 (30, 220, 200, 110, 0, 0)
        变量 线性 <类型 = ThorVG线性渐变>
        检查 ("创建线性渐变", 线性.创建 ())
        检查 ("设置起止点", 线性.设置起止点 (30, 220, 230, 330))
        线性.添加色标 (0.0, 255, 200, 60, 255)
        线性.添加色标 (0.5, 255, 120, 40, 255)
        线性.添加色标 (1.0, 180, 40, 200, 255)
        检查 ("提交色标", 线性.提交色标 ())
        检查 ("线性渐变应用到填充", 线性.应用到填充 (矩形))
        检查 ("渐变交付后句柄清零", 线性.已创建 () == 假)
        检查 ("渐变矩形加入画布", 画布对象.加入形状 (矩形))

        变量 圆 <类型 = ThorVG形状>
        圆.创建 ()
        圆.追加圆 (330, 275, 55)
        变量 径向 <类型 = ThorVG径向渐变>
        检查 ("创建径向渐变", 径向.创建 ())
        检查 ("设置范围", 径向.设置范围 (330, 275, 55, 330, 275, 0))
        径向.添加色标 (0.0, 255, 255, 255, 255)
        径向.添加色标 (0.55, 90, 200, 240, 255)
        径向.添加色标 (1.0, 30, 90, 160, 255)
        检查 ("径向渐变应用到填充", 径向.应用到填充 (圆))
        检查 ("径向圆加入画布", 画布对象.加入形状 (圆))

        变量 环 <类型 = ThorVG形状>
        环.创建 ()
        环.追加矩形 (470, 220, 200, 110, 12, 12)
        环.描边宽度 (10)
        变量 描边渐变 <类型 = ThorVG线性渐变>
        描边渐变.创建 ()
        描边渐变.设置起止点 (470, 220, 670, 330)
        描边渐变.添加色标 (0.0, 120, 255, 180, 255)
        描边渐变.添加色标 (1.0, 255, 120, 200, 255)
        检查 ("渐变应用到描边", 描边渐变.应用到描边 (环))
        检查 ("渐变描边加入画布", 画布对象.加入形状 (环))
    }

