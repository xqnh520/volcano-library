    方法 测试场景 <公开>
    {
        变量 场景 <类型 = ThorVG场景>
        检查 ("创建场景", 场景.创建 ())

        变量 块甲 <类型 = ThorVG形状>
        块甲.创建 ()
        块甲.追加矩形 (0, 0, 70, 70, 8, 8)
        块甲.填充颜色 (255, 120, 120)
        检查 ("场景加入形状甲", 场景.加入形状 (块甲))

        变量 块乙 <类型 = ThorVG形状>
        块乙.创建 ()
        块乙.追加矩形 (40, 40, 70, 70, 8, 8)
        块乙.填充颜色 (120, 180, 255)
        检查 ("场景加入形状乙", 场景.加入形状 (块乙))

        场景.平移 (830, 545)
        场景.旋转 (20)
        场景.透明度 (200)
        检查 ("场景加入画布", 画布对象.加入场景 (场景))

        变量 矩阵块 <类型 = ThorVG形状>
        矩阵块.创建 ()
        矩阵块.追加矩形 (0, 0, 90, 50, 6, 6)
        矩阵块.填充颜色 (200, 160, 255)
        变量 缩放矩阵 <类型 = 字节集类>
        缩放矩阵 = ThorVG矩阵.缩放 (1.4, 1.4)
        检查 ("矩阵生成 36 字节", 取字节集长度 (缩放矩阵) == 36)
        检查 ("矩阵分量(0,0)为1.4", 取整 (ThorVG矩阵.取分量 (缩放矩阵, 0) * 10.0) == 14)
        检查 ("矩阵分量(0,1)为0", 取整 (ThorVG矩阵.取分量 (缩放矩阵, 1)) == 0)
        // 复合变换: 先缩放再平移 -> 组合(缩放矩阵, 平移矩阵);
        // 注意 ThorVG 一旦 变换 设定矩阵, 之后的 平移/旋转/缩放 都不再生效
        变量 平移矩阵 <类型 = 字节集类>
        平移矩阵 = ThorVG矩阵.平移 (120.0, 720.0)
        变量 复合矩阵 <类型 = 字节集类>
        复合矩阵 = ThorVG矩阵.组合 (缩放矩阵, 平移矩阵)
        检查 ("矩阵组合后平移分量", 取整 (ThorVG矩阵.取分量 (复合矩阵, 2)) == 120)
        检查 ("应用矩阵变换", 矩阵块.变换 (复合矩阵))
        检查 ("矩阵块包围盒宽度约126", 取整 (矩阵块.取包围盒宽度 ()) == 126)
        检查 ("矩阵块加入画布", 画布对象.加入形状 (矩阵块))

        变量 进度环 <类型 = ThorVG形状>
        进度环.创建 ()
        进度环.追加圆 (400, 740, 55)
        进度环.描边宽度 (12)
        进度环.描边颜色 (120, 240, 200)
        进度环.描边端点 (1)
        检查 ("路径裁剪 0~70%", 进度环.路径裁剪 (0.0, 0.7))
        检查 ("进度环加入画布", 画布对象.加入形状 (进度环))
    }

    方法 测试图片 <公开>
    {
        变量 内容 <类型 = 文本型>
        内容 = "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'>"
        内容 = 内容 + "<rect x='4' y='4' width='112' height='112' rx='18' fill='#2f6feb'/>"
        内容 = 内容 + "<circle cx='60' cy='46' r='22' fill='#ffd75e'/>"
        内容 = 内容 + "<path d='M28 96 L60 62 L92 96 Z' fill='#ffffff' opacity='0.9'/>"
        内容 = 内容 + "</svg>"

        演示图片.创建 ()
        检查 ("由SVG数据加载", 演示图片.加载数据 (文本到UTF8 (内容), "svg"))
        检查 ("图片原始宽度为120", 取整 (演示图片.原始宽度) == 120)
        检查 ("图片原始高度为120", 取整 (演示图片.原始高度) == 120)
        检查 ("图片平移", 演示图片.平移 (560, 700))
        检查 ("图片加入画布", 画布对象.加入图片 (演示图片))

        变量 盒 <类型 = 字节集类>
        盒 = 演示图片.取包围盒 ()
        如果 (取字节集长度 (盒) >= 16)
        {
            写报告 ("  图片包围盒: " + 到文本 (取整 (取字节集单精度小数 (盒, 0))) + "," + 到文本 (取整 (取字节集单精度小数 (盒, 4))) + " " + 到文本 (取整 (取字节集单精度小数 (盒, 8))) + "x" + 到文本 (取整 (取字节集单精度小数 (盒, 12))))
        }

        写报告 ("  (动画与磁盘图片加载 API 已提供, 自测未覆盖: ThorVG动画 / ThorVG图片.加载文件)")
    }

    # ================= 报告辅助 =================

    方法 画标题 <公开 注释 = "在画布上绘制一行标题文本。">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 内容 <类型 = 文本型>
    {
        变量 对象 <类型 = ThorVG文本>
        如果 (对象.创建 () == 假)
        {
            返回 ()
        }
        对象.设置字体 ("simhei")
        对象.设置内容 (内容)
        对象.设置字号 (26)
        对象.设置颜色 (255, 255, 255)
        对象.平移 (横坐标, 纵坐标)
        画布对象.加入文本 (对象)
    }

    方法 写报告 <公开 注释 = "向报告文本追加一行。">
    参数 行 <类型 = 文本型>
    {
        报告文本 = 报告文本 + 行 + "\r\n"
    }

    方法 检查 <公开 类型 = 逻辑型 注释 = "记录一项断言。">
    参数 名称 <类型 = 文本型>
    参数 结果 <类型 = 逻辑型>
    {
        检查数 = 检查数 + 1
        如果 (结果)
        {
            写报告 ("[通过] " + 名称)
        }
        否则
        {
            失败数 = 失败数 + 1
            写报告 ("[失败] " + 名称)
        }
        返回 (结果)
    }
}
