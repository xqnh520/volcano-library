        卡1注.设置文字色 (ThorVG颜色.取颜色 (150, 162, 182))
        卡1注.添加到 (卡1)

        变量 卡2 <类型 = ThorVG控件>
        卡2 = 添加卡片 ("card2", "", 0.0, 0.0, 280.0, 140.0)
        卡2.添加到 (网格)

        变量 卡2标 <类型 = ThorVG控件>
        卡2标 = 添加标签 ("card2t", "绘制对象", 14.0, 12.0, 240.0, 22.0)
        卡2标.设置字号 (13.0)
        卡2标.添加到 (卡2)

        变量 卡2条 <类型 = ThorVG控件>
        卡2条 = 添加进度条 ("card2p", "", 14.0, 42.0, 250.0, 8.0)
        卡2条.设置范围 (0.0, 100.0, 0.0)
        卡2条.设置值 (64.0)
        卡2条.添加到 (卡2)

        变量 卡2注 <类型 = ThorVG控件>
        卡2注 = 添加标签 ("card2n", "本帧约 170 个矢量对象", 14.0, 60.0, 250.0, 20.0)
        卡2注.设置字号 (11.0)
        卡2注.设置文字色 (ThorVG颜色.取颜色 (150, 162, 182))
        卡2注.添加到 (卡2)

        变量 卡3 <类型 = ThorVG控件>
        卡3 = 添加卡片 ("card3", "", 0.0, 0.0, 280.0, 140.0)
        卡3.添加到 (网格)

        变量 卡3标 <类型 = ThorVG控件>
        卡3标 = 添加标签 ("card3t", "布局模式", 14.0, 12.0, 240.0, 22.0)
        卡3标.设置字号 (13.0)
        卡3标.添加到 (卡3)

        变量 卡3条 <类型 = ThorVG控件>
        卡3条 = 添加进度条 ("card3p", "", 14.0, 42.0, 250.0, 8.0)
        卡3条.设置范围 (0.0, 100.0, 0.0)
        卡3条.设置值 (80.0)
        卡3条.添加到 (卡3)

        变量 卡3注 <类型 = ThorVG控件>
        卡3注 = 添加标签 ("card3n", "绝对/水平/垂直/网格/叠层", 14.0, 60.0, 250.0, 20.0)
        卡3注.设置字号 (11.0)
        卡3注.设置文字色 (ThorVG颜色.取颜色 (150, 162, 182))
        卡3注.添加到 (卡3)

        变量 卡4 <类型 = ThorVG控件>
        卡4 = 添加卡片 ("card4", "", 0.0, 0.0, 280.0, 140.0)
        卡4.添加到 (网格)

        变量 卡4标 <类型 = ThorVG控件>
        卡4标 = 添加标签 ("card4t", "事件分发", 14.0, 12.0, 240.0, 22.0)
        卡4标.设置字号 (13.0)
        卡4标.添加到 (卡4)

        变量 卡4条 <类型 = ThorVG控件>
        卡4条 = 添加进度条 ("card4p", "", 14.0, 42.0, 250.0, 8.0)
        卡4条.设置范围 (0.0, 100.0, 0.0)
        卡4条.设置值 (100.0)
        卡4条.添加到 (卡4)

        变量 卡4注 <类型 = ThorVG控件>
        卡4注 = 添加标签 ("card4n", "14 种事件 -> 可覆盖钩子", 14.0, 60.0, 250.0, 20.0)
        卡4注.设置字号 (11.0)
        卡4注.设置文字色 (ThorVG颜色.取颜色 (150, 162, 182))
        卡4注.添加到 (卡4)

        变量 分组 <类型 = ThorVG控件>
        分组 = 添加分组框 ("grp", "水平流水布局", 16.0, 448.0, 588.0, 92.0)
        分组.设置布局 (1, 10.0, 10.0)
        分组.添加到 (页3)

        变量 流1 <类型 = ThorVG控件>
        流1 = 添加按钮 ("flow1", "按内容", 0.0, 0.0, 0.0, 0.0)
        流1.添加到 (分组)

        变量 流2 <类型 = ThorVG控件>
        流2 = 添加按钮 ("flow2", "自动", 0.0, 0.0, 0.0, 0.0)
        流2.添加到 (分组)

        变量 流3 <类型 = ThorVG控件>
        流3 = 添加按钮 ("flow3", "排布", 0.0, 0.0, 0.0, 0.0)
        流3.添加到 (分组)

        变量 流4 <类型 = ThorVG控件>
        流4 = 添加按钮 ("flow4", "按权重伸展", 0.0, 0.0, 0.0, 0.0)
        流4.设置权重 (1.0)
        流4.添加到 (分组)

        // ---------------- 右栏 卡片 ----------------
        变量 右卡 <类型 = ThorVG控件>
        右卡 = 添加卡片 ("rightCard", "", 890.0, 70.0, 278.0, 778.0)

        变量 右标题 <类型 = ThorVG控件>
        右标题 = 添加标签 ("rcTitle", "界面工具库", 16.0, 14.0, 240.0, 26.0)
        右标题.设置字号 (16.0)
        右标题.添加到 (右卡)

        变量 图片 <类型 = ThorVG控件>
        图片 = 添加图片 ("hero", "", 16.0, 46.0, 246.0, 110.0)
        图片.添加到 (右卡)

        变量 分隔3 <类型 = ThorVG控件>
        分隔3 = 添加分隔线 ("rcSep", "", 16.0, 170.0, 246.0, 1.0)
        分隔3.添加到 (右卡)

        备注 = 添加多行文本 ("note", "", 16.0, 182.0, 238.0, 330.0)
        备注.添加到 (右卡)

        变量 状态标题 <类型 = ThorVG控件>
        状态标题 = 添加标签 ("rcSt", "运行状态", 16.0, 528.0, 240.0, 20.0)
        状态标题.设置字号 (12.0)
        状态标题.设置文字色 (ThorVG颜色.取颜色 (150, 162, 182))
        状态标题.添加到 (右卡)

        状态标签3 = 添加标签 ("rcStatus", "等待交互", 16.0, 552.0, 246.0, 22.0)
        状态标签3.设置文字色 (ThorVG颜色.取颜色 (76, 141, 255))
        状态标签3.添加到 (右卡)

        进度2 = 添加进度条 ("rcBar", "", 16.0, 582.0, 246.0, 8.0)
        进度2.设置范围 (0.0, 100.0, 0.0)
        进度2.设置值 (35.0)
        进度2.添加到 (右卡)

        变量 输入测试按钮 <类型 = ThorVG控件>
        输入测试按钮 = 添加按钮 ("testInput", "模拟键入测试", 16.0, 608.0, 246.0, 34.0)
        输入测试按钮.添加到 (右卡)

        变量 遍历按钮 <类型 = ThorVG控件>
        遍历按钮 = 添加按钮 ("countAll", "统计控件数", 16.0, 650.0, 246.0, 34.0)
        遍历按钮.添加到 (右卡)

        变量 底注 <类型 = ThorVG控件>
        底注 = 添加标签 ("rcFoot", "全部图形由 ThorVG 矢量绘制", 16.0, 730.0, 246.0, 20.0)
        底注.设置字号 (10.0)
        底注.设置文字色 (ThorVG颜色.取颜色 (110, 124, 146))
        底注.添加到 (右卡)

        // 图片: 用 SVG 生成渐变头图
        变量 图形 <类型 = 文本型>
        图形 = "<svg xmlns='http://www.w3.org/2000/svg' width='246' height='110' viewBox='0 0 246 110'>"
        图形 = 图形 + "<defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>"
        图形 = 图形 + "<stop offset='0' stop-color='#4C8DFF'/><stop offset='0.55' stop-color='#7C5CFF'/><stop offset='1' stop-color='#C04CF0'/>"
        图形 = 图形 + "</linearGradient></defs>"
        图形 = 图形 + "<rect width='246' height='110' rx='10' fill='url(#g)'/>"
        图形 = 图形 + "<circle cx='196' cy='26' r='34' fill='#FFFFFF' opacity='0.16'/>"
        图形 = 图形 + "<circle cx='36' cy='92' r='26' fill='#FFFFFF' opacity='0.12'/>"
        图形 = 图形 + "<path d='M20 66 L46 40 L72 66 Z' fill='#FFFFFF' opacity='0.85'/>"
        图形 = 图形 + "<rect x='86' y='42' width='52' height='26' rx='6' fill='#FFFFFF' opacity='0.9'/>"
        图形 = 图形 + "<circle cx='164' cy='55' r='13' fill='#FFFFFF' opacity='0.75'/>"
        图形 = 图形 + "</svg>"
        图片.设置图片数据 (文本到UTF8 (图形), "svg")

        // 说明文字
        变量 说明 <类型 = 文本型>
        说明 = "本界面完全由 ThorVG 矢量路径绘制, 不依赖任何 MFC 控件。"
        说明 = 说明 + "\r\n\r\n"
        说明 = 说明 + "【控件】面板、卡片、分组框、标签、按钮、复选框、单选框、开关、滑块、进度条、输入框、多行文本、下拉框、列表、表格、标签页、分隔线、滚动条、图片、链接、徽标、菜单、数值框。"
        说明 = 说明 + "\r\n\r\n"
        说明 = 说明 + "【布局】绝对定位、水平流水、垂直流水、网格、叠层; 支持权重伸展、内边距、外边距与内容自适应尺寸。"
        说明 = 说明 + "\r\n\r\n"
        说明 = 说明 + "【交互】最内层命中测试、悬停/按下/焦点/选中状态机、弹出层、拖动滑块、滚动容器、键盘焦点链。"
        说明 = 说明 + "\r\n\r\n"
        说明 = 说明 + "全部交互事件通过可覆盖的钩子方法回调到火山代码。"
        备注.设置文本 (说明)

        返回 (真)
    }

    // ---------------- 交互钩子 ----------------

    方法 控件被单击 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理单击。">
    参数 控件名 <类型 = 文本型>
    {
        如果 (控件名 == "apply")
        {
            变量 新值 <类型 = 小数>
            新值 = 进度.取值 () + 8.0
            如果 (新值 > 100.0)
            {
                新值 = 100.0
            }
            进度.设置值 (新值)
            进度2.设置值 (新值)
            状态标签2.设置文本 ("已应用设置, 进度 " + 到文本 (取整 (新值)) + "%")
            状态标签3.设置文本 ("应用设置")
        }
        否则 (控件名 == "reset")
        {
            滑块.设置值 (0.0)
            进度.设置值 (0.0)
            进度2.设置值 (0.0)
            数值框.设置值 (1.0)
            状态标签2.设置文本 ("已重置全部数值")
            状态标签3.设置文本 ("重置完成")
        }
        否则 (控件名 == "about")
        {
            状态标签3.设置文本 ("ThorVG UI Toolkit v2.0")
            状态标签2.设置文本 ("23 种控件 / 5 种布局 / 14 种事件")
        }
        否则 (控件名 == "testInput")
        {
            设置焦点 (输入框)
            输入框.设置文本 ("")
            输入字符 (72)
            输入字符 (101)
            输入字符 (108)
            输入字符 (108)
            输入字符 (111)
            状态标签3.设置文本 ("模拟键入 Hello")
            状态标签2.设置文本 ("输入框内容: " + 输入框.取文本 ())
        }
        否则 (控件名 == "countAll")
        {
            变量 总数 <类型 = 整数>
            总数 = 控件数 ()
            状态标签3.设置文本 ("共 " + 到文本 (总数) + " 个控件")
            状态标签2.设置文本 ("控件总数: " + 到文本 (总数))
        }
        否则 (控件名 == "help")
        {
            状态标签2.设置文本 ("提示: 点击左侧导航切换页面")
        }
        返回 (0)
    }

    方法 控件值改变 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理数值改变。">
    参数 控件名 <类型 = 文本型>
    参数 新值 <类型 = 小数>
    {
        如果 (控件名 == "vol")
        {
            进度.设置值 (新值)
            进度2.设置值 (新值)
            状态标签2.设置文本 ("音量 " + 到文本 (取整 (新值)))
            状态标签3.设置文本 ("滑块 = " + 到文本 (取整 (新值)))
        }
        否则 (控件名 == "qty")
        {
            状态标签2.设置文本 ("数量 " + 到文本 (取整 (新值)))
        }
        返回 (0)
    }

    方法 控件勾选改变 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理勾选改变。">
    参数 控件名 <类型 = 文本型>
    参数 勾选 <类型 = 逻辑型>
    {
        如果 (控件名 == "night")
        {
            如果 (勾选)
            {
                状态标签3.设置文本 ("夜间模式 开")
            }
            否则
            {
                状态标签3.设置文本 ("夜间模式 关")
            }
        }
        否则 (控件名 == "chk1")
        {
            如果 (勾选)
            {
                状态标签3.设置文本 ("实时刷新 开")
            }
            否则
            {
                状态标签3.设置文本 ("实时刷新 关")
            }
        }
        返回 (0)
    }

    方法 控件项被单击 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理列表/表格/菜单项点击。">
    参数 控件名 <类型 = 文本型>
    参数 索引 <类型 = 整数>
    参数 列 <类型 = 整数>
    {
        如果 (控件名 == "nav")
        {
            标签页.选中 (索引)
            状态标签.设置文本 ("导航: 第 " + 到文本 (索引 + 1) + " 页")
            状态标签3.设置文本 ("切换到第 " + 到文本 (索引 + 1) + " 页")
        }
        否则 (控件名 == "tbl")
        {
            状态标签3.设置文本 ("表格选中第 " + 到文本 (索引 + 1) + " 行")
            状态标签2.设置文本 ("选中表格行索引 " + 到文本 (索引))
        }
        否则 (控件名 == "themeMenu")
        {
            设置主题 (索引)
            如果 (索引 == 0)
            {
                状态标签3.设置文本 ("主题: 深色")
            }
            否则 (索引 == 1)
            {
                状态标签3.设置文本 ("主题: 浅色")
            }
            否则 (索引 == 2)
            {
                状态标签3.设置文本 ("主题: 蓝色")
            }
            否则
            {
                状态标签3.设置文本 ("主题: 高对比")
            }
        }
        返回 (0)
    }

    方法 控件选中改变 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理选中项改变。">
    参数 控件名 <类型 = 文本型>
    参数 索引 <类型 = 整数>
    {
        如果 (控件名 == "combo")
        {
            状态标签2.设置文本 ("城市: " + 城市框.取项目 (索引))
        }
        否则 (控件名 == "dataList")
        {
            状态标签2.设置文本 ("选中对象索引 " + 到文本 (索引))
        }
        返回 (0)
    }

    方法 标签页被切换 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理标签页切换。">
    参数 控件名 <类型 = 文本型>
    参数 索引 <类型 = 整数>
    {
        如果 (控件名 == "tabs")
        {
            导航.选中 (索引)
            状态标签3.设置文本 ("标签页 " + 到文本 (索引 + 1))
        }
        返回 (0)
    }

    方法 文本被修改 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理输入框文本改变。">
    参数 控件名 <类型 = 文本型>
    参数 新文本 <类型 = 文本型>
    {
        如果 (控件名 == "edit")
        {
            状态标签2.设置文本 ("输入: " + 新文本)
        }
        返回 (0)
    }

    方法 容器被滚动 <公开 @虚拟方法 = 可覆盖 类型 = 整数 注释 = "处理滚动。">
    参数 控件名 <类型 = 文本型>
    参数 偏移 <类型 = 小数>
    {
        返回 (0)
    }
}

// ================ 主窗口 ================

类 我的主窗口 <公开 基础类 = 窗口 注释 = "承载自绘界面的窗口。" @视窗.布局 = "client_size = \"1180, 860\"" 标题 = "ThorVGUIDemo">
{
    变量 画板1 <类型 = 画板 @视窗.布局 = "id = 100\r\npos = \"0, 0, 1180, 860\"">
    变量 画布 <类型 = ThorVG画布>
    变量 界面 <类型 = 演示界面>
    变量 已就绪 <类型 = 逻辑型>
    变量 界面位图 <类型 = 字节集类>
    变量 缓存位图 <类型 = 位图对象类>

    方法 我的主窗口_创建完毕 <接收事件 类型 = 整数 注释 = "窗口创建完毕: 开启整窗双缓冲, 避免画板刷新时闪烁。">
    参数 来源对象 <类型 = 我的主窗口>
    参数 标记值 <类型 = 整数>
    {
        // WS_EX_COMPOSITED(0x02000000): 让系统对整个窗口做双缓冲, 子控件重绘不再闪烁
        变量 窗口句柄 <类型 = 变整数>
        窗口句柄 = 取窗口句柄 ()
        @ ::SetWindowLongPtrW((HWND)@<窗口句柄>, -20, ::GetWindowLongPtrW((HWND)@<窗口句柄>, -20) | 0x02000000L);
        画板1.自动重画 = 真
        如果 (已就绪 == 假)
        {
            ThorVG引擎.初始化 ()
            ThorVG文本.载入字体文件 ("C:/Windows/Fonts/simhei.ttf")
            画布.创建 (1180, 860, 1)
            如果 (界面.搭建 ())
            {
                已就绪 = 真
                刷新界面 ()
            }
        }
        返回 (0)
    }

    方法 我的主窗口_首次激活 <接收事件 类型 = 整数 注释 = "首次显示后初始化并绘制。">
    参数 来源对象 <类型 = 我的主窗口>
    参数 标记值 <类型 = 整数>
    {
        如果 (已就绪)
        {
            返回 (0)
        }
        ThorVG引擎.初始化 ()
            ThorVG文本.载入字体文件 ("C:/Windows/Fonts/simhei.ttf")
        画布.创建 (1180, 860, 1)
        如果 (界面.搭建 () == 假)
        {
            返回 (0)
        }
        已就绪 = 真
        刷新界面 ()
        返回 (0)
    }

    方法 刷新界面 <公开 类型 = 逻辑型 注释 = "渲染到画布, 再把整幅位图直接覆盖到画板(不先擦背景, 一步完成不闪烁)。">
    {
        如果 (已就绪 == 假)
        {
            返回 (假)
        }
        界面.布局 ()
        画布.填满颜色 (18, 23, 31, 255)
        界面.绘制 (画布)
        画布.刷新 ()
        画布.绘制 ()
        界面位图 = 画布.取位图数据 ()
        如果 (取字节集长度 (界面位图) <= 0)
        {
            返回 (假)
        }
        缓存位图 = 位图对象类.载入位图数据 (界面位图)
        如果 (缓存位图.为空 ())
        {
            返回 (假)
        }
        画板1.画图片 (缓存位图, 0, 0, 画板1.取用户区宽度 (), 画板1.取用户区高度 ())
        返回 (真)
    }

    方法 换算横 <公开 类型 = 小数 注释 = "像素坐标换算为逻辑坐标。">
    参数 像素 <类型 = 整数>
    {
        变量 宽 <类型 = 整数>
        宽 = 画板1.取用户区宽度 ()
        如果 (宽 <= 0)
        {
            返回 (0.0)
        }
        返回 (像素 * 1180.0 / 宽)
    }

    方法 换算纵 <公开 类型 = 小数 注释 = "像素坐标换算为逻辑坐标。">
    参数 像素 <类型 = 整数>
    {
        变量 高 <类型 = 整数>
        高 = 画板1.取用户区高度 ()
        如果 (高 <= 0)
        {
            返回 (0.0)
        }
        返回 (像素 * 860.0 / 高)
    }

    方法 画板_鼠标位置被移动 <接收事件 类型 = 整数 注释 = "转发鼠标移动。">
    参数 来源对象 <类型 = 画板>
    参数 标记值 <类型 = 整数>
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    参数 功能键状态 <类型 = 整数>
    {
        如果 (已就绪)
        {
            界面.鼠标移动 (换算横 (横坐标), 换算纵 (纵坐标))
            界面.处理事件 ()
            如果 (界面.取脏标记 ())
            {
                刷新界面 ()
            }
        }
        返回 (0)
    }

    方法 画板_鼠标左键被按下 <接收事件 类型 = 整数 注释 = "转发鼠标按下。">
