<火山程序 类型 = "通常" 版本 = 1 />

包 火山.ThorVG <注释 = "ThorVG 自绘界面工具库: 在 ThorVG 画布之上提供控件树、布局、命中测试、主题样式与事件分发。"
        注释 = "用法: 继承 ThorVG界面 得到自己的界面类 -> 创建() 添加控件 -> 每帧 布局() + 绘制(画布) -> 转发鼠标键盘 -> 处理事件() 触发可覆盖的钩子。"
        注释 = "坐标单位为逻辑像素, 原点在左上角; 颜色用 0xAARRGGBB 整数表示。"
        "@视窗.外部头文件.全局-100" = "thorvg_bridge.hpp"
        "@视窗.外部头文件.全局-101" = "ui_bridge.hpp">


类 ThorVG颜色 <公开 注释 = "颜色工具。界面库的颜色一律用 0xAARRGGBB 整数表示。">
{
    方法 取颜色 <公开 静态 类型 = 整数 注释 = "由红/绿/蓝/透明度合成颜色整数, 透明度默认不透明。">
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    参数 透明度 <类型 = 整数 @默认值 = 255>
    {
        变量 结果 <类型 = 整数>
        @ @<结果> = (int)(((unsigned)@<透明度> << 24) | ((unsigned)@<红> << 16) | ((unsigned)@<绿> << 8) | (unsigned)@<蓝>);
        返回 (结果)
    }

    方法 取透明度 <公开 静态 类型 = 整数 注释 = "取颜色整数中的透明度分量(0-255)。">
    参数 颜色 <类型 = 整数>
    {
        变量 结果 <类型 = 整数>
        @ @<结果> = (int)(((unsigned)@<颜色> >> 24) & 0xFF);
        返回 (结果)
    }
}

类 ThorVG界面事件 <公开 注释 = "手动轮询时使用的事件对象。">
{
    变量 类型 <公开 类型 = 整数 注释 = "0 单击 1 值改变 2 文本改变 3 鼠标进入 4 鼠标离开 5 获得焦点 6 失去焦点 7 勾选改变 8 滚动 9 选中项改变 10 项被单击 11 标签页切换 12 弹出层关闭 13 项双击; -1 无事件">
    变量 控件名 <公开 类型 = 文本型>
    变量 目标标识 <公开 类型 = 整数 注释 = "事件来源控件的内部标识。">
    变量 数值 <公开 类型 = 小数>
    变量 标志 <公开 类型 = 整数>
    变量 文本 <公开 类型 = 文本型>
}

类 ThorVG控件 <公开 注释 = "界面控件句柄。属性设置立即生效, 下一次 布局/绘制 时体现。">
{
    变量 界面指针 <公开 类型 = 变整数 注释 = "所属界面上下文, 请勿手工修改。">
    变量 控件标识 <公开 类型 = 整数 注释 = "控件内部标识, 请勿手工修改。">

    方法 已有效 <公开 类型 = 逻辑型 注释 = "控件是否仍存在。">
    {
        变量 上下文 <类型 = 变整数>
        变量 标识 <类型 = 整数>
        变量 结果 <类型 = 逻辑型>
        上下文 = 界面指针
        标识 = 控件标识
        @ @<结果> = @<上下文> != 0 && @<标识> > 0;
        返回 (结果)
    }

    方法 设置文本 <公开 类型 = 逻辑型 注释 = "设置控件文本。">
    参数 新文本 <类型 = 文本型>
    {
        变量 上下文 <类型 = 变整数>
        变量 标识 <类型 = 整数>
        上下文 = 界面指针
        标识 = 控件标识
        变量 数据1 <类型 = 字节集类>
        变量 结果 <类型 = 逻辑型>
        数据1 = 文本到UTF8 (新文本)
        @ @<结果> = uiw_set_text((void*)@<上下文>, @<标识>, (const char*)@<数据1>.GetPtr());
        返回 (结果)
    }

    方法 设置值 <公开 类型 = 逻辑型 注释 = "设置滑块/进度条/数值框的值。">
    参数 值 <类型 = 小数>
    {
        变量 上下文 <类型 = 变整数>
        变量 标识 <类型 = 整数>
        上下文 = 界面指针
        标识 = 控件标识
        变量 结果 <类型 = 逻辑型>
        @ @<结果> = uiw_set_value((void*)@<上下文>, @<标识>, (float)@<值>);
        返回 (结果)
    }

    方法 取值 <公开 类型 = 小数 注释 = "取当前值。">
    {
        变量 上下文 <类型 = 变整数>
        变量 标识 <类型 = 整数>
        上下文 = 界面指针
        标识 = 控件标识
        变量 结果 <类型 = 小数>
        @ @<结果> = uiw_get_value((void*)@<上下文>, @<标识>);
        返回 (结果)
    }

    方法 设置范围 <公开 类型 = 逻辑型 注释 = "设置取值范围与步长(步长 0 表示连续)。">
    参数 最小值 <类型 = 小数>
    参数 最大值 <类型 = 小数>
    参数 步长 <类型 = 小数>
    {
        变量 上下文 <类型 = 变整数>
        变量 标识 <类型 = 整数>
        上下文 = 界面指针
        标识 = 控件标识
        变量 结果 <类型 = 逻辑型>
        @ @<结果> = uiw_set_range((void*)@<上下文>, @<标识>, (float)@<最小值>, (float)@<最大值>, (float)@<步长>);
        返回 (结果)
    }

    方法 设置勾选 <公开 类型 = 逻辑型 注释 = "设置复选框/单选框/开关的勾选状态。">
    参数 勾选 <类型 = 逻辑型>
    {
        变量 上下文 <类型 = 变整数>
        变量 标识 <类型 = 整数>
        上下文 = 界面指针
        标识 = 控件标识
        变量 结果 <类型 = 逻辑型>
        @ @<结果> = uiw_set_checked((void*)@<上下文>, @<标识>, @<勾选> ? 1 : 0);
        返回 (结果)
    }

    方法 勾选 <公开 类型 = 逻辑型 注释 = "是否处于勾选状态。">
    {
        变量 上下文 <类型 = 变整数>
