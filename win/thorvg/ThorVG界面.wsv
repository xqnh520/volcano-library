        父标识 = 父控件.控件标识
        @ @<结果> = uiw_set_parent((void*)@<上下文>, @<标识>, @<父标识>) == 0;
        返回 (结果)
    }
}

类 ThorVG界面 <公开 注释 = "自绘界面上下文。继承本类并覆盖钩子方法即可处理交互。">
{
    变量 上下文句柄 <公开 类型 = 变整数 注释 = "原生上下文指针, 请勿手工修改。">

    方法 销毁 <公开 注释 = "释放界面及其全部控件。">
    {
        变量 上下文 <类型 = 变整数>
        上下文 = 上下文句柄
        上下文句柄 = 0
        @ uiw_free((void*)@<上下文>);
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "界面是否已创建。">
    {
        变量 上下文 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        上下文 = 上下文句柄
        @ @<结果> = @<上下文> != 0;
        返回 (结果)
    }

    方法 设置主题 <公开 类型 = 逻辑型 注释 = "设置主题: 0 深色 1 浅色 2 蓝色 3 高对比。">
    参数 主题 <类型 = 整数>
    {
        变量 上下文 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        上下文 = 上下文句柄
        @ @<结果> = uiw_set_theme((void*)@<上下文>, @<主题>);
        返回 (结果)
    }

    方法 设置字体 <公开 类型 = 逻辑型 注释 = "设置字体名(需先用 ThorVG文本.载入字体文件 注册)。">
    参数 字体名 <类型 = 文本型>
    {
        变量 上下文 <类型 = 变整数>
        变量 数据1 <类型 = 字节集类>
        变量 结果 <类型 = 逻辑型>
        上下文 = 上下文句柄
        数据1 = 文本到UTF8 (字体名)
        @ @<结果> = uiw_set_font((void*)@<上下文>, (const char*)@<数据1>.GetPtr());
        返回 (结果)
    }

