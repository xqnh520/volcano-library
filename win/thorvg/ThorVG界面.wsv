        变量 名称数据 <类型 = 字节集类>
        变量 文本数据 <类型 = 字节集类>
        变量 结果 <类型 = ThorVG控件>
        上下文 = 上下文句柄
        名称数据 = 文本到UTF8 (名称)
        文本数据 = 文本到UTF8 (文本)
        @ @<标识> = uiw_add((void*)@<上下文>, @<种类>, (const char*)@<名称数据>.GetPtr(), (const char*)@<文本数据>.GetPtr(), (float)@<左>, (float)@<顶>, (float)@<宽>, (float)@<高>);
        结果.界面指针 = 上下文
        结果.控件标识 = 标识
        返回 (结果)
    }

