        变量 缓冲 <类型 = 字节集类>
        变量 宽 <类型 = 小数>
        上下文 = 上下文句柄
        数据 = 文本到UTF8 (文本)
        缓冲 = 取空白字节集 (8)
        @ uiw_measure_text((void*)@<上下文>, (const char*)@<数据>.GetPtr(), (float)@<字号>, (float*)@<缓冲>.GetPtr());
        @ @<宽> = *(float*)@<缓冲>.GetPtr();
        返回 (宽)
    }

    方法 取事件 <公开 类型 = ThorVG界面事件 注释 = "取出一个待处理事件, 无事件时返回类型为 -1 的对象。">
    {
        变量 上下文 <类型 = 变整数>
        变量 结果 <类型 = ThorVG界面事件>
        变量 名称缓冲 <类型 = 字节集类>
        变量 文本缓冲 <类型 = 字节集类>
        变量 名称长度 <类型 = 整数>
        变量 文本长度 <类型 = 整数>
        变量 事件类型 <类型 = 整数>
        变量 事件标识 <类型 = 整数>
        变量 事件数值 <类型 = 小数>
        变量 事件标志 <类型 = 整数>
        上下文 = 上下文句柄
        结果.类型 = -1
        如果 (上下文 == 0)
        {
            返回 (结果)
        }
        变量 有无 <类型 = 逻辑型>
        @ @<有无> = uiw_ev_next((void*)@<上下文>) != 0;
        如果 (有无 == 假)
        {
            返回 (结果)
        }
        @ @<事件类型> = uiw_ev_kind((void*)@<上下文>);
        @ @<事件标识> = uiw_ev_id((void*)@<上下文>);
        @ @<事件数值> = uiw_ev_value((void*)@<上下文>);
        @ @<事件标志> = uiw_ev_flag((void*)@<上下文>);
        结果.类型 = 事件类型
        结果.目标标识 = 事件标识
        结果.数值 = 事件数值
        结果.标志 = 事件标志
        名称缓冲 = 取空白字节集 (64)
        文本缓冲 = 取空白字节集 (512)
        @ @<名称长度> = uiw_ev_name((void*)@<上下文>, (char*)@<名称缓冲>.GetPtr(), 64);
        @ @<文本长度> = uiw_ev_text((void*)@<上下文>, (char*)@<文本缓冲>.GetPtr(), 512);
        如果 (名称长度 > 0)
        {
            结果.控件名 = UTF8到文本 (取字节集左边 (名称缓冲, 名称长度))
        }
        如果 (文本长度 > 0)
        {
            结果.文本 = UTF8到文本 (取字节集左边 (文本缓冲, 文本长度))
        }
        返回 (结果)
    }

    方法 处理事件 <公开 类型 = 整数 注释 = "把队列里的事件逐条分派给可覆盖的钩子方法, 返回处理条数。">
    {
        变量 上下文 <类型 = 变整数>
        变量 继续 <类型 = 逻辑型>
        变量 种类 <类型 = 整数>
        变量 数值 <类型 = 小数>
        变量 标志 <类型 = 整数>
        变量 名称缓冲 <类型 = 字节集类>
        变量 文本缓冲 <类型 = 字节集类>
        变量 名称长度 <类型 = 整数>
        变量 文本长度 <类型 = 整数>
        变量 名称 <类型 = 文本型>
        变量 文本 <类型 = 文本型>
        变量 处理数 <类型 = 整数>
        上下文 = 上下文句柄
        如果 (上下文 == 0)
        {
            返回 (0)
        }
        继续 = 真
        判断循环 (继续)
        {
            @ @<继续> = uiw_ev_next((void*)@<上下文>) != 0;
            如果 (继续)
            {
                @ @<种类> = uiw_ev_kind((void*)@<上下文>);
                @ @<数值> = uiw_ev_value((void*)@<上下文>);
                @ @<标志> = uiw_ev_flag((void*)@<上下文>);
                名称缓冲 = 取空白字节集 (64)
                文本缓冲 = 取空白字节集 (512)
                @ @<名称长度> = uiw_ev_name((void*)@<上下文>, (char*)@<名称缓冲>.GetPtr(), 64);
                @ @<文本长度> = uiw_ev_text((void*)@<上下文>, (char*)@<文本缓冲>.GetPtr(), 512);
                名称 = ""
                文本 = ""
                如果 (名称长度 > 0)
                {
                    名称 = UTF8到文本 (取字节集左边 (名称缓冲, 名称长度))
                }
                如果 (文本长度 > 0)
                {
                    文本 = UTF8到文本 (取字节集左边 (文本缓冲, 文本长度))
                }

                如果 (种类 == 0)
                {
                    控件被单击 (名称)
                }
                否则 (种类 == 1)
                {
                    控件值改变 (名称, 数值)
                }
                否则 (种类 == 2)
                {
                    文本被修改 (名称, 文本)
                }
                否则 (种类 == 3)
                {
                    控件鼠标进入 (名称)
                }
                否则 (种类 == 4)
                {
                    控件鼠标离开 (名称)
                }
                否则 (种类 == 5)
                {
                    控件获得焦点 (名称)
                }
                否则 (种类 == 6)
                {
                    控件失去焦点 (名称)
                }
                否则 (种类 == 7)
                {
                    控件勾选改变 (名称, 标志 != 0)
                }
                否则 (种类 == 8)
                {
                    容器被滚动 (名称, 数值)
                }
                否则 (种类 == 9)
                {
                    控件选中改变 (名称, 取整 (数值))
                }
                否则 (种类 == 10)
                {
                    控件项被单击 (名称, 取整 (数值), 标志)
                }
                否则 (种类 == 11)
                {
                    标签页被切换 (名称, 取整 (数值))
                }
                否则 (种类 == 12)
                {
                    弹出层被关闭 (名称)
                }
                否则 (种类 == 13)
                {
                    控件项被双击 (名称, 取整 (数值), 标志)
                }
                处理数 = 处理数 + 1
            }
        }
        返回 (处理数)
    }

    方法 添加面板 <公开 类型 = ThorVG控件 注释 = "面板控件。">
    参数 名称 <类型 = 文本型>
