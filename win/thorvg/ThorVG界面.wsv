    方法 取文本 <公开 类型 = 文本型 注释 = "取控件文本。">
    {
        变量 上下文 <类型 = 变整数>
        变量 标识 <类型 = 整数>
        变量 缓冲 <类型 = 字节集类>
        变量 长度 <类型 = 整数>
        上下文 = 界面指针
        标识 = 控件标识
        缓冲 = 取空白字节集 (512)
        @ @<长度> = uiw_get_text((void*)@<上下文>, @<标识>, (char*)@<缓冲>.GetPtr(), 512);
        如果 (长度 <= 0)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (取字节集左边 (缓冲, 长度)))
    }

