<火山程序 类型 = "通常" 版本 = 1 />

包 火山.ThorVG <注释 = "ThorVG 复合对象: 场景(可整体变换与加特效的容器)、图片(SVG/PNG/JPG/WebP)、动画(Lottie)与文本(TrueType/OpenType 字体排版)。"
        注释 = "场景与画布一样是「宿主」: 通过 场景.加入xxx 放入的对象归场景所有, 场景销毁时一并销毁。"
        注释 = "注意: ThorVG 一旦用 变换 设定矩阵, 之后的 平移/旋转/缩放 都不再生效; 复合变换请先用 ThorVG矩阵.组合 合成矩阵。"
        "@视窗.外部头文件.全局-100" = "thorvg_bridge.hpp">

类 ThorVG场景 <公开 注释 = "场景容器: 可把多个形状/图片/文本组合在一起, 对整体做平移旋转缩放、透明度、混合与模糊特效。场景本身也是一个绘制对象, 可以再嵌套场景。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "内部场景句柄, 请勿手工修改。">
    变量 已交付 <公开 类型 = 逻辑型 注释 = "是否已交给画布或父场景。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建空场景, 成功返回真。">
    {
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)thorgw_scene_new();
        对象指针 = 新指针
        已交付 = 假
        返回 (新指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁场景及其全部子对象; 已交付给画布的场景会被跳过。可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        旧指针 = 对象指针
        如果 (已交付 == 假)
        {
            @ thorgw_paint_free((void*)@<旧指针>);
        }
        对象指针 = 0
        已交付 = 假
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "场景是否有效。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<ThorVG场景.对象指针> != 0)
    }

    方法 类型 <公开 属性读 类型 = 整数 注释 = "对象类型码(场景为 2); 无效对象返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_paint_type((void*)@sn<this>.@n<ThorVG场景.对象指针>)
    }

    方法 加入形状 <公开 类型 = 逻辑型 注释 = "把形状加入场景。加入后形状归场景所有, 不要再调用形状的 释放。">
    参数 形状 <类型 = ThorVG形状>
    {
        变量 结果 <类型 = 整数>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        @ @<结果> = thorgw_scene_add((void*)@<场景指针>, (void*)@<形状>.@n<ThorVG形状.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        形状.已交付 = 真
        返回 (真)
    }

    方法 加入图片 <公开 类型 = 逻辑型 注释 = "把图片加入场景。加入后图片归场景所有。">
    参数 图片 <类型 = ThorVG图片>
    {
        变量 结果 <类型 = 整数>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        @ @<结果> = thorgw_scene_add((void*)@<场景指针>, (void*)@<图片>.@n<ThorVG图片.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        图片.已交付 = 真
        返回 (真)
    }

    方法 加入文本 <公开 类型 = 逻辑型 注释 = "把文本加入场景。加入后文本归场景所有。">
    参数 文本 <类型 = ThorVG文本>
    {
        变量 结果 <类型 = 整数>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        @ @<结果> = thorgw_scene_add((void*)@<场景指针>, (void*)@<文本>.@n<ThorVG文本.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        文本.已交付 = 真
        返回 (真)
    }

    方法 加入场景 <公开 类型 = 逻辑型 注释 = "把另一个场景作为子场景加入。加入后子场景归本场景所有。">
    参数 子场景 <类型 = ThorVG场景>
    {
        变量 结果 <类型 = 整数>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        @ @<结果> = thorgw_scene_add((void*)@<场景指针>, (void*)@<子场景>.@n<ThorVG场景.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        子场景.已交付 = 真
        返回 (真)
    }

    方法 移除形状 <公开 类型 = 逻辑型 注释 = "从场景移除形状并立即销毁它, 句柄自动清零。">
    参数 形状 <类型 = ThorVG形状>
    {
        变量 结果 <类型 = 整数>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        @ @<结果> = thorgw_scene_remove((void*)@<场景指针>, (void*)@<形状>.@n<ThorVG形状.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        形状.对象指针 = 0
        形状.已交付 = 假
        返回 (真)
    }

    方法 移除图片 <公开 类型 = 逻辑型 注释 = "从场景移除图片并立即销毁它, 句柄自动清零。">
    参数 图片 <类型 = ThorVG图片>
    {
        变量 结果 <类型 = 整数>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        @ @<结果> = thorgw_scene_remove((void*)@<场景指针>, (void*)@<图片>.@n<ThorVG图片.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        图片.对象指针 = 0
        图片.已交付 = 假
        返回 (真)
    }

    方法 移除文本 <公开 类型 = 逻辑型 注释 = "从场景移除文本并立即销毁它, 句柄自动清零。">
    参数 文本 <类型 = ThorVG文本>
    {
        变量 结果 <类型 = 整数>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        @ @<结果> = thorgw_scene_remove((void*)@<场景指针>, (void*)@<文本>.@n<ThorVG文本.对象指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        文本.对象指针 = 0
        文本.已交付 = 假
        返回 (真)
    }

    方法 清空子项 <公开 类型 = 逻辑型 注释 = "移除场景内全部子对象(移出即销毁)。" 折叠 @嵌入式方法 = "">
    {
        @ (thorgw_scene_remove((void*)@sn<this>.@n<ThorVG场景.对象指针>, nullptr) == 0)
    }

    方法 模糊 <公开 类型 = 逻辑型 注释 = "给整个场景加高斯模糊。强度 为模糊半径(大于 0), 方向 0 双向 / 1 水平 / 2 垂直, 边框 为边缘扩展像素, 质量 1~3。" 折叠 @嵌入式方法 = "">
    参数 强度 <类型 = 小数>
    参数 方向 <类型 = 整数 @默认值 = 0>
    参数 边框 <类型 = 整数 @默认值 = 0>
    参数 质量 <类型 = 整数 @默认值 = 1>
    {
        @ (thorgw_scene_blur((void*)@sn<this>.@n<ThorVG场景.对象指针>, (float)@<强度>, @<方向>, @<边框>, @<质量>) == 0)
    }

    方法 清除特效 <公开 类型 = 逻辑型 注释 = "清除场景上的全部特效。" 折叠 @嵌入式方法 = "">
    {
        @ (thorgw_scene_clear_effects((void*)@sn<this>.@n<ThorVG场景.对象指针>) == 0)
    }

    方法 可见 <公开 类型 = 逻辑型 注释 = "设置是否可见。" 折叠 @嵌入式方法 = "">
    参数 状态 <类型 = 逻辑型>
    {
        @ (thorgw_paint_visible((void*)@sn<this>.@n<ThorVG场景.对象指针>, @<状态> ? 1 : 0) == 0)
    }

    方法 透明度 <公开 类型 = 逻辑型 注释 = "设置整体不透明度(0 全透明 ~ 255 不透明)。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (thorgw_paint_opacity((void*)@sn<this>.@n<ThorVG场景.对象指针>, @<值>) == 0)
    }

    方法 平移 <公开 类型 = 逻辑型 注释 = "整体平移。注意: 若已调用 变换 设定矩阵, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ (thorgw_paint_translate((void*)@sn<this>.@n<ThorVG场景.对象指针>, (float)@<横位移>, (float)@<纵位移>) == 0)
    }

    方法 旋转 <公开 类型 = 逻辑型 注释 = "整体绕原点旋转(度, 顺时针为正)。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 角度 <类型 = 小数>
    {
        @ (thorgw_paint_rotate((void*)@sn<this>.@n<ThorVG场景.对象指针>, (float)@<角度>) == 0)
    }

    方法 缩放 <公开 类型 = 逻辑型 注释 = "整体等比缩放。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 比例 <类型 = 小数>
    {
        @ (thorgw_paint_scale((void*)@sn<this>.@n<ThorVG场景.对象指针>, (float)@<比例>) == 0)
    }

    方法 变换 <公开 类型 = 逻辑型 注释 = "应用仿射矩阵(36 字节字节集)。注意: 设定矩阵后 平移/旋转/缩放 将失效。">
    参数 矩阵数据 <类型 = 字节集类>
    {
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_transform((void*)@<场景指针>, (const float*)@<矩阵数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 混合模式 <公开 类型 = 逻辑型 注释 = "设置混合模式(取值同形状的 混合模式)。" 折叠 @嵌入式方法 = "">
    参数 模式 <类型 = 整数>
    {
        @ (thorgw_paint_blend((void*)@sn<this>.@n<ThorVG场景.对象指针>, @<模式>) == 0)
    }

    方法 取包围盒 <公开 类型 = 字节集类 注释 = "返回包围盒(4 个单精度小数: 横坐标/纵坐标/宽/高); 无效对象返回空字节集。">
    {
        变量 数据 <类型 = 字节集类>
        变量 场景指针 <类型 = 变整数>
        场景指针 = 对象指针
        数据 = 取空白字节集 (16)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_bounds((void*)@<场景指针>, (float*)@<数据>.GetPtr());
        如果 (结果 != 0)
        {
            返回 (取空白字节集 (0))
        }
        返回 (数据)
    }
}

类 ThorVG图片 <公开 注释 = "图片对象: 支持 SVG / PNG / JPG / WebP / TVG 格式, 由文件或内存数据加载, 可设置显示尺寸、原点与缩放过滤方式。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "内部图片句柄, 请勿手工修改。">
    变量 已交付 <公开 类型 = 逻辑型 注释 = "是否已交给画布或场景。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建空图片对象, 成功返回真。">
    {
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)thorgw_picture_new();
        对象指针 = 新指针
        已交付 = 假
        返回 (新指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁图片; 已交付给画布/场景的会被跳过。可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        旧指针 = 对象指针
        如果 (已交付 == 假)
        {
            @ thorgw_paint_free((void*)@<旧指针>);
        }
        对象指针 = 0
        已交付 = 假
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "图片对象是否有效。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<ThorVG图片.对象指针> != 0)
    }

    方法 类型 <公开 属性读 类型 = 整数 注释 = "对象类型码(图片为 3); 无效对象返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_paint_type((void*)@sn<this>.@n<ThorVG图片.对象指针>)
    }

    方法 加载文件 <公开 类型 = 逻辑型 注释 = "从磁盘文件加载图片(SVG/PNG/JPG/WebP/TVG)。">
    参数 文件名 <类型 = 文本型>
    {
        变量 路径数据 <类型 = 字节集类>
        变量 图片指针 <类型 = 变整数>
        路径数据 = 文本到UTF8 (文件名)
        图片指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_picture_load((void*)@<图片指针>, (const char*)@<路径数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 加载数据 <公开 类型 = 逻辑型 注释 = "从内存数据加载图片。类型 为 svg / png / jpg / webp / tvg 之一。">
    参数 图片数据 <类型 = 字节集类>
    参数 类型 <类型 = 文本型>
    {
        变量 长度 <类型 = 整数>
        长度 = 取字节集长度 (图片数据)
        如果 (长度 <= 0)
        {
            返回 (假)
        }
        变量 类型数据 <类型 = 字节集类>
        类型数据 = 文本到UTF8 (类型)
        变量 图片指针 <类型 = 变整数>
        图片指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_picture_load_data((void*)@<图片指针>, (const void*)@<图片数据>.GetPtr(), @<长度>, (const char*)@<类型数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 加载像素 <公开 类型 = 逻辑型 注释 = "从原始像素数据加载图片(每像素 4 字节, ARGB8888); 是否复制 为真时内部保留副本。">
    参数 像素数据 <类型 = 字节集类>
    参数 宽 <类型 = 整数>
    参数 高 <类型 = 整数>
    参数 是否复制 <类型 = 逻辑型 @默认值 = 真>
    {
        变量 图片指针 <类型 = 变整数>
        图片指针 = 对象指针
        变量 复制标志 <类型 = 整数>
        复制标志 = 0
        如果 (是否复制)
        {
            复制标志 = 1
        }
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_picture_load_pixels((void*)@<图片指针>, (const void*)@<像素数据>.GetPtr(), @<宽>, @<高>, 1, @<复制标志>);
        返回 (结果 == 0)
    }

    方法 设置尺寸 <公开 类型 = 逻辑型 注释 = "设置图片在画布上的显示尺寸(等比缩放请按原始宽高比换算)。" 折叠 @嵌入式方法 = "">
    参数 宽 <类型 = 小数>
    参数 高 <类型 = 小数>
    {
        @ (thorgw_picture_set_size((void*)@sn<this>.@n<ThorVG图片.对象指针>, (float)@<宽>, (float)@<高>) == 0)
    }

    方法 设置原点 <公开 类型 = 逻辑型 注释 = "设置绘制原点偏移。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ (thorgw_picture_origin((void*)@sn<this>.@n<ThorVG图片.对象指针>, (float)@<横坐标>, (float)@<纵坐标>) == 0)
    }

    方法 过滤方式 <公开 类型 = 逻辑型 注释 = "设置缩放过滤方式: 0 双线性(平滑, 默认), 1 最近邻(锐利)。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ (thorgw_picture_filter((void*)@sn<this>.@n<ThorVG图片.对象指针>, @<方式>) == 0)
    }

    方法 原始宽度 <公开 属性读 类型 = 小数 注释 = "图片原始宽度; 无效对象返回 0。">
    {
        变量 数据 <类型 = 字节集类>
        变量 图片指针 <类型 = 变整数>
        图片指针 = 对象指针
        数据 = 取空白字节集 (8)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_picture_get_size((void*)@<图片指针>, (float*)@<数据>.GetPtr());
        如果 (结果 != 0)
        {
            返回 (0.0)
        }
        返回 (取字节集单精度小数 (数据, 0))
    }

    方法 原始高度 <公开 属性读 类型 = 小数 注释 = "图片原始高度; 无效对象返回 0。">
    {
        变量 数据 <类型 = 字节集类>
        变量 图片指针 <类型 = 变整数>
        图片指针 = 对象指针
        数据 = 取空白字节集 (8)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_picture_get_size((void*)@<图片指针>, (float*)@<数据>.GetPtr());
        如果 (结果 != 0)
        {
            返回 (0.0)
        }
        返回 (取字节集单精度小数 (数据, 4))
    }

    方法 可见 <公开 类型 = 逻辑型 注释 = "设置是否可见。" 折叠 @嵌入式方法 = "">
    参数 状态 <类型 = 逻辑型>
    {
        @ (thorgw_paint_visible((void*)@sn<this>.@n<ThorVG图片.对象指针>, @<状态> ? 1 : 0) == 0)
    }

    方法 透明度 <公开 类型 = 逻辑型 注释 = "设置整体不透明度(0~255)。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (thorgw_paint_opacity((void*)@sn<this>.@n<ThorVG图片.对象指针>, @<值>) == 0)
    }

    方法 平移 <公开 类型 = 逻辑型 注释 = "整体平移。注意: 若已调用 变换 设定矩阵, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ (thorgw_paint_translate((void*)@sn<this>.@n<ThorVG图片.对象指针>, (float)@<横位移>, (float)@<纵位移>) == 0)
    }

    方法 旋转 <公开 类型 = 逻辑型 注释 = "整体旋转(度)。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 角度 <类型 = 小数>
    {
        @ (thorgw_paint_rotate((void*)@sn<this>.@n<ThorVG图片.对象指针>, (float)@<角度>) == 0)
    }

    方法 缩放 <公开 类型 = 逻辑型 注释 = "整体等比缩放。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 比例 <类型 = 小数>
    {
        @ (thorgw_paint_scale((void*)@sn<this>.@n<ThorVG图片.对象指针>, (float)@<比例>) == 0)
    }

    方法 变换 <公开 类型 = 逻辑型 注释 = "应用仿射矩阵(36 字节字节集)。注意: 设定矩阵后 平移/旋转/缩放 将失效。">
    参数 矩阵数据 <类型 = 字节集类>
    {
        变量 图片指针 <类型 = 变整数>
        图片指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_transform((void*)@<图片指针>, (const float*)@<矩阵数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 取包围盒 <公开 类型 = 字节集类 注释 = "返回包围盒(4 个单精度小数); 无效对象返回空字节集。">
    {
        变量 数据 <类型 = 字节集类>
        变量 图片指针 <类型 = 变整数>
        图片指针 = 对象指针
        数据 = 取空白字节集 (16)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_bounds((void*)@<图片指针>, (float*)@<数据>.GetPtr());
        如果 (结果 != 0)
        {
            返回 (取空白字节集 (0))
        }
        返回 (数据)
    }
}

类 ThorVG动画 <公开 注释 = "动画对象(ThorVG 1.1 的「动画 -> 图片」模型): 创建动画后取出它自带的图片, 用图片加载 Lottie 文件, 把图片加入画布, 再用 设置帧 推进画面。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "内部动画句柄, 请勿手工修改。">
    变量 图片对象 <类型 = ThorVG图片 注释 = "动画自带的图片对象; 由动画持有, 只需把它加入画布。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建动画对象并关联其内置图片, 成功返回真。">
    {
        变量 新指针 <类型 = 变整数>
        变量 图片指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)thorgw_animation_new();
        对象指针 = 新指针
        如果 (新指针 == 0)
        {
            返回 (假)
        }
        @ @<图片指针> = (intptr_t)thorgw_animation_picture((void*)@<新指针>);
        图片对象.对象指针 = 图片指针
        图片对象.已交付 = 假
        返回 (图片指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁动画及其内置图片; 若图片已加入画布, 请先释放画布。可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        旧指针 = 对象指针
        图片对象.对象指针 = 0
        @ thorgw_animation_free((void*)@<旧指针>);
        对象指针 = 0
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "动画是否有效。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<ThorVG动画.对象指针> != 0)
    }

    方法 取图片 <公开 类型 = ThorVG图片 注释 = "取动画内置的图片对象(加入画布后即可显示当前帧)。">
    {
        返回 (图片对象)
    }

    方法 加载文件 <公开 类型 = 逻辑型 注释 = "从 Lottie 文件(.json / .lot) 或 TVG 动画文件加载。">
    参数 文件名 <类型 = 文本型>
    {
        变量 路径数据 <类型 = 字节集类>
        变量 动画指针 <类型 = 变整数>
        路径数据 = 文本到UTF8 (文件名)
        动画指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_animation_load((void*)@<动画指针>, (const char*)@<路径数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 加载数据 <公开 类型 = 逻辑型 注释 = "从内存数据加载动画。类型 为 json / lot / tvg。">
    参数 动画数据 <类型 = 字节集类>
    参数 类型 <类型 = 文本型>
    {
        变量 长度 <类型 = 整数>
        长度 = 取字节集长度 (动画数据)
        如果 (长度 <= 0)
        {
            返回 (假)
        }
        变量 类型数据 <类型 = 字节集类>
        类型数据 = 文本到UTF8 (类型)
        变量 动画指针 <类型 = 变整数>
        动画指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_animation_load_data((void*)@<动画指针>, (const void*)@<动画数据>.GetPtr(), @<长度>, (const char*)@<类型数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 总帧数 <公开 属性读 类型 = 小数 注释 = "动画总帧数; 无效对象返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_animation_total_frame((void*)@sn<this>.@n<ThorVG动画.对象指针>)
    }

    方法 时长 <公开 属性读 类型 = 小数 注释 = "动画总时长(秒); 无效对象返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_animation_duration((void*)@sn<this>.@n<ThorVG动画.对象指针>)
    }

    方法 当前帧 <公开 属性读 类型 = 小数 注释 = "当前帧号; 无效对象返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_animation_cur_frame((void*)@sn<this>.@n<ThorVG动画.对象指针>)
    }

    方法 设置帧 <公开 类型 = 逻辑型 注释 = "跳转到指定帧(可为小数, 支持插值)。" 折叠 @嵌入式方法 = "">
    参数 帧号 <类型 = 小数>
    {
        @ (thorgw_animation_set_frame((void*)@sn<this>.@n<ThorVG动画.对象指针>, (float)@<帧号>) == 0)
    }

    方法 设置片段 <公开 类型 = 逻辑型 注释 = "设置播放片段(只在该帧区间内播放)。" 折叠 @嵌入式方法 = "">
    参数 起始帧 <类型 = 小数>
    参数 结束帧 <类型 = 小数>
    {
        @ (thorgw_animation_segment((void*)@sn<this>.@n<ThorVG动画.对象指针>, (float)@<起始帧>, (float)@<结束帧>) == 0)
    }
}

类 ThorVG文本 <公开 注释 = "文本对象: 使用 TrueType/OpenType 字体排版。使用前需先用 载入字体文件 / 载入字体数据 注册字体, 再用 设置字体 引用注册名。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "内部文本句柄, 请勿手工修改。">
    变量 已交付 <公开 类型 = 逻辑型 注释 = "是否已交给画布或场景。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建空文本对象, 成功返回真。">
    {
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)thorgw_text_new();
        对象指针 = 新指针
        已交付 = 假
        返回 (新指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁文本; 已交付给画布/场景的会被跳过。可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        旧指针 = 对象指针
        如果 (已交付 == 假)
        {
            @ thorgw_paint_free((void*)@<旧指针>);
        }
        对象指针 = 0
        已交付 = 假
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "文本对象是否有效。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<ThorVG文本.对象指针> != 0)
    }

    方法 类型 <公开 属性读 类型 = 整数 注释 = "对象类型码(文本为 4); 无效对象返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_paint_type((void*)@sn<this>.@n<ThorVG文本.对象指针>)
    }

    方法 载入字体文件 <公开 静态 类型 = 逻辑型 注释 = "载入字体文件并注册; 注册名为文件名去扩展名(如 simhei.ttf 注册为 simhei)。也可直接用系统字体路径。">
    参数 文件名 <类型 = 文本型>
    {
        变量 路径数据 <类型 = 字节集类>
        路径数据 = 文本到UTF8 (文件名)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_font_load_file((const char*)@<路径数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 载入字体数据 <公开 静态 类型 = 逻辑型 注释 = "从内存数据载入字体, 并注册为指定名称。">
    参数 名称 <类型 = 文本型>
    参数 字体数据 <类型 = 字节集类>
    {
        变量 长度 <类型 = 整数>
        长度 = 取字节集长度 (字体数据)
        如果 (长度 <= 0)
        {
            返回 (假)
        }
        变量 名称数据 <类型 = 字节集类>
        名称数据 = 文本到UTF8 (名称)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_font_load((const char*)@<名称数据>.GetPtr(), (const void*)@<字体数据>.GetPtr(), @<长度>, "ttf");
        返回 (结果 == 0)
    }

    方法 卸载字体 <公开 静态 类型 = 逻辑型 注释 = "卸载已注册的字体。">
    参数 名称 <类型 = 文本型>
    {
        变量 名称数据 <类型 = 字节集类>
        名称数据 = 文本到UTF8 (名称)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_font_unload((const char*)@<名称数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 设置字体 <公开 类型 = 逻辑型 注释 = "设置字体注册名(需先载入)。">
    参数 名称 <类型 = 文本型>
    {
        变量 名称数据 <类型 = 字节集类>
        变量 文本指针 <类型 = 变整数>
        名称数据 = 文本到UTF8 (名称)
        文本指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_text_font((void*)@<文本指针>, (const char*)@<名称数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 设置内容 <公开 类型 = 逻辑型 注释 = "设置文本内容(支持中文)。">
    参数 内容 <类型 = 文本型>
    {
        变量 内容数据 <类型 = 字节集类>
        变量 文本指针 <类型 = 变整数>
        内容数据 = 文本到UTF8 (内容)
        文本指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_text_set((void*)@<文本指针>, (const char*)@<内容数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 设置字号 <公开 类型 = 逻辑型 注释 = "设置字号(像素)。" 折叠 @嵌入式方法 = "">
    参数 字号 <类型 = 小数>
    {
        @ (thorgw_text_size((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<字号>) == 0)
    }

    方法 设置对齐 <公开 类型 = 逻辑型 注释 = "设置文本在排版区域内的对齐比例(0 左/上, 0.5 居中, 1 右/下)。" 折叠 @嵌入式方法 = "">
    参数 横向比例 <类型 = 小数 @默认值 = 0.0>
    参数 纵向比例 <类型 = 小数 @默认值 = 0.0>
    {
        @ (thorgw_text_align((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<横向比例>, (float)@<纵向比例>) == 0)
    }

    方法 设置布局 <公开 类型 = 逻辑型 注释 = "设置排版区域尺寸(换行基于该区域宽度)。" 折叠 @嵌入式方法 = "">
    参数 宽 <类型 = 小数>
    参数 高 <类型 = 小数>
    {
        @ (thorgw_text_layout((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<宽>, (float)@<高>) == 0)
    }

    方法 设置换行 <公开 类型 = 逻辑型 注释 = "设置换行方式: 0 不换行, 1 按字符, 2 按单词, 3 智能, 4 省略号。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ (thorgw_text_wrap((void*)@sn<this>.@n<ThorVG文本.对象指针>, @<方式>) == 0)
    }

    方法 设置斜体 <公开 类型 = 逻辑型 注释 = "设置斜体倾斜量(常用 0.18)。" 折叠 @嵌入式方法 = "">
    参数 倾斜 <类型 = 小数 @默认值 = 0.18>
    {
        @ (thorgw_text_italic((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<倾斜>) == 0)
    }

    方法 设置描边 <公开 类型 = 逻辑型 注释 = "设置文字描边(宽度为 0 表示无描边)。" 折叠 @嵌入式方法 = "">
    参数 宽度 <类型 = 小数>
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    {
        @ (thorgw_text_outline((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<宽度>, @<红>, @<绿>, @<蓝>) == 0)
    }

    方法 设置颜色 <公开 类型 = 逻辑型 注释 = "设置文字颜色。" 折叠 @嵌入式方法 = "">
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    {
        @ (thorgw_text_fill((void*)@sn<this>.@n<ThorVG文本.对象指针>, @<红>, @<绿>, @<蓝>) == 0)
    }

    方法 设置间距 <公开 类型 = 逻辑型 注释 = "设置字间距与行间距。" 折叠 @嵌入式方法 = "">
    参数 字间距 <类型 = 小数 @默认值 = 0.0>
    参数 行间距 <类型 = 小数 @默认值 = 0.0>
    {
        @ (thorgw_text_spacing((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<字间距>, (float)@<行间距>) == 0)
    }

    方法 取度量 <公开 类型 = 字节集类 注释 = "返回文本度量(4 个单精度小数: 上沿/下沿/行距/行推进); 无效对象返回空字节集。">
    {
        变量 数据 <类型 = 字节集类>
        变量 文本指针 <类型 = 变整数>
        文本指针 = 对象指针
        数据 = 取空白字节集 (16)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_text_metrics((void*)@<文本指针>, (float*)@<数据>.GetPtr());
        如果 (结果 != 0)
        {
            返回 (取空白字节集 (0))
        }
        返回 (数据)
    }

    方法 可见 <公开 类型 = 逻辑型 注释 = "设置是否可见。" 折叠 @嵌入式方法 = "">
    参数 状态 <类型 = 逻辑型>
    {
        @ (thorgw_paint_visible((void*)@sn<this>.@n<ThorVG文本.对象指针>, @<状态> ? 1 : 0) == 0)
    }

    方法 透明度 <公开 类型 = 逻辑型 注释 = "设置整体不透明度(0~255)。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (thorgw_paint_opacity((void*)@sn<this>.@n<ThorVG文本.对象指针>, @<值>) == 0)
    }

    方法 平移 <公开 类型 = 逻辑型 注释 = "整体平移(文本按基线定位, 平移即指定绘制位置)。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ (thorgw_paint_translate((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<横位移>, (float)@<纵位移>) == 0)
    }

    方法 旋转 <公开 类型 = 逻辑型 注释 = "整体旋转(度)。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 角度 <类型 = 小数>
    {
        @ (thorgw_paint_rotate((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<角度>) == 0)
    }

    方法 缩放 <公开 类型 = 逻辑型 注释 = "整体等比缩放。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 比例 <类型 = 小数>
    {
        @ (thorgw_paint_scale((void*)@sn<this>.@n<ThorVG文本.对象指针>, (float)@<比例>) == 0)
    }

    方法 变换 <公开 类型 = 逻辑型 注释 = "应用仿射矩阵(36 字节字节集)。注意: 设定矩阵后 平移/旋转/缩放 将失效。">
    参数 矩阵数据 <类型 = 字节集类>
    {
        变量 文本指针 <类型 = 变整数>
        文本指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_transform((void*)@<文本指针>, (const float*)@<矩阵数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 取包围盒 <公开 类型 = 字节集类 注释 = "返回包围盒(4 个单精度小数); 无效对象返回空字节集。">
    {
        变量 数据 <类型 = 字节集类>
        变量 文本指针 <类型 = 变整数>
        文本指针 = 对象指针
        数据 = 取空白字节集 (16)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_bounds((void*)@<文本指针>, (float*)@<数据>.GetPtr());
        如果 (结果 != 0)
        {
            返回 (取空白字节集 (0))
        }
        返回 (数据)
    }
}
