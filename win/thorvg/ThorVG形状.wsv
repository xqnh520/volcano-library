<火山程序 类型 = "通常" 版本 = 1 />

包 火山.ThorVG <注释 = "ThorVG 形状与渐变: 路径构建(直线/三次曲线/矩形/圆/椭圆/圆环/星形/圆弧/折线/多边形)、纯色与渐变填充、描边(宽度/虚线/端点/拐角)、变换、混合、遮罩与裁剪。"
        注释 = "渐变对象在 应用到填充 / 应用到描边 之后所有权转移给形状, 火山侧句柄自动清零, 不可再释放, 也不可再给第二个形状使用。"
        注释 = "注意: ThorVG 一旦用 变换 设定矩阵, 之后的 平移/旋转/缩放 都不再生效; 复合变换请先用 ThorVG矩阵.组合 合成矩阵。"
        "@视窗.外部头文件.全局-100" = "thorvg_bridge.hpp">

类 ThorVG形状 <公开 注释 = "矢量形状: 用路径命令或内置图元构建轮廓, 再设置填充与描边。一个形状可以包含多个子路径(如圆环=两个同心圆, 填充规则设为 奇偶 即可挖空)。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "内部形状句柄, 请勿手工修改。">
    变量 已交付 <公开 类型 = 逻辑型 注释 = "是否已交给画布或场景; 已交付的对象由宿主销毁, 不要再调用 释放。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建空形状, 成功返回真。">
    {
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)thorgw_shape_new();
        对象指针 = 新指针
        已交付 = 假
        返回 (新指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁形状; 已交付给画布/场景的对象会被跳过(由宿主负责销毁)。可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        旧指针 = 对象指针
        如果 (已交付 == 假)
        {
            @ thorgw_paint_free((void*)@<旧指针>);
        }
        对象指针 = 0
        已交付 = 假
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "形状是否有效。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<ThorVG形状.对象指针> != 0)
    }

    方法 类型 <公开 属性读 类型 = 整数 注释 = "对象类型码: 1 形状, 2 场景, 3 图片, 4 文本; 无效对象返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ thorgw_paint_type((void*)@sn<this>.@n<ThorVG形状.对象指针>)
    }

    方法 重置路径 <公开 类型 = 逻辑型 注释 = "清空已构建的路径(样式保留)。" 折叠 @嵌入式方法 = "">
    {
        @ (thorgw_shape_reset((void*)@sn<this>.@n<ThorVG形状.对象指针>) == 0)
    }

    方法 移动到 <公开 类型 = 逻辑型 注释 = "开始一个新的子路径并移动到指定点。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ (thorgw_shape_move_to((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<横坐标>, (float)@<纵坐标>) == 0)
    }

    方法 直线到 <公开 类型 = 逻辑型 注释 = "从当前点画直线到指定点。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ (thorgw_shape_line_to((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<横坐标>, (float)@<纵坐标>) == 0)
    }

    方法 三次曲线到 <公开 类型 = 逻辑型 注释 = "从当前点画三次贝塞尔曲线到终点(两个控制点)。" 折叠 @嵌入式方法 = "">
    参数 控制一横 <类型 = 小数>
    参数 控制一纵 <类型 = 小数>
    参数 控制二横 <类型 = 小数>
    参数 控制二纵 <类型 = 小数>
    参数 终点横 <类型 = 小数>
    参数 终点纵 <类型 = 小数>
    {
        @ (thorgw_shape_cubic_to((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<控制一横>, (float)@<控制一纵>, (float)@<控制二横>, (float)@<控制二纵>, (float)@<终点横>, (float)@<终点纵>) == 0)
    }

    方法 闭合路径 <公开 类型 = 逻辑型 注释 = "闭合当前子路径(回到起始点)。" 折叠 @嵌入式方法 = "">
    {
        @ (thorgw_shape_close((void*)@sn<this>.@n<ThorVG形状.对象指针>) == 0)
    }

    方法 追加矩形 <公开 类型 = 逻辑型 注释 = "追加一个矩形子路径; 圆角半径为 0 时为直角矩形。" 折叠 @嵌入式方法 = "">
    参数 左边 <类型 = 小数>
    参数 顶边 <类型 = 小数>
    参数 宽 <类型 = 小数>
    参数 高 <类型 = 小数>
    参数 圆角横 <类型 = 小数 @默认值 = 0.0>
    参数 圆角纵 <类型 = 小数 @默认值 = 0.0>
    {
        @ (thorgw_shape_append_rect((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<左边>, (float)@<顶边>, (float)@<宽>, (float)@<高>, (float)@<圆角横>, (float)@<圆角纵>) == 0)
    }

    方法 追加圆 <公开 类型 = 逻辑型 注释 = "追加一个圆(圆心 + 半径)。">
    参数 圆心横 <类型 = 小数>
    参数 圆心纵 <类型 = 小数>
    参数 半径 <类型 = 小数>
    {
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        变量 半径值 <类型 = 小数>
        半径值 = 半径
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_shape_append_circle((void*)@<形状指针>, (float)@<圆心横>, (float)@<圆心纵>, (float)@<半径值>, (float)@<半径值>);
        返回 (结果 == 0)
    }

    方法 追加椭圆 <公开 类型 = 逻辑型 注释 = "追加一个椭圆(圆心 + 横纵半径)。" 折叠 @嵌入式方法 = "">
    参数 圆心横 <类型 = 小数>
    参数 圆心纵 <类型 = 小数>
    参数 横半径 <类型 = 小数>
    参数 纵半径 <类型 = 小数>
    {
        @ (thorgw_shape_append_circle((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<圆心横>, (float)@<圆心纵>, (float)@<横半径>, (float)@<纵半径>) == 0)
    }

    方法 追加星形 <公开 类型 = 逻辑型 注释 = "追加一个正星形(顶点数不小于 3, 内半径建议为外半径的 0.3~0.5)。" 折叠 @嵌入式方法 = "">
    参数 中心横 <类型 = 小数>
    参数 中心纵 <类型 = 小数>
    参数 外半径 <类型 = 小数>
    参数 内半径 <类型 = 小数>
    参数 顶点数 <类型 = 整数 @默认值 = 5>
    {
        @ (thorgw_shape_append_star((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<中心横>, (float)@<中心纵>, (float)@<外半径>, (float)@<内半径>, @<顶点数>) == 0)
    }

    方法 追加圆弧 <公开 类型 = 逻辑型 注释 = "追加一段圆弧(不含到圆心的连线); 起始角与扫过角单位为度, 顺时针为正。" 折叠 @嵌入式方法 = "">
    参数 圆心横 <类型 = 小数>
    参数 圆心纵 <类型 = 小数>
    参数 半径 <类型 = 小数>
    参数 起始角 <类型 = 小数>
    参数 扫过角 <类型 = 小数>
    {
        @ (thorgw_shape_append_arc((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<圆心横>, (float)@<圆心纵>, (float)@<半径>, (float)@<起始角>, (float)@<扫过角>) == 0)
    }

    方法 追加圆环 <公开 类型 = 逻辑型 注释 = "追加一个圆环(外圆 + 内圆两段子路径), 并自动把填充规则设为 奇偶 以挖空中间。">
    参数 圆心横 <类型 = 小数>
    参数 圆心纵 <类型 = 小数>
    参数 外半径 <类型 = 小数>
    参数 内半径 <类型 = 小数>
    {
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_shape_append_circle((void*)@<形状指针>, (float)@<圆心横>, (float)@<圆心纵>, (float)@<外半径>, (float)@<外半径>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        @ @<结果> = thorgw_shape_append_circle((void*)@<形状指针>, (float)@<圆心横>, (float)@<圆心纵>, (float)@<内半径>, (float)@<内半径>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        @ thorgw_shape_fill_rule((void*)@<形状指针>, 1);
        返回 (真)
    }

    方法 追加折线 <公开 类型 = 逻辑型 注释 = "由点序列追加一条折线。点数据为字节集, 每点 8 字节(横坐标/纵坐标各一个单精度小数), 用 取空白字节集 加 置字节集单精度小数 构建。">
    参数 点数据 <类型 = 字节集类>
    参数 是否闭合 <类型 = 逻辑型 @默认值 = 假>
    {
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        变量 点数 <类型 = 整数>
        点数 = 取字节集长度 (点数据) / 8
        如果 (点数 < 2)
        {
            返回 (假)
        }
        变量 结果 <类型 = 整数>
        如果 (是否闭合)
        {
            @ @<结果> = thorgw_shape_append_polygon((void*)@<形状指针>, (const float*)@<点数据>.GetPtr(), @<点数>, 1);
        }
        否则
        {
            @ @<结果> = thorgw_shape_append_polygon((void*)@<形状指针>, (const float*)@<点数据>.GetPtr(), @<点数>, 0);
        }
        返回 (结果 == 0)
    }

    方法 追加多边形 <公开 类型 = 逻辑型 注释 = "由点序列追加一个闭合多边形; 点数据格式同 追加折线。">
    参数 点数据 <类型 = 字节集类>
    {
        返回 (追加折线 (点数据, 真))
    }

    方法 填充颜色 <公开 类型 = 逻辑型 注释 = "用纯色填充(透明度 255 为不透明)。" 折叠 @嵌入式方法 = "">
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    参数 透明度 <类型 = 整数 @默认值 = 255>
    {
        @ (thorgw_shape_fill((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<红>, @<绿>, @<蓝>, @<透明度>) == 0)
    }

    方法 描边颜色 <公开 类型 = 逻辑型 注释 = "用纯色描边。" 折叠 @嵌入式方法 = "">
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    参数 透明度 <类型 = 整数 @默认值 = 255>
    {
        @ (thorgw_shape_stroke_fill((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<红>, @<绿>, @<蓝>, @<透明度>) == 0)
    }

    方法 描边宽度 <公开 类型 = 逻辑型 注释 = "设置描边宽度(像素); 为 0 表示不描边。" 折叠 @嵌入式方法 = "">
    参数 宽度 <类型 = 小数>
    {
        @ (thorgw_shape_stroke_width((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<宽度>) == 0)
    }

    方法 描边虚线 <公开 类型 = 逻辑型 注释 = "设置虚线样式。样式数据每项 4 字节(单精度小数), 依次为实线段长度、间隔长度, 可循环给出多段。">
    参数 样式数据 <类型 = 字节集类>
    参数 起始偏移 <类型 = 小数 @默认值 = 0.0>
    {
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        变量 项数 <类型 = 整数>
        项数 = 取字节集长度 (样式数据) / 4
        如果 (项数 <= 0)
        {
            返回 (假)
        }
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_shape_stroke_dash((void*)@<形状指针>, (const float*)@<样式数据>.GetPtr(), @<项数>, (float)@<起始偏移>);
        返回 (结果 == 0)
    }

    方法 描边端点 <公开 类型 = 逻辑型 注释 = "设置线端样式: 0 平头, 1 圆头, 2 方头。" 折叠 @嵌入式方法 = "">
    参数 样式 <类型 = 整数>
    {
        @ (thorgw_shape_stroke_cap((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<样式>) == 0)
    }

    方法 描边拐角 <公开 类型 = 逻辑型 注释 = "设置拐角样式: 0 尖角, 1 圆角, 2 斜切。" 折叠 @嵌入式方法 = "">
    参数 样式 <类型 = 整数>
    {
        @ (thorgw_shape_stroke_join((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<样式>) == 0)
    }

    方法 描边斜接限制 <公开 类型 = 逻辑型 注释 = "设置尖角的最大斜接长度倍数(仅尖角样式有效)。" 折叠 @嵌入式方法 = "">
    参数 限制值 <类型 = 小数>
    {
        @ (thorgw_shape_stroke_miterlimit((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<限制值>) == 0)
    }

    方法 填充规则 <公开 类型 = 逻辑型 注释 = "设置填充规则: 0 非零环绕(默认), 1 奇偶(用于挖孔)。" 折叠 @嵌入式方法 = "">
    参数 规则 <类型 = 整数>
    {
        @ (thorgw_shape_fill_rule((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<规则>) == 0)
    }

    方法 描边优先 <公开 类型 = 逻辑型 注释 = "为真时先画描边再画填充(描边被填充覆盖一半)。" 折叠 @嵌入式方法 = "">
    参数 优先 <类型 = 逻辑型>
    {
        @ (thorgw_shape_order((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<优先> ? 1 : 0) == 0)
    }

    方法 路径裁剪 <公开 类型 = 逻辑型 注释 = "只绘制路径的一段(参数为 0~1 的比例), 常配合描边动画使用。" 折叠 @嵌入式方法 = "">
    参数 起点比例 <类型 = 小数>
    参数 终点比例 <类型 = 小数>
    {
        @ (thorgw_shape_trim((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<起点比例>, (float)@<终点比例>) == 0)
    }

    方法 可见 <公开 类型 = 逻辑型 注释 = "设置是否可见。" 折叠 @嵌入式方法 = "">
    参数 状态 <类型 = 逻辑型>
    {
        @ (thorgw_paint_visible((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<状态> ? 1 : 0) == 0)
    }

    方法 透明度 <公开 类型 = 逻辑型 注释 = "设置整体不透明度(0 全透明 ~ 255 不透明)。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (thorgw_paint_opacity((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<值>) == 0)
    }

    方法 平移 <公开 类型 = 逻辑型 注释 = "相对当前位置再平移。注意: 若已调用 变换 设定矩阵, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ (thorgw_paint_translate((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<横位移>, (float)@<纵位移>) == 0)
    }

    方法 旋转 <公开 类型 = 逻辑型 注释 = "绕原点再旋转指定角度(顺时针为正)。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 角度 <类型 = 小数>
    {
        @ (thorgw_paint_rotate((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<角度>) == 0)
    }

    方法 缩放 <公开 类型 = 逻辑型 注释 = "以原点为中心等比缩放。注意: 若已调用 变换, 本方法不再生效。" 折叠 @嵌入式方法 = "">
    参数 比例 <类型 = 小数>
    {
        @ (thorgw_paint_scale((void*)@sn<this>.@n<ThorVG形状.对象指针>, (float)@<比例>) == 0)
    }

    方法 变换 <公开 类型 = 逻辑型 注释 = "应用一个完整的仿射矩阵(36 字节字节集, 可用 ThorVG矩阵 生成)。注意: 设定矩阵后 平移/旋转/缩放 将失效, 复合变换请先用 ThorVG矩阵.组合 合成。">
    参数 矩阵数据 <类型 = 字节集类>
    {
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_transform((void*)@<形状指针>, (const float*)@<矩阵数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 混合模式 <公开 类型 = 逻辑型 注释 = "设置与下层内容的混合模式: 0 正常, 1 正片叠底, 2 滤色, 3 叠加, 4 变暗, 5 变亮, 6 颜色减淡, 7 颜色加深, 8 强光, 9 柔光, 10 差值, 11 排除, 12 色相, 13 饱和度, 14 颜色, 15 明度, 16 相加。" 折叠 @嵌入式方法 = "">
    参数 模式 <类型 = 整数>
    {
        @ (thorgw_paint_blend((void*)@sn<this>.@n<ThorVG形状.对象指针>, @<模式>) == 0)
    }

    方法 遮罩 <公开 类型 = 逻辑型 注释 = "用另一个形状作为遮罩: 0 无, 1 Alpha, 2 反 Alpha, 3 亮度, 4 反亮度, 5 相加, 6 相减, 7 相交, 8 差值, 9 变亮, 10 变暗。遮罩形状归本对象管理。" 折叠 @嵌入式方法 = "">
    参数 遮罩形状 <类型 = ThorVG形状>
    参数 方式 <类型 = 整数 @默认值 = 1>
    {
        @ (thorgw_paint_mask((void*)@sn<this>.@n<ThorVG形状.对象指针>, (void*)@<遮罩形状>.@n<ThorVG形状.对象指针>, @<方式>) == 0)
    }

    方法 裁剪 <公开 类型 = 逻辑型 注释 = "用另一个形状裁剪本对象(只显示落在裁剪形状内的部分)。" 折叠 @嵌入式方法 = "">
    参数 裁剪形状 <类型 = ThorVG形状>
    {
        @ (thorgw_paint_clip((void*)@sn<this>.@n<ThorVG形状.对象指针>, (void*)@<裁剪形状>.@n<ThorVG形状.对象指针>) == 0)
    }

    方法 取包围盒 <公开 类型 = 字节集类 注释 = "返回包围盒字节集(4 个单精度小数: 横坐标/纵坐标/宽/高), 用 取字节集单精度小数 读取; 无效对象返回空字节集。">
    {
        变量 数据 <类型 = 字节集类>
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        数据 = 取空白字节集 (16)
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_paint_bounds((void*)@<形状指针>, (float*)@<数据>.GetPtr());
        如果 (结果 != 0)
        {
            返回 (取空白字节集 (0))
        }
        返回 (数据)
    }

    方法 取包围盒横坐标 <公开 类型 = 小数 注释 = "包围盒左上角横坐标; 无效对象返回 0。">
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取包围盒 ()
        如果 (取字节集长度 (数据) < 16)
        {
            返回 (0.0)
        }
        返回 (取字节集单精度小数 (数据, 0))
    }

    方法 取包围盒纵坐标 <公开 类型 = 小数 注释 = "包围盒左上角纵坐标; 无效对象返回 0。">
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取包围盒 ()
        如果 (取字节集长度 (数据) < 16)
        {
            返回 (0.0)
        }
        返回 (取字节集单精度小数 (数据, 4))
    }

    方法 取包围盒宽度 <公开 类型 = 小数 注释 = "包围盒宽度; 无效对象返回 0。">
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取包围盒 ()
        如果 (取字节集长度 (数据) < 16)
        {
            返回 (0.0)
        }
        返回 (取字节集单精度小数 (数据, 8))
    }

    方法 取包围盒高度 <公开 类型 = 小数 注释 = "包围盒高度; 无效对象返回 0。">
    {
        变量 数据 <类型 = 字节集类>
        数据 = 取包围盒 ()
        如果 (取字节集长度 (数据) < 16)
        {
            返回 (0.0)
        }
        返回 (取字节集单精度小数 (数据, 12))
    }

    方法 路径命令数 <公开 属性读 类型 = 整数 注释 = "路径命令数量; 无效对象返回 0。">
    {
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        变量 数量 <类型 = 整数>
        @ @<数量> = thorgw_shape_path_cmd_count((void*)@<形状指针>);
        如果 (数量 < 0)
        {
            返回 (0)
        }
        返回 (数量)
    }

    方法 路径点数 <公开 属性读 类型 = 整数 注释 = "路径点数量; 无效对象返回 0。">
    {
        变量 形状指针 <类型 = 变整数>
        形状指针 = 对象指针
        变量 数量 <类型 = 整数>
        @ @<数量> = thorgw_shape_path_point_count((void*)@<形状指针>);
        如果 (数量 < 0)
        {
            返回 (0)
        }
        返回 (数量)
    }
}

类 ThorVG线性渐变 <公开 注释 = "线性渐变填充: 由起止两点定义渐变方向, 沿方向排布若干色标。用法: 创建 -> 设置起止点 -> 添加色标 -> 应用到填充(形状)。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "内部渐变句柄, 请勿手工修改。">
    变量 色标数据 <类型 = 字节集类 注释 = "累积的色标(每组 20 字节: 偏移/红/绿/蓝/透明度 各一个单精度小数)。">
    变量 已交付 <公开 类型 = 逻辑型 注释 = "是否已交给形状; 已交付的渐变由形状销毁, 不要再调用 释放。">

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建线性渐变, 成功返回真。">
    {
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)thorgw_linear_new();
        对象指针 = 新指针
        色标数据 = 取空白字节集 (0)
        已交付 = 假
        返回 (新指针 != 0)
    }

    方法 释放 <公开 注释 = "销毁渐变; 已交付给形状的渐变会被跳过。可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        旧指针 = 对象指针
        如果 (已交付 == 假)
        {
            @ thorgw_gradient_free((void*)@<旧指针>);
        }
        对象指针 = 0
        已交付 = 假
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "渐变是否有效。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<ThorVG线性渐变.对象指针> != 0)
    }

    方法 设置起止点 <公开 类型 = 逻辑型 注释 = "设置渐变方向: 从 (起横, 起纵) 到 (止横, 止纵)。" 折叠 @嵌入式方法 = "">
    参数 起横 <类型 = 小数>
    参数 起纵 <类型 = 小数>
    参数 止横 <类型 = 小数>
    参数 止纵 <类型 = 小数>
    {
        @ (thorgw_linear_set((void*)@sn<this>.@n<ThorVG线性渐变.对象指针>, (float)@<起横>, (float)@<起纵>, (float)@<止横>, (float)@<止纵>) == 0)
    }

    方法 添加色标 <公开 类型 = 逻辑型 注释 = "追加一个色标(需随后调用 提交色标 或直接 应用到填充 生效)。偏移取 0~1。">
    参数 偏移 <类型 = 小数>
    参数 红 <类型 = 整数>
    参数 绿 <类型 = 整数>
    参数 蓝 <类型 = 整数>
    参数 透明度 <类型 = 整数 @默认值 = 255>
    {
        变量 一组 <类型 = 字节集类>
        一组 = 取空白字节集 (20)
        置字节集单精度小数 (一组, 0, (单精度小数)偏移)
        置字节集单精度小数 (一组, 4, (单精度小数)红)
        置字节集单精度小数 (一组, 8, (单精度小数)绿)
        置字节集单精度小数 (一组, 12, (单精度小数)蓝)
        置字节集单精度小数 (一组, 16, (单精度小数)透明度)
        色标数据 = 组合字节集 (色标数据, 一组)
        返回 (真)
    }

    方法 设置色标 <公开 类型 = 逻辑型 注释 = "一次性设置全部色标并立即生效。色标数据每组 20 字节(偏移/红/绿/蓝/透明度 各一个单精度小数), 偏移取 0~1。">
    参数 数据 <类型 = 字节集类>
    {
        变量 渐变指针 <类型 = 变整数>
        渐变指针 = 对象指针
        变量 组数 <类型 = 整数>
        组数 = 取字节集长度 (数据) / 20
        如果 (组数 <= 0)
        {
            返回 (假)
        }
        色标数据 = 数据
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_gradient_stops((void*)@<渐变指针>, (const float*)@<数据>.GetPtr(), @<组数>);
        返回 (结果 == 0)
    }

    方法 提交色标 <公开 类型 = 逻辑型 注释 = "把已添加的色标提交到原生渐变对象。">
    {
        返回 (设置色标 (色标数据))
    }

    方法 平铺方式 <公开 类型 = 逻辑型 注释 = "设置渐变范围之外的填充方式: 0 夹取(默认), 1 反射, 2 重复。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ (thorgw_gradient_spread((void*)@sn<this>.@n<ThorVG线性渐变.对象指针>, @<方式>) == 0)
    }

    方法 变换 <公开 类型 = 逻辑型 注释 = "对渐变本身应用仿射矩阵(36 字节字节集)。">
    参数 矩阵数据 <类型 = 字节集类>
    {
        变量 渐变指针 <类型 = 变整数>
        渐变指针 = 对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_gradient_transform((void*)@<渐变指针>, (const float*)@<矩阵数据>.GetPtr());
        返回 (结果 == 0)
    }

    方法 应用到填充 <公开 类型 = 逻辑型 注释 = "把本渐变用作形状的填充色; 调用后渐变所有权转移给形状, 本对象句柄清零。">
    参数 目标形状 <类型 = ThorVG形状>
    {
        提交色标 ()
        变量 渐变指针 <类型 = 变整数>
        变量 形状指针 <类型 = 变整数>
        渐变指针 = 对象指针
        形状指针 = 目标形状.对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_shape_fill_gradient((void*)@<形状指针>, (void*)@<渐变指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        对象指针 = 0
        已交付 = 真
        返回 (真)
    }

    方法 应用到描边 <公开 类型 = 逻辑型 注释 = "把本渐变用作形状的描边色; 调用后渐变所有权转移给形状, 本对象句柄清零。">
    参数 目标形状 <类型 = ThorVG形状>
    {
        提交色标 ()
        变量 渐变指针 <类型 = 变整数>
        变量 形状指针 <类型 = 变整数>
        渐变指针 = 对象指针
        形状指针 = 目标形状.对象指针
        变量 结果 <类型 = 整数>
        @ @<结果> = thorgw_shape_stroke_gradient((void*)@<形状指针>, (void*)@<渐变指针>);
        如果 (结果 != 0)
        {
            返回 (假)
        }
        对象指针 = 0
        已交付 = 真
        返回 (真)
    }
}

类 ThorVG径向渐变 <公开 注释 = "径向渐变填充: 由中心圆(圆心+半径)与焦点定义渐变范围。用法: 创建 -> 设置范围 -> 添加色标 -> 应用到填充(形状)。">
