        @ @<结果> = thorgw_gradient_stops((void*)@<渐变指针>, (const float*)@<数据>.GetPtr(), @<组数>);
        返回 (结果 == 0)
    }

    方法 提交色标 <公开 类型 = 逻辑型 注释 = "把已添加的色标提交到原生渐变对象。">
    {
        返回 (设置色标 (色标数据))
    }

    方法 平铺方式 <公开 类型 = 逻辑型 注释 = "设置渐变范围之外的填充方式: 0 夹取, 1 反射, 2 重复。" 折叠 @嵌入式方法 = "">
