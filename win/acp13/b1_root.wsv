<火山程序 类型 = "通常" 版本 = 1 />

包 火山.根类探针 <注释 = "P13 探针: 根类, 4 个静态方法。">

类 探针根类 <公开 注释 = "统一根类。">
{
    方法 是否有效 <公开 静态 类型 = 整数 注释 = "1 有效。">
    参数 句柄 <类型 = 变整数>
    {
        返回 (1)
    }

    方法 取类型全名 <公开 静态 类型 = 文本型 注释 = "类型名。">
    参数 句柄 <类型 = 变整数>
    {
        返回 ("根类")
    }

    方法 释放 <公开 静态 类型 = 整数 注释 = "释放。">
    参数 句柄 <类型 = 变整数>
    {
        返回 (1)
    }

    方法 判等 <公开 静态 类型 = 整数 注释 = "判等。">
    参数 句柄1 <类型 = 变整数>
    参数 句柄2 <类型 = 变整数>
    {
        返回 (0)
    }
}
