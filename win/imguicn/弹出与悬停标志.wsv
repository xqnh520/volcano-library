<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 弹出标志 <公开 注释 = "弹出窗口标志" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiPopupFlags_None>
    常量 鼠标左键 <公开 类型 = 整数 值 = @ImGuiPopupFlags_MouseButtonLeft>
    常量 鼠标右键 <公开 类型 = 整数 值 = @ImGuiPopupFlags_MouseButtonRight>
    常量 鼠标中键 <公开 类型 = 整数 值 = @ImGuiPopupFlags_MouseButtonMiddle>
    常量 禁止重复打开 <公开 类型 = 整数 值 = @ImGuiPopupFlags_NoReopen>
    常量 已有弹出时不打开 <公开 类型 = 整数 值 = @ImGuiPopupFlags_NoOpenOverExistingPopup>
    常量 不覆盖项目打开 <公开 类型 = 整数 值 = @ImGuiPopupFlags_NoOpenOverItems>
    常量 任意弹出ID <公开 类型 = 整数 值 = @ImGuiPopupFlags_AnyPopupId>
    常量 任意弹出层级 <公开 类型 = 整数 值 = @ImGuiPopupFlags_AnyPopupLevel>
    常量 任意弹出窗口 <公开 类型 = 整数 值 = @ImGuiPopupFlags_AnyPopup>
}
类 悬停标志 <公开 注释 = "悬停判定标志" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiHoveredFlags_None>
    常量 包含子窗口 <公开 类型 = 整数 值 = @ImGuiHoveredFlags_ChildWindows>
