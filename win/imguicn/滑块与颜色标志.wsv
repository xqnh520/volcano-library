<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 滑块标志 <公开 注释 = "滑块/拖动框标志" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiSliderFlags_None>
    常量 对数刻度 <公开 类型 = 整数 值 = @ImGuiSliderFlags_Logarithmic>
    常量 不按格式取整 <公开 类型 = 整数 值 = @ImGuiSliderFlags_NoRoundToFormat>
    常量 禁止直接输入 <公开 类型 = 整数 值 = @ImGuiSliderFlags_NoInput>
    常量 循环取值 <公开 类型 = 整数 值 = @ImGuiSliderFlags_WrapAround>
    常量 输入时钳制 <公开 类型 = 整数 值 = @ImGuiSliderFlags_ClampOnInput>
    常量 零范围钳制 <公开 类型 = 整数 值 = @ImGuiSliderFlags_ClampZeroRange>
    常量 不调整拖动速度 <公开 类型 = 整数 值 = @ImGuiSliderFlags_NoSpeedTweaks>
    常量 始终钳制 <公开 类型 = 整数 值 = @ImGuiSliderFlags_AlwaysClamp>
}
