<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 配置标志 <公开 注释 = "IO配置标志" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiConfigFlags_None>
    常量 启用键盘导航 <公开 类型 = 整数 值 = @ImGuiConfigFlags_NavEnableKeyboard>
    常量 启用手柄导航 <公开 类型 = 整数 值 = @ImGuiConfigFlags_NavEnableGamepad>
    常量 禁止鼠标 <公开 类型 = 整数 值 = @ImGuiConfigFlags_NoMouse>
    常量 不改变鼠标光标 <公开 类型 = 整数 值 = @ImGuiConfigFlags_NoMouseCursorChange>
    常量 禁止键盘 <公开 类型 = 整数 值 = @ImGuiConfigFlags_NoKeyboard>
    常量 启用停靠 <公开 类型 = 整数 值 = @ImGuiConfigFlags_DockingEnable>
    常量 启用多视口 <公开 类型 = 整数 值 = @ImGuiConfigFlags_ViewportsEnable>
    常量 DPI缩放视口 <公开 类型 = 整数 值 = @ImGuiConfigFlags_DpiEnableScaleViewports>
    常量 DPI缩放字体 <公开 类型 = 整数 值 = @ImGuiConfigFlags_DpiEnableScaleFonts>
    常量 sRGB模式 <公开 类型 = 整数 值 = @ImGuiConfigFlags_IsSRGB>
    常量 触摸屏模式 <公开 类型 = 整数 值 = @ImGuiConfigFlags_IsTouchScreen>
    常量 导航设置鼠标位置 <公开 类型 = 整数 值 = @ImGuiConfigFlags_NavEnableSetMousePos>
    常量 导航不捕获键盘 <公开 类型 = 整数 值 = @ImGuiConfigFlags_NavNoCaptureKeyboard>
}
类 后端标志 <公开 注释 = "后端能力标志" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiBackendFlags_None>
    常量 支持手柄 <公开 类型 = 整数 值 = @ImGuiBackendFlags_HasGamepad>
    常量 支持鼠标光标 <公开 类型 = 整数 值 = @ImGuiBackendFlags_HasMouseCursors>
    常量 支持设置鼠标位置 <公开 类型 = 整数 值 = @ImGuiBackendFlags_HasSetMousePos>
    常量 渲染器支持顶点偏移 <公开 类型 = 整数 值 = @ImGuiBackendFlags_RendererHasVtxOffset>
    常量 平台支持多视口 <公开 类型 = 整数 值 = @ImGuiBackendFlags_PlatformHasViewports>
    常量 支持悬停视口 <公开 类型 = 整数 值 = @ImGuiBackendFlags_HasMouseHoveredViewport>
    常量 渲染器支持多视口 <公开 类型 = 整数 值 = @ImGuiBackendFlags_RendererHasViewports>
}
