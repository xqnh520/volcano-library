<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 数据类别 <公开 注释 = "数值数据类别" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 有符号8位 <公开 类型 = 整数 值 = @ImGuiDataType_S8>
    常量 无符号8位 <公开 类型 = 整数 值 = @ImGuiDataType_U8>
    常量 有符号16位 <公开 类型 = 整数 值 = @ImGuiDataType_S16>
    常量 无符号16位 <公开 类型 = 整数 值 = @ImGuiDataType_U16>
    常量 有符号32位 <公开 类型 = 整数 值 = @ImGuiDataType_S32>
    常量 无符号32位 <公开 类型 = 整数 值 = @ImGuiDataType_U32>
    常量 有符号64位 <公开 类型 = 整数 值 = @ImGuiDataType_S64>
    常量 无符号64位 <公开 类型 = 整数 值 = @ImGuiDataType_U64>
    常量 单精度浮点 <公开 类型 = 整数 值 = @ImGuiDataType_Float>
    常量 双精度浮点 <公开 类型 = 整数 值 = @ImGuiDataType_Double>
    常量 逻辑布尔 <公开 类型 = 整数 值 = @ImGuiDataType_Bool>
    常量 文本字符串 <公开 类型 = 整数 值 = @ImGuiDataType_String>
}
类 布局方向 <公开 注释 = "布局方向（左/右/上/下），用于分割停靠节点等" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiDir_None>
    常量 左 <公开 类型 = 整数 值 = @ImGuiDir_Left>
    常量 右 <公开 类型 = 整数 值 = @ImGuiDir_Right>
    常量 上 <公开 类型 = 整数 值 = @ImGuiDir_Up>
    常量 下 <公开 类型 = 整数 值 = @ImGuiDir_Down>
}
