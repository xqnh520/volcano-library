<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 文本过滤器 <公开 注释 = "文本过滤器：按空格分词做包含匹配，支持 \"-词\" 排除语法，常用于列表搜索框。" 折叠>
{
    方法 绘制 <公开 静态 类型 = 逻辑型 注释 = "绘制一个带输入框的过滤器控件。" 返回值注释 = "过滤文本变化时返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签" @默认值 = "过滤（支持 -排除）">
    参数 宽度 <类型 = 单精度小数 注释 = "输入框宽度，0 表示默认" @默认值 = 0>
    {
        @ ::imcn::FilterDraw(IMCN_U8(@<标签文本>), @<宽度>)
    }

    方法 是否通过 <公开 静态 类型 = 逻辑型 注释 = "判断一段文本是否符合当前过滤条件；过滤器为空时一律通过。" 返回值注释 = "符合返回真" 折叠 @嵌入式方法 = "">
    参数 待测文本 <类型 = 文本型 注释 = "要检查的文本">
    {
        @ ::imcn::FilterPass(IMCN_U8(@<待测文本>))
    }

    方法 是否启用 <公开 静态 类型 = 逻辑型 注释 = "过滤器是否已有有效条件。" 返回值注释 = "有过滤条件返回真" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::FilterActive()
    }

    方法 置过滤文本 <公开 静态 注释 = "直接设置过滤条件文本（不经过输入框）。" 折叠 @嵌入式方法 = "">
    参数 过滤文本 <类型 = 文本型 注释 = "过滤条件，多个词用空格分隔">
    {
        @ ::imcn::FilterSetText(IMCN_U8(@<过滤文本>))
    }

    方法 清空 <公开 静态 注释 = "清空过滤条件。" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::FilterClear()
    }
}
