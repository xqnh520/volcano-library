<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 列表裁剪 <公开 注释 = "大列表裁剪：只处理当前可见的行，避免上万行逐条绘制。用法：开始裁剪 → 判断循环(裁剪步进) → 按 取显示起始/取显示结束 绘制 → 结束裁剪。" 折叠>
{
    方法 开始裁剪 <公开 静态 注释 = "开始一次列表裁剪，需与\"结束裁剪\"配对（正常走完 裁剪步进 会自动结束）。行高传 -1 时由第一行自动推算，因此循环体里每轮至少要提交一个会推进光标的控件，否则会因算不出行高而断言退出；行高已知时直接传入可避免该问题。" 折叠 @嵌入式方法 = "">
    参数 项目总数 <类型 = 整数 注释 = "列表总行数">
    参数 项目高度 <类型 = 单精度小数 注释 = "单行高度，-1 表示使用当前字体行高" @默认值 = -1>
    {
        @ ::imcn::ClipperBegin((int)@<项目总数>, @<项目高度>)
    }

    方法 裁剪步进 <公开 静态 类型 = 逻辑型 注释 = "推进到下一批可见行，返回假表示遍历结束。" 返回值注释 = "还有可见行返回真" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::ClipperStep()
    }

    方法 取显示起始 <公开 静态 类型 = 整数 注释 = "取回当前批次第一个可见行的索引。" 返回值注释 = "起始行索引" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::ClipperDisplayStart()
    }

    方法 取显示结束 <公开 静态 类型 = 整数 注释 = "取回当前批次最后一个可见行的索引（不含）。" 返回值注释 = "结束行索引" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::ClipperDisplayEnd()
    }

    方法 结束裁剪 <公开 静态 注释 = "提前结束列表裁剪。" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::ClipperEnd()
    }

    # 强制区间与光标定位 | Forced Range & Seek

    方法 按索引包含区间 <公开 静态 注释 = "强制让一段索引区间不被裁剪，例如当前选中行、展开的子项或表头固定行。必须在\"开始裁剪\"之后、第一次\"裁剪步进\"之前调用，否则内部断言会失败（本方法已做保护，超时会变成无操作）。" 折叠 @嵌入式方法 = "">
    参数 起始索引 <类型 = 整数 注释 = "区间起始索引（含）">
    参数 结束索引 <类型 = 整数 注释 = "区间结束索引（不含），等于起始索引加一时只包含一项">
    {
        @ ::imcn::ClipperIncludeItems((int)@<起始索引>, (int)@<结束索引>)
    }

    方法 定位光标到项 <公开 静态 注释 = "把光标直接定位到第 N 项所在的高度，用于项目总数事先未知（开始裁剪时传一个极大值）而需要手工收尾的场合。可在\"结束裁剪\"之前或之后调用。" 折叠 @嵌入式方法 = "">
    参数 项索引 <类型 = 整数 注释 = "要定位到的项索引">
    {
        @ ::imcn::ClipperSeekCursorForItem((int)@<项索引>)
    }

}
