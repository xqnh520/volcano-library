<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 界面表格 <公开 注释 = "表格命令：创建表格、定义列、逐行逐列填充内容。典型顺序：开始表格 → 设置列×N → 表头行 → 下一行 → 下一列..." 折叠>
{
    方法 开始表格 <公开 静态 类型 = 逻辑型 注释 = "开始一个表格，需要用\"结束表格\"闭合。" 返回值注释 = "表格可见时返回真" 折叠 @嵌入式方法 = "">
    参数 表格ID <类型 = 文本型 注释 = "表格唯一ID">
    参数 列数 <类型 = 整数 注释 = "表格列数">
    参数 表格标志值 <类型 = 整数 注释 = "表格标志，可用\"表格标志\"类中的常量" @默认值 = 0>
    参数 外框尺寸 <类型 = 二维坐标值 注释 = "(0,0) 表示自动尺寸" @默认值 = 二维坐标值默认值.零值>
    参数 内部宽度 <类型 = 单精度小数 注释 = "表格最小内部宽度，0 表示自动" @默认值 = 0>
    {
        @ ImGui::BeginTable(IMCN_U8(@<表格ID>), (int)@<列数>, (ImGuiTableFlags)@<表格标志值>, @<外框尺寸>, @<内部宽度>)
    }

    方法 结束表格 <公开 静态 注释 = "结束表格。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::EndTable()
    }

    方法 设置列 <公开 静态 注释 = "设置一列的标题与标志，必须在表头行之前调用。" 折叠 @嵌入式方法 = "">
    参数 列名称 <类型 = 文本型 注释 = "列标题文本">
    参数 列标志 <类型 = 整数 注释 = "表格列标志，可用\"表格列标志\"类中的常量" @默认值 = 0>
    参数 初始宽度 <类型 = 单精度小数 注释 = "初始列宽，0 表示自动" @默认值 = 0>
    {
        @ ImGui::TableSetupColumn(IMCN_U8(@<列名称>), (ImGuiTableColumnFlags)@<列标志>, @<初始宽度>)
    }

    方法 设置滚动冻结行数 <公开 静态 注释 = "设置滚动时冻结的行数。" 折叠 @嵌入式方法 = "">
    参数 冻结行数 <类型 = 整数 注释 = "冻结的行数">
    {
        @ ImGui::TableSetupScrollFreeze(0, (int)@<冻结行数>)
    }

    方法 设置滚动冻结 <公开 静态 注释 = "设置滚动时冻结的列数与行数。" 折叠 @嵌入式方法 = "">
    参数 冻结列数 <类型 = 整数 注释 = "冻结的列数">
    参数 冻结行数 <类型 = 整数 注释 = "冻结的行数">
    {
        @ ImGui::TableSetupScrollFreeze((int)@<冻结列数>, (int)@<冻结行数>)
    }

    方法 表头行 <公开 静态 注释 = "输出一行表头（自动绘制列标题）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableHeadersRow()
    }

    方法 下一行 <公开 静态 注释 = "开始新的一行。" 折叠 @嵌入式方法 = "">
    参数 行标志 <类型 = 整数 注释 = "表格行标志，可用\"表格行标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::TableNextRow((ImGuiTableRowFlags)@<行标志>)
    }

    方法 下一列 <公开 静态 类型 = 逻辑型 注释 = "移动到下一列。" 返回值注释 = "进入新列返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableNextColumn()
    }

    方法 定位列 <公开 静态 类型 = 逻辑型 注释 = "移动到指定列。" 返回值注释 = "列可见返回真" 折叠 @嵌入式方法 = "">
    参数 列索引 <类型 = 整数 注释 = "列索引，从 0 开始">
    {
        @ ImGui::TableSetColumnIndex((int)@<列索引>)
    }

    方法 置当前列宽 <公开 静态 注释 = "设置当前列的宽度。需在表格第二帧及以后调用（首帧列宽尚未初始化），并须在第一行之前调用；不满足条件时本方法安全忽略本次调用。" 折叠 @嵌入式方法 = "">
    参数 宽度 <类型 = 单精度小数 注释 = "列宽像素值">
    {
        @ ::imcn::TableSetColumnWidthSafe(ImGui::TableGetColumnIndex(), @<宽度>)
    }

    方法 取当前列索引 <公开 静态 类型 = 整数 注释 = "取回当前光标所在列索引。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableGetColumnIndex()
    }

    方法 取列数 <公开 静态 类型 = 整数 注释 = "取回当前表格的列数。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableGetColumnCount()
    }

    方法 取排序状态 <公开 静态 类型 = 整数 注释 = "取回当前排序状态标志（是否升序、是否被排序）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableGetColumnFlags()
    }

    方法 置行背景色 <公开 静态 注释 = "设置当前行的背景颜色。" 折叠 @嵌入式方法 = "">
    参数 颜色值 <类型 = 四维数值 注释 = "行背景色">
    参数 背景目标 <类型 = 整数 注释 = "背景目标，可用\"表格背景目标\"类中的常量" @默认值 = 2>
    {
        @ ImGui::TableSetBgColor((ImGuiTableBgTarget)@<背景目标>, ImGui::ColorConvertFloat4ToU32(@<颜色值>))
    }

    方法 取是否需要排序 <公开 静态 类型 = 逻辑型 注释 = "表格是否要求重新排序（点击了表头）。" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::TableSortDirty()
    }

    # 手工表头与排序规格 | Manual Header & Sort Specs

    方法 表头列 <公开 静态 注释 = "手工提交一个表头单元格，仅在需要自行控制表头行时使用，通常直接调用\"表头行\"即可。" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "表头文字">
    {
        @ ImGui::TableHeader(IMCN_U8(@<标签文本>))
    }

    方法 表头倾斜行 <公开 静态 注释 = "提交一行倾斜显示的表头，仅对列标志里开启了角度表头的列生效，且必须是表格第一行。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableAngledHeadersRow()
    }

    方法 取悬停列 <公开 静态 类型 = 整数 注释 = "取回鼠标当前悬停的列序号，未悬停返回 -1。" 返回值注释 = "列序号" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableGetHoveredColumn()
    }

    方法 取排序规格 <公开 静态 类型 = 变整数 注释 = "取回表格当前的排序规格结构指针，表格不可排序或未排序时返回 0。" 返回值注释 = "排序规格指针" 折叠 @嵌入式方法 = "">
    {
        @ (long long)(intptr_t)ImGui::TableGetSortSpecs()
    }

}
类 界面表格扩展 <公开 注释 = "表格进阶命令：按索引设置列宽与列启用状态、查询列名称与列标志、查询当前行索引、设置列排序方向。" 折叠>
{
    # 列设置 | Column

    方法 置列宽 <公开 静态 注释 = "按列索引设置列宽。需在表格第二帧及以后调用（首帧列宽尚未初始化），并须在第一行之前调用；不满足条件时本方法安全忽略本次调用。" 折叠 @嵌入式方法 = "">
    参数 列索引 <类型 = 整数 注释 = "列索引，从 0 开始">
    参数 列宽 <类型 = 单精度小数 注释 = "列宽像素值">
    {
        @ ::imcn::TableSetColumnWidthSafe((int)@<列索引>, @<列宽>)
    }

    方法 置列启用 <公开 静态 注释 = "按列索引启用或隐藏一列。表格必须带表级标志『表格标志.允许隐藏列』，否则本方法安全忽略本次调用。" 折叠 @嵌入式方法 = "">
    参数 列索引 <类型 = 整数 注释 = "列索引，从 0 开始">
    参数 是否启用 <类型 = 逻辑型 注释 = "假表示隐藏该列">
    {
        @ ::imcn::TableSetColumnEnabledSafe((int)@<列索引>, (bool)@<是否启用>)
    }

    方法 置列排序方向 <公开 静态 注释 = "设置指定列的排序方向，使表头显示升序/降序箭头。需在表格内部调用，且表格须带表级标志『表格标志.允许排序』；『排序方向.无』只适用于开了三态排序的表格。" 折叠 @嵌入式方法 = "">
    参数 列索引 <类型 = 整数 注释 = "列索引，从 0 开始">
    参数 排序方向 <类型 = 整数 注释 = "排序方向，可用\"排序方向\"类中的常量">
    {
        @ ImGui::TableSetColumnSortDirection((int)@<列索引>, (ImGuiSortDirection)@<排序方向>, false)
    }

    # 列查询 | Column Query

    方法 取列名称 <公开 静态 类型 = 文本型 注释 = "取回指定列的名称（即设置列时传入的标题文本）。" 返回值注释 = "列名称文本" 折叠
            @嵌入式方法 = "">
    参数 列索引 <类型 = 整数 注释 = "列索引，从 0 开始">
    {
        @ CVolString(::imcn::ToW(ImGui::TableGetColumnName((int)@<列索引>)).c_str())
    }

    方法 取列标志 <公开 静态 类型 = 整数 注释 = "取回指定列当前的标志，可用\"表格列标志\"类中的常量做位判断。" 折叠 @嵌入式方法 = "">
    参数 列索引 <类型 = 整数 注释 = "列索引，从 0 开始">
    {
        @ (int)ImGui::TableGetColumnFlags((int)@<列索引>)
    }

    方法 取表格列数 <公开 静态 类型 = 整数 注释 = "取回当前表格的列数。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableGetColumnCount()
    }

    方法 取列宽 <公开 静态 类型 = 单精度小数 注释 = "取回指定列当前的实际宽度（像素），用于校验\"置列宽\"是否生效。首帧布局尚未计算时返回 0。" 返回值注释 = "列宽像素值" 折叠
            @嵌入式方法 = "">
    参数 列索引 <类型 = 整数 注释 = "列索引，从 0 开始">
    {
        @ ::imcn::TableGetColumnWidthSafe((int)@<列索引>)
    }

    # 行查询 | Row Query

    方法 取当前行索引 <公开 静态 类型 = 整数 注释 = "取回当前表格中光标所在的行索引，从 0 开始。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::TableGetRowIndex()
    }
}
