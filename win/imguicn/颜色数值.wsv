<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 四维数值 <公开 注释 = "对应 ImGui 的 ImVec4，常用于表示带透明度的颜色 (红, 绿, 蓝, 透明)。" 折叠
        折叠2 @文档 = "category = \"基础类型\"" @别名 = "ImVec4" @别名类型 = 本地值类型>
{
    变量 红色 <公开 类型 = 单精度小数 @输出名 = "x" @属性变量 = 真 注释 = "红色分量，范围 0.0-1.0">
    变量 绿色 <公开 类型 = 单精度小数 @输出名 = "y" @属性变量 = 真 注释 = "绿色分量，范围 0.0-1.0">
    变量 蓝色 <公开 类型 = 单精度小数 @输出名 = "z" @属性变量 = 真 注释 = "蓝色分量，范围 0.0-1.0">
    变量 透明度 <公开 类型 = 单精度小数 @输出名 = "w" @属性变量 = 真 注释 = "透明度分量，范围 0.0-1.0">

    方法 创建 <公开 静态 类型 = 四维数值 注释 = "按给定的四个分量创建数值。" 折叠 @嵌入式方法 = "">
    参数 红色值 <注释 = "红色分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 绿色值 <注释 = "绿色分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 蓝色值 <注释 = "蓝色分量" @默认值 = 0 @匹配类型 = 通用数值型>
    参数 透明度值 <注释 = "透明度分量" @默认值 = 1 @匹配类型 = 通用数值型>
    {
        @ ImVec4((float)@<红色值>, (float)@<绿色值>, (float)@<蓝色值>, (float)@<透明度值>)
    }

    方法 创建自整数色 <公开 静态 类型 = 四维数值 注释 = "把一个 32 位打包颜色值（AABBGGRR）拆分为四个分量。" 折叠 @嵌入式方法 = "">
    参数 打包颜色 <类型 = 整数 注释 = "32 位打包颜色值">
    {
        @ ImGui::ColorConvertU32ToFloat4((ImU32)@<打包颜色>)
    }

    方法 转为整数色 <公开 静态 类型 = 整数 注释 = "把四个分量打包为 32 位颜色值（AABBGGRR）。" 折叠 @嵌入式方法 = "">
    参数 欲转换的颜色 <类型 = 四维数值 @视窗.后缀文本 = "&" 注释 = "被转换的颜色值">
    {
        @ ImGui::ColorConvertFloat4ToU32(@<欲转换的颜色>)
    }
}
