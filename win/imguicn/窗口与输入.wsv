    方法 结束分组 <公开 静态 注释 = "结束分组，必须与\"开始分组\"成对使用。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::EndGroup()
    }

    方法 置光标横向位置 <公开 静态 注释 = "设置布局光标的横向位置。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 单精度小数 注释 = "相对窗口内容区的横坐标">
    {
        @ ImGui::SetCursorPosX(@<横坐标>)
    }

    方法 置光标纵向位置 <公开 静态 注释 = "设置布局光标的纵向位置。" 折叠 @嵌入式方法 = "">
    参数 纵坐标 <类型 = 单精度小数 注释 = "相对窗口内容区的纵坐标">
    {
