        @ ImGui::EndDisabled()
    }

    方法 开始裁剪 <公开 静态 注释 = "开始裁剪区域，超出矩形的内容不会被绘制。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::PushClipRect(ImVec2(0.0f, 0.0f), ImVec2(FLT_MAX, FLT_MAX), false)
    }

    方法 结束裁剪 <公开 静态 注释 = "结束裁剪区域。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::PopClipRect()
    }
    方法 压入项宽度 <公开 静态 注释 = "后续控件使用指定宽度，需与"弹出项宽度"配对。" 折叠 @嵌入式方法 = "">
    参数 宽度 <类型 = 单精度小数 注释 = "以像素计的宽度">
    {
        @ ImGui::PushItemWidth(@<宽度>)
    }

    方法 取标识 <公开 静态 类型 = 整数 注释 = "由文本计算出一个稳定的32位标识值，常用于停靠区ID。" 返回值注释 = "标识值" 折叠 @嵌入式方法 = "">
    参数 文本 <类型 = 文本型 注释 = "用于计算标识的文本">
    {
        @ (int)ImGui::GetID(IMCN_U8(@<文本>))
    }

    方法 取项宽度 <公开 静态 类型 = 单精度小数 注释 = "取回当前控件的默认宽度。" 返回值注释 = "宽度像素值" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::CalcItemWidth()
    }

    方法 弹出项宽度 <公开 静态 注释 = "恢复"压入项宽度"之前的宽度。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::PopItemWidth()
    }

    方法 绘制停靠区 <公开 静态 类型 = 整数 注释 = "在当前窗口内创建一个停靠区，返回停靠区标识。" 返回值注释 = "停靠区标识" 折叠 @嵌入式方法 = "">
    参数 停靠区标识 <类型 = 整数 注释 = "用"取标识"得到的停靠区ID">
    参数 尺寸 <类型 = 二维坐标值 注释 = "(0,0) 表示占满剩余空间" @默认值 = 二维坐标值默认值.零值>
    参数 停靠节点标志值 <类型 = 整数 注释 = "停靠节点标志，可用"停靠节点标志"类中的常量" @默认值 = 0>
    {
        @ (int)ImGui::DockSpace((ImGuiID)@<停靠区标识>, @<尺寸>, (ImGuiDockNodeFlags)@<停靠节点标志值>, NULL)
    }

    方法 置下一窗口停靠标识 <公开 静态 注释 = "指定下一个窗口停靠到哪个停靠节点。" 折叠 @嵌入式方法 = "">
    参数 停靠标识 <类型 = 整数 注释 = "目标停靠节点ID">
    参数 执行条件 <类型 = 整数 注释 = "条件，可用"执行条件"类中的常量" @默认值 = 0>
    {
        @ ImGui::SetNextWindowDockID((ImGuiID)@<停靠标识>, (ImGuiCond)@<执行条件>)
    }

    方法 绘制全屏停靠区 <公开 静态 类型 = 整数 注释 = "创建一个覆盖主视口的全屏停靠区，适合做主界面骨架。" 返回值注释 = "停靠区标识" 折叠 @嵌入式方法 = "">
    参数 停靠区标识 <类型 = 整数 注释 = "停靠区ID，传 0 表示自动" @默认值 = 0>
    参数 停靠节点标志值 <类型 = 整数 注释 = "停靠节点标志" @默认值 = 0>
    {
        @ (int)ImGui::DockSpaceOverViewport((ImGuiID)@<停靠区标识>, NULL, (ImGuiDockNodeFlags)@<停靠节点标志值>, NULL)
    }

    方法 重置停靠节点 <公开 静态 注释 = "删除指定停靠节点及其子节点。重建布局前先调用它。" 折叠 @嵌入式方法 = "">
    参数 节点标识 <类型 = 整数 注释 = "停靠区标识">
    {
        @ ::imcn::DockReset((unsigned int)@<节点标识>)
    }

    方法 新建停靠节点 <公开 静态 类型 = 整数 注释 = "新建一个停靠节点并返回其标识。" 返回值注释 = "新节点标识" 折叠 @嵌入式方法 = "">
    参数 节点标识 <类型 = 整数 注释 = "父节点标识，传 0 表示新建" @默认值 = 0>
    参数 节点标志值 <类型 = 整数 注释 = "停靠节点标志" @默认值 = 0>
    {
        @ (int)::imcn::DockAddNode((unsigned int)@<节点标识>, (int)@<节点标志值>)
    }

    方法 置停靠节点尺寸 <公开 静态 注释 = "设置停靠节点尺寸，必须在分割之前调用。" 折叠 @嵌入式方法 = "">
    参数 节点标识 <类型 = 整数 注释 = "节点标识">
    参数 宽度 <类型 = 单精度小数 注释 = "宽度像素">
    参数 高度 <类型 = 单精度小数 注释 = "高度像素">
    {
        @ ::imcn::DockSetNodeSize((unsigned int)@<节点标识>, @<宽度>, @<高度>)
    }

    方法 分割停靠节点 <公开 静态 类型 = 整数 注释 = "沿指定方向切分节点并返回该侧子节点标识。多级切分请改用构建全屏停靠区。" 返回值注释 = "子节点标识" 折叠 @嵌入式方法 = "">
    参数 节点标识 <类型 = 整数 注释 = "被切分的节点标识">
    参数 方向值 <类型 = 整数 注释 = "切分方向，可用布局方向类中的常量">
    参数 比例 <类型 = 单精度小数 注释 = "该侧所占比例 0~1">
    {
        @ (int)::imcn::DockSplit((unsigned int)@<节点标识>, (int)@<方向值>, @<比例>)
    }

    方法 停靠窗口到节点 <公开 静态 注释 = "按窗口名把已存在的窗口停靠到节点上，首帧无效。" 折叠 @嵌入式方法 = "">
    参数 窗口名称 <类型 = 文本型 注释 = "窗口标题">
    参数 节点标识 <类型 = 整数 注释 = "目标节点标识">
    {
        @ ::imcn::DockWindow(IMCN_U8(@<窗口名称>), (unsigned int)@<节点标识>)
    }

    方法 完成停靠 <公开 静态 注释 = "结束一次布局构建。" 折叠 @嵌入式方法 = "">
    参数 节点标识 <类型 = 整数 注释 = "根节点标识">
    {
        @ ::imcn::DockFinish((unsigned int)@<节点标识>)
    }

    方法 构建全屏停靠区 <公开 静态 类型 = 整数 注释 = "每帧调用一次：创建铺满主视口的停靠宿主窗口，是否重建为真时一次性搭好左/右/下/中四区并回传子节点标识。" 返回值注释 = "停靠区标识" 折叠 @嵌入式方法 = "">
    参数 名称文本 <类型 = 文本型 注释 = "停靠区名称">
    参数 左比例 <类型 = 单精度小数 注释 = "左侧占比">
    参数 右比例 <类型 = 单精度小数 注释 = "右侧占比">
    参数 下比例 <类型 = 单精度小数 注释 = "底部占比">
    参数 是否重建 <类型 = 逻辑型 注释 = "真 = 重建布局">
    参数 左节点变量 <类型 = 整数 @需求类型 = 可写入变量 注释 = "回传左侧节点">
    参数 右节点变量 <类型 = 整数 @需求类型 = 可写入变量 注释 = "回传右侧节点">
    参数 下节点变量 <类型 = 整数 @需求类型 = 可写入变量 注释 = "回传底部节点">
    参数 中节点变量 <类型 = 整数 @需求类型 = 可写入变量 注释 = "回传中央节点（分裂后剩下的部分）">
    {
        @ (int)::imcn::DockBuildQuadFullViewport(IMCN_U8(@<名称文本>), @<左比例>, @<右比例>, @<下比例>, (bool)@<是否重建>, &@<左节点变量>, &@<右节点变量>, &@<下节点变量>, &@<中节点变量>)
    }

    方法 构建四区停靠 <公开 静态 类型 = 整数 注释 = "创建铺满窗口的四区停靠布局，并把四个名字指定的窗口分别停靠到左/右/底/中央。窗口必须用\"开始\"按这些名字创建（尚未创建也没关系，同帧稍后创建即可）。这是把右侧、底部窗口真正挂上停靠树的正确做法。" 返回值注释 = "停靠区标识" 折叠 @嵌入式方法 = "">
    参数 区名 <类型 = 文本型 注释 = "停靠区唯一名称">
    参数 左窗口名 <类型 = 文本型 注释 = "要停到左侧的窗口标题，空文本表示不指定">
    参数 右窗口名 <类型 = 文本型 注释 = "要停到右侧的窗口标题，空文本表示不指定">
    参数 底部窗口名 <类型 = 文本型 注释 = "要停到底部的窗口标题，空文本表示不指定">
    参数 中央窗口名 <类型 = 文本型 注释 = "要停到中央的窗口标题，空文本表示不指定">
    参数 左比例 <类型 = 单精度小数 注释 = "左侧宽度占比，例如 0.25" @默认值 = 0.25>
    参数 右比例 <类型 = 单精度小数 注释 = "右侧宽度占比" @默认值 = 0.2>
    参数 底部比例 <类型 = 单精度小数 注释 = "底部高度占比" @默认值 = 0.3>
    参数 是否重建 <类型 = 逻辑型 注释 = "真表示每帧重建布局（会重置用户拖动结果）" @默认值 = 假>
    {
        @ (int)::imcn::DockBuildQuadWindows(IMCN_U8(@<区名>), @<左比例>, @<右比例>, @<底部比例>, IMCN_U8(@<左窗口名>), IMCN_U8(@<右窗口名>), IMCN_U8(@<底部窗口名>), IMCN_U8(@<中央窗口名>), (int)@<是否重建>, NULL, NULL, NULL, NULL)
    }

    方法 取停靠诊断 <公开 静态 类型 = 文本型 注释 = "取回四个窗口当前是否已被停靠，以及它们的位置、尺寸与所属停靠节点，用于排查停靠布局没生效的问题。节点值为 0 表示窗口仍在浮动。" 返回值注释 = "每个窗口一行的诊断文本" 折叠 @嵌入式方法 = "">
    参数 窗口一 <类型 = 文本型 注释 = "第一个窗口标题">
    参数 窗口二 <类型 = 文本型 注释 = "第二个窗口标题，可留空">
    参数 窗口三 <类型 = 文本型 注释 = "第三个窗口标题，可留空">
    参数 窗口四 <类型 = 文本型 注释 = "第四个窗口标题，可留空">
    {
        @ CVolString(::imcn::ToW(::imcn::DockProbeText(IMCN_U8(@<窗口一>), IMCN_U8(@<窗口二>), IMCN_U8(@<窗口三>), IMCN_U8(@<窗口四>))).c_str())
    }

    方法 取窗口停靠标识 <公开 静态 类型 = 整数 注释 = "按窗口标题查询停靠节点，-1 未创建，0 浮动。" 返回值注释 = "停靠节点标识" 折叠 @嵌入式方法 = "">
    参数 窗口名称 <类型 = 文本型 注释 = "窗口标题">
    {
        @ ::imcn::WindowDockId(IMCN_U8(@<窗口名称>))
    }


    # 布局与光标查询 | Layout & Cursor

    方法 取光标横向位置 <公开 静态 类型 = 单精度小数 注释 = "取回当前窗口内的光标横坐标（窗口局部坐标），用于自定义排版与对齐计算。" 返回值注释 = "光标横坐标" 折叠 @嵌入式方法 = "">
