        @ ImGui::IsItemFocused()
    }

    方法 取项目是否刚激活 <公开 静态 类型 = 逻辑型 注释 = "判断上一个控件是否在本帧被激活（例如刚按下鼠标开始拖动）。" 返回值注释 = "刚激活返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsItemActivated()
    }

    方法 取项目是否编辑后失焦 <公开 静态 类型 = 逻辑型 注释 = "判断上一个控件是否在编辑结束的瞬间失去激活状态，适合在此时提交数值。" 返回值注释 = "编辑后失焦返回真" 折叠 @嵌入式方法 = "">
