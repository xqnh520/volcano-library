<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 界面窗口 <公开 注释 = "窗口相关命令：创建窗口、设置窗口位置尺寸、子窗口、滚动区域、布局光标等。" 折叠>
{
    # 窗口 | Window

    方法 开始 <公开 静态 类型 = 逻辑型 注释 = "开始一个窗口，必须在\"结束\"之前使用；返回假时说明窗口被裁剪，不需要绘制内容。" 返回值注释 = "窗口可见时返回真" 折叠 @嵌入式方法 = "">
    参数 窗口标题 <类型 = 文本型 注释 = "窗口标题文本，可用\"##\"与\"###\"控制窗口ID">
    参数 窗口标志值 <类型 = 整数 注释 = "窗口标志，可用\"窗口标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::Begin(IMCN_U8(@<窗口标题>), NULL, (ImGuiWindowFlags)@<窗口标志值>)
    }

    方法 结束 <公开 静态 注释 = "结束一个窗口，必须与\"开始\"成对使用。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::End()
    }

    方法 开始子窗口 <公开 静态 类型 = 逻辑型 注释 = "开始一个子窗口（带独立滚动区的区域）。" 返回值注释 = "子窗口可见时返回真" 折叠 @嵌入式方法 = "">
    参数 子窗口ID <类型 = 文本型 注释 = "子窗口的唯一ID文本">
    参数 子窗口尺寸 <类型 = 二维坐标值 注释 = "子窗口尺寸，(0,0) 表示自动占满剩余空间" @默认值 = 二维坐标值默认值.零值>
    参数 子窗口标志值 <类型 = 整数 注释 = "子窗口标志，可用\"子窗口标志\"类中的常量" @默认值 = 0>
    参数 窗口标志值 <类型 = 整数 注释 = "窗口标志，可用\"窗口标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::BeginChild(IMCN_U8(@<子窗口ID>), @<子窗口尺寸>, (ImGuiChildFlags)@<子窗口标志值>, (ImGuiWindowFlags)@<窗口标志值>)
    }

    方法 结束子窗口 <公开 静态 注释 = "结束子窗口，必须与\"开始子窗口\"成对使用。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::EndChild()
    }

    方法 取是否首次出现 <公开 静态 类型 = 逻辑型 注释 = "当前窗口本帧是否刚刚出现（例如从隐藏切换为显示）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsWindowAppearing()
    }

    方法 取是否折叠 <公开 静态 类型 = 逻辑型 注释 = "当前窗口是否处于折叠状态。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsWindowCollapsed()
    }

    方法 取是否有焦点 <公开 静态 类型 = 逻辑型 注释 = "当前窗口是否拥有键盘焦点。" 折叠 @嵌入式方法 = "">
    参数 判定标志 <类型 = 整数 注释 = "焦点判定标志，可用\"焦点标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::IsWindowFocused((ImGuiFocusedFlags)@<判定标志>)
    }

    方法 取是否被悬停 <公开 静态 类型 = 逻辑型 注释 = "鼠标是否悬停在当前窗口上（未被弹出窗口遮挡）。" 折叠 @嵌入式方法 = "">
    参数 判定标志 <类型 = 整数 注释 = "悬停判定标志，可用\"悬停标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::IsWindowHovered((ImGuiHoveredFlags)@<判定标志>)
    }

    方法 取窗口绘制列表 <公开 静态 类型 = 绘制列表 注释 = "取回当前窗口的绘制列表，用于自绘图形。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetWindowDrawList()
    }

    方法 取窗口位置 <公开 静态 类型 = 二维坐标值 注释 = "取回当前窗口在屏幕坐标系中的左上角位置。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetWindowPos()
    }

    方法 取窗口尺寸 <公开 静态 类型 = 二维坐标值 注释 = "取回当前窗口的尺寸。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetWindowSize()
    }

    方法 取窗口宽度 <公开 静态 类型 = 单精度小数 注释 = "取回当前窗口宽度。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetWindowWidth()
    }

    方法 取窗口高度 <公开 静态 类型 = 单精度小数 注释 = "取回当前窗口高度。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetWindowHeight()
    }

    方法 置窗口位置 <公开 静态 注释 = "直接修改当前窗口位置，建议改用\"置下一窗口位置\"。" 折叠 @嵌入式方法 = "">
    参数 位置 <类型 = 二维坐标值 注释 = "新的窗口左上角屏幕坐标">
    参数 执行条件 <类型 = 整数 注释 = "执行条件，可用\"执行条件\"类中的常量" @默认值 = 0>
    {
        @ ImGui::SetWindowPos(@<位置>, (ImGuiCond)@<执行条件>)
    }

    方法 置窗口尺寸 <公开 静态 注释 = "直接修改当前窗口尺寸，建议改用\"置下一窗口尺寸\"。" 折叠 @嵌入式方法 = "">
    参数 尺寸 <类型 = 二维坐标值 注释 = "新的窗口尺寸">
    参数 执行条件 <类型 = 整数 注释 = "执行条件，可用\"执行条件\"类中的常量" @默认值 = 0>
    {
        @ ImGui::SetWindowSize(@<尺寸>, (ImGuiCond)@<执行条件>)
    }

    # 下一窗口参数 | SetNextWindow

    方法 置下一窗口位置 <公开 静态 注释 = "设置下一个创建的窗口的位置，必须在\"开始\"之前调用。" 折叠 @嵌入式方法 = "">
    参数 位置 <类型 = 二维坐标值 注释 = "窗口左上角屏幕坐标">
    参数 执行条件 <类型 = 整数 注释 = "执行条件，可用\"执行条件\"类中的常量" @默认值 = 0>
    参数 对齐比例 <类型 = 二维坐标值 注释 = "(0.5,0.5) 表示以窗口中心对齐给定坐标" @默认值 = 二维坐标值默认值.零值>
    {
        @ ImGui::SetNextWindowPos(@<位置>, (ImGuiCond)@<执行条件>, @<对齐比例>)
    }

    方法 置下一窗口尺寸 <公开 静态 注释 = "设置下一个创建的窗口的尺寸。" 折叠 @嵌入式方法 = "">
    参数 尺寸 <类型 = 二维坐标值 注释 = "窗口尺寸，某一轴填 0 表示该轴自动适应内容">
    参数 执行条件 <类型 = 整数 注释 = "执行条件，可用\"执行条件\"类中的常量" @默认值 = 0>
    {
        @ ImGui::SetNextWindowSize(@<尺寸>, (ImGuiCond)@<执行条件>)
    }

    方法 置下一窗口尺寸限制 <公开 静态 注释 = "限制下一个窗口可调整的最小与最大尺寸。" 折叠 @嵌入式方法 = "">
    参数 最小尺寸 <类型 = 二维坐标值 注释 = "最小尺寸">
    参数 最大尺寸 <类型 = 二维坐标值 注释 = "最大尺寸，可用很大的值表示不限制">
    {
        @ ImGui::SetNextWindowSizeConstraints(@<最小尺寸>, @<最大尺寸>, NULL, NULL)
    }

    方法 置下一窗口内容尺寸 <公开 静态 注释 = "设置下一个窗口的可滚动内容尺寸。" 折叠 @嵌入式方法 = "">
    参数 内容尺寸 <类型 = 二维坐标值 注释 = "内容尺寸，某一轴填 0 表示自动">
    {
        @ ImGui::SetNextWindowContentSize(@<内容尺寸>)
    }

    方法 置下一窗口折叠 <公开 静态 注释 = "设置下一个窗口是否为折叠状态。" 折叠 @嵌入式方法 = "">
    参数 是否折叠 <类型 = 逻辑型 注释 = "真为折叠">
    参数 执行条件 <类型 = 整数 注释 = "执行条件，可用\"执行条件\"类中的常量" @默认值 = 0>
    {
        @ ImGui::SetNextWindowCollapsed(@<是否折叠>, (ImGuiCond)@<执行条件>)
    }

    方法 置下一窗口获得焦点 <公开 静态 注释 = "让下一个窗口创建时获得焦点并置于顶层。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::SetNextWindowFocus()
    }

    方法 置下一窗口滚动值 <公开 静态 注释 = "设置下一个窗口的滚动位置，负值表示该轴不改变。" 折叠 @嵌入式方法 = "">
    参数 滚动值 <类型 = 二维坐标值 注释 = "横向与纵向滚动位置">
    {
        @ ImGui::SetNextWindowScroll(@<滚动值>)
    }

    方法 置下一窗口背景透明度 <公开 静态 注释 = "设置下一个窗口背景色的透明度。" 折叠 @嵌入式方法 = "">
    参数 透明度 <类型 = 单精度小数 注释 = "范围 0.0-1.0">
    {
        @ ImGui::SetNextWindowBgAlpha(@<透明度>)
    }

    方法 置窗口字体缩放 <公开 静态 注释 = "调整当前窗口内字体的缩放系数（作用于当前窗口，不是下一个窗口）。" 折叠 @嵌入式方法 = "">
    参数 缩放系数 <类型 = 单精度小数 注释 = "缩放倍数，1.0 表示不缩放">
    {
        @ ImGui::SetWindowFontScale(@<缩放系数>)
    }

    # 滚动 | Scrolling

    方法 取横向滚动值 <公开 静态 类型 = 单精度小数 注释 = "取回当前窗口的横向滚动值。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetScrollX()
    }

    方法 取纵向滚动值 <公开 静态 类型 = 单精度小数 注释 = "取回当前窗口的纵向滚动值。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetScrollY()
    }

    方法 置横向滚动值 <公开 静态 注释 = "设置当前窗口的横向滚动值。" 折叠 @嵌入式方法 = "">
    参数 滚动值 <类型 = 单精度小数 注释 = "欲设置的横向滚动位置">
    {
        @ ImGui::SetScrollX(@<滚动值>)
    }

    方法 置纵向滚动值 <公开 静态 注释 = "设置当前窗口的纵向滚动值。" 折叠 @嵌入式方法 = "">
    参数 滚动值 <类型 = 单精度小数 注释 = "欲设置的纵向滚动位置">
    {
        @ ImGui::SetScrollY(@<滚动值>)
    }

    方法 取横向最大滚动值 <公开 静态 类型 = 单精度小数 注释 = "取回当前窗口的横向最大滚动值。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetScrollMaxX()
    }

    方法 取纵向最大滚动值 <公开 静态 类型 = 单精度小数 注释 = "取回当前窗口的纵向最大滚动值。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetScrollMaxY()
    }

    方法 滚动到此横向位置 <公开 静态 注释 = "把横向滚动条移动到使当前项目可见的位置。" 折叠 @嵌入式方法 = "">
    参数 居中比例 <类型 = 单精度小数 注释 = "0.0 靠左、0.5 居中、1.0 靠右" @默认值 = 0.5>
    {
        @ ImGui::SetScrollHereX(@<居中比例>)
    }

    方法 滚动到此纵向位置 <公开 静态 注释 = "把纵向滚动条移动到使当前项目可见的位置。" 折叠 @嵌入式方法 = "">
    参数 居中比例 <类型 = 单精度小数 注释 = "0.0 靠上、0.5 居中、1.0 靠下" @默认值 = 0.5>
    {
        @ ImGui::SetScrollHereY(@<居中比例>)
    }

    方法 从横向比例滚动 <公开 静态 注释 = "把横向滚动条移动到指定局部比例位置。" 折叠 @嵌入式方法 = "">
    参数 局部位置 <类型 = 单精度小数 注释 = "窗口内容中的横向局部坐标">
    参数 居中比例 <类型 = 单精度小数 注释 = "0.0 靠左、0.5 居中、1.0 靠右" @默认值 = 0.5>
    {
        @ ImGui::SetScrollFromPosX(@<局部位置>, @<居中比例>)
    }

    方法 从纵向比例滚动 <公开 静态 注释 = "把纵向滚动条移动到指定局部比例位置。" 折叠 @嵌入式方法 = "">
    参数 局部位置 <类型 = 单精度小数 注释 = "窗口内容中的纵向局部坐标">
    参数 居中比例 <类型 = 单精度小数 注释 = "0.0 靠上、0.5 居中、1.0 靠下" @默认值 = 0.5>
    {
        @ ImGui::SetScrollFromPosY(@<局部位置>, @<居中比例>)
    }

    # 布局 | Layout

    方法 相同行 <公开 静态 注释 = "让后续项目与上一个项目处于同一行。" 折叠 @嵌入式方法 = "">
    参数 间距 <类型 = 单精度小数 注释 = "横向间距，-1 表示使用默认项目间距" @默认值 = -1>
    {
        @ ImGui::SameLine(@<间距>)
    }

    方法 换行 <公开 静态 注释 = "强制后续项目从新的一行开始。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::NewLine()
    }

    方法 分隔线 <公开 静态 注释 = "绘制一条水平分隔线。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::Separator()
    }

    方法 分隔文本 <公开 静态 注释 = "绘制一条带居中文本的分隔线。" 折叠 @嵌入式方法 = "">
    参数 文本内容 <类型 = 文本型 注释 = "分隔线中的文本">
    {
        @ ImGui::SeparatorText(IMCN_U8(@<文本内容>))
    }

    方法 间隔 <公开 静态 注释 = "插入一个空白占位，占用指定尺寸。" 折叠 @嵌入式方法 = "">
    参数 尺寸 <类型 = 二维坐标值 注释 = "占位尺寸">
    {
        @ ImGui::Dummy(@<尺寸>)
    }

    方法 缩进 <公开 静态 注释 = "增加一级缩进。" 折叠 @嵌入式方法 = "">
    参数 缩进宽度 <类型 = 单精度小数 注释 = "缩进像素宽度，0 表示使用默认缩进" @默认值 = 0>
    {
        @ ImGui::Indent(@<缩进宽度>)
    }

    方法 取消缩进 <公开 静态 注释 = "减少一级缩进。" 折叠 @嵌入式方法 = "">
    参数 缩进宽度 <类型 = 单精度小数 注释 = "缩进像素宽度，0 表示使用默认缩进" @默认值 = 0>
    {
        @ ImGui::Unindent(@<缩进宽度>)
    }

    方法 开始分组 <公开 静态 注释 = "开始一个逻辑分组，分组内的项目会作为整体参与布局。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::BeginGroup()
