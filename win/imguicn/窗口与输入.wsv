        @ ImGui::IsItemDeactivatedAfterEdit()
    }

    方法 取项目是否展开切换 <公开 静态 类型 = 逻辑型 注释 = "判断上一个树节点/折叠标题是否在本帧切换了展开状态。" 返回值注释 = "发生切换返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsItemToggledOpen()
    }

