    {
        @ ImGui::IsItemToggledSelection()
    }

    方法 取任意项目是否获得焦点 <公开 静态 类型 = 逻辑型 注释 = "判断当前是否任意控件持有键盘焦点。" 返回值注释 = "有控件获得焦点返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsAnyItemFocused()
    }

    方法 取矩形是否可见 <公开 静态 类型 = 逻辑型 注释 = "判断指定屏幕矩形是否与当前裁剪区域相交，可用于手工做粗裁剪以省掉大量绘制。" 返回值注释 = "可见返回真" 折叠 @嵌入式方法 = "">
    参数 左上角 <类型 = 二维坐标值 注释 = "矩形左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "矩形右下角屏幕坐标">
    {
        @ ImGui::IsRectVisible(@<左上角>, @<右下角>)
    }

    # 绘制列表取用与颜色 | DrawList & Colors

    方法 取背景绘制列表 <公开 静态 类型 = 变整数 注释 = "取回背景层绘制列表指针，可在所有窗口之下自定义绘制；配合\"绘制工具\"类使用。" 返回值注释 = "绘制列表指针" 折叠 @嵌入式方法 = "">
    {
        @ (long long)(intptr_t)ImGui::GetBackgroundDrawList()
    }

    方法 取前景绘制列表 <公开 静态 类型 = 变整数 注释 = "取回前景层绘制列表指针，可在所有窗口之上绘制覆盖提示、准星等。" 返回值注释 = "绘制列表指针" 折叠 @嵌入式方法 = "">
    {
        @ (long long)(intptr_t)ImGui::GetForegroundDrawList()
    }

    方法 取字体白色像素UV <公开 静态 类型 = 二维坐标值 注释 = "取回字体图集中纯白像素的纹理坐标，用于给自绘图形填充纯白色。" 返回值注释 = "UV 坐标" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetFontTexUvWhitePixel()
    }

    方法 取颜色值32 <公开 静态 类型 = 整数 注释 = "把样式颜色（含样式透明度）压成32位颜色值，可直接交给绘制列表。" 返回值注释 = "ABGR 打包颜色" 折叠 @嵌入式方法 = "">
    参数 颜色标识 <类型 = 整数 注释 = "样式颜色标识，可用\"颜色标识\"类中的常量">
    参数 透明度系数 <类型 = 单精度小数 注释 = "额外透明度倍数，1 表示原样" @默认值 = 1>
    {
        @ (int)ImGui::GetColorU32((ImGuiCol)@<颜色标识>, @<透明度系数>)
    }

    方法 取颜色值32由四维 <公开 静态 类型 = 整数 注释 = "把四维颜色压成32位颜色值，可直接交给绘制列表。" 返回值注释 = "ABGR 打包颜色" 折叠 @嵌入式方法 = "">
    参数 颜色 <类型 = 四维数值 注释 = "四维颜色（红绿蓝透明度，0~1）">
    参数 透明度系数 <类型 = 单精度小数 注释 = "额外透明度倍数，1 表示原样" @默认值 = 1>
    {
        @ (int)::imcn::ColorU32FromVec4(@<颜色>, @<透明度系数>)
    }

    方法 取样式颜色数值 <公开 静态 类型 = 四维数值 注释 = "取回样式表中保存的四维颜色（不含样式透明度），可再交给\"压入样式颜色\"。" 返回值注释 = "四维颜色" 折叠 @嵌入式方法 = "">
    参数 颜色标识 <类型 = 整数 注释 = "样式颜色标识，可用\"颜色标识\"类中的常量">
    {
        @ ImGui::GetStyleColorVec4((ImGuiCol)@<颜色标识>)
    }

    方法 取样式颜色名称 <公开 静态 类型 = 文本型 注释 = "取回样式颜色标识对应的英文名称，用于调试面板。" 返回值注释 = "颜色名称" 折叠 @嵌入式方法 = "">
    参数 颜色标识 <类型 = 整数 注释 = "样式颜色标识，可用\"颜色标识\"类中的常量">
    {
        @ CVolString(::imcn::ToW(ImGui::GetStyleColorName((ImGuiCol)@<颜色标识>)).c_str())
    }


    # 窗口存储与按键归属 | Storage & Key Owner

    方法 取窗口存储 <公开 静态 类型 = 变整数 注释 = "取回当前窗口的键值存储指针，可配合\"界面存储\"的引用式方法直接读写同一份数据。" 返回值注释 = "存储指针" 折叠 @嵌入式方法 = "">
    {
        @ (long long)(intptr_t)ImGui::GetStateStorage()
    }

    方法 置窗口存储 <公开 静态 注释 = "把当前窗口的键值存储替换成自己的存储，用于让多个窗口共享同一份状态。传 0 表示恢复为窗口自有存储。" 折叠 @嵌入式方法 = "">
    参数 存储指针 <类型 = 变整数 注释 = "由\"取窗口存储\"或其他途径取得的存储指针，0 表示恢复默认">
    {
        @ ImGui::SetStateStorage((ImGuiStorage*)(intptr_t)@<存储指针>)
    }

    方法 置项目按键归属 <公开 静态 注释 = "把上一个控件登记为某个按键的归属者：只有它悬停或激活时才消耗该按键，避免全局快捷键被误触发。须紧跟控件调用。" 折叠 @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用\"按键\"类中的常量">
    {
        @ ImGui::SetItemKeyOwner((ImGuiKey)@<按键码>)
    }

}
类 输入状态 <公开 注释 = "输入状态与后端交互查询：是否抢占键鼠、鼠标移动增量与滚轮、帧计数、配置文件开关、鼠标光标形状、按键重复次数、字体全局缩放。" 折叠>
{
    # 抢占状态 | Capture

    方法 取是否要键盘 <公开 静态 类型 = 逻辑型 注释 = "ImGui 是否正在使用键盘（有输入框获得焦点时通常为真），宿主程序可据此屏蔽自己的快捷键。" 返回值注释 = "需要键盘返回真" 折叠
            @嵌入式方法 = "">
    {
        @ ImGui::GetIO().WantCaptureKeyboard
    }

    方法 取是否要鼠标 <公开 静态 类型 = 逻辑型 注释 = "ImGui 是否正在使用鼠标（鼠标位于 ImGui 窗口内时通常为真），宿主程序可据此屏蔽自己的鼠标逻辑。" 返回值注释 = "需要鼠标返回真" 折叠
            @嵌入式方法 = "">
    {
        @ ImGui::GetIO().WantCaptureMouse
    }

    方法 取是否要输入文本 <公开 静态 类型 = 逻辑型 注释 = "ImGui 当前是否有输入框正在接收文字输入。" 返回值注释 = "正在输入文本返回真" 折叠
            @嵌入式方法 = "">
    {
        @ ImGui::GetIO().WantTextInput
    }

    # 鼠标与帧 | Mouse & Frame

    方法 取鼠标移动增量 <公开 静态 类型 = 二维坐标值 注释 = "取回本帧鼠标相对上一帧的移动增量。" 返回值注释 = "鼠标移动增量" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().MouseDelta
    }

    方法 取鼠标滚轮值 <公开 静态 类型 = 单精度小数 注释 = "取回本帧鼠标滚轮的滚动量，向上为正。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().MouseWheel
    }

    方法 取帧计数 <公开 静态 类型 = 整数 注释 = "取回自创建上下文以来已经渲染的帧数。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetFrameCount()
    }

    方法 取字体全局缩放 <公开 静态 类型 = 单精度小数 注释 = "取回字体全局缩放系数，1.0 表示原始大小。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().FontGlobalScale
    }

    # 配置文件 | Ini File

    方法 置配置文件路径 <公开 静态 注释 = "指定界面布局/窗口位置的保存文件路径；传空文本等价于关闭保存。路径会被内部转存，可安全传入临时文本。" 折叠
            @嵌入式方法 = "">
    参数 路径文本 <类型 = 文本型 注释 = "ini 文件路径，空文本表示不保存">
    {
        @ static std::string imcn_ini_path; imcn_ini_path = IMCN_U8(@<路径文本>); ImGui::GetIO().IniFilename = imcn_ini_path.empty() ? NULL : imcn_ini_path.c_str()
    }

    方法 关闭配置文件 <公开 静态 注释 = "关闭界面布局的自动保存与加载。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().IniFilename = NULL
    }

    # 鼠标光标 | Mouse Cursor

    方法 置鼠标光标 <公开 静态 注释 = "强制设置本帧的鼠标光标形状，可用\"鼠标光标\"类中的常量。" 折叠 @嵌入式方法 = "">
    参数 光标类型 <类型 = 整数 注释 = "光标类型，可用\"鼠标光标\"类中的常量">
    {
        @ ImGui::SetMouseCursor((ImGuiMouseCursor)@<光标类型>)
    }

    方法 取鼠标光标 <公开 静态 类型 = 整数 注释 = "取回本帧生效的鼠标光标类型。" 折叠 @嵌入式方法 = "">
    {
        @ (int)ImGui::GetMouseCursor()
    }

    # 按键 | Key

    方法 取按键按下次数 <公开 静态 类型 = 整数 注释 = "取回指定按键在本帧内产生的按下次数（已按重复延迟与重复间隔计算）。" 返回值注释 = "按下次数" 折叠
            @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用\"按键\"类中的常量">
    参数 重复延迟 <类型 = 单精度小数 注释 = "首次重复前的延迟秒数" @默认值 = 0.3>
    参数 重复间隔 <类型 = 单精度小数 注释 = "按住时的重复间隔秒数" @默认值 = 0.05>
    {
        @ ImGui::GetKeyPressedAmount((ImGuiKey)@<按键码>, @<重复延迟>, @<重复间隔>)
    }
    方法 取主视口位置 <公开 静态 类型 = 二维坐标值 注释 = "取回主视口左上角的屏幕坐标。" 返回值注释 = "主视口位置" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetMainViewport()->Pos
    }

    方法 取主视口尺寸 <公开 静态 类型 = 二维坐标值 注释 = "取回主视口的像素尺寸，可用于铺满全屏的界面布局。" 返回值注释 = "主视口尺寸" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetMainViewport()->Size
    }

    方法 取鼠标位置 <公开 静态 类型 = 二维坐标值 注释 = "取回鼠标当前屏幕坐标。" 返回值注释 = "鼠标坐标" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetMousePos()
    }

    方法 取鼠标拖动增量 <公开 静态 类型 = 二维坐标值 注释 = "取回按住鼠标以来的拖动位移，未超过拖动阈值时为零。" 返回值注释 = "拖动位移" 折叠 @嵌入式方法 = "">
    参数 鼠标按钮值 <类型 = 整数 注释 = "鼠标按钮，可用"鼠标按钮"类中的常量" @默认值 = 0>
    参数 锁定阈值 <类型 = 单精度小数 注释 = "起始死区像素，负值表示用系统设置" @默认值 = -1>
    {
        @ ImGui::GetMouseDragDelta((ImGuiMouseButton)@<鼠标按钮值>, @<锁定阈值>)
    }

    方法 注入UTF16字符 <公开 静态 注释 = "向 ImGui 提交一个 UTF-16 编码单元作为文本输入。" 折叠 @嵌入式方法 = "">
    参数 字符编码 <类型 = 整数 注释 = "UTF-16 编码单元">
    {
        @ ImGui::GetIO().AddInputCharacterUTF16((ImWchar16)@<字符编码>)
    }

    方法 注入字符 <公开 静态 注释 = "向 ImGui 提交一个 Unicode 码点作为文本输入。" 折叠 @嵌入式方法 = "">
    参数 字符码点 <类型 = 整数 注释 = "Unicode 码点，如 0x4E2D 表示"中"">
    {
        @ ImGui::GetIO().AddInputCharacter((unsigned int)@<字符码点>)
    }

    方法 注入按键 <公开 静态 注释 = "向 ImGui 提交一次按键按下/抬起事件。" 折叠 @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用"按键"类中的常量">
    参数 是否按下 <类型 = 逻辑型 注释 = "真表示按下，假表示抬起">
    {
        @ ImGui::GetIO().AddKeyEvent((ImGuiKey)@<按键码>, (bool)@<是否按下>)
    }

    方法 注入按键模拟量 <公开 静态 注释 = "提交带模拟量的按键事件，用于手柄扳机/摇杆。" 折叠 @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用"按键"类中的常量">
    参数 是否按下 <类型 = 逻辑型 注释 = "真表示按下">
    参数 模拟量 <类型 = 单精度小数 注释 = "0.0 ~ 1.0 的模拟量，数字按键传 1">
    {
        @ ImGui::GetIO().AddKeyAnalogEvent((ImGuiKey)@<按键码>, (bool)@<是否按下>, @<模拟量>)
    }

    方法 注入文本 <公开 静态 注释 = "把一整段文本（UTF-8）作为输入事件提交。" 折叠 @嵌入式方法 = "">
    参数 文本内容 <类型 = 文本型 注释 = "要提交的文本">
    {
        @ ImGui::GetIO().AddInputCharactersUTF8(IMCN_U8(@<文本内容>))
    }

    方法 注入焦点 <公开 静态 注释 = "通知 ImGui 窗口焦点变化。" 折叠 @嵌入式方法 = "">
    参数 是否获得焦点 <类型 = 逻辑型 注释 = "真表示获得焦点">
    {
        @ ImGui::GetIO().AddFocusEvent((bool)@<是否获得焦点>)
    }

    方法 注入鼠标位置 <公开 静态 注释 = "向 ImGui 提交一次鼠标位置事件。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 单精度小数 注释 = "鼠标 X 坐标">
    参数 纵坐标 <类型 = 单精度小数 注释 = "鼠标 Y 坐标">
    {
        @ ImGui::GetIO().AddMousePosEvent(@<横坐标>, @<纵坐标>)
    }

    方法 注入鼠标按钮 <公开 静态 注释 = "向 ImGui 提交一次鼠标按钮事件。" 折叠 @嵌入式方法 = "">
    参数 鼠标按钮值 <类型 = 整数 注释 = "鼠标按钮，可用"鼠标按钮"类中的常量">
    参数 是否按下 <类型 = 逻辑型 注释 = "真表示按下，假表示抬起">
    {
        @ ImGui::GetIO().AddMouseButtonEvent((int)@<鼠标按钮值>, (bool)@<是否按下>)
    }

    方法 注入鼠标来源 <公开 静态 注释 = "通知 ImGui 当前指针来源（鼠标/触摸/手柄）。" 折叠 @嵌入式方法 = "">
    参数 来源值 <类型 = 整数 注释 = "鼠标来源，可用"鼠标来源"类中的常量">
    {
        @ ImGui::GetIO().AddMouseSourceEvent((ImGuiMouseSource)@<来源值>)
    }

    方法 注入鼠标滚轮 <公开 静态 注释 = "向 ImGui 提交一次滚轮事件。" 折叠 @嵌入式方法 = "">
    参数 滚动量 <类型 = 单精度小数 注释 = "滚轮增量，一格通常为 1.0">
    {
        @ ImGui::GetIO().AddMouseWheelEvent(0.0f, @<滚动量>)
    }

    方法 清空事件队列 <公开 静态 注释 = "丢弃尚在队列中、本帧还未处理的输入事件。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().ClearEventsQueue()
    }

    方法 清空输入字符 <公开 静态 注释 = "清除本帧已累积的文本输入字符。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().ClearInputCharacters()
    }

    方法 清空输入按键 <公开 静态 注释 = "清除全部按键状态与本帧文本输入。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().ClearInputKeys()
    }

    方法 清空输入鼠标 <公开 静态 注释 = "清除全部鼠标状态。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().ClearInputMouse()
    }

    方法 置接受事件 <公开 静态 注释 = "开关 ImGui 是否接受键鼠与文本事件（默认接受）。" 折叠 @嵌入式方法 = "">
    参数 是否接受 <类型 = 逻辑型 注释 = "假表示暂时屏蔽全部输入">
    {
        @ ImGui::GetIO().SetAppAcceptingEvents((bool)@<是否接受>)
    }

    方法 重置鼠标拖动增量 <公开 静态 注释 = "把鼠标拖动位移清零。" 折叠 @嵌入式方法 = "">
    参数 鼠标按钮值 <类型 = 整数 注释 = "鼠标按钮，可用"鼠标按钮"类中的常量" @默认值 = 0>
    {
        @ ImGui::ResetMouseDragDelta((ImGuiMouseButton)@<鼠标按钮值>)
    }


    # 鼠标与按键查询 | Mouse & Key Query

    方法 取鼠标点击次数 <公开 静态 类型 = 整数 注释 = "取回本帧鼠标按键的连击次数，1 单击、2 双击。" 返回值注释 = "连击次数" 折叠 @嵌入式方法 = "">
    参数 鼠标按钮 <类型 = 整数 注释 = "0 左键、1 右键、2 中键">
    {
        @ ImGui::GetMouseClickedCount((ImGuiMouseButton)@<鼠标按钮>)
    }

    方法 取鼠标是否释放 <公开 静态 类型 = 逻辑型 注释 = "判断本帧鼠标按键是否刚抬起。" 返回值注释 = "刚抬起返回真" 折叠 @嵌入式方法 = "">
    参数 鼠标按钮 <类型 = 整数 注释 = "0 左键、1 右键、2 中键">
    {
        @ ImGui::IsMouseReleased((ImGuiMouseButton)@<鼠标按钮>)
    }

    方法 取鼠标延迟释放 <公开 静态 类型 = 逻辑型 注释 = "判断鼠标按键是否在抬起后经过了指定延迟帧数，常用于区分单击与拖拽结束。" 返回值注释 = "满足延迟返回真" 折叠 @嵌入式方法 = "">
    参数 鼠标按钮 <类型 = 整数 注释 = "0 左键、1 右键、2 中键">
    参数 延迟帧数 <类型 = 整数 注释 = "抬起后需经过的帧数">
    {
        @ ImGui::IsMouseReleased((ImGuiMouseButton)@<鼠标按钮>, @<延迟帧数>)
    }

    方法 取鼠标是否任意按下 <公开 静态 类型 = 逻辑型 注释 = "判断是否有任意鼠标按键处于按下状态。" 返回值注释 = "有按键按下返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsAnyMouseDown()
    }

    方法 取鼠标是否在矩形内 <公开 静态 类型 = 逻辑型 注释 = "判断鼠标位置是否落在指定屏幕矩形内，可选择是否再判裁剪区域。" 返回值注释 = "在矩形内返回真" 折叠 @嵌入式方法 = "">
    参数 左上角 <类型 = 二维坐标值 注释 = "矩形左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "矩形右下角屏幕坐标">
    参数 是否排除裁剪 <类型 = 逻辑型 注释 = "真表示同时判断是否被裁剪掉" @默认值 = 真>
    {
        @ ImGui::IsMouseHoveringRect(@<左上角>, @<右下角>, (bool)@<是否排除裁剪>)
    }

    方法 取鼠标位置是否有效 <公开 静态 类型 = 逻辑型 注释 = "判断鼠标坐标是否为有效值（鼠标移出窗口时坐标可能为极大的负数）。" 返回值注释 = "有效返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsMousePosValid()
    }

    方法 取按键名称 <公开 静态 类型 = 文本型 注释 = "取回按键码对应的英文名称，仅用于调试显示。" 返回值注释 = "按键名称" 折叠 @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用\"按键\"类中的常量">
    {
        @ CVolString(::imcn::ToW(ImGui::GetKeyName((ImGuiKey)@<按键码>)).c_str())
    }

    方法 取按键组合是否按下 <公开 静态 类型 = 逻辑型 注释 = "判断\"修饰键+主键\"的组合是否在本帧按下，不做焦点与路由判断。" 返回值注释 = "组合按下返回真" 折叠 @嵌入式方法 = "">
    参数 组合码 <类型 = 整数 注释 = "按键码与修饰键按位或后的组合值">
    {
        @ ImGui::IsKeyChordPressed((ImGuiKeyChord)@<组合码>)
    }

    # 配置文件读写 | Ini Files

    方法 保存配置到文件 <公开 静态 注释 = "把当前窗口布局与表格设置写入指定的 ini 文件，路径支持中文。" 折叠 @嵌入式方法 = "">
    参数 文件路径 <类型 = 文本型 注释 = "ini 文件的完整路径">
    {
        @ ImGui::SaveIniSettingsToDisk(IMCN_U8(@<文件路径>))
    }

    方法 从文件载入配置 <公开 静态 注释 = "从 ini 文件恢复窗口布局，须在创建上下文之后、首帧之前调用。" 折叠 @嵌入式方法 = "">
    参数 文件路径 <类型 = 文本型 注释 = "ini 文件的完整路径">
    {
        @ ImGui::LoadIniSettingsFromDisk(IMCN_U8(@<文件路径>))
    }


    # 下一帧输入捕获 | Next Frame Capture

    方法 置下一帧要键盘 <公开 静态 注释 = "强制指定下一帧界面是否接收键盘。用于鼠标悬停在自绘控件上时抢先拿到键盘，避免快捷键被宿主程序吃掉。" 折叠 @嵌入式方法 = "">
    参数 是否要键盘 <类型 = 逻辑型 注释 = "真表示下一帧由界面接收键盘">
    {
        @ ImGui::SetNextFrameWantCaptureKeyboard((bool)@<是否要键盘>)
    }

    方法 置下一帧要鼠标 <公开 静态 注释 = "强制指定下一帧界面是否接收鼠标。用于界面完全隐藏时仍然拦截鼠标，或反过来把鼠标让给宿主程序。" 折叠 @嵌入式方法 = "">
    参数 是否要鼠标 <类型 = 逻辑型 注释 = "真表示下一帧由界面接收鼠标">
    {
        @ ImGui::SetNextFrameWantCaptureMouse((bool)@<是否要鼠标>)
    }


    # 弹窗与导航光标 | Popup & Nav Cursor

    方法 取弹出打开时鼠标位置 <公开 静态 类型 = 二维坐标值 注释 = "取回当前弹窗被打开那一刻的鼠标屏幕坐标，画右键菜单位置标记时不必自己记账。" 返回值注释 = "打开时的鼠标坐标" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetMousePosOnOpeningCurrentPopup()
    }

    方法 置导航光标可见 <公开 静态 注释 = "强制显示或隐藏键盘导航光标。默认行为是用方向键时显示、点鼠标时隐藏，做手柄界面时可固定为可见。" 折叠 @嵌入式方法 = "">
    参数 是否可见 <类型 = 逻辑型 注释 = "真表示显示导航光标">
    {
        @ ImGui::SetNavCursorVisible((bool)@<是否可见>)
    }

}
