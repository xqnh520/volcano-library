<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 即时界面 <公开 注释 = "ImGui 核心类：负责上下文创建、帧循环、输入注入、样式设置与调试窗口。典型用法：创建上下文 → 循环{ 开始新帧 → 绘制界面 → 渲染 → 后端渲染 }。" 折叠>
{
    # 上下文 | 生命周期

    方法 检查版本 <公开 静态 注释 = "校验头文件与编译版本是否一致，建议在创建上下文之前调用一次。" 折叠 @嵌入式方法 = "">
    {
        @ IMGUI_CHECKVERSION()
    }

    方法 创建上下文 <公开 静态 注释 = "创建 ImGui 上下文，并设置为当前上下文。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::CreateContext()
    }

    方法 销毁上下文 <公开 静态 注释 = "销毁当前 ImGui 上下文，释放全部资源。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::DestroyContext()
    }

    方法 取版本 <公开 静态 类型 = 文本型 注释 = "返回编译进来的 ImGui 版本号文本，例如 \"1.91.9b\"。" 返回值注释 = "版本号文本" 折叠
            @嵌入式方法 = "">
    {
        @ CVolString(::imcn::ToW(ImGui::GetVersion()).c_str())
    }

    # 帧循环 | Frame

    方法 开始新帧 <公开 静态 注释 = "开始一帧，之后即可提交全部界面代码；必须与\"渲染\"成对调用。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::NewFrame()
    }

    方法 结束帧 <公开 静态 注释 = "结束一帧（\"渲染\"内部会自动调用），仅在不渲染时需要手动调用。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::EndFrame()
    }

    方法 渲染 <公开 静态 注释 = "结束一帧并生成绘制数据，随后用\"取绘制数据\"取出并交给渲染后端。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::Render()
    }

    方法 取绘制数据 <公开 静态 类型 = 绘制数据 注释 = "取回本帧的绘制数据，仅在渲染之后到下一次开始新帧之前有效。" 返回值注释 = "绘制数据指针" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetDrawData()
    }

    # 输入注入 | IO

    方法 取配置标志 <公开 静态 类型 = 整数 注释 = "取回 IO 配置标志，返回值见\"配置标志\"类。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().ConfigFlags
    }

    方法 添加配置标志 <公开 静态 注释 = "按位或方式添加 IO 配置标志。" 折叠 @嵌入式方法 = "">
    参数 标志值 <类型 = 整数 注释 = "欲添加的配置标志，可用\"配置标志\"类中的常量组合">
    {
        @ ImGui::GetIO().ConfigFlags |= (ImGuiConfigFlags)@<标志值>
    }

    方法 移除配置标志 <公开 静态 注释 = "按位与非方式移除 IO 配置标志。" 折叠 @嵌入式方法 = "">
    参数 标志值 <类型 = 整数 注释 = "欲移除的配置标志">
    {
        @ ImGui::GetIO().ConfigFlags &= ~(ImGuiConfigFlags)@<标志值>
    }

    方法 取后端标志 <公开 静态 类型 = 整数 注释 = "取回后端能力标志，返回值见\"后端标志\"类。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().BackendFlags
    }

    方法 置显示尺寸 <公开 静态 注释 = "设置绘制目标的像素尺寸，窗口尺寸变化时必须调用。" 折叠 @嵌入式方法 = "">
    参数 宽度 <类型 = 单精度小数 注释 = "绘制目标宽度（像素）">
    参数 高度 <类型 = 单精度小数 注释 = "绘制目标高度（像素）">
    {
        @ ImGui::GetIO().DisplaySize = ImVec2(@<宽度>, @<高度>)
    }

    方法 取显示尺寸 <公开 静态 类型 = 二维坐标值 注释 = "取回绘制目标的像素尺寸。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().DisplaySize
    }

    方法 置增量时间 <公开 静态 注释 = "设置本帧与上一帧的时间间隔（秒），用于动画与双击判定。" 折叠 @嵌入式方法 = "">
    参数 秒数 <类型 = 单精度小数 注释 = "时间间隔，单位为秒">
    {
        @ ImGui::GetIO().DeltaTime = @<秒数>
    }

    方法 取增量时间 <公开 静态 类型 = 单精度小数 注释 = "取回本帧与上一帧的时间间隔（秒）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().DeltaTime
    }

    方法 取帧率 <公开 静态 类型 = 单精度小数 注释 = "取回最近一段时间的平均帧率（帧/秒）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Framerate
    }

    方法 置鼠标位置 <公开 静态 注释 = "设置鼠标在绘制目标中的像素位置。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 单精度小数 注释 = "鼠标横坐标">
    参数 纵坐标 <类型 = 单精度小数 注释 = "鼠标纵坐标">
    {
        @ ImGui::GetIO().AddMousePosEvent(@<横坐标>, @<纵坐标>)
    }

    方法 取鼠标位置 <公开 静态 类型 = 二维坐标值 注释 = "取回鼠标在绘制目标中的像素位置。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().MousePos
    }

    方法 置鼠标按键 <公开 静态 注释 = "设置某个鼠标按键的按下状态。" 折叠 @嵌入式方法 = "">
    参数 鼠标键 <类型 = 整数 注释 = "鼠标按键，可用\"鼠标按钮\"类中的常量">
    参数 是否按下 <类型 = 逻辑型 注释 = "真为按下，假为释放">
    {
        @ ImGui::GetIO().AddMouseButtonEvent((int)@<鼠标键>, @<是否按下>)
    }

    方法 置鼠标滚轮 <公开 静态 注释 = "设置鼠标滚轮增量（横向与纵向）。" 折叠 @嵌入式方法 = "">
    参数 横向增量 <类型 = 单精度小数 注释 = "横向滚轮增量，一般填 0">
    参数 纵向增量 <类型 = 单精度小数 注释 = "纵向滚轮增量，向上为正">
    {
        @ ImGui::GetIO().AddMouseWheelEvent(@<横向增量>, @<纵向增量>)
    }

    方法 置按键状态 <公开 静态 注释 = "设置某个按键的按下状态。" 折叠 @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用\"按键\"类中的常量">
    参数 是否按下 <类型 = 逻辑型 注释 = "真为按下，假为释放">
    {
        @ ImGui::GetIO().AddKeyEvent((ImGuiKey)@<按键码>, @<是否按下>)
    }

    方法 添加输入字符 <公开 静态 注释 = "向 ImGui 提交一段文本输入（UTF-8 内部会自动转换）。" 折叠 @嵌入式方法 = "">
    参数 输入文本 <类型 = 文本型 注释 = "用户输入的文本">
    {
        @ ImGui::GetIO().AddInputCharactersUTF8(IMCN_U8(@<输入文本>))
    }

    方法 取按键是否按下 <公开 静态 类型 = 逻辑型 注释 = "判断某个按键当前是否处于按下状态。" 返回值注释 = "按下返回真" 折叠 @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用\"按键\"类中的常量">
    {
        @ ImGui::IsKeyDown((ImGuiKey)@<按键码>)
    }

    方法 取按键是否触发 <公开 静态 类型 = 逻辑型 注释 = "判断某个按键本帧是否刚被按下（含自动重复）。" 返回值注释 = "触发返回真" 折叠
            @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用\"按键\"类中的常量">
    参数 允许重复 <类型 = 逻辑型 注释 = "真为允许按住时重复触发" @默认值 = 真>
    {
        @ ImGui::IsKeyPressed((ImGuiKey)@<按键码>, @<允许重复>)
    }

    方法 取按键是否释放 <公开 静态 类型 = 逻辑型 注释 = "判断某个按键本帧是否刚被释放。" 返回值注释 = "释放返回真" 折叠 @嵌入式方法 = "">
    参数 按键码 <类型 = 整数 注释 = "按键码，可用\"按键\"类中的常量">
    {
        @ ImGui::IsKeyReleased((ImGuiKey)@<按键码>)
    }

    方法 取鼠标是否按下 <公开 静态 类型 = 逻辑型 注释 = "判断某个鼠标按键当前是否处于按下状态。" 返回值注释 = "按下返回真" 折叠
            @嵌入式方法 = "">
    参数 鼠标键 <类型 = 整数 注释 = "鼠标按键，可用\"鼠标按钮\"类中的常量" @默认值 = 0>
    {
        @ ImGui::IsMouseDown((ImGuiMouseButton)@<鼠标键>)
    }

    方法 取鼠标是否单击 <公开 静态 类型 = 逻辑型 注释 = "判断某个鼠标按键本帧是否发生单击。" 返回值注释 = "单击返回真" 折叠
            @嵌入式方法 = "">
    参数 鼠标键 <类型 = 整数 注释 = "鼠标按键，可用\"鼠标按钮\"类中的常量" @默认值 = 0>
    {
        @ ImGui::IsMouseClicked((ImGuiMouseButton)@<鼠标键>)
    }

    方法 取鼠标是否双击 <公开 静态 类型 = 逻辑型 注释 = "判断某个鼠标按键本帧是否发生双击。" 返回值注释 = "双击返回真" 折叠
            @嵌入式方法 = "">
    参数 鼠标键 <类型 = 整数 注释 = "鼠标按键，可用\"鼠标按钮\"类中的常量" @默认值 = 0>
    {
        @ ImGui::IsMouseDoubleClicked((ImGuiMouseButton)@<鼠标键>)
    }

    方法 取鼠标是否拖动 <公开 静态 类型 = 逻辑型 注释 = "判断某个鼠标按键是否正在拖动。" 返回值注释 = "正在拖动返回真" 折叠
            @嵌入式方法 = "">
    参数 鼠标键 <类型 = 整数 注释 = "鼠标按键，可用\"鼠标按钮\"类中的常量" @默认值 = 0>
    {
        @ ImGui::IsMouseDragging((ImGuiMouseButton)@<鼠标键>, 0.0f)
    }

    方法 取鼠标拖动距离 <公开 静态 类型 = 二维坐标值 注释 = "取回某个鼠标按键自按下以来的拖动距离。" 折叠 @嵌入式方法 = "">
    参数 鼠标键 <类型 = 整数 注释 = "鼠标按键，可用\"鼠标按钮\"类中的常量" @默认值 = 0>
    {
        @ ImGui::GetMouseDragDelta((ImGuiMouseButton)@<鼠标键>)
    }

    方法 复位鼠标拖动距离 <公开 静态 注释 = "把某个鼠标按键的拖动距离清零。" 折叠 @嵌入式方法 = "">
    参数 鼠标键 <类型 = 整数 注释 = "鼠标按键，可用\"鼠标按钮\"类中的常量" @默认值 = 0>
    {
        @ ImGui::ResetMouseDragDelta((ImGuiMouseButton)@<鼠标键>)
    }

    方法 取剪贴板文本 <公开 静态 类型 = 文本型 注释 = "取回 ImGui 当前使用的剪贴板文本。" 折叠 @嵌入式方法 = "">
    {
        @ CVolString(::imcn::ToW(ImGui::GetClipboardText()).c_str())
    }

    方法 置剪贴板文本 <公开 静态 注释 = "设置 ImGui 使用的剪贴板文本。" 折叠 @嵌入式方法 = "">
    参数 文本内容 <类型 = 文本型 注释 = "欲写入剪贴板的文本">
    {
        @ ImGui::SetClipboardText(IMCN_U8(@<文本内容>))
    }

    # 样式 | Style

    方法 取样式 <公开 静态 类型 = 样式数据 注释 = "取回全局样式对象指针。" 折叠 @嵌入式方法 = "">
    {
        @ &ImGui::GetStyle()
    }

    方法 置样式颜色 <公开 静态 注释 = "设置某个样式标识对应的颜色。" 折叠 @嵌入式方法 = "">
    参数 颜色标识 <类型 = 整数 注释 = "颜色标识，可用\"颜色标识\"类中的常量">
    参数 颜色值 <类型 = 四维数值 注释 = "欲设置的颜色 (红, 绿, 蓝, 透明)">
    {
        @ ImGui::GetStyle().Colors[@<颜色标识>] = @<颜色值>
    }

    方法 取样式颜色 <公开 静态 类型 = 四维数值 注释 = "取回某个样式标识对应的颜色。" 折叠 @嵌入式方法 = "">
    参数 颜色标识 <类型 = 整数 注释 = "颜色标识，可用\"颜色标识\"类中的常量">
    {
        @ ImGui::GetStyle().Colors[@<颜色标识>]
    }

    方法 缩放全部尺寸 <公开 静态 注释 = "把样式中全部尺寸按比例缩放，用于适配高分屏。" 折叠 @嵌入式方法 = "">
    参数 缩放系数 <类型 = 单精度小数 注释 = "缩放倍数，1.0 表示不缩放">
    {
        @ ImGui::GetStyle().ScaleAllSizes(@<缩放系数>)
    }

    方法 使用深色样式 <公开 静态 注释 = "应用 ImGui 推荐的深色配色（默认）。" 折叠 @嵌入式方法 = "">
