    方法 取项目矩形最大坐标 <公开 静态 类型 = 二维坐标值 注释 = "取回上一个项目矩形的右下角屏幕坐标。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetItemRectMax()
    }

    方法 取项目矩形尺寸 <公开 静态 类型 = 二维坐标值 注释 = "取回上一个项目矩形的尺寸。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetItemRectSize()
    }

    方法 置项目提示 <公开 静态 注释 = "为上一个项目设置鼠标悬停提示文本。" 折叠 @嵌入式方法 = "">
    参数 提示文本 <类型 = 文本型 注释 = "悬停时显示的文本">
    {
        @ ImGui::SetItemTooltip("%s", IMCN_U8(@<提示文本>))
    }

    # 配置持久化 | Ini Persistence

    方法 保存配置文本 <公开 静态 类型 = 文本型 注释 = "把当前窗口布局/表格设置等导出为 ini 文本，可自行保存到文件。" 返回值注释 = "ini 配置文本" 折叠 @嵌入式方法 = "">
    {
        @ CVolString(::imcn::ToW(ImGui::SaveIniSettingsToMemory()).c_str())
    }

    方法 载入配置文本 <公开 静态 注释 = "从 ini 文本恢复窗口布局/表格设置。须在创建上下文之后、首帧之前调用。" 折叠 @嵌入式方法 = "">
    参数 配置文本 <类型 = 文本型 注释 = "由\"保存配置文本\"导出的文本">
    {
        @ ImGui::LoadIniSettingsFromMemory(IMCN_U8(@<配置文本>))
    }


    # 日志捕获 | Logging
    # 把此后绘制的界面文本原样记录下来，适合做使用手册截图、问题复现或把界面导出成文本。

    方法 开始日志到文件 <公开 静态 注释 = "开始把此后绘制的界面文本记录到当前工作目录的 imgui_log.txt（追加模式），适合做使用手册素材或问题复现记录。必须与\"结束日志\"配对，否则文件句柄不释放。工作目录或该文件不可写时 ImGui 会直接断言退出（无返回值、无降级），调用前必须确保可写。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::LogToFile(-1, NULL)
    }

    方法 开始日志到终端 <公开 静态 注释 = "开始把此后绘制的界面文本输出到标准输出（控制台），用于没有界面的自动化检查。必须与\"结束日志\"配对。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::LogToTTY(-1)
    }

    方法 开始日志到剪贴板 <公开 静态 注释 = "开始把此后绘制的界面文本收集到系统剪贴板，结束后可直接粘贴给别人。必须与\"结束日志\"配对。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::LogToClipboard(-1)
    }

    方法 结束日志 <公开 静态 注释 = "结束当前正在进行的日志捕获（关闭文件、刷新终端输出或写入剪贴板）。没有开始过日志时调用无副作用。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::LogFinish()
    }

    方法 追加日志文本 <公开 静态 注释 = "把一段文本直接写进当前日志，不显示在界面上，用于补充说明行。必须在开始日志之后、结束日志之前调用。" 折叠 @嵌入式方法 = "">
    参数 日志文本 <类型 = 文本型 注释 = "要写入日志的文本">
    {
        @ ImGui::LogText("%s", IMCN_U8(@<日志文本>))
    }

    方法 日志按钮组 <公开 静态 注释 = "插入一组现成的日志开关按钮：输出到终端 / 文件 / 剪贴板。一般只在调试窗口里使用，一行三个按钮。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::LogButtons()
    }

    # 样式栈 | Style Stack
    # 只在本帧临时改变外观，弹出后立即还原，不影响全局样式表。

    方法 压入样式颜色 <公开 静态 注释 = "临时替换一个样式颜色，需与\"弹出样式颜色\"配对。压入后本帧余下绘制的控件都受影响，常用于高亮一整个区块。" 折叠 @嵌入式方法 = "">
    参数 颜色标识 <类型 = 整数 注释 = "样式颜色标识，可用\"颜色标识\"类中的常量">
    参数 颜色值 <类型 = 四维数值 注释 = "新的颜色（红绿蓝透明度，0~1）">
    {
        @ ImGui::PushStyleColor((ImGuiCol)@<颜色标识>, @<颜色值>)
    }

    方法 弹出样式颜色 <公开 静态 注释 = "恢复\"压入样式颜色\"之前的颜色，层数要与压入次数一致，否则样式栈会错位。" 折叠 @嵌入式方法 = "">
    参数 弹出层数 <类型 = 整数 注释 = "要恢复的层数" @默认值 = 1>
    {
        @ ImGui::PopStyleColor(@<弹出层数>)
    }

    方法 压入样式变量X <公开 静态 注释 = "只改一个二维样式变量的横向分量（例如\"控件内边距\"的左右值），需与\"弹出样式变量\"配对。标识必须是二维类型的样式变量，否则会触发断言。" 折叠 @嵌入式方法 = "">
    参数 样式变量标识 <类型 = 整数 注释 = "样式变量标识，可用\"样式标识\"类中的常量">
    参数 数值 <类型 = 单精度小数 注释 = "横向分量的新值">
    {
        @ ImGui::PushStyleVarX((ImGuiStyleVar)@<样式变量标识>, @<数值>)
    }

    方法 压入样式变量Y <公开 静态 注释 = "只改一个二维样式变量的纵向分量（例如\"控件内边距\"的上下值），需与\"弹出样式变量\"配对。标识必须是二维类型的样式变量，否则会触发断言。" 折叠 @嵌入式方法 = "">
    参数 样式变量标识 <类型 = 整数 注释 = "样式变量标识，可用\"样式标识\"类中的常量">
    参数 数值 <类型 = 单精度小数 注释 = "纵向分量的新值">
    {
        @ ImGui::PushStyleVarY((ImGuiStyleVar)@<样式变量标识>, @<数值>)
    }

    方法 弹出样式变量 <公开 静态 注释 = "恢复\"压入样式变量\"/\"压入样式变量X\"/\"压入样式变量Y\"之前的数值，层数要与压入次数一致。" 折叠 @嵌入式方法 = "">
    参数 弹出层数 <类型 = 整数 注释 = "要恢复的层数" @默认值 = 1>
    {
        @ ImGui::PopStyleVar(@<弹出层数>)
    }

    # 平台接口 | Platform IO

    方法 取平台输入输出 <公开 静态 类型 = 变整数 注释 = "取回平台/渲染后端接口结构（ImGuiPlatformIO）的裸指针，高级用法：可读取或替换剪贴板、输入法、多视口回调。返回 0 表示尚未创建上下文。" 返回值注释 = "平台接口指针" 折叠 @嵌入式方法 = "">
    {
        @ (long long)(intptr_t)&ImGui::GetPlatformIO()
    }


    # 日志落盘与编码排查 | Log to file & Encoding

    方法 开始日志到指定文件 <公开 静态 类型 = 逻辑型 注释 = "开始把此后绘制的界面文本追加写入指定文件，需与\"结束日志\"配对。写入前会先试探文件能否打开，打不开直接返回假且不启动日志，不会像\"开始日志到文件\"那样断言退出。" 返回值注释 = "成功开始日志返回真" 折叠 @嵌入式方法 = "">
    参数 文件路径 <类型 = 文本型 注释 = "日志文件完整路径，支持中文，父目录须已存在">
    {
        @ ::imcn::LogToFileW(IMCN_U8(@<文件路径>))
    }

    方法 调试文本编码 <公开 静态 注释 = "把一段文本的 UTF-8 字节与码点打印到调试日志窗口，专门用来排查中文乱码。须先调用\"显示调试日志窗口\"才能看到输出。" 折叠 @嵌入式方法 = "">
    参数 文本 <类型 = 文本型 注释 = "要检查的文本">
    {
        @ ImGui::DebugTextEncoding(IMCN_U8(@<文本>))
    }

}
