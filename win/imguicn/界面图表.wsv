<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 界面图表 <公开 注释 = "图表控件：折线图与直方图。数据先逐点写入缓冲区，再一次性绘制。" 折叠>
{
    # 数据缓冲 | Data Buffer

    方法 清空数据 <公开 静态 注释 = "清空图表数据缓冲区。" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::PlotClear()
    }

    方法 添加数据 <公开 静态 注释 = "向图表缓冲区追加一个数据点。" 折叠 @嵌入式方法 = "">
    参数 数值 <类型 = 单精度小数 注释 = "数据点的值">
    {
        @ ::imcn::PlotPush(@<数值>)
    }

    方法 取数据点数 <公开 静态 类型 = 整数 注释 = "取回缓冲区中已写入的数据点个数。" 返回值注释 = "数据点个数" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::PlotCount()
    }

    # 绘制 | Draw

    方法 绘制曲线 <公开 静态 类型 = 逻辑型 注释 = "把缓冲区数据画成折线图。缓冲区为空时返回假。" 返回值注释 = "绘制成功返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "图表标签">
    参数 最小刻度 <类型 = 单精度小数 注释 = "纵轴最小值" @默认值 = 0>
    参数 最大刻度 <类型 = 单精度小数 注释 = "纵轴最大值" @默认值 = 1>
    参数 图形尺寸 <类型 = 二维坐标值 注释 = "(0,0) 表示默认尺寸" @默认值 = 二维坐标值默认值.零值>
    参数 覆盖文本 <类型 = 文本型 注释 = "显示在图表左上角的文本" @默认值 = "">
    {
        @ ::imcn::PlotLinesW(IMCN_U8(@<标签文本>), IMCN_U8(@<覆盖文本>), @<最小刻度>, @<最大刻度>, @<图形尺寸>)
    }

    方法 绘制直方图 <公开 静态 类型 = 逻辑型 注释 = "把缓冲区数据画成柱状图。缓冲区为空时返回假。" 返回值注释 = "绘制成功返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "图表标签">
    参数 最小刻度 <类型 = 单精度小数 注释 = "纵轴最小值" @默认值 = 0>
    参数 最大刻度 <类型 = 单精度小数 注释 = "纵轴最大值" @默认值 = 1>
    参数 图形尺寸 <类型 = 二维坐标值 注释 = "(0,0) 表示默认尺寸" @默认值 = 二维坐标值默认值.零值>
    参数 覆盖文本 <类型 = 文本型 注释 = "显示在图表左上角的文本" @默认值 = "">
    {
        @ ::imcn::PlotHistogramW(IMCN_U8(@<标签文本>), IMCN_U8(@<覆盖文本>), @<最小刻度>, @<最大刻度>, @<图形尺寸>)
    }
}
