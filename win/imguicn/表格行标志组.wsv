类 表格行标志 <公开 注释 = "表格行标志，用于界面表格.下一行" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiTableRowFlags_None>
    常量 表头行 <公开 类型 = 整数 值 = @ImGuiTableRowFlags_Headers>
}
类 表格背景目标 <公开 注释 = "表格背景目标，用于界面表格.置背景色" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiTableBgTarget_None>
