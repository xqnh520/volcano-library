<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 排序方向 <公开 注释 = "排序方向" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 无 <公开 类型 = 整数 值 = @ImGuiSortDirection_None>
    常量 升序 <公开 类型 = 整数 值 = @ImGuiSortDirection_Ascending>
    常量 降序 <公开 类型 = 整数 值 = @ImGuiSortDirection_Descending>
}
类 执行条件 <公开 注释 = "执行条件" 折叠 折叠2 @文档 = "category = \"标志类\"">
{
    常量 始终 <公开 类型 = 整数 值 = @ImGuiCond_None>
    常量 始终设置 <公开 类型 = 整数 值 = @ImGuiCond_Always>
    常量 仅首次 <公开 类型 = 整数 值 = @ImGuiCond_Once>
    常量 首次使用时 <公开 类型 = 整数 值 = @ImGuiCond_FirstUseEver>
    常量 窗口出现时 <公开 类型 = 整数 值 = @ImGuiCond_Appearing>
}
