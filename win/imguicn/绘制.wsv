<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 绘制工具 <公开 注释 = "在绘制列表上自绘线段、矩形、圆、文本、图片等图元。绘制列表由\"界面窗口.取窗口绘制列表\"取得，坐标为屏幕坐标。" 折叠>
{
    方法 添加线段 <公开 静态 注释 = "绘制一条线段。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 起点 <类型 = 二维坐标值 注释 = "起点屏幕坐标">
    参数 终点 <类型 = 二维坐标值 注释 = "终点屏幕坐标">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色，可用\"四维数值.转为整数色\"生成">
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddLine(@<起点>, @<终点>, (ImU32)@<颜色值>, @<线宽>)
    }

    方法 添加矩形 <公开 静态 注释 = "绘制一个矩形边框。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 左上角 <类型 = 二维坐标值 注释 = "左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "右下角屏幕坐标">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 圆角 <类型 = 单精度小数 注释 = "圆角半径" @默认值 = 0>
    参数 绘制标志 <类型 = 整数 注释 = "绘制标志，可用\"绘制标志\"类中的常量" @默认值 = 0>
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddRect(@<左上角>, @<右下角>, (ImU32)@<颜色值>, @<圆角>, (ImDrawFlags)@<绘制标志>, @<线宽>)
    }

    方法 添加矩形填充 <公开 静态 注释 = "绘制一个填充矩形。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 左上角 <类型 = 二维坐标值 注释 = "左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "右下角屏幕坐标">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 圆角 <类型 = 单精度小数 注释 = "圆角半径" @默认值 = 0>
    参数 绘制标志 <类型 = 整数 注释 = "绘制标志" @默认值 = 0>
    {
        @ @<目标列表>->AddRectFilled(@<左上角>, @<右下角>, (ImU32)@<颜色值>, @<圆角>, (ImDrawFlags)@<绘制标志>)
    }

    方法 添加圆形 <公开 静态 注释 = "绘制一个圆形边框。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "圆心屏幕坐标">
    参数 半径 <类型 = 单精度小数 注释 = "圆半径">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 分段数 <类型 = 整数 注释 = "圆周分段数，0 表示自动" @默认值 = 0>
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddCircle(@<圆心>, @<半径>, (ImU32)@<颜色值>, (int)@<分段数>, @<线宽>)
    }

    方法 添加圆形填充 <公开 静态 注释 = "绘制一个填充圆形。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "圆心屏幕坐标">
    参数 半径 <类型 = 单精度小数 注释 = "圆半径">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 分段数 <类型 = 整数 注释 = "圆周分段数，0 表示自动" @默认值 = 0>
    {
        @ @<目标列表>->AddCircleFilled(@<圆心>, @<半径>, (ImU32)@<颜色值>, (int)@<分段数>)
    }

    方法 添加三角形 <公开 静态 注释 = "绘制一个三角形边框。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 顶点甲 <类型 = 二维坐标值 注释 = "第一个顶点">
    参数 顶点乙 <类型 = 二维坐标值 注释 = "第二个顶点">
    参数 顶点丙 <类型 = 二维坐标值 注释 = "第三个顶点">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddTriangle(@<顶点甲>, @<顶点乙>, @<顶点丙>, (ImU32)@<颜色值>, @<线宽>)
    }

    方法 添加三角形填充 <公开 静态 注释 = "绘制一个填充三角形。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 顶点甲 <类型 = 二维坐标值 注释 = "第一个顶点">
    参数 顶点乙 <类型 = 二维坐标值 注释 = "第二个顶点">
    参数 顶点丙 <类型 = 二维坐标值 注释 = "第三个顶点">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    {
        @ @<目标列表>->AddTriangleFilled(@<顶点甲>, @<顶点乙>, @<顶点丙>, (ImU32)@<颜色值>)
    }

    方法 添加文本 <公开 静态 注释 = "在指定屏幕坐标绘制一段文本。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 位置 <类型 = 二维坐标值 注释 = "文本左上角屏幕坐标">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 内容 <类型 = 文本型 注释 = "欲绘制的文本">
    {
        @ @<目标列表>->AddText(@<位置>, (ImU32)@<颜色值>, IMCN_U8(@<内容>))
    }

    方法 添加图片 <公开 静态 注释 = "在指定矩形区域绘制一张纹理图片。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 纹理标识 <类型 = 变整数 注释 = "后端提供的纹理句柄">
    参数 左上角 <类型 = 二维坐标值 注释 = "左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "右下角屏幕坐标">
    {
        @ @<目标列表>->AddImage((ImTextureID)(intptr_t)@<纹理标识>, @<左上角>, @<右下角>)
    }

    方法 添加贝塞尔曲线 <公开 静态 注释 = "绘制一条三次贝塞尔曲线。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 起点 <类型 = 二维坐标值 注释 = "起点">
    参数 控制点一 <类型 = 二维坐标值 注释 = "第一个控制点">
    参数 控制点二 <类型 = 二维坐标值 注释 = "第二个控制点">
    参数 终点 <类型 = 二维坐标值 注释 = "终点">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddBezierCubic(@<起点>, @<控制点一>, @<控制点二>, @<终点>, (ImU32)@<颜色值>, @<线宽>)
    }

    方法 取路径分段数 <公开 静态 类型 = 整数 注释 = "取回曲线的自动分段数量。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetDrawListSharedData()->CurveTessellationTol > 0 ? 32 : 32
    }
}
类 绘制扩展 <公开 注释 = "绘制列表进阶图元：正多边形、渐变矩形、阴影矩形、指定字体与字号的文本、裁剪矩形，以及顶点/命令数量等统计信息。绘制列表由\"界面窗口.取窗口绘制列表\"取得，坐标为屏幕坐标。" 折叠>
{
    # 正多边形 | N-gon

    方法 添加正多边形 <公开 静态 注释 = "绘制一个正多边形边框。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "多边形外接圆圆心屏幕坐标">
    参数 半径 <类型 = 单精度小数 注释 = "外接圆半径">
    参数 边数 <类型 = 整数 注释 = "多边形边数，至少为 3">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色，可用\"四维数值.转为整数色\"生成">
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddNgon(@<圆心>, @<半径>, (ImU32)@<颜色值>, (int)@<边数>, @<线宽>)
    }

    方法 添加正多边形填充 <公开 静态 注释 = "绘制一个填充的正多边形。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "多边形外接圆圆心屏幕坐标">
    参数 半径 <类型 = 单精度小数 注释 = "外接圆半径">
    参数 边数 <类型 = 整数 注释 = "多边形边数，至少为 3">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    {
        @ @<目标列表>->AddNgonFilled(@<圆心>, @<半径>, (ImU32)@<颜色值>, (int)@<边数>)
    }

    # 矩形进阶 | Rect

    方法 添加渐变矩形 <公开 静态 注释 = "绘制一个四角颜色各异的渐变填充矩形。ImGui 的渐变矩形是轴对齐的，因此只需左上、右下两个角定义范围，四个颜色分别对应四个角。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 左上角 <类型 = 二维坐标值 注释 = "左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "右下角屏幕坐标">
    参数 左上色 <类型 = 整数 注释 = "左上角颜色">
    参数 右上色 <类型 = 整数 注释 = "右上角颜色">
    参数 右下色 <类型 = 整数 注释 = "右下角颜色">
    参数 左下色 <类型 = 整数 注释 = "左下角颜色">
    {
        @ @<目标列表>->AddRectFilledMultiColor(@<左上角>, @<右下角>, (ImU32)@<左上色>, (ImU32)@<右上色>, (ImU32)@<右下色>, (ImU32)@<左下色>)
    }

    方法 添加阴影矩形 <公开 静态 注释 = "以矩形为中心向四周各扩散指定像素后填充，配合半透明颜色即可得到阴影或辉光效果。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 左上角 <类型 = 二维坐标值 注释 = "矩形左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "矩形右下角屏幕坐标">
    参数 阴影颜色 <类型 = 整数 注释 = "阴影填充色，通常带较低的透明度">
    参数 圆角 <类型 = 单精度小数 注释 = "圆角半径" @默认值 = 0>
    参数 阴影扩散 <类型 = 整数 注释 = "向四周扩散的像素数，0 表示与矩形完全重合" @默认值 = 0>
    {
        @ ::imcn::AddShadowRect(@<目标列表>, @<左上角>, @<右下角>, (ImU32)@<阴影颜色>, @<圆角>, (float)@<阴影扩散>)
    }

    方法 添加圆角矩形填充 <公开 静态 注释 = "绘制一个可带圆角的填充矩形（底层为 ImDrawList::AddRectFilled），是最常用的背景/底板绘制方式。圆角传 0 即为直角矩形。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 左上角 <类型 = 二维坐标值 注释 = "矩形左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "矩形右下角屏幕坐标">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 圆角 <类型 = 单精度小数 注释 = "圆角半径，0 表示直角" @默认值 = 0>
    {
        @ @<目标列表>->AddRectFilled(@<左上角>, @<右下角>, (ImU32)@<颜色值>, @<圆角>)
    }

    # 文本 | Text

    方法 添加指定字号文本 <公开 静态 注释 = "使用当前字体、按指定像素字号在屏幕坐标绘制一段文本。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 位置 <类型 = 二维坐标值 注释 = "文本左上角屏幕坐标">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 内容 <类型 = 文本型 注释 = "欲绘制的文本">
    参数 字号 <类型 = 单精度小数 注释 = "文本像素字号">
    {
        @ @<目标列表>->AddText(ImGui::GetFont(), @<字号>, @<位置>, (ImU32)@<颜色值>, IMCN_U8(@<内容>))
    }

    # 裁剪 | Clip Rect

    方法 压入裁剪矩形 <公开 静态 注释 = "把绘制列表的裁剪区域限制在指定矩形内，需要用\"弹出裁剪矩形\"恢复。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 左上角 <类型 = 二维坐标值 注释 = "裁剪矩形左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "裁剪矩形右下角屏幕坐标">
    {
        @ @<目标列表>->PushClipRect(@<左上角>, @<右下角>, true)
    }

    方法 弹出裁剪矩形 <公开 静态 注释 = "恢复上一层裁剪区域。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    {
        @ @<目标列表>->PopClipRect()
    }

    # 统计与清空 | Stats & Clear

    方法 取顶点数量 <公开 静态 类型 = 整数 注释 = "取回绘制列表中已累积的顶点数量。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    {
        @ @<目标列表>->VtxBuffer.Size
    }

    方法 取命令数量 <公开 静态 类型 = 整数 注释 = "取回绘制列表中已累积的绘制命令数量。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    {
        @ @<目标列表>->CmdBuffer.Size
    }

    方法 添加四边形 <公开 静态 注释 = "绘制一个空心四边形，四个顶点按顺时针顺序给出。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 顶点一 <类型 = 二维坐标值 注释 = "第一个顶点">
    参数 顶点二 <类型 = 二维坐标值 注释 = "第二个顶点">
    参数 顶点三 <类型 = 二维坐标值 注释 = "第三个顶点">
    参数 顶点四 <类型 = 二维坐标值 注释 = "第四个顶点">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddQuad(@<顶点一>, @<顶点二>, @<顶点三>, @<顶点四>, (ImU32)@<颜色值>, @<线宽>)
    }

    方法 添加四边形填充 <公开 静态 注释 = "绘制一个填充四边形。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 顶点一 <类型 = 二维坐标值 注释 = "第一个顶点">
    参数 顶点二 <类型 = 二维坐标值 注释 = "第二个顶点">
    参数 顶点三 <类型 = 二维坐标值 注释 = "第三个顶点">
    参数 顶点四 <类型 = 二维坐标值 注释 = "第四个顶点">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    {
        @ @<目标列表>->AddQuadFilled(@<顶点一>, @<顶点二>, @<顶点三>, @<顶点四>, (ImU32)@<颜色值>)
    }

    方法 添加图片四边形 <公开 静态 注释 = "把整张纹理贴到一个任意四边形上，可用于旋转/透视变形的图片。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 纹理标识 <类型 = 变整数 注释 = "后端提供的纹理句柄">
    参数 顶点一 <类型 = 二维坐标值 注释 = "纹理左上角对应的位置">
    参数 顶点二 <类型 = 二维坐标值 注释 = "纹理右上角对应的位置">
    参数 顶点三 <类型 = 二维坐标值 注释 = "纹理右下角对应的位置">
    参数 顶点四 <类型 = 二维坐标值 注释 = "纹理左下角对应的位置">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色（通常为白色）" @默认值 = -1>
    {
        @ @<目标列表>->AddImageQuad((ImTextureID)(intptr_t)@<纹理标识>, @<顶点一>, @<顶点二>, @<顶点三>, @<顶点四>, ImVec2(0.0f, 0.0f), ImVec2(1.0f, 0.0f), ImVec2(1.0f, 1.0f), ImVec2(0.0f, 1.0f), (ImU32)@<颜色值>)
    }

    方法 添加圆角图片 <公开 静态 注释 = "绘制一张带圆角（可裁成圆形）的纹理图片。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 纹理标识 <类型 = 变整数 注释 = "后端提供的纹理句柄">
    参数 左上角 <类型 = 二维坐标值 注释 = "左上角屏幕坐标">
    参数 右下角 <类型 = 二维坐标值 注释 = "右下角屏幕坐标">
    参数 圆角 <类型 = 单精度小数 注释 = "圆角半径，取宽高一半即为圆形">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色（通常为白色）" @默认值 = -1>
    参数 绘制标志 <类型 = 整数 注释 = "绘制标志，可用\"绘制标志\"类中的常量" @默认值 = 0>
    {
        @ @<目标列表>->AddImageRounded((ImTextureID)(intptr_t)@<纹理标识>, @<左上角>, @<右下角>, ImVec2(0.0f, 0.0f), ImVec2(1.0f, 1.0f), (ImU32)@<颜色值>, @<圆角>, (ImDrawFlags)@<绘制标志>)
    }

    方法 添加椭圆 <公开 静态 注释 = "绘制一个空心椭圆。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "圆心坐标">
    参数 半径 <类型 = 二维坐标值 注释 = "横向半径与纵向半径">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 旋转角度 <类型 = 单精度小数 注释 = "旋转弧度" @默认值 = 0>
    参数 分段数 <类型 = 整数 注释 = "分段数，0 表示自动" @默认值 = 0>
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->AddEllipse(@<圆心>, @<半径>, (ImU32)@<颜色值>, @<旋转角度>, (int)@<分段数>, @<线宽>)
    }

    方法 添加椭圆填充 <公开 静态 注释 = "绘制一个填充椭圆。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "圆心坐标">
    参数 半径 <类型 = 二维坐标值 注释 = "横向半径与纵向半径">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 旋转角度 <类型 = 单精度小数 注释 = "旋转弧度" @默认值 = 0>
    参数 分段数 <类型 = 整数 注释 = "分段数，0 表示自动" @默认值 = 0>
    {
        @ @<目标列表>->AddEllipseFilled(@<圆心>, @<半径>, (ImU32)@<颜色值>, @<旋转角度>, (int)@<分段数>)
    }

    方法 添加二次贝塞尔 <公开 静态 注释 = "绘制一条二次贝塞尔曲线（一个控制点）。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 起点 <类型 = 二维坐标值 注释 = "起点">
    参数 控制点 <类型 = 二维坐标值 注释 = "控制点">
    参数 终点 <类型 = 二维坐标值 注释 = "终点">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    参数 分段数 <类型 = 整数 注释 = "分段数，0 表示自动" @默认值 = 0>
    {
        @ @<目标列表>->AddBezierQuadratic(@<起点>, @<控制点>, @<终点>, (ImU32)@<颜色值>, @<线宽>, (int)@<分段数>)
    }

    方法 清空路径点 <公开 静态 注释 = "清空折线/多边形顶点缓冲区，之后可用\"添加路径点\"逐点构建。" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::PathClear()
    }

    方法 添加路径点 <公开 静态 注释 = "向折线/多边形顶点缓冲区追加一个点。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 单精度小数 注释 = "X 坐标">
    参数 纵坐标 <类型 = 单精度小数 注释 = "Y 坐标">
    {
        @ ::imcn::PathPush(@<横坐标>, @<纵坐标>)
    }

    方法 取路径点数 <公开 静态 类型 = 整数 注释 = "取回顶点缓冲区当前的点数。" 返回值注释 = "点数" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::PathCount()
    }

    方法 绘制折线 <公开 静态 注释 = "把顶点缓冲区连成折线绘制（至少 2 个点）。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 闭合 <类型 = 逻辑型 注释 = "真表示首尾相连闭合" @默认值 = 假>
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ ::imcn::PathPolyline(@<目标列表>, (ImU32)@<颜色值>, (ImDrawFlags)((bool)@<闭合> ? ImDrawFlags_Closed : 0), @<线宽>)
    }

    方法 绘制凸多边形填充 <公开 静态 注释 = "把顶点缓冲区当成凸多边形填充（至少 3 个点）。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    {
        @ ::imcn::PathConvexFill(@<目标列表>, (ImU32)@<颜色值>)
    }

    方法 绘制凹多边形填充 <公开 静态 注释 = "把顶点缓冲区当成凹多边形填充（至少 3 个点，内部会三角化）。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    {
        @ ::imcn::PathConcaveFill(@<目标列表>, (ImU32)@<颜色值>)
    }


    # 状态化路径 | Stateful Path API
    # 先把路径点加入绘制列表内部路径，再用"路径填充凸"或"路径描边"收尾。

    方法 清空路径 <公开 静态 注释 = "清空绘制列表内部的状态化路径。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    {
        @ @<目标列表>->PathClear()
    }

    方法 路径连线到 <公开 静态 注释 = "在当前路径末尾追加一个顶点。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 位置 <类型 = 二维坐标值 注释 = "顶点坐标">
    {
        @ @<目标列表>->PathLineTo(@<位置>)
    }

    方法 路径画弧 <公开 静态 注释 = "在路径中追加一段圆弧。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "圆心">
    参数 半径 <类型 = 单精度小数 注释 = "半径">
    参数 起始角度 <类型 = 单精度小数 注释 = "起始弧度">
    参数 结束角度 <类型 = 单精度小数 注释 = "结束弧度">
    参数 分段数 <类型 = 整数 注释 = "分段数，0 表示自动" @默认值 = 0>
    {
        @ @<目标列表>->PathArcTo(@<圆心>, @<半径>, @<起始角度>, @<结束角度>, (int)@<分段数>)
    }

    方法 路径画椭圆弧 <公开 静态 注释 = "在路径中追加一段椭圆弧。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "圆心">
    参数 半径 <类型 = 二维坐标值 注释 = "横向半径与纵向半径">
    参数 旋转角度 <类型 = 单精度小数 注释 = "旋转弧度" @默认值 = 0>
    参数 起始角度 <类型 = 单精度小数 注释 = "起始弧度">
    参数 结束角度 <类型 = 单精度小数 注释 = "结束弧度">
    参数 分段数 <类型 = 整数 注释 = "分段数，0 表示自动" @默认值 = 0>
    {
        @ @<目标列表>->PathEllipticalArcTo(@<圆心>, @<半径>, @<旋转角度>, @<起始角度>, @<结束角度>, (int)@<分段数>)
    }

    方法 路径画矩形 <公开 静态 注释 = "在路径中追加一个矩形（可带圆角）。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 左上角 <类型 = 二维坐标值 注释 = "左上角">
    参数 右下角 <类型 = 二维坐标值 注释 = "右下角">
    参数 圆角 <类型 = 单精度小数 注释 = "圆角半径" @默认值 = 0>
    参数 绘制标志 <类型 = 整数 注释 = "圆角位置标志，可用\"绘制标志\"类中的常量" @默认值 = 0>
    {
        @ @<目标列表>->PathRect(@<左上角>, @<右下角>, @<圆角>, (ImDrawFlags)@<绘制标志>)
    }

    方法 路径三次贝塞尔到 <公开 静态 注释 = "从当前路径末端追加一段三次贝塞尔曲线。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 控制点一 <类型 = 二维坐标值 注释 = "第一个控制点">
    参数 控制点二 <类型 = 二维坐标值 注释 = "第二个控制点">
    参数 终点 <类型 = 二维坐标值 注释 = "终点">
    参数 分段数 <类型 = 整数 注释 = "分段数，0 表示自动" @默认值 = 0>
    {
        @ @<目标列表>->PathBezierCubicCurveTo(@<控制点一>, @<控制点二>, @<终点>, (int)@<分段数>)
    }

    方法 路径二次贝塞尔到 <公开 静态 注释 = "从当前路径末端追加一段二次贝塞尔曲线。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 控制点 <类型 = 二维坐标值 注释 = "控制点">
    参数 终点 <类型 = 二维坐标值 注释 = "终点">
    参数 分段数 <类型 = 整数 注释 = "分段数，0 表示自动" @默认值 = 0>
    {
        @ @<目标列表>->PathBezierQuadraticCurveTo(@<控制点>, @<终点>, (int)@<分段数>)
    }

    方法 路径填充凸 <公开 静态 注释 = "把当前路径作为凸多边形填充并结束路径。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    {
        @ @<目标列表>->PathFillConvex((ImU32)@<颜色值>)
    }

    方法 路径描边 <公开 静态 注释 = "把当前路径作为折线描边并结束路径。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 颜色值 <类型 = 整数 注释 = "32位打包颜色">
    参数 闭合 <类型 = 逻辑型 注释 = "真表示首尾相连" @默认值 = 假>
    参数 线宽 <类型 = 单精度小数 注释 = "线宽像素" @默认值 = 1>
    {
        @ @<目标列表>->PathStroke((ImU32)@<颜色值>, (ImDrawFlags)((bool)@<闭合> ? ImDrawFlags_Closed : 0), @<线宽>)
    }


    方法 压入纹理 <公开 静态 注释 = "把绘制列表之后的图元都改用指定纹理，需与\"弹出纹理\"配对。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 纹理标识 <类型 = 变整数 注释 = "纹理句柄">
    {
        @ @<目标列表>->PushTextureID((ImTextureID)(intptr_t)@<纹理标识>)
    }

    方法 弹出纹理 <公开 静态 注释 = "恢复\"压入纹理\"之前的纹理。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    {
        @ @<目标列表>->PopTextureID()
    }

    方法 路径快速圆弧 <公开 静态 注释 = "按 12 等分刻度快速追加一段圆弧，适合画圆环/仪表盘。" 折叠 @嵌入式方法 = "">
    参数 目标列表 <类型 = 绘制列表 注释 = "绘制列表">
    参数 圆心 <类型 = 二维坐标值 注释 = "圆心">
    参数 半径 <类型 = 单精度小数 注释 = "半径">
    参数 起始刻度 <类型 = 整数 注释 = "起始刻度 0~12（12 表示整圆）">
    参数 结束刻度 <类型 = 整数 注释 = "结束刻度 0~12">
    {
        @ @<目标列表>->PathArcToFast(@<圆心>, @<半径>, (int)@<起始刻度>, (int)@<结束刻度>)
    }

}
