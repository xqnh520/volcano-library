    {
        @ ImGui::BeginCombo(IMCN_U8(@<标签文本>), IMCN_U8(@<预览文本>), (ImGuiComboFlags)@<组合框标志值>)
    }

    方法 结束组合框 <公开 静态 注释 = "结束下拉组合框。" 折叠 @嵌入式方法 = "">
