    # 通用标量控件 | Generic Scalar Widgets
    # 由\"数据类别\"决定数值宽度，配合\"界面存储.取整数引用\"等裸指针使用：
    # 数据指针指向的内存宽度必须与数据类别一致，否则会读写越界。

    方法 通用输入 <公开 静态 类型 = 逻辑型 注释 = "按数据类别自动选择宽度与格式的通用输入框。适合把\"界面存储\"里的裸指针直接交给控件，省去为每种宽度写一遍。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签，可用\"##\"隐藏显示部分">
    参数 数据类别 <类型 = 整数 注释 = "数值数据类别，可用\"数据类别\"类中的常量，仅支持数值类别">
    参数 数据指针 <类型 = 变整数 注释 = "指向待编辑数值的裸指针，可由\"取整数引用\"等取得">
    参数 步进 <类型 = 单精度小数 注释 = "加减按钮的变化量，0 表示用默认值" @默认值 = 0>
    参数 快速步进 <类型 = 单精度小数 注释 = "按住 Ctrl 时的变化量，0 表示用默认值" @默认值 = 0>
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，留空表示按数据类别自动选择" @默认值 = "">
    参数 输入框标志 <类型 = 整数 注释 = "输入框标志，可用\"输入框标志\"类中的常量" @默认值 = 0>
    {
        @ ::imcn::InputScalarD(IMCN_U8(@<标签文本>), (int)@<数据类别>, (void*)(intptr_t)@<数据指针>, @<步进>, @<快速步进>, IMCN_U8(@<显示格式>), (ImGuiInputTextFlags)@<输入框标志>)
    }

    方法 通用输入多 <公开 静态 类型 = 逻辑型 注释 = "多分量版本的通用输入框，数据指针要指向一段连续存放的分量数组。分量数以整数传递；S64/U64 建议改用单分量版逐项输入，避免精度损失。" 返回值注释 = "任一分量被修改返回真" 折叠 @嵌入式方法 = "">
