    参数 步进 <类型 = 单精度小数 注释 = "步进量，0 表示默认" @默认值 = 0>
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%.3f">
    参数 输入框标志 <类型 = 整数 注释 = "输入框标志" @默认值 = 0>
    {
        @ ::imcn::InputScalarND(IMCN_U8(@<标签文本>), 9, (void*)&@<数值变量>, 4, @<步进>, 0.0, IMCN_U8(@<显示格式>), (ImGuiInputTextFlags)@<输入框标志>)
    }

    方法 通用滑块四分 <公开 静态 类型 = 逻辑型 注释 = "四个分量联动的一条横排滑块组，用于颜色/权重等四分量数值。" 返回值注释 = "任一数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "组标签">
    参数 数值变量 <类型 = 四维数值 @需求类型 = 可写入变量 注释 = "被编辑的四维数值变量">
    参数 最小值 <类型 = 单精度小数 注释 = "滑块左端值">
    参数 最大值 <类型 = 单精度小数 注释 = "滑块右端值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%.3f">
    参数 滑块标志 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ::imcn::SliderScalarND(IMCN_U8(@<标签文本>), 9, (void*)&@<数值变量>, 4, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志>)
    }

    方法 通用拖动四分 <公开 静态 类型 = 逻辑型 注释 = "四个分量联动的横排拖动框，用于颜色/偏移等四分量数值。" 返回值注释 = "任一数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "组标签">
    参数 数值变量 <类型 = 四维数值 @需求类型 = 可写入变量 注释 = "被编辑的四维数值变量">
    参数 拖动速度 <类型 = 单精度小数 注释 = "每像素变化量" @默认值 = 1>
    参数 最小值 <类型 = 单精度小数 注释 = "允许的最小值，0 表示不限制" @默认值 = 0>
    参数 最大值 <类型 = 单精度小数 注释 = "允许的最大值，0 表示不限制" @默认值 = 0>
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%.3f">
    参数 滑块标志 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ::imcn::DragScalarND(IMCN_U8(@<标签文本>), 9, (void*)&@<数值变量>, 4, @<拖动速度>, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志>)
    }
}
