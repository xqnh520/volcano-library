        @ ImGui::EndCombo()
    }

    方法 可选项 <公开 静态 类型 = 逻辑型 注释 = "创建一个可被选中的列表项，常用于组合框、列表框与菜单。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
