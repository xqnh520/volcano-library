<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 界面控件 <公开 注释 = "常用控件命令：文本、按钮、复选框、输入框、滑块、下拉框、列表、树、菜单、选项卡、弹窗、拖放、颜色与图片。" 折叠>
{
    # 文本 | Text

    方法 文本 <公开 静态 注释 = "显示一段普通文本。" 折叠 @嵌入式方法 = "">
    参数 内容 <类型 = 文本型 注释 = "欲显示的文本">
    {
        @ ImGui::TextUnformatted(IMCN_U8(@<内容>))
    }

    方法 禁用文本 <公开 静态 注释 = "显示一段灰色的次要文本。" 折叠 @嵌入式方法 = "">
    参数 内容 <类型 = 文本型 注释 = "欲显示的文本">
    {
        @ ImGui::TextDisabled("%s", IMCN_U8(@<内容>))
    }

    方法 换行文本 <公开 静态 注释 = "显示一段可自动换行的文本。" 折叠 @嵌入式方法 = "">
    参数 内容 <类型 = 文本型 注释 = "欲显示的文本">
    {
        @ ImGui::TextWrapped("%s", IMCN_U8(@<内容>))
    }

    方法 彩色文本 <公开 静态 注释 = "用指定颜色显示一段文本。" 折叠 @嵌入式方法 = "">
    参数 颜色值 <类型 = 四维数值 注释 = "文本颜色 (红, 绿, 蓝, 透明)">
    参数 内容 <类型 = 文本型 注释 = "欲显示的文本">
    {
        @ ImGui::TextColored(@<颜色值>, "%s", IMCN_U8(@<内容>))
    }

    方法 项目符号 <公开 静态 注释 = "绘制一个小圆点，并把光标保持在同一行。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::Bullet()
    }

    方法 项目符号文本 <公开 静态 注释 = "绘制一个小圆点并换行显示文本。" 折叠 @嵌入式方法 = "">
    参数 内容 <类型 = 文本型 注释 = "圆点后的文本">
    {
        @ ImGui::BulletText("%s", IMCN_U8(@<内容>))
    }

    方法 带标签文本 <公开 静态 注释 = "在同一行显示标签与文本，常用于参数展示。" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "标签文本">
    参数 内容 <类型 = 文本型 注释 = "数值或其它文本">
    {
        @ ImGui::LabelText(IMCN_U8(@<标签文本>), "%s", IMCN_U8(@<内容>))
    }

    方法 载入中文本 <公开 静态 注释 = "绘制一个旋转的载入指示图标。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::Text("%s", ::imcn::SpinnerText())
    }

    # 按钮 | Button

    方法 按钮 <公开 静态 类型 = 逻辑型 注释 = "创建一个普通按钮。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "按钮文本，可用\"##\"区分同名的按钮">
    参数 按钮尺寸 <类型 = 二维坐标值 注释 = "(0,0) 表示按文本自动计算尺寸" @默认值 = 二维坐标值默认值.零值>
    {
        @ ImGui::Button(IMCN_U8(@<标签文本>), @<按钮尺寸>)
    }

    方法 小按钮 <公开 静态 类型 = 逻辑型 注释 = "创建一个无边距的小按钮，适合嵌入文本行。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "按钮文本">
    {
        @ ImGui::SmallButton(IMCN_U8(@<标签文本>))
    }

    方法 箭头按钮 <公开 静态 类型 = 逻辑型 注释 = "创建一个箭头形状的按钮。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
    参数 按钮ID <类型 = 文本型 注释 = "按钮唯一ID，不显示在界面上">
    参数 箭头方向 <类型 = 整数 注释 = "箭头方向，可用\"方向\"类中的常量">
    {
        @ ImGui::ArrowButton(IMCN_U8(@<按钮ID>), (ImGuiDir)@<箭头方向>)
    }

    方法 隐身按钮 <公开 静态 类型 = 逻辑型 注释 = "创建一个不可见但仍可响应鼠标的按钮，常用于自绘交互区域。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
    参数 按钮ID <类型 = 文本型 注释 = "按钮唯一ID">
    参数 按钮尺寸 <类型 = 二维坐标值 注释 = "交互区域尺寸">
    参数 按钮标志值 <类型 = 整数 注释 = "按钮标志，可用\"按钮标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::InvisibleButton(IMCN_U8(@<按钮ID>), @<按钮尺寸>, (ImGuiButtonFlags)@<按钮标志值>)
    }

    方法 复选框 <公开 静态 类型 = 逻辑型 注释 = "创建一个复选框，勾选状态保存在传入的变量中。" 返回值注释 = "状态被改变返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "复选框文本">
    参数 选中状态 <类型 = 逻辑型 @需求类型 = 可写入变量 注释 = "必须传入一个逻辑型变量">
    {
        @ ImGui::Checkbox(IMCN_U8(@<标签文本>), (bool*)&@<选中状态>)
    }

    方法 复选框标志 <公开 静态 类型 = 逻辑型 注释 = "创建一个复选框，勾选时按位或标志值、取消时按位异或标志值。" 返回值注释 = "状态被改变返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "复选框文本">
    参数 当前标志 <类型 = 整数 @需求类型 = 可写入变量 注释 = "必须传入一个整数变量">
    参数 标志值 <类型 = 整数 注释 = "被勾选时参与位运算的标志值">
    {
        @ ImGui::CheckboxFlags(IMCN_U8(@<标签文本>), (int*)&@<当前标志>, (int)@<标志值>)
    }

    方法 单选按钮 <公开 静态 类型 = 逻辑型 注释 = "创建一个单选按钮，选中状态由传入的逻辑值决定。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "单选按钮文本">
    参数 是否选中 <类型 = 逻辑型 注释 = "是否处于选中状态">
    {
        @ ImGui::RadioButton(IMCN_U8(@<标签文本>), (bool)@<是否选中>)
    }

    方法 单选按钮组 <公开 静态 类型 = 逻辑型 注释 = "创建一个由整数索引控制选中项的单选按钮。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "单选按钮文本">
    参数 现行索引 <类型 = 整数 @需求类型 = 可写入变量 注释 = "必须传入一个整数变量，表示当前选中索引">
    参数 本按钮索引 <类型 = 整数 注释 = "本按钮对应的索引值">
    {
        @ ImGui::RadioButton(IMCN_U8(@<标签文本>), &@<现行索引>, (int)@<本按钮索引>)
    }

    方法 进度条 <公开 静态 注释 = "创建一个进度条。" 折叠 @嵌入式方法 = "">
    参数 进度 <类型 = 单精度小数 注释 = "进度值，范围 0.0-1.0">
    参数 尺寸 <类型 = 二维坐标值 注释 = "进度条尺寸，(-FLT_MIN,0) 表示占满宽度" @默认值 = 二维坐标值默认值.全宽零高>
    参数 覆盖文本 <类型 = 文本型 注释 = "覆盖默认百分比文本，空文本表示使用默认" @默认值 = 空对象>
    {
        @ ImGui::ProgressBar(@<进度>, @<尺寸>, IMCN_U8(@<覆盖文本>))
    }

    方法 超链接 <公开 静态 类型 = 逻辑型 注释 = "创建一个可单击的超链接文本按钮。" 返回值注释 = "被单击返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "链接文本">
    {
        @ ImGui::TextLink(IMCN_U8(@<标签文本>))
    }

    # 输入框 | Input

    方法 输入文本 <公开 静态 类型 = 逻辑型 注释 = "创建一个单行文本输入框，内容与原文本类型变量双向同步。" 返回值注释 = "内容被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签，可用\"##\"隐藏显示部分">
    参数 内容变量 <类型 = 文本型 @需求类型 = 可写入变量 注释 = "必须传入一个文本型变量">
    参数 输入框标志值 <类型 = 整数 注释 = "输入框标志，可用\"输入框标志\"类中的常量" @默认值 = 0>
    {
        @ ::imcn::InputTextW(IMCN_U8(@<标签文本>), &@<内容变量>, (ImGuiInputTextFlags)@<输入框标志值>)
    }

    方法 输入多行文本 <公开 静态 类型 = 逻辑型 注释 = "创建一个多行文本输入框。" 返回值注释 = "内容被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签">
    参数 内容变量 <类型 = 文本型 @需求类型 = 可写入变量 注释 = "必须传入一个文本型变量">
    参数 输入框尺寸 <类型 = 二维坐标值 注释 = "输入框尺寸，(0,0) 表示默认尺寸" @默认值 = 二维坐标值默认值.零值>
    参数 输入框标志值 <类型 = 整数 注释 = "输入框标志，可用\"输入框标志\"类中的常量" @默认值 = 0>
    {
        @ ::imcn::InputTextMultilineW(IMCN_U8(@<标签文本>), &@<内容变量>, @<输入框尺寸>, (ImGuiInputTextFlags)@<输入框标志值>)
    }

    方法 输入整数 <公开 静态 类型 = 逻辑型 注释 = "创建一个整数输入框，可用加减按钮微调。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签">
    参数 整数值 <类型 = 整数 @需求类型 = 可写入变量 注释 = "必须传入一个整数变量">
    参数 步进值 <类型 = 整数 注释 = "点击加减按钮时的变化量" @默认值 = 1>
    参数 快速步进值 <类型 = 整数 注释 = "按住Ctrl时的变化量" @默认值 = 100>
    参数 输入框标志值 <类型 = 整数 注释 = "输入框标志" @默认值 = 0>
    {
        @ ImGui::InputInt(IMCN_U8(@<标签文本>), &@<整数值>, (int)@<步进值>, (int)@<快速步进值>, (ImGuiInputTextFlags)@<输入框标志值>)
    }

    方法 输入小数 <公开 静态 类型 = 逻辑型 注释 = "创建一个小数输入框。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签">
    参数 小数值 <类型 = 单精度小数 @需求类型 = 可写入变量 注释 = "必须传入一个单精度小数变量">
    参数 步进值 <类型 = 单精度小数 注释 = "点击按钮时的变化量" @默认值 = 0.1>
    参数 快速步进值 <类型 = 单精度小数 注释 = "按住Ctrl时的变化量" @默认值 = 1>
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，如 \"%.2f\"" @默认值 = "%.3f">
    参数 输入框标志值 <类型 = 整数 注释 = "输入框标志" @默认值 = 0>
    {
        @ ImGui::InputFloat(IMCN_U8(@<标签文本>), &@<小数值>, @<步进值>, @<快速步进值>, IMCN_U8(@<显示格式>), (ImGuiInputTextFlags)@<输入框标志值>)
    }

    方法 输入小数二 <公开 静态 类型 = 逻辑型 注释 = "创建由两个小数分量组成的输入框。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签">
    参数 数值 <类型 = 二维坐标值 @需求类型 = 可写入变量 注释 = "必须传入一个二维坐标值变量">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%.3f">
    {
        @ ImGui::InputFloat2(IMCN_U8(@<标签文本>), (float*)&@<数值>, IMCN_U8(@<显示格式>))
    }

    方法 拖动小数 <公开 静态 类型 = 逻辑型 注释 = "创建一个可左右拖动调整数值的拖动框。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "拖动框标签">
    参数 小数值 <类型 = 单精度小数 @需求类型 = 可写入变量 注释 = "必须传入一个单精度小数变量">
    参数 拖动速度 <类型 = 单精度小数 注释 = "每像素变化量" @默认值 = 1>
    参数 最小值 <类型 = 单精度小数 注释 = "允许的最小值">
    参数 最大值 <类型 = 单精度小数 注释 = "允许的最大值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%.3f">
    参数 滑块标志值 <类型 = 整数 注释 = "滑块标志，可用\"滑块标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::DragFloat(IMCN_U8(@<标签文本>), &@<小数值>, @<拖动速度>, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志值>)
    }

    方法 拖动整数 <公开 静态 类型 = 逻辑型 注释 = "创建一个可左右拖动调整数值的整数拖动框。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "拖动框标签">
    参数 整数值 <类型 = 整数 @需求类型 = 可写入变量 注释 = "必须传入一个整数变量">
    参数 拖动速度 <类型 = 单精度小数 注释 = "每像素变化量" @默认值 = 1>
    参数 最小值 <类型 = 整数 注释 = "允许的最小值">
    参数 最大值 <类型 = 整数 注释 = "允许的最大值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%d">
    参数 滑块标志值 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ImGui::DragInt(IMCN_U8(@<标签文本>), &@<整数值>, @<拖动速度>, (int)@<最小值>, (int)@<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志值>)
    }

    方法 滑块小数 <公开 静态 类型 = 逻辑型 注释 = "创建一个横向小数滑块。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "滑块标签">
    参数 小数值 <类型 = 单精度小数 @需求类型 = 可写入变量 注释 = "必须传入一个单精度小数变量">
    参数 最小值 <类型 = 单精度小数 注释 = "滑块左端值">
    参数 最大值 <类型 = 单精度小数 注释 = "滑块右端值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%.3f">
    参数 滑块标志值 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ImGui::SliderFloat(IMCN_U8(@<标签文本>), &@<小数值>, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志值>)
    }

    方法 滑块整数 <公开 静态 类型 = 逻辑型 注释 = "创建一个横向整数滑块。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "滑块标签">
    参数 整数值 <类型 = 整数 @需求类型 = 可写入变量 注释 = "必须传入一个整数变量">
    参数 最小值 <类型 = 整数 注释 = "滑块左端值">
    参数 最大值 <类型 = 整数 注释 = "滑块右端值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%d">
    参数 滑块标志值 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ImGui::SliderInt(IMCN_U8(@<标签文本>), &@<整数值>, (int)@<最小值>, (int)@<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志值>)
    }

    方法 垂直滑块小数 <公开 静态 类型 = 逻辑型 注释 = "创建一个纵向小数滑块。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "滑块标签">
    参数 滑块尺寸 <类型 = 二维坐标值 注释 = "滑块尺寸">
    参数 小数值 <类型 = 单精度小数 @需求类型 = 可写入变量 注释 = "必须传入一个单精度小数变量">
    参数 最小值 <类型 = 单精度小数 注释 = "下端值">
    参数 最大值 <类型 = 单精度小数 注释 = "上端值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式" @默认值 = "%.3f">
    参数 滑块标志值 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ImGui::VSliderFloat(IMCN_U8(@<标签文本>), @<滑块尺寸>, &@<小数值>, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志值>)
    }

    方法 滑动条小数 <公开 静态 注释 = "创建一个不可拖动、只能通过代码修改的滑动条。" 折叠 @嵌入式方法 = "">
    参数 进度 <类型 = 单精度小数 注释 = "当前值，范围 0.0-1.0">
    参数 尺寸 <类型 = 二维坐标值 注释 = "尺寸，(-FLT_MIN,0) 表示占满宽度" @默认值 = 二维坐标值默认值.全宽零高>
    参数 覆盖文本 <类型 = 文本型 注释 = "自定义显示文本，空文本表示使用百分比" @默认值 = 空对象>
    {
        @ ImGui::ProgressBar(@<进度>, @<尺寸>, IMCN_U8(@<覆盖文本>))
    }

