    方法 取任意项目是否悬停 <公开 静态 类型 = 逻辑型 注释 = "当前是否有任意 ImGui 项目被悬停。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsAnyItemHovered()
    }

    方法 取任意项目是否激活 <公开 静态 类型 = 逻辑型 注释 = "当前是否有任意 ImGui 项目处于激活状态。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsAnyItemActive()
    }

    # 标识栈 | ID Stack

    方法 压入标识 <公开 静态 注释 = "压入一个字符串 ID，用于区分同名控件。" 折叠 @嵌入式方法 = "">
    参数 标识文本 <类型 = 文本型 注释 = "ID 文本">
    {
        @ ImGui::PushID(IMCN_U8(@<标识文本>))
    }

    方法 压入标识整数 <公开 静态 注释 = "压入一个整数 ID。" 折叠 @嵌入式方法 = "">
    参数 标识值 <类型 = 整数 注释 = "ID 数值">
    {
        @ ImGui::PushID((int)@<标识值>)
    }

    方法 弹出标识 <公开 静态 注释 = "弹出一个 ID。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::PopID()
    }

    # 快捷键 | Shortcut

    方法 快捷键 <公开 静态 类型 = 逻辑型 注释 = "判断组合键是否被按下，例如 Ctrl+S 可传\"按键.Ctrl修饰键 + 按键.字母S\"。" 返回值注释 = "按下返回真" 折叠 @嵌入式方法 = "">
    参数 按键组合 <类型 = 整数 注释 = "按键码与修饰键按位或的结果">
    参数 输入标志值 <类型 = 整数 注释 = "输入标志，可用\"输入标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::Shortcut((ImGuiKey)@<按键组合>, (ImGuiInputFlags)@<输入标志值>)
    }

    方法 置快捷键 <公开 静态 注释 = "为上一个项目注册快捷键。" 折叠 @嵌入式方法 = "">
    参数 按键组合 <类型 = 整数 注释 = "按键码与修饰键按位或的结果">
    参数 输入标志值 <类型 = 整数 注释 = "输入标志" @默认值 = 0>
    {
        @ ImGui::SetNextItemShortcut((ImGuiKey)@<按键组合>, (ImGuiInputFlags)@<输入标志值>)
    }

    方法 开始主菜单栏 <公开 静态 类型 = 逻辑型 注释 = "在屏幕顶部开始一个主菜单栏，不依赖任何窗口；需与\"结束主菜单栏\"配对。" 返回值注释 = "成功返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::BeginMainMenuBar()
    }

    方法 结束主菜单栏 <公开 静态 注释 = "结束主菜单栏。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::EndMainMenuBar()
    }

    方法 取项目左上角 <公开 静态 类型 = 二维坐标值 注释 = "取回上一个项目包围矩形的左上角屏幕坐标。" 返回值注释 = "左上角坐标" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetItemRectMin()
    }

    方法 取项目右下角 <公开 静态 类型 = 二维坐标值 注释 = "取回上一个项目包围矩形的右下角屏幕坐标。" 返回值注释 = "右下角坐标" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetItemRectMax()
    }

    方法 开始窗口右键菜单 <公开 静态 类型 = 逻辑型 注释 = "在窗口任意空白处右键时打开上下文菜单，需与\"结束弹窗\"配对。" 返回值注释 = "菜单打开时返回真" 折叠 @嵌入式方法 = "">
    参数 弹窗ID <类型 = 文本型 注释 = "菜单唯一ID，留空表示使用当前窗口ID" @默认值 = "">
    参数 弹出标志值 <类型 = 整数 注释 = "弹出标志，默认右键触发" @默认值 = 1>
    {
        @ ImGui::BeginPopupContextWindow(IMCN_U8(@<弹窗ID>), (ImGuiPopupFlags)@<弹出标志值>)
    }

    方法 开始空白右键菜单 <公开 静态 类型 = 逻辑型 注释 = "在没有任何窗口的空白区域右键时打开上下文菜单，需与\"结束弹窗\"配对。" 返回值注释 = "菜单打开时返回真" 折叠 @嵌入式方法 = "">
    参数 弹窗ID <类型 = 文本型 注释 = "菜单唯一ID，留空表示默认ID" @默认值 = "">
    参数 弹出标志值 <类型 = 整数 注释 = "弹出标志，默认右键触发" @默认值 = 1>
    {
        @ ImGui::BeginPopupContextVoid(IMCN_U8(@<弹窗ID>), (ImGuiPopupFlags)@<弹出标志值>)
    }

    方法 打开项点击弹出 <公开 静态 注释 = "在当前项目被点击时打开弹窗（右键点击最常用）。" 折叠 @嵌入式方法 = "">
    参数 弹窗ID <类型 = 文本型 注释 = "弹窗唯一ID，留空表示使用项目ID" @默认值 = "">
    参数 弹出标志值 <类型 = 整数 注释 = "弹出标志，默认右键触发" @默认值 = 1>
    {
        @ ImGui::OpenPopupOnItemClick(IMCN_U8(@<弹窗ID>), (ImGuiPopupFlags)@<弹出标志值>)
    }

    方法 取弹出是否打开 <公开 静态 类型 = 逻辑型 注释 = "查询指定ID的弹窗是否处于打开状态。" 返回值注释 = "已打开返回真" 折叠 @嵌入式方法 = "">
    参数 弹窗ID <类型 = 文本型 注释 = "弹窗唯一ID" @默认值 = "">
    参数 弹出标志值 <类型 = 整数 注释 = "弹出标志" @默认值 = 0>
    {
        @ ImGui::IsPopupOpen(IMCN_U8(@<弹窗ID>), (ImGuiPopupFlags)@<弹出标志值>)
    }

    方法 取项目是否被点击 <公开 静态 类型 = 逻辑型 注释 = "查询上一个项目本帧是否被鼠标点击。" 返回值注释 = "被点击返回真" 折叠 @嵌入式方法 = "">
    参数 鼠标按钮值 <类型 = 整数 注释 = "鼠标按钮，可用\"鼠标按钮\"类中的常量" @默认值 = 0>
    {
        @ ImGui::IsItemClicked((ImGuiMouseButton)@<鼠标按钮值>)
    }

    方法 取项目是否结束编辑 <公开 静态 类型 = 逻辑型 注释 = "查询上一个项目是否在本帧刚刚结束编辑（松开鼠标、失焦或回车）。" 返回值注释 = "刚结束编辑返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::IsItemDeactivated()
    }

    方法 开始项目提示框 <公开 静态 类型 = 逻辑型 注释 = "上一个项目被悬停时打开提示框，需与\"结束提示框\"配对。" 返回值注释 = "提示框打开返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::BeginItemTooltip()
    }


    # 布局与颜色工具 | Layout & Color Helpers

    方法 对齐文本到框架 <公开 静态 注释 = "把文本基线对齐到控件框架高度，用于让纯文本与输入框/按钮水平对齐。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::AlignTextToFramePadding()
    }

    方法 HSV转RGB <公开 静态 类型 = 四维数值 注释 = "把 HSV 颜色转成 RGB（分量 0~1，透明度为 1）。" 返回值注释 = "RGBA 颜色" 折叠 @嵌入式方法 = "">
    参数 色相 <类型 = 单精度小数 注释 = "H，0~1">
    参数 饱和度 <类型 = 单精度小数 注释 = "S，0~1">
    参数 明度 <类型 = 单精度小数 注释 = "V，0~1">
    {
        @ ::imcn::HSVtoRGB(@<色相>, @<饱和度>, @<明度>)
    }

    方法 RGB转HSV <公开 静态 类型 = 四维数值 注释 = "把 RGB 颜色转成 HSV（返回值的 xyzw 对应 HSV 与 1）。" 返回值注释 = "HSV 分量" 折叠 @嵌入式方法 = "">
    参数 红色 <类型 = 单精度小数 注释 = "R，0~1">
    参数 绿色 <类型 = 单精度小数 注释 = "G，0~1">
    参数 蓝色 <类型 = 单精度小数 注释 = "B，0~1">
    {
        @ ::imcn::RGBtoHSV(@<红色>, @<绿色>, @<蓝色>)
    }


    # 链接、选项块与图像 | Link, Selector & Image

    方法 文本链接打开网址 <公开 静态 注释 = "创建可点击的超链接文本，点击后用系统默认浏览器打开网址。" 折叠 @嵌入式方法 = "">
    参数 显示文本 <类型 = 文本型 注释 = "链接上显示的文字">
    参数 网址 <类型 = 文本型 注释 = "点击后打开的地址，可留空表示用显示文本本身" @默认值 = "">
    {
        @ ImGui::TextLinkOpenURL(IMCN_U8(@<显示文本>), IMCN_U8(@<网址>))
    }

    方法 显示样式选择器 <公开 静态 类型 = 逻辑型 注释 = "插入一个样式下拉框，用户可即时切换 ImGui 内置配色。" 返回值注释 = "样式被切换返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "下拉框标签">
    {
        @ ImGui::ShowStyleSelector(IMCN_U8(@<标签文本>))
    }

    方法 显示字体选择器 <公开 静态 注释 = "插入一个字体下拉框，用户可即时切换已加载的字体。" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "下拉框标签">
    {
        @ ImGui::ShowFontSelector(IMCN_U8(@<标签文本>))
    }

    方法 置颜色编辑选项 <公开 静态 注释 = "设置后续颜色编辑控件的默认输入方式（RGB/HSV/十六进制等），一般只在启动时调用一次。" 折叠 @嵌入式方法 = "">
    参数 颜色编辑标志 <类型 = 整数 注释 = "颜色编辑标志，可用\"颜色编辑标志\"类中的常量">
    {
        @ ImGui::SetColorEditOptions((ImGuiColorEditFlags)@<颜色编辑标志>)
    }

    方法 置选项卡项已关闭 <公开 静态 注释 = "提前通知选项卡栏或停靠系统某个选项卡已被关闭，可减少可拖动选项卡的闪烁。" 折叠 @嵌入式方法 = "">
    参数 选项卡名称 <类型 = 文本型 注释 = "被关闭的选项卡标题，或窗口标题">
    {
        @ ImGui::SetTabItemClosed(IMCN_U8(@<选项卡名称>))
    }

    方法 选项卡按钮 <公开 静态 类型 = 逻辑型 注释 = "创建一个外观像选项卡的按钮，用于在选项卡栏中放置\"新建\"之类的动作入口。" 返回值注释 = "被点击返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "按钮文字">
    参数 选项卡项标志 <类型 = 整数 注释 = "选项卡项标志，可用\"选项卡项标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::TabItemButton(IMCN_U8(@<标签文本>), (ImGuiTabItemFlags)@<选项卡项标志>)
    }

    方法 图像带背景 <公开 静态 注释 = "绘制一张带背景色的图像，透明像素处会显示背景色，避免贴图与背景混色发灰。" 折叠 @嵌入式方法 = "">
    参数 纹理标识 <类型 = 变整数 注释 = "纹理标识，由\"取纹理标识\"取得">
    参数 图像尺寸 <类型 = 二维坐标值 注释 = "显示尺寸（像素）">
    参数 背景颜色 <类型 = 四维数值 注释 = "背景色（红绿蓝透明度，0~1），透明像素处显示该颜色">
    {
        @ ImGui::ImageWithBg((ImTextureID)@<纹理标识>, @<图像尺寸>, ImVec2(0, 0), ImVec2(1, 1), @<背景颜色>, ImVec4(1, 1, 1, 1))
    }


    # 载荷探查 | Payload Peek

    方法 取拖放载荷 <公开 静态 类型 = 变整数 注释 = "取回当前拖放载荷结构（ImGuiPayload）的裸指针，可在任意位置窥探正在拖动的数据，不必写在拖放目标块里。返回 0 表示当前没有拖放或拖放已结束。" 返回值注释 = "载荷结构指针" 折叠 @嵌入式方法 = "">
    {
        @ (long long)(intptr_t)ImGui::GetDragDropPayload()
    }


    # 手工树缩进 | Manual Tree Push

    方法 推入树节点 <公开 静态 注释 = "手动压入一层树缩进与标识，用于把自定义内容画成树节点的样子；\"树节点\"返回真时内部已自动压入，不要重复调用。需与\"树节点结束\"配对。" 折叠 @嵌入式方法 = "">
    参数 标识文本 <类型 = 文本型 注释 = "本层唯一标识，用于保存展开状态">
    {
        @ ImGui::TreePush(IMCN_U8(@<标识文本>))
    }

}
类 界面数值控件 <公开 注释 = "多分量数值控件：双/三/四分量输入框、滑块、拖动框，以及带提示的文本输入。" 折叠>
{
    # 多分量输入 | Multi-component Input

    方法 输入小数二 <公开 静态 类型 = 逻辑型 注释 = "创建由两个小数分量组成的输入框。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签，可用\"##\"隐藏显示部分">
    参数 数值变量 <类型 = 二维坐标值 @需求类型 = 可写入变量 注释 = "必须传入一个二维坐标值变量">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，如 \"%.2f\"" @默认值 = "%.3f">
    {
        @ ImGui::InputFloat2(IMCN_U8(@<标签文本>), (float*)&@<数值变量>, IMCN_U8(@<显示格式>))
    }

    方法 输入小数三 <公开 静态 类型 = 逻辑型 注释 = "创建由三个小数分量组成的输入框，用四维数值变量承载前三个分量。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签，可用\"##\"隐藏显示部分">
    参数 数值变量 <类型 = 四维数值 @需求类型 = 可写入变量 注释 = "必须传入一个四维数值变量，仅前三个分量参与编辑">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，如 \"%.2f\"" @默认值 = "%.3f">
    {
        @ ImGui::InputFloat3(IMCN_U8(@<标签文本>), (float*)&@<数值变量>, IMCN_U8(@<显示格式>))
    }

    方法 输入小数四 <公开 静态 类型 = 逻辑型 注释 = "创建由四个小数分量组成的输入框。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "输入框标签，可用\"##\"隐藏显示部分">
    参数 数值变量 <类型 = 四维数值 @需求类型 = 可写入变量 注释 = "必须传入一个四维数值变量">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，如 \"%.2f\"" @默认值 = "%.3f">
    {
        @ ImGui::InputFloat4(IMCN_U8(@<标签文本>), (float*)&@<数值变量>, IMCN_U8(@<显示格式>))
    }

    # 多分量滑块 | Multi-component Slider

    方法 滑块小数二 <公开 静态 类型 = 逻辑型 注释 = "创建由两个分量组成的横向滑块组。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "滑块标签，可用\"##\"隐藏显示部分">
    参数 数值变量 <类型 = 二维坐标值 @需求类型 = 可写入变量 注释 = "必须传入一个二维坐标值变量">
    参数 最小值 <类型 = 单精度小数 注释 = "滑块左端值">
    参数 最大值 <类型 = 单精度小数 注释 = "滑块右端值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，如 \"%.2f\"" @默认值 = "%.3f">
    参数 滑块标志 <类型 = 整数 注释 = "滑块标志，可用\"滑块标志\"类中的常量" @默认值 = 0>
    {
        @ ImGui::SliderFloat2(IMCN_U8(@<标签文本>), (float*)&@<数值变量>, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志>)
    }

    方法 滑块小数三 <公开 静态 类型 = 逻辑型 注释 = "创建由三个分量组成的横向滑块组，用四维数值变量承载前三个分量。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "滑块标签，可用\"##\"隐藏显示部分">
    参数 数值变量 <类型 = 四维数值 @需求类型 = 可写入变量 注释 = "必须传入一个四维数值变量，仅前三个分量参与编辑">
    参数 最小值 <类型 = 单精度小数 注释 = "滑块左端值">
    参数 最大值 <类型 = 单精度小数 注释 = "滑块右端值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，如 \"%.2f\"" @默认值 = "%.3f">
    参数 滑块标志 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ImGui::SliderFloat3(IMCN_U8(@<标签文本>), (float*)&@<数值变量>, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志>)
    }

    方法 滑块小数四 <公开 静态 类型 = 逻辑型 注释 = "创建由四个分量组成的横向滑块组。" 返回值注释 = "数值被修改返回真" 折叠 @嵌入式方法 = "">
    参数 标签文本 <类型 = 文本型 注释 = "滑块标签，可用\"##\"隐藏显示部分">
    参数 数值变量 <类型 = 四维数值 @需求类型 = 可写入变量 注释 = "必须传入一个四维数值变量">
    参数 最小值 <类型 = 单精度小数 注释 = "滑块左端值">
    参数 最大值 <类型 = 单精度小数 注释 = "滑块右端值">
    参数 显示格式 <类型 = 文本型 注释 = "printf 风格格式，如 \"%.2f\"" @默认值 = "%.3f">
    参数 滑块标志 <类型 = 整数 注释 = "滑块标志" @默认值 = 0>
    {
        @ ImGui::SliderFloat4(IMCN_U8(@<标签文本>), (float*)&@<数值变量>, @<最小值>, @<最大值>, IMCN_U8(@<显示格式>), (ImGuiSliderFlags)@<滑块标志>)
