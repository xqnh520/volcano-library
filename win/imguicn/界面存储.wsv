<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 界面存储 <公开 注释 = "窗口级键值存储：按文本键保存整数/小数/逻辑值，数据跟随窗口生命周期（同一窗口的存储跨帧保持）。" 折叠>
{
    方法 置整数 <公开 静态 注释 = "写入一个整数键值。" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名，同一键在同窗口内唯一">
    参数 整数值 <类型 = 整数 注释 = "要保存的整数">
    {
        @ ::imcn::StorageSetInt(IMCN_U8(@<键文本>), (int)@<整数值>)
    }

    方法 取整数 <公开 静态 类型 = 整数 注释 = "读取一个整数键值，键不存在时返回默认值。" 返回值注释 = "保存的整数" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 默认值 <类型 = 整数 注释 = "键不存在时返回的值" @默认值 = 0>
    {
        @ ::imcn::StorageGetInt(IMCN_U8(@<键文本>), (int)@<默认值>)
    }

    方法 置小数 <公开 静态 注释 = "写入一个小数键值。" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 小数值 <类型 = 单精度小数 注释 = "要保存的小数">
    {
        @ ::imcn::StorageSetFloat(IMCN_U8(@<键文本>), @<小数值>)
    }

    方法 取小数 <公开 静态 类型 = 单精度小数 注释 = "读取一个小数键值，键不存在时返回默认值。" 返回值注释 = "保存的小数" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 默认值 <类型 = 单精度小数 注释 = "键不存在时返回的值" @默认值 = 0>
    {
        @ ::imcn::StorageGetFloat(IMCN_U8(@<键文本>), @<默认值>)
    }

    方法 置逻辑 <公开 静态 注释 = "写入一个逻辑键值。" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 逻辑值 <类型 = 逻辑型 注释 = "要保存的逻辑值">
    {
        @ ::imcn::StorageSetBool(IMCN_U8(@<键文本>), (bool)@<逻辑值>)
    }

    方法 取逻辑 <公开 静态 类型 = 逻辑型 注释 = "读取一个逻辑键值，键不存在时返回默认值。" 返回值注释 = "保存的逻辑值" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 默认值 <类型 = 逻辑型 注释 = "键不存在时返回的值" @默认值 = 假>
    {
        @ ::imcn::StorageGetBool(IMCN_U8(@<键文本>), (bool)@<默认值>)
    }

    方法 取条目数 <公开 静态 类型 = 整数 注释 = "取回当前窗口存储中已保存的键值对数量。" 返回值注释 = "条目数" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::StorageCount()
    }

    方法 清空 <公开 静态 注释 = "清空当前窗口的全部键值。" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::StorageClear()
    }

    方法 置指针 <公开 静态 注释 = "写入一个指针值（句柄）键值，配合\"取指针\"使用。" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 指针值 <类型 = 变整数 注释 = "要保存的指针/句柄">
    {
        @ ::imcn::StorageSetPtr(IMCN_U8(@<键文本>), (void*)(intptr_t)@<指针值>)
    }

    方法 取指针 <公开 静态 类型 = 变整数 注释 = "读取一个指针值键值，键不存在时返回 0。" 返回值注释 = "指针/句柄" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    {
        @ (intptr_t)::imcn::StorageGetPtr(IMCN_U8(@<键文本>))
    }


    # 数值引用 | Raw Value References
    # 高级用法：返回存储槽位的裸指针，配合自绘控件或外部缓冲直接读写，省掉每帧的哈希查找。

    方法 取整数引用 <公开 静态 类型 = 变整数 注释 = "高级用法：返回存储槽位的裸指针（int*），配合自绘/外部缓冲使用，可直接交给\"通用输入\"等需要数据指针的接口。返回 0 表示当前没有可用窗口。注意：之后再插入新键可能使旧指针失效，需重新获取。" 返回值注释 = "整数变量指针" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名，同一键在同窗口内唯一">
    参数 默认值 <类型 = 整数 注释 = "键不存在时写入的初始值" @默认值 = 0>
    {
        @ (long long)(intptr_t)::imcn::StorageGetIntRef(IMCN_U8(@<键文本>), (int)@<默认值>)
    }

    方法 取小数引用 <公开 静态 类型 = 变整数 注释 = "高级用法：返回存储槽位的裸指针（float*），配合自绘/外部缓冲使用，可直接交给\"通用滑块\"等需要数据指针的接口。返回 0 表示当前没有可用窗口。注意：之后再插入新键可能使旧指针失效，需重新获取。" 返回值注释 = "小数变量指针" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 默认值 <类型 = 单精度小数 注释 = "键不存在时写入的初始值" @默认值 = 0>
    {
        @ (long long)(intptr_t)::imcn::StorageGetFloatRef(IMCN_U8(@<键文本>), @<默认值>)
    }

    方法 取逻辑引用 <公开 静态 类型 = 变整数 注释 = "高级用法：返回存储槽位的裸指针（bool*），配合自绘/外部缓冲使用，可直接交给需要数据指针的逻辑型接口。返回 0 表示当前没有可用窗口。注意：之后再插入新键可能使旧指针失效，需重新获取。" 返回值注释 = "逻辑变量指针" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 默认值 <类型 = 逻辑型 注释 = "键不存在时写入的初始值" @默认值 = 假>
    {
        @ (long long)(intptr_t)::imcn::StorageGetBoolRef(IMCN_U8(@<键文本>), (bool)@<默认值>)
    }

    方法 取指针引用 <公开 静态 类型 = 变整数 注释 = "高级用法：返回存储槽位的裸指针（void**），可直接改写已保存的句柄，用于把存储当作外部对象表的挂点。返回 0 表示当前没有可用窗口。注意：之后再插入新键可能使旧指针失效，需重新获取。" 返回值注释 = "句柄变量指针" 折叠 @嵌入式方法 = "">
    参数 键文本 <类型 = 文本型 注释 = "键名">
    参数 默认值 <类型 = 变整数 注释 = "键不存在时写入的初始句柄，0 表示空" @默认值 = 0>
    {
        @ (long long)(intptr_t)::imcn::StorageGetPtrRef(IMCN_U8(@<键文本>), (void*)(intptr_t)@<默认值>)
    }

    方法 全部置整数 <公开 静态 注释 = "把当前窗口存储中的全部槽位统一写成同一个整数（底层是同一块联合内存，小数与逻辑槽位也会被覆盖）。常用于整表清零或统一初始化。注意：该调用会覆盖底层存储的全部键，包含 ImGui 自身用于表格、树节点与排序状态的槽位；仅当该窗口不使用这些状态时才可使用，否则控件状态会错乱。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数 注释 = "要写入的整数值">
    {
        @ ::imcn::StorageSetAllInt((int)@<值>)
    }

}
