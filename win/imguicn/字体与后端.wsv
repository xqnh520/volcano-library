<火山程序 类型 = "通常" 版本 = 1 />

包 火山.即时界面 <注释 = "Dear ImGui v1.91.9b-docking 的火山视窗中文封装，全中文类名/方法名/参数名/注释。" @视窗.头文件搜寻目录 = "imgui"
        @视窗.外部头文件 = "imcn_helper.h, imcn_host.h"
        @视窗.外部源文件 = "imgui\\imgui.cpp, imgui\\imgui_draw.cpp, imgui\\imgui_tables.cpp, imgui\\imgui_widgets.cpp, imgui\\imgui_demo.cpp, imgui\\misc\\cpp\\imgui_stdlib.cpp, imgui\\backends\\imgui_impl_win32.cpp, imgui\\backends\\imgui_impl_dx11.cpp">

类 界面字体 <公开 注释 = "字体命令：向字体图集加载字体、构建纹理、切换当前字体。" 折叠>
{
    方法 添加字体文件 <公开 静态 类型 = 字体对象 注释 = "从 TTF/OTF 文件加载字体，返回字体对象。" 返回值注释 = "字体对象" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件路径，可为相对路径">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, NULL)
    }

    方法 添加中文字体 <公开 静态 类型 = 字体对象 注释 = "加载字体并包含全部常用中文字形，适合中文界面。" 返回值注释 = "字体对象" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件路径（需包含中文字形，如 msyh.ttc）">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesChineseFull())
    }

    方法 添加简体中文字体 <公开 静态 类型 = 字体对象 注释 = "加载字体并只包含常用简体字形，纹理更小。" 返回值注释 = "字体对象" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件路径">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesChineseSimplifiedCommon())
    }

    方法 添加默认字体 <公开 静态 类型 = 字体对象 注释 = "添加 ImGui 内置的默认字体（仅含拉丁字符）。" 折叠 @嵌入式方法 = "">
    {
        @ ::imcn::AddFontDefaultW()
    }

    方法 取字体数量 <公开 静态 类型 = 整数 注释 = "取回字体图集中的字体数量。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Fonts->Fonts.Size
    }

    方法 构建图集 <公开 静态 注释 = "构建字体纹理。使用自定义纹理后端时，需要在渲染首帧之前调用一次。" 折叠 @嵌入式方法 = "">
    {
        @ unsigned char* pixels = NULL; int tw = 0; int th = 0; ImGui::GetIO().Fonts->GetTexDataAsRGBA32(&pixels, &tw, &th);
    }

    方法 压入字体 <公开 静态 注释 = "把指定字体压入字体栈，之后的内容使用该字体。" 折叠 @嵌入式方法 = "">
    参数 字体 <类型 = 字体对象 注释 = "欲使用的字体对象">
    {
        @ ImGui::PushFont(@<字体>)
    }

    方法 弹出字体 <公开 静态 注释 = "弹出字体栈顶字体。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::PopFont()
    }

    # 图集维护与字形范围 | Font Atlas

    方法 清空全部字体 <公开 静态 注释 = "清空字体图集中的全部字体与纹理数据，通常用于重建中文图集前。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Fonts->Clear()
    }

    方法 重建图集 <公开 静态 注释 = "按当前已添加的字体重建字体纹理。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Fonts->Build()
    }

    方法 添加日文字体 <公开 静态 注释 = "加载一个覆盖日文字形的字体文件。" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesJapanese())
    }

    方法 添加韩文字体 <公开 静态 注释 = "加载一个覆盖韩文字形的字体文件。" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesKorean())
    }

    方法 添加西里尔字体 <公开 静态 注释 = "加载一个覆盖西里尔字母的字体文件。" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesCyrillic())
    }

    方法 添加泰文字体 <公开 静态 注释 = "加载一个覆盖泰文字形的字体文件。" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesThai())
    }


    # 文本测量与内存字体 | Measurement & Memory Font

    方法 取文本像素尺寸 <公开 静态 类型 = 二维坐标值 注释 = "按指定字号测量文本的像素尺寸。换行宽度传 0 表示不换行。" 返回值注释 = "文本宽高" 折叠 @嵌入式方法 = "">
    参数 文本内容 <类型 = 文本型 注释 = "要测量的文本">
    参数 字号 <类型 = 单精度小数 注释 = "字号（像素）">
    参数 换行宽度 <类型 = 单精度小数 注释 = "超过该宽度自动换行，0 表示不换行" @默认值 = 0>
    {
        @ ImGui::GetFont()->CalcTextSizeA(@<字号>, FLT_MAX, @<换行宽度>, IMCN_U8(@<文本内容>))
    }

    方法 取换行字节位置 <公开 静态 类型 = 整数 注释 = "计算在给定宽度下应当换行的字节位置，用于手工排版。" 返回值注释 = "可容纳文本的字节长度" 折叠 @嵌入式方法 = "">
    参数 文本内容 <类型 = 文本型 注释 = "要排版的文本">
    参数 字号 <类型 = 单精度小数 注释 = "字号（像素）">
    参数 换行宽度 <类型 = 单精度小数 注释 = "行宽限制">
    {
        @ ::imcn::WordWrapByteOffset(@<字号>, @<文本内容>, @<换行宽度>)
    }

    方法 取字形是否存在 <公开 静态 类型 = 逻辑型 注释 = "查询当前字体是否包含指定码点的字形（含回退字形）。" 返回值注释 = "存在返回真" 折叠 @嵌入式方法 = "">
    参数 字符码点 <类型 = 整数 注释 = "Unicode 码点，如 0x4E2D">
    {
        @ ::imcn::HasGlyph((unsigned int)@<字符码点>)
    }

    方法 取字形前进宽度 <公开 静态 类型 = 单精度小数 注释 = "取回某个字符在当前字体下的步进宽度，可用于自绘文本对齐。" 返回值注释 = "步进宽度（像素）" 折叠 @嵌入式方法 = "">
    参数 字符码点 <类型 = 整数 注释 = "Unicode 码点，如 0x4E2D">
    {
        @ ::imcn::GlyphAdvance((unsigned int)@<字符码点>)
    }

    方法 取基准字号 <公开 静态 类型 = 单精度小数 注释 = "取回当前字体的基准字号（像素）。" 返回值注释 = "字号" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetFont()->FontSize
    }

    方法 从内存加载字体 <公开 静态 类型 = 逻辑型 注释 = "把字体文件读入内存后交给 ImGui（AddFontFromMemoryTTF 路径），只含拉丁字形。" 返回值注释 = "加载成功返回真" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径（建议 ASCII 路径）">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFromFileMemory(IMCN_U8(@<字体文件>), @<字号>, false)
    }

    方法 从内存加载中文字体 <公开 静态 类型 = 逻辑型 注释 = "以内存方式加载字体并请求完整中文字形范围。" 返回值注释 = "加载成功返回真" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径（建议 ASCII 路径）">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFromFileMemory(IMCN_U8(@<字体文件>), @<字号>, true)
    }

    方法 清空纹理数据 <公开 静态 注释 = "释放字体图集的 CPU 侧纹理数据（纹理已上传显卡后可调用以省内存）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Fonts->ClearTexData()
    }

    方法 清空输入数据 <公开 静态 注释 = "清空图集的输入数据（字体配置、TTF 数据、字形范围等）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Fonts->ClearInputData()
    }

    方法 取字形纹理尺寸 <公开 静态 类型 = 二维坐标值 注释 = "取回字体图集纹理的像素尺寸。" 返回值注释 = "纹理宽高" 折叠 @嵌入式方法 = "">
    {
        @ ImVec2((float)ImGui::GetIO().Fonts->TexWidth, (float)ImGui::GetIO().Fonts->TexHeight)
    }

    方法 是否已构建 <公开 静态 类型 = 逻辑型 注释 = "查询字体图集纹理是否已经构建完成。" 返回值注释 = "已构建返回真" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Fonts->IsBuilt()
    }


    方法 清空字体列表 <公开 静态 注释 = "清空图集里的全部字体（等价于 ClearFonts，输入与输出数据一并清除）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().Fonts->ClearFonts()
    }

    方法 添加西文字体 <公开 静态 注释 = "加载只覆盖拉丁/西文字形的字体文件（英文界面最省显存）。" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径（建议 ASCII 路径）">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesDefault())
    }

    方法 添加希腊字体 <公开 静态 注释 = "加载覆盖希腊字母的字体文件。" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径（建议 ASCII 路径）">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesGreek())
    }

    方法 添加越南字体 <公开 静态 注释 = "加载覆盖越南语声调字母的字体文件。" 折叠 @嵌入式方法 = "">
    参数 字体文件 <类型 = 文本型 注释 = "字体文件完整路径（建议 ASCII 路径）">
    参数 字号 <类型 = 单精度小数 注释 = "像素字号">
    {
        @ ::imcn::AddFontFileW(IMCN_U8(@<字体文件>), @<字号>, ImGui::GetIO().Fonts->GetGlyphRangesVietnamese())
    }

}
类 界面后端 <公开 注释 = "Windows + Direct3D 11 图形后端：创建窗口与设备、驱动帧循环、呈现画面。使用顺序：创建窗口 → 循环{ 处理消息 → 开始帧 → 绘制界面 → 渲染 → 呈现 } → 销毁。" 折叠>
{
    方法 创建窗口 <公开 静态 类型 = 变整数 注释 = "创建一个 Win32 窗口 + D3D11 设备，并初始化 ImGui 后端与上下文。返回值即宿主句柄。" 返回值注释 = "宿主句柄，失败返回 0" 折叠 @嵌入式方法 = "">
    参数 窗口标题 <类型 = 文本型 注释 = "窗口标题">
    参数 窗口宽度 <类型 = 整数 注释 = "窗口客户区宽度">
    参数 窗口高度 <类型 = 整数 注释 = "窗口客户区高度">
    {
        @ (intptr_t)::imcn::CreateHostW11(::imcn::ToW(IMCN_U8(@<窗口标题>)).c_str(), (int)@<窗口宽度>, (int)@<窗口高度>)
    }

    方法 处理消息 <公开 静态 类型 = 逻辑型 注释 = "处理窗口消息队列，返回假表示窗口已被关闭、应结束循环。" 返回值注释 = "继续运行返回真" 折叠 @嵌入式方法 = "">
    参数 宿主 <类型 = 变整数 注释 = "由\"创建窗口\"返回的宿主句柄">
    {
        @ ::imcn::PumpHostW11((::imcn::HostW11*)(intptr_t)@<宿主>)
    }

    方法 开始帧 <公开 静态 注释 = "通知后端开始新的一帧，需在\"即时界面.开始新帧\"之前调用。" 折叠 @嵌入式方法 = "">
    参数 宿主 <类型 = 变整数 注释 = "宿主句柄">
    {
        @ ((::imcn::HostW11*)(intptr_t)@<宿主>)->BeginFrame()
    }

    方法 呈现 <公开 静态 注释 = "清屏、绘制 ImGui 绘制数据并呈现到窗口，需在\"即时界面.渲染\"之后调用。" 折叠 @嵌入式方法 = "">
    参数 宿主 <类型 = 变整数 注释 = "宿主句柄">
    {
        @ ((::imcn::HostW11*)(intptr_t)@<宿主>)->EndFrame()
    }

    方法 销毁窗口 <公开 静态 注释 = "销毁窗口、设备并释放 ImGui 上下文。" 折叠 @嵌入式方法 = "">
    参数 宿主 <类型 = 变整数 注释 = "宿主句柄">
    {
        @ ::imcn::DestroyHostW11((::imcn::HostW11*)(intptr_t)@<宿主>)
    }

    方法 取窗口句柄 <公开 静态 类型 = 变整数 注释 = "取回底层 Win32 窗口句柄（HWND）。" 折叠 @嵌入式方法 = "">
    参数 宿主 <类型 = 变整数 注释 = "宿主句柄">
    {
        @ (intptr_t)(((::imcn::HostW11*)(intptr_t)@<宿主>)->Handle)
    }

    方法 取帧间隔 <公开 静态 类型 = 单精度小数 注释 = "取回本帧与上帧的时间间隔（秒）。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::GetIO().DeltaTime
    }

    # 多视口支持 | Multi-Viewport

    方法 更新平台窗口 <公开 静态 注释 = "主循环中调用：为每个次级视口创建、移动、销毁对应的平台窗口。启用多视口时必须每帧调用一次。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::UpdatePlatformWindows()
    }

    方法 绘制平台窗口 <公开 静态 注释 = "主循环中调用：渲染所有次级视口对应的平台窗口。启用多视口时必须每帧调用一次。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::RenderPlatformWindowsDefault(NULL, NULL)
    }

    方法 销毁平台窗口 <公开 静态 注释 = "销毁所有次级视口对应的平台窗口，用于退出前提前关闭窗口。" 折叠 @嵌入式方法 = "">
    {
        @ ImGui::DestroyPlatformWindows()
    }

}
