        句柄 = 对象指针
        路径句柄 = 路径.对象指针
        @ sk_canvas_clip_path_with_operation((sk_canvas_t*)@<句柄>, (const sk_path_t*)@<路径句柄>, (sk_clipop_t)@<裁剪方式>, (bool)@<抗锯齿>);
        返回 (真)
    }

    方法 裁剪圆角矩形 <公开 类型 = 逻辑型 注释 = "按圆角矩形裁剪; 裁剪方式 0 挖去/1 取交。">
