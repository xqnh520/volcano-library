    {
        @ ([&]() -> bool { sk_color4f_t* __c = (sk_color4f_t*)@sn<this>.@n<Skia浮点颜色.数据>.GetPtr(); __c->fR = (float)@<红值>; __c->fG = (float)@<绿值>; __c->fB = (float)@<蓝值>; __c->fA = (float)@<透明度值>; return true; }())
    }

