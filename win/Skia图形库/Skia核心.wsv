    方法 绘制图像 <公开 类型 = 逻辑型 注释 = "按左上角坐标绘制图像; 采样句柄传 0 表示默认(最近邻+无多级)。">
    参数 图像 <类型 = Skia图像>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 采样 <类型 = Skia采样选项>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 图指针 <类型 = 变整数>
        句柄 = 对象指针
        图指针 = 图像.对象指针
        @ sk_canvas_draw_image((sk_canvas_t*)@<句柄>, (const sk_image_t*)@<图指针>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制图像_按区域 <公开 类型 = 逻辑型 注释 = "按源矩形与目标矩形绘制图像, 实现缩放与裁剪。">
    参数 图像 <类型 = Skia图像>
    参数 源矩形 <类型 = Skia矩形>
    参数 目标矩形 <类型 = Skia矩形>
    参数 采样 <类型 = Skia采样选项>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 图指针 <类型 = 变整数>
        句柄 = 对象指针
        图指针 = 图像.对象指针
        @ sk_canvas_draw_image_rect((sk_canvas_t*)@<句柄>, (const sk_image_t*)@<图指针>, (const sk_rect_t*)@<源矩形>.@n<Skia矩形.数据>.GetPtr(), (const sk_rect_t*)@<目标矩形>.@n<Skia矩形.数据>.GetPtr(), (const sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制图片 <公开 类型 = 逻辑型 注释 = "回放已录制图片的绘制命令。">
    参数 图片 <类型 = Skia图片>
    参数 矩阵 <类型 = Skia矩阵>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 图指针 <类型 = 变整数>
        句柄 = 对象指针
        图指针 = 图片.对象指针
        @ sk_canvas_draw_picture((sk_canvas_t*)@<句柄>, (const sk_picture_t*)@<图指针>, (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制可绘制对象 <公开 类型 = 逻辑型 注释 = "绘制会变化的可绘制对象。">
    参数 可绘制对象 <类型 = Skia可绘制对象>
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 句柄 <类型 = 变整数>
        变量 对象指针值 <类型 = 变整数>
        句柄 = 对象指针
        对象指针值 = 可绘制对象.对象指针
        @ sk_canvas_draw_drawable((sk_canvas_t*)@<句柄>, (sk_drawable_t*)@<对象指针值>, (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
        返回 (真)
    }

    方法 绘制注释_键值 <公开 类型 = 逻辑型 注释 = "仅有 PDF/XPS 画布有效, 光栅画布忽略。">
    参数 矩形 <类型 = Skia矩形>
    参数 键名 <类型 = 文本型>
    参数 值数据 <类型 = Skia数据>
    {
        变量 句柄 <类型 = 变整数>
        变量 键名字节 <类型 = 字节集类>
        变量 数据指针 <类型 = 变整数>
        句柄 = 对象指针
        数据指针 = 值数据.对象指针
        键名字节 = 文本到UTF8 (键名, )
        @ sk_canvas_draw_annotation((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (const char*)@<键名字节>.GetPtr(), (sk_data_t*)@<数据指针>);
        返回 (真)
    }

    方法 绘制注释_网址 <公开 类型 = 逻辑型 注释 = "PDF/XPS 专用超链接注释; 值数据为网址字节。">
    参数 矩形 <类型 = Skia矩形>
    参数 值数据 <类型 = Skia数据>
    {
        变量 句柄 <类型 = 变整数>
        变量 数据指针 <类型 = 变整数>
        句柄 = 对象指针
        数据指针 = 值数据.对象指针
        @ sk_canvas_draw_url_annotation((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_data_t*)@<数据指针>);
        返回 (真)
    }

    方法 绘制注释_命名目标 <公开 类型 = 逻辑型 注释 = "PDF/XPS 专用命名目标注释; 值数据为目标名。">
    参数 锚点 <类型 = Skia点>
    参数 值数据 <类型 = Skia数据>
    {
        变量 句柄 <类型 = 变整数>
        变量 数据指针 <类型 = 变整数>
        句柄 = 对象指针
        数据指针 = 值数据.对象指针
        @ sk_canvas_draw_named_destination_annotation((sk_canvas_t*)@<句柄>, (const sk_point_t*)@<锚点>.@n<Skia点.数据>.GetPtr(), (sk_data_t*)@<数据指针>);
        返回 (真)
    }

    方法 绘制注释_链接目标 <公开 类型 = 逻辑型 注释 = "PDF/XPS 专用链接目标注释; 值数据为目标名。">
    参数 矩形 <类型 = Skia矩形>
    参数 值数据 <类型 = Skia数据>
    {
        变量 句柄 <类型 = 变整数>
        变量 数据指针 <类型 = 变整数>
        句柄 = 对象指针
        数据指针 = 值数据.对象指针
        @ sk_canvas_draw_link_destination_annotation((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_data_t*)@<数据指针>);
        返回 (真)
    }

    方法 绘制九宫格图像 <公开 类型 = 逻辑型 注释 = "按九宫格拉伸绘制图像; 过滤方式 0 最近邻/1 线性。">
    参数 图像 <类型 = Skia图像>
    参数 中心 <类型 = Skia整数矩形>
    参数 目标矩形 <类型 = Skia矩形>
    参数 过滤方式 <类型 = 整数 @默认值 = 1>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 图像指针 <类型 = 变整数>
        句柄 = 对象指针
        图像指针 = 图像.对象指针
        @ sk_canvas_draw_image_nine((sk_canvas_t*)@<句柄>, (const sk_image_t*)@<图像指针>, (const sk_irect_t*)@<中心>.@n<Skia整数矩形.数据>.GetPtr(), (const sk_rect_t*)@<目标矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_filter_mode_t)@<过滤方式>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制顶点 <公开 类型 = 逻辑型 注释 = "绘制三角网格(逐顶点着色); 顶点句柄为 sk_vertices_t*。">
    参数 顶点 <类型 = Skia顶点>
    参数 混合方式 <类型 = 整数 @默认值 = 3>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 顶点指针 <类型 = 变整数>
        句柄 = 对象指针
        顶点指针 = 顶点.对象指针
        @ sk_canvas_draw_vertices((sk_canvas_t*)@<句柄>, (const sk_vertices_t*)@<顶点指针>, (sk_blendmode_t)@<混合方式>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制双层圆角矩形 <公开 类型 = 逻辑型 注释 = "描边时画环, 填充时挖洞。">
    参数 外框 <类型 = Skia圆角矩形>
    参数 内框 <类型 = Skia圆角矩形>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 外框句柄 <类型 = 变整数>
        变量 内框句柄 <类型 = 变整数>
        句柄 = 对象指针
        外框句柄 = 外框.对象指针
        内框句柄 = 内框.对象指针
        @ sk_canvas_draw_drrect((sk_canvas_t*)@<句柄>, (const sk_rrect_t*)@<外框句柄>, (const sk_rrect_t*)@<内框句柄>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制补片 <公开 类型 = 逻辑型 注释 = "绘制补片; 控制点数据 96 字节(12 点)/颜色数据 16 字节(4 个色)/纹理坐标数据 32 字节(4 点)。">
    参数 控制点数据 <类型 = 字节集类>
    参数 颜色数据 <类型 = 字节集类>
    参数 纹理坐标数据 <类型 = 字节集类>
    参数 混合方式 <类型 = 整数 @默认值 = 3>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_patch((sk_canvas_t*)@<句柄>, (const sk_point_t*)@<控制点数据>.GetPtr(), (const sk_color_t*)@<颜色数据>.GetPtr(), (const sk_point_t*)@<纹理坐标数据>.GetPtr(), (sk_blendmode_t)@<混合方式>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 裁剪是否为空 <公开 类型 = 逻辑型 注释 = "为真表示当前裁剪区域没有任何像素, 可跳过整段绘制。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_canvas_is_clip_empty((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>) != 0)
    }

    方法 裁剪是否为矩形 <公开 类型 = 逻辑型 注释 = "为真表示裁剪是单一矩形(可走快速路径)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_canvas_is_clip_rect((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>) != 0)
    }

    方法 取所属表面 <公开 类型 = Skia表面 注释 = "取本画布所属的表面; 返回借用对象(是否拥有句柄=假), 不要释放; 非表面画布返回空对象。">
    {
        变量 结果 <类型 = Skia表面>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_get_surface((sk_canvas_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }
}
