类 Skia图像信息 <公开 注释 = "sk_imageinfo_t: 像素格式描述, 24 字节。实测内存布局(以 deps\skia\include\c\sk_types.h 与 docs\值类清单.md 为准): 偏移 0 颜色空间(8 字节指针), 偏移 8 宽(int32), 偏移 12 高(int32), 偏移 16 颜色类型(int32), 偏移 20 透明度类型(int32)。注意 colorspace 在最前, 不是宽高在最前。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "24 字节缓冲, 对应 sk_imageinfo_t。">

    方法 类_初始化 <公开 注释 = "分配 24 字节缓冲并清零(颜色空间 0 表示默认 sRGB)。">
    {
        数据 = 取空白字节集 (24)
    }

    方法 新建 <公开 静态 类型 = Skia图像信息 注释 = "静态; 建 宽值×高值 的描述。颜色类型固定 6 = BGRA_8888(内存字节序 B,G,R,A), 透明度类型固定 2 = PREMUL(预乘), 颜色空间 0 = 默认 sRGB。这是 SkiaSharp 在 Windows 上最常见的光栅格式, 也是 新建_按像素 最省事的组合。">
    参数 宽值 <类型 = 整数>
    参数 高值 <类型 = 整数>
    {
        变量 结果 <类型 = Skia图像信息>
        结果.置宽 (宽值)
        结果.置高 (高值)
        结果.置颜色类型 (6)
        结果.置透明度类型 (2)
        结果.置颜色空间 (0)
        返回 (结果)
    }

    方法 新建_完整 <公开 静态 类型 = Skia图像信息 注释 = "静态; 指定 颜色类型值/透明度类型值。颜色类型值 4 = RGBA_8888, 6 = BGRA_8888; 透明度类型值 1 = 不透明, 2 = 预乘, 3 = 非预乘。颜色空间固定 0(默认 sRGB), 需要非 sRGB 时再调 置颜色空间。">
    参数 宽值 <类型 = 整数>
    参数 高值 <类型 = 整数>
    参数 颜色类型值 <类型 = 整数>
    参数 透明度类型值 <类型 = 整数>
    {
        变量 结果 <类型 = Skia图像信息>
        结果.置宽 (宽值)
        结果.置高 (高值)
        结果.置颜色类型 (颜色类型值)
        结果.置透明度类型 (透明度类型值)
        返回 (结果)
    }

    方法 宽 <公开 属性读 类型 = 整数 注释 = "宽度(像素)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->width)
    }

    方法 高 <公开 属性读 类型 = 整数 注释 = "高度(像素)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->height)
    }

    方法 颜色类型 <公开 属性读 类型 = 整数 注释 = "颜色类型(sk_colortype_t): 4 = RGBA_8888, 6 = BGRA_8888。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->colorType)
    }

    方法 透明度类型 <公开 属性读 类型 = 整数 注释 = "透明度类型(sk_alphatype_t): 1 不透明/2 预乘/3 非预乘。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->alphaType)
    }

    方法 颜色空间 <公开 属性读 类型 = 变整数 注释 = "颜色空间句柄(sk_colorspace_t*); 0 表示默认 sRGB。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)((const sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->colorspace)
    }

    方法 置宽 <公开 类型 = 逻辑型 注释 = "设置宽度。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (((sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->width = (int32_t)@<值>, true)
    }

    方法 置高 <公开 类型 = 逻辑型 注释 = "设置高度。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (((sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->height = (int32_t)@<值>, true)
    }

    方法 置颜色类型 <公开 类型 = 逻辑型 注释 = "设置颜色类型(4 = RGBA_8888, 6 = BGRA_8888)。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (((sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->colorType = (sk_colortype_t)@<值>, true)
    }

    方法 置透明度类型 <公开 类型 = 逻辑型 注释 = "设置透明度类型(1 不透明/2 预乘/3 非预乘)。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (((sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->alphaType = (sk_alphatype_t)@<值>, true)
    }

    方法 置颜色空间 <公开 类型 = 逻辑型 注释 = "设置颜色空间句柄; 0 表示默认 sRGB。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 变整数>
    {
        @ (((sk_imageinfo_t*)@sn<this>.@n<Skia图像信息.数据>.GetPtr())->colorspace = (sk_colorspace_t*)@<值>, true)
    }

    方法 行字节数 <公开 属性读 类型 = 变整数 注释 = "每行字节数 = 宽 × 4(假定每像素 4 字节, 即 RGBA_8888/BGRA_8888); 直接用作 新建_按像素 的行字节数参数。">
    {
        变量 结果 <类型 = 变整数>
        结果 = 宽 * 4
        返回 (结果)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_imageinfo_t*); 0 表示缓冲无效。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia图像信息.数据>.GetPtr())
    }
}

# ============================================================
# 三、画笔
# ============================================================

类 Skia画笔 <公开 注释 = "绘制属性容器(sk_paint_t): 颜色/样式/线宽/线帽/转角/混合方式/着色器等。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia画笔.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia画笔 注释 = "创建默认画笔(黑色/填充/抗锯齿)。">
    {
        变量 结果 <类型 = Skia画笔>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_paint_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 克隆 <公开 类型 = Skia画笔 注释 = "复制本画笔的全部属性; 返回的新对象独立拥有句柄。">
    {
        变量 结果 <类型 = Skia画笔>
        变量 旧指针 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        旧指针 = 对象指针
        @ @<新指针> = (intptr_t)sk_paint_clone((sk_paint_t*)@<旧指针>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_paint_delete((sk_paint_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事。火山值类按值复制会共享同一个原生句柄, 在 类_清理 里自动销毁会造成重复释放/悬空句柄, 因此句柄一律由调用方显式 释放。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia画笔.对象指针> != 0)
    }


    方法 置颜色 <公开 注释 = "设置颜色(0xAARRGGBB)。" 折叠 @嵌入式方法 = "">
    参数 颜色 <类型 = 整数>
    {
        @ sk_paint_set_color((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_color_t)@<颜色>)
    }

    方法 取颜色 <公开 类型 = 整数 注释 = "取颜色(0xAARRGGBB)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_paint_get_color((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置样式 <公开 注释 = "设置样式: 0 填充, 1 描边, 2 填充并描边(sk_paint_style_t)。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ sk_paint_set_style((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_paint_style_t)@<方式>)
    }

    方法 取样式 <公开 类型 = 整数 注释 = "取样式枚举值。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_paint_get_style((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置线宽 <公开 注释 = "设置描边线宽。" 折叠 @嵌入式方法 = "">
    参数 线宽 <类型 = 小数>
    {
        @ sk_paint_set_stroke_width((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (float)@<线宽>)
    }

    方法 取线宽 <公开 类型 = 小数 注释 = "取描边线宽。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_paint_get_stroke_width((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置抗锯齿 <公开 注释 = "开启/关闭抗锯齿。" 折叠 @嵌入式方法 = "">
    参数 是否开启 <类型 = 逻辑型>
    {
        @ sk_paint_set_antialias((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (bool)@<是否开启>)
    }

    方法 是否抗锯齿 <公开 类型 = 逻辑型 注释 = "是否开启抗锯齿。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_paint_is_antialias((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>) != 0)
    }

    方法 置线帽 <公开 注释 = "设置线帽: 0 平头, 1 圆头, 2 方头(sk_stroke_cap_t)。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ sk_paint_set_stroke_cap((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_stroke_cap_t)@<方式>)
    }

    方法 置转角 <公开 注释 = "设置转角: 0 尖角, 1 圆角, 2 斜角(sk_stroke_join_t)。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ sk_paint_set_stroke_join((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_stroke_join_t)@<方式>)
    }

    方法 置斜接限制 <公开 注释 = "设置尖角连接的斜接限制(仅尖角转角有效)。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 小数>
    {
        @ sk_paint_set_stroke_miter((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (float)@<值>)
    }

    方法 置混合方式 <公开 注释 = "设置混合方式(sk_blendmode_t 枚举值, 3 为 SrcOver)。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ sk_paint_set_blendmode((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_blendmode_t)@<方式>)
    }

    方法 取混合方式 <公开 类型 = 整数 注释 = "取混合方式枚举值。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_paint_get_blendmode((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置抖色 <公开 注释 = "开启/关闭抖动。" 折叠 @嵌入式方法 = "">
    参数 是否开启 <类型 = 逻辑型>
    {
        @ sk_paint_set_dither((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (bool)@<是否开启>)
    }

    方法 置着色器 <公开 类型 = 逻辑型 注释 = "设置着色器; 传空对象表示清除。着色器所有权仍归调用方, 本画笔不接管。">
    参数 着色器 <类型 = Skia着色器>
    {
        变量 句柄 <类型 = 变整数>
        变量 色句柄 <类型 = 变整数>
        句柄 = 对象指针
        色句柄 = 着色器.对象指针
        @ sk_paint_set_shader((sk_paint_t*)@<句柄>, (sk_shader_t*)@<色句柄>);
        返回 (真)
    }

    方法 取着色器 <公开 类型 = Skia着色器 注释 = "取当前着色器; 返回借用对象(是否拥有句柄=假), 不要释放。">
    {
        变量 结果 <类型 = Skia着色器>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_paint_get_shader((sk_paint_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 重置 <公开 注释 = "恢复全部默认值(黑色/填充/抗锯齿/线宽 0 等)。" 折叠 @嵌入式方法 = "">
    {
        @ sk_paint_reset((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>)
    }

    方法 取浮点颜色 <公开 类型 = 逻辑型 注释 = "取 0~1 浮点颜色写入 结果颜色(顺序 R,G,B,A)。">
    参数 结果颜色 <类型 = Skia浮点颜色>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_paint_get_color4f((const sk_paint_t*)@<句柄>, (sk_color4f_t*)@<结果颜色>.@n<Skia浮点颜色.数据>.GetPtr());
        返回 (真)
    }

    方法 置浮点颜色 <公开 类型 = 逻辑型 注释 = "按 0~1 浮点分量设置颜色; 颜色空间句柄传 0 表示 sRGB。">
    参数 颜色 <类型 = Skia浮点颜色>
    参数 颜色空间句柄 <类型 = 变整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_paint_set_color4f((sk_paint_t*)@<句柄>, (sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr(), (sk_colorspace_t*)@<颜色空间句柄>);
        返回 (真)
    }

    方法 取斜接限制 <公开 类型 = 小数 注释 = "取尖角连接的斜接限制(默认 4.0)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_paint_get_stroke_miter((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 取线帽 <公开 类型 = 整数 注释 = "取线帽: 0 平头/1 圆头/2 方头。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_paint_get_stroke_cap((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 取转角 <公开 类型 = 整数 注释 = "取转角: 0 尖角/1 圆角/2 斜角。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_paint_get_stroke_join((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置遮罩滤镜 <公开 注释 = "设置遮罩滤镜(sk_maskfilter_t 句柄); 传 0 表示清除。" 折叠 @嵌入式方法 = "">
    参数 滤镜句柄 <类型 = 变整数 @默认值 = 0>
    {
        @ sk_paint_set_maskfilter((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_maskfilter_t*)@<滤镜句柄>)
    }

    方法 取遮罩滤镜 <公开 类型 = 变整数 注释 = "取遮罩滤镜句柄(借用, 不要释放); 0 表示没有。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_paint_get_maskfilter((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置混合器 <公开 注释 = "设置混合器(sk_blender_t 句柄); 传 0 表示清除。置混合器后 置混合方式 失效。" 折叠 @嵌入式方法 = "">
    参数 混合器句柄 <类型 = 变整数 @默认值 = 0>
    {
        @ sk_paint_set_blender((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_blender_t*)@<混合器句柄>)
    }

    方法 取混合器 <公开 类型 = 变整数 注释 = "取混合器句柄(借用, 不要释放); 0 表示没有。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_paint_get_blender((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 是否抖色 <公开 类型 = 逻辑型 注释 = "是否开启抖动(默认假)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_paint_is_dither((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>) != 0)
    }

    方法 取颜色滤镜 <公开 类型 = 变整数 注释 = "取颜色滤镜句柄(借用, 不要释放); 0 表示没有。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_paint_get_colorfilter((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置颜色滤镜 <公开 注释 = "设置颜色滤镜(sk_colorfilter_t 句柄); 传 0 表示清除。" 折叠 @嵌入式方法 = "">
    参数 滤镜句柄 <类型 = 变整数 @默认值 = 0>
    {
        @ sk_paint_set_colorfilter((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_colorfilter_t*)@<滤镜句柄>)
    }

    方法 取图像滤镜 <公开 类型 = 变整数 注释 = "取图像滤镜句柄(借用, 不要释放); 0 表示没有。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_paint_get_imagefilter((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>))
    }

    方法 置图像滤镜 <公开 注释 = "设置图像滤镜(sk_imagefilter_t 句柄); 传 0 表示清除。" 折叠 @嵌入式方法 = "">
    参数 滤镜句柄 <类型 = 变整数 @默认值 = 0>
    {
        @ sk_paint_set_imagefilter((sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>, (sk_imagefilter_t*)@<滤镜句柄>)
    }

    方法 取路径效果 <公开 类型 = Skia路径效果 注释 = "取当前路径效果; 返回借用对象(是否拥有句柄=假), 不要释放。">
    {
        变量 结果 <类型 = Skia路径效果>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_paint_get_path_effect((sk_paint_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 置路径效果 <公开 类型 = 逻辑型 注释 = "设置描边路径效果(虚线/圆角/裁剪等); 效果句柄传 0 表示清除。置入后所有权归画笔。">
    参数 效果 <类型 = Skia路径效果>
    {
        变量 句柄 <类型 = 变整数>
        变量 效果句柄 <类型 = 变整数>
        句柄 = 对象指针
        效果句柄 = 效果.对象指针
        @ sk_paint_set_path_effect((sk_paint_t*)@<句柄>, (sk_path_effect_t*)@<效果句柄>);
        返回 (真)
    }

    方法 取填充路径 <公开 类型 = 逻辑型 注释 = "把画笔的「描边」转换成「可填充轮廓」写入 目标构建器, 用于描边转面。">
    参数 源路径 <类型 = Skia路径>
    参数 目标构建器 <类型 = Skia路径构建器>
    参数 剔除矩形 <类型 = Skia矩形>
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 句柄 <类型 = 变整数>
        变量 源句柄 <类型 = 变整数>
        变量 构建器句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        源句柄 = 源路径.对象指针
        构建器句柄 = 目标构建器.对象指针
        @ @<结果> = (sk_paint_get_fill_path((const sk_paint_t*)@<句柄>, (const sk_path_t*)@<源句柄>, (sk_pathbuilder_t*)@<构建器句柄>, (const sk_rect_t*)@<剔除矩形>.@n<Skia矩形.数据>.GetPtr(), (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 是否支持快速边界 <公开 类型 = 逻辑型 注释 = "为真才可调用 计算快速边界。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_paint_can_compute_fast_bounds((const sk_paint_t*)@sn<this>.@n<Skia画笔.对象指针>) != 0)
    }

    方法 计算快速边界 <公开 类型 = 逻辑型 注释 = "含描边宽与特效后的外扩边界写入 结果矩形。">
    参数 原矩形 <类型 = Skia矩形>
    参数 结果矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_paint_compute_fast_bounds((const sk_paint_t*)@<句柄>, (const sk_rect_t*)@<原矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }
}

# ============================================================
# 四、路径
# ============================================================

类 Skia路径 <公开 注释 = "路径(sk_path_t): 由直线/曲线/圆/矩形等图元组成的几何轮廓。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia路径 注释 = "创建空路径。">
    {
        变量 结果 <类型 = Skia路径>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_path_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 克隆 <公开 类型 = Skia路径 注释 = "复制本路径; 返回的新对象独立拥有句柄。">
    {
        变量 结果 <类型 = Skia路径>
        变量 旧指针 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        旧指针 = 对象指针
        @ @<新指针> = (intptr_t)sk_path_clone((const sk_path_t*)@<旧指针>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_path_delete((sk_path_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事。火山值类按值复制会共享同一个原生句柄, 在 类_清理 里自动销毁会造成重复释放/悬空句柄, 因此句柄一律由调用方显式 释放。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径.对象指针> != 0)
    }

    方法 取边界 <公开 类型 = 逻辑型 注释 = "取控制点包围盒(保守边界)写入 矩形。">
    参数 矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_path_get_bounds((const sk_path_t*)@<句柄>, (sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 取精确边界 <公开 类型 = 逻辑型 注释 = "取曲线精确包围盒写入 矩形(计算量比 取边界 大)。">
    参数 矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_path_compute_tight_bounds((const sk_path_t*)@<句柄>, (sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 取填充方式 <公开 类型 = 整数 注释 = "取填充规则(sk_path_filltype_t: 0 环绕, 1 奇偶...)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_path_get_filltype((sk_path_t*)@sn<this>.@n<Skia路径.对象指针>))
    }

    方法 置填充方式 <公开 注释 = "设置填充规则(sk_path_filltype_t)。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ sk_path_set_filltype((sk_path_t*)@sn<this>.@n<Skia路径.对象指针>, (sk_path_filltype_t)@<方式>)
    }

    方法 变换 <公开 类型 = 逻辑型 注释 = "用矩阵就地变换本路径。">
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_path_transform((sk_path_t*)@<句柄>, (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
        返回 (真)
    }

    方法 重置 <公开 注释 = "清空路径(保留已分配容量)。" 折叠 @嵌入式方法 = "">
    {
        @ sk_path_reset((sk_path_t*)@sn<this>.@n<Skia路径.对象指针>)
    }

    方法 回退到起点 <公开 注释 = "回退到起点(保留填充方式与已分配容量, 比 重置 便宜); 与 重置 语义不同: 重置 会清空全部图元。" 折叠 @嵌入式方法 = "">
    {
        @ sk_path_rewind((sk_path_t*)@sn<this>.@n<Skia路径.对象指针>)
    }

    方法 取点数 <公开 类型 = 整数 注释 = "取路径内控制点总数。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_path_count_points((const sk_path_t*)@sn<this>.@n<Skia路径.对象指针>))
    }

    方法 取图元数 <公开 类型 = 整数 注释 = "取路径内图元(verb)总数。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_path_count_verbs((const sk_path_t*)@sn<this>.@n<Skia路径.对象指针>))
    }

    方法 是否包含点 <公开 类型 = 逻辑型 注释 = "点是否落在路径填充区域内。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ (sk_path_contains((const sk_path_t*)@sn<this>.@n<Skia路径.对象指针>, (float)@<横坐标>, (float)@<纵坐标>) != 0)
    }

    方法 是否凸 <公开 类型 = 逻辑型 注释 = "路径是否凸多边形(仅直线段有意义)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_path_is_convex((const sk_path_t*)@sn<this>.@n<Skia路径.对象指针>) != 0)
    }

    方法 取末点 <公开 类型 = 逻辑型 注释 = "取最后一个点写入 点; 路径为空返回假。">
    参数 点 <类型 = Skia点>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_path_get_last_point((const sk_path_t*)@<句柄>, (sk_point_t*)@<点>.@n<Skia点.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 变换到 <公开 类型 = 逻辑型 注释 = "把变换结果写入 目标路径, 自身不变。">
    参数 矩阵 <类型 = Skia矩阵>
    参数 目标路径 <类型 = Skia路径>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        句柄 = 对象指针
        目标句柄 = 目标路径.对象指针
        @ sk_path_transform_to_dest((const sk_path_t*)@<句柄>, (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr(), (sk_path_t*)@<目标句柄>);
        返回 (真)
    }

    方法 取点 <公开 类型 = 逻辑型 注释 = "取第 序号 个控制点写入 结果点(序号从 0 开始, 越界返回 (0,0))。">
    参数 序号 <类型 = 整数>
    参数 结果点 <类型 = Skia点>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_path_get_point((const sk_path_t*)@<句柄>, @<序号>, (sk_point_t*)@<结果点>.@n<Skia点.数据>.GetPtr());
        返回 (真)
    }

    方法 取全部点 <公开 类型 = 整数 注释 = "把最多 最大点数 个控制点写入 结果数据(每点 8 字节), 返回实际写入点数。">
    参数 结果数据 <类型 = 字节集类>
    参数 最大点数 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = (sk_path_get_points((const sk_path_t*)@<句柄>, (sk_point_t*)@<结果数据>.GetPtr(), @<最大点数>));
        返回 (结果)
    }

    方法 解析SVG文本 <公开 类型 = 逻辑型 注释 = "按 SVG path 的 d 串语法解析并替换本路径内容(如 M10 10 L20 20 Z); 失败返回假。">
    参数 路径文本 <类型 = 文本型>
    {
        变量 句柄 <类型 = 变整数>
        变量 数据 <类型 = 字节集类>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        数据 = 文本到UTF8 (路径文本, )
        @ @<结果> = (sk_path_parse_svg_string((sk_path_t*)@<句柄>, (const char*)@<数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 转SVG文本 <公开 类型 = 逻辑型 注释 = "把本路径输出成 SVG path 的 d 串, 结果由 Skia字符串 对象承载; 目前以 sk_string_t 句柄(变整数)承载。">
    参数 字符串 <类型 = Skia字符串>
    {
        变量 句柄 <类型 = 变整数>
        变量 串指针 <类型 = 变整数>
        句柄 = 对象指针
        串指针 = 字符串.对象指针
        @ sk_path_to_svg_string((const sk_path_t*)@<句柄>, (sk_string_t*)@<串指针>);
        返回 (真)
    }

    方法 圆锥转二次 <公开 静态 类型 = 整数 注释 = "静态; 把圆锥曲线拆成二次曲线, 结果写入 结果数据(每点 8 字节, 需 对数 为 2 的幂容量); 返回实际二次曲线数。">
    参数 起点 <类型 = Skia点>
    参数 控制点 <类型 = Skia点>
    参数 终点 <类型 = Skia点>
    参数 权重 <类型 = 小数>
    参数 结果数据 <类型 = 字节集类>
    参数 对数 <类型 = 整数>
    {
        变量 结果 <类型 = 整数>
        @ @<结果> = (sk_path_convert_conic_to_quads((const sk_point_t*)@<起点>.@n<Skia点.数据>.GetPtr(), (const sk_point_t*)@<控制点>.@n<Skia点.数据>.GetPtr(), (const sk_point_t*)@<终点>.@n<Skia点.数据>.GetPtr(), (float)@<权重>, (sk_point_t*)@<结果数据>.GetPtr(), @<对数>));
        返回 (结果)
    }

    方法 取线段掩码 <公开 类型 = 整数 注释 = "取 32 个连续线段的掩码位组合。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_path_get_segment_masks((sk_path_t*)@sn<this>.@n<Skia路径.对象指针>))
    }

    方法 是否椭圆 <公开 类型 = 逻辑型 注释 = "路径是否为椭圆; 是则把外接矩形写入 结果矩形。">
    参数 结果矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_path_is_oval((sk_path_t*)@<句柄>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 是否圆角矩形 <公开 类型 = 逻辑型 注释 = "路径是否为圆角矩形; 是则写入 结果圆角矩形。">
    参数 结果圆角矩形 <类型 = Skia圆角矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 结果圆角矩形.对象指针
        @ @<结果> = (sk_path_is_rrect((sk_path_t*)@<句柄>, (sk_rrect_t*)@<目标句柄>) != 0);
        返回 (结果)
    }

    方法 是否直线 <公开 类型 = 逻辑型 注释 = "路径是否为一条直线段; 是则把两个端点写入 结果数据(需 16 字节)。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_path_is_line((sk_path_t*)@<句柄>, (sk_point_t*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 是否矩形 <公开 类型 = 逻辑型 注释 = "路径是否为轴对齐矩形; 是则写入 结果矩形, 并把「是否闭合」与「方向」两个 32 位整数写入 结果标志数据(需 8 字节, 方向 0 顺时针/1 逆时针)。">
    参数 结果矩形 <类型 = Skia矩形>
    参数 结果标志数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = ([&]() -> bool { bool __closed = false; sk_path_direction_t __dir = CW_SK_PATH_DIRECTION; bool __ok = sk_path_is_rect((sk_path_t*)@<句柄>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr(), &__closed, &__dir) != 0; int __flags[2]; if (__closed) { __flags[0] = 1; } else { __flags[0] = 0; } __flags[1] = (int)__dir; memcpy(@<结果标志数据>.GetPtr(), __flags, 8); return __ok; }());
        返回 (结果)
    }
}

# ============================================================
# 五、路径构建器
# ============================================================

类 Skia路径构建器 <公开 注释 = "路径构建器(sk_pathbuilder_t): 累积图元后 取出路径/快照路径 得到 Skia路径。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径构建器.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia路径构建器 注释 = "创建空构建器。">
    {
        变量 结果 <类型 = Skia路径构建器>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_pathbuilder_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_pathbuilder_delete((sk_pathbuilder_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事。火山值类按值复制会共享同一个原生句柄, 在 类_清理 里自动销毁会造成重复释放/悬空句柄, 因此句柄一律由调用方显式 释放。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径构建器.对象指针> != 0)
    }

    方法 移动到 <公开 注释 = "开始新的子路径, 移动到指定点。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ sk_pathbuilder_move_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<横坐标>, (float)@<纵坐标>)
    }

    方法 直线到 <公开 注释 = "从当前点加一条直线到指定点。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ sk_pathbuilder_line_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<横坐标>, (float)@<纵坐标>)
    }

    方法 二次曲线到 <公开 注释 = "加一条二次贝塞尔曲线(一个控制点 + 终点)。" 折叠 @嵌入式方法 = "">
    参数 控制横坐标 <类型 = 小数>
    参数 控制纵坐标 <类型 = 小数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ sk_pathbuilder_quad_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<控制横坐标>, (float)@<控制纵坐标>, (float)@<横坐标>, (float)@<纵坐标>)
    }

    方法 三次曲线到 <公开 注释 = "加一条三次贝塞尔曲线(两个控制点 + 终点)。" 折叠 @嵌入式方法 = "">
    参数 控制横坐标1 <类型 = 小数>
    参数 控制纵坐标1 <类型 = 小数>
    参数 控制横坐标2 <类型 = 小数>
    参数 控制纵坐标2 <类型 = 小数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ sk_pathbuilder_cubic_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<控制横坐标1>, (float)@<控制纵坐标1>, (float)@<控制横坐标2>, (float)@<控制纵坐标2>, (float)@<横坐标>, (float)@<纵坐标>)
    }

    方法 闭合 <公开 注释 = "闭合当前子路径。" 折叠 @嵌入式方法 = "">
    {
        @ sk_pathbuilder_close((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>)
    }

    方法 追加矩形 <公开 类型 = 逻辑型 注释 = "追加一个矩形子路径; 方向 0 顺时针, 1 逆时针。">
    参数 矩形 <类型 = Skia矩形>
    参数 方向 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_add_rect((sk_pathbuilder_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_path_direction_t)@<方向>);
        返回 (真)
    }

    方法 追加圆 <公开 注释 = "追加一个圆子路径; 方向 0 顺时针, 1 逆时针。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 半径 <类型 = 小数>
    参数 方向 <类型 = 整数 @默认值 = 0>
    {
        @ sk_pathbuilder_add_circle((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<横坐标>, (float)@<纵坐标>, (float)@<半径>, (sk_path_direction_t)@<方向>)
    }

    方法 追加椭圆 <公开 类型 = 逻辑型 注释 = "追加一个内切于 矩形 的椭圆子路径; 方向 0 顺时针, 1 逆时针。">
    参数 矩形 <类型 = Skia矩形>
    参数 方向 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_add_oval((sk_pathbuilder_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_path_direction_t)@<方向>);
        返回 (真)
    }

    方法 追加路径 <公开 类型 = 逻辑型 注释 = "追加另一条路径; 追加方式 0 追加, 1 延伸。">
    参数 路径 <类型 = Skia路径>
    参数 追加方式 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_add_path((sk_pathbuilder_t*)@<句柄>, (const sk_path_t*)@<路径>.@n<Skia路径.对象指针>, (sk_path_add_mode_t)@<追加方式>);
        返回 (真)
    }

    方法 反向追加路径 <公开 类型 = 逻辑型 注释 = "按相反方向追加另一条路径。">
    参数 路径 <类型 = Skia路径>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_reverse_add_path((sk_pathbuilder_t*)@<句柄>, (const sk_path_t*)@<路径>.@n<Skia路径.对象指针>);
        返回 (真)
    }

    方法 置填充方式 <公开 注释 = "设置填充规则(sk_path_filltype_t)。" 折叠 @嵌入式方法 = "">
    参数 方式 <类型 = 整数>
    {
        @ sk_pathbuilder_set_filltype((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (sk_path_filltype_t)@<方式>)
    }

    方法 取填充方式 <公开 类型 = 整数 注释 = "取填充规则枚举值。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_pathbuilder_get_filltype((const sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>))
    }

    方法 取出路径 <公开 类型 = Skia路径 注释 = "把构建器内已累积的内容移交出来(构建器被清空); 返回的路径独立拥有句柄。">
    {
        变量 结果 <类型 = Skia路径>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_pathbuilder_detach_path((sk_pathbuilder_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 快照路径 <公开 类型 = Skia路径 注释 = "按当前内容复制一份路径(构建器内容保留); 返回的路径独立拥有句柄。">
    {
        变量 结果 <类型 = Skia路径>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_pathbuilder_snapshot_path((sk_pathbuilder_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按路径 <公开 静态 类型 = Skia路径构建器 注释 = "以已有路径为初值创建构建器。">
    参数 路径 <类型 = Skia路径>
    {
        变量 结果 <类型 = Skia路径构建器>
        变量 路径句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        路径句柄 = 路径.对象指针
        @ @<新指针> = (intptr_t)sk_pathbuilder_new_from_path((const sk_path_t*)@<路径句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 圆锥曲线到 <公开 注释 = "加一条圆锥曲线(权重大于 1 为尖角, 等于 1 等同二次曲线)。" 折叠 @嵌入式方法 = "">
    参数 控制横坐标 <类型 = 小数>
    参数 控制纵坐标 <类型 = 小数>
    参数 终点横坐标 <类型 = 小数>
    参数 终点纵坐标 <类型 = 小数>
    参数 权重 <类型 = 小数>
    {
        @ sk_pathbuilder_conic_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<控制横坐标>, (float)@<控制纵坐标>, (float)@<终点横坐标>, (float)@<终点纵坐标>, (float)@<权重>)
    }

    方法 弧线到 <公开 注释 = "按 SVG 弧语义追加一段弧; 弧大小 0 小弧/1 大弧, 扫过方向 0 顺时针/1 逆时针。" 折叠 @嵌入式方法 = "">
    参数 横半径 <类型 = 小数>
    参数 纵半径 <类型 = 小数>
    参数 轴旋转 <类型 = 小数>
    参数 弧大小 <类型 = 整数>
    参数 扫过方向 <类型 = 整数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    {
        @ sk_pathbuilder_arc_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<横半径>, (float)@<纵半径>, (float)@<轴旋转>, (sk_path_arc_size_t)@<弧大小>, (sk_path_direction_t)@<扫过方向>, (float)@<横坐标>, (float)@<纵坐标>)
    }

    方法 弧线到_按椭圆 <公开 类型 = 逻辑型 注释 = "按内切椭圆追加一段弧(角度单位度, 顺时针为正)。">
    参数 椭圆矩形 <类型 = Skia矩形>
    参数 起始角 <类型 = 小数>
    参数 扫过角 <类型 = 小数>
    参数 是否先移动 <类型 = 逻辑型 @默认值 = 假>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_arc_to_with_oval((sk_pathbuilder_t*)@<句柄>, (const sk_rect_t*)@<椭圆矩形>.@n<Skia矩形.数据>.GetPtr(), (float)@<起始角>, (float)@<扫过角>, (bool)@<是否先移动>);
        返回 (真)
    }

    方法 弧线到_按两点 <公开 类型 = 逻辑型 注释 = "自动计算切向的圆角化两点圆弧。">
    参数 起点横坐标 <类型 = 小数>
    参数 起点纵坐标 <类型 = 小数>
    参数 终点横坐标 <类型 = 小数>
    参数 终点纵坐标 <类型 = 小数>
    参数 半径 <类型 = 小数>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_arc_to_with_points((sk_pathbuilder_t*)@<句柄>, (float)@<起点横坐标>, (float)@<起点纵坐标>, (float)@<终点横坐标>, (float)@<终点纵坐标>, (float)@<半径>);
        返回 (真)
    }

    方法 相对移动到 <公开 注释 = "相对当前点开始新的子路径。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ sk_pathbuilder_rmove_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<横位移>, (float)@<纵位移>)
    }

    方法 相对直线到 <公开 注释 = "相对当前点加一条直线。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ sk_pathbuilder_rline_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<横位移>, (float)@<纵位移>)
    }

    方法 相对二次曲线到 <公开 注释 = "相对当前点加一条二次贝塞尔曲线。" 折叠 @嵌入式方法 = "">
    参数 控制横位移 <类型 = 小数>
    参数 控制纵位移 <类型 = 小数>
    参数 终点横位移 <类型 = 小数>
    参数 终点纵位移 <类型 = 小数>
    {
        @ sk_pathbuilder_rquad_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<控制横位移>, (float)@<控制纵位移>, (float)@<终点横位移>, (float)@<终点纵位移>)
    }

    方法 相对圆锥曲线到 <公开 注释 = "相对当前点加一条圆锥曲线(权重大于 1 为尖角)。" 折叠 @嵌入式方法 = "">
    参数 控制横位移 <类型 = 小数>
    参数 控制纵位移 <类型 = 小数>
    参数 终点横位移 <类型 = 小数>
    参数 终点纵位移 <类型 = 小数>
    参数 权重 <类型 = 小数>
    {
        @ sk_pathbuilder_rconic_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<控制横位移>, (float)@<控制纵位移>, (float)@<终点横位移>, (float)@<终点纵位移>, (float)@<权重>)
    }

    方法 相对三次曲线到 <公开 注释 = "相对当前点加一条三次贝塞尔曲线。" 折叠 @嵌入式方法 = "">
    参数 控制1横位移 <类型 = 小数>
    参数 控制1纵位移 <类型 = 小数>
    参数 控制2横位移 <类型 = 小数>
    参数 控制2纵位移 <类型 = 小数>
    参数 终点横位移 <类型 = 小数>
    参数 终点纵位移 <类型 = 小数>
    {
        @ sk_pathbuilder_rcubic_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<控制1横位移>, (float)@<控制1纵位移>, (float)@<控制2横位移>, (float)@<控制2纵位移>, (float)@<终点横位移>, (float)@<终点纵位移>)
    }

    方法 相对弧线到 <公开 注释 = "SVG 弧语义 + 相对终点。" 折叠 @嵌入式方法 = "">
    参数 横半径 <类型 = 小数>
    参数 纵半径 <类型 = 小数>
    参数 轴旋转 <类型 = 小数>
    参数 弧大小 <类型 = 整数>
    参数 扫过方向 <类型 = 整数>
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ sk_pathbuilder_rarc_to((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>, (float)@<横半径>, (float)@<纵半径>, (float)@<轴旋转>, (sk_path_arc_size_t)@<弧大小>, (sk_path_direction_t)@<扫过方向>, (float)@<横位移>, (float)@<纵位移>)
    }

    方法 追加矩形_指定起点 <公开 类型 = 逻辑型 注释 = "追加矩形子路径, 起点序号 0~3 指定从哪个角开始。">
    参数 矩形 <类型 = Skia矩形>
    参数 方向 <类型 = 整数 @默认值 = 0>
    参数 起点序号 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_add_rect_start((sk_pathbuilder_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_path_direction_t)@<方向>, (uint32_t)@<起点序号>);
        返回 (真)
    }

    方法 追加圆角矩形 <公开 类型 = 逻辑型 注释 = "追加圆角矩形子路径; 方向 0 顺时针/1 逆时针。">
    参数 圆角矩形 <类型 = Skia圆角矩形>
    参数 方向 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 圆角句柄 <类型 = 变整数>
        句柄 = 对象指针
        圆角句柄 = 圆角矩形.对象指针
        @ sk_pathbuilder_add_rrect((sk_pathbuilder_t*)@<句柄>, (const sk_rrect_t*)@<圆角句柄>, (sk_path_direction_t)@<方向>);
        返回 (真)
    }

    方法 追加圆角矩形_指定起点 <公开 类型 = 逻辑型 注释 = "追加圆角矩形子路径, 起点序号 0~7。">
    参数 圆角矩形 <类型 = Skia圆角矩形>
    参数 方向 <类型 = 整数 @默认值 = 0>
    参数 起点序号 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 圆角句柄 <类型 = 变整数>
        句柄 = 对象指针
        圆角句柄 = 圆角矩形.对象指针
        @ sk_pathbuilder_add_rrect_start((sk_pathbuilder_t*)@<句柄>, (const sk_rrect_t*)@<圆角句柄>, (sk_path_direction_t)@<方向>, (uint32_t)@<起点序号>);
        返回 (真)
    }

    方法 追加圆角矩形_按半径 <公开 类型 = 逻辑型 注释 = "按统一半径追加圆角矩形; 两半径相等为正圆角。">
    参数 矩形 <类型 = Skia矩形>
    参数 横半径 <类型 = 小数>
    参数 纵半径 <类型 = 小数>
    参数 方向 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_add_rounded_rect((sk_pathbuilder_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (float)@<横半径>, (float)@<纵半径>, (sk_path_direction_t)@<方向>);
        返回 (真)
    }

    方法 追加圆弧 <公开 类型 = 逻辑型 注释 = "追加一段独立椭圆弧(角度单位度), 自动先移动到弧起点。">
    参数 矩形 <类型 = Skia矩形>
    参数 起始角 <类型 = 小数>
    参数 扫过角 <类型 = 小数>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_add_arc((sk_pathbuilder_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (float)@<起始角>, (float)@<扫过角>);
        返回 (真)
    }

    方法 追加多边形 <公开 类型 = 逻辑型 注释 = "由点数据追加多边形; 点数据每点 8 字节(横/纵各 4 字节单精度)。">
    参数 点数据 <类型 = 字节集类>
    参数 点数 <类型 = 整数>
    参数 是否闭合 <类型 = 逻辑型 @默认值 = 真>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pathbuilder_add_poly((sk_pathbuilder_t*)@<句柄>, (const sk_point_t*)@<点数据>.GetPtr(), @<点数>, (bool)@<是否闭合>);
        返回 (真)
    }

    方法 追加路径_按偏移 <公开 类型 = 逻辑型 注释 = "先按 横位移/纵位移 偏移再追加另一条路径。">
    参数 路径 <类型 = Skia路径>
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    参数 追加方式 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        句柄 = 对象指针
        路径句柄 = 路径.对象指针
        @ sk_pathbuilder_add_path_offset((sk_pathbuilder_t*)@<句柄>, (const sk_path_t*)@<路径句柄>, (float)@<横位移>, (float)@<纵位移>, (sk_path_add_mode_t)@<追加方式>);
        返回 (真)
    }

    方法 追加路径_按矩阵 <公开 类型 = 逻辑型 注释 = "先按矩阵变换再追加另一条路径。">
    参数 路径 <类型 = Skia路径>
    参数 矩阵 <类型 = Skia矩阵>
    参数 追加方式 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        句柄 = 对象指针
        路径句柄 = 路径.对象指针
        @ sk_pathbuilder_add_path_matrix((sk_pathbuilder_t*)@<句柄>, (const sk_path_t*)@<路径句柄>, (sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr(), (sk_path_add_mode_t)@<追加方式>);
        返回 (真)
    }

    方法 重置 <公开 注释 = "清空全部指令但保留内部容量。" 折叠 @嵌入式方法 = "">
    {
        @ sk_pathbuilder_reset((sk_pathbuilder_t*)@sn<this>.@n<Skia路径构建器.对象指针>)
    }
}

# ============================================================
# 六、画布
# ============================================================

类 Skia画布 <公开 注释 = "光栅画布(sk_canvas_t): 本批只封装由位图创建的基础画布与核心绘制子集。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia画布.对象指针>)
    }
    变量 画布宽 <类型 = 整数 注释 = "创建时从位图信息读到的宽度(像素)。">
    变量 画布高 <类型 = 整数 注释 = "创建时从位图信息读到的高度(像素)。">

    方法 新建_按位图 <公开 静态 类型 = Skia画布 注释 = "由位图句柄(sk_bitmap_t*)创建光栅画布; 画布不接管位图所有权。">
    参数 位图 <类型 = Skia位图>
    {
        变量 结果 <类型 = Skia画布>
        变量 新指针 <类型 = 变整数>
        变量 信息 <类型 = 字节集类>
        变量 宽值 <类型 = 整数>
        变量 高值 <类型 = 整数>
        变量 位图指针 <类型 = 变整数>
        信息 = 取空白字节集 (32)
        位图指针 = 位图.对象指针
        @ @<新指针> = (intptr_t)sk_canvas_new_from_bitmap((const sk_bitmap_t*)@<位图指针>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        @ sk_bitmap_get_info((sk_bitmap_t*)@<位图指针>, (sk_imageinfo_t*)@<信息>.GetPtr());
        @ @<宽值> = (int)((const sk_imageinfo_t*)@<信息>.GetPtr())->width;
        @ @<高值> = (int)((const sk_imageinfo_t*)@<信息>.GetPtr())->height;
        结果.画布宽 = 宽值
        结果.画布高 = 高值
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_canvas_destroy((sk_canvas_t*)@<旧指针>);
        对象指针 = 0
        画布宽 = 0
        画布高 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事。火山值类按值复制会共享同一个原生句柄, 在 类_清理 里自动销毁会造成重复释放/悬空句柄, 因此句柄一律由调用方显式 释放。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia画布.对象指针> != 0)
    }

    方法 清空 <公开 注释 = "用指定颜色填满整块画布(不做混合)。" 折叠 @嵌入式方法 = "">
    参数 颜色 <类型 = 整数>
    {
        @ sk_canvas_clear((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>, (sk_color_t)@<颜色>)
    }

    方法 绘制矩形 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制矩形。">
    参数 矩形 <类型 = Skia矩形>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_rect((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制圆 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制圆。">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 半径 <类型 = 小数>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_circle((sk_canvas_t*)@<句柄>, (float)@<横坐标>, (float)@<纵坐标>, (float)@<半径>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制椭圆 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制内切于 矩形 的椭圆。">
    参数 矩形 <类型 = Skia矩形>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_oval((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制直线 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制一条直线。">
    参数 起始横坐标 <类型 = 小数>
    参数 起始纵坐标 <类型 = 小数>
    参数 结束横坐标 <类型 = 小数>
    参数 结束纵坐标 <类型 = 小数>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_line((sk_canvas_t*)@<句柄>, (float)@<起始横坐标>, (float)@<起始纵坐标>, (float)@<结束横坐标>, (float)@<结束纵坐标>, (sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制点 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制一个点。">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_point((sk_canvas_t*)@<句柄>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制路径 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制路径。">
    参数 路径 <类型 = Skia路径>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_path((sk_canvas_t*)@<句柄>, (const sk_path_t*)@<路径>.@n<Skia路径.对象指针>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制圆角矩形_按半径 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制圆角矩形(分别给出 横半径/纵半径)。">
    参数 矩形 <类型 = Skia矩形>
    参数 横半径 <类型 = 小数>
    参数 纵半径 <类型 = 小数>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_round_rect((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (float)@<横半径>, (float)@<纵半径>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制圆弧 <公开 类型 = 逻辑型 注释 = "按 画笔 绘制一段圆弧(内切于 椭圆矩形); 角度单位为度, 顺时针为正。">
    参数 椭圆矩形 <类型 = Skia矩形>
    参数 起始角度 <类型 = 小数>
    参数 扫过角度 <类型 = 小数>
    参数 是否连到中心 <类型 = 逻辑型 @默认值 = 假>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_arc((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<椭圆矩形>.@n<Skia矩形.数据>.GetPtr(), (float)@<起始角度>, (float)@<扫过角度>, (bool)@<是否连到中心>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制颜色 <公开 注释 = "用指定颜色铺满整个裁剪区域(受混合方式影响)。" 折叠 @嵌入式方法 = "">
    参数 颜色 <类型 = 整数>
    参数 混合方式 <类型 = 整数 @默认值 = 3>
    {
        @ sk_canvas_draw_color((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>, (sk_color_t)@<颜色>, (sk_blendmode_t)@<混合方式>)
    }

    方法 保存状态 <公开 类型 = 整数 注释 = "保存当前矩阵/裁剪栈, 返回保存层数(sk_canvas_save)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_canvas_save((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>))
    }

    方法 恢复状态 <公开 注释 = "恢复到上一次 保存状态 的状态。" 折叠 @嵌入式方法 = "">
    {
        @ sk_canvas_restore((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>)
    }

    方法 平移画布 <公开 注释 = "平移坐标系。" 折叠 @嵌入式方法 = "">
    参数 横偏移 <类型 = 小数>
    参数 纵偏移 <类型 = 小数>
    {
        @ sk_canvas_translate((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>, (float)@<横偏移>, (float)@<纵偏移>)
    }

    方法 缩放画布 <公开 注释 = "缩放坐标系。" 折叠 @嵌入式方法 = "">
    参数 横缩放 <类型 = 小数>
    参数 纵缩放 <类型 = 小数>
    {
        @ sk_canvas_scale((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>, (float)@<横缩放>, (float)@<纵缩放>)
    }

    方法 旋转角度 <公开 注释 = "旋转坐标系(角度单位: 度, 顺时针为正)。" 折叠 @嵌入式方法 = "">
    参数 角度 <类型 = 小数>
    {
        @ sk_canvas_rotate_degrees((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>, (float)@<角度>)
    }

    方法 重置矩阵 <公开 注释 = "把当前矩阵重置为单位矩阵。" 折叠 @嵌入式方法 = "">
    {
        @ sk_canvas_reset_matrix((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>)
    }

    方法 置矩阵 <公开 类型 = 逻辑型 注释 = "用 4x4 矩阵整体替换当前矩阵。">
    参数 矩阵 <类型 = Skia矩阵44>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_set_matrix((sk_canvas_t*)@<句柄>, (const sk_matrix44_t*)@<矩阵>.@n<Skia矩阵44.数据>.GetPtr());
        返回 (真)
    }

    方法 取宽度 <公开 类型 = 整数 注释 = "画布宽度(像素); 无效画布返回 0。">
    {
        返回 (画布宽)
    }

    方法 取高度 <公开 类型 = 整数 注释 = "画布高度(像素); 无效画布返回 0。">
    {
        返回 (画布高)
    }

    方法 取保存层数 <公开 类型 = 整数 注释 = "当前保存栈层数。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_canvas_get_save_count((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>))
    }

    方法 裁剪矩形 <公开 类型 = 逻辑型 注释 = "把后续绘制裁剪到矩形内; 裁剪操作 0 替换, 1 相交。">
    参数 矩形 <类型 = Skia矩形>
    参数 裁剪操作 <类型 = 整数 @默认值 = 1>
    参数 抗锯齿 <类型 = 逻辑型 @默认值 = 假>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_clip_rect_with_operation((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_clipop_t)@<裁剪操作>, (bool)@<抗锯齿>);
        返回 (真)
    }

    方法 快速剔除 <公开 类型 = 逻辑型 注释 = "矩形是否完全落在当前裁剪区域之外(为真时可跳过绘制)。">
    参数 矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_canvas_quick_reject((sk_canvas_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 新建_按像素 <公开 静态 类型 = Skia画布 注释 = "静态; 直接接管外部像素内存(不拷贝), 调用方须保证内存在画布存活期内有效。行字节数请用 Skia图像信息.行字节数; 表面属性 传 0 表示无特殊属性(Skia表面属性 类尚未封装, 以变整数承载)。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 像素地址 <类型 = 变整数>
    参数 行字节数 <类型 = 整数>
    参数 表面属性 <类型 = Skia表面属性>
    {
        变量 结果 <类型 = Skia画布>
        变量 新指针 <类型 = 变整数>
        变量 宽值 <类型 = 整数>
        变量 高值 <类型 = 整数>
        变量 属性指针 <类型 = 变整数>
        属性指针 = 表面属性.对象指针
        宽值 = 图像信息.宽
        高值 = 图像信息.高
        @ @<新指针> = (intptr_t)sk_canvas_new_from_raster((const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素地址>, (size_t)@<行字节数>, (const sk_surfaceprops_t*)@<属性指针>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        结果.画布宽 = 宽值
        结果.画布高 = 高值
        返回 (结果)
    }

    方法 清空_浮点色 <公开 注释 = "用 0~1 浮点颜色覆盖整块目标(不做混合)。">
    参数 颜色 <类型 = Skia浮点颜色>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_clear_color4f((sk_canvas_t*)@<句柄>, *((const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr()));
    }

    方法 丢弃内容 <公开 注释 = "丢弃目标像素内容, 比 清空 更快; 结果内容未定义。" 折叠 @嵌入式方法 = "">
    {
        @ sk_canvas_discard((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>)
    }

    方法 恢复到保存层数 <公开 注释 = "一次弹栈到指定深度; 层数取值 0~当前深度。" 折叠 @嵌入式方法 = "">
    参数 层数 <类型 = 整数>
    {
        @ sk_canvas_restore_to_count((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>, @<层数>)
    }

    方法 绘制颜色_浮点色 <公开 注释 = "以 0~1 浮点颜色填充全画幅(受混合方式影响)。">
    参数 颜色 <类型 = Skia浮点颜色>
    参数 混合方式 <类型 = 整数 @默认值 = 3>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_color4f((sk_canvas_t*)@<句柄>, *((const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr()), (sk_blendmode_t)@<混合方式>);
    }

    方法 绘制多点 <公开 注释 = "绘制一组点; 点数据每点 8 字节, 点方式 0 点/1 折线/2 多边形。">
    参数 点方式 <类型 = 整数>
    参数 数量 <类型 = 整数>
    参数 点数据 <类型 = 字节集类>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_points((sk_canvas_t*)@<句柄>, (sk_point_mode_t)@<点方式>, (size_t)@<数量>, (const sk_point_t*)@<点数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
    }

    方法 绘制简单文字 <公开 注释 = "绘制一段文字; 文字数据是 UTF-8 字节流(中文每字 3 字节), 编码 0 UTF8/1 UTF16/2 UTF32/3 字形ID。">
    参数 文字数据 <类型 = 字节集类>
    参数 编码 <类型 = 整数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 字体句柄 <类型 = 变整数>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 字节数 <类型 = 变整数>
        句柄 = 对象指针
        字节数 = 取字节集长度 (文字数据)
        @ sk_canvas_draw_simple_text((sk_canvas_t*)@<句柄>, (const void*)@<文字数据>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)@<编码>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_font_t*)@<字体句柄>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
    }

    方法 绘制文字块 <公开 注释 = "绘制文字块(横纵坐标为基线起点); 重复绘制优先用文字块。">
    参数 文字块句柄 <类型 = 变整数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_draw_text_blob((sk_canvas_t*)@<句柄>, (sk_textblob_t*)@<文字块句柄>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
    }

    方法 取矩阵 <公开 类型 = 逻辑型 注释 = "取当前 4x4 变换矩阵写入 结果矩阵。">
    参数 结果矩阵 <类型 = Skia矩阵44>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_get_matrix((sk_canvas_t*)@<句柄>, (sk_matrix44_t*)@<结果矩阵>.@n<Skia矩阵44.数据>.GetPtr());
        返回 (真)
    }

    方法 裁剪路径 <公开 类型 = 逻辑型 注释 = "按路径裁剪; 裁剪方式 0 挖去/1 取交(常规裁剪传 1)。">
    参数 路径 <类型 = Skia路径>
