<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Skia <注释 = "Skia (SkiaSharp C API) 图形库封装(火山视窗, 64 位)。直接链接 libSkiaSharp.dll 导出的 sk_* C 接口, 不做二次桥接层。"
        注释 = "本模块为第一批: 值类族(矩形/点/整数点/整数矩形/尺寸/矩阵/矩阵44/浮点颜色) + 全局/颜色/画笔/路径/路径构建器/画布。后续批次在此模块组内继续追加其它类文件。"
        注释 = "所有权与句柄约定(重要): 所有原生句柄都是 变整数, 0 表示无效。句柄类对象的 释放 可重复调用; 是否拥有句柄 为假 时 释放 只清火山侧句柄、不销毁原生对象(借用场景)。"
        注释 = "【必须显式释放】火山值类在赋值/传参/返回时按值复制, 多个副本会共享同一个原生句柄, 因此本模块的 类_清理 一律不做自动销毁 —— 谁创建谁调用 释放(克隆/快照/取出 出来的新句柄同样要各自 释放)。这与 ThorVG/OCCT 类库的约定一致; 若在 类_清理 里自动 sk_*_delete, 副本销毁时会出现重复释放, 实测表现为 STATUS_HEAP_CORRUPTION(0xC0000374) 崩溃。忘记调用 释放 只会泄漏, 不会崩。"
        注释 = "【零拷贝入口 5 个(重要)】Skia画布.新建_按像素 / Skia图像.新建_按像素内存 / Skia表面.新建_光栅直通 / Skia位图.安装像素 / Skia位图.安装像素_按像素图 —— 这 5 个都【不复制像素内存】, 调用方必须保证该内存在对象存活期内一直有效, 提前释放会导致崩溃。其中 Skia画布.新建_按像素 最容易被误认为安全: 画布会直接改写你传入的缓冲, 缓冲被释放或移动后画布立即失效(崩溃), 缓冲生命周期必须覆盖画布的全部使用期。安全替代: Skia表面.新建_光栅 / Skia图像.新建_按像素拷贝 / Skia位图.尝试分配像素。"
        注释 = "【裁剪会一直生效】裁剪矩形 / 裁剪路径 / 裁剪区域 会持续影响后续绘制, 作用范围到对应的 恢复状态 为止; 只想局部裁剪请用 保存状态 () -> 裁剪 -> 绘制 -> 恢复状态 () 包住。保存图层 (边界, 画笔) 同样必须与 恢复状态 配对(每次 保存图层 恰好对应一次 恢复状态), 而且它比普通 保存状态 更重(会分配离屏缓冲), 漏配对会导致图层栈泄漏、绘制结果错位。"
        注释 = "【颜色是 0xAARRGGBB 有符号 32 位】高位为 1 时呈现为负数, 位模式不变。注意「不透明黑」是 0xFF000000 = -16777216, 直接写 0 是「全透明黑」, 画上去等于没画(实测: 文字用 0 当黑色时非背景像素数 = 0, 改成 -16777216 后 = 146)。"
        注释 = "【NOMINMAX】本模块不定义 NOMINMAX。@视窗.预定义宏 是工程级宏, 定义 NOMINMAX 会让 MFC 的 GdiplusTypes.h 因 min/max 未定义而编译失败(实测 C3861); 若调用方程序需要 NOMINMAX, 请在自己的工程级设置里自行定义。"
        注释 = "【外部库名】@视窗.外部库.x64 写死 libSkiaSharp.lib, 不用 $(d) 后缀 —— SkiaSharp 的导入库没有 debug/release 之分, 写 $(d) 会展开成 libSkiaSharprelease.lib 导致 LNK1181。"
        注释 = "句柄为 0 时直接调用 sk_* 属于未定义行为(原生层不解引用空句柄的检查在调用方), 因此业务代码请先用 是否有效 判断。"
        注释 = "坐标单位为像素, 原点左上角, Y 轴向下; 角度单位为度, 顺时针为正。颜色一律是 0xAARRGGBB 的 32 位整数, 因 火山 整数 是有符号 32 位, 高位为 1 时呈现为负数, 位模式不变。"
        注释 = "值类(矩形/点/矩阵...)底层是一块定长字节集缓冲, 字段读写全部是嵌入行内的单次取址, 不会发生缓冲复制; 因此拿它们的 取地址 结果交给原生函数写出参是安全的。"
        @视窗.头文件搜寻目录 = "deps\\skia"
        @视窗.头文件搜寻目录 = "deps\\skia\\include\\c"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "skia_include.h"
        @视窗.库文件搜寻目录.x64 = "deps\\skia\\lib\\x64"
        @视窗.外部库.x64 = "libSkiaSharp.lib"
        @视窗.附属文件 = "deps\\skia\\bin\\x64\\libSkiaSharp.dll"
        @视窗.预定义宏 = "_CRT_SECURE_NO_WARNINGS"
        @视窗.附加编译参数 = "cpp: /bigobj /FS">

# ============================================================
# 一、全局与颜色
# ============================================================

类 Skia全局 <公开 注释 = "Skia 全局初始化、版本信息与缓存管理。进程内启动时调用一次 初始化 即可。">
{
    方法 初始化 <公开 静态 注释 = "初始化 Skia 图形库(进程内调用一次即可, 重复调用无副作用)。" 折叠 @嵌入式方法 = "">
    {
        @ sk_graphics_init()
    }

    方法 取主版本号 <公开 静态 类型 = 整数 注释 = "返回 Skia 主版本号(milestone, 例如 120)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_version_get_milestone())
    }

    方法 取次版本号 <公开 静态 类型 = 整数 注释 = "返回 Skia 增量版本号(increment)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_version_get_increment())
    }

    方法 取版本文本 <公开 静态 类型 = 文本型 注释 = "返回原生库版本字符串(UTF-8 转火山文本)。">
    {
        变量 缓冲 <类型 = 字节集类>
        变量 结果 <类型 = 文本型>
        缓冲 = 取空白字节集 (128)
        @ strcpy_s((char*)@<缓冲>.GetPtr(), (size_t)128, sk_version_get_string());
        结果 = UTF8到文本 (缓冲)
        返回 (结果)
    }

    方法 清理全部缓存 <公开 静态 注释 = "清空字体缓存与资源缓存。" 折叠 @嵌入式方法 = "">
    {
        @ sk_graphics_purge_all_caches()
    }

    方法 清理字体缓存 <公开 静态 注释 = "只清空字体缓存。" 折叠 @嵌入式方法 = "">
    {
        @ sk_graphics_purge_font_cache()
    }

    方法 取字体缓存用量 <公开 静态 类型 = 变整数 注释 = "当前字体缓存占用字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_graphics_get_font_cache_used())
    }

    方法 置字体缓存上限 <公开 静态 类型 = 变整数 注释 = "设置字体缓存上限(字节), 返回旧上限。" 折叠 @嵌入式方法 = "">
    参数 字节数 <类型 = 变整数>
    {
        @ ((intptr_t)sk_graphics_set_font_cache_limit((size_t)@<字节数>))
    }

    方法 清理资源缓存 <公开 静态 注释 = "丢弃图片/着色器等资源缓存。" 折叠 @嵌入式方法 = "">
    {
        @ sk_graphics_purge_resource_cache()
    }

    方法 取字体缓存上限 <公开 静态 类型 = 变整数 注释 = "字体缓存上限字节数; 0 表示不限制。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_graphics_get_font_cache_limit())
    }

    方法 取字体缓存条目数 <公开 静态 类型 = 整数 注释 = "已缓存的字形条目个数。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_graphics_get_font_cache_count_used())
    }

    方法 取字体缓存条目上限 <公开 静态 类型 = 整数 注释 = "字体缓存条目上限; 0 表示不限制。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_graphics_get_font_cache_count_limit())
    }

    方法 置字体缓存条目上限 <公开 静态 类型 = 整数 注释 = "设置字体缓存条目上限, 返回旧上限。" 折叠 @嵌入式方法 = "">
    参数 上限条目 <类型 = 整数>
    {
        @ (sk_graphics_set_font_cache_count_limit(@<上限条目>))
    }

    方法 取资源缓存字节数 <公开 静态 类型 = 变整数 注释 = "资源缓存当前占用字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_graphics_get_resource_cache_total_bytes_used())
    }

    方法 取资源缓存字节上限 <公开 静态 类型 = 变整数 注释 = "资源缓存字节上限。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_graphics_get_resource_cache_total_byte_limit())
    }

    方法 置资源缓存字节上限 <公开 静态 类型 = 变整数 注释 = "设置资源缓存字节上限, 返回旧上限。" 折叠 @嵌入式方法 = "">
    参数 上限字节 <类型 = 变整数>
    {
        @ ((intptr_t)sk_graphics_set_resource_cache_total_byte_limit((size_t)@<上限字节>))
    }

    方法 取单次分配字节上限 <公开 静态 类型 = 变整数 注释 = "资源缓存单次分配字节上限。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_graphics_get_resource_cache_single_allocation_byte_limit())
    }

    方法 置单次分配字节上限 <公开 静态 类型 = 变整数 注释 = "设置资源缓存单次分配字节上限, 返回旧上限。" 折叠 @嵌入式方法 = "">
    参数 上限字节 <类型 = 变整数>
    {
        @ ((intptr_t)sk_graphics_set_resource_cache_single_allocation_byte_limit((size_t)@<上限字节>))
    }

    方法 保持链接 <公开 静态 注释 = "防止链接器丢弃静态初始化代码; 程序启动时调用一次。" 折叠 @嵌入式方法 = "">
    {
        @ sk_linker_keep_alive()
    }
}

类 Skia颜色 <公开 注释 = "32 位整数颜色(0xAARRGGBB)与浮点颜色的换算、预乘与去预乘。">
{
    方法 取默认色彩类型 <公开 静态 类型 = 整数 注释 = "返回平台默认的 8888 色彩类型枚举值(sk_colortype_t)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_colortype_get_default_8888())
    }

    方法 浮点色转整数色 <公开 静态 类型 = 整数 注释 = "把 0~1 的浮点颜色转成 0xAARRGGBB 整数色(各分量四舍五入)。">
    参数 颜色 <类型 = Skia浮点颜色>
    {
        变量 结果 <类型 = 整数>
        @ @<结果> = (int)sk_color_set_argb((uint32_t)(((const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr())->fA * 255.0f + 0.5f), (uint32_t)(((const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr())->fR * 255.0f + 0.5f), (uint32_t)(((const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr())->fG * 255.0f + 0.5f), (uint32_t)(((const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr())->fB * 255.0f + 0.5f));
        返回 (结果)
    }

    方法 整数色转浮点色 <公开 静态 类型 = Skia浮点颜色 注释 = "把 0xAARRGGBB 整数色拆成 0~1 的浮点颜色。">
    参数 颜色 <类型 = 整数>
    {
        变量 结果 <类型 = Skia浮点颜色>
        变量 地址 <类型 = 变整数>
        地址 = 结果.取地址 ()
        @ ([&]() -> bool { sk_color4f_t* __c = (sk_color4f_t*)@<地址>; uint32_t __v = (uint32_t)@<颜色>; __c->fA = (float)((__v >> 24) & 0xFF) / 255.0f; __c->fR = (float)((__v >> 16) & 0xFF) / 255.0f; __c->fG = (float)((__v >> 8) & 0xFF) / 255.0f; __c->fB = (float)(__v & 0xFF) / 255.0f; return true; }());
        返回 (结果)
    }

    方法 预乘 <公开 静态 类型 = 整数 注释 = "把非预乘的 0xAARRGGBB 整数色转成预乘色(各分量 乘 透明度/255)。">
    参数 颜色 <类型 = 整数>
    {
        变量 透明度值 <类型 = 整数>
        变量 红值 <类型 = 整数>
        变量 绿值 <类型 = 整数>
        变量 蓝值 <类型 = 整数>
        变量 结果 <类型 = 整数>
        @ @<透明度值> = (int)(((uint32_t)@<颜色> >> 24) & 0xFF);
        @ @<红值> = (int)((uint32_t)(((uint32_t)@<颜色> >> 16) & 0xFF) * (uint32_t)@<透明度值> / 255u);
        @ @<绿值> = (int)((uint32_t)(((uint32_t)@<颜色> >> 8) & 0xFF) * (uint32_t)@<透明度值> / 255u);
        @ @<蓝值> = (int)((uint32_t)((uint32_t)@<颜色> & 0xFF) * (uint32_t)@<透明度值> / 255u);
        @ @<结果> = (int)(((uint32_t)@<透明度值> << 24) | ((uint32_t)@<红值> << 16) | ((uint32_t)@<绿值> << 8) | (uint32_t)@<蓝值>);
        返回 (结果)
    }

    方法 去预乘 <公开 静态 类型 = 整数 注释 = "把预乘的 0xAARRGGBB 整数色还原成非预乘色; 透明度为 0 时返回 0。">
    参数 颜色 <类型 = 整数>
    {
        变量 透明度值 <类型 = 整数>
        变量 红值 <类型 = 整数>
        变量 绿值 <类型 = 整数>
        变量 蓝值 <类型 = 整数>
        变量 结果 <类型 = 整数>
        变量 上限 <类型 = 整数>
        上限 = 255
        @ @<透明度值> = (int)(((uint32_t)@<颜色> >> 24) & 0xFF);
        如果 (透明度值 == 0)
        {
            返回 (0)
        }
        @ @<红值> = (int)(((uint32_t)(((uint32_t)@<颜色> >> 16) & 0xFF) * 255u + (uint32_t)@<透明度值> / 2u) / (uint32_t)@<透明度值>);
        @ @<绿值> = (int)(((uint32_t)(((uint32_t)@<颜色> >> 8) & 0xFF) * 255u + (uint32_t)@<透明度值> / 2u) / (uint32_t)@<透明度值>);
        @ @<蓝值> = (int)(((uint32_t)((uint32_t)@<颜色> & 0xFF) * 255u + (uint32_t)@<透明度值> / 2u) / (uint32_t)@<透明度值>);
        如果 (红值 > 上限)
        {
            红值 = 上限
        }
        如果 (绿值 > 上限)
        {
            绿值 = 上限
        }
        如果 (蓝值 > 上限)
        {
            蓝值 = 上限
        }
        @ @<结果> = (int)(((uint32_t)@<透明度值> << 24) | ((uint32_t)@<红值> << 16) | ((uint32_t)@<绿值> << 8) | (uint32_t)@<蓝值>);
        返回 (结果)
    }

    方法 批量去预乘 <公开 静态 注释 = "批量把预乘色还原成非预乘色; 源数据与 结果数据 各需 数量 个 4 字节整数。" 折叠 @嵌入式方法 = "">
    参数 源数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果数据 <类型 = 字节集类>
    {
        @ sk_color_unpremultiply_array((const sk_pmcolor_t*)@<源数据>.GetPtr(), @<数量>, (sk_color_t*)@<结果数据>.GetPtr());
    }

    方法 批量预乘 <公开 静态 注释 = "批量把非预乘色转成预乘色; 源数据与 结果数据 各需 数量 个 4 字节整数。" 折叠 @嵌入式方法 = "">
    参数 源数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果数据 <类型 = 字节集类>
    {
        @ sk_color_premultiply_array((const sk_color_t*)@<源数据>.GetPtr(), @<数量>, (sk_pmcolor_t*)@<结果数据>.GetPtr());
    }

    方法 取通道位移 <公开 静态 类型 = 逻辑型 注释 = "取各通道位偏移写入 结果数据(共 16 字节: 依次为 A/R/G/B 四个 32 位整数)。">
    参数 结果数据 <类型 = 字节集类>
    {
        @ ([&]() -> bool { int __s[4] = { 0, 0, 0, 0 }; sk_color_get_bit_shift(&__s[0], &__s[1], &__s[2], &__s[3]); memcpy(@<结果数据>.GetPtr(), __s, 16); return true; }());
        返回 (真)
    }

    方法 交换红蓝通道 <公开 静态 注释 = "BGRA 与 RGBA 互转; 结果数据 与 源数据 各需 数量 个 4 字节整数。" 折叠 @嵌入式方法 = "">
    参数 结果数据 <类型 = 字节集类>
    参数 源数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    {
        @ sk_swizzle_swap_rb((uint32_t*)@<结果数据>.GetPtr(), (const uint32_t*)@<源数据>.GetPtr(), @<数量>);
    }
}

# ============================================================
# 二、值类族(字节集缓冲法)
# ============================================================

类 Skia矩形 <公开 注释 = "sk_rect_t: 左/上/右/下(单精度小数)。底层 16 字节缓冲, 对应 sk_rect_t 的内存布局。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "16 字节缓冲, 对应 sk_rect_t(4 个单精度小数)。">

    方法 类_初始化 <公开 注释 = "分配并清零 16 字节缓冲。">
    {
        数据 = 取空白字节集 (16)
    }

    方法 置边界 <公开 类型 = 逻辑型 注释 = "一次写入 左/上/右/下 四个边界。" 折叠 @嵌入式方法 = "">
    参数 左边 <类型 = 小数>
    参数 上边 <类型 = 小数>
    参数 右边 <类型 = 小数>
    参数 下边 <类型 = 小数>
    {
        @ ([&]() -> bool { sk_rect_t* __r = (sk_rect_t*)@sn<this>.@n<Skia矩形.数据>.GetPtr(); __r->left = (float)@<左边>; __r->top = (float)@<上边>; __r->right = (float)@<右边>; __r->bottom = (float)@<下边>; return true; }())
    }

    方法 左 <公开 属性读 类型 = 小数 注释 = "左边界。" 折叠 @嵌入式方法 = "">
    {
        @ (((const sk_rect_t*)@sn<this>.@n<Skia矩形.数据>.GetPtr())->left)
    }

    方法 上 <公开 属性读 类型 = 小数 注释 = "上边界。" 折叠 @嵌入式方法 = "">
    {
        @ (((const sk_rect_t*)@sn<this>.@n<Skia矩形.数据>.GetPtr())->top)
    }

    方法 右 <公开 属性读 类型 = 小数 注释 = "右边界。" 折叠 @嵌入式方法 = "">
    {
        @ (((const sk_rect_t*)@sn<this>.@n<Skia矩形.数据>.GetPtr())->right)
    }

    方法 下 <公开 属性读 类型 = 小数 注释 = "下边界。" 折叠 @嵌入式方法 = "">
    {
        @ (((const sk_rect_t*)@sn<this>.@n<Skia矩形.数据>.GetPtr())->bottom)
    }

    方法 置左 <公开 类型 = 逻辑型 注释 = "设置左边界。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 小数>
    {
        @ (((sk_rect_t*)@sn<this>.@n<Skia矩形.数据>.GetPtr())->left = (float)@<值>, true)
    }

