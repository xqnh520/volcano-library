    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_matrix_t*); 0 表示缓冲无效。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia矩阵.数据>.GetPtr())
    }

    方法 尝试求逆 <公开 类型 = 逻辑型 注释 = "把本矩阵的逆写入 结果矩阵; 奇异矩阵返回假。">
    参数 结果矩阵 <类型 = Skia矩阵>
    {
        变量 地址 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        地址 = 取地址 ()
        @ @<结果> = (sk_matrix_try_invert((sk_matrix_t*)@<地址>, (sk_matrix_t*)@<结果矩阵>.@n<Skia矩阵.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 连接 <公开 静态 注释 = "静态; 结果矩阵 = 甲矩阵 × 乙矩阵(语义为「先施加甲再施加乙」)。" 折叠 @嵌入式方法 = "">
    参数 甲矩阵 <类型 = Skia矩阵>
    参数 乙矩阵 <类型 = Skia矩阵>
    参数 结果矩阵 <类型 = Skia矩阵>
    {
        @ sk_matrix_concat((sk_matrix_t*)@<结果矩阵>.@n<Skia矩阵.数据>.GetPtr(), (sk_matrix_t*)@<甲矩阵>.@n<Skia矩阵.数据>.GetPtr(), (sk_matrix_t*)@<乙矩阵>.@n<Skia矩阵.数据>.GetPtr());
    }

    方法 前乘 <公开 注释 = "自身 = 矩阵 × 自身。">
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ sk_matrix_pre_concat((sk_matrix_t*)@<地址>, (sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
    }

    方法 后乘 <公开 注释 = "自身 = 自身 × 矩阵。">
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ sk_matrix_post_concat((sk_matrix_t*)@<地址>, (sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
    }

    方法 映射矩形 <公开 注释 = "把 源矩形 变换后写入 结果矩形; 透视矩阵会退化为外接盒。">
    参数 结果矩形 <类型 = Skia矩形>
    参数 源矩形 <类型 = Skia矩形>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ sk_matrix_map_rect((sk_matrix_t*)@<地址>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_rect_t*)@<源矩形>.@n<Skia矩形.数据>.GetPtr());
    }

    方法 映射多点 <公开 注释 = "把 源数据 里的 点数 个点变换后写入 结果数据; 两块缓冲各需 点数×8 字节。">
    参数 结果数据 <类型 = 字节集类>
    参数 源数据 <类型 = 字节集类>
    参数 点数 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ sk_matrix_map_points((sk_matrix_t*)@<地址>, (sk_point_t*)@<结果数据>.GetPtr(), (sk_point_t*)@<源数据>.GetPtr(), @<点数>);
    }

    方法 映射多向量 <公开 注释 = "忽略平移分量地变换 数量 个向量写入 结果数据; 两块缓冲各需 数量×8 字节。">
    参数 结果数据 <类型 = 字节集类>
    参数 源数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ sk_matrix_map_vectors((sk_matrix_t*)@<地址>, (sk_point_t*)@<结果数据>.GetPtr(), (sk_point_t*)@<源数据>.GetPtr(), @<数量>);
    }

    方法 映射坐标 <公开 注释 = "含平移与透视地映射一个坐标, 写入 结果点。">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 结果点 <类型 = Skia点>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ sk_matrix_map_xy((sk_matrix_t*)@<地址>, (float)@<横坐标>, (float)@<纵坐标>, (sk_point_t*)@<结果点>.@n<Skia点.数据>.GetPtr());
    }

    方法 映射向量 <公开 注释 = "忽略平移分量地映射一个向量, 写入 结果点。">
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 结果点 <类型 = Skia点>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ sk_matrix_map_vector((sk_matrix_t*)@<地址>, (float)@<横坐标>, (float)@<纵坐标>, (sk_point_t*)@<结果点>.@n<Skia点.数据>.GetPtr());
    }

    方法 映射半径 <公开 类型 = 小数 注释 = "按两轴缩放的最大值映射半径。">
    参数 半径 <类型 = 小数>
    {
        变量 地址 <类型 = 变整数>
        变量 结果 <类型 = 小数>
        地址 = 取地址 ()
        @ @<结果> = ((double)sk_matrix_map_radius((sk_matrix_t*)@<地址>, (float)@<半径>));
        返回 (结果)
    }
}

类 Skia矩阵44 <公开 注释 = "sk_matrix44_t: 4x4 矩阵(16 个单精度小数, 行主序 m00..m33)。底层 64 字节缓冲。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "64 字节缓冲, 对应 sk_matrix44_t(16 个单精度小数)。">

    方法 类_初始化 <公开 注释 = "分配 64 字节缓冲并置为单位矩阵。">
    {
        数据 = 取空白字节集 (64)
        置单位矩阵 ()
    }

    方法 置单位矩阵 <公开 类型 = 逻辑型 注释 = "置为 4x4 单位矩阵。">
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { float* __m = (float*)@<地址>; for (int __i = 0; __i < 16; ++__i) { __m[__i] = 0.0f; } __m[0] = 1.0f; __m[5] = 1.0f; __m[10] = 1.0f; __m[15] = 1.0f; return true; }());
        返回 (真)
    }

    方法 取元素 <公开 类型 = 小数 注释 = "取第 行,列 个元素(行列均为 0~3)。">
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        变量 结果 <类型 = 小数>
        地址 = 取地址 ()
        @ @<结果> = (double)((const float*)@<地址>)[@<行> * 4 + @<列>];
        返回 (结果)
    }

    方法 置元素 <公开 类型 = 逻辑型 注释 = "设置第 行,列 个元素(行列均为 0~3)。">
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    参数 值 <类型 = 小数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ((float*)@<地址>)[@<行> * 4 + @<列>] = (float)@<值>;
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_matrix44_t*); 0 表示缓冲无效。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia矩阵44.数据>.GetPtr())
    }
}

类 Skia浮点颜色 <公开 注释 = "sk_color4f_t: 红/绿/蓝/透明度(0~1 单精度小数)。底层 16 字节缓冲。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "16 字节缓冲, 对应 sk_color4f_t(fR/fG/fB/fA 四个单精度小数)。">

