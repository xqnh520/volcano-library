    }

    方法 透明度 <公开 属性读 类型 = 小数 注释 = "透明度分量(0~1)。" 折叠 @嵌入式方法 = "">
    {
        @ (((const sk_color4f_t*)@sn<this>.@n<Skia浮点颜色.数据>.GetPtr())->fA)
    }

