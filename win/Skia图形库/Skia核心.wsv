    {
        @ (((sk_color4f_t*)@sn<this>.@n<Skia浮点颜色.数据>.GetPtr())->fA = (float)@<值>, true)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_color4f_t*); 0 表示缓冲无效。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia浮点颜色.数据>.GetPtr())
