        地址 = 取地址 ()
        @ ([&]() -> bool { sk_matrix_t* __m = (sk_matrix_t*)@<地址>; __m->scaleX = 1.0f; __m->skewX = 0.0f; __m->transX = 0.0f; __m->skewY = 0.0f; __m->scaleY = 1.0f; __m->transY = 0.0f; __m->persp0 = 0.0f; __m->persp1 = 0.0f; __m->persp2 = 1.0f; return true; }());
