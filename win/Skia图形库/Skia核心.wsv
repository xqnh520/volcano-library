        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = (sk_canvas_save_layer_rec((sk_canvas_t*)@<句柄>, (const sk_canvas_savelayerrec_t*)@<记录地址>));
        返回 (结果)
    }

    方法 旋转弧度 <公开 注释 = "旋转坐标系(单位: 弧度)。" 折叠 @嵌入式方法 = "">
    参数 弧度 <类型 = 小数>
    {
        @ sk_canvas_rotate_radians((sk_canvas_t*)@sn<this>.@n<Skia画布.对象指针>, (float)@<弧度>)
    }

