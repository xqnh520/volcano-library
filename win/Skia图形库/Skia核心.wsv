    }

    方法 连接矩阵 <公开 类型 = 逻辑型 注释 = "把 4x4 矩阵后乘到当前矩阵(叠加而非替换)。">
    参数 矩阵 <类型 = Skia矩阵44>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_canvas_concat((sk_canvas_t*)@<句柄>, (const sk_matrix44_t*)@<矩阵>.@n<Skia矩阵44.数据>.GetPtr());
        返回 (真)
    }

    方法 裁剪区域 <公开 类型 = 逻辑型 注释 = "按整数区域裁剪(无抗锯齿参数); 裁剪方式 0 挖去/1 取交。">
