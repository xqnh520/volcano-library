<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Skia <注释 = "Skia 数据/字符串/流族封装(批次2 第二部分): Skia数据 / Skia字符串 / Skia流 / Skia写流 / Skia文件流 / Skia文件写流 / Skia内存流 / Skia动态内存写流。"
        注释 = "【必须显式释放】火山值类按值复制会共享同一原生句柄, 因此本文件所有句柄类的 类_清理 一律不做自动销毁 —— 谁创建谁调用 释放(或派生类的 关闭)。忘记释放只会泄漏, 不会崩。"
        注释 = "【继承约定】Skia文件流 / Skia内存流 基础类 = Skia流(基类有 释放), 销毁方法叫 关闭; Skia文件写流 / Skia动态内存写流 基础类 = Skia写流(基类没有 释放, 原生无 sk_wstream_destroy), 销毁方法也叫 关闭。同一个类里只有一个 关闭。"
        注释 = "【编码到内存的标准套路】Skia动态内存写流.新建 () → 用它的 取借用写流 () 作为目标写流 → Skia编解码器.编码PNG/JPEpeg/WebP → 取出为数据 () → Skia数据.取字节集类 () → 存盘。"
        @视窗.头文件搜寻目录 = "deps\\skia"
        @视窗.头文件搜寻目录 = "deps\\skia\\include\\c"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "skia_include.h">

# ============================================================
# 一、Skia数据(不可变字节缓冲)
# ============================================================

类 Skia数据 <公开 注释 = "不可变字节缓冲(sk_data_t): 图像编码数据、序列化图片等都靠它承载。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia数据.对象指针>)
    }

    方法 新建_空 <公开 静态 类型 = Skia数据 注释 = "静态; 长度为 0 的不可变缓冲。">
    {
        变量 结果 <类型 = Skia数据>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_data_new_empty();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按拷贝 <公开 静态 类型 = Skia数据 注释 = "静态; 拷贝整个字节集内容建数据, 长度由 取字节集长度 自动得出。">
    参数 数据源 <类型 = 字节集类>
    {
        变量 结果 <类型 = Skia数据>
        变量 长度 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        长度 = 取字节集长度 (数据源)
        @ @<新指针> = (intptr_t)sk_data_new_with_copy((const void*)@<数据源>.GetPtr(), (size_t)@<长度>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_子集 <公开 静态 类型 = Skia数据 注释 = "静态; 不拷贝内存, 共享源数据缓冲; 偏移+尺寸不得越过源长度。">
    参数 源数据 <类型 = Skia数据>
    参数 偏移 <类型 = 变整数>
    参数 数据尺寸 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia数据>
        变量 源句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        源句柄 = 源数据.对象指针
        @ @<新指针> = (intptr_t)sk_data_new_subset((const sk_data_t*)@<源句柄>, (size_t)@<偏移>, (size_t)@<数据尺寸>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_未初始化 <公开 静态 类型 = Skia数据 注释 = "静态; 申请指定字节数的可写数据, 内容未清零。">
    参数 数据尺寸 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia数据>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_data_new_uninitialized((size_t)@<数据尺寸>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按文件 <公开 静态 类型 = Skia数据 注释 = "静态; 把整个文件读进内存; 失败返回空对象(句柄 0)。">
    参数 文件名 <类型 = 文本型>
    {
        变量 结果 <类型 = Skia数据>
        变量 路径数据 <类型 = 字节集类>
        变量 新指针 <类型 = 变整数>
        路径数据 = 文本到UTF8 (文件名, )
        @ @<新指针> = (intptr_t)sk_data_new_from_file((const char*)@<路径数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按流 <公开 静态 类型 = Skia数据 注释 = "静态; 从流中读 数据尺寸 个字节(尺寸传 0 表示读到末尾)。">
    参数 流 <类型 = Skia流>
    参数 数据尺寸 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia数据>
        变量 流句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        流句柄 = 流.对象指针
        @ @<新指针> = (intptr_t)sk_data_new_from_stream((sk_stream_t*)@<流句柄>, (size_t)@<数据尺寸>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_data_unref((sk_data_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia数据.对象指针> != 0)
    }

    方法 加引用 <公开 注释 = "增加一份引用, 可多处复用; sk_data_ref 的参数是 const。" 折叠 @嵌入式方法 = "">
    {
        @ sk_data_ref((const sk_data_t*)@sn<this>.@n<Skia数据.对象指针>)
    }

    方法 取尺寸 <公开 类型 = 变整数 注释 = "字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_data_get_size((const sk_data_t*)@sn<this>.@n<Skia数据.对象指针>))
    }

    方法 取数据地址 <公开 类型 = 变整数 注释 = "const void* 裸地址, 不拷贝; 随本对象释放而失效。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_data_get_data((const sk_data_t*)@sn<this>.@n<Skia数据.对象指针>))
    }

    方法 取字节地址 <公开 类型 = 变整数 注释 = "const uint8_t* 裸地址, 与 取数据地址 等价(供编解码接口用)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_data_get_bytes((const sk_data_t*)@sn<this>.@n<Skia数据.对象指针>))
    }

    方法 取字节集类 <公开 类型 = 字节集类 注释 = "纯火山辅助: 把本数据的全部字节拷贝成火山字节集, 调用方可以安全持有。">
    {
        变量 长度 <类型 = 变整数>
        变量 容量 <类型 = 整数>
        变量 地址 <类型 = 变整数>
        变量 结果 <类型 = 字节集类>
        长度 = 取尺寸 ()
        @ @<容量> = (int)@<长度>;
        地址 = 取数据地址 ()
        结果 = 取空白字节集 (容量)
        如果 (长度 == 0)
        {
            返回 (结果)
        }
        @ memcpy(@<结果>.GetPtr(), (const void*)@<地址>, (size_t)@<长度>);
        返回 (结果)
    }
}

# ============================================================
# 二、Skia字符串
# ============================================================

类 Skia字符串 <公开 注释 = "字符串缓冲(sk_string_t): 主要用于承接原生返回的 UTF-8 文本(如 路径转SVG文本)。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字符串.对象指针>)
    }

    方法 新建_空 <公开 静态 类型 = Skia字符串 注释 = "静态; 空字符串缓冲。">
    {
        变量 结果 <类型 = Skia字符串>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_string_new_empty();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按拷贝 <公开 静态 类型 = Skia字符串 注释 = "静态; 拷贝原始字节(不做编码转换), 长度由 取字节集长度 得出。">
    参数 内容 <类型 = 字节集类>
    {
        变量 结果 <类型 = Skia字符串>
        变量 长度 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        长度 = 取字节集长度 (内容)
        @ @<新指针> = (intptr_t)sk_string_new_with_copy((const char*)@<内容>.GetPtr(), (size_t)@<长度>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_string_destructor((sk_string_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字符串.对象指针> != 0)
    }

    方法 取尺寸 <公开 类型 = 变整数 注释 = "字节数(不含结尾 0)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_string_get_size((const sk_string_t*)@sn<this>.@n<Skia字符串.对象指针>))
    }

    方法 取文本 <公开 类型 = 文本型 注释 = "按 UTF-8 解释成火山文本(内部先拷到字节集再转换); 内含 0 字节时会被截断。">
    {
        变量 长度 <类型 = 变整数>
        变量 容量 <类型 = 整数>
        变量 地址 <类型 = 变整数>
        变量 缓冲 <类型 = 字节集类>
        变量 结果 <类型 = 文本型>
        如果 (对象指针 == 0)
        {
            返回 ("")
        }
        长度 = 取尺寸 ()
        @ @<容量> = (int)(@<长度> + 1);
        缓冲 = 取空白字节集 (容量)
        地址 = 对象指针
        @ memcpy(@<缓冲>.GetPtr(), sk_string_get_c_str((const sk_string_t*)@<地址>), (size_t)@<长度> + 1);
        结果 = UTF8到文本 (缓冲)
        返回 (结果)
    }
}

# ============================================================
# 三、Skia流(基类)
# ============================================================

类 Skia流 <公开 注释 = "只读流基类(sk_stream_t)。派生的 Skia文件流 / Skia内存流 用 关闭 销毁; 本基类用 释放。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia流.对象指针>)
    }

    方法 销毁资源流 <公开 静态 注释 = "静态; 销毁 Skia动态内存写流.取出为流 () 得到的 sk_stream_asset_t* 裸句柄; 传 0 无副作用。" 折叠 @嵌入式方法 = "">
    参数 资源流句柄 <类型 = 变整数>
    {
        @ sk_stream_asset_destroy((sk_stream_asset_t*)@<资源流句柄>);
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁流句柄; 可重复调用(派生类请改用 关闭)。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_stream_destroy((sk_stream_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放/关闭)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia流.对象指针> != 0)
    }

    方法 取数据 <公开 类型 = 变整数 注释 = "最多读 数量 字节写入 目标数据, 返回实际读取字节数; 目标数据长度须 ≥ 数量。">
    参数 目标数据 <类型 = 字节集类>
    参数 数量 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = ((intptr_t)sk_stream_read((sk_stream_t*)@<句柄>, (void*)@<目标数据>.GetPtr(), (size_t)@<数量>));
        返回 (结果)
    }

    方法 预览数据 <公开 类型 = 变整数 注释 = "读但不前进, 返回实际预览字节数。">
    参数 目标数据 <类型 = 字节集类>
    参数 数量 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = ((intptr_t)sk_stream_peek((sk_stream_t*)@<句柄>, (void*)@<目标数据>.GetPtr(), (size_t)@<数量>));
        返回 (结果)
    }

    方法 跳过 <公开 类型 = 变整数 注释 = "跳过 数量 字节, 返回实际跳过字节数(可能小于请求)。">
    参数 数量 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = ((intptr_t)sk_stream_skip((sk_stream_t*)@<句柄>, (size_t)@<数量>));
        返回 (结果)
    }

    方法 取无符号八位 <公开 类型 = 逻辑型 注释 = "读 1 字节无符号整数写入 结果数据(需 1 字节)。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_read_u8((sk_stream_t*)@<句柄>, (uint8_t*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取无符号十六位 <公开 类型 = 逻辑型 注释 = "读 2 字节无符号整数写入 结果数据(需 2 字节)。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_read_u16((sk_stream_t*)@<句柄>, (uint16_t*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取无符号三十二位 <公开 类型 = 逻辑型 注释 = "读 4 字节无符号整数写入 结果数据(需 4 字节)。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_read_u32((sk_stream_t*)@<句柄>, (uint32_t*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 是否结束 <公开 类型 = 逻辑型 注释 = "是否已到末尾。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_stream_is_at_end((sk_stream_t*)@sn<this>.@n<Skia流.对象指针>) != 0)
    }

    方法 取八位整数 <公开 类型 = 逻辑型 注释 = "读 1 字节有符号整数写入 结果数据(需 1 字节); 无符号请自行按 255 掩码解释。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_read_s8((sk_stream_t*)@<句柄>, (int8_t*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取十六位整数 <公开 类型 = 逻辑型 注释 = "读 2 字节有符号整数写入 结果数据(需 2 字节)。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_read_s16((sk_stream_t*)@<句柄>, (int16_t*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取三十二位整数 <公开 类型 = 逻辑型 注释 = "读 4 字节有符号整数写入 结果数据(需 4 字节)。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_read_s32((sk_stream_t*)@<句柄>, (int32_t*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取布尔值 <公开 类型 = 逻辑型 注释 = "读 1 字节布尔(0/1)写入 结果数据(需 1 字节)。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_read_bool((sk_stream_t*)@<句柄>, (bool*)@<结果数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 重置位置 <公开 类型 = 逻辑型 注释 = "回到开头; 流不支持回绕时返回假。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_stream_rewind((sk_stream_t*)@sn<this>.@n<Skia流.对象指针>) != 0)
    }

    方法 是否支持定位 <公开 类型 = 逻辑型 注释 = "为假时 取当前偏移/定位到/相对移动 都无意义。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_stream_has_position((sk_stream_t*)@sn<this>.@n<Skia流.对象指针>) != 0)
    }

    方法 取当前偏移 <公开 类型 = 变整数 注释 = "距开头的字节偏移; 不支持定位时返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_stream_get_position((sk_stream_t*)@sn<this>.@n<Skia流.对象指针>))
    }

    方法 定位到 <公开 类型 = 逻辑型 注释 = "绝对定位到指定字节偏移。">
    参数 偏移 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_seek((sk_stream_t*)@<句柄>, (size_t)@<偏移>) != 0);
        返回 (结果)
    }

    方法 相对移动 <公开 类型 = 逻辑型 注释 = "相对当前偏移移动, 可为负。">
    参数 偏移 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_stream_move((sk_stream_t*)@<句柄>, @<偏移>) != 0);
        返回 (结果)
    }

    方法 是否已知总长 <公开 类型 = 逻辑型 注释 = "为假时 取数据总长 不可用。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_stream_has_length((sk_stream_t*)@sn<this>.@n<Skia流.对象指针>) != 0)
    }

    方法 取数据总长 <公开 类型 = 变整数 注释 = "剩余总字节数; 未知长度时返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_stream_get_length((sk_stream_t*)@sn<this>.@n<Skia流.对象指针>))
    }

    方法 取内存起始地址 <公开 类型 = 变整数 注释 = "只有基于内存的流才有值, 其它返回 0(不拷贝)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_stream_get_memory_base((sk_stream_t*)@sn<this>.@n<Skia流.对象指针>))
    }

    方法 转为数据 <公开 类型 = Skia数据 注释 = "把当前位置到末尾的内容转成 Skia数据(会占用流); 失败返回空对象。">
    {
        变量 结果 <类型 = Skia数据>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_stream_get_data((sk_stream_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 分流 <公开 类型 = Skia流 注释 = "从当前位置派生一个独立流, 两端共享底层缓冲。">
    {
        变量 结果 <类型 = Skia流>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_stream_fork((sk_stream_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 复制 <公开 类型 = Skia流 注释 = "复制当前状态(互不影响)。">
    {
        变量 结果 <类型 = Skia流>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_stream_duplicate((sk_stream_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}

# ============================================================
# 四、Skia写流(基类, 无 释放)
# ============================================================

类 Skia写流 <公开 注释 = "写流基类(sk_wstream_t)。原生没有 sk_wstream_destroy, 所以本类没有 释放; 派生的 Skia文件写流 / Skia动态内存写流 用 关闭 销毁。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 关闭 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia写流.对象指针>)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 关闭)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia写流.对象指针> != 0)
    }

    方法 写换行 <公开 类型 = 逻辑型 注释 = "写入平台换行(通常为 \n)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_wstream_newline((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>) != 0)
    }

    方法 刷新 <公开 注释 = "把缓冲推给底层(文件写流必须调)。" 折叠 @嵌入式方法 = "">
    {
        @ sk_wstream_flush((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>)
    }

    方法 写八位 <公开 类型 = 逻辑型 注释 = "只写低 8 位。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (sk_wstream_write_8((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, (uint8_t)@<值>) != 0)
    }

    方法 写十六位 <公开 类型 = 逻辑型 注释 = "小端写出 2 字节。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (sk_wstream_write_16((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, (uint16_t)@<值>) != 0)
    }

    方法 写三十二位 <公开 类型 = 逻辑型 注释 = "小端写出 4 字节。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (sk_wstream_write_32((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, (uint32_t)@<值>) != 0)
    }

    方法 写文本 <公开 类型 = 逻辑型 注释 = "自动转 UTF-8 并写原始字节(不写长度前缀)。">
    参数 内容 <类型 = 文本型>
    {
        变量 句柄 <类型 = 变整数>
        变量 文本数据 <类型 = 字节集类>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        文本数据 = 文本到UTF8 (内容, )
        @ @<结果> = (sk_wstream_write_text((sk_wstream_t*)@<句柄>, (const char*)@<文本数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 写十进制文本 <公开 类型 = 逻辑型 注释 = "例: -42 写成 「-42」。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (sk_wstream_write_dec_as_text((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, @<值>) != 0)
    }

    方法 写长十进制文本 <公开 类型 = 逻辑型 注释 = "不足 最少位数 时左侧补 0。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 长整数>
    参数 最少位数 <类型 = 整数>
    {
        @ (sk_wstream_write_bigdec_as_text((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, @<值>, @<最少位数>) != 0)
    }

    方法 写十六进制文本 <公开 类型 = 逻辑型 注释 = "大写十六进制, 不足 最少位数 时左侧补 0。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    参数 最少位数 <类型 = 整数>
    {
        @ (sk_wstream_write_hex_as_text((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, @<值>, @<最少位数>) != 0)
    }

    方法 写小数文本 <公开 类型 = 逻辑型 注释 = "单精度小数的十进制文本。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 小数>
    {
        @ (sk_wstream_write_scalar_as_text((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, (float)@<值>) != 0)
    }

    方法 写单精度 <公开 类型 = 逻辑型 注释 = "写 4 字节二进制浮点(小端), 与 写小数文本 不同。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 小数>
    {
        @ (sk_wstream_write_scalar((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, (float)@<值>) != 0)
    }

    方法 写压缩整数 <公开 类型 = 逻辑型 注释 = "Skia 变长整数编码; 与 取压缩整数尺寸 配对。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 变整数>
    {
        @ (sk_wstream_write_packed_uint((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, (size_t)@<值>) != 0)
    }

    方法 写数据 <公开 类型 = 逻辑型 注释 = "把字节集的全部字节写出去(二进制写入的标准入口, 长度由 取字节集长度 得出)。">
    参数 数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 长度 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        长度 = 取字节集长度 (数据)
        @ @<结果> = (sk_wstream_write((sk_wstream_t*)@<句柄>, (const void*)@<数据>.GetPtr(), (size_t)@<长度>) != 0);
        返回 (结果)
    }

    方法 写布尔值 <公开 类型 = 逻辑型 注释 = "写入 1 字节布尔值。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 逻辑型>
    {
        @ (sk_wstream_write_bool((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>, (bool)@<值>) != 0)
    }

    方法 取已写字节数 <公开 类型 = 变整数 注释 = "本写流累计已写入的字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_wstream_bytes_written((sk_wstream_t*)@sn<this>.@n<Skia写流.对象指针>))
    }

    方法 写流 <公开 类型 = 逻辑型 注释 = "从源流复制指定字节数到本流。">
    参数 源流 <类型 = Skia流>
    参数 数量 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 源句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        源句柄 = 源流.对象指针
        @ @<结果> = (sk_wstream_write_stream((sk_wstream_t*)@<句柄>, (sk_stream_t*)@<源句柄>, (size_t)@<数量>) != 0);
        返回 (结果)
    }

    方法 取压缩整数尺寸 <公开 静态 类型 = 整数 注释 = "静态; 预算该值用变长整数编码后占几个字节。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 变整数>
    {
        @ (sk_wstream_get_size_of_packed_uint((size_t)@<值>))
    }
}

# ============================================================
# 五、Skia文件流(派生, 关闭)
# ============================================================

类 Skia文件流 <公开 基础类 = Skia流 注释 = "只读文件流(sk_stream_filestream_t)。销毁用 关闭, 不要用 释放。">
{
    方法 新建 <公开 静态 类型 = Skia文件流 注释 = "静态; 只读打开文件。原生 is_valid 已导出, 用 是否已打开 () 判定; 也可用 取数据总长 () 是否大于 0 判定。">
    参数 文件名 <类型 = 文本型>
    {
        变量 结果 <类型 = Skia文件流>
        变量 路径数据 <类型 = 字节集类>
        变量 新指针 <类型 = 变整数>
        路径数据 = 文本到UTF8 (文件名, )
        @ @<新指针> = (intptr_t)sk_filestream_new((const char*)@<路径数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 是否已打开 <公开 类型 = 逻辑型 注释 = "文件是否成功打开(原生 is_valid); 基类的 是否有效 只判句柄非 0, 语义不同所以用不同名。">
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_filestream_is_valid((sk_stream_filestream_t*)@<句柄>) != 0);
        返回 (结果)
    }

    方法 关闭 <公开 类型 = 逻辑型 注释 = "关闭并销毁文件流; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_filestream_destroy((sk_stream_filestream_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }
}

# ============================================================
# 六、Skia文件写流(派生, 关闭)
# ============================================================

类 Skia文件写流 <公开 基础类 = Skia写流 注释 = "文件写流(sk_wstream_filestream_t)。销毁用 关闭(内部会自动刷出缓冲)。">
{
    方法 新建 <公开 静态 类型 = Skia文件写流 注释 = "静态; 覆盖写入方式打开文件; 失败返回空对象。">
    参数 文件名 <类型 = 文本型>
    {
        变量 结果 <类型 = Skia文件写流>
        变量 路径数据 <类型 = 字节集类>
        变量 新指针 <类型 = 变整数>
        路径数据 = 文本到UTF8 (文件名, )
        @ @<新指针> = (intptr_t)sk_filewstream_new((const char*)@<路径数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 是否已打开 <公开 类型 = 逻辑型 注释 = "文件写流是否成功打开(原生 is_valid); 与基类 是否有效 语义不同所以用不同名。">
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_filewstream_is_valid((sk_wstream_filestream_t*)@<句柄>) != 0);
        返回 (结果)
    }

    方法 关闭 <公开 类型 = 逻辑型 注释 = "刷出缓冲并关闭文件写流; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_filewstream_destroy((sk_wstream_filestream_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }
}

# ============================================================
# 七、Skia内存流(派生, 关闭)
# ============================================================

类 Skia内存流 <公开 基础类 = Skia流 注释 = "内存只读流(sk_stream_memorystream_t)。销毁用 关闭。">
{
    方法 新建 <公开 静态 类型 = Skia内存流 注释 = "静态; 空的内存流。">
    {
        变量 结果 <类型 = Skia内存流>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_memorystream_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按长度 <公开 静态 类型 = Skia内存流 注释 = "静态; 预分配指定字节数, 内容未清零。">
    参数 数据尺寸 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia内存流>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_memorystream_new_with_length((size_t)@<数据尺寸>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按数据 <公开 静态 类型 = Skia内存流 注释 = "静态; 是否复制 为假时直接引用外部内存(调用方须保证内存在流存活期内有效)。">
    参数 数据地址 <类型 = 变整数>
    参数 数据尺寸 <类型 = 变整数>
    参数 是否复制 <类型 = 逻辑型 @默认值 = 真>
    {
        变量 结果 <类型 = Skia内存流>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_memorystream_new_with_data((const void*)@<数据地址>, (size_t)@<数据尺寸>, (bool)@<是否复制>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按Skia数据 <公开 静态 类型 = Skia内存流 注释 = "静态; 引用 Skia数据 的缓冲(不需要另外拷贝)。">
    参数 数据 <类型 = Skia数据>
    {
        变量 结果 <类型 = Skia内存流>
        变量 数据句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        数据句柄 = 数据.对象指针
        @ @<新指针> = (intptr_t)sk_memorystream_new_with_skdata((sk_data_t*)@<数据句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 置内存 <公开 类型 = 逻辑型 注释 = "复用已有对象重新绑定内存(是否复制 的语义同 新建_按数据)。">
    参数 数据地址 <类型 = 变整数>
    参数 数据尺寸 <类型 = 变整数>
    参数 是否复制 <类型 = 逻辑型 @默认值 = 真>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_memorystream_set_memory((sk_stream_memorystream_t*)@<句柄>, (void*)@<数据地址>, (size_t)@<数据尺寸>, (bool)@<是否复制>);
        返回 (真)
    }

    方法 关闭 <公开 类型 = 逻辑型 注释 = "关闭内存流; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_memorystream_destroy((sk_stream_memorystream_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }
}

# ============================================================
# 八、Skia动态内存写流(派生, 关闭)
# ============================================================

类 Skia动态内存写流 <公开 基础类 = Skia写流 注释 = "可增长的内存写流(sk_wstream_dynamicmemorystream_t), 是「编码到内存」的标准套路。销毁用 关闭。">
{
    方法 新建 <公开 静态 类型 = Skia动态内存写流 注释 = "静态; 创建可增长的内存写流。">
    {
        变量 结果 <类型 = Skia动态内存写流>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_dynamicmemorywstream_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取出为数据 <公开 类型 = Skia数据 注释 = "交出已写内容并清空本流, 之后可继续写下一段。">
    {
        变量 结果 <类型 = Skia数据>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_dynamicmemorywstream_detach_as_data((sk_wstream_dynamicmemorystream_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取出为流 <公开 类型 = 变整数 注释 = "交出 sk_stream_asset_t* 裸句柄(要用 Skia流.销毁资源流 释放); 一般直接用 取出为数据 更省事。">
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = (intptr_t)sk_dynamicmemorywstream_detach_as_stream((sk_wstream_dynamicmemorystream_t*)@<句柄>);
        返回 (结果)
    }

    方法 复制到 <公开 类型 = 逻辑型 注释 = "把全部已写内容复制到 目标数据(长度须足够)。">
    参数 目标数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_dynamicmemorywstream_copy_to((sk_wstream_dynamicmemorystream_t*)@<句柄>, (void*)@<目标数据>.GetPtr());
        返回 (真)
    }

    方法 写到流 <公开 类型 = 逻辑型 注释 = "把已写内容推给另一个写流。">
    参数 目标写流 <类型 = Skia写流>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 目标写流.对象指针
        @ @<结果> = (sk_dynamicmemorywstream_write_to_stream((sk_wstream_dynamicmemorystream_t*)@<句柄>, (sk_wstream_t*)@<目标句柄>) != 0);
        返回 (结果)
    }

    方法 关闭 <公开 类型 = 逻辑型 注释 = "关闭并丢弃未取出的内容; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_dynamicmemorywstream_destroy((sk_wstream_dynamicmemorystream_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }
}
