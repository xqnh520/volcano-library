<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Skia <注释 = "Skia 几何与遍历器类(批次1 第二部分): 圆角矩形 / 区域 / 路径效果 / 路径测量 / 各类遍历器 / 派生画布 / 路径运算。"
        注释 = "【必须显式释放】火山值类在赋值/传参/返回时按值复制, 多个副本会共享同一个原生句柄, 因此本文件所有句柄类的 类_清理 一律不做自动销毁 —— 谁创建谁调用 释放。"
        注释 = "遍历器类持有源对象(区域/路径)的内部引用: 遍历器存活期内源对象不可释放, 否则遍历结果未定义。"
        注释 = "派生画布(无绘制/多路/过绘检测)不继承 Skia画布(火山派生类重复声明 释放 会冲突), 各自持有独立句柄, 需要绘制时用 取借用画布 得到包装成 Skia画布 的借用对象(不要释放它)。"
        @视窗.头文件搜寻目录 = "deps\\skia"
        @视窗.头文件搜寻目录 = "deps\\skia\\include\\c"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "skia_include.h">

# ============================================================
# 一、圆角矩形
# ============================================================

类 Skia圆角矩形 <公开 注释 = "圆角矩形(sk_rrect_t): 支持四角不同半径与九宫格。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia圆角矩形.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia圆角矩形 注释 = "创建空圆角矩形。">
    {
        变量 结果 <类型 = Skia圆角矩形>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_rrect_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按副本 <公开 静态 类型 = Skia圆角矩形 注释 = "完整拷贝一个圆角矩形。">
    参数 源圆角矩形 <类型 = Skia圆角矩形>
    {
        变量 结果 <类型 = Skia圆角矩形>
        变量 源句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        源句柄 = 源圆角矩形.对象指针
        @ @<新指针> = (intptr_t)sk_rrect_new_copy((const sk_rrect_t*)@<源句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_rrect_delete((const sk_rrect_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 已创建 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia圆角矩形.对象指针> != 0)
    }

    方法 取类型 <公开 类型 = 整数 注释 = "0 空/1 矩形/2 椭圆/3 简单(四角相同)/4 九宫格/5 复合。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_rrect_get_type((const sk_rrect_t*)@sn<this>.@n<Skia圆角矩形.对象指针>))
    }

    方法 取角半径 <公开 类型 = 逻辑型 注释 = "取指定角的半径写入 结果向量(x 横半径, y 纵半径); 角 0 左上/1 右上/2 右下/3 左下。">
    参数 角 <类型 = 整数>
    参数 结果向量 <类型 = Skia点>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_rrect_get_radii((const sk_rrect_t*)@<句柄>, (sk_rrect_corner_t)@<角>, (sk_vector_t*)@<结果向量>.@n<Skia点.数据>.GetPtr());
        返回 (真)
    }

    方法 取宽 <公开 属性读 类型 = 小数 注释 = "宽度(像素)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_rrect_get_width((const sk_rrect_t*)@sn<this>.@n<Skia圆角矩形.对象指针>))
    }

    方法 取高 <公开 属性读 类型 = 小数 注释 = "高度(像素)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_rrect_get_height((const sk_rrect_t*)@sn<this>.@n<Skia圆角矩形.对象指针>))
    }

    方法 置空 <公开 注释 = "清成空圆角矩形。" 折叠 @嵌入式方法 = "">
    {
        @ sk_rrect_set_empty((sk_rrect_t*)@sn<this>.@n<Skia圆角矩形.对象指针>)
    }

    方法 置矩形 <公开 类型 = 逻辑型 注释 = "置为直角矩形(四角半径 0)。">
    参数 矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_rrect_set_rect((sk_rrect_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 置椭圆 <公开 类型 = 逻辑型 注释 = "置为内切于 矩形 的椭圆(四角半径为半宽半高)。">
    参数 矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_rrect_set_oval((sk_rrect_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 置矩形与半径 <公开 类型 = 逻辑型 注释 = "置为四角相同半径的圆角矩形。">
    参数 矩形 <类型 = Skia矩形>
    参数 横半径 <类型 = 小数>
    参数 纵半径 <类型 = 小数>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_rrect_set_rect_xy((sk_rrect_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (float)@<横半径>, (float)@<纵半径>);
        返回 (真)
    }

    方法 置九宫格 <公开 类型 = 逻辑型 注释 = "置为四角半径可不同的九宫格圆角矩形。">
    参数 矩形 <类型 = Skia矩形>
    参数 左上半径 <类型 = 小数>
    参数 右上半径 <类型 = 小数>
    参数 右下半径 <类型 = 小数>
    参数 左下半径 <类型 = 小数>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_rrect_set_nine_patch((sk_rrect_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (float)@<左上半径>, (float)@<右上半径>, (float)@<右下半径>, (float)@<左下半径>);
        返回 (真)
    }

    方法 置矩形与四角半径 <公开 类型 = 逻辑型 注释 = "按 角半径数据(32 字节, 顺序 左上/右上/右下/左下, 每项 8 字节 x,y) 设置四角半径。">
    参数 矩形 <类型 = Skia矩形>
    参数 角半径数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_rrect_set_rect_radii((sk_rrect_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr(), (const sk_vector_t*)@<角半径数据>.GetPtr());
        返回 (真)
    }

    方法 内缩 <公开 注释 = "四边内缩(负值等于外扩)。" 折叠 @嵌入式方法 = "">
    参数 横缩 <类型 = 小数>
    参数 纵缩 <类型 = 小数>
    {
        @ sk_rrect_inset((sk_rrect_t*)@sn<this>.@n<Skia圆角矩形.对象指针>, (float)@<横缩>, (float)@<纵缩>)
    }

    方法 外扩 <公开 注释 = "四边外扩(负值等于内缩)。" 折叠 @嵌入式方法 = "">
    参数 横扩 <类型 = 小数>
    参数 纵扩 <类型 = 小数>
    {
        @ sk_rrect_outset((sk_rrect_t*)@sn<this>.@n<Skia圆角矩形.对象指针>, (float)@<横扩>, (float)@<纵扩>)
    }

    方法 平移 <公开 注释 = "整体平移(单位像素)。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 小数>
    参数 纵位移 <类型 = 小数>
    {
        @ sk_rrect_offset((sk_rrect_t*)@sn<this>.@n<Skia圆角矩形.对象指针>, (float)@<横位移>, (float)@<纵位移>)
    }

    方法 是否包含矩形 <公开 类型 = 逻辑型 注释 = "矩形是否完全落在本圆角矩形内部。">
    参数 矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_rrect_contains((const sk_rrect_t*)@<句柄>, (const sk_rect_t*)@<矩形>.@n<Skia矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取外接矩形 <公开 类型 = 逻辑型 注释 = "把本圆角矩形的外接矩形写入 结果矩形。">
    参数 结果矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_rrect_get_rect((const sk_rrect_t*)@<句柄>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "半径与宽高不矛盾时为真。">
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_rrect_is_valid((const sk_rrect_t*)@<句柄>) != 0);
        返回 (结果)
    }

    方法 变换到 <公开 类型 = 逻辑型 注释 = "按矩阵变换后写入 目标圆角矩形; 仅供轴对齐变换, 不可行时返回假。">
    参数 矩阵 <类型 = Skia矩阵>
    参数 目标圆角矩形 <类型 = Skia圆角矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 目标圆角矩形.对象指针
        @ @<结果> = (sk_rrect_transform((sk_rrect_t*)@<句柄>, (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr(), (sk_rrect_t*)@<目标句柄>) != 0);
        返回 (结果)
    }
}

# ============================================================
# 二、区域(整数像素集合)
# ============================================================

类 Skia区域 <公开 注释 = "区域(sk_region_t): 由整数像素矩形拼成的集合, 全整数运算。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia区域.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia区域 注释 = "创建空区域。">
    {
        变量 结果 <类型 = Skia区域>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_region_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_region_delete((sk_region_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia区域.对象指针> != 0)
    }

    方法 是否为空 <公开 类型 = 逻辑型 注释 = "区域是否不含任何像素。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_region_is_empty((const sk_region_t*)@sn<this>.@n<Skia区域.对象指针>) != 0)
    }

    方法 是否为矩形 <公开 类型 = 逻辑型 注释 = "是否退化成单一矩形(最快的情况)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_region_is_rect((const sk_region_t*)@sn<this>.@n<Skia区域.对象指针>) != 0)
    }

    方法 是否为复合 <公开 类型 = 逻辑型 注释 = "是否由多个矩形拼成。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_region_is_complex((const sk_region_t*)@sn<this>.@n<Skia区域.对象指针>) != 0)
    }

    方法 取边界 <公开 类型 = 逻辑型 注释 = "取外接整数矩形写入 结果矩形。">
    参数 结果矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_region_get_bounds((const sk_region_t*)@<句柄>, (sk_irect_t*)@<结果矩形>.@n<Skia整数矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 取边界路径 <公开 类型 = 逻辑型 注释 = "把区域轮廓转成路径写入 结果路径, 便于描边或按路径绘制。">
    参数 结果路径 <类型 = Skia路径>
    {
        变量 句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        路径句柄 = 结果路径.对象指针
        @ @<结果> = (sk_region_get_boundary_path((const sk_region_t*)@<句柄>, (sk_path_t*)@<路径句柄>) != 0);
        返回 (结果)
    }

    方法 置空 <公开 类型 = 逻辑型 注释 = "清空成空区域。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_region_set_empty((sk_region_t*)@sn<this>.@n<Skia区域.对象指针>) != 0)
    }

    方法 置矩形 <公开 类型 = 逻辑型 注释 = "置为单个整数矩形。">
    参数 矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_region_set_rect((sk_region_t*)@<句柄>, (const sk_irect_t*)@<矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 置多个矩形 <公开 类型 = 逻辑型 注释 = "置为 矩形数据 里的 数量 个整数矩形(每项 16 字节)。">
    参数 矩形数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_region_set_rects((sk_region_t*)@<句柄>, (const sk_irect_t*)@<矩形数据>.GetPtr(), @<数量>) != 0);
        返回 (结果)
    }

    方法 置区域 <公开 类型 = 逻辑型 注释 = "整体拷贝另一个区域。">
    参数 源区域 <类型 = Skia区域>
    {
        变量 句柄 <类型 = 变整数>
        变量 源句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        源句柄 = 源区域.对象指针
        @ @<结果> = (sk_region_set_region((sk_region_t*)@<句柄>, (const sk_region_t*)@<源句柄>) != 0);
        返回 (结果)
    }

    方法 置路径 <公开 类型 = 逻辑型 注释 = "按路径填充方式光栅化成区域; 裁剪区域句柄传 0 表示不裁剪。">
    参数 路径 <类型 = Skia路径>
    参数 裁剪区域 <类型 = Skia区域>
    {
        变量 句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        变量 裁剪指针 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        路径句柄 = 路径.对象指针
        裁剪指针 = 裁剪区域.对象指针
        @ @<结果> = (sk_region_set_path((sk_region_t*)@<句柄>, (const sk_path_t*)@<路径句柄>, (const sk_region_t*)@<裁剪指针>) != 0);
        返回 (结果)
    }

    方法 是否相交矩形 <公开 类型 = 逻辑型 注释 = "是否与指定整数矩形有公共像素。">
    参数 矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_region_intersects_rect((const sk_region_t*)@<句柄>, (const sk_irect_t*)@<矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 是否相交 <公开 类型 = 逻辑型 注释 = "是否与另一区域有公共像素。">
    参数 区域 <类型 = Skia区域>
    {
        变量 句柄 <类型 = 变整数>
        变量 区域句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        区域句柄 = 区域.对象指针
        @ @<结果> = (sk_region_intersects((const sk_region_t*)@<句柄>, (const sk_region_t*)@<区域句柄>) != 0);
        返回 (结果)
    }

    方法 是否包含点 <公开 类型 = 逻辑型 注释 = "是否包含指定整数像素点。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ (sk_region_contains_point((const sk_region_t*)@sn<this>.@n<Skia区域.对象指针>, @<横坐标>, @<纵坐标>) != 0)
    }

    方法 是否包含矩形 <公开 类型 = 逻辑型 注释 = "是否完全包含指定整数矩形。">
    参数 矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_region_contains_rect((const sk_region_t*)@<句柄>, (const sk_irect_t*)@<矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 是否包含区域 <公开 类型 = 逻辑型 注释 = "是否完全包含另一区域。">
    参数 区域 <类型 = Skia区域>
    {
        变量 句柄 <类型 = 变整数>
        变量 区域句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        区域句柄 = 区域.对象指针
        @ @<结果> = (sk_region_contains((const sk_region_t*)@<句柄>, (const sk_region_t*)@<区域句柄>) != 0);
        返回 (结果)
    }

    方法 快速包含矩形 <公开 类型 = 逻辑型 注释 = "只比较外接矩形, 可能误判为真(仅用于优化)。">
    参数 矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_region_quick_contains((const sk_region_t*)@<句柄>, (const sk_irect_t*)@<矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 快速剔除矩形 <公开 类型 = 逻辑型 注释 = "为真表示肯定与指定矩形不相交, 可安全跳过。">
    参数 矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_region_quick_reject_rect((const sk_region_t*)@<句柄>, (const sk_irect_t*)@<矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 快速剔除区域 <公开 类型 = 逻辑型 注释 = "为真表示肯定与另一区域不相交。">
    参数 区域 <类型 = Skia区域>
    {
        变量 句柄 <类型 = 变整数>
        变量 区域句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        区域句柄 = 区域.对象指针
        @ @<结果> = (sk_region_quick_reject((const sk_region_t*)@<句柄>, (const sk_region_t*)@<区域句柄>) != 0);
        返回 (结果)
    }

    方法 平移 <公开 注释 = "整体平移(整数像素)。" 折叠 @嵌入式方法 = "">
    参数 横位移 <类型 = 整数>
    参数 纵位移 <类型 = 整数>
    {
        @ sk_region_translate((sk_region_t*)@sn<this>.@n<Skia区域.对象指针>, @<横位移>, @<纵位移>)
    }

    方法 与矩形运算 <公开 类型 = 逻辑型 注释 = "与整数矩形做布尔运算; 运算方式 0 差/1 交/2 并/3 异或/4 反向差/5 替换。">
    参数 矩形 <类型 = Skia整数矩形>
    参数 运算方式 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_region_op_rect((sk_region_t*)@<句柄>, (const sk_irect_t*)@<矩形>.@n<Skia整数矩形.数据>.GetPtr(), (sk_region_op_t)@<运算方式>) != 0);
        返回 (结果)
    }

    方法 与区域运算 <公开 类型 = 逻辑型 注释 = "与另一区域做布尔运算; 运算方式 0 差/1 交/2 并/3 异或/4 反向差/5 替换。">
    参数 区域 <类型 = Skia区域>
    参数 运算方式 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 区域句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        区域句柄 = 区域.对象指针
        @ @<结果> = (sk_region_op((sk_region_t*)@<句柄>, (const sk_region_t*)@<区域句柄>, (sk_region_op_t)@<运算方式>) != 0);
        返回 (结果)
    }
}

# ============================================================
# 三、区域遍历器族
# ============================================================

类 Skia区域遍历器 <公开 注释 = "遍历区域分解出的矩形块; 生存期内源区域不可释放。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia区域遍历器.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia区域遍历器 注释 = "由区域创建遍历器(源区域在遍历期间不可释放)。">
    参数 区域 <类型 = Skia区域>
    {
        变量 结果 <类型 = Skia区域遍历器>
        变量 区域句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        区域句柄 = 区域.对象指针
        @ @<新指针> = (intptr_t)sk_region_iterator_new((const sk_region_t*)@<区域句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        @ sk_region_iterator_rewind((sk_region_iterator_t*)@<新指针>);
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁遍历器; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_region_iterator_delete((sk_region_iterator_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 重置遍历 <公开 类型 = 逻辑型 注释 = "回到第一块。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_region_iterator_rewind((sk_region_iterator_t*)@sn<this>.@n<Skia区域遍历器.对象指针>) != 0)
    }

    方法 遍历结束 <公开 类型 = 逻辑型 注释 = "为真表示已无更多块。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_region_iterator_done((const sk_region_iterator_t*)@sn<this>.@n<Skia区域遍历器.对象指针>) != 0)
    }

    方法 下一块 <公开 注释 = "前进到下一块。" 折叠 @嵌入式方法 = "">
    {
        @ sk_region_iterator_next((sk_region_iterator_t*)@sn<this>.@n<Skia区域遍历器.对象指针>)
    }

    方法 取当前矩形 <公开 类型 = 逻辑型 注释 = "取当前块的整数矩形写入 结果矩形。">
    参数 结果矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_region_iterator_rect((const sk_region_iterator_t*)@<句柄>, (sk_irect_t*)@<结果矩形>.@n<Skia整数矩形.数据>.GetPtr());
        返回 (真)
    }
}

类 Skia区域裁剪遍历器 <公开 注释 = "只遍历区域与裁剪矩形相交部分的遍历器; 生存期内源区域不可释放。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia区域裁剪遍历器.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia区域裁剪遍历器 注释 = "由区域与裁剪矩形创建遍历器。">
    参数 区域 <类型 = Skia区域>
    参数 裁剪矩形 <类型 = Skia整数矩形>
    {
        变量 结果 <类型 = Skia区域裁剪遍历器>
        变量 区域句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        区域句柄 = 区域.对象指针
        @ @<新指针> = (intptr_t)sk_region_cliperator_new((const sk_region_t*)@<区域句柄>, (const sk_irect_t*)@<裁剪矩形>.@n<Skia整数矩形.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁遍历器; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_region_cliperator_delete((sk_region_cliperator_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 遍历结束 <公开 类型 = 逻辑型 注释 = "为真表示已无更多块。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_region_cliperator_done((sk_region_cliperator_t*)@sn<this>.@n<Skia区域裁剪遍历器.对象指针>) != 0)
    }

    方法 下一块 <公开 注释 = "前进到下一块。" 折叠 @嵌入式方法 = "">
    {
        @ sk_region_cliperator_next((sk_region_cliperator_t*)@sn<this>.@n<Skia区域裁剪遍历器.对象指针>)
    }

    方法 取裁剪矩形 <公开 类型 = 逻辑型 注释 = "取当前块与裁剪矩形相交后的矩形写入 结果矩形。">
    参数 结果矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_region_cliperator_rect((const sk_region_cliperator_t*)@<句柄>, (sk_irect_t*)@<结果矩形>.@n<Skia整数矩形.数据>.GetPtr());
        返回 (真)
    }
}

类 Skia区域扫描遍历器 <公开 注释 = "扫描区域指定行上的连续像素段; 生存期内源区域不可释放。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia区域扫描遍历器.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia区域扫描遍历器 注释 = "由区域与行号创建扫描遍历器; 左界/右界为整数像素限制。">
    参数 区域 <类型 = Skia区域>
    参数 行号 <类型 = 整数>
    参数 左界 <类型 = 整数>
    参数 右界 <类型 = 整数>
    {
        变量 结果 <类型 = Skia区域扫描遍历器>
        变量 区域句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        区域句柄 = 区域.对象指针
        @ @<新指针> = (intptr_t)sk_region_spanerator_new((const sk_region_t*)@<区域句柄>, @<行号>, @<左界>, @<右界>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁遍历器; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_region_spanerator_delete((sk_region_spanerator_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 下一段 <公开 类型 = 逻辑型 注释 = "取下一段; 有段时把 左界/右界 两个 32 位整数写入 结果数据(需 8 字节), 区间左闭右开。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = ([&]() -> bool { int __l = 0; int __r = 0; bool __ok = sk_region_spanerator_next((sk_region_spanerator_t*)@<句柄>, &__l, &__r) != 0; int __pair[2]; __pair[0] = __l; __pair[1] = __r; memcpy(@<结果数据>.GetPtr(), __pair, 8); return __ok; }());
        返回 (结果)
    }
}

# ============================================================
# 四、路径效果(描边特效)
# ============================================================

类 Skia路径效果 <公开 注释 = "描边路径效果(sk_path_effect_t): 虚线/圆角/裁剪/印章等。置入画笔后所有权归画笔, 不要再次 释放。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径效果.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "只减引用计数; 已置入画笔的效果不要再释放; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_path_effect_unref((sk_path_effect_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径效果.对象指针> != 0)
    }

    方法 新建_组合 <公开 静态 类型 = Skia路径效果 注释 = "静态; 先施加内效果再施加外效果。">
    参数 外效果 <类型 = Skia路径效果>
    参数 内效果 <类型 = Skia路径效果>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 外句柄 <类型 = 变整数>
        变量 内句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        外句柄 = 外效果.对象指针
        内句柄 = 内效果.对象指针
        @ @<新指针> = (intptr_t)sk_path_effect_create_compose((sk_path_effect_t*)@<外句柄>, (sk_path_effect_t*)@<内句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_合并 <公开 静态 类型 = Skia路径效果 注释 = "静态; 两个效果的结果同时画, 画笔须为描边。">
    参数 效果甲 <类型 = Skia路径效果>
    参数 效果乙 <类型 = Skia路径效果>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 甲句柄 <类型 = 变整数>
        变量 乙句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        甲句柄 = 效果甲.对象指针
        乙句柄 = 效果乙.对象指针
        @ @<新指针> = (intptr_t)sk_path_effect_create_sum((sk_path_effect_t*)@<甲句柄>, (sk_path_effect_t*)@<乙句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_离散 <公开 静态 类型 = Skia路径效果 注释 = "静态; 手绘抖动效果; 随机种子传 0 表示随机。">
    参数 段长 <类型 = 小数>
    参数 偏移幅度 <类型 = 小数>
    参数 随机种子 <类型 = 整数 @默认值 = 0>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_path_effect_create_discrete((float)@<段长>, (float)@<偏移幅度>, (uint32_t)@<随机种子>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_圆角 <公开 静态 类型 = Skia路径效果 注释 = "静态; 把尖角磨圆(仅描边有效)。">
    参数 半径 <类型 = 小数>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_path_effect_create_corner((float)@<半径>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_一维路径 <公开 静态 类型 = Skia路径效果 注释 = "静态; 沿路径盖章; 样式 0 平移/1 旋转/2 形变。">
    参数 印章路径 <类型 = Skia路径>
    参数 间距 <类型 = 小数>
    参数 初相 <类型 = 小数>
    参数 样式 <类型 = 整数 @默认值 = 0>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 路径句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        路径句柄 = 印章路径.对象指针
        @ @<新指针> = (intptr_t)sk_path_effect_create_1d_path((const sk_path_t*)@<路径句柄>, (float)@<间距>, (float)@<初相>, (sk_path_effect_1d_style_t)@<样式>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_二维线 <公开 静态 类型 = Skia路径效果 注释 = "静态; 用线纹填充, 画笔须为描边。">
