# 六、路径遍历器族
# ============================================================

类 Skia路径遍历器 <公开 注释 = "路径遍历器(sk_path_iterator_t): 逐个读取图元; 生存期内源路径不可释放。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径遍历器.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia路径遍历器 注释 = "由路径创建遍历器; 强制闭合为真时把开放轮廓自动收尾。">
    参数 路径 <类型 = Skia路径>
    参数 强制闭合 <类型 = 逻辑型 @默认值 = 假>
    {
        变量 结果 <类型 = Skia路径遍历器>
        变量 路径句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        路径句柄 = 路径.对象指针
        @ @<新指针> = (intptr_t)sk_path_create_iter((sk_path_t*)@<路径句柄>, (int)@<强制闭合>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁遍历器; 可与 新建 成对调用, 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_path_iter_destroy((sk_path_iterator_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径遍历器.对象指针> != 0)
    }

    方法 取下一图元 <公开 类型 = 整数 注释 = "前进并取下一个图元; 结果数据 需 32 字节(4 个点); 返回 0 移动/1 直线/2 二次/3 圆锥/4 三次/5 闭合/6 结束。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_path_iter_next((sk_path_iterator_t*)@<句柄>, (sk_point_t*)@<结果数据>.GetPtr()));
        返回 (结果)
    }

    方法 取圆锥权重 <公开 类型 = 小数 注释 = "上一图元为圆锥(3)时有效。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_path_iter_conic_weight((sk_path_iterator_t*)@sn<this>.@n<Skia路径遍历器.对象指针>))
    }

    方法 线段是否闭合 <公开 类型 = 逻辑型 注释 = "上一图元是否直接闭合。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_path_iter_is_close_line((sk_path_iterator_t*)@sn<this>.@n<Skia路径遍历器.对象指针>) != 0)
    }

    方法 轮廓是否闭合 <公开 类型 = 逻辑型 注释 = "当前子路径是否闭合。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_path_iter_is_closed_contour((sk_path_iterator_t*)@sn<this>.@n<Skia路径遍历器.对象指针>) != 0)
    }
}

类 Skia路径原始遍历器 <公开 注释 = "路径原始遍历器(sk_path_rawiterator_t): 不做隐式闭合与几何规范化; 生存期内源路径不可释放。">
