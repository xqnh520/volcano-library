# ============================================================
# 七、路径布尔运算
# ============================================================

类 Skia路径运算 <公开 注释 = "路径布尔运算(全静态)。运算方式 0 差集(甲-乙)/1 交集/2 并集/3 异或/4 反向差集(乙-甲)。">
{
    方法 运算 <公开 静态 类型 = 逻辑型 注释 = "静态; 对 甲路径 与 乙路径 做布尔运算, 结果写入 结果路径(已存在的路径对象)。">
    参数 甲路径 <类型 = Skia路径>
    参数 乙路径 <类型 = Skia路径>
    参数 运算方式 <类型 = 整数>
    参数 结果路径 <类型 = Skia路径>
    {
        变量 甲句柄 <类型 = 变整数>
        变量 乙句柄 <类型 = 变整数>
        变量 结果句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        甲句柄 = 甲路径.对象指针
        乙句柄 = 乙路径.对象指针
        结果句柄 = 结果路径.对象指针
        @ @<结果> = (sk_pathop_op((const sk_path_t*)@<甲句柄>, (const sk_path_t*)@<乙句柄>, (sk_pathop_t)@<运算方式>, (sk_path_t*)@<结果句柄>) != 0);
        返回 (结果)
    }

    方法 简化 <公开 静态 类型 = 逻辑型 注释 = "静态; 去掉自交、合并重叠子路径, 结果写入 结果路径。">
    参数 路径 <类型 = Skia路径>
    参数 结果路径 <类型 = Skia路径>
    {
        变量 路径句柄 <类型 = 变整数>
        变量 结果句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        路径句柄 = 路径.对象指针
        结果句柄 = 结果路径.对象指针
        @ @<结果> = (sk_pathop_simplify((const sk_path_t*)@<路径句柄>, (sk_path_t*)@<结果句柄>) != 0);
        返回 (结果)
    }

    方法 取精确边界 <公开 静态 类型 = 逻辑型 注释 = "静态; 取真实几何边界写入 结果矩形(与 Skia路径.取精确边界 等价)。">
    参数 路径 <类型 = Skia路径>
    参数 结果矩形 <类型 = Skia矩形>
    {
        变量 路径句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        路径句柄 = 路径.对象指针
        @ @<结果> = (sk_pathop_tight_bounds((const sk_path_t*)@<路径句柄>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 转环绕填充 <公开 静态 类型 = 逻辑型 注释 = "静态; 把奇偶填充结果固化成环绕填充, 结果写入 结果路径。">
    参数 路径 <类型 = Skia路径>
    参数 结果路径 <类型 = Skia路径>
    {
        变量 路径句柄 <类型 = 变整数>
        变量 结果句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        路径句柄 = 路径.对象指针
        结果句柄 = 结果路径.对象指针
        @ @<结果> = (sk_pathop_as_winding((const sk_path_t*)@<路径句柄>, (sk_path_t*)@<结果句柄>) != 0);
        返回 (结果)
    }
}

类 Skia路径运算构建器 <公开 注释 = "路径布尔运算构建器(sk_opbuilder_t): 连续多次布尔运算后一次解析。运算方式 0 差/1 交/2 并/3 异或/4 反向差。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径运算构建器.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia路径运算构建器 注释 = "创建运算构建器。">
    {
        变量 结果 <类型 = Skia路径运算构建器>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_opbuilder_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁构建器; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_opbuilder_destroy((sk_opbuilder_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径运算构建器.对象指针> != 0)
    }

    方法 追加路径 <公开 类型 = 逻辑型 注释 = "把一个路径与指定运算方式入栈。">
    参数 路径 <类型 = Skia路径>
    参数 运算方式 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        句柄 = 对象指针
        路径句柄 = 路径.对象指针
        @ sk_opbuilder_add((sk_opbuilder_t*)@<句柄>, (const sk_path_t*)@<路径句柄>, (sk_pathop_t)@<运算方式>);
        返回 (真)
    }

    方法 解析到 <公开 类型 = 逻辑型 注释 = "按入栈顺序两两求值, 结果写入 结果路径。">
    参数 结果路径 <类型 = Skia路径>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        结果句柄 = 结果路径.对象指针
        @ @<结果> = (sk_opbuilder_resolve((sk_opbuilder_t*)@<句柄>, (sk_path_t*)@<结果句柄>) != 0);
        返回 (结果)
    }
}

# ============================================================
# 八、派生画布(不继承 Skia画布, 各自独立持有句柄)
# ============================================================

类 Skia无绘制画布 <公开 注释 = "无绘制画布(sk_nodraw_canvas_t): 只做几何统计与快速剔除, 不产生像素。">
