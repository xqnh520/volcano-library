    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_path_effect_create_2d_line((float)@<线宽>, (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_二维路径 <公开 静态 类型 = Skia路径效果 注释 = "静态; 用图案平铺填充, 画笔须为描边。">
    参数 矩阵 <类型 = Skia矩阵>
    参数 图案路径 <类型 = Skia路径>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 路径句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        路径句柄 = 图案路径.对象指针
        @ @<新指针> = (intptr_t)sk_path_effect_create_2d_path((const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr(), (const sk_path_t*)@<路径句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_虚线 <公开 静态 类型 = Skia路径效果 注释 = "静态; 间隔数据为单精度数组(4 字节/个), 顺序 [实,虚,实,虚…]; 初相为起始偏移。">
    参数 间隔数据 <类型 = 字节集类>
    参数 间隔数量 <类型 = 整数>
    参数 初相 <类型 = 小数 @默认值 = 0>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_path_effect_create_dash((const float*)@<间隔数据>.GetPtr(), @<间隔数量>, (float)@<初相>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_裁剪 <公开 静态 类型 = Skia路径效果 注释 = "静态; 比例取 0~1; 裁剪方式 0 普通/1 反转/2 允许倒序。">
    参数 起点比例 <类型 = 小数>
    参数 终点比例 <类型 = 小数>
    参数 裁剪方式 <类型 = 整数 @默认值 = 0>
    {
        变量 结果 <类型 = Skia路径效果>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_path_effect_create_trim((float)@<起点比例>, (float)@<终点比例>, (sk_path_effect_trim_mode_t)@<裁剪方式>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
