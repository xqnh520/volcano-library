# ============================================================
# 五、路径测量
# ============================================================

类 Skia路径测量 <公开 注释 = "路径测量(sk_pathmeasure_t): 求路径长、按距离取位置/切线/矩阵、截取片段。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径测量.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia路径测量 注释 = "创建不含路径的测量器, 需再调 置路径。">
    {
        变量 结果 <类型 = Skia路径测量>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_pathmeasure_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按路径 <公开 静态 类型 = Skia路径测量 注释 = "由路径创建测量器; 精度为曲线细分比例, 1.0 为默认, 越大越准越慢。">
    参数 路径 <类型 = Skia路径>
    参数 强制闭合 <类型 = 逻辑型 @默认值 = 假>
    参数 精度 <类型 = 小数 @默认值 = 1.0>
    {
        变量 结果 <类型 = Skia路径测量>
        变量 路径句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        路径句柄 = 路径.对象指针
        @ @<新指针> = (intptr_t)sk_pathmeasure_new_with_path((const sk_path_t*)@<路径句柄>, (bool)@<强制闭合>, (float)@<精度>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_pathmeasure_destroy((sk_pathmeasure_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia路径测量.对象指针> != 0)
    }

    方法 置路径 <公开 类型 = 逻辑型 注释 = "替换被测量的路径。">
    参数 路径 <类型 = Skia路径>
    参数 强制闭合 <类型 = 逻辑型 @默认值 = 假>
    {
        变量 句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        句柄 = 对象指针
        路径句柄 = 路径.对象指针
        @ sk_pathmeasure_set_path((sk_pathmeasure_t*)@<句柄>, (const sk_path_t*)@<路径句柄>, (bool)@<强制闭合>);
        返回 (真)
    }

    方法 取路径长 <公开 类型 = 小数 注释 = "当前轮廓长度(像素)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_pathmeasure_get_length((sk_pathmeasure_t*)@sn<this>.@n<Skia路径测量.对象指针>))
    }

    方法 取位置与切线 <公开 类型 = 逻辑型 注释 = "按距离取位置与切线; 切线未归一化, 越界返回假。">
    参数 距离 <类型 = 小数>
    参数 结果位置 <类型 = Skia点>
    参数 结果切线 <类型 = Skia点>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_pathmeasure_get_pos_tan((sk_pathmeasure_t*)@<句柄>, (float)@<距离>, (sk_point_t*)@<结果位置>.@n<Skia点.数据>.GetPtr(), (sk_vector_t*)@<结果切线>.@n<Skia点.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取矩阵_按距离 <公开 类型 = 逻辑型 注释 = "按距离取变换矩阵; 标志 1 只取位置/2 只取切线/3 两者都取。">
    参数 距离 <类型 = 小数>
    参数 结果矩阵 <类型 = Skia矩阵>
    参数 标志 <类型 = 整数 @默认值 = 3>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_pathmeasure_get_matrix((sk_pathmeasure_t*)@<句柄>, (float)@<距离>, (sk_matrix_t*)@<结果矩阵>.@n<Skia矩阵.数据>.GetPtr(), (sk_pathmeasure_matrixflags_t)@<标志>) != 0);
        返回 (结果)
    }

    方法 取片段 <公开 类型 = 逻辑型 注释 = "截取 起点距离~终点距离 的子路径写入 目标构建器, 常用于描线动画。">
    参数 起点距离 <类型 = 小数>
    参数 终点距离 <类型 = 小数>
    参数 目标构建器 <类型 = Skia路径构建器>
    参数 是否先移动 <类型 = 逻辑型 @默认值 = 真>
    {
        变量 句柄 <类型 = 变整数>
        变量 构建器句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        构建器句柄 = 目标构建器.对象指针
        @ @<结果> = (sk_pathmeasure_get_segment((sk_pathmeasure_t*)@<句柄>, (float)@<起点距离>, (float)@<终点距离>, (sk_pathbuilder_t*)@<构建器句柄>, (bool)@<是否先移动>) != 0);
        返回 (结果)
    }

    方法 是否闭合 <公开 类型 = 逻辑型 注释 = "当前轮廓是否闭合。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_pathmeasure_is_closed((sk_pathmeasure_t*)@sn<this>.@n<Skia路径测量.对象指针>) != 0)
    }

    方法 下一轮廓 <公开 类型 = 逻辑型 注释 = "移动到下一子路径; 无更多轮廓返回假。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_pathmeasure_next_contour((sk_pathmeasure_t*)@sn<this>.@n<Skia路径测量.对象指针>) != 0)
    }
}

