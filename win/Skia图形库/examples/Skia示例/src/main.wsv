<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序 <注释 = "Skia 封装示例: 全局版本信息 / 值类读回 / 画笔属性 / 路径构建 / 几何类, 结果按步骤追加写入 examples/result.txt。">

类 启动类 <公开 基础类 = 窗口程序类 注释 = "Skia 封装示例程序。">
{
    变量 主窗口对象 <类型 = Skia示例窗口 标题 = "Skia 封装示例">

    方法 启动方法 <公开 类型 = 整数>
    {
        主窗口对象.创建主窗口 ()
        返回 (1)
    }
}

# ================

类 Skia示例窗口 <基础类 = 窗口 @视窗.布局 = "client_size = \"900, 620\"" 标题 = "Skia 封装示例">
{
    变量 结果框 <类型 = 编辑框 隐藏值属性 = "0" @视窗.布局 = "id = 101\r\npos = \"12, 12, 876, 596\"" 是否允许多行 = 真 滚动条 = 横向及纵向滚动条>

    方法 存报告 <公开 类型 = 逻辑型 注释 = "把一行报告追加到 examples/result.txt(读旧内容 + 拼接 + 写回), 保证每一步都留在文件里。">
    参数 行 <类型 = 文本型>
    {
        变量 旧内容 <类型 = 文本型>
        变量 全部内容 <类型 = 文本型>
        旧内容 = UTF8到文本 (读入文件 ("E:/AI开发/Skia工具/examples/result.txt"))
        如果 (旧内容 == "")
        {
            全部内容 = 行
        }
        否则
        {
            全部内容 = 旧内容 + 行
        }
        写到文件 ("E:/AI开发/Skia工具/examples/result.txt", 文本到UTF8 (全部内容, ))
        返回 (真)
    }

    方法 Skia示例窗口_创建完毕 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = Skia示例窗口>
    参数 标记值 <类型 = 整数>
    {
        变量 报告 <类型 = 文本型>
        变量 行 <类型 = 文本型>
        变量 主版本 <类型 = 整数>
        变量 次版本 <类型 = 整数>
        变量 矩形 <类型 = Skia矩形>
        变量 浮点色 <类型 = Skia浮点颜色>
        变量 整数色 <类型 = 整数>
        变量 画笔 <类型 = Skia画笔>
        变量 构建器 <类型 = Skia路径构建器>
        变量 快照 <类型 = Skia路径>
        变量 结果路径 <类型 = Skia路径>
        变量 边界 <类型 = Skia矩形>
        变量 点数 <类型 = 整数>
        写到文件 ("E:/AI开发/Skia工具/examples/result.txt", 文本到UTF8 ("", ))
        Skia全局.初始化 ()
        行 = "[1] Skia全局.取版本文本 () = " + Skia全局.取版本文本 () + "\r\n"
        报告 = 报告 + 行
        存报告 (行)
        主版本 = Skia全局.取主版本号 ()
        次版本 = Skia全局.取次版本号 ()
        行 = "[2] Skia全局.取主版本号 () = " + 到文本 (主版本) + ", 取次版本号 () = " + 到文本 (次版本) + ", 取字体缓存条目数 () = " + 到文本 (Skia全局.取字体缓存条目数 ()) + "\r\n"
        报告 = 报告 + 行
        存报告 (行)
        矩形.置边界 (1.5, 2.5, 30.25, 40.75)
        行 = "[3] Skia矩形.置边界 (1.5, 2.5, 30.25, 40.75) 后读回: 左 = " + 到文本 (矩形.左) + ", 上 = " + 到文本 (矩形.上) + ", 右 = " + 到文本 (矩形.右) + ", 下 = " + 到文本 (矩形.下) + "\r\n"
        报告 = 报告 + 行
        存报告 (行)
        浮点色.置颜色 (0.2, 0.4, 0.8, 1.0)
        整数色 = Skia颜色.浮点色转整数色 (浮点色)
        行 = "[4] Skia颜色.浮点色转整数色 (0.2, 0.4, 0.8, 1.0) = " + 到文本 (整数色) + " (位模式 0xFF3366CC)\r\n"
        报告 = 报告 + 行
        存报告 (行)
        画笔 = Skia画笔.新建 ()
        如果 (画笔.是否有效 ())
        {
            画笔.置颜色 (整数色)
            画笔.置线宽 (3.5)
            行 = "[5] Skia画笔.新建 () 取得有效句柄; 置颜色 + 置线宽 (3.5) 后 取颜色 = " + 到文本 (画笔.取颜色 ()) + " (与 [4] 相同即正确), 取线宽 = " + 到文本 (画笔.取线宽 ()) + "\r\n"
            报告 = 报告 + 行
            存报告 (行)
            画笔.释放 ()
            如果 (画笔.是否有效 ())
            {
                行 = "[6] Skia画笔.释放 () 后 是否有效 = 真 [异常]\r\n"
            }
            否则
            {
                行 = "[6] Skia画笔.释放 () 后 是否有效 = 假 [正确]\r\n"
            }
        }
        否则
        {
            行 = "[5] Skia画笔.新建 () = 无效句柄 [失败]\r\n"
        }
        报告 = 报告 + 行
        存报告 (行)
        构建器 = Skia路径构建器.新建 ()
        构建器.移动到 (0.0, 0.0)
        构建器.直线到 (100.0, 50.0)
        快照 = 构建器.快照路径 ()
        点数 = 快照.取点数 ()
        行 = "[7] 构建器 移动到 (0,0) + 直线到 (100,50) 后 快照路径.取点数 () = " + 到文本 (点数) + " (应为 2)\r\n"
        报告 = 报告 + 行
        存报告 (行)
        快照.释放 ()
        构建器.追加矩形 (矩形, 0)
        结果路径 = 构建器.取出路径 ()
        点数 = 结果路径.取点数 ()
        行 = "[8] 再 追加矩形 + 取出路径 后 取点数 () = " + 到文本 (点数) + " (应为 6), 取图元数 () = " + 到文本 (结果路径.取图元数 ()) + "\r\n"
        报告 = 报告 + 行
        存报告 (行)
        结果路径.取边界 (边界)
        行 = "[9] 取出路径.取边界 () 读回: 左 = " + 到文本 (边界.左) + ", 上 = " + 到文本 (边界.上) + ", 右 = " + 到文本 (边界.右) + ", 下 = " + 到文本 (边界.下) + "\r\n"
        报告 = 报告 + 行
        存报告 (行)
        如果 (结果路径.是否凸 ())
        {
            行 = "[10] 取出路径.是否凸 () = 真\r\n"
        }
        否则
        {
            行 = "[10] 取出路径.是否凸 () = 假\r\n"
        }
        报告 = 报告 + 行
        存报告 (行)
        结果路径.释放 ()
        构建器.释放 ()
        行 = 路径释放测试 ()
        报告 = 报告 + 行
        存报告 (行)
        行 = 值类补充测试 (整数色)
        报告 = 报告 + 行
        存报告 (行)
        行 = 几何类测试 ()
        报告 = 报告 + 行
        存报告 (行)
        行 = 像素自检 ()
        报告 = 报告 + 行
        存报告 (行)
        行 = 批次3测试 ()
        报告 = 报告 + 行
        存报告 (行)
        行 = 批次3效果测试 ()
        报告 = 报告 + 行
        存报告 (行)
        行 = 批次4文字测试 ()
        报告 = 报告 + 行
        存报告 (行)
        行 = "[44] 全部调用完成, 未崩溃。\r\n"
        报告 = 报告 + 行
        存报告 (行)
        结果框.内容 = 报告
        返回 (0)
    }

    方法 路径释放测试 <公开 类型 = 文本型 注释 = "空路径的新建/取点数/释放三连, 返回一行报告。">
    {
        变量 空路径 <类型 = Skia路径>
        变量 点数 <类型 = 整数>
        空路径 = Skia路径.新建 ()
        点数 = 空路径.取点数 ()
        空路径.释放 ()
        返回 ("[11] Skia路径.新建 () 后 取点数 () = " + 到文本 (点数) + " (空路径应为 0), 已释放\r\n")
    }

    方法 值类补充测试 <公开 类型 = 文本型 注释 = "其余值类(点/尺寸/矩阵/矩阵44/浮点颜色/整数矩形)的读写回读。">
    参数 整数色 <类型 = 整数>
    {
        变量 点 <类型 = Skia点>
        变量 尺寸 <类型 = Skia尺寸>
        变量 矩阵 <类型 = Skia矩阵>
        变量 矩阵44 <类型 = Skia矩阵44>
        变量 浮点色 <类型 = Skia浮点颜色>
        变量 整数矩形 <类型 = Skia整数矩形>
        变量 逆矩阵 <类型 = Skia矩阵>
        变量 行 <类型 = 文本型>
        点.置坐标 (12.5, 34.75)
        尺寸.置尺寸 (640.0, 480.0)
        矩阵.置缩放平移 (2.0, 3.0, 100.0, 200.0)
        矩阵44.置元素 (1, 2, 9.5)
        浮点色 = Skia颜色.整数色转浮点色 (整数色)
        整数矩形.置边界 (1, 2, 30, 40)
        行 = "[12] Skia点 置坐标 后: 横坐标 = " + 到文本 (点.横坐标) + ", 纵坐标 = " + 到文本 (点.纵坐标) + "\r\n"
        行 = 行 + "[13] Skia尺寸 置尺寸 后: 宽 = " + 到文本 (尺寸.宽) + ", 高 = " + 到文本 (尺寸.高) + "\r\n"
        行 = 行 + "[14] Skia矩阵 置缩放平移 (2,3,100,200) 后: 缩放X = " + 到文本 (矩阵.缩放X) + ", 缩放Y = " + 到文本 (矩阵.缩放Y) + ", 平移X = " + 到文本 (矩阵.平移X) + ", 平移Y = " + 到文本 (矩阵.平移Y) + ", 透视2 = " + 到文本 (矩阵.透视2) + "\r\n"
        行 = 行 + "[15] Skia矩阵44 置元素 (1,2,9.5) 取元素 = " + 到文本 (矩阵44.取元素 (1, 2)) + ", 单位阵 取元素 (0,0) = " + 到文本 (矩阵44.取元素 (0, 0)) + ", 取元素 (1,1) = " + 到文本 (矩阵44.取元素 (1, 1)) + "\r\n"
        行 = 行 + "[16] Skia颜色.整数色转浮点色 (" + 到文本 (整数色) + ") 后: 红 = " + 到文本 (浮点色.红) + ", 绿 = " + 到文本 (浮点色.绿) + ", 蓝 = " + 到文本 (浮点色.蓝) + ", 透明度 = " + 到文本 (浮点色.透明度) + "\r\n"
        行 = 行 + "[17] Skia整数矩形 置边界 (1,2,30,40) 后: 左 = " + 到文本 (整数矩形.左) + ", 上 = " + 到文本 (整数矩形.上) + ", 右 = " + 到文本 (整数矩形.右) + ", 下 = " + 到文本 (整数矩形.下) + "\r\n"
        如果 (矩阵.尝试求逆 (逆矩阵))
        {
            行 = 行 + "[18] Skia矩阵 尝试求逆 成功: 逆矩阵 缩放X = " + 到文本 (逆矩阵.缩放X) + ", 平移X = " + 到文本 (逆矩阵.平移X) + "\r\n"
        }
        否则
        {
            行 = 行 + "[18] Skia矩阵 尝试求逆 = 假 [异常]\r\n"
        }
        矩阵.映射坐标 (1.0, 1.0, 点)
        行 = 行 + "[19] Skia矩阵.映射坐标 (1,1) 后 结果点: 横坐标 = " + 到文本 (点.横坐标) + ", 纵坐标 = " + 到文本 (点.纵坐标) + "\r\n"
        返回 (行)
    }

    方法 几何类测试 <公开 类型 = 文本型 注释 = "批次1 第二批(几何类)的读写回读: 圆角矩形 / 区域 / 路径运算 / 遍历器 / 路径效果 / 路径测量。">
    {
        变量 圆角矩形 <类型 = Skia圆角矩形>
        变量 区域 <类型 = Skia区域>
        变量 区域边界 <类型 = Skia整数矩形>
        变量 遍历器 <类型 = Skia区域遍历器>
        变量 块矩形 <类型 = Skia整数矩形>
        变量 块数 <类型 = 整数>
        变量 索引 <类型 = 整数>
        变量 甲路径 <类型 = Skia路径>
        变量 乙路径 <类型 = Skia路径>
        变量 运算结果 <类型 = Skia路径>
        变量 构建器甲 <类型 = Skia路径构建器>
        变量 构建器乙 <类型 = Skia路径构建器>
        变量 测量器 <类型 = Skia路径测量>
        变量 效果 <类型 = Skia路径效果>
        变量 间隔数据 <类型 = 字节集类>
        变量 测试矩形 <类型 = Skia矩形>
        变量 行 <类型 = 文本型>
        测试矩形.置边界 (0.0, 0.0, 200.0, 100.0)
        圆角矩形 = Skia圆角矩形.新建 ()
        圆角矩形.置矩形与半径 (测试矩形, 8.0, 8.0)
        行 = "[20] Skia圆角矩形 置矩形与半径 (0,0,200,100 / 8,8) 后: 取类型 = " + 到文本 (圆角矩形.取类型 ()) + ", 取宽 = " + 到文本 (圆角矩形.取宽) + ", 取高 = " + 到文本 (圆角矩形.取高) + ", 是否有效 = " + 逻辑到文本 (圆角矩形.是否有效 ()) + "\r\n"
        区域 = Skia区域.新建 ()
        区域边界.置边界 (0, 0, 100, 100)
        区域.置矩形 (区域边界)
        区域.取边界 (块矩形)
        遍历器 = Skia区域遍历器.新建 (区域)
        块数 = 0
        循环 (0, 64, 索引)
        {
            如果 (遍历器.遍历结束 () == 假)
            {
                块数 = 块数 + 1
                遍历器.下一块 ()
            }
        }
        行 = 行 + "[21] Skia区域 置矩形 (0,0,100,100) 后: 是否为空 = " + 逻辑到文本 (区域.是否为空 ()) + ", 是否为矩形 = " + 逻辑到文本 (区域.是否为矩形 ()) + ", 边界 = (" + 到文本 (块矩形.左) + "," + 到文本 (块矩形.上) + "," + 到文本 (块矩形.右) + "," + 到文本 (块矩形.下) + "), 遍历块数 = " + 到文本 (块数) + "\r\n"
        遍历器.释放 ()
        区域.释放 ()
        构建器甲 = Skia路径构建器.新建 ()
        构建器甲.追加矩形 (测试矩形, 0)
        甲路径 = 构建器甲.取出路径 ()
        构建器乙 = Skia路径构建器.新建 ()
        构建器乙.追加圆 (100.0, 50.0, 30.0, 0)
        乙路径 = 构建器乙.取出路径 ()
        运算结果 = Skia路径.新建 ()
        如果 (Skia路径运算.运算 (甲路径, 乙路径, 1, 运算结果))
        {
            测量器 = Skia路径测量.新建_按路径 (运算结果, 假, 1.0)
            行 = 行 + "[22] 路径运算.运算 (矩形 交 圆, 方式 1) 成功: 交集点数 = " + 到文本 (运算结果.取点数 ()) + ", 路径长 = " + 到文本 (测量器.取路径长 ()) + "\r\n"
            测量器.释放 ()
        }
        否则
        {
            行 = 行 + "[22] 路径运算.运算 (方式 1) = 假 [异常]\r\n"
        }
        间隔数据 = 取空白字节集 (8)
        @ ((float*)@<间隔数据>.GetPtr())[0] = 10.0f;
        @ ((float*)@<间隔数据>.GetPtr())[1] = 5.0f;
        效果 = Skia路径效果.新建_虚线 (间隔数据, 2, 0.0)
        行 = 行 + "[23] Skia路径效果.新建_虚线 (10,5) 后 是否有效 = " + 逻辑到文本 (效果.是否有效 ()) + ", 已释放\r\n"
        效果.释放 ()
        运算结果.释放 ()
        甲路径.释放 ()
        乙路径.释放 ()
        构建器甲.释放 ()
        构建器乙.释放 ()
        圆角矩形.释放 ()
        返回 (行)
    }

    方法 像素自检 <公开 类型 = 文本型 注释 = "像素级自检: 64x64 外部缓冲 + 新建_按像素 + 清空纯蓝, 再从缓冲直接读回 4 个像素值。">
    {
        变量 缓冲 <类型 = 字节集类>
        变量 图像信息 <类型 = Skia图像信息>
        变量 无表面属性 <类型 = Skia表面属性>
        变量 画布 <类型 = Skia画布>
        变量 像素地址 <类型 = 变整数>
        变量 行字节 <类型 = 整数>
        变量 像素 <类型 = 整数>
        变量 行 <类型 = 文本型>
        缓冲 = 取空白字节集 (16384)
        图像信息 = Skia图像信息.新建 (64, 64)
        行字节 = 图像信息.宽 * 4
        @ @<像素地址> = (intptr_t)@<缓冲>.GetPtr();
        行 = "[24] Skia图像信息.新建 (64,64) 后: 宽 = " + 到文本 (图像信息.宽) + ", 高 = " + 到文本 (图像信息.高) + ", 颜色类型 = " + 到文本 (图像信息.颜色类型) + ", 透明度类型 = " + 到文本 (图像信息.透明度类型) + ", 颜色空间 = " + 到文本 (图像信息.颜色空间) + ", 行字节数 = " + 到文本 (图像信息.行字节数) + "\r\n"
        画布 = Skia画布.新建_按像素 (图像信息, 像素地址, 行字节, 无表面属性)
        如果 (画布.是否有效 ())
        {
            画布.清空 (-16776961)
            画布.释放 ()
            像素 = 取字节集数据 (缓冲, 0, 整数)
            行 = 行 + "[25] 像素自检 (64x64 清空 0xFF0000FF 后从缓冲读回): (0,0) = " + 到文本 (像素)
            像素 = 取字节集数据 (缓冲, 63 * 4, 整数)
            行 = 行 + ", (63,0) = " + 到文本 (像素)
            像素 = 取字节集数据 (缓冲, 63 * 256, 整数)
            行 = 行 + ", (0,63) = " + 到文本 (像素)
            像素 = 取字节集数据 (缓冲, (32 * 64 + 32) * 4, 整数)
            行 = 行 + ", (32,32) = " + 到文本 (像素) + " (期望均为 -16776961 = 0xFF0000FF)\r\n"
        }
        否则
        {
            行 = 行 + "[25] Skia画布.新建_按像素 = 无效句柄 [失败]\r\n"
        }
        返回 (行)
    }

    方法 批次3测试 <公开 类型 = 文本型 注释 = "批次3(颜色空间/文档域)运行时读回 + 值类字节数实测。">
    {
        变量 传递函数 <类型 = Skia传递函数>
        变量 色度矩阵 <类型 = Skia色度矩阵>
        变量 色度坐标 <类型 = Skia色度坐标>
        变量 元数据 <类型 = Skia文档元数据>
        变量 文档时间 <类型 = Skia文档时间>
        变量 XPS选项 <类型 = SkiaXPS选项>
        变量 颜色空间 <类型 = Skia颜色空间>
        变量 线性空间 <类型 = Skia颜色空间>
        变量 矩阵乙 <类型 = Skia色度矩阵>
        变量 写流 <类型 = Skia动态内存写流>
        变量 文档 <类型 = Skia文档>
        变量 页面画布 <类型 = Skia画布>
        变量 内容矩形 <类型 = Skia矩形>
        变量 画笔甲 <类型 = Skia画笔>
        变量 数据 <类型 = Skia数据>
        变量 行 <类型 = 文本型>
        传递函数 = Skia传递函数.新建_sRGB ()
        色度矩阵 = Skia色度矩阵.新建_sRGB ()
        色度坐标.置sRGB ()
        文档时间.置时间 (480, 2025, 10, 5, 30, 14, 22, 8)
        XPS选项.置选项 (300.0, 假)
        行 = "[26] 值类字节数实测: 传递函数 = " + 到文本 (取字节集长度 (传递函数.数据)) + ", 色度矩阵 = " + 到文本 (取字节集长度 (色度矩阵.数据)) + ", 色度坐标 = " + 到文本 (取字节集长度 (色度坐标.数据)) + ", 文档元数据 = " + 到文本 (取字节集长度 (元数据.数据)) + ", 文档时间 = " + 到文本 (取字节集长度 (文档时间.数据)) + ", XPS选项 = " + 到文本 (取字节集长度 (XPS选项.数据)) + "\r\n"
        行 = 行 + "[27] Skia传递函数.新建_sRGB 求值 (0.5) = " + 到文本 (传递函数.求值 (0.5)) + "; 色度矩阵 取元素 (0,0) = " + 到文本 (色度矩阵.取元素 (0, 0)) + "; 色度坐标 转色度矩阵 = " + 逻辑到文本 (色度坐标.转色度矩阵 (矩阵乙)) + " 其取元素 (0,0) = " + 到文本 (矩阵乙.取元素 (0, 0)) + "\r\n"
        颜色空间 = Skia颜色空间.新建_sRGB ()
        线性空间 = Skia颜色空间.新建_线性sRGB ()
        行 = 行 + "[28] Skia颜色空间.新建_sRGB 是否有效 = " + 逻辑到文本 (颜色空间.是否有效 ()) + ", 是否sRGB = " + 逻辑到文本 (颜色空间.是否sRGB ()) + ", 传递是否接近sRGB = " + 逻辑到文本 (颜色空间.传递是否接近sRGB ()) + ", 传递是否线性 = " + 逻辑到文本 (颜色空间.传递是否线性 ()) + "; 新建_线性sRGB 传递是否线性 = " + 逻辑到文本 (线性空间.传递是否线性 ()) + ", 两者 是否相同 = " + 逻辑到文本 (颜色空间.是否相同 (线性空间)) + "\r\n"
        写流 = Skia动态内存写流.新建 ()
        文档 = Skia文档.新建PDF_按写流 (写流)
        内容矩形.置边界 (0.0, 0.0, 100.0, 100.0)
        如果 (文档.是否有效 ())
        {
            页面画布 = 文档.开始页 (100.0, 100.0, 内容矩形)
            画笔甲 = Skia画笔.新建 ()
            画笔甲.置颜色 (-16776961)
            页面画布.绘制矩形 (内容矩形, 画笔甲)
            画笔甲.释放 ()
            文档.结束页 ()
            文档.关闭 ()
            文档.释放 ()
            数据 = 写流.取出为数据 ()
            行 = 行 + "[29] Skia文档 PDF 输出: 开始页->绘制->结束页->关闭->释放 全部成功, PDF 字节数 = " + 到文本 (数据.取尺寸 ()) + "\r\n"
            数据.释放 ()
        }
        否则
        {
            行 = 行 + "[29] Skia文档.新建PDF_按写流 = 无效句柄 [失败]\r\n"
        }
        写流.关闭 ()
        颜色空间.释放 ()
        线性空间.释放 ()
        行 = 行 + "[30] 颜色空间/写流 已释放, 批次3 颜色空间域与文档域自检完成\r\n"
        返回 (行)
    }

    方法 批次3效果测试 <公开 类型 = 文本型 注释 = "批次3 效果域: 渐变着色器、反色滤镜实绘像素、值类字节数实测。">
    {
        变量 矩阵数据 <类型 = 字节集类>
        变量 颜色滤镜 <类型 = Skia颜色滤镜>
        变量 变量信息 <类型 = Skia效果变量>
        变量 子项信息 <类型 = Skia效果子项>
        变量 点三 <类型 = Skia点3>
        变量 对比度配置 <类型 = Skia高对比度配置>
        变量 变量缓冲 <类型 = 字节集类>
        变量 画布缓冲 <类型 = 字节集类>
        变量 画布 <类型 = Skia画布>
        变量 像素地址 <类型 = 变整数>
        变量 图像信息 <类型 = Skia图像信息>
        变量 无表面属性 <类型 = Skia表面属性>
        变量 画笔 <类型 = Skia画笔>
        变量 矩阵单位 <类型 = Skia矩阵>
        变量 矩形 <类型 = Skia矩形>
        变量 颜色数据 <类型 = 字节集类>
        变量 位置数据 <类型 = 字节集类>
        变量 起点 <类型 = Skia点>
        变量 终点 <类型 = Skia点>
        变量 渐变 <类型 = Skia着色器>
        变量 模糊滤镜 <类型 = Skia图像滤镜>
        变量 空输入滤镜 <类型 = Skia图像滤镜>
        变量 绘制画笔 <类型 = Skia画笔>
        变量 像素 <类型 = 整数>
        变量 行 <类型 = 文本型>
        点三.置坐标 (0.0, 0.0, 1.0)
        对比度配置.置配置 (假, 0, 0.5)
        行 = "[31] 效果域值类字节数实测: 效果变量 = " + 到文本 (取字节集长度 (变量信息.数据)) + ", 效果子项 = " + 到文本 (取字节集长度 (子项信息.数据)) + ", 点3 = " + 到文本 (取字节集长度 (点三.数据)) + ", 高对比度配置 = " + 到文本 (取字节集长度 (对比度配置.数据)) + "\r\n"
        起点.置坐标 (0.0, 0.0)
        终点.置坐标 (100.0, 0.0)
        颜色数据 = 取空白字节集 (8)
        @ ((int*)@<颜色数据>.GetPtr())[0] = -65536;
        @ ((int*)@<颜色数据>.GetPtr())[1] = -16776961;
        位置数据 = 取空白字节集 (8)
        置字节集单精度小数 (位置数据, 0, 0.0)
        置字节集单精度小数 (位置数据, 4, 1.0)
        渐变 = Skia着色器.新建_线性渐变 (起点, 终点, 颜色数据, 位置数据, 2, 0, 矩阵单位)
        行 = 行 + "[32] Skia着色器.新建_线性渐变 (红到蓝, 2 色) 是否有效 = " + 逻辑到文本 (渐变.是否有效 ()) + "\r\n"
        画布缓冲 = 取空白字节集 (256)
        图像信息 = Skia图像信息.新建 (8, 8)
        @ @<像素地址> = (intptr_t)@<画布缓冲>.GetPtr();
        画布 = Skia画布.新建_按像素 (图像信息, 像素地址, 32, 无表面属性)
        如果 (画布.是否有效 ())
        {
            画布.清空 (-1)
            绘制画笔 = Skia画笔.新建 ()
            绘制画笔.置线宽 (1.0)
            绘制画笔.置抗锯齿 (假)
            颜色滤镜 = Skia颜色滤镜.新建_按模式 (-1, 22)
            绘制画笔.置颜色 (-65536)
            矩形.置边界 (2.0, 2.0, 6.0, 6.0)
            画布.绘制矩形 (矩形, 绘制画笔)
            像素 = 读像素 (画布缓冲, 2 * 8 + 2)
            行 = 行 + "[33a] 对照(不挂滤镜): 纯红矩形读回 = " + 到文本 (像素) + " (期望 -65536 = 0xFFFF0000)\r\n"
            绘制画笔.置颜色滤镜 (颜色滤镜.取句柄)
            画布.绘制矩形 (矩形, 绘制画笔)
            像素 = 读像素 (画布缓冲, 2 * 8 + 2)
            行 = 行 + "[33b] 反色颜色滤镜 (新建_按模式 白/差异混合=反色): 纯红矩形读回 = " + 到文本 (像素) + " (期望 -16711681 = 0xFF00FFFF 纯青)\r\n"
            颜色滤镜.释放 ()
            颜色滤镜.释放 ()
            画布缓冲 = 取空白字节集 (200 * 200 * 4)
            图像信息 = Skia图像信息.新建 (200, 200)
            @ @<像素地址> = (intptr_t)@<画布缓冲>.GetPtr();
            画布.释放 ()
            画布 = Skia画布.新建_按像素 (图像信息, 像素地址, 800, 无表面属性)
            画布.清空 (-1)
            模糊滤镜 = Skia图像滤镜.新建_模糊 (30.0, 30.0, 0, 空输入滤镜)
            行 = 行 + "[34] Skia图像滤镜.新建_模糊 (30,30,0, 空输入) 是否有效 = " + 逻辑到文本 (模糊滤镜.是否有效 ()) + "\r\n"
            如果 (模糊滤镜.是否有效 ())
            {
                绘制画笔.置颜色 (-16777216)
                绘制画笔.置颜色滤镜 (0)
                绘制画笔.置图像滤镜 (模糊滤镜.取句柄)
                矩形.置边界 (20.0, 20.0, 180.0, 180.0)
                画布.绘制矩形 (矩形, 绘制画笔)
                像素 = 读像素 (画布缓冲, 100 * 200 + 100)
                行 = 行 + "[35] 挂 新建_模糊(30,30,0,空输入) 后 黑矩形内部 (100,100) 读回 = " + 到文本 (像素) + " (绝不能是 -1 背景白; SQL 明文: 深色即模糊生效)\r\n"
                像素 = 读像素 (画布缓冲, 100 * 200 + 5)
                行 = 行 + "[36] 模糊扩散检查 (5,100) 靠近边界外侧 = " + 到文本 (像素) + " (若为 -1 说明没扩散出去, 与 (100,100) 对比看)\r\n"
                模糊滤镜.释放 ()
            }
            绘制画笔.释放 ()
        }
        否则
        {
            行 = 行 + "[33] 像素画布创建失败\r\n"
        }
        画布.释放 ()
        渐变.释放 ()
        返回 (行)
    }

    方法 读像素 <公开 类型 = 整数 注释 = "按像素序号从缓冲读取 32 位像素值。">
    参数 缓冲 <类型 = 字节集类>
    参数 序号 <类型 = 整数>
    {
        变量 值 <类型 = 整数>
        @ @<值> = (int)((const uint32_t*)@<缓冲>.GetPtr())[@<序号>];
        返回 (值)
    }

    方法 批次4文字测试 <公开 类型 = 文本型 注释 = "批次4: 字体管理 -> 字形 -> 字体 -> 度量 -> 绘制 -> 统计非背景像素。">
    {
        变量 字管理 <类型 = Skia字体管理>
        变量 字形 <类型 = Skia字形>
        变量 绘制字体 <类型 = Skia字体>
        变量 常规样式 <类型 = Skia字体样式>
        变量 度量 <类型 = Skia字体度量>
        变量 宽 <类型 = 小数>
        变量 行高 <类型 = 小数>
        变量 字符号 <类型 = 整数>
        变量 画布缓冲 <类型 = 字节集类>
        变量 画布 <类型 = Skia画布>
        变量 图像信息 <类型 = Skia图像信息>
        变量 无表面属性 <类型 = Skia表面属性>
        变量 像素地址 <类型 = 变整数>
        变量 文字字节 <类型 = 字节集类>
        变量 画笔 <类型 = Skia画笔>
        变量 非背景 <类型 = 整数>
        变量 序号 <类型 = 整数>
        变量 像素 <类型 = 整数>
        变量 行 <类型 = 文本型>
        字管理 = Skia字体管理.取默认 ()
        行 = "[38] 字体管理: 是否有效 = " + 逻辑到文本 (字管理.是否有效 ()) + ", 系统字体族数量 = " + 到文本 (字管理.取字体族数量 ()) + "\r\n"
        常规样式 = Skia字体样式.新建 (400, 5, 0)
        字形 = 字管理.按族名取字形 ("SimHei", 常规样式)
        如果 (字形.是否有效 ())
        {
            绘制字体 = Skia字体.新建_按字形 (字形, 24.0, 1.0, 0.0)
            宽 = 绘制字体.取文字宽度 ("中")
            行高 = 绘制字体.取度量 (度量)
            字符号 = 绘制字体.单字转字形 (20013)
            行 = 行 + "[39] SimHei 字形有效: 字号 = " + 到文本 (绘制字体.取字号 ()) + ", 取文字宽度(中) = " + 到文本 (宽) + ", 取度量行高 = " + 到文本 (行高) + ", 上升 = " + 到文本 (度量.上升) + ", 下降 = " + 到文本 (度量.下降) + ", 单字转字形(中) = " + 到文本 (字符号) + ", 字体度量字节数 = " + 到文本 (取字节集长度 (度量.数据)) + "\r\n"
            画布缓冲 = 取空白字节集 (64 * 64 * 4)
            图像信息 = Skia图像信息.新建 (64, 64)
            @ @<像素地址> = (intptr_t)@<画布缓冲>.GetPtr();
            画布 = Skia画布.新建_按像素 (图像信息, 像素地址, 256, 无表面属性)
            如果 (画布.是否有效 ())
            {
                画布.清空 (-1)
                画笔 = Skia画笔.新建 ()
                画笔.置颜色 (-16777216)
                画笔.置抗锯齿 (真)
                文字字节 = 文本到UTF8 ("中", 假)
                画布.绘制简单文字 (文字字节, 0, 8.0, 44.0, 绘制字体.取句柄, 画笔)
                画布.释放 ()
                非背景 = 0
                循环 (0, 4096, 序号)
                {
                    像素 = 读像素 (画布缓冲, 序号)
                    如果 (像素 != -1)
                    {
                        非背景 = 非背景 + 1
                    }
                }
                行 = 行 + "[40] 在 64x64 画布上 绘制简单文字 (中, 8, 44, 字体.取句柄, 黑画笔) 后: 非背景色像素数 = " + 到文本 (非背景) + " (大于 0 即文字真的画出来了)\r\n"
                画笔.释放 ()
            }
            绘制字体.释放 ()
            字形.释放 ()
            常规样式.释放 ()
        }
        否则
        {
            行 = 行 + "[39] SimHei 字形无效(系统无该字体), 文字链路未验证\r\n"
        }
        字管理.释放 ()
        返回 (行)
    }

    方法 逻辑到文本 <公开 类型 = 文本型 注释 = "把逻辑型转成「真/假」文本。">
    参数 值 <类型 = 逻辑型>
    {
        如果 (值)
        {
            返回 ("真")
        }
        返回 ("假")
    }
}
