<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序 <注释 = "批次1 功能读回验证: 对 Skia核心/Skia几何 的可确定性读回做逐项断言, 结果写入 examples/verify_report.txt。期望值来源为工程师实测基线。">

类 启动类 <公开 基础类 = 窗口程序类 注释 = "功能验证宿主程序。">
{
    变量 主窗口对象 <类型 = 验证窗口 标题 = "Skia 批次1 功能验证">

    方法 启动方法 <公开 类型 = 整数>
    {
        主窗口对象.创建主窗口 ()
        返回 (1)
    }
}

# ================

类 验证窗口 <基础类 = 窗口 @视窗.布局 = "client_size = \"760, 520\"" 标题 = "Skia 批次1 功能验证">
{
    变量 结果框 <类型 = 编辑框 隐藏值属性 = "0" @视窗.布局 = "id = 101\r\npos = \"12, 12, 736, 496\"" 是否允许多行 = 真 滚动条 = 横向及纵向滚动条>
    变量 报告 <类型 = 文本型>
    变量 通过数 <类型 = 整数>
    变量 失败数 <类型 = 整数>

    方法 存行 <公开 类型 = 逻辑型 注释 = "把整份累计报告覆盖写一次; 崩溃时文件里的最后一行就是最后完成的断言。">
    参数 行 <类型 = 文本型>
    {
        报告 = 报告 + 行 + "\r\n"
        写到文件 ("E:/AI开发/Skia工具/examples/verify_report.txt", 文本到UTF8 (报告, 假), )
        返回 (真)
    }

    方法 判整数 <公开 类型 = 逻辑型 注释 = "整数精确相等断言。">
    参数 用例 <类型 = 文本型>
    参数 期望值 <类型 = 整数>
    参数 实际值 <类型 = 整数>
    {
        如果 (期望值 == 实际值)
        {
            通过数 = 通过数 + 1
            存行 ("  [OK] " + 用例 + " = " + 到文本 (实际值))
            返回 (真)
        }
        失败数 = 失败数 + 1
        存行 ("  [NG] " + 用例 + " 期望 " + 到文本 (期望值) + " 实际 " + 到文本 (实际值))
        返回 (假)
    }

    方法 判文本 <公开 类型 = 逻辑型 注释 = "文本精确相等断言。">
    参数 用例 <类型 = 文本型>
    参数 期望值 <类型 = 文本型>
    参数 实际值 <类型 = 文本型>
    {
        如果 (期望值 == 实际值)
        {
            通过数 = 通过数 + 1
            存行 ("  [OK] " + 用例 + " = " + 实际值)
            返回 (真)
        }
        失败数 = 失败数 + 1
        存行 ("  [NG] " + 用例 + " 期望 [" + 期望值 + "] 实际 [" + 实际值 + "]")
        返回 (假)
    }

    方法 判小数 <公开 类型 = 逻辑型 注释 = "小数按容差断言(单精度误差)。">
    参数 用例 <类型 = 文本型>
    参数 期望值 <类型 = 小数>
    参数 实际值 <类型 = 小数>
    参数 容差 <类型 = 小数>
    {
        变量 差 <类型 = 小数>
        差 = 实际值 - 期望值
        如果 (差 < 0.0)
        {
            差 = 0.0 - 差
        }
        如果 (差 <= 容差)
        {
            通过数 = 通过数 + 1
            存行 ("  [OK] " + 用例 + " = " + 到文本 (实际值))
            返回 (真)
        }
        失败数 = 失败数 + 1
        存行 ("  [NG] " + 用例 + " 期望 " + 到文本 (期望值) + " 实际 " + 到文本 (实际值) + " 容差 " + 到文本 (容差))
        返回 (假)
    }

    方法 判真假 <公开 类型 = 逻辑型 注释 = "逻辑型断言, 期望真。">
    参数 用例 <类型 = 文本型>
    参数 实际值 <类型 = 逻辑型>
    {
        如果 (实际值)
        {
            通过数 = 通过数 + 1
            存行 ("  [OK] " + 用例 + " = 真")
            返回 (真)
        }
        失败数 = 失败数 + 1
        存行 ("  [NG] " + 用例 + " 期望 真 实际 假")
        返回 (假)
    }

    方法 验证窗口_创建完毕 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = 验证窗口>
    参数 标记值 <类型 = 整数>
    {
        变量 矩形甲 <类型 = Skia矩形>
        变量 浮点色甲 <类型 = Skia浮点颜色>
        变量 浮点色乙 <类型 = Skia浮点颜色>
        变量 整数色 <类型 = 整数>
        变量 画笔甲 <类型 = Skia画笔>
        变量 构建器甲 <类型 = Skia路径构建器>
        变量 快照甲 <类型 = Skia路径>
        变量 取出甲 <类型 = Skia路径>
        变量 空路径 <类型 = Skia路径>
        变量 矩阵甲 <类型 = Skia矩阵44>
        变量 采样甲 <类型 = Skia采样选项>

        报告 = ""
        通过数 = 0
        失败数 = 0
        存行 ("Skia 批次1 功能读回验证")
        存行 ("说明: 期望值来源为工程师实测基线; 小数类断言按容差, 整数/文本精确相等。")
        存行 ("")

        // ---------- 用例1: 全局版本信息 ----------
        存行 ("[1] Skia全局 版本信息")
        判整数 ("Skia全局.取主版本号 ()", 154, Skia全局.取主版本号 ())
        判整数 ("Skia全局.取次版本号 ()", 0, Skia全局.取次版本号 ())
        判文本 ("Skia全局.取版本文本 ()", "154.0", Skia全局.取版本文本 ())
        存行 ("")

        // ---------- 用例2: 值类写入/读回 ----------
        存行 ("[2] Skia矩形 置边界 -> 属性读回")
        判真假 ("Skia矩形.置边界 (1.5, 2.5, 30.25, 40.75)", 矩形甲.置边界 (1.5, 2.5, 30.25, 40.75))
        判小数 ("Skia矩形.左", 1.5, 矩形甲.左, 0.0001)
        判小数 ("Skia矩形.上", 2.5, 矩形甲.上, 0.0001)
        判小数 ("Skia矩形.右", 30.25, 矩形甲.右, 0.0001)
        判小数 ("Skia矩形.下", 40.75, 矩形甲.下, 0.0001)
        存行 ("")

        // ---------- 用例3: 颜色往返 ----------
        存行 ("[3] Skia颜色 浮点<->整数 往返")
        浮点色甲.置颜色 (0.2, 0.4, 0.8, 1.0)
        整数色 = Skia颜色.浮点色转整数色 (浮点色甲)
        判整数 ("Skia颜色.浮点色转整数色 (0.2,0.4,0.8,1.0) 位模式 0xFF3366CC", -13408564, 整数色)
        浮点色乙 = Skia颜色.整数色转浮点色 (整数色)
        判小数 ("Skia颜色.整数色转浮点色 -> 红", 0.2, 浮点色乙.红, 0.0001)
        判小数 ("Skia颜色.整数色转浮点色 -> 绿", 0.4, 浮点色乙.绿, 0.0001)
        判小数 ("Skia颜色.整数色转浮点色 -> 蓝", 0.8, 浮点色乙.蓝, 0.0001)
        判小数 ("Skia颜色.整数色转浮点色 -> 透明度", 1.0, 浮点色乙.透明度, 0.0001)
        存行 ("")

        // ---------- 用例4: 画笔生命周期与属性往返 ----------
        存行 ("[4] Skia画笔 生命周期与属性往返")
        画笔甲 = Skia画笔.新建 ()
        判真假 ("Skia画笔.新建 () 后 是否有效 ()", 画笔甲.是否有效 ())
        画笔甲.置颜色 (整数色)
        画笔甲.置线宽 (3.5)
        判整数 ("Skia画笔.取颜色 () 应与浮点色转整数色一致", 整数色, 画笔甲.取颜色 ())
        判小数 ("Skia画笔.取线宽 ()", 3.5, 画笔甲.取线宽 (), 0.0001)
        判真假 ("Skia画笔.释放 () 返回真", 画笔甲.释放 ())
        判真假 ("Skia画笔.释放 () 可重复调用", 画笔甲.释放 ())
        如果 (画笔甲.是否有效 ())
        {
            失败数 = 失败数 + 1
            存行 ("  [NG] Skia画笔.释放 () 后 是否有效 () 应为假, 实际为真")
        }
        否则
        {
            通过数 = 通过数 + 1
            存行 ("  [OK] Skia画笔.释放 () 后 是否有效 () = 假")
        }
        存行 ("")

        // ---------- 用例5: 路径构建器 ----------
        存行 ("[5] Skia路径构建器 计数与边界")
        构建器甲 = Skia路径构建器.新建 ()
        构建器甲.移动到 (0.0, 0.0)
        构建器甲.直线到 (100.0, 50.0)
        快照甲 = 构建器甲.快照路径 ()
        判整数 ("快照路径.取点数 () 期望 2", 2, 快照甲.取点数 ())
        快照甲.释放 ()
        矩形甲.置边界 (0.0, 0.0, 100.0, 50.0)
        判真假 ("构建器.追加矩形 (矩形, 0)", 构建器甲.追加矩形 (矩形甲, 0))
        取出甲 = 构建器甲.取出路径 ()
        判整数 ("取出路径.取点数 () 期望 6", 6, 取出甲.取点数 ())
        判整数 ("取出路径.取图元数 () 期望 7", 7, 取出甲.取图元数 ())
        判真假 ("取出路径.取边界 (结果矩形)", 取出甲.取边界 (矩形甲))
        判小数 ("取出路径.取边界 左", 0.0, 矩形甲.左, 0.0001)
        判小数 ("取出路径.取边界 上", 0.0, 矩形甲.上, 0.0001)
        判小数 ("取出路径.取边界 右", 100.0, 矩形甲.右, 0.0001)
        判小数 ("取出路径.取边界 下", 50.0, 矩形甲.下, 0.0001)
        取出甲.释放 ()
        构建器甲.释放 ()
        空路径 = Skia路径.新建 ()
        判整数 ("Skia路径.新建 ().取点数 () 期望 0", 0, 空路径.取点数 ())
        空路径.释放 ()
        存行 ("")

        // ---------- 用例6: 矩阵44 元素读写 ----------
        存行 ("[6] Skia矩阵44 元素读写")
        矩阵甲.置单位矩阵 ()
        判小数 ("单位阵 取元素 (0,0)", 1.0, 矩阵甲.取元素 (0, 0), 0.0001)
        判小数 ("单位阵 取元素 (1,1)", 1.0, 矩阵甲.取元素 (1, 1), 0.0001)
        判小数 ("单位阵 取元素 (0,1) 期望 0", 0.0, 矩阵甲.取元素 (0, 1), 0.0001)
        判真假 ("矩阵44.置元素 (1,2,9.5)", 矩阵甲.置元素 (1, 2, 9.5))
        判小数 ("矩阵44.取元素 (1,2)", 9.5, 矩阵甲.取元素 (1, 2), 0.0001)
        判小数 ("置元素后 取元素 (1,1) 仍为单位阵", 1.0, 矩阵甲.取元素 (1, 1), 0.0001)
        存行 ("")

        // ---------- 用例7: 值类属性同名重名的读回验证 ----------
        // 背景: Skia采样选项 里 置过滤 的参数名 过滤方式/多级模式 与同类属性读方法同名,
        //       若嵌入行把 @<过滤方式> 解析成方法而不是参数, 就会静默读回旧值(置了等于没置)。
        存行 ("[7] Skia采样选项 置过滤 -> 属性读回（参数名与属性读方法重名）")
        判真假 ("采样选项.置过滤 (1, 2)", 采样甲.置过滤 (1, 2))
        判整数 ("采样选项.过滤方式 期望 1", 1, 采样甲.过滤方式)
        判整数 ("采样选项.多级模式 期望 2", 2, 采样甲.多级模式)
        判真假 ("采样选项.置过滤 (0, 0) 复位", 采样甲.置过滤 (0, 0))
        判整数 ("采样选项.过滤方式 复位后期望 0", 0, 采样甲.过滤方式)
        判整数 ("采样选项.多级模式 复位后期望 0", 0, 采样甲.多级模式)
        存行 ("")

        // ---------- 汇总 ----------
        存行 ("========================================")
        存行 ("汇总: 通过 " + 到文本 (通过数) + " 项, 失败 " + 到文本 (失败数) + " 项")
        如果 (失败数 == 0)
        {
            存行 ("结论: 批次1 功能读回全部符合预期。")
        }
        否则
        {
            存行 ("结论: 存在失败项, 见上方 [NG] 行。")
        }
        结果框.内容 = 报告
        返回 (0)
    }
}
