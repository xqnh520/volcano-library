<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序 <注释 = "Skia 使用示例: 用 Skia图形库 模块绘制一张 800x600 海报并保存为 PNG。覆盖 画布/画笔/几何/圆角矩形/文字 与 PNG 编码的完整链路, 结果实时显示在窗口里。">

类 启动类 <公开 基础类 = 窗口程序类 注释 = "示例入口。">
{
    变量 主窗口对象 <类型 = Skia海报窗口 标题 = "Skia 使用示例">

    方法 启动方法 <公开 类型 = 整数>
    {
        主窗口对象.创建主窗口 ()
        返回 (1)
    }
}

# ============================================================

类 Skia海报窗口 <基础类 = 窗口 @视窗.布局 = "client_size = \"700, 340\"" 标题 = "Skia 使用示例 · 生成海报">
{
    变量 输出框 <类型 = 编辑框 隐藏值属性 = "0" @视窗.布局 = "id = 101\r\npos = \"12, 12, 676, 316\"" 是否允许多行 = 真 滚动条 = 横向及纵向滚动条>

    方法 输出 <公开 类型 = 整数 注释 = "往输出框追加一行。">
    参数 行 <类型 = 文本型>
    {
        输出框.内容 = 输出框.内容 + 行 + "\r\n"
        返回 (0)
    }

    方法 Skia海报窗口_创建完毕 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = Skia海报窗口>
    参数 标记值 <类型 = 整数>
    {
        变量 宽 <类型 = 整数>
        变量 高 <类型 = 整数>
        变量 行字节 <类型 = 整数>
        变量 像素缓冲 <类型 = 字节集类>
        变量 图像信息 <类型 = Skia图像信息>
        变量 像素地址 <类型 = 变整数>
        变量 空表面属性 <类型 = Skia表面属性>
        变量 画布 <类型 = Skia画布>
        变量 画笔 <类型 = Skia画笔>
        变量 矩形甲 <类型 = Skia矩形>
        变量 字体样式常规 <类型 = Skia字体样式>
        变量 字体样式粗体 <类型 = Skia字体样式>
        变量 字体管理 <类型 = Skia字体管理>
        变量 字形甲 <类型 = Skia字形>
        变量 字体标题 <类型 = Skia字体>
        变量 字体正文 <类型 = Skia字体>
        变量 文字字节 <类型 = 字节集类>
        变量 像素图 <类型 = Skia像素图>
        变量 写流 <类型 = Skia动态内存写流>
        变量 PNG选项 <类型 = SkiaPNG编码选项>
        变量 PNG长度 <类型 = 变整数>
        变量 PNG长度整数 <类型 = 整数>
        变量 PNG数据 <类型 = 字节集类>
        变量 输出文件名 <类型 = 文本型>
        变量 结果 <类型 = 逻辑型>

        宽 = 800
        高 = 600
        行字节 = 宽 * 4

        输出 ("[1] Skia 版本 = " + Skia全局.取版本文本 ())
        输出 ("[2] 准备画布: " + 到文本 (宽) + " x " + 到文本 (高) + ", 行字节 = " + 到文本 (行字节))

        像素缓冲 = 取空白字节集 (宽 * 高 * 4)
        图像信息 = Skia图像信息.新建 (宽, 高)
        @ @<像素地址> = (intptr_t)@<像素缓冲>.GetPtr();
        画布 = Skia画布.新建_按像素 (图像信息, 像素地址, 行字节, 空表面属性)

        如果 (画布.是否有效 () == 假)
        {
            输出 ("[失败] 画布创建失败")
            返回 (0)
        }

        输出 ("[3] 画布已创建, 开始绘制")

        画布.清空 (-14800316)
        画笔 = Skia画笔.新建 ()
        画笔.置抗锯齿 (真)
        画笔.置样式 (0)

        画笔.置颜色 (1090519039)
        画布.绘制圆 (680.0, 80.0, 210.0, 画笔)

        画笔.置颜色 (-16723245)
        画布.绘制圆 (110.0, 520.0, 95.0, 画笔)

        画笔.置颜色 (-9675545)
        矩形甲.置边界 (60.0, 300.0, 150.0, 390.0)
        画布.绘制圆角矩形_按半径 (矩形甲, 14.0, 14.0, 画笔)

        画笔.置颜色 (-16723245)
        矩形甲.置边界 (170.0, 300.0, 260.0, 390.0)
        画布.绘制圆角矩形_按半径 (矩形甲, 14.0, 14.0, 画笔)

        画笔.置颜色 (-24765)
        矩形甲.置边界 (280.0, 300.0, 370.0, 390.0)
        画布.绘制圆角矩形_按半径 (矩形甲, 14.0, 14.0, 画笔)

        输出 ("[4] 背景与图形已绘制 (清空 + 2 圆 + 3 圆角方块)")

        字体管理 = Skia字体管理.取默认 ()
        字体样式常规 = Skia字体样式.新建 (400, 5, 0)
        字体样式粗体 = Skia字体样式.新建 (700, 5, 0)
        字形甲 = 字体管理.按族名取字形 ("SimHei", 字体样式粗体)

        如果 (字形甲.是否有效 () == 假)
        {
            输出 ("[失败] 系统里找不到 SimHei 字体")
            画笔.释放 ()
            画布.释放 ()
            返回 (0)
        }

        字体标题 = Skia字体.新建_按字形 (字形甲, 44.0, 1.0, 0.0)
        画笔.置颜色 (-1)
        文字字节 = 文本到UTF8 ("Skia 图形库", 假)
        画布.绘制简单文字 (文字字节, 0, 60.0, 145.0, 字体标题.取句柄, 画笔)
        输出 ("[5] 标题文字宽度 = " + 到文本 (字体标题.取文字宽度 ("Skia 图形库")) + " 像素")

        字形甲 = 字体管理.按族名取字形 ("SimHei", 字体样式常规)
        字体正文 = Skia字体.新建_按字形 (字形甲, 22.0, 1.0, 0.0)

        画笔.置颜色 (-1)
        文字字节 = 文本到UTF8 ("770 个原生函数 转 84 个中文类 / 1149 个方法", 假)
        画布.绘制简单文字 (文字字节, 0, 60.0, 195.0, 字体正文.取句柄, 画笔)

        画笔.置颜色 (1090519039)
        文字字节 = 文本到UTF8 ("画布 · 画笔 · 路径 · 几何 · 图像 · 效果 · 文字", 假)
        画布.绘制简单文字 (文字字节, 0, 60.0, 235.0, 字体正文.取句柄, 画笔)

        画笔.置样式 (1)
        画笔.置线宽 (2.0)
        画笔.置颜色 (1090519039)
        矩形甲.置边界 (60.0, 415.0, 740.0, 545.0)
        画布.绘制圆角矩形_按半径 (矩形甲, 16.0, 16.0, 画笔)

        画笔.置样式 (0)
        画笔.置颜色 (-1)
        文字字节 = 文本到UTF8 ("这张图完全由 Skia 画布绘制，最后编码成 PNG。", 假)
        画布.绘制简单文字 (文字字节, 0, 90.0, 470.0, 字体正文.取句柄, 画笔)
        文字字节 = 文本到UTF8 ("深蓝底 + 两个半透明圆 + 三个圆角方块 + 多段文字", 假)
        画布.绘制简单文字 (文字字节, 0, 90.0, 510.0, 字体正文.取句柄, 画笔)

        输出 ("[6] 文字与边框已绘制")

        像素图 = Skia像素图.新建_按参数 (图像信息, 像素地址, 行字节)
        PNG选项.置ZLib等级 (6)
        写流 = Skia动态内存写流.新建 ()
        结果 = Skia编解码器.编码PNG (写流, 像素图, PNG选项)

        如果 (结果 == 假)
        {
            输出 ("[失败] PNG 编码失败")
        }
        否则
        {
            PNG长度 = 写流.取已写字节数 ()
            @ @<PNG长度整数> = (int)@<PNG长度>;
            PNG数据 = 取空白字节集 (PNG长度整数)
            写流.复制到 (PNG数据)
            输出文件名 = "skia演示.png"
            结果 = 写到文件 (输出文件名, PNG数据)
            如果 (结果)
            {
                输出 ("[7] PNG 已保存: " + 输出文件名 + ", " + 到文本 (PNG长度整数) + " 字节")
                输出 ("    路径 = 编译输出目录 (exe 所在目录)")
            }
            否则
            {
                输出 ("[失败] 写文件失败")
            }
        }

        写流.关闭 ()
        字体标题.释放 ()
        字体正文.释放 ()
        字体样式常规.释放 ()
        字体样式粗体.释放 ()
        字体管理.释放 ()
        像素图.释放 ()
        画笔.释放 ()
        画布.释放 ()

        输出 ("[8] 全部句柄已释放, 完成")
        返回 (0)
    }
}
