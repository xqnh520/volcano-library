<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序 <注释 = "冒烟闸门宿主: 唯一目的是让 Skia冒烟.执行全部 从启动类可达, 从而强制 Skia核心.wsv 的全部方法体进入 C++ 编译。本工程只做编译检查, 不承载任何业务演示。">

类 启动类 <公开 基础类 = 窗口程序类 注释 = "冒烟闸门宿主程序。">
{
    变量 主窗口对象 <类型 = 冒烟窗口 标题 = "Skia 冒烟闸门">

    方法 启动方法 <公开 类型 = 整数>
    {
        主窗口对象.创建主窗口 ()
        返回 (1)
    }
}

# ================

类 冒烟窗口 <基础类 = 窗口 @视窗.布局 = "client_size = \"620, 300\"" 标题 = "Skia 冒烟闸门">
{
    变量 日志框 <类型 = 编辑框 隐藏值属性 = "0" @视窗.布局 = "id = 101\r\npos = \"12, 12, 596, 276\"" 是否允许多行 = 真 滚动条 = 横向及纵向滚动条>

    方法 冒烟窗口_创建完毕 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = 冒烟窗口>
    参数 标记值 <类型 = 整数>
    {
        日志框.内容 = "编译期冒烟闸门宿主。执行全部 (0) = 不执行, 只做编译覆盖。"
        // 这一句是闸门的关键: 没有它 Skia冒烟 整体不可达, 火山不会为桩生成 C++。
        Skia冒烟.执行全部 (0)
        返回 (0)
    }
}
