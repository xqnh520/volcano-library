    {
        变量 结果 <类型 = Skia字形>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_fontstyleset_create_typeface((sk_fontstyleset_t*)@<句柄>, @<序号>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 按样式取字形 <公开 类型 = Skia字形 注释 = "找最接近的字重(如要 600 但只有 400/700 时取 700); 失败返回空对象。">
    参数 样式 <类型 = Skia字体样式>
    {
        变量 结果 <类型 = Skia字形>
        变量 句柄 <类型 = 变整数>
        变量 样式句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        样式句柄 = 样式.对象指针
        @ @<新指针> = (intptr_t)sk_fontstyleset_match_style((sk_fontstyleset_t*)@<句柄>, (sk_fontstyle_t*)@<样式句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}

# ============================================================
# 八、Skia文字工具(全静态)
# ============================================================

类 Skia文字工具 <公开 注释 = "文字工具(全静态): 把整串文字转成轮廓路径, 之后可当普通路径描边/填充/做布尔运算。">
{
    方法 文字转路径 <公开 静态 类型 = 逻辑型 注释 = "静态; 把整串文字转成轮廓路径(会先清空结果路径)。">
    参数 文字数据 <类型 = 字节集类>
    参数 编码 <类型 = 整数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 字体 <类型 = Skia字体>
    参数 结果路径 <类型 = Skia路径>
    {
        变量 字节数 <类型 = 变整数>
        变量 字体句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        字节数 = 取字节集长度 (文字数据)
        字体句柄 = 字体.对象指针
        路径句柄 = 结果路径.对象指针
        @ sk_text_utils_get_path((const void*)@<文字数据>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)@<编码>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_font_t*)@<字体句柄>, (sk_path_t*)@<路径句柄>);
        返回 (真)
    }

    方法 文字转路径_按位置 <公开 静态 类型 = 逻辑型 注释 = "静态; 位置数据每点 8 字节(sk_point_t), 个数须等于文字字形数; 用于曲线排字/任意位置排字。">
    参数 文字数据 <类型 = 字节集类>
    参数 编码 <类型 = 整数>
    参数 位置数据 <类型 = 字节集类>
    参数 字体 <类型 = Skia字体>
    参数 结果路径 <类型 = Skia路径>
    {
        变量 字节数 <类型 = 变整数>
        变量 字体句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        字节数 = 取字节集长度 (文字数据)
        字体句柄 = 字体.对象指针
        路径句柄 = 结果路径.对象指针
        @ sk_text_utils_get_pos_path((const void*)@<文字数据>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)@<编码>, (const sk_point_t*)@<位置数据>.GetPtr(), (const sk_font_t*)@<字体句柄>, (sk_path_t*)@<路径句柄>);
        返回 (真)
    }
}
