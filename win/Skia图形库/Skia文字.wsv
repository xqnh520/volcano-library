<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Skia <注释 = "Skia 文字/字体域封装(批次4, 最后一批): Skia字体 / Skia字形 / Skia文字块 / Skia文字块构建器 / Skia字体管理 / Skia字体样式 / Skia字体样式集 / Skia文字工具 + 两个值类(Skia字体度量 64 字节 / Skia文字块缓冲 32 字节)。"
        注释 = "【画文字的最小路径】Skia字体管理.取默认 () -> 按族名取字形 (族名, 空样式) -> Skia字体.置字形与字号 (字形, 24.0) -> Skia画布.绘制简单文字 (文字数据, 0, x, y, 字体.取句柄, 画笔)。注意 绘制简单文字 的字体参数是裸 变整数, 传 字体.取句柄 即可(取句柄 是属性读, 不要加括号)。"
        注释 = "【v4 的 API 变更, 不是遗漏】Skia v4 的 SkPaint 内部已不含字体(sk_paint.h 全文无 text/font 接口), 字体是 绘制简单文字 的独立参数。所以本模块没有 字体.绑定到画笔: 该方法保留但固定返回假, 原因写在方法注释里。要「把字体挂到画笔」只有 sk_compatpaint_* 那条路, 而本 deps 没有对应头文件。"
        注释 = "【一次性类型】Skia字形 只有 unref 没有 ref: 字形一旦 置字形 进 Skia字体 就不要再 释放、也不要给第二个字体复用; 需要两个字体用同一字体面时, 重新 按族名取字形 各取一次。Skia字体 / Skia文字块 有 ref, 可 加引用 复用。"
        注释 = "【指针数组型接口】文字转字形 / 多字转字形 / 取字形宽度与边界 / 取字形位置 / 取字形横向位置 / 取表标签 / 取字距调整 都是「先问数量 -> 分配字节集类 -> 再取」。每项字节数: 字形 2, 码位/簇/调整 4, 位置 8, 边界 16, 表标签 4。注释里逐个标了。"
        注释 = "【必须显式释放】句柄类的 类_清理 一律空实现, 谁创建谁 释放。"
        @视窗.头文件搜寻目录 = "deps\\skia"
        @视窗.头文件搜寻目录 = "deps\\skia\\include\\c"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "skia_include.h">

# ============================================================
# 一、值类
# ============================================================

类 Skia字体度量 <公开 注释 = "字体度量(sk_fontmetrics_t, 64 字节): 1 个 uint32 标志 + 15 个单精度。偏移 0 标志 / 4 上边界 / 8 上升(负值) / 12 下降(正值) / 16 下边界 / 20 行距 / 24 平均字宽 / 28 最大字宽 / 32 最小横界 / 36 最大横界 / 40 小写字高 / 44 大写高 / 48 下划线厚度 / 52 下划线偏移 / 56 删除线厚度 / 60 删除线偏移。垂直居中: 基线Y = 中心Y + (上升 + 下降) / 2。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "64 字节缓冲, 对应 sk_fontmetrics_t。">

    方法 类_初始化 <公开 注释 = "分配 64 字节缓冲并清零。">
    {
        数据 = 取空白字节集 (64)
    }

    方法 标志 <公开 属性读 类型 = 整数 注释 = "位标志(一般 0)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fFlags)
    }

    方法 上边界 <公开 属性读 类型 = 小数 注释 = "推荐行距的上边(通常为负)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fTop)
    }

    方法 上升 <公开 属性读 类型 = 小数 注释 = "基线到最高点的距离(负值)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fAscent)
    }

    方法 下降 <公开 属性读 类型 = 小数 注释 = "基线到最低点的距离(正值)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fDescent)
    }

    方法 下边界 <公开 属性读 类型 = 小数 注释 = "推荐行距的下边。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fBottom)
    }

    方法 行距 <公开 属性读 类型 = 小数 注释 = "行间推荐额外间距。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fLeading)
    }

    方法 平均字宽 <公开 属性读 类型 = 小数 注释 = "平均字符宽度。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fAvgCharWidth)
    }

    方法 最大字宽 <公开 属性读 类型 = 小数 注释 = "最宽字符宽度。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fMaxCharWidth)
    }

    方法 最小横界 <公开 属性读 类型 = 小数 注释 = "最小 x 范围。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fXMin)
    }

    方法 最大横界 <公开 属性读 类型 = 小数 注释 = "最大 x 范围。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fXMax)
    }

    方法 小写字高 <公开 属性读 类型 = 小数 注释 = "小写字母高度(常用于垂直居中)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fXHeight)
    }

    方法 大写高 <公开 属性读 类型 = 小数 注释 = "大写字母高度。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fCapHeight)
    }

    方法 下划线厚度 <公开 属性读 类型 = 小数 注释 = "下划线粗细。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fUnderlineThickness)
    }

    方法 下划线偏移 <公开 属性读 类型 = 小数 注释 = "下划线相对基线的 y 偏移(负值在基线下方)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fUnderlinePosition)
    }

    方法 删除线厚度 <公开 属性读 类型 = 小数 注释 = "删除线粗细。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fStrikeoutThickness)
    }

    方法 删除线偏移 <公开 属性读 类型 = 小数 注释 = "删除线相对基线的 y 偏移。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_fontmetrics_t*)@sn<this>.@n<Skia字体度量.数据>.GetPtr())->fStrikeoutPosition)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_fontmetrics_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia字体度量.数据>.GetPtr())
    }
}

类 Skia文字块缓冲 <公开 注释 = "文字块 run 缓冲(sk_textblob_builder_runbuffer_t, 32 字节): 4 个裸指针 —— 0 字形数组(每项 2 字节) / 8 位置数组(每项 8 字节) / 16 UTF-8 文本 / 24 簇数组(每项 4 字节)。这 4 个指针由 Skia 分配, 调用方只往里写数据, 不要释放。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "32 字节缓冲, 对应 sk_textblob_builder_runbuffer_t。">

    方法 类_初始化 <公开 注释 = "分配 32 字节缓冲并清零(4 个指针全 0)。">
    {
        数据 = 取空白字节集 (32)
    }

    方法 置字形 <公开 类型 = 逻辑型 注释 = "写入第 序号 个字形的字形 ID(先调 分配* 让指针就绪)。">
    参数 序号 <类型 = 整数>
    参数 字形编号 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { uint16_t* __g = (uint16_t*)((sk_textblob_builder_runbuffer_t*)@<地址>)->glyphs; if (__g == nullptr) { return false; } __g[@<序号>] = (uint16_t)@<字形编号>; return true; }());
        返回 (真)
    }

    方法 置簇 <公开 类型 = 逻辑型 注释 = "写入第 序号 个字形的文本簇偏移(字节偏移)。">
    参数 序号 <类型 = 整数>
    参数 字节偏移 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { uint32_t* __c = (uint32_t*)((sk_textblob_builder_runbuffer_t*)@<地址>)->clusters; if (__c == nullptr) { return false; } __c[@<序号>] = (uint32_t)@<字节偏移>; return true; }());
        返回 (真)
    }

    方法 取字形容器地址 <公开 类型 = 变整数 注释 = "字形数组首地址(只读用); 未分配时为 0。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)((const sk_textblob_builder_runbuffer_t*)@sn<this>.@n<Skia文字块缓冲.数据>.GetPtr())->glyphs)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_textblob_builder_runbuffer_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia文字块缓冲.数据>.GetPtr())
    }
}

# ============================================================
# 二、Skia字体样式
# ============================================================

类 Skia字体样式 <公开 注释 = "字体样式(sk_fontstyle_t): 粗细 100~900(400 常规/700 粗体) + 宽度等级 1~9(5 常规) + 倾斜 0 直立/1 斜体/2 倾斜体。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字体样式.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia字体样式 注释 = "静态; 粗细 100~900(400 常规/700 粗体), 宽度等级 1~9(5 常规), 倾斜 0 直立/1 斜体/2 倾斜体。">
    参数 粗细 <类型 = 整数>
    参数 宽度等级 <类型 = 整数>
    参数 倾斜方式 <类型 = 整数>
    {
        变量 结果 <类型 = Skia字体样式>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_fontstyle_new(@<粗细>, @<宽度等级>, (sk_font_style_slant_t)@<倾斜方式>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_fontstyle_delete((sk_fontstyle_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字体样式.对象指针> != 0)
    }

    方法 取粗细 <公开 类型 = 整数 注释 = "100~900。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_fontstyle_get_weight((const sk_fontstyle_t*)@sn<this>.@n<Skia字体样式.对象指针>))
    }

    方法 取宽度等级 <公开 类型 = 整数 注释 = "1~9。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_fontstyle_get_width((const sk_fontstyle_t*)@sn<this>.@n<Skia字体样式.对象指针>))
    }

    方法 取倾斜方式 <公开 类型 = 整数 注释 = "0 直立/1 斜体/2 倾斜体。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_fontstyle_get_slant((const sk_fontstyle_t*)@sn<this>.@n<Skia字体样式.对象指针>))
    }
}

# ============================================================
# 三、Skia字形(一次性: 只有 unref)
# ============================================================

类 Skia字形 <公开 注释 = "字形面(sk_typeface_t): 代表一个字体文件。⚠ 只有 unref 没有 ref —— 一旦 置字形 进 Skia字体 就不要再 释放、不要给第二个字体复用; 需要两个字体用同一字体面请各取一次。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字形.对象指针>)
    }

    方法 新建_空 <公开 静态 类型 = Skia字形 注释 = "静态; 空字形面(无任何字形), 只用于占位或测试。">
    {
        变量 结果 <类型 = Skia字形>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_typeface_create_empty();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用; 原生没有 ref, 一个字形只能置入一个字体; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_typeface_unref((sk_typeface_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字形.对象指针> != 0)
    }

    方法 取字体样式 <公开 类型 = Skia字体样式 注释 = "返回新建的样式对象(拥有句柄=真), 用完要 释放; 失败返回空对象。">
    {
        变量 结果 <类型 = Skia字体样式>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_typeface_get_fontstyle((const sk_typeface_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取粗细 <公开 类型 = 整数 注释 = "100~900。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_typeface_get_font_weight((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>))
    }

    方法 取宽度等级 <公开 类型 = 整数 注释 = "1~9。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_typeface_get_font_width((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>))
    }

    方法 取倾斜方式 <公开 类型 = 整数 注释 = "0 直立/1 斜体/2 倾斜体。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_typeface_get_font_slant((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>))
    }

    方法 是否等宽 <公开 类型 = 逻辑型 注释 = "为真表示所有字形等宽。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_typeface_is_fixed_pitch((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>) != 0)
    }

    方法 单字转字形 <公开 类型 = 整数 注释 = "Unicode 码位 → 字形 ID; 0 表示缺字。" 折叠 @嵌入式方法 = "">
    参数 码位 <类型 = 整数>
    {
        @ ((int)sk_typeface_unichar_to_glyph((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>, (int32_t)@<码位>))
    }

    方法 多字转字形 <公开 类型 = 逻辑型 注释 = "码位数据每项 4 字节(int32, 共 数量 x 4); 结果字形数据每项 2 字节(uint16, 共 数量 x 2)。先分配两块缓冲再调。">
    参数 码位数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果字形数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_typeface_unichars_to_glyphs((const sk_typeface_t*)@<句柄>, (const int32_t*)@<码位数据>.GetPtr(), @<数量>, (uint16_t*)@<结果字形数据>.GetPtr());
        返回 (真)
    }

    方法 取字形总数 <公开 类型 = 整数 注释 = "该字体包含的字形个数。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_typeface_count_glyphs((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>))
    }

    方法 取表总数 <公开 类型 = 整数 注释 = "字体内部的表(OpenType table)个数。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_typeface_count_tables((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>))
    }

    方法 取表标签 <公开 类型 = 整数 注释 = "结果标签数据每项 4 字节(uint32 tag, 如 head/cmap); 缓冲需 ≥ 取表总数() x 4; 返回实际写入个数。">
    参数 结果标签数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_typeface_get_table_tags((const sk_typeface_t*)@<句柄>, (uint32_t*)@<结果标签数据>.GetPtr()));
        返回 (结果)
    }

    方法 取表尺寸 <公开 类型 = 变整数 注释 = "该表的字节数; 无该表返回 0。">
    参数 表标签 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = ((intptr_t)sk_typeface_get_table_size((const sk_typeface_t*)@<句柄>, (uint32_t)@<表标签>));
        返回 (结果)
    }

    方法 取表数据 <公开 类型 = 变整数 注释 = "返回实际写入字节数; 结果数据缓冲需 ≥ 取用字节数。先用 取表尺寸 判断大小。">
    参数 表标签 <类型 = 整数>
    参数 偏移 <类型 = 变整数>
    参数 取用字节数 <类型 = 变整数>
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = ((intptr_t)sk_typeface_get_table_data((const sk_typeface_t*)@<句柄>, (uint32_t)@<表标签>, (size_t)@<偏移>, (size_t)@<取用字节数>, (void*)@<结果数据>.GetPtr()));
        返回 (结果)
    }

    方法 复制表数据 <公开 类型 = Skia数据 注释 = "一步取回整张表(内部拷贝); 无该表返回空对象。">
    参数 表标签 <类型 = 整数>
    {
        变量 结果 <类型 = Skia数据>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_typeface_copy_table_data((const sk_typeface_t*)@<句柄>, (uint32_t)@<表标签>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取设计单位 <公开 类型 = 整数 注释 = "字体设计网格(常见 1000 或 2048); 像素 = 设计值 x 字号 / 本单位。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_typeface_get_units_per_em((const sk_typeface_t*)@sn<this>.@n<Skia字形.对象指针>))
    }

    方法 取字距调整 <公开 类型 = 逻辑型 注释 = "字形数据每项 2 字节; 结果调整数据每项 4 字节(int32, 共 数量 x 4), 单位是设计单位; 少于 2 个字形返回假。">
    参数 字形数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果调整数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_typeface_get_kerning_pair_adjustments((const sk_typeface_t*)@<句柄>, (const uint16_t*)@<字形数据>.GetPtr(), @<数量>, (int32_t*)@<结果调整数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取族名 <公开 类型 = Skia字符串 注释 = "返回新引用(拥有句柄=真), 用完要 释放; 失败返回空对象。">
    {
        变量 结果 <类型 = Skia字符串>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_typeface_get_family_name((const sk_typeface_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取PostScript名 <公开 类型 = Skia字符串 注释 = "返回新引用(拥有句柄=真), 用完要 释放; 失败返回空对象。">
    {
        变量 结果 <类型 = Skia字符串>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_typeface_get_post_script_name((const sk_typeface_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 打开数据流 <公开 类型 = 变整数 注释 = "返回 sk_stream_asset_t* 裸句柄(用 Skia流.销毁资源流 释放); 结果TTC序号需 4 字节缓冲; 失败返回 0。">
    参数 结果TTC序号 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = ((intptr_t)sk_typeface_open_stream((const sk_typeface_t*)@<句柄>, (int*)@<结果TTC序号>.GetPtr()));
        返回 (结果)
    }

    方法 取可变轴坐标 <公开 类型 = 整数 注释 = "结果坐标数据每项 8 字节(轴标签 4 + float 值 4); 返回实际个数; 非可变字体返回 0。">
    参数 结果坐标数据 <类型 = 字节集类>
    参数 最大个数 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_typeface_get_variation_design_position((const sk_typeface_t*)@<句柄>, (sk_fontarguments_variation_position_coordinate_t*)@<结果坐标数据>.GetPtr(), @<最大个数>));
        返回 (结果)
    }

    方法 取可变轴参数 <公开 类型 = 整数 注释 = "结果参数数据每项 20 字节(轴标签 4 + 最小 4 + 默认 4 + 最大 4 + 是否隐藏 1 + 填充 3); 返回实际个数。">
    参数 结果参数数据 <类型 = 字节集类>
    参数 最大个数 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_typeface_get_variation_design_parameters((const sk_typeface_t*)@<句柄>, (sk_fontarguments_variation_axis_t*)@<结果参数数据>.GetPtr(), @<最大个数>));
        返回 (结果)
    }

    方法 按参数克隆 <公开 类型 = Skia字形 注释 = "返回新的字形对象(拥有句柄=真), 失败返回空对象; 坐标数据每项 8 字节(轴标签 4 + float 值 4); 调色板覆盖数据每项 8 字节(index uint16@0 + color uint32@4); 序号传 0 表示默认。">
    参数 坐标数据 <类型 = 字节集类>
    参数 坐标个数 <类型 = 整数>
    参数 字体集序号 <类型 = 整数>
    参数 调色板序号 <类型 = 整数>
    参数 调色板覆盖数据 <类型 = 字节集类>
    参数 覆盖个数 <类型 = 整数>
    {
        变量 结果 <类型 = Skia字形>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_typeface_clone_with_arguments((const sk_typeface_t*)@<句柄>, (const sk_fontarguments_variation_position_coordinate_t*)@<坐标数据>.GetPtr(), @<坐标个数>, @<字体集序号>, @<调色板序号>, (const sk_fontarguments_palette_override_t*)@<调色板覆盖数据>.GetPtr(), @<覆盖个数>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}

# ============================================================
# 四、Skia字体(含 3 个纯火山便利方法 + 取句柄)
# ============================================================

类 Skia字体 <公开 注释 = "字体(sk_font_t): 字形面 + 字号 + 横向比例/倾斜 + 微调与栅格化选项。⚠ 原生没有 sk_font_new(真名 sk_font_new_with_values)。常用序列: Skia字体管理.取默认 -> 按族名取字形 -> 置字形与字号 (字形, 24.0) -> 取文字宽度 / 绘制简单文字 (…, 字体.取句柄, 画笔)。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口(如 Skia画布.绘制简单文字)时用它。属性读, 调用不要加括号。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字体.对象指针>)
    }

    方法 新建_按字形 <公开 静态 类型 = Skia字体 注释 = "静态; 原生函数是 sk_font_new_with_values(不存在 sk_font_new); 横向比例 1.0 为正常, 横向倾斜 0 为正常; 字形可传空对象得到空字体。">
    参数 字形 <类型 = Skia字形>
    参数 字号 <类型 = 小数>
    参数 横向比例 <类型 = 小数 @默认值 = 1.0>
    参数 横向倾斜 <类型 = 小数 @默认值 = 0.0>
    {
        变量 结果 <类型 = Skia字体>
        变量 字形句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        字形句柄 = 字形.对象指针
        @ @<新指针> = (intptr_t)sk_font_new_with_values((sk_typeface_t*)@<字形句柄>, (float)@<字号>, (float)@<横向比例>, (float)@<横向倾斜>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_font_delete((sk_font_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字体.对象指针> != 0)
    }

    方法 置字形与字号 <公开 类型 = 逻辑型 注释 = "纯火山组合: 句柄为 0 时内部用 sk_font_new_with_values(字形, 字号, 1.0, 0.0) 新建, 否则调 置字形 + 置字号; 少踩「忘记先新建」的坑。">
    参数 字形 <类型 = Skia字形>
    参数 字号 <类型 = 小数>
    {
        变量 句柄 <类型 = 变整数>
        变量 字形句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        字形句柄 = 字形.对象指针
        如果 (对象指针 == 0)
        {
            @ @<新指针> = (intptr_t)sk_font_new_with_values((sk_typeface_t*)@<字形句柄>, (float)@<字号>, 1.0f, 0.0f);
            如果 (新指针 == 0)
            {
                返回 (假)
            }
            对象指针 = 新指针
            返回 (真)
        }
        句柄 = 对象指针
        @ sk_font_set_typeface((sk_font_t*)@<句柄>, (sk_typeface_t*)@<字形句柄>);
        @ sk_font_set_size((sk_font_t*)@<句柄>, (float)@<字号>);
        返回 (真)
    }

    方法 取文字宽度 <公开 类型 = 小数 注释 = "纯火山组合: 内部转 UTF-8 后按 编码 0 调 sk_font_measure_text(边界传空), 返回像素宽度。最常用的测量入口。">
    参数 文字 <类型 = 文本型>
    {
        变量 句柄 <类型 = 变整数>
        变量 文字字节 <类型 = 字节集类>
        变量 字节数 <类型 = 变整数>
        变量 宽度 <类型 = 小数>
        句柄 = 对象指针
        文字字节 = 文本到UTF8 (文字, 假)
        字节数 = 取字节集长度 (文字字节)
        @ @<宽度> = ((double)sk_font_measure_text((const sk_font_t*)@<句柄>, (const void*)@<文字字节>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)0, nullptr, nullptr));
        返回 (宽度)
    }

    方法 取文字宽度_按画笔 <公开 类型 = 小数 注释 = "同上, 但把画笔传给原生(影响字距/描边宽度参与测量)。">
    参数 文字 <类型 = 文本型>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 文字字节 <类型 = 字节集类>
        变量 字节数 <类型 = 变整数>
        变量 宽度 <类型 = 小数>
        句柄 = 对象指针
        文字字节 = 文本到UTF8 (文字, 假)
        字节数 = 取字节集长度 (文字字节)
        @ @<宽度> = ((double)sk_font_measure_text((const sk_font_t*)@<句柄>, (const void*)@<文字字节>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)0, nullptr, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>));
        返回 (宽度)
    }

    方法 绑定到画笔 <公开 类型 = 逻辑型 注释 = "⚠ 暂缺, 固定返回假。原因: Skia v4 的 SkPaint 内部已不含字体(sk_paint.h 全文无 text/font 接口), 字体是 绘制简单文字 的独立参数, 不是批次1 的疏漏。要画文字请用 Skia画布.绘制简单文字 (…, 字体.取句柄, 画笔); 把字体挂到画笔上只有 sk_compatpaint_* 那条路, 而本 deps 没有该头文件。">
    参数 画笔 <类型 = Skia画笔>
    {
        返回 (假)
    }

    方法 是否强制自动微调 <公开 类型 = 逻辑型 注释 = "默认真。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_font_is_force_auto_hinting((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>) != 0)
    }

    方法 置强制自动微调 <公开 注释 = "仅在未显式指定微调级别时生效。" 折叠 @嵌入式方法 = "">
    参数 启用 <类型 = 逻辑型>
    {
        @ sk_font_set_force_auto_hinting((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (bool)@<启用>)
    }

    方法 是否用内嵌点阵 <公开 类型 = 逻辑型 注释 = "默认真; 小字号时优先用字体内嵌点阵。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_font_is_embedded_bitmaps((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>) != 0)
    }

    方法 置用内嵌点阵 <公开 注释 = "关闭后一律走轮廓栅格化。" 折叠 @嵌入式方法 = "">
    参数 启用 <类型 = 逻辑型>
    {
        @ sk_font_set_embedded_bitmaps((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (bool)@<启用>)
    }

    方法 是否亚像素定位 <公开 类型 = 逻辑型 注释 = "默认真; 关闭后字形位置吸附到整数像素。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_font_is_subpixel((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>) != 0)
    }

    方法 置亚像素定位 <公开 注释 = "排版精度与速度的取舍。" 折叠 @嵌入式方法 = "">
    参数 启用 <类型 = 逻辑型>
    {
        @ sk_font_set_subpixel((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (bool)@<启用>)
    }

    方法 是否线性度量 <公开 类型 = 逻辑型 注释 = "默认真; 为假时度量按微调后的整数像素计算。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_font_is_linear_metrics((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>) != 0)
    }

    方法 置线性度量 <公开 注释 = "需要「度量与位置完全对齐」时设为假。" 折叠 @嵌入式方法 = "">
    参数 启用 <类型 = 逻辑型>
    {
        @ sk_font_set_linear_metrics((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (bool)@<启用>)
    }

    方法 是否加粗描边 <公开 类型 = 逻辑型 注释 = "默认真; 为假时合成加粗不生效。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_font_is_embolden((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>) != 0)
    }

    方法 置加粗描边 <公开 注释 = "只影响「合成加粗」(无粗体字体时)。" 折叠 @嵌入式方法 = "">
    参数 启用 <类型 = 逻辑型>
    {
        @ sk_font_set_embolden((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (bool)@<启用>)
    }

    方法 是否基线吸附 <公开 类型 = 逻辑型 注释 = "默认真。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_font_is_baseline_snap((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>) != 0)
    }

    方法 置基线吸附 <公开 注释 = "为真时基线吸附到整数像素, 文本更锐利但位置有跳动。" 折叠 @嵌入式方法 = "">
    参数 启用 <类型 = 逻辑型>
    {
        @ sk_font_set_baseline_snap((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (bool)@<启用>)
    }

    方法 取边缘方式 <公开 类型 = 整数 注释 = "0 黑白/1 抗锯齿/2 亚像素抗锯齿(LCD)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_font_get_edging((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>))
    }

    方法 置边缘方式 <公开 注释 = "0 黑白/1 抗锯齿/2 亚像素(LCD); 亚像素需要不透明背景。" 折叠 @嵌入式方法 = "">
    参数 边缘方式 <类型 = 整数>
    {
        @ sk_font_set_edging((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (sk_font_edging_t)@<边缘方式>)
    }

    方法 取微调级别 <公开 类型 = 整数 注释 = "0 无/1 轻微/2 普通/3 完全。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_font_get_hinting((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>))
    }

    方法 置微调级别 <公开 注释 = "0 无/1 轻微/2 普通/3 完全; 屏幕小字用 2, 打印/缩放用 0。" 折叠 @嵌入式方法 = "">
    参数 微调级别 <类型 = 整数>
    {
        @ sk_font_set_hinting((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (sk_font_hinting_t)@<微调级别>)
    }

    方法 取字形 <公开 类型 = Skia字形 注释 = "返回借用对象(是否拥有句柄=假), 不要释放。">
    {
        变量 结果 <类型 = Skia字形>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_font_get_typeface((const sk_font_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 置字形 <公开 类型 = 逻辑型 注释 = "只改字形面, 保留字号/比例/倾斜; 传空对象等于空字体。字形所有权转移给本字体, 不要再 释放 那个字形。">
    参数 字形 <类型 = Skia字形>
    {
        变量 句柄 <类型 = 变整数>
        变量 字形句柄 <类型 = 变整数>
        句柄 = 对象指针
        字形句柄 = 字形.对象指针
        @ sk_font_set_typeface((sk_font_t*)@<句柄>, (sk_typeface_t*)@<字形句柄>);
        返回 (真)
    }

    方法 取字号 <公开 类型 = 小数 注释 = "单位像素(逻辑高度)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_font_get_size((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>))
    }

    方法 置字号 <公开 注释 = "必须大于 0。" 折叠 @嵌入式方法 = "">
    参数 字号 <类型 = 小数>
    {
        @ sk_font_set_size((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (float)@<字号>)
    }

    方法 取横向比例 <公开 类型 = 小数 注释 = "1.0 为正常。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_font_get_scale_x((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>))
    }

    方法 置横向比例 <公开 注释 = "1.0 为正常; 0.5 为压扁一半。" 折叠 @嵌入式方法 = "">
    参数 横向比例 <类型 = 小数>
    {
        @ sk_font_set_scale_x((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (float)@<横向比例>)
    }

    方法 取横向倾斜 <公开 类型 = 小数 注释 = "0 为正常。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)sk_font_get_skew_x((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>))
    }

    方法 置横向倾斜 <公开 注释 = "0 为正常; -0.25 约等于斜体。" 折叠 @嵌入式方法 = "">
    参数 横向倾斜 <类型 = 小数>
    {
        @ sk_font_set_skew_x((sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (float)@<横向倾斜>)
    }

    方法 文字转字形 <公开 类型 = 整数 注释 = "两步: 先按 最大字形数 x 2 字节分配结果字形数据(每字形 uint16), 再调本方法; 编码 0 UTF8/1 UTF16/2 UTF32/3 字形ID。">
    参数 文字数据 <类型 = 字节集类>
    参数 编码 <类型 = 整数>
    参数 结果字形数据 <类型 = 字节集类>
    参数 最大字形数 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 字节数 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        字节数 = 取字节集长度 (文字数据)
        @ @<结果> = ((int)sk_font_text_to_glyphs((const sk_font_t*)@<句柄>, (const void*)@<文字数据>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)@<编码>, (uint16_t*)@<结果字形数据>.GetPtr(), @<最大字形数>));
        返回 (结果)
    }

    方法 单字转字形 <公开 类型 = 整数 注释 = "Unicode 码位 → 字形 ID(uint16, 0 表示缺字)。" 折叠 @嵌入式方法 = "">
    参数 码位 <类型 = 整数>
    {
        @ ((int)sk_font_unichar_to_glyph((const sk_font_t*)@sn<this>.@n<Skia字体.对象指针>, (int32_t)@<码位>))
    }

    方法 多字转字形 <公开 类型 = 逻辑型 注释 = "码位数据每项 4 字节(int32, 共 数量 x 4); 结果字形数据每项 2 字节(uint16, 共 数量 x 2)。两步: 先分配两块缓冲再调。">
    参数 码位数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果字形数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_font_unichars_to_glyphs((const sk_font_t*)@<句柄>, (const int32_t*)@<码位数据>.GetPtr(), @<数量>, (uint16_t*)@<结果字形数据>.GetPtr());
        返回 (真)
    }

    方法 测量文字 <公开 类型 = 小数 注释 = "返回前进宽度(像素); 结果边界写入文字外框(可传空对象); 文字数据是字节流, UTF-8 中文每字 3 字节。">
    参数 文字数据 <类型 = 字节集类>
    参数 编码 <类型 = 整数>
    参数 结果边界 <类型 = Skia矩形>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 字节数 <类型 = 变整数>
        变量 宽度 <类型 = 小数>
        句柄 = 对象指针
        字节数 = 取字节集长度 (文字数据)
        @ @<宽度> = ((double)sk_font_measure_text((const sk_font_t*)@<句柄>, (const void*)@<文字数据>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)@<编码>, (sk_rect_t*)@<结果边界>.@n<Skia矩形.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>));
        返回 (宽度)
    }

    方法 测量文字_按出参 <公开 类型 = 逻辑型 注释 = "与 测量文字 等价, 宽度改为写入 结果宽度(4 字节单精度)。">
    参数 文字数据 <类型 = 字节集类>
    参数 编码 <类型 = 整数>
    参数 结果边界 <类型 = Skia矩形>
    参数 画笔 <类型 = Skia画笔>
    参数 结果宽度 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 字节数 <类型 = 变整数>
        句柄 = 对象指针
        字节数 = 取字节集长度 (文字数据)
        @ sk_font_measure_text_no_return((const sk_font_t*)@<句柄>, (const void*)@<文字数据>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)@<编码>, (sk_rect_t*)@<结果边界>.@n<Skia矩形.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>, (float*)@<结果宽度>.GetPtr());
        返回 (真)
    }

    方法 断行文字 <公开 类型 = 变整数 注释 = "返回可容纳的字节数(在该字节处断行); 结果宽度需 4 字节缓冲; 返回 0 表示一个字符都放不下。">
    参数 文字数据 <类型 = 字节集类>
    参数 编码 <类型 = 整数>
    参数 最大宽度 <类型 = 小数>
    参数 结果宽度 <类型 = 字节集类>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 字节数 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        字节数 = 取字节集长度 (文字数据)
        @ @<结果> = ((intptr_t)sk_font_break_text((const sk_font_t*)@<句柄>, (const void*)@<文字数据>.GetPtr(), (size_t)@<字节数>, (sk_text_encoding_t)@<编码>, (float)@<最大宽度>, (float*)@<结果宽度>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>));
        返回 (结果)
    }

    方法 取字形宽度与边界 <公开 类型 = 逻辑型 注释 = "字形数据每项 2 字节; 结果宽度数据每项 4 字节(数量 x 4); 结果边界数据每项 16 字节(数量 x 16, 顺序 左/上/右/下)。">
    参数 字形数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果宽度数据 <类型 = 字节集类>
    参数 结果边界数据 <类型 = 字节集类>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_font_get_widths_bounds((const sk_font_t*)@<句柄>, (const uint16_t*)@<字形数据>.GetPtr(), @<数量>, (float*)@<结果宽度数据>.GetPtr(), (sk_rect_t*)@<结果边界数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 取字形位置 <公开 类型 = 逻辑型 注释 = "结果位置数据每项 8 字节(sk_point_t, 数量 x 8); 起点为第一个字形的基点。">
    参数 字形数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果位置数据 <类型 = 字节集类>
    参数 起点 <类型 = Skia点>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_font_get_pos((const sk_font_t*)@<句柄>, (const uint16_t*)@<字形数据>.GetPtr(), @<数量>, (sk_point_t*)@<结果位置数据>.GetPtr(), (sk_point_t*)@<起点>.@n<Skia点.数据>.GetPtr());
        返回 (真)
    }

    方法 取字形横向位置 <公开 类型 = 逻辑型 注释 = "结果横坐标数据每项 4 字节(数量 x 4); 比 取字形位置 更省内存。">
    参数 字形数据 <类型 = 字节集类>
    参数 数量 <类型 = 整数>
    参数 结果横坐标数据 <类型 = 字节集类>
    参数 起点横坐标 <类型 = 小数>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_font_get_xpos((const sk_font_t*)@<句柄>, (const uint16_t*)@<字形数据>.GetPtr(), @<数量>, (float*)@<结果横坐标数据>.GetPtr(), (float)@<起点横坐标>);
        返回 (真)
    }

    方法 取单字轮廓 <公开 类型 = 逻辑型 注释 = "字形编号 由 单字转字形 得到; 写入 结果路径(会先清空); 缺字返回假。">
    参数 字形编号 <类型 = 整数>
    参数 结果路径 <类型 = Skia路径>
    {
        变量 句柄 <类型 = 变整数>
        变量 路径句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        路径句柄 = 结果路径.对象指针
        @ @<结果> = (sk_font_get_path((const sk_font_t*)@<句柄>, (uint16_t)@<字形编号>, (sk_path_t*)@<路径句柄>) != 0);
        返回 (结果)
    }

    方法 取度量 <公开 类型 = 小数 注释 = "返回建议行高(上边界 到 下边界); 结果度量 64 字节, 偏移见 Skia字体度量 的类注释。">
    参数 结果度量 <类型 = Skia字体度量>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 小数>
        句柄 = 对象指针
        @ @<结果> = ((double)sk_font_get_metrics((const sk_font_t*)@<句柄>, (sk_fontmetrics_t*)@<结果度量>.@n<Skia字体度量.数据>.GetPtr()));
        返回 (结果)
    }
}

# ============================================================
# 五、Skia文字块 / 文字块构建器
# ============================================================

类 Skia文字块 <公开 注释 = "排版结果(sk_textblob_t): 与 构建器 是两种不同句柄。ref 已导出, 可 加引用 后复用。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia文字块.对象指针>)
    }

    方法 加引用 <公开 注释 = "增加一份引用, 可安全复用; 与 释放 配对。" 折叠 @嵌入式方法 = "">
    {
        @ sk_textblob_ref((sk_textblob_t*)@sn<this>.@n<Skia文字块.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_textblob_unref((sk_textblob_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia文字块.对象指针> != 0)
    }

    方法 取唯一编号 <公开 类型 = 整数 注释 = "全进程唯一 32 位编号, 适合做缓存键。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_textblob_get_unique_id((const sk_textblob_t*)@sn<this>.@n<Skia文字块.对象指针>))
    }

    方法 取边界 <公开 类型 = 逻辑型 注释 = "文字外框(相对绘制原点)。">
    参数 结果矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_textblob_get_bounds((const sk_textblob_t*)@<句柄>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 取截线段 <公开 类型 = 整数 注释 = "纵向范围数据为上下两个值(8 字节); 结果区间数据每项 4 字节单精度; 返回区间个数(即字形数)。">
    参数 纵向范围数据 <类型 = 字节集类>
    参数 结果区间数据 <类型 = 字节集类>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_textblob_get_intercepts((const sk_textblob_t*)@<句柄>, (const float*)@<纵向范围数据>.GetPtr(), (float*)@<结果区间数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>));
        返回 (结果)
    }
}

类 Skia文字块构建器 <公开 注释 = "文字块构建器(sk_textblob_builder_t): 先 分配*run 拿到 32 字节缓冲的指针, 往里写字形/位置/簇, 再 生成 文字块。释放 不影响已 生成 的文字块。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia文字块构建器.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia文字块构建器 注释 = "静态; 创建文字块构建器。">
    {
        变量 结果 <类型 = Skia文字块构建器>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_textblob_builder_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁构建器; 不影响已 生成 的文字块; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_textblob_builder_delete((sk_textblob_builder_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia文字块构建器.对象指针> != 0)
    }

    方法 生成 <公开 类型 = Skia文字块 注释 = "把已分配的 run 组合成文字块; 生成后构建器仍可继续追加。">
    {
        变量 结果 <类型 = Skia文字块>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_textblob_builder_make((sk_textblob_builder_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 分配水平run <公开 类型 = 逻辑型 注释 = "所有字形共用一个起点的水平排版; 缓冲 32 字节结构体, 调用后其内部指针指向构建器内存, 直接往里写字形即可; 裁剪矩形可传空对象。">
    参数 字体 <类型 = Skia字体>
    参数 字形数 <类型 = 整数>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 裁剪矩形 <类型 = Skia矩形>
    参数 缓冲 <类型 = Skia文字块缓冲>
    {
        变量 句柄 <类型 = 变整数>
        变量 字体句柄 <类型 = 变整数>
        句柄 = 对象指针
        字体句柄 = 字体.对象指针
        @ sk_textblob_builder_alloc_run((sk_textblob_builder_t*)@<句柄>, (const sk_font_t*)@<字体句柄>, @<字形数>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_rect_t*)@<裁剪矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_textblob_builder_runbuffer_t*)@<缓冲>.@n<Skia文字块缓冲.数据>.GetPtr());
        返回 (真)
    }

    方法 分配水平run_按横坐标 <公开 类型 = 逻辑型 注释 = "每个字形单独 x(水平), 共用 y。">
    参数 字体 <类型 = Skia字体>
    参数 字形数 <类型 = 整数>
    参数 纵坐标 <类型 = 小数>
    参数 裁剪矩形 <类型 = Skia矩形>
    参数 缓冲 <类型 = Skia文字块缓冲>
    {
        变量 句柄 <类型 = 变整数>
        变量 字体句柄 <类型 = 变整数>
        句柄 = 对象指针
        字体句柄 = 字体.对象指针
        @ sk_textblob_builder_alloc_run_pos_h((sk_textblob_builder_t*)@<句柄>, (const sk_font_t*)@<字体句柄>, @<字形数>, (float)@<纵坐标>, (const sk_rect_t*)@<裁剪矩形>.@n<Skia矩形.数据>.GetPtr(), (sk_textblob_builder_runbuffer_t*)@<缓冲>.@n<Skia文字块缓冲.数据>.GetPtr());
        返回 (真)
    }

