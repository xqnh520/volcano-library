# ============================================================
# 六、Skia字体管理
# ============================================================

类 Skia字体管理 <公开 注释 = "系统字体管理器(sk_fontmgr_t): 取默认 拿到单例(返回时已加引用), 用完请 释放。这是「拿一个字体面」的标准入口。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字体管理.对象指针>)
    }

    方法 取默认 <公开 静态 类型 = Skia字体管理 注释 = "静态; 取系统字体管理器(内部单例, 返回时已加引用); 用完请 释放。">
    {
        变量 结果 <类型 = Skia字体管理>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_fontmgr_create_default();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用; 原生没有 ref, 一次取用一次释放; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_fontmgr_unref((sk_fontmgr_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia字体管理.对象指针> != 0)
    }

    方法 取字体族数量 <公开 类型 = 整数 注释 = "系统已装字族个数。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_fontmgr_count_families((sk_fontmgr_t*)@sn<this>.@n<Skia字体管理.对象指针>))
    }

    方法 取字体族名 <公开 类型 = 逻辑型 注释 = "序号 0 ~ 数量-1; 越界不写入; 结果字符串须已 新建。">
    参数 序号 <类型 = 整数>
    参数 结果字符串 <类型 = Skia字符串>
    {
        变量 句柄 <类型 = 变整数>
        变量 串句柄 <类型 = 变整数>
        句柄 = 对象指针
        串句柄 = 结果字符串.对象指针
        @ sk_fontmgr_get_family_name((sk_fontmgr_t*)@<句柄>, @<序号>, (sk_string_t*)@<串句柄>);
        返回 (真)
    }

    方法 取样式集 <公开 类型 = Skia字体样式集 注释 = "按族序号取该族全部字重; 失败返回空对象。">
    参数 序号 <类型 = 整数>
    {
        变量 结果 <类型 = Skia字体样式集>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_fontmgr_create_styleset((sk_fontmgr_t*)@<句柄>, @<序号>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 按族名取样式集 <公开 类型 = Skia字体样式集 注释 = "族名写中文(微软雅黑)或英文(Microsoft YaHei); 找不到返回空对象。">
