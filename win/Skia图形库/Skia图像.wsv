<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Skia <注释 = "Skia 图像域封装(批次2 第一部分): 支撑值类(整数尺寸/采样选项/解码选项/帧信息/PNG-JPEG-WebP编码选项) + 支撑句柄类(颜色空间/着色器/图像滤镜) + 表面属性 / 像素图 / 位图。图像/表面/编解码器/图片族见同文件后半部分。"
        注释 = "【必须显式释放】火山值类按值复制会共享同一原生句柄, 因此本文件所有句柄类的 类_清理 一律不做自动销毁 —— 谁创建谁调用 释放。忘记释放只会泄漏, 不会崩。"
        注释 = "【零拷贝风险提示】全模块共 5 个零拷贝入口(Skia画布.新建_按像素 / Skia图像.新建_按像素内存 / Skia表面.新建_光栅直通 / Skia位图.安装像素 / Skia位图.安装像素_按像素图): 它们不复制像素内存, 调用方必须保证该内存在对象存活期内一直有效, 提前释放会导致崩溃。不确定生命周期时请改用对应的安全拷贝版本(新建_按像素拷贝 / 新建_光栅 / 尝试分配像素)。原生 releaseProc 固定传 nullptr —— Skia 既不复制、也不释放、也不告警。"
        注释 = "【像素换算】32 位格式(BGRA_8888/RGBA_8888): 每像素 4 字节, 行字节数 = 宽 x 4, 整幅 = 宽 x 高 x 4; 16 位(RGB_565): 每像素 2 字节; 8 位(ALPHA_8/GRAY_8): 每像素 1 字节。默认格式 颜色类型 6 = BGRA_8888 + 透明度类型 2 = PREMUL。"
        @视窗.头文件搜寻目录 = "deps\\skia"
        @视窗.头文件搜寻目录 = "deps\\skia\\include\\c"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "skia_include.h">

# ============================================================
# 一、支撑值类
# ============================================================

类 Skia整数尺寸 <公开 注释 = "sk_isize_t: 整数宽高(8 字节)。偏移 0 宽(int32), 偏移 4 高(int32)。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "8 字节缓冲, 对应 sk_isize_t。">

    方法 类_初始化 <公开 注释 = "分配 8 字节缓冲。">
    {
        数据 = 取空白字节集 (8)
    }

    方法 置尺寸 <公开 类型 = 逻辑型 注释 = "一次写入 宽/高。" 折叠 @嵌入式方法 = "">
    参数 宽值 <类型 = 整数>
    参数 高值 <类型 = 整数>
    {
        @ ([&]() -> bool { sk_isize_t* __s = (sk_isize_t*)@sn<this>.@n<Skia整数尺寸.数据>.GetPtr(); __s->w = (int32_t)@<宽值>; __s->h = (int32_t)@<高值>; return true; }())
    }

    方法 宽 <公开 属性读 类型 = 整数 注释 = "宽度。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_isize_t*)@sn<this>.@n<Skia整数尺寸.数据>.GetPtr())->w)
    }

    方法 高 <公开 属性读 类型 = 整数 注释 = "高度。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_isize_t*)@sn<this>.@n<Skia整数尺寸.数据>.GetPtr())->h)
    }

    方法 置宽 <公开 类型 = 逻辑型 注释 = "设置宽度。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (((sk_isize_t*)@sn<this>.@n<Skia整数尺寸.数据>.GetPtr())->w = (int32_t)@<值>, true)
    }

    方法 置高 <公开 类型 = 逻辑型 注释 = "设置高度。" 折叠 @嵌入式方法 = "">
    参数 值 <类型 = 整数>
    {
        @ (((sk_isize_t*)@sn<this>.@n<Skia整数尺寸.数据>.GetPtr())->h = (int32_t)@<值>, true)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_isize_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia整数尺寸.数据>.GetPtr())
    }
}

类 Skia采样选项 <公开 注释 = "sk_sampling_options_t: 采样/重采样选项(24 字节)。偏移 0 最大各向异性(int), 4 使用三次插值(bool, 1 字节, 后 3 字节填充), 8 三次参数(8 字节), 16 过滤方式(int), 20 多级模式(int)。全 0 即「最近邻 + 无多级」。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "24 字节缓冲, 对应 sk_sampling_options_t。">

    方法 类_初始化 <公开 注释 = "分配 24 字节缓冲并清零(等于最近邻采样)。">
    {
        数据 = 取空白字节集 (24)
    }

    方法 置过滤 <公开 类型 = 逻辑型 注释 = "设置过滤方式(0 最近邻/1 线性)与多级模式(0 无/1 最近邻/2 线性)。形参带 值 后缀, 避免与同类只读属性方法重名。">
    参数 过滤方式值 <类型 = 整数>
    参数 多级模式值 <类型 = 整数 @默认值 = 0>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { sk_sampling_options_t* __o = (sk_sampling_options_t*)@<地址>; __o->fFilter = (sk_filter_mode_t)@<过滤方式值>; __o->fMipmap = (sk_mipmap_mode_t)@<多级模式值>; return true; }());
        返回 (真)
    }

    方法 置最大各向异性 <公开 类型 = 逻辑型 注释 = "设置最大各向异性采样数(0 或 1 = 关闭)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_sampling_options_t*)@<地址>)->fMaxAniso = @<值>, true);
        返回 (真)
    }

    方法 过滤方式 <公开 属性读 类型 = 整数 注释 = "过滤方式: 0 最近邻/1 线性。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_sampling_options_t*)@sn<this>.@n<Skia采样选项.数据>.GetPtr())->fFilter)
    }

    方法 多级模式 <公开 属性读 类型 = 整数 注释 = "多级模式: 0 无/1 最近邻/2 线性。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_sampling_options_t*)@sn<this>.@n<Skia采样选项.数据>.GetPtr())->fMipmap)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_sampling_options_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia采样选项.数据>.GetPtr())
    }
}

类 Skia解码选项 <公开 注释 = "sk_codec_options_t: 解码选项(32 字节)。偏移 0 零初始化标志(int), 8 子集矩形指针(8 字节), 16 帧序号(int), 20 前置帧(int), 24 最大解码内存(size_t)。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "32 字节缓冲, 对应 sk_codec_options_t。">

    方法 类_初始化 <公开 注释 = "分配 32 字节缓冲并清零(默认选项)。">
    {
        数据 = 取空白字节集 (32)
    }

    方法 置零初始化 <公开 类型 = 逻辑型 注释 = "设置 零初始化标志(0 不要求/1 要求像素缓冲先清零)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_codec_options_t*)@<地址>)->fZeroInitialized = (sk_codec_zero_initialized_t)@<值>, true);
        返回 (真)
    }

    方法 置帧序号 <公开 类型 = 逻辑型 注释 = "设置要解码的动画帧序号(单帧图传 0)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_codec_options_t*)@<地址>)->fFrameIndex = @<值>, true);
        返回 (真)
    }

    方法 置子集矩形 <公开 类型 = 逻辑型 注释 = "设置只解码 子集矩形 内的区域(传空对象 = 不限制)。">
    参数 子集矩形 <类型 = Skia整数矩形>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_codec_options_t*)@<地址>)->fSubset = (sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr(), true);
        返回 (真)
    }

    方法 置最大解码内存 <公开 类型 = 逻辑型 注释 = "设置解码过程允许申请的最大字节数(0 = 不限制)。">
    参数 值 <类型 = 变整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_codec_options_t*)@<地址>)->fMaxDecodeMemory = (size_t)@<值>, true);
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_codec_options_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia解码选项.数据>.GetPtr())
    }
}

类 Skia帧信息 <公开 注释 = "sk_codec_frameinfo_t: 动画帧描述(44 字节)。偏移 0 前置帧(int), 4 时长(毫秒, int), 8 是否完全接收(bool), 12 透明度类型(int), 16 边界内是否含透明(bool), 20 处置方式(int), 24 混合方式(int), 28 帧矩形(sk_irect_t, 16 字节)。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "44 字节缓冲, 对应 sk_codec_frameinfo_t。">

    方法 类_初始化 <公开 注释 = "分配 44 字节缓冲并清零。">
    {
        数据 = 取空白字节集 (44)
    }

    方法 时长 <公开 属性读 类型 = 整数 注释 = "本帧显示时长(毫秒)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_codec_frameinfo_t*)@sn<this>.@n<Skia帧信息.数据>.GetPtr())->fDuration)
    }

    方法 前置帧 <公开 属性读 类型 = 整数 注释 = "本帧所依赖的前置帧序号(-1 表示无依赖)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_codec_frameinfo_t*)@sn<this>.@n<Skia帧信息.数据>.GetPtr())->fRequiredFrame)
    }

    方法 透明度类型 <公开 属性读 类型 = 整数 注释 = "透明度类型: 1 不透明/2 预乘/3 非预乘。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_codec_frameinfo_t*)@sn<this>.@n<Skia帧信息.数据>.GetPtr())->fAlphaType)
    }

    方法 处置方式 <公开 属性读 类型 = 整数 注释 = "帧处置方式(1 保留/2 恢复背景/3 恢复上一帧)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_codec_frameinfo_t*)@sn<this>.@n<Skia帧信息.数据>.GetPtr())->fDisposalMethod)
    }

    方法 混合方式 <公开 属性读 类型 = 整数 注释 = "帧混合方式(0 源覆盖/1 源)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_codec_frameinfo_t*)@sn<this>.@n<Skia帧信息.数据>.GetPtr())->fBlend)
    }

    方法 帧矩形 <公开 类型 = 逻辑型 注释 = "把本帧的矩形写入 结果矩形(默认用 fFrameRect 描述位置)。">
    参数 结果矩形 <类型 = Skia整数矩形>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (*((sk_irect_t*)@<结果矩形>.@n<Skia整数矩形.数据>.GetPtr()) = ((const sk_codec_frameinfo_t*)@<地址>)->fFrameRect, true);
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_codec_frameinfo_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia帧信息.数据>.GetPtr())
    }
}

类 SkiaPNG编码选项 <公开 注释 = "sk_pngencoder_options_t: PNG 编码选项(32 字节)。偏移 0 过滤标志(int), 4 ZLib 压缩等级(int, 0~9), 8 注释指针, 16 增益图指针, 24 增益图信息指针。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "32 字节缓冲, 对应 sk_pngencoder_options_t。">

    方法 类_初始化 <公开 注释 = "分配 32 字节缓冲并清零(默认选项)。">
    {
        数据 = 取空白字节集 (32)
    }

    方法 置ZLib等级 <公开 类型 = 逻辑型 注释 = "设置 zlib 压缩等级 0~9(默认 6, 越大越小越慢)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_pngencoder_options_t*)@<地址>)->fZLibLevel = @<值>, true);
        返回 (真)
    }

    方法 置过滤标志 <公开 类型 = 逻辑型 注释 = "设置行过滤标志位(0 = 默认)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_pngencoder_options_t*)@<地址>)->fFilterFlags = (sk_pngencoder_filterflags_t)@<值>, true);
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_pngencoder_options_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<SkiaPNG编码选项.数据>.GetPtr())
    }
}

类 SkiaJPEG编码选项 <公开 注释 = "sk_jpegencoder_options_t: JPEG 编码选项(32 字节)。偏移 0 质量(int, 0~100), 4 降采样(int), 8 透明度选项(int, 0 忽略/1 与黑混合), 16 xmp 元数据指针, 24 原点方向(int32), 28 是否有原点(bool)。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "32 字节缓冲, 对应 sk_jpegencoder_options_t。">

    方法 类_初始化 <公开 注释 = "分配 32 字节缓冲并清零; 质量 0 表示由 Skia 取默认(100)。">
    {
        数据 = 取空白字节集 (32)
    }

    方法 置质量 <公开 类型 = 逻辑型 注释 = "设置质量 0~100(越大越好越慢)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_jpegencoder_options_t*)@<地址>)->fQuality = @<值>, true);
        返回 (真)
    }

    方法 置降采样 <公开 类型 = 逻辑型 注释 = "设置色度降采样(0 默认/1 4:4:4/2 4:2:2/3 4:2:0)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_jpegencoder_options_t*)@<地址>)->fDownsample = (sk_jpegencoder_downsample_t)@<值>, true);
        返回 (真)
    }

    方法 置透明度选项 <公开 类型 = 逻辑型 注释 = "设置 alpha 处理(0 忽略/1 与黑背景混合)。">
    参数 值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_jpegencoder_options_t*)@<地址>)->fAlphaOption = (sk_jpegencoder_alphaoption_t)@<值>, true);
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_jpegencoder_options_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<SkiaJPEG编码选项.数据>.GetPtr())
    }
}

类 SkiaWebP编码选项 <公开 注释 = "sk_webpencoder_options_t: WebP 编码选项(8 字节)。偏移 0 压缩方式(int, 0 有损/1 无损), 4 质量(单精度 0~100)。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "8 字节缓冲, 对应 sk_webpencoder_options_t。">

    方法 类_初始化 <公开 注释 = "分配 8 字节缓冲并清零(有损 + 质量 0)。">
    {
        数据 = 取空白字节集 (8)
    }

    方法 置压缩 <公开 类型 = 逻辑型 注释 = "设置压缩方式 0 有损/1 无损 与质量 0~100。">
    参数 压缩方式 <类型 = 整数>
    参数 质量 <类型 = 小数 @默认值 = 100.0>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { sk_webpencoder_options_t* __o = (sk_webpencoder_options_t*)@<地址>; __o->fCompression = (sk_webpencoder_compression_t)@<压缩方式>; __o->fQuality = (float)@<质量>; return true; }());
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_webpencoder_options_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<SkiaWebP编码选项.数据>.GetPtr())
    }
}

# ============================================================
# 二、支撑句柄类(颜色空间 / 着色器 / 图像滤镜)
# ============================================================




# ============================================================
# 三、Skia表面属性
# ============================================================

类 Skia表面属性 <公开 注释 = "表面属性(sk_surfaceprops_t, 不透明句柄): 描述字体是否与设备无关、像素排列方向。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效(多数接口可传 0 = 默认)。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia表面属性.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia表面属性 注释 = "静态; 标志 0 无/1 使用设备无关字体; 像素排列 0 未知/1 RGB横向/2 BGR横向/3 RGB纵向/4 BGR纵向。">
    参数 标志 <类型 = 整数>
    参数 像素排列 <类型 = 整数>
    {
        变量 结果 <类型 = Skia表面属性>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_surfaceprops_new((uint32_t)@<标志>, (sk_pixelgeometry_t)@<像素排列>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_surfaceprops_delete((sk_surfaceprops_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia表面属性.对象指针> != 0)
    }

    方法 取标志 <公开 类型 = 整数 注释 = "0 无/1 使用设备无关字体。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_surfaceprops_get_flags((sk_surfaceprops_t*)@sn<this>.@n<Skia表面属性.对象指针>))
    }

    方法 取像素排列 <公开 类型 = 整数 注释 = "0 未知/1 RGB横向/2 BGR横向/3 RGB纵向/4 BGR纵向。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_surfaceprops_get_pixel_geometry((sk_surfaceprops_t*)@sn<this>.@n<Skia表面属性.对象指针>))
    }
}

# ============================================================
# 四、Skia像素图(内存视图, 不拥有像素)
# ============================================================

类 Skia像素图 <公开 注释 = "像素图(sk_pixmap_t): 只是一段像素内存的「格式+地址」视图, 不拥有内存, 释放 不会释放像素。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia像素图.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia像素图 注释 = "静态; 空像素图(尚未指向任何内存)。">
    {
        变量 结果 <类型 = Skia像素图>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_pixmap_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按参数 <公开 静态 类型 = Skia像素图 注释 = "静态; 零拷贝把一段内存当作像素图; 行字节数传 0 表示紧凑排列; 数据地址传 0 表示只描述格式不绑定内存。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 数据地址 <类型 = 变整数>
    参数 行字节数 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia像素图>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_pixmap_new_with_params((const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (const void*)@<数据地址>, (size_t)@<行字节数>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "只销毁视图, 不释放它指向的像素内存; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_pixmap_destructor((sk_pixmap_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia像素图.对象指针> != 0)
    }

    方法 重置 <公开 注释 = "解绑内存并清成空视图。" 折叠 @嵌入式方法 = "">
    {
        @ sk_pixmap_reset((sk_pixmap_t*)@sn<this>.@n<Skia像素图.对象指针>)
    }

    方法 重置_按参数 <公开 类型 = 逻辑型 注释 = "复用本对象重新绑定内存(语义同 新建_按参数)。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 数据地址 <类型 = 变整数>
    参数 行字节数 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pixmap_reset_with_params((sk_pixmap_t*)@<句柄>, (const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (const void*)@<数据地址>, (size_t)@<行字节数>);
        返回 (真)
    }

    方法 置颜色空间 <公开 类型 = 逻辑型 注释 = "设置颜色空间; 传空对象表示恢复默认 sRGB。">
    参数 颜色空间 <类型 = Skia颜色空间>
    {
        变量 句柄 <类型 = 变整数>
        变量 色句柄 <类型 = 变整数>
        句柄 = 对象指针
        色句柄 = 颜色空间.对象指针
        @ sk_pixmap_set_colorspace((sk_pixmap_t*)@<句柄>, (sk_colorspace_t*)@<色句柄>);
        返回 (真)
    }

    方法 取子集 <公开 类型 = 逻辑型 注释 = "零拷贝裁剪视图, 写入 结果像素图; 子集须在范围内。">
    参数 结果像素图 <类型 = Skia像素图>
    参数 子集矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 结果像素图.对象指针
        @ @<结果> = (sk_pixmap_extract_subset((const sk_pixmap_t*)@<句柄>, (sk_pixmap_t*)@<目标句柄>, (const sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取图像信息 <公开 类型 = 逻辑型 注释 = "把格式与尺寸写入 结果信息(须已初始化)。">
    参数 结果信息 <类型 = Skia图像信息>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pixmap_get_info((const sk_pixmap_t*)@<句柄>, (sk_imageinfo_t*)@<结果信息>.@n<Skia图像信息.数据>.GetPtr());
        返回 (真)
    }

    方法 取颜色空间 <公开 类型 = Skia颜色空间 注释 = "取本像素图记录的颜色空间; 返回借用对象(是否拥有句柄=假), 不要释放。">
    {
        变量 结果 <类型 = Skia颜色空间>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_pixmap_get_colorspace((const sk_pixmap_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 取行字节数 <公开 类型 = 变整数 注释 = "每行字节数(32 位格式通常 = 宽 x 4)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_pixmap_get_row_bytes((const sk_pixmap_t*)@sn<this>.@n<Skia像素图.对象指针>))
    }

    方法 计算是否不透明 <公开 类型 = 逻辑型 注释 = "扫描全部像素判定是否完全不透明(较慢)。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_pixmap_compute_is_opaque((const sk_pixmap_t*)@sn<this>.@n<Skia像素图.对象指针>) != 0)
    }

    方法 取像素颜色 <公开 类型 = 整数 注释 = "取指定像素的 ARGB 32 位颜色; 越界返回 0。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((int)sk_pixmap_get_pixel_color((const sk_pixmap_t*)@sn<this>.@n<Skia像素图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 取像素浮点颜色 <公开 类型 = 逻辑型 注释 = "取像素的 0~1 浮点颜色写入 结果颜色(顺序 R,G,B,A)。">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    参数 结果颜色 <类型 = Skia浮点颜色>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_pixmap_get_pixel_color4f((const sk_pixmap_t*)@<句柄>, @<横坐标>, @<纵坐标>, (sk_color4f_t*)@<结果颜色>.@n<Skia浮点颜色.数据>.GetPtr());
        返回 (真)
    }

    方法 取像素透明度 <公开 类型 = 小数 注释 = "取像素 alpha(0.0~1.0)。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((double)sk_pixmap_get_pixel_alphaf((const sk_pixmap_t*)@sn<this>.@n<Skia像素图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 取可写地址 <公开 类型 = 变整数 注释 = "首像素裸地址(可写); 空视图返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_pixmap_get_writable_addr((const sk_pixmap_t*)@sn<this>.@n<Skia像素图.对象指针>))
    }

    方法 取可写地址_按坐标 <公开 类型 = 变整数 注释 = "指定像素的裸地址; 原生拼写为 writeable(多一个 e)。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((intptr_t)sk_pixmap_get_writeable_addr_with_xy((const sk_pixmap_t*)@sn<this>.@n<Skia像素图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 读取像素 <公开 类型 = 逻辑型 注释 = "按 目标信息 的格式把像素写入 像素数据(可做格式转换); 像素数据长度须 ≥ 行字节数 x 目标信息.高()。">
    参数 目标信息 <类型 = Skia图像信息>
    参数 像素数据 <类型 = 字节集类>
    参数 行字节数 <类型 = 变整数>
    参数 源X <类型 = 整数>
    参数 源Y <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_pixmap_read_pixels((const sk_pixmap_t*)@<句柄>, (const sk_imageinfo_t*)@<目标信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素数据>.GetPtr(), (size_t)@<行字节数>, @<源X>, @<源Y>) != 0);
        返回 (结果)
    }

    方法 缩放像素 <公开 类型 = 逻辑型 注释 = "重采样到 目标像素图; 采样可传空对象(默认最近邻)。">
    参数 目标像素图 <类型 = Skia像素图>
    参数 采样 <类型 = Skia采样选项>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 目标像素图.对象指针
        @ @<结果> = (sk_pixmap_scale_pixels((const sk_pixmap_t*)@<句柄>, (const sk_pixmap_t*)@<目标句柄>, (const sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 擦除颜色 <公开 类型 = 逻辑型 注释 = "把 子集矩形 区域填成指定 ARGB 颜色(不做混合)。">
    参数 颜色值 <类型 = 整数>
    参数 子集矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_pixmap_erase_color((const sk_pixmap_t*)@<句柄>, (sk_color_t)@<颜色值>, (const sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 擦除浮点颜色 <公开 类型 = 逻辑型 注释 = "浮点颜色版本的区域擦除。">
    参数 颜色 <类型 = Skia浮点颜色>
    参数 子集矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_pixmap_erase_color4f((const sk_pixmap_t*)@<句柄>, (const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr(), (const sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }
}

# ============================================================
# 五、Skia位图(拥有像素)
# ============================================================

类 Skia位图 <公开 注释 = "位图(sk_bitmap_t): 自己拥有像素内存(尝试分配像素)或接管外部内存(安装像素)。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia位图.对象指针>)
    }

    方法 新建 <公开 静态 类型 = Skia位图 注释 = "静态; 空位图, 需先 尝试分配像素 或 安装像素。">
    {
        变量 结果 <类型 = Skia位图>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_bitmap_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁位图(并释放它自己拥有的像素); 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_bitmap_destructor((sk_bitmap_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia位图.对象指针> != 0)
    }

    方法 取图像信息 <公开 类型 = 逻辑型 注释 = "把格式与尺寸写入 结果信息(须已初始化)。">
    参数 结果信息 <类型 = Skia图像信息>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_bitmap_get_info((sk_bitmap_t*)@<句柄>, (sk_imageinfo_t*)@<结果信息>.@n<Skia图像信息.数据>.GetPtr());
        返回 (真)
    }

    方法 取像素地址 <公开 类型 = 变整数 注释 = "可写像素裸地址; 结果长度 需 8 字节缓冲, 内部写入总字节数(size_t); 空位图返回 0。">
    参数 结果长度 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 变整数>
        句柄 = 对象指针
        @ @<结果> = ((intptr_t)sk_bitmap_get_pixels((sk_bitmap_t*)@<句柄>, (size_t*)@<结果长度>.GetPtr()));
        返回 (结果)
    }

    方法 取行字节数 <公开 类型 = 变整数 注释 = "每行字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_bitmap_get_row_bytes((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>))
    }

    方法 取字节数 <公开 类型 = 变整数 注释 = "整幅字节数 = 行字节数 x 高。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_bitmap_get_byte_count((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>))
    }

    方法 重置 <公开 注释 = "释放像素并清成空位图。" 折叠 @嵌入式方法 = "">
    {
        @ sk_bitmap_reset((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>)
    }

    方法 是否为空 <公开 类型 = 逻辑型 注释 = "没有像素或宽高为 0 时为真。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_bitmap_is_null((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>) != 0)
    }

    方法 是否不可变 <公开 类型 = 逻辑型 注释 = "为真时不能再改像素。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_bitmap_is_immutable((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>) != 0)
    }

    方法 置不可变 <公开 注释 = "冻结像素, 不可逆。" 折叠 @嵌入式方法 = "">
    {
        @ sk_bitmap_set_immutable((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>)
    }

    方法 填充颜色 <公开 注释 = "整幅填色(直接写入, 不做混合)。" 折叠 @嵌入式方法 = "">
    参数 颜色值 <类型 = 整数>
    {
        @ sk_bitmap_erase((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>, (sk_color_t)@<颜色值>)
    }

    方法 填充矩形 <公开 类型 = 逻辑型 注释 = "只填指定整数像素区域。">
    参数 颜色值 <类型 = 整数>
    参数 矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_bitmap_erase_rect((sk_bitmap_t*)@<句柄>, (sk_color_t)@<颜色值>, (sk_irect_t*)@<矩形>.@n<Skia整数矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "该像素的裸地址(未按格式解释); 越界返回 0。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((intptr_t)sk_bitmap_get_addr((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 取地址_八位 <公开 类型 = 变整数 注释 = "按 8 位像素解释的地址。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((intptr_t)sk_bitmap_get_addr_8((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 取地址_十六位 <公开 类型 = 变整数 注释 = "按 16 位像素解释的地址。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((intptr_t)sk_bitmap_get_addr_16((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 取地址_三十二位 <公开 类型 = 变整数 注释 = "按 32 位像素解释的地址(最常用)。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((intptr_t)sk_bitmap_get_addr_32((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 取像素颜色 <公开 类型 = 整数 注释 = "取 ARGB 32 位颜色; 越界返回 0。" 折叠 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ ((int)sk_bitmap_get_pixel_color((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>, @<横坐标>, @<纵坐标>))
    }

    方法 取全部像素颜色 <公开 类型 = 逻辑型 注释 = "按行优先写入 宽 x 高 个 ARGB 值; 结果数据须 ≥ 宽 x 高 x 4 字节。">
    参数 结果数据 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_bitmap_get_pixel_colors((sk_bitmap_t*)@<句柄>, (sk_color_t*)@<结果数据>.GetPtr());
        返回 (真)
    }

    方法 是否可绘制 <公开 类型 = 逻辑型 注释 = "格式与像素都已就绪时为真。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_bitmap_ready_to_draw((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>) != 0)
    }

    方法 尝试分配像素 <公开 类型 = 逻辑型 注释 = "安全入口: 由 Skia 自己分配像素内存(行字节数传 0 表示紧凑排列)。注意原生名是 try_alloc_pixels, 没有 alloc_pixels。">
    参数 请求信息 <类型 = Skia图像信息>
    参数 行字节数 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_bitmap_try_alloc_pixels((sk_bitmap_t*)@<句柄>, (const sk_imageinfo_t*)@<请求信息>.@n<Skia图像信息.数据>.GetPtr(), (size_t)@<行字节数>) != 0);
        返回 (结果)
    }

    方法 尝试分配像素_按标志 <公开 类型 = 逻辑型 注释 = "由 Skia 分配像素; 标志 0 无/1 像素清零; 行字节数自动紧凑。">
    参数 请求信息 <类型 = Skia图像信息>
    参数 标志 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_bitmap_try_alloc_pixels_with_flags((sk_bitmap_t*)@<句柄>, (const sk_imageinfo_t*)@<请求信息>.@n<Skia图像信息.数据>.GetPtr(), (uint32_t)@<标志>) != 0);
        返回 (结果)
    }

    方法 安装像素 <公开 类型 = 逻辑型 注释 = "⚠ 不复制像素内存：调用方必须保证该内存在对象存活期内一直有效，提前释放会导致崩溃。原生 releaseProc 固定传 nullptr —— Skia 不会替你释放这块内存, 也不会告警。不确定生命周期时请改用 尝试分配像素(自己分配) 或 Skia图像.新建_按像素拷贝(完整复制一份)。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 像素地址 <类型 = 变整数>
    参数 行字节数 <类型 = 变整数>
    参数 上下文 <类型 = 变整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_bitmap_install_pixels((sk_bitmap_t*)@<句柄>, (const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素地址>, (size_t)@<行字节数>, nullptr, (void*)@<上下文>) != 0);
        返回 (结果)
    }

    方法 安装像素_按像素图 <公开 类型 = 逻辑型 注释 = "⚠ 不复制像素内存：调用方必须保证该内存在对象存活期内一直有效，提前释放会导致崩溃。像素图只是内存视图, 它指向的像素必须活得比本对象久; 需要独立副本请用 尝试分配像素 + 取像素地址 自行拷贝。">
    参数 像素图 <类型 = Skia像素图>
    {
        变量 句柄 <类型 = 变整数>
        变量 图句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        图句柄 = 像素图.对象指针
        @ @<结果> = (sk_bitmap_install_pixels_with_pixmap((sk_bitmap_t*)@<句柄>, (const sk_pixmap_t*)@<图句柄>) != 0);
        返回 (结果)
    }

    方法 置像素地址 <公开 类型 = 逻辑型 注释 = "只替换像素指针, 沿用已有格式与尺寸; 不接管所有权。">
    参数 像素地址 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_bitmap_set_pixels((sk_bitmap_t*)@<句柄>, (void*)@<像素地址>);
        返回 (真)
    }

    方法 窥视像素 <公开 类型 = 逻辑型 注释 = "零拷贝取出像素视图写入 像素图。">
    参数 像素图 <类型 = Skia像素图>
    {
        变量 句柄 <类型 = 变整数>
        变量 图句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        图句柄 = 像素图.对象指针
        @ @<结果> = (sk_bitmap_peek_pixels((sk_bitmap_t*)@<句柄>, (sk_pixmap_t*)@<图句柄>) != 0);
        返回 (结果)
    }

    方法 取子集 <公开 类型 = 逻辑型 注释 = "裁剪到目标位图(共享像素); 子集须在范围内。">
    参数 目标位图 <类型 = Skia位图>
    参数 子集矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 目标位图.对象指针
        @ @<结果> = (sk_bitmap_extract_subset((sk_bitmap_t*)@<句柄>, (sk_bitmap_t*)@<目标句柄>, (sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取透明通道 <公开 类型 = 逻辑型 注释 = "抽取 alpha 成 8 位图写入 目标位图; 结果偏移 输出原点相对位置。">
    参数 目标位图 <类型 = Skia位图>
    参数 画笔 <类型 = Skia画笔>
    参数 结果偏移 <类型 = Skia整数点>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 目标位图.对象指针
        @ @<结果> = (sk_bitmap_extract_alpha((sk_bitmap_t*)@<句柄>, (sk_bitmap_t*)@<目标句柄>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>, (sk_ipoint_t*)@<结果偏移>.@n<Skia整数点.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 通知像素已变 <公开 注释 = "手动改过像素后必须调用, 否则缓存(如着色器)保持旧内容。" 折叠 @嵌入式方法 = "">
    {
        @ sk_bitmap_notify_pixels_changed((sk_bitmap_t*)@sn<this>.@n<Skia位图.对象指针>)
    }

    方法 交换 <公开 类型 = 逻辑型 注释 = "两个位图互换内容(不拷贝像素, 只交换指针)。">
    参数 另位图 <类型 = Skia位图>
    {
        变量 句柄 <类型 = 变整数>
        变量 另一位句柄 <类型 = 变整数>
        句柄 = 对象指针
        另一位句柄 = 另位图.对象指针
        @ sk_bitmap_swap((sk_bitmap_t*)@<句柄>, (sk_bitmap_t*)@<另一位句柄>);
        返回 (真)
    }

    方法 取着色器 <公开 类型 = Skia着色器 注释 = "用本位图做纹理; 平铺 0 钳制/1 重复/2 镜像/3 贴花。">
    参数 平铺X <类型 = 整数>
    参数 平铺Y <类型 = 整数>
    参数 采样 <类型 = Skia采样选项>
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 结果 <类型 = Skia着色器>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_bitmap_make_shader((sk_bitmap_t*)@<句柄>, (sk_shader_tilemode_t)@<平铺X>, (sk_shader_tilemode_t)@<平铺Y>, (sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr(), (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}

# ============================================================
# 六、Skia图像(不可变像素)
# ============================================================

类 Skia图像 <公开 注释 = "不可变图像(sk_image_t): 像素建图、编码数据惰性解码、图片渲染结果都靠它。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia图像.对象指针>)
    }

    方法 新建_按像素拷贝 <公开 静态 类型 = Skia图像 注释 = "静态; 最常用的安全入口 —— 完整复制一份像素建图。行字节数传 0 表示紧凑排列。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 像素数据 <类型 = 字节集类>
    参数 行字节数 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia图像>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_image_new_raster_copy((const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (const void*)@<像素数据>.GetPtr(), (size_t)@<行字节数>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按像素图拷贝 <公开 静态 类型 = Skia图像 注释 = "静态; 按像素图的格式与内容拷贝建图。">
    参数 像素图 <类型 = Skia像素图>
    {
        变量 结果 <类型 = Skia图像>
        变量 图句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        图句柄 = 像素图.对象指针
        @ @<新指针> = (intptr_t)sk_image_new_raster_copy_with_pixmap((const sk_pixmap_t*)@<图句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按数据 <公开 静态 类型 = Skia图像 注释 = "静态; 零拷贝持有 Skia数据(靠引用计数保活), 行字节数传 0 表示紧凑排列。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 像素数据 <类型 = Skia数据>
    参数 行字节数 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia图像>
        变量 数据句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        数据句柄 = 像素数据.对象指针
        @ @<新指针> = (intptr_t)sk_image_new_raster_data((const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (sk_data_t*)@<数据句柄>, (size_t)@<行字节数>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按像素内存 <公开 静态 类型 = Skia图像 注释 = "⚠ 不复制像素内存：调用方必须保证该内存在对象存活期内一直有效，提前释放会导致崩溃。原生 releaseProc 固定传 nullptr —— Skia 不会替你释放这块内存, 也不会告警。不确定生命周期时请改用 新建_按像素拷贝(完整复制一份, 最安全)。">
    参数 像素图 <类型 = Skia像素图>
    参数 上下文 <类型 = 变整数 @默认值 = 0>
    {
        变量 结果 <类型 = Skia图像>
        变量 图句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        图句柄 = 像素图.对象指针
        @ @<新指针> = (intptr_t)sk_image_new_raster((const sk_pixmap_t*)@<图句柄>, nullptr, (void*)@<上下文>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按位图 <公开 静态 类型 = Skia图像 注释 = "静态; 持有位图像素的不可变快照。">
    参数 位图 <类型 = Skia位图>
    {
        变量 结果 <类型 = Skia图像>
        变量 位图句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        位图句柄 = 位图.对象指针
        @ @<新指针> = (intptr_t)sk_image_new_from_bitmap((const sk_bitmap_t*)@<位图句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按编码数据 <公开 静态 类型 = Skia图像 注释 = "静态; 惰性解码 PNG/JPEG/WebP/GIF 等; 数据非法时返回空对象。">
    参数 编码数据 <类型 = Skia数据>
    {
        变量 结果 <类型 = Skia图像>
        变量 数据句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        数据句柄 = 编码数据.对象指针
        @ @<新指针> = (intptr_t)sk_image_new_from_encoded((const sk_data_t*)@<数据句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按图片 <公开 静态 类型 = Skia图像 注释 = "静态; 把录制命令渲染成图像; 颜色空间传 0 表示 sRGB。">
    参数 图片 <类型 = Skia图片>
    参数 尺寸 <类型 = Skia整数尺寸>
    参数 矩阵 <类型 = Skia矩阵>
    参数 画笔 <类型 = Skia画笔>
    参数 是否浮点位深 <类型 = 逻辑型 @默认值 = 假>
    参数 颜色空间 <类型 = Skia颜色空间>
    参数 表面属性 <类型 = Skia表面属性>
    {
        变量 结果 <类型 = Skia图像>
        变量 图句柄 <类型 = 变整数>
        变量 色句柄 <类型 = 变整数>
        变量 属性句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        图句柄 = 图片.对象指针
        色句柄 = 颜色空间.对象指针
        属性句柄 = 表面属性.对象指针
        @ @<新指针> = (intptr_t)sk_image_new_from_picture((sk_picture_t*)@<图句柄>, (const sk_isize_t*)@<尺寸>.@n<Skia整数尺寸.数据>.GetPtr(), (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>, (bool)@<是否浮点位深>, (sk_colorspace_t*)@<色句柄>, (const sk_surfaceprops_t*)@<属性句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 加引用 <公开 注释 = "增加一个引用计数; 与 释放 配对(本类型独有, 其它类型无 ref)。" 折叠 @嵌入式方法 = "">
    {
        @ sk_image_ref((sk_image_t*)@sn<this>.@n<Skia图像.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_image_unref((sk_image_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia图像.对象指针> != 0)
    }

    方法 取宽 <公开 类型 = 整数 注释 = "宽度(像素); 无效图像返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_image_get_width((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>))
    }

    方法 取高 <公开 类型 = 整数 注释 = "高度(像素); 无效图像返回 0。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_image_get_height((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>))
    }

    方法 取唯一编号 <公开 类型 = 整数 注释 = "全进程唯一的 32 位编号, 常作缓存键。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_image_get_unique_id((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>))
    }

    方法 取透明度类型 <公开 类型 = 整数 注释 = "0 未知/1 不透明/2 预乘/3 非预乘。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_image_get_alpha_type((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>))
    }

    方法 取颜色类型 <公开 类型 = 整数 注释 = "6 = BGRA_8888 表示可直接当 DIB 用。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_image_get_color_type((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>))
    }

    方法 取颜色空间 <公开 类型 = Skia颜色空间 注释 = "返回借用对象(是否拥有句柄=假), 不要释放; 未设置时为空对象。">
    {
        变量 结果 <类型 = Skia颜色空间>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_image_get_colorspace((const sk_image_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 是否纯透明通道 <公开 类型 = 逻辑型 注释 = "为真表示只有 alpha 没有颜色。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_image_is_alpha_only((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>) != 0)
    }

    方法 取着色器 <公开 类型 = Skia着色器 注释 = "用本图像做纹理; 平铺 0 钳制/1 重复/2 镜像/3 贴花。">
    参数 平铺X <类型 = 整数>
    参数 平铺Y <类型 = 整数>
    参数 采样 <类型 = Skia采样选项>
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 结果 <类型 = Skia着色器>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_image_make_shader((const sk_image_t*)@<句柄>, (sk_shader_tilemode_t)@<平铺X>, (sk_shader_tilemode_t)@<平铺Y>, (const sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr(), (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取原始着色器 <公开 类型 = Skia着色器 注释 = "与 取着色器 的区别是不做 sRGB 转换(调色板类纹理用)。">
    参数 平铺X <类型 = 整数>
    参数 平铺Y <类型 = 整数>
    参数 采样 <类型 = Skia采样选项>
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 结果 <类型 = Skia着色器>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_image_make_raw_shader((const sk_image_t*)@<句柄>, (sk_shader_tilemode_t)@<平铺X>, (sk_shader_tilemode_t)@<平铺Y>, (const sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr(), (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 窥视像素 <公开 类型 = 逻辑型 注释 = "零拷贝把像素视图写入 像素图; 仅当图像本来就持有光栅像素时成功。">
    参数 像素图 <类型 = Skia像素图>
    {
        变量 句柄 <类型 = 变整数>
        变量 图句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        图句柄 = 像素图.对象指针
        @ @<结果> = (sk_image_peek_pixels((const sk_image_t*)@<句柄>, (sk_pixmap_t*)@<图句柄>) != 0);
        返回 (结果)
    }

    方法 是否纹理后端 <公开 类型 = 逻辑型 注释 = "CPU 光栅图像恒为假。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_image_is_texture_backed((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>) != 0)
    }

    方法 是否惰性生成 <公开 类型 = 逻辑型 注释 = "由编码数据创建且尚未解码时为真。" 折叠 @嵌入式方法 = "">
    {
        @ (sk_image_is_lazy_generated((const sk_image_t*)@sn<this>.@n<Skia图像.对象指针>) != 0)
    }

    方法 读取像素 <公开 类型 = 逻辑型 注释 = "按 目标信息 的格式读出像素; 像素数据长度须 ≥ 行字节数 x 目标信息.高(); 缓存提示 0 允许/1 不允许。">
    参数 目标信息 <类型 = Skia图像信息>
    参数 像素数据 <类型 = 字节集类>
    参数 行字节数 <类型 = 变整数>
    参数 源X <类型 = 整数>
    参数 源Y <类型 = 整数>
    参数 缓存提示 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_image_read_pixels((const sk_image_t*)@<句柄>, (const sk_imageinfo_t*)@<目标信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素数据>.GetPtr(), (size_t)@<行字节数>, @<源X>, @<源Y>, (sk_image_caching_hint_t)@<缓存提示>) != 0);
        返回 (结果)
    }

    方法 读取像素到像素图 <公开 类型 = 逻辑型 注释 = "目标像素图须已指向足够大的内存。">
    参数 目标像素图 <类型 = Skia像素图>
    参数 源X <类型 = 整数>
    参数 源Y <类型 = 整数>
    参数 缓存提示 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 目标像素图.对象指针
        @ @<结果> = (sk_image_read_pixels_into_pixmap((const sk_image_t*)@<句柄>, (const sk_pixmap_t*)@<目标句柄>, @<源X>, @<源Y>, (sk_image_caching_hint_t)@<缓存提示>) != 0);
        返回 (结果)
    }

    方法 缩放像素 <公开 类型 = 逻辑型 注释 = "高质量重采样到 目标像素图; 采样可传空对象。">
    参数 目标像素图 <类型 = Skia像素图>
    参数 采样 <类型 = Skia采样选项>
    参数 缓存提示 <类型 = 整数 @默认值 = 0>
    {
        变量 句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        目标句柄 = 目标像素图.对象指针
        @ @<结果> = (sk_image_scale_pixels((const sk_image_t*)@<句柄>, (const sk_pixmap_t*)@<目标句柄>, (const sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr(), (sk_image_caching_hint_t)@<缓存提示>) != 0);
        返回 (结果)
    }

    方法 取编码数据 <公开 类型 = Skia数据 注释 = "取回创建本图像时的原始编码字节(如原始 PNG); 无编码数据时返回空对象。">
    {
        变量 结果 <类型 = Skia数据>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_image_ref_encoded((const sk_image_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取子集 <公开 类型 = Skia图像 注释 = "裁剪出子图(共享像素, 不拷贝); 子集须在图像范围内。">
    参数 子集矩形 <类型 = Skia整数矩形>
    {
        变量 结果 <类型 = Skia图像>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_image_make_subset_raster((const sk_image_t*)@<句柄>, (const sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 转为非纹理图像 <公开 类型 = Skia图像 注释 = "脱离纹理后端。">
    {
        变量 结果 <类型 = Skia图像>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_image_make_non_texture_image((const sk_image_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 转为光栅图像 <公开 类型 = Skia图像 注释 = "强制解码成 CPU 光栅, 之后 窥视像素 才会成功。">
    {
        变量 结果 <类型 = Skia图像>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_image_make_raster_image((const sk_image_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 按滤镜新建 <公开 类型 = Skia图像 注释 = "对图像施滤镜得到新图; 结果子集/结果偏移 描述新图与原图的相对位置。">
    参数 滤镜 <类型 = Skia图像滤镜>
    参数 子集矩形 <类型 = Skia整数矩形>
    参数 裁剪矩形 <类型 = Skia整数矩形>
    参数 结果子集 <类型 = Skia整数矩形>
    参数 结果偏移 <类型 = Skia整数点>
    {
        变量 结果 <类型 = Skia图像>
        变量 句柄 <类型 = 变整数>
        变量 滤镜句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        滤镜句柄 = 滤镜.对象指针
        @ @<新指针> = (intptr_t)sk_image_make_with_filter_raster((const sk_image_t*)@<句柄>, (const sk_imagefilter_t*)@<滤镜句柄>, (const sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr(), (const sk_irect_t*)@<裁剪矩形>.@n<Skia整数矩形.数据>.GetPtr(), (sk_irect_t*)@<结果子集>.@n<Skia整数矩形.数据>.GetPtr(), (sk_ipoint_t*)@<结果偏移>.@n<Skia整数点.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}

# ============================================================
# 七、Skia表面
# ============================================================

类 Skia表面 <公开 注释 = "绘制表面(sk_surface_t): 自己管理像素(新建_光栅)或接管外部内存(新建_光栅直通), 从它能取到画布。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia表面.对象指针>)
    }

    方法 新建_光栅 <公开 静态 类型 = Skia表面 注释 = "静态; 安全入口 —— 由 Skia 自己分配像素。行字节数传 0 = 按 图像信息 自动紧凑排列。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 行字节数 <类型 = 变整数>
    参数 表面属性 <类型 = Skia表面属性>
    {
        变量 结果 <类型 = Skia表面>
        变量 属性句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        属性句柄 = 表面属性.对象指针
        @ @<新指针> = (intptr_t)sk_surface_new_raster((const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (size_t)@<行字节数>, (const sk_surfaceprops_t*)@<属性句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_光栅直通 <公开 静态 类型 = Skia表面 注释 = "⚠ 不复制像素内存：调用方必须保证该内存在对象存活期内一直有效，提前释放会导致崩溃。直接画进你提供的那块内存(零拷贝), 原生 releaseProc 固定传 nullptr —— Skia 不会替你释放这块内存。不确定生命周期时请改用 新建_光栅(自己分配像素, 最安全)。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 像素地址 <类型 = 变整数>
    参数 行字节数 <类型 = 变整数>
    参数 表面属性 <类型 = Skia表面属性>
    {
        变量 结果 <类型 = Skia表面>
        变量 属性句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        属性句柄 = 表面属性.对象指针
        @ @<新指针> = (intptr_t)sk_surface_new_raster_direct((const sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素地址>, (size_t)@<行字节数>, nullptr, nullptr, (const sk_surfaceprops_t*)@<属性句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_占位 <公开 静态 类型 = Skia表面 注释 = "静态; 不分配像素的占位表面, 用于「先量尺寸后绘制」。">
    参数 宽 <类型 = 整数>
    参数 高 <类型 = 整数>
    {
        变量 结果 <类型 = Skia表面>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_surface_new_null(@<宽>, @<高>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用; 表面释放后其画布句柄全部失效。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_surface_unref((sk_surface_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia表面.对象指针> != 0)
    }

    方法 取画布 <公开 类型 = Skia画布 注释 = "⚠ 借用对象(是否拥有句柄=假), 严禁调用其 释放(会把表面内部画布 delete 掉); 表面存活期内一直有效。">
    {
        变量 结果 <类型 = Skia画布>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_surface_get_canvas((sk_surface_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 取图像快照 <公开 类型 = Skia图像 注释 = "把当前像素冻结成不可变图像。">
    {
        变量 结果 <类型 = Skia图像>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_surface_new_image_snapshot((sk_surface_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 取图像快照_按裁剪 <公开 类型 = Skia图像 注释 = "只冻结指定整数像素区域。">
    参数 边界 <类型 = Skia整数矩形>
    {
        变量 结果 <类型 = Skia图像>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_surface_new_image_snapshot_with_crop((sk_surface_t*)@<句柄>, (const sk_irect_t*)@<边界>.@n<Skia整数矩形.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 绘制到 <公开 类型 = 逻辑型 注释 = "把本表面内容贴到另一个画布上(左上角对齐); 画笔可传空对象。">
    参数 画布 <类型 = Skia画布>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 画布句柄 <类型 = 变整数>
        句柄 = 对象指针
        画布句柄 = 画布.对象指针
        @ sk_surface_draw((sk_surface_t*)@<句柄>, (sk_canvas_t*)@<画布句柄>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 绘制到_按采样 <公开 类型 = 逻辑型 注释 = "带缩放的贴图; 采样可传空对象。">
    参数 画布 <类型 = Skia画布>
    参数 横坐标 <类型 = 小数>
    参数 纵坐标 <类型 = 小数>
    参数 采样 <类型 = Skia采样选项>
    参数 画笔 <类型 = Skia画笔>
    {
        变量 句柄 <类型 = 变整数>
        变量 画布句柄 <类型 = 变整数>
        句柄 = 对象指针
        画布句柄 = 画布.对象指针
        @ sk_surface_draw_with_sampling((sk_surface_t*)@<句柄>, (sk_canvas_t*)@<画布句柄>, (float)@<横坐标>, (float)@<纵坐标>, (const sk_sampling_options_t*)@<采样>.@n<Skia采样选项.数据>.GetPtr(), (const sk_paint_t*)@<画笔>.@n<Skia画笔.对象指针>);
        返回 (真)
    }

    方法 窥视像素 <公开 类型 = 逻辑型 注释 = "零拷贝取出表面像素视图(要求表面是光栅后端)。">
    参数 像素图 <类型 = Skia像素图>
    {
        变量 句柄 <类型 = 变整数>
        变量 图句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        图句柄 = 像素图.对象指针
        @ @<结果> = (sk_surface_peek_pixels((sk_surface_t*)@<句柄>, (sk_pixmap_t*)@<图句柄>) != 0);
        返回 (结果)
    }

    方法 读取像素 <公开 类型 = 逻辑型 注释 = "把画好的画面整块取出; 像素数据长度须 ≥ 行字节数 x 目标信息.高()。">
    参数 目标信息 <类型 = Skia图像信息>
    参数 像素数据 <类型 = 字节集类>
    参数 行字节数 <类型 = 变整数>
    参数 源X <类型 = 整数>
    参数 源Y <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_surface_read_pixels((sk_surface_t*)@<句柄>, (sk_imageinfo_t*)@<目标信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素数据>.GetPtr(), (size_t)@<行字节数>, @<源X>, @<源Y>) != 0);
        返回 (结果)
    }

    方法 取表面属性 <公开 类型 = Skia表面属性 注释 = "返回借用对象(是否拥有句柄=假), 不要释放。">
    {
        变量 结果 <类型 = Skia表面属性>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_surface_get_props((sk_surface_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }
}

# ============================================================
# 八、Skia编解码器(解码 + 编码)
# ============================================================

类 Skia编解码器 <公开 注释 = "编解码器(sk_codec_t): 解码 PNG/JPEG/WebP/GIF 等; 编码入口是静态方法 编码PNG/编码JPEG/编码WebP。标准编码序列见包注释。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia编解码器.对象指针>)
    }

    方法 取最小缓冲字节数 <公开 静态 类型 = 变整数 注释 = "静态; 流式解码至少要先缓冲这么多字节。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_codec_min_buffered_bytes_needed())
    }

    方法 新建_按流 <公开 静态 类型 = Skia编解码器 注释 = "静态; 结果码 需 4 字节缓冲并写入 sk_codec_result_t(0 成功/1 输入不足/2 输入错误/3 转换不支持/4 缩放不支持/5 参数非法/6 未知格式/7 无法回绕/8 内部错误/9 未实现); 失败返回空对象。">
    参数 流 <类型 = Skia流>
    参数 结果码 <类型 = 字节集类>
    {
        变量 结果 <类型 = Skia编解码器>
        变量 流句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        流句柄 = 流.对象指针
        @ @<新指针> = (intptr_t)sk_codec_new_from_stream((sk_stream_t*)@<流句柄>, (sk_codec_result_t*)@<结果码>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按数据 <公开 静态 类型 = Skia编解码器 注释 = "静态; 从内存中的 PNG/JPEG/WebP/GIF 建解码器。">
    参数 编码数据 <类型 = Skia数据>
    {
        变量 结果 <类型 = Skia编解码器>
        变量 数据句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        数据句柄 = 编码数据.对象指针
        @ @<新指针> = (intptr_t)sk_codec_new_from_data((sk_data_t*)@<数据句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁原生对象; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_codec_destroy((sk_codec_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia编解码器.对象指针> != 0)
    }

    方法 取图像信息 <公开 类型 = 逻辑型 注释 = "解码后的像素格式与尺寸写入 结果信息。">
    参数 结果信息 <类型 = Skia图像信息>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_codec_get_info((sk_codec_t*)@<句柄>, (sk_imageinfo_t*)@<结果信息>.@n<Skia图像信息.数据>.GetPtr());
        返回 (真)
    }

    方法 取原点方向 <公开 类型 = 整数 注释 = "1 左上(默认)/2 右上/3 右下/4 左下/5 左上旋90逆/6 右上旋90顺/7 右下旋90顺/8 左下旋90逆。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_codec_get_origin((sk_codec_t*)@sn<this>.@n<Skia编解码器.对象指针>))
    }

    方法 取缩放后尺寸 <公开 类型 = 逻辑型 注释 = "目标比例 0~1; 解码前用它按比例省内存。">
    参数 目标比例 <类型 = 小数>
    参数 结果尺寸 <类型 = Skia整数尺寸>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_codec_get_scaled_dimensions((sk_codec_t*)@<句柄>, (float)@<目标比例>, (sk_isize_t*)@<结果尺寸>.@n<Skia整数尺寸.数据>.GetPtr());
        返回 (真)
    }

    方法 校正子集 <公开 类型 = 逻辑型 注释 = "输入期望区域, 原地修正为合法区域; 完全越界返回假。">
    参数 子集矩形 <类型 = Skia整数矩形>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_codec_get_valid_subset((sk_codec_t*)@<句柄>, (sk_irect_t*)@<子集矩形>.@n<Skia整数矩形.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取编码格式 <公开 类型 = 整数 注释 = "0 BMP/1 GIF/2 ICO/3 JPEG/4 PNG/5 WBMP/6 WEBP/7 PKM/8 KTX/9 ASTC/10 DNG/11 HEIF/12 AVIF/13 JPEGXL。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_codec_get_encoded_format((sk_codec_t*)@sn<this>.@n<Skia编解码器.对象指针>))
    }

    方法 解码像素 <公开 类型 = 整数 注释 = "一步解码; 先 取图像信息 → 按 信息.取字节数() 分配字节集类 → 再调本方法; 返回 0 表示成功。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 像素数据 <类型 = 字节集类>
    参数 行字节数 <类型 = 变整数>
    参数 解码选项 <类型 = Skia解码选项>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_codec_get_pixels((sk_codec_t*)@<句柄>, (sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素数据>.GetPtr(), (size_t)@<行字节数>, (sk_codec_options_t*)@<解码选项>.@n<Skia解码选项.数据>.GetPtr()));
        返回 (结果)
    }

    方法 开始增量解码 <公开 类型 = 整数 注释 = "返回 0 成功; 之后反复调 增量解码 直到返回非 1 的值。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 像素数据 <类型 = 字节集类>
    参数 行字节数 <类型 = 变整数>
    参数 解码选项 <类型 = Skia解码选项>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_codec_start_incremental_decode((sk_codec_t*)@<句柄>, (sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (void*)@<像素数据>.GetPtr(), (size_t)@<行字节数>, (sk_codec_options_t*)@<解码选项>.@n<Skia解码选项.数据>.GetPtr()));
        返回 (结果)
    }

    方法 增量解码 <公开 类型 = 整数 注释 = "结果行数 需 4 字节缓冲(int); 返回 0 完成/1 需要更多输入/其它为错误码。">
    参数 结果行数 <类型 = 字节集类>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_codec_incremental_decode((sk_codec_t*)@<句柄>, (int*)@<结果行数>.GetPtr()));
        返回 (结果)
    }

    方法 开始逐行解码 <公开 类型 = 整数 注释 = "逐行模式初始化; 返回 0 成功。">
    参数 图像信息 <类型 = Skia图像信息>
    参数 解码选项 <类型 = Skia解码选项>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_codec_start_scanline_decode((sk_codec_t*)@<句柄>, (sk_imageinfo_t*)@<图像信息>.@n<Skia图像信息.数据>.GetPtr(), (sk_codec_options_t*)@<解码选项>.@n<Skia解码选项.数据>.GetPtr()));
        返回 (结果)
    }

    方法 取扫描行 <公开 类型 = 整数 注释 = "返回实际取到的行数; 缓冲区须 ≥ 行数 x 行字节数。">
    参数 像素数据 <类型 = 字节集类>
    参数 行数 <类型 = 整数>
    参数 行字节数 <类型 = 变整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_codec_get_scanlines((sk_codec_t*)@<句柄>, (void*)@<像素数据>.GetPtr(), @<行数>, (size_t)@<行字节数>));
        返回 (结果)
    }

    方法 跳过扫描行 <公开 类型 = 逻辑型 注释 = "逐行模式下快速丢弃若干行。">
    参数 行数 <类型 = 整数>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_codec_skip_scanlines((sk_codec_t*)@<句柄>, @<行数>) != 0);
        返回 (结果)
    }

    方法 取扫描行顺序 <公开 类型 = 整数 注释 = "0 自上而下/1 自下而上。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_codec_get_scanline_order((sk_codec_t*)@sn<this>.@n<Skia编解码器.对象指针>))
    }

    方法 下一扫描行 <公开 类型 = 整数 注释 = "返回下一行的输出行号; 负数表示结束。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_codec_next_scanline((sk_codec_t*)@sn<this>.@n<Skia编解码器.对象指针>))
    }

    方法 输出扫描行 <公开 类型 = 整数 注释 = "把输入行号映射为输出行号(处理自下而上)。" 折叠 @嵌入式方法 = "">
    参数 输入行号 <类型 = 整数>
    {
        @ ((int)sk_codec_output_scanline((sk_codec_t*)@sn<this>.@n<Skia编解码器.对象指针>, @<输入行号>))
    }

    方法 取帧数 <公开 类型 = 整数 注释 = "动图帧数; 单帧图为 1。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_codec_get_frame_count((sk_codec_t*)@sn<this>.@n<Skia编解码器.对象指针>))
    }

    方法 取帧信息 <公开 类型 = 逻辑型 注释 = "取当前帧描述写入 结果帧信息。">
    参数 结果帧信息 <类型 = Skia帧信息>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_codec_get_frame_info((sk_codec_t*)@<句柄>, (sk_codec_frameinfo_t*)@<结果帧信息>.@n<Skia帧信息.数据>.GetPtr());
        返回 (真)
    }

    方法 取帧信息_按序号 <公开 类型 = 逻辑型 注释 = "序号从 0 开始; 越界返回假。">
    参数 序号 <类型 = 整数>
    参数 结果帧信息 <类型 = Skia帧信息>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        句柄 = 对象指针
        @ @<结果> = (sk_codec_get_frame_info_for_index((sk_codec_t*)@<句柄>, @<序号>, (sk_codec_frameinfo_t*)@<结果帧信息>.@n<Skia帧信息.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 取循环次数 <公开 类型 = 整数 注释 = "动图循环次数; 0 表示无限循环。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_codec_get_repetition_count((sk_codec_t*)@sn<this>.@n<Skia编解码器.对象指针>))
    }

    方法 编码PNG <公开 静态 类型 = 逻辑型 注释 = "静态; 编码选项可传空对象; 目标写流推荐 Skia动态内存写流 再 取出为数据。">
    参数 目标写流 <类型 = Skia写流>
    参数 源像素图 <类型 = Skia像素图>
    参数 编码选项 <类型 = SkiaPNG编码选项>
    {
        变量 写句柄 <类型 = 变整数>
        变量 图句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        写句柄 = 目标写流.对象指针
        图句柄 = 源像素图.对象指针
        @ @<结果> = (sk_pngencoder_encode((sk_wstream_t*)@<写句柄>, (const sk_pixmap_t*)@<图句柄>, (const sk_pngencoder_options_t*)@<编码选项>.@n<SkiaPNG编码选项.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 编码JPEG <公开 静态 类型 = 逻辑型 注释 = "静态; 选项可传空对象(默认质量 100); JPEG 不支持透明。">
    参数 目标写流 <类型 = Skia写流>
    参数 源像素图 <类型 = Skia像素图>
    参数 编码选项 <类型 = SkiaJPEG编码选项>
    {
        变量 写句柄 <类型 = 变整数>
        变量 图句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        写句柄 = 目标写流.对象指针
        图句柄 = 源像素图.对象指针
        @ @<结果> = (sk_jpegencoder_encode((sk_wstream_t*)@<写句柄>, (const sk_pixmap_t*)@<图句柄>, (const sk_jpegencoder_options_t*)@<编码选项>.@n<SkiaJPEG编码选项.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 编码WebP <公开 静态 类型 = 逻辑型 注释 = "静态; 压缩方式 0 有损/1 无损; 质量 0~100。">
    参数 目标写流 <类型 = Skia写流>
    参数 源像素图 <类型 = Skia像素图>
    参数 编码选项 <类型 = SkiaWebP编码选项>
    {
        变量 写句柄 <类型 = 变整数>
        变量 图句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        写句柄 = 目标写流.对象指针
        图句柄 = 源像素图.对象指针
        @ @<结果> = (sk_webpencoder_encode((sk_wstream_t*)@<写句柄>, (const sk_pixmap_t*)@<图句柄>, (const sk_webpencoder_options_t*)@<编码选项>.@n<SkiaWebP编码选项.数据>.GetPtr()) != 0);
        返回 (结果)
    }

    方法 编码WebP动画 <公开 静态 类型 = 逻辑型 注释 = "静态; 帧数据是 sk_webpencoder_frame_t 数组, 每项 16 字节(像素图指针 8 + 时长 4 + 4 填充)。">
    参数 目标写流 <类型 = Skia写流>
    参数 帧数据 <类型 = 字节集类>
    参数 帧数 <类型 = 整数>
    参数 编码选项 <类型 = SkiaWebP编码选项>
    {
        变量 写句柄 <类型 = 变整数>
        变量 结果 <类型 = 逻辑型>
        写句柄 = 目标写流.对象指针
        @ @<结果> = (sk_webpencoder_encode_animated((sk_wstream_t*)@<写句柄>, (const sk_webpencoder_frame_t*)@<帧数据>.GetPtr(), @<帧数>, (const sk_webpencoder_options_t*)@<编码选项>.@n<SkiaWebP编码选项.数据>.GetPtr()) != 0);
        返回 (结果)
    }
}

# ============================================================
# 九、Skia图片录制器 / Skia图片 / Skia可绘制对象
# ============================================================

类 Skia图片录制器 <公开 注释 = "图片录制器(sk_picture_recorder_t): 与 Skia图片(sk_picture_t) 是两种不同句柄, 不要混用。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia图片录制器.对象指针>)
