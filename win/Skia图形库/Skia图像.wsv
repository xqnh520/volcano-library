    {
        变量 结果 <类型 = Skia图片录制器>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_picture_recorder_new();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "销毁录制器; 不影响已经 结束录制 得到的 Skia图片; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_picture_recorder_delete((sk_picture_recorder_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia图片录制器.对象指针> != 0)
    }

    方法 开始录制 <公开 类型 = Skia画布 注释 = "返回录制画布(借用对象, 不要释放); 边界传空矩形表示不限制(此时不能做快速剔除)。">
    参数 边界 <类型 = Skia矩形>
    {
        变量 结果 <类型 = Skia画布>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_picture_recorder_begin_recording((sk_picture_recorder_t*)@<句柄>, (const sk_rect_t*)@<边界>.@n<Skia矩形.数据>.GetPtr());
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 开始录制_按缓存工厂 <公开 类型 = Skia画布 注释 = "缓存工厂句柄传 0 等价于 开始录制(本封装不提供 rtree 工厂构造)。">
    参数 边界 <类型 = Skia矩形>
    参数 缓存工厂 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia画布>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_picture_recorder_begin_recording_with_bbh_factory((sk_picture_recorder_t*)@<句柄>, (const sk_rect_t*)@<边界>.@n<Skia矩形.数据>.GetPtr(), (sk_bbh_factory_t*)@<缓存工厂>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 取录制画布 <公开 类型 = Skia画布 注释 = "借用; 未开始录制时为空对象。⚠ 原生函数名是 sk_picture_get_recording_canvas(前缀是 sk_picture_ 但接收录制器), 别写成 sk_picture_recorder_get_recording_canvas。">
    {
        变量 结果 <类型 = Skia画布>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_picture_get_recording_canvas((sk_picture_recorder_t*)@<句柄>);
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 结束录制 <公开 类型 = Skia图片 注释 = "结束并交出图片; 之后录制器需重新 开始录制 才能再用。">
    {
        变量 结果 <类型 = Skia图片>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_picture_recorder_end_recording((sk_picture_recorder_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 结束录制为可绘制对象 <公开 类型 = Skia可绘制对象 注释 = "交出可绘制对象(内容更新时可通知重绘)。">
    {
        变量 结果 <类型 = Skia可绘制对象>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_picture_recorder_end_recording_as_drawable((sk_picture_recorder_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}

类 Skia图片 <公开 注释 = "已录制的绘制指令集合(sk_picture_t): 可回放、序列化、转着色器、渲染成图像。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia图片.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_picture_unref((sk_picture_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia图片.对象指针> != 0)
    }

    方法 加引用 <公开 注释 = "增加一份引用, 可多处复用。实测本库 sk_picture_ref 收的是非 const 指针。" 折叠 @嵌入式方法 = "">
    {
        @ sk_picture_ref((sk_picture_t*)@sn<this>.@n<Skia图片.对象指针>)
    }

    方法 取唯一编号 <公开 类型 = 整数 注释 = "全进程唯一 32 位编号。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_picture_get_unique_id((sk_picture_t*)@sn<this>.@n<Skia图片.对象指针>))
    }

    方法 取剔除矩形 <公开 类型 = 逻辑型 注释 = "把录制时声明的边界写入 结果矩形。">
    参数 结果矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_picture_get_cull_rect((sk_picture_t*)@<句柄>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 取着色器 <公开 类型 = Skia着色器 注释 = "把图片当纹理; 过滤 0 最近邻/1 线性; 局部矩阵/平铺矩形可传空对象。">
    参数 平铺X <类型 = 整数>
    参数 平铺Y <类型 = 整数>
    参数 过滤方式 <类型 = 整数>
    参数 局部矩阵 <类型 = Skia矩阵>
    参数 平铺矩形 <类型 = Skia矩形>
    {
        变量 结果 <类型 = Skia着色器>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_picture_make_shader((sk_picture_t*)@<句柄>, (sk_shader_tilemode_t)@<平铺X>, (sk_shader_tilemode_t)@<平铺Y>, (sk_filter_mode_t)@<过滤方式>, (const sk_matrix_t*)@<局部矩阵>.@n<Skia矩阵.数据>.GetPtr(), (const sk_rect_t*)@<平铺矩形>.@n<Skia矩形.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 序列化为数据 <公开 类型 = Skia数据 注释 = "序列化成可存盘的二进制; 失败返回空对象。">
    {
        变量 结果 <类型 = Skia数据>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_picture_serialize_to_data((sk_picture_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 序列化到流 <公开 类型 = 逻辑型 注释 = "直接写进目标写流。">
    参数 目标写流 <类型 = Skia写流>
    {
        变量 句柄 <类型 = 变整数>
        变量 写句柄 <类型 = 变整数>
        句柄 = 对象指针
        写句柄 = 目标写流.对象指针
        @ sk_picture_serialize_to_stream((sk_picture_t*)@<句柄>, (sk_wstream_t*)@<写句柄>);
        返回 (真)
    }

    方法 反序列化_按流 <公开 静态 类型 = Skia图片 注释 = "静态; 数据非法返回空对象。">
    参数 源流 <类型 = Skia流>
    {
        变量 结果 <类型 = Skia图片>
        变量 流句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        流句柄 = 源流.对象指针
        @ @<新指针> = (intptr_t)sk_picture_deserialize_from_stream((sk_stream_t*)@<流句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 反序列化_按数据 <公开 静态 类型 = Skia图片 注释 = "静态; 从 Skia数据 重建图片。">
    参数 源数据 <类型 = Skia数据>
    {
        变量 结果 <类型 = Skia图片>
        变量 数据句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        数据句柄 = 源数据.对象指针
        @ @<新指针> = (intptr_t)sk_picture_deserialize_from_data((sk_data_t*)@<数据句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 反序列化_按内存 <公开 静态 类型 = Skia图片 注释 = "静态; 内存须在反序列化完成前有效。">
    参数 内存地址 <类型 = 变整数>
    参数 数据尺寸 <类型 = 变整数>
    {
        变量 结果 <类型 = Skia图片>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_picture_deserialize_from_memory((void*)@<内存地址>, (size_t)@<数据尺寸>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 回放 <公开 类型 = 逻辑型 注释 = "按录制的矩阵/裁剪原样重放。">
    参数 画布 <类型 = Skia画布>
    {
        变量 句柄 <类型 = 变整数>
        变量 画布句柄 <类型 = 变整数>
        句柄 = 对象指针
        画布句柄 = 画布.对象指针
        @ sk_picture_playback((const sk_picture_t*)@<句柄>, (sk_canvas_t*)@<画布句柄>);
        返回 (真)
    }

    方法 取近似指令数 <公开 类型 = 整数 注释 = "性能估算用; 是否含嵌套 决定是否统计子图片。">
    参数 是否含嵌套 <类型 = 逻辑型 @默认值 = 假>
    {
        变量 句柄 <类型 = 变整数>
        变量 结果 <类型 = 整数>
        句柄 = 对象指针
        @ @<结果> = ((int)sk_picture_approximate_op_count((sk_picture_t*)@<句柄>, (bool)@<是否含嵌套>));
        返回 (结果)
    }

    方法 取近似字节数 <公开 类型 = 变整数 注释 = "估算占用的字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_picture_approximate_bytes_used((sk_picture_t*)@sn<this>.@n<Skia图片.对象指针>))
    }
}

类 Skia可绘制对象 <公开 注释 = "可绘制对象(sk_drawable_t): 内容可变, 变化后调 通知绘制已变。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia可绘制对象.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_drawable_unref((sk_drawable_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia可绘制对象.对象指针> != 0)
    }

    方法 取世代编号 <公开 类型 = 整数 注释 = "每次 通知绘制已变 后递增, 可用于判断是否需要重绘。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)sk_drawable_get_generation_id((sk_drawable_t*)@sn<this>.@n<Skia可绘制对象.对象指针>))
    }

    方法 取边界 <公开 类型 = 逻辑型 注释 = "内容的浮动边界写入 结果矩形。">
    参数 结果矩形 <类型 = Skia矩形>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_drawable_get_bounds((sk_drawable_t*)@<句柄>, (sk_rect_t*)@<结果矩形>.@n<Skia矩形.数据>.GetPtr());
        返回 (真)
    }

    方法 绘制到 <公开 类型 = 逻辑型 注释 = "把可绘制对象画到指定画布; 矩阵可选。">
    参数 画布 <类型 = Skia画布>
    参数 矩阵 <类型 = Skia矩阵>
    {
        变量 句柄 <类型 = 变整数>
        变量 画布句柄 <类型 = 变整数>
        句柄 = 对象指针
        画布句柄 = 画布.对象指针
        @ sk_drawable_draw((sk_drawable_t*)@<句柄>, (sk_canvas_t*)@<画布句柄>, (const sk_matrix_t*)@<矩阵>.@n<Skia矩阵.数据>.GetPtr());
        返回 (真)
    }

    方法 取图片快照 <公开 类型 = Skia图片 注释 = "固化当前内容成不可变图片, 可缓存复用。">
    {
        变量 结果 <类型 = Skia图片>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_drawable_new_picture_snapshot((sk_drawable_t*)@<句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 通知绘制已变 <公开 注释 = "内容变化后必须调用, 世代编号随之递增。" 折叠 @嵌入式方法 = "">
    {
        @ sk_drawable_notify_drawing_changed((sk_drawable_t*)@sn<this>.@n<Skia可绘制对象.对象指针>)
    }

    方法 取近似字节数 <公开 类型 = 变整数 注释 = "估算占用的字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)sk_drawable_approximate_bytes_used((sk_drawable_t*)@sn<this>.@n<Skia可绘制对象.对象指针>))
    }
}

# ============================================================
# 十、Skia顶点
# ============================================================

类 Skia顶点 <公开 注释 = "顶点集合(sk_vertices_t): 三角网格, 逐顶点着色。用 Skia画布.绘制顶点 绘制。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数); 传给仍是 变整数 参数的旧接口时用它。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia顶点.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_vertices_unref((sk_vertices_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia顶点.对象指针> != 0)
    }

    方法 加引用 <公开 注释 = "增加一份引用, 可多处复用; sk_vertices_ref 的参数是非 const。" 折叠 @嵌入式方法 = "">
    {
        @ sk_vertices_ref((sk_vertices_t*)@sn<this>.@n<Skia顶点.对象指针>)
    }

    方法 新建_按拷贝 <公开 静态 类型 = Skia顶点 注释 = "静态; 顶点模式 0 三角列表/1 三角带/2 三角扇; 位置数据每点 8 字节(x,y 各 4 字节单精度); 颜色数据每个 4 字节(ARGB); 索引数据每项 2 字节(16 位无符号)。纹理数据/颜色数据传空字节集类表示「无」。">
    参数 顶点模式 <类型 = 整数>
    参数 顶点数 <类型 = 整数>
    参数 位置数据 <类型 = 字节集类>
    参数 纹理数据 <类型 = 字节集类>
    参数 颜色数据 <类型 = 字节集类>
    参数 索引数 <类型 = 整数>
    参数 索引数据 <类型 = 字节集类>
    {
        变量 结果 <类型 = Skia顶点>
        变量 纹理地址 <类型 = 变整数>
        变量 颜色地址 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        纹理地址 = 0
        颜色地址 = 0
        如果 (取字节集长度 (纹理数据) > 0)
        {
            @ @<纹理地址> = (intptr_t)@<纹理数据>.GetPtr();
        }
        如果 (取字节集长度 (颜色数据) > 0)
        {
            @ @<颜色地址> = (intptr_t)@<颜色数据>.GetPtr();
        }
        @ @<新指针> = (intptr_t)sk_vertices_make_copy((sk_vertices_vertex_mode_t)@<顶点模式>, @<顶点数>, (const sk_point_t*)@<位置数据>.GetPtr(), (const sk_point_t*)@<纹理地址>, (const sk_color_t*)@<颜色地址>, @<索引数>, (const uint16_t*)@<索引数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}
