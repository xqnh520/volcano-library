# ============================================================
# 六、Skia颜色滤镜(原生无 ref → 只持一份引用, 不可复用)
# ============================================================

类 Skia颜色滤镜 <公开 注释 = "颜色滤镜(sk_colorfilter_t): 调色/矩阵/查表/反色等。原生没有 ref 函数 —— 只持一份引用: 置入画笔后不要释放、不要复用; 要给第二个画笔用请重新构造。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia颜色滤镜.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 置入画笔后不要再释放; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_colorfilter_unref((sk_colorfilter_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。构造失败时为假。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia颜色滤镜.对象指针> != 0)
    }

    方法 新建_按模式 <公开 静态 类型 = Skia颜色滤镜 注释 = "静态; 结果 = 颜色 与 源像素 按混合方式合成; 混合方式 0~29。">
    参数 颜色值 <类型 = 整数>
    参数 混合方式 <类型 = 整数>
    {
        变量 结果 <类型 = Skia颜色滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_colorfilter_new_mode((sk_color_t)@<颜色值>, (sk_blendmode_t)@<混合方式>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_光照 <公开 静态 类型 = Skia颜色滤镜 注释 = "静态; 结果 = 源 * 乘色 + 加色(各通道)。">
    参数 乘色 <类型 = 整数>
    参数 加色 <类型 = 整数>
    {
        变量 结果 <类型 = Skia颜色滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_colorfilter_new_lighting((sk_color_t)@<乘色>, (sk_color_t)@<加色>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_组合 <公开 静态 类型 = Skia颜色滤镜 注释 = "静态; 先施加内滤镜再施加外滤镜。">
    参数 外滤镜 <类型 = Skia颜色滤镜>
    参数 内滤镜 <类型 = Skia颜色滤镜>
    {
        变量 结果 <类型 = Skia颜色滤镜>
        变量 外句柄 <类型 = 变整数>
        变量 内句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        外句柄 = 外滤镜.对象指针
        内句柄 = 内滤镜.对象指针
        @ @<新指针> = (intptr_t)sk_colorfilter_new_compose((sk_colorfilter_t*)@<外句柄>, (sk_colorfilter_t*)@<内句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_颜色矩阵 <公开 静态 类型 = Skia颜色滤镜 注释 = "静态; 20 个单精度共 80 字节, 标准 4x5 行优先: 每行 5 个 = 4 个通道系数 + 1 个偏移(偏移列索引 4/9/14/19, 取值按 1.0 表示满量程)。⚠ 必须用内联 C 写 float, 不要用 置字节集单精度小数(实测写不进浮点数组, 读回仍是 0, 会让矩阵全 0 → 滤镜输出全透明)。反色示例: 对角 -1、偏移列 +1、A 行 [0,0,0,1,0]（对角索引 0/6/12/18, 偏移列 4/9/14/19） —— 纯红 0xFFFF0000 精确变纯青 0xFF00FFFF(已实测)。写法: @ { float* __m = (float*)@<矩阵数据>.GetPtr(); for (int __i = 0; __i < 20; ++__i) __m[__i] = 0.0f; __m[0] = -1.0f; __m[6] = -1.0f; __m[12] = -1.0f; __m[18] = 1.0f; __m[4] = 1.0f; __m[9] = 1.0f; __m[14] = 1.0f; }">
    参数 矩阵数据 <类型 = 字节集类>
    {
        变量 结果 <类型 = Skia颜色滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_colorfilter_new_color_matrix((const float*)@<矩阵数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

