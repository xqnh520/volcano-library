# ============================================================
# 三、Skia遮罩滤镜(有 ref → 可复用)
# ============================================================

类 Skia遮罩滤镜 <公开 注释 = "遮罩滤镜(sk_maskfilter_t): 按 alpha 做模糊/查表/伽马/裁剪。ref 与 unref 都导出, 可 加引用 后交给多个画笔。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia遮罩滤镜.对象指针>)
    }

    方法 加引用 <公开 注释 = "增加一份引用, 可交给多个画笔复用; 参数是非 const。" 折叠 @嵌入式方法 = "">
    {
        @ sk_maskfilter_ref((sk_maskfilter_t*)@sn<this>.@n<Skia遮罩滤镜.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_maskfilter_unref((sk_maskfilter_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia遮罩滤镜.对象指针> != 0)
    }

    方法 新建_模糊 <公开 静态 类型 = Skia遮罩滤镜 注释 = "静态; 样式 0 正常(内外都糊)/1 实心(只糊外)/2 外糊(内部透明)/3 内糊; 标准差单位像素, 约等于半径/2。">
    参数 模糊样式 <类型 = 整数>
    参数 标准差 <类型 = 小数>
    {
        变量 结果 <类型 = Skia遮罩滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_maskfilter_new_blur((sk_blurstyle_t)@<模糊样式>, (float)@<标准差>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_模糊_按标志 <公开 静态 类型 = Skia遮罩滤镜 注释 = "静态; 随变换缩放为真时模糊半径随画布矩阵缩放(几何缩放时更自然)。">
    参数 模糊样式 <类型 = 整数>
    参数 标准差 <类型 = 小数>
    参数 随变换缩放 <类型 = 逻辑型 @默认值 = 真>
    {
        变量 结果 <类型 = Skia遮罩滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_maskfilter_new_blur_with_flags((sk_blurstyle_t)@<模糊样式>, (float)@<标准差>, (bool)@<随变换缩放>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_查表 <公开 静态 类型 = Skia遮罩滤镜 注释 = "静态; 表数据 256 字节, 映射 alpha。">
    参数 表数据 <类型 = 字节集类>
    {
        变量 结果 <类型 = Skia遮罩滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_maskfilter_new_table((const uint8_t*)@<表数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_伽马 <公开 静态 类型 = Skia遮罩滤镜 注释 = "静态; 用 gamma 曲线调整 alpha, 常用 0.5~2.0。">
    参数 伽马值 <类型 = 小数>
    {
        变量 结果 <类型 = Skia遮罩滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_maskfilter_new_gamma((float)@<伽马值>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_裁剪 <公开 静态 类型 = Skia遮罩滤镜 注释 = "静态; 0~255; alpha 低于最小值归 0, 高于最大值归 255。">
    参数 最小值 <类型 = 整数>
    参数 最大值 <类型 = 整数>
    {
        变量 结果 <类型 = Skia遮罩滤镜>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_maskfilter_new_clip((uint8_t)@<最小值>, (uint8_t)@<最大值>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_按着色器 <公开 静态 类型 = Skia遮罩滤镜 注释 = "静态; 用着色器的 alpha 当遮罩。">
    参数 着色器 <类型 = Skia着色器>
    {
        变量 结果 <类型 = Skia遮罩滤镜>
        变量 色句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        色句柄 = 着色器.对象指针
        @ @<新指针> = (intptr_t)sk_maskfilter_new_shader((sk_shader_t*)@<色句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }
}

