    方法 取子项信息 <公开 类型 = 逻辑型 注释 = "结果子项 24 字节: 名地址@0/名长度@8/类型@16/序号@20; 类型 0 着色器/1 颜色滤镜/2 混合器。">
    参数 序号 <类型 = 整数>
    参数 结果子项 <类型 = Skia效果子项>
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_runtimeeffect_get_child_from_index((const sk_runtimeeffect_t*)@<句柄>, @<序号>, (sk_runtimeeffect_child_t*)@<结果子项>.@n<Skia效果子项.数据>.GetPtr());
        返回 (真)
    }

    方法 取子项信息_按名 <公开 类型 = 逻辑型 注释 = "未找到时同样无法报错(结果保持不变)。">
    参数 子项名 <类型 = 文本型>
    参数 结果子项 <类型 = Skia效果子项>
    {
        变量 句柄 <类型 = 变整数>
        变量 名字节 <类型 = 字节集类>
        变量 名长度 <类型 = 变整数>
        句柄 = 对象指针
        名字节 = 文本到UTF8 (子项名, )
        名长度 = 取字节集长度 (名字节)
        @ sk_runtimeeffect_get_child_from_name((const sk_runtimeeffect_t*)@<句柄>, (const char*)@<名字节>.GetPtr(), (size_t)@<名长度>, (sk_runtimeeffect_child_t*)@<结果子项>.@n<Skia效果子项.数据>.GetPtr());
        返回 (真)
    }
}
