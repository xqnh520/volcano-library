        色句柄 = 着色器.对象指针
        @ @<新指针> = (intptr_t)sk_imagefilter_new_shader((sk_shader_t*)@<色句柄>, (bool)@<是否抖色>, (const sk_rect_t*)@<裁剪矩形>.@n<Skia矩形.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

