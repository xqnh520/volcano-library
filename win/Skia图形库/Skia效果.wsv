        @ memcpy(@<两点>.GetPtr(), (const void*)@<起点>.@n<Skia点.数据>.GetPtr(), 8);
        @ memcpy((char*)@<两点>.GetPtr() + 8, (const void*)@<终点>.@n<Skia点.数据>.GetPtr(), 8);
