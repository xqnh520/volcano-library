<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Skia <注释 = "Skia 效果域封装(批次3): Skia着色器 / Skia遮罩滤镜 / Skia混合器 / Skia图像滤镜 / Skia颜色滤镜 / Skia运行时效果 + 四个值类(Skia点3 12B / Skia高对比度配置 12B / Skia效果变量 40B / Skia效果子项 24B)。"
        注释 = "【可复用 vs 一次性(极重要, 写反会崩)】有 ref 可复用(Skia着色器 / Skia遮罩滤镜 / Skia混合器) —— 用 加引用 后交给多个画笔, 每个持有者用完各自 释放。原生根本没有 ref 函数的真一次性(Skia图像滤镜 / Skia颜色滤镜 / Skia运行时效果) —— 只持一份引用, 置入画笔后不可释放、不可复用; 要给第二个画笔用必须重新构造, 否则 refcount 归零导致崩溃。"
        注释 = "【空对象语义】置着色器/置图像滤镜/置颜色滤镜/置遮罩滤镜/置混合器 传空对象 = 清除该效果, 这是合法用法(不是无操作)。图像滤镜的 输入滤镜 传空对象 = 以当前整个绘制内容为输入。⚠ 裁剪矩形 不是可空参数: 它是值类, 默认构造的是全 0 矩形, 会得到 0×0 裁剪把输出整块丢弃(实测画面上什么都不剩)。不带裁剪的入口是 Skia图像滤镜.新建_模糊; 其余带裁剪参数的方法请传有效正面积矩形(例如 (0,0,画布宽,画布高))。"
        注释 = "【构造可能失败】所有 新建_* / 编译为* 都可能返回空对象(句柄 0): 参数非法、SkSL 编译失败都会返回 0 而不抛错。调用方必须 是否有效 () 判空后再用 —— 把空效果置进画笔会静默变成「没效果」, 事后极难排查。"
        注释 = "【必须显式释放】句柄类的 类_清理 一律空实现, 谁创建谁 释放。"
        @视窗.头文件搜寻目录 = "deps\\skia"
        @视窗.头文件搜寻目录 = "deps\\skia\\include\\c"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "skia_include.h">

# ============================================================
# 一、值类
# ============================================================

类 Skia点3 <公开 注释 = "三维点/向量(sk_point3_t, 12 字节): 偏移 0 x / 4 y / 8 z, 单精度。光照类滤镜的方向与光源位置用它。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "12 字节缓冲, 对应 sk_point3_t。">

    方法 类_初始化 <公开 注释 = "分配 12 字节缓冲并清零。">
    {
        数据 = 取空白字节集 (12)
    }

    方法 置坐标 <公开 类型 = 逻辑型 注释 = "一次写入 x/y/z(方向向量请自行归一化)。" 折叠 @嵌入式方法 = "">
    参数 横值 <类型 = 小数>
    参数 纵值 <类型 = 小数>
    参数 深值 <类型 = 小数>
    {
        @ ([&]() -> bool { sk_point3_t* __p = (sk_point3_t*)@sn<this>.@n<Skia点3.数据>.GetPtr(); __p->x = (float)@<横值>; __p->y = (float)@<纵值>; __p->z = (float)@<深值>; return true; }())
    }

    方法 横坐标 <公开 属性读 类型 = 小数 注释 = "x。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_point3_t*)@sn<this>.@n<Skia点3.数据>.GetPtr())->x)
    }

    方法 纵坐标 <公开 属性读 类型 = 小数 注释 = "y。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_point3_t*)@sn<this>.@n<Skia点3.数据>.GetPtr())->y)
    }

    方法 深度 <公开 属性读 类型 = 小数 注释 = "z。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_point3_t*)@sn<this>.@n<Skia点3.数据>.GetPtr())->z)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_point3_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia点3.数据>.GetPtr())
    }
}

类 Skia高对比度配置 <公开 注释 = "高对比度配置(sk_highcontrastconfig_t, 12 字节): 是否灰度 bool@0(1 字节, 后跟 3 字节填充) / 反转方式 int@4 / 对比度 float@8。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "12 字节缓冲, 对应 sk_highcontrastconfig_t。">

    方法 类_初始化 <公开 注释 = "分配 12 字节缓冲并清零(不灰度 / 不反转 / 对比度 0)。">
    {
        数据 = 取空白字节集 (12)
    }

    方法 置配置 <公开 类型 = 逻辑型 注释 = "设置 是否灰度 / 反转方式(0 无/1 反转亮度/2 反转明度) / 对比度。bool 只占 1 字节, 不要用整数写。">
    参数 是否灰度值 <类型 = 逻辑型>
    参数 反转方式值 <类型 = 整数>
    参数 对比度值 <类型 = 小数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { sk_highcontrastconfig_t* __c = (sk_highcontrastconfig_t*)@<地址>; __c->fGrayscale = (bool)@<是否灰度值>; __c->fInvertStyle = (sk_highcontrastconfig_invertstyle_t)@<反转方式值>; __c->fContrast = (float)@<对比度值>; return true; }());
        返回 (真)
    }

    方法 是否灰度 <公开 属性读 类型 = 逻辑型 注释 = "是否转灰度。" 折叠 @嵌入式方法 = "">
    {
        @ (((const sk_highcontrastconfig_t*)@sn<this>.@n<Skia高对比度配置.数据>.GetPtr())->fGrayscale != 0)
    }

    方法 反转方式 <公开 属性读 类型 = 整数 注释 = "0 无/1 反转亮度/2 反转明度。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_highcontrastconfig_t*)@sn<this>.@n<Skia高对比度配置.数据>.GetPtr())->fInvertStyle)
    }

    方法 对比度 <公开 属性读 类型 = 小数 注释 = "对比度(通常 0~1)。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_highcontrastconfig_t*)@sn<this>.@n<Skia高对比度配置.数据>.GetPtr())->fContrast)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_highcontrastconfig_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia高对比度配置.数据>.GetPtr())
    }
}

类 Skia效果变量 <公开 注释 = "SkSL 变量(uniform)描述(sk_runtimeeffect_uniform_t): 实测 40 字节(尾部 4 字节填充)。偏移 0 变量名地址 / 8 变量名长度 / 16 数据偏移 / 24 变量类型 / 28 元素个数 / 32 变量标志 / 36 填充。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "40 字节缓冲, 对应 sk_runtimeeffect_uniform_t。">

    方法 类_初始化 <公开 注释 = "分配 40 字节缓冲并清零。">
    {
        数据 = 取空白字节集 (40)
    }

    方法 变量名地址 <公开 属性读 类型 = 变整数 注释 = "变量名 const char* 裸地址。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)((const sk_runtimeeffect_uniform_t*)@sn<this>.@n<Skia效果变量.数据>.GetPtr())->fName)
    }

    方法 变量名长度 <公开 属性读 类型 = 变整数 注释 = "变量名字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)((const sk_runtimeeffect_uniform_t*)@sn<this>.@n<Skia效果变量.数据>.GetPtr())->fNameLength)
    }

    方法 数据偏移 <公开 属性读 类型 = 变整数 注释 = "该变量在统一数据块里的字节偏移。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)((const sk_runtimeeffect_uniform_t*)@sn<this>.@n<Skia效果变量.数据>.GetPtr())->fOffset)
    }

    方法 变量类型 <公开 属性读 类型 = 整数 注释 = "0 FLOAT / 1 FLOAT2 / 2 FLOAT3 / 3 FLOAT4 / 4 FLOAT2X2 / 5 FLOAT3X3 / 6 FLOAT4X4 / 7 INT / 8 INT2 / 9 INT3 / 10 INT4。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_runtimeeffect_uniform_t*)@sn<this>.@n<Skia效果变量.数据>.GetPtr())->fType)
    }

    方法 元素个数 <公开 属性读 类型 = 整数 注释 = "数组变量时的元素个数(非数组为 1)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_runtimeeffect_uniform_t*)@sn<this>.@n<Skia效果变量.数据>.GetPtr())->fCount)
    }

    方法 变量标志 <公开 属性读 类型 = 整数 注释 = "0x01 ARRAY / 0x02 COLOR / 0x04 VERTEX / 0x08 FRAGMENT / 0x10 HALF_PRECISION。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_runtimeeffect_uniform_t*)@sn<this>.@n<Skia效果变量.数据>.GetPtr())->fFlags)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_runtimeeffect_uniform_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia效果变量.数据>.GetPtr())
    }
}

类 Skia效果子项 <公开 注释 = "SkSL 子项(child)描述(sk_runtimeeffect_child_t, 24 字节): 偏移 0 子项名地址 / 8 子项名长度 / 16 子项类型(0 着色器/1 颜色滤镜/2 混合器) / 20 子项序号。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "24 字节缓冲, 对应 sk_runtimeeffect_child_t。">

    方法 类_初始化 <公开 注释 = "分配 24 字节缓冲并清零。">
    {
        数据 = 取空白字节集 (24)
    }

    方法 子项名地址 <公开 属性读 类型 = 变整数 注释 = "子项名 const char* 裸地址。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)((const sk_runtimeeffect_child_t*)@sn<this>.@n<Skia效果子项.数据>.GetPtr())->fName)
    }

    方法 子项名长度 <公开 属性读 类型 = 变整数 注释 = "子项名字节数。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)((const sk_runtimeeffect_child_t*)@sn<this>.@n<Skia效果子项.数据>.GetPtr())->fNameLength)
    }

    方法 子项类型 <公开 属性读 类型 = 整数 注释 = "0 着色器/1 颜色滤镜/2 混合器。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_runtimeeffect_child_t*)@sn<this>.@n<Skia效果子项.数据>.GetPtr())->fType)
    }

    方法 子项序号 <公开 属性读 类型 = 整数 注释 = "该子项在对应类型里的序号。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_runtimeeffect_child_t*)@sn<this>.@n<Skia效果子项.数据>.GetPtr())->fIndex)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_runtimeeffect_child_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia效果子项.数据>.GetPtr())
    }
}

# ============================================================
# 二、Skia着色器(有 ref → 可复用)
# ============================================================

类 Skia着色器 <公开 注释 = "着色器(sk_shader_t): 渐变/噪声/纯色/混合。ref 与 unref 都导出, 可 加引用 后交给多个画笔, 每个持有者用完各自 释放。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia着色器.对象指针>)
    }

    方法 加引用 <公开 注释 = "增加一份引用, 可交给多个画笔复用; 每个持有者用完各自 释放。参数是非 const。" 折叠 @嵌入式方法 = "">
    {
        @ sk_shader_ref((sk_shader_t*)@sn<this>.@n<Skia着色器.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_shader_unref((sk_shader_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。构造失败时为假。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia着色器.对象指针> != 0)
    }

    方法 加上局部矩阵 <公开 类型 = Skia着色器 注释 = "返回叠加了局部变换矩阵的新着色器(原对象不变); 局部矩阵传空对象表示单位矩阵。">
    参数 局部矩阵 <类型 = Skia矩阵>
    {
        变量 结果 <类型 = Skia着色器>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_shader_with_local_matrix((const sk_shader_t*)@<句柄>, (const sk_matrix_t*)@<局部矩阵>.@n<Skia矩阵.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 加上颜色滤镜 <公开 类型 = Skia着色器 注释 = "返回套了颜色滤镜的新着色器(原对象不变)。">
    参数 滤镜 <类型 = Skia颜色滤镜>
    {
        变量 结果 <类型 = Skia着色器>
        变量 句柄 <类型 = 变整数>
        变量 滤镜句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        滤镜句柄 = 滤镜.对象指针
        @ @<新指针> = (intptr_t)sk_shader_with_color_filter((const sk_shader_t*)@<句柄>, (const sk_colorfilter_t*)@<滤镜句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_空 <公开 静态 类型 = Skia着色器 注释 = "静态; 什么都不画的着色器(全透明黑), 可作占位。">
    {
        变量 结果 <类型 = Skia着色器>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_shader_new_empty();
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_纯色 <公开 静态 类型 = Skia着色器 注释 = "静态; ARGB 32 位纯色着色器。">
    参数 颜色值 <类型 = 整数>
    {
        变量 结果 <类型 = Skia着色器>
        变量 新指针 <类型 = 变整数>
        @ @<新指针> = (intptr_t)sk_shader_new_color((sk_color_t)@<颜色值>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_浮点色 <公开 静态 类型 = Skia着色器 注释 = "静态; 0~1 浮点色(顺序 R,G,B,A); 颜色空间传空对象表示 sRGB。">
    参数 颜色 <类型 = Skia浮点颜色>
    参数 颜色空间 <类型 = Skia颜色空间>
    {
        变量 结果 <类型 = Skia着色器>
        变量 色句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        色句柄 = 颜色空间.对象指针
        @ @<新指针> = (intptr_t)sk_shader_new_color4f((const sk_color4f_t*)@<颜色>.@n<Skia浮点颜色.数据>.GetPtr(), (const sk_colorspace_t*)@<色句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_混合 <公开 静态 类型 = Skia着色器 注释 = "静态; 两个着色器按混合方式合成; 混合方式 0 清除/1 源/3 源覆盖/…/29 亮度。">
    参数 混合方式 <类型 = 整数>
    参数 目标着色器 <类型 = Skia着色器>
    参数 源着色器 <类型 = Skia着色器>
    {
        变量 结果 <类型 = Skia着色器>
        变量 目标句柄 <类型 = 变整数>
        变量 源句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        目标句柄 = 目标着色器.对象指针
        源句柄 = 源着色器.对象指针
        @ @<新指针> = (intptr_t)sk_shader_new_blend((sk_blendmode_t)@<混合方式>, (const sk_shader_t*)@<目标句柄>, (const sk_shader_t*)@<源句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_混合器 <公开 静态 类型 = Skia着色器 注释 = "静态; 用自定义混合器替代混合方式合成两个着色器。">
    参数 混合器 <类型 = Skia混合器>
    参数 目标着色器 <类型 = Skia着色器>
    参数 源着色器 <类型 = Skia着色器>
    {
        变量 结果 <类型 = Skia着色器>
        变量 混合句柄 <类型 = 变整数>
        变量 目标句柄 <类型 = 变整数>
        变量 源句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        混合句柄 = 混合器.对象指针
        目标句柄 = 目标着色器.对象指针
        源句柄 = 源着色器.对象指针
        @ @<新指针> = (intptr_t)sk_shader_new_blender((sk_blender_t*)@<混合句柄>, (const sk_shader_t*)@<目标句柄>, (const sk_shader_t*)@<源句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建_线性渐变 <公开 静态 类型 = Skia着色器 注释 = "静态; 颜色数据每色 4 字节(ARGB, 共 颜色数量 x 4); 位置数据每项 4 字节单精度(0~1), 传空字节集类表示均匀分布; 平铺方式 0 钳制/1 重复/2 镜像/3 贴花。">
    参数 起点 <类型 = Skia点>
    参数 终点 <类型 = Skia点>
    参数 颜色数据 <类型 = 字节集类>
    参数 位置数据 <类型 = 字节集类>
    参数 颜色数量 <类型 = 整数>
    参数 平铺方式 <类型 = 整数 @默认值 = 0>
