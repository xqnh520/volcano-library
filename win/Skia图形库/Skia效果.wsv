# ============================================================
# 七、Skia运行时效果(SkSL, 原生无 ref → 只持一份引用)
# ============================================================

类 Skia运行时效果 <公开 注释 = "SkSL 运行时效果(sk_runtimeeffect_t)。典型序列: Skia字符串.新建_按拷贝(SkSL 字节) -> 编译为着色器(脚本, 错误信息) -> 判空 -> 取变量个数/取变量信息 得到各变量偏移与类型 -> 按偏移填统一数据 -> 取着色器(统一数据, 空字节集类, 0, 单位矩阵)。编译失败返回空对象而不抛错: 把空效果置进画笔会静默变成「没效果」, 必须先 是否有效 () 判空。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效(通常意味着 SkSL 编译失败)。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia运行时效果.对象指针>)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 可重复调用; 效果本身可反复 取着色器。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_runtimeeffect_unref((sk_runtimeeffect_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0); 为假通常表示 SkSL 编译失败。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia运行时效果.对象指针> != 0)
    }

    方法 编译为着色器 <公开 静态 类型 = Skia运行时效果 注释 = "静态; 脚本为 SkSL 源码; 失败返回空对象并把错误写进 错误信息(传空对象则不接收)。">
    参数 脚本 <类型 = Skia字符串>
    参数 错误信息 <类型 = Skia字符串>
    {
        变量 结果 <类型 = Skia运行时效果>
        变量 脚本句柄 <类型 = 变整数>
        变量 错误句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        脚本句柄 = 脚本.对象指针
        错误句柄 = 错误信息.对象指针
        @ @<新指针> = (intptr_t)sk_runtimeeffect_make_for_shader((sk_string_t*)@<脚本句柄>, (sk_string_t*)@<错误句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 编译为颜色滤镜 <公开 静态 类型 = Skia运行时效果 注释 = "静态; SkSL 必须定义 half4 main(half4)。">
