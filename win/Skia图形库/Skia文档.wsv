<火山程序 类型 = "通常" 版本 = 1 />

包 火山.Skia <注释 = "Skia 文档域封装(批次3): Skia文档(PDF/XPS) + 三个值类(文档元数据 80 字节 / 文档时间 10 字节 / XPS选项 8 字节)。"
        注释 = "【唯一正确的 PDF 输出顺序(写反会得到空文件)】建 Skia动态内存写流 -> Skia文档.新建PDF_按写流(写流) -> 循环[开始页(宽,高,内容矩形) -> 用返回的借用画布绘制 -> 结束页()] -> 关闭() -> 释放() -> 最后 取写流数据。写流必须活到文档 释放 之后, 否则内容会写进已释放的流。"
        注释 = "【配对纪律】每一页 开始页 必须与 结束页 严格配对; 上一页未结束就调 开始页 属未定义行为。关闭 与 放弃 只能调其中一个, 且都在 释放 之前。"
        注释 = "【借用画布】开始页 返回的画布是借用对象(是否拥有句柄 = 假), 严禁调用其 释放; 结束页 之后该画布立即失效。"
        注释 = "【元数据】结构里前 6 个是 sk_string_t 指针(标题/作者/主题/关键字/创建者/生成者), 必须指向活着的 Skia字符串 对象; 创建时间/修改时间指向 Skia文档时间; 不需要的项保持 0。"
        @视窗.头文件搜寻目录 = "deps\\skia"
        @视窗.头文件搜寻目录 = "deps\\skia\\include\\c"
        @视窗.头文件搜寻目录 = "native"
        "@视窗.外部头文件.全局-100" = "skia_include.h">

# ============================================================
# 一、Skia文档时间(值类 10 字节)
# ============================================================

类 Skia文档时间 <公开 注释 = "PDF 日期时间(sk_document_pdf_datetime_t, 10 字节): 时区分钟@0(int16) 年@2(uint16) 月@4 星期@5 日@6 时@7 分@8 秒@9。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "10 字节缓冲, 对应 sk_document_pdf_datetime_t。">

    方法 类_初始化 <公开 注释 = "分配 10 字节缓冲并清零。">
    {
        数据 = 取空白字节集 (10)
    }

    方法 置时间 <公开 类型 = 逻辑型 注释 = "一次写好 8 个字段; 月/日/时/分/秒 从 1(月日) 或 0(时分秒) 起, 星期 0 表示周日。">
    参数 时区分钟 <类型 = 整数>
    参数 年值 <类型 = 整数>
    参数 月值 <类型 = 整数>
    参数 星期值 <类型 = 整数>
    参数 日值 <类型 = 整数>
    参数 时值 <类型 = 整数>
    参数 分值 <类型 = 整数>
    参数 秒值 <类型 = 整数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { sk_document_pdf_datetime_t* __d = (sk_document_pdf_datetime_t*)@<地址>; __d->fTimeZoneMinutes = (uint16_t)@<时区分钟>; __d->fYear = (uint16_t)@<年值>; __d->fMonth = (uint8_t)@<月值>; __d->fDayOfWeek = (uint8_t)@<星期值>; __d->fDay = (uint8_t)@<日值>; __d->fHour = (uint8_t)@<时值>; __d->fMinute = (uint8_t)@<分值>; __d->fSecond = (uint8_t)@<秒值>; return true; }());
        返回 (真)
    }

    方法 年 <公开 属性读 类型 = 整数 注释 = "年。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_document_pdf_datetime_t*)@sn<this>.@n<Skia文档时间.数据>.GetPtr())->fYear)
    }

    方法 月 <公开 属性读 类型 = 整数 注释 = "月(1~12)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_document_pdf_datetime_t*)@sn<this>.@n<Skia文档时间.数据>.GetPtr())->fMonth)
    }

    方法 日 <公开 属性读 类型 = 整数 注释 = "日(1~31)。" 折叠 @嵌入式方法 = "">
    {
        @ ((int)((const sk_document_pdf_datetime_t*)@sn<this>.@n<Skia文档时间.数据>.GetPtr())->fDay)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_document_pdf_datetime_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia文档时间.数据>.GetPtr())
    }
}

# ============================================================
# 二、SkiaXPS选项(值类 8 字节)
# ============================================================

类 SkiaXPS选项 <公开 注释 = "XPS 输出选项(sk_document_xps_options_t, 8 字节): DPI(单精度)@0, 是否允许无 PNG@4(bool, 1 字节)。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "8 字节缓冲, 对应 sk_document_xps_options_t。">

    方法 类_初始化 <公开 注释 = "分配 8 字节缓冲并置 DPI = 300、允许无 PNG = 假。">
    {
        数据 = 取空白字节集 (8)
        置选项 (300.0, 假)
    }

    方法 置选项 <公开 类型 = 逻辑型 注释 = "设置 DPI 与 是否允许无 PNG。bool 只占 1 字节, 不要用整数写。">
    参数 分辨率值 <类型 = 小数>
    参数 允许无PNG值 <类型 = 逻辑型>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ ([&]() -> bool { sk_document_xps_options_t* __o = (sk_document_xps_options_t*)@<地址>; __o->fDPI = (float)@<分辨率值>; __o->fAllowNoPngs = (bool)@<允许无PNG值>; return true; }());
        返回 (真)
    }

    方法 分辨率 <公开 属性读 类型 = 小数 注释 = "DPI。" 折叠 @嵌入式方法 = "">
    {
        @ ((double)((const sk_document_xps_options_t*)@sn<this>.@n<SkiaXPS选项.数据>.GetPtr())->fDPI)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_document_xps_options_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<SkiaXPS选项.数据>.GetPtr())
    }
}

# ============================================================
# 三、Skia文档元数据(值类 80 字节)
# ============================================================

类 Skia文档元数据 <公开 注释 = "PDF 元数据(sk_document_pdf_metadata_t, 80 字节): 标题@0 作者@8 主题@16 关键字@24 创建者@32 生成者@40 创建时间@48 修改时间@56 分辨率@64 是否为PDFA@68 编码质量@72。前 6 个是 Skia字符串 指针, 两个时间是 Skia文档时间 指针, 不需要的项保持 0。">
{
    变量 数据 <公开 类型 = 字节集类 注释 = "80 字节缓冲, 对应 sk_document_pdf_metadata_t。">

    方法 类_初始化 <公开 注释 = "分配 80 字节缓冲并清零(全部留空)。">
    {
        数据 = 取空白字节集 (80)
    }

    方法 置标题 <公开 类型 = 逻辑型 注释 = "设置标题(传空字符串对象表示留空)。">
    参数 值 <类型 = Skia字符串>
    {
        变量 地址 <类型 = 变整数>
        变量 串指针 <类型 = 变整数>
        地址 = 取地址 ()
        串指针 = 值.对象指针
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fTitle = (sk_string_t*)@<串指针>, true);
        返回 (真)
    }

    方法 置作者 <公开 类型 = 逻辑型 注释 = "设置作者。">
    参数 值 <类型 = Skia字符串>
    {
        变量 地址 <类型 = 变整数>
        变量 串指针 <类型 = 变整数>
        地址 = 取地址 ()
        串指针 = 值.对象指针
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fAuthor = (sk_string_t*)@<串指针>, true);
        返回 (真)
    }

    方法 置主题 <公开 类型 = 逻辑型 注释 = "设置主题。">
    参数 值 <类型 = Skia字符串>
    {
        变量 地址 <类型 = 变整数>
        变量 串指针 <类型 = 变整数>
        地址 = 取地址 ()
        串指针 = 值.对象指针
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fSubject = (sk_string_t*)@<串指针>, true);
        返回 (真)
    }

    方法 置关键字 <公开 类型 = 逻辑型 注释 = "设置关键字。">
    参数 值 <类型 = Skia字符串>
    {
        变量 地址 <类型 = 变整数>
        变量 串指针 <类型 = 变整数>
        地址 = 取地址 ()
        串指针 = 值.对象指针
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fKeywords = (sk_string_t*)@<串指针>, true);
        返回 (真)
    }

    方法 置创建者 <公开 类型 = 逻辑型 注释 = "设置创建者(Creator)。">
    参数 值 <类型 = Skia字符串>
    {
        变量 地址 <类型 = 变整数>
        变量 串指针 <类型 = 变整数>
        地址 = 取地址 ()
        串指针 = 值.对象指针
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fCreator = (sk_string_t*)@<串指针>, true);
        返回 (真)
    }

    方法 置生成者 <公开 类型 = 逻辑型 注释 = "设置生成者(Producer)。">
    参数 值 <类型 = Skia字符串>
    {
        变量 地址 <类型 = 变整数>
        变量 串指针 <类型 = 变整数>
        地址 = 取地址 ()
        串指针 = 值.对象指针
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fProducer = (sk_string_t*)@<串指针>, true);
        返回 (真)
    }

    方法 置创建时间 <公开 类型 = 逻辑型 注释 = "设置创建时间(时间对象必须活得比文档久)。">
    参数 值 <类型 = Skia文档时间>
    {
        变量 地址 <类型 = 变整数>
        变量 时间指针 <类型 = 变整数>
        地址 = 取地址 ()
        时间指针 = 值.取地址 ()
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fCreation = (sk_document_pdf_datetime_t*)@<时间指针>, true);
        返回 (真)
    }

    方法 置修改时间 <公开 类型 = 逻辑型 注释 = "设置修改时间。">
    参数 值 <类型 = Skia文档时间>
    {
        变量 地址 <类型 = 变整数>
        变量 时间指针 <类型 = 变整数>
        地址 = 取地址 ()
        时间指针 = 值.取地址 ()
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fModified = (sk_document_pdf_datetime_t*)@<时间指针>, true);
        返回 (真)
    }

    方法 置分辨率 <公开 类型 = 逻辑型 注释 = "设置光栅化 DPI(默认 72)。">
    参数 值 <类型 = 小数>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fRasterDPI = (float)@<值>, true);
        返回 (真)
    }

    方法 置是否为PDFA <公开 类型 = 逻辑型 注释 = "是否输出 PDF/A(归档格式)。bool 只占 1 字节。">
    参数 值 <类型 = 逻辑型>
    {
        变量 地址 <类型 = 变整数>
        地址 = 取地址 ()
        @ (((sk_document_pdf_metadata_t*)@<地址>)->fPDFA = (bool)@<值>, true);
        返回 (真)
    }

    方法 取地址 <公开 类型 = 变整数 注释 = "缓冲首地址(即 sk_document_pdf_metadata_t*)。" 折叠 @嵌入式方法 = "">
    {
        @ ((intptr_t)@sn<this>.@n<Skia文档元数据.数据>.GetPtr())
    }
}

# ============================================================
# 四、Skia文档(句柄)
# ============================================================

类 Skia文档 <公开 注释 = "PDF/XPS 文档(sk_document_t)。正确顺序: 新建 -> 循环[开始页/结束页] -> 关闭 -> 释放; 写流必须活到 释放 之后。关闭 与 放弃 只能二选一, 且都在 释放 之前。">
{
    变量 对象指针 <公开 类型 = 变整数 注释 = "原生句柄, 0 表示无效。">
    变量 是否拥有句柄 <公开 类型 = 逻辑型 值 = 真 注释 = "为假时 释放 不销毁原生对象(借用句柄)。">

    方法 取句柄 <公开 属性读 类型 = 变整数 注释 = "原生句柄(变整数)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia文档.对象指针>)
    }

    方法 新建PDF_按写流 <公开 静态 类型 = Skia文档 注释 = "静态; 默认元数据的 PDF 文档。目标写流在整个文档生命周期内必须有效, 且要活到 释放 之后。">
    参数 目标写流 <类型 = Skia写流>
    {
        变量 结果 <类型 = Skia文档>
        变量 写句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        写句柄 = 目标写流.对象指针
        @ @<新指针> = (intptr_t)sk_document_create_pdf_from_stream((sk_wstream_t*)@<写句柄>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建PDF_按写流与元数据 <公开 静态 类型 = Skia文档 注释 = "静态; 带元数据的 PDF 文档。元数据里的 Skia字符串 与 Skia文档时间 必须活得比文档久。">
    参数 目标写流 <类型 = Skia写流>
    参数 元数据 <类型 = Skia文档元数据>
    {
        变量 结果 <类型 = Skia文档>
        变量 写句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        写句柄 = 目标写流.对象指针
        @ @<新指针> = (intptr_t)sk_document_create_pdf_from_stream_with_metadata((sk_wstream_t*)@<写句柄>, (const sk_document_pdf_metadata_t*)@<元数据>.@n<Skia文档元数据.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建XPS_按写流 <公开 静态 类型 = Skia文档 注释 = "静态; XPS 文档, 分辨率单位 DPI。">
    参数 目标写流 <类型 = Skia写流>
    参数 分辨率 <类型 = 小数 @默认值 = 300.0>
    {
        变量 结果 <类型 = Skia文档>
        变量 写句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        写句柄 = 目标写流.对象指针
        @ @<新指针> = (intptr_t)sk_document_create_xps_from_stream((sk_wstream_t*)@<写句柄>, (float)@<分辨率>);
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 新建XPS_按写流与选项 <公开 静态 类型 = Skia文档 注释 = "静态; 按 SkiaXPS选项(8 字节)创建 XPS 文档。">
    参数 目标写流 <类型 = Skia写流>
    参数 选项 <类型 = SkiaXPS选项>
    {
        变量 结果 <类型 = Skia文档>
        变量 写句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        写句柄 = 目标写流.对象指针
        @ @<新指针> = (intptr_t)sk_document_create_xps_from_stream_with_options((sk_wstream_t*)@<写句柄>, (const sk_document_xps_options_t*)@<选项>.@n<SkiaXPS选项.数据>.GetPtr());
        如果 (新指针 == 0)
        {
            返回 (结果)
        }
        结果.对象指针 = 新指针
        返回 (结果)
    }

    方法 开始页 <公开 类型 = Skia画布 注释 = "开始一页, 返回借用画布(是否拥有句柄 = 假), 严禁 释放; 必须与 结束页 严格配对, 上一页未结束就调本方法属未定义行为。">
    参数 宽 <类型 = 小数>
    参数 高 <类型 = 小数>
    参数 内容矩形 <类型 = Skia矩形>
    {
        变量 结果 <类型 = Skia画布>
        变量 句柄 <类型 = 变整数>
        变量 新指针 <类型 = 变整数>
        句柄 = 对象指针
        @ @<新指针> = (intptr_t)sk_document_begin_page((sk_document_t*)@<句柄>, (float)@<宽>, (float)@<高>, (const sk_rect_t*)@<内容矩形>.@n<Skia矩形.数据>.GetPtr());
        结果.对象指针 = 新指针
        结果.是否拥有句柄 = 假
        返回 (结果)
    }

    方法 结束页 <公开 类型 = 逻辑型 注释 = "结束当前页; 结束后 开始页 返回的画布立即失效。">
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_document_end_page((sk_document_t*)@<句柄>);
        返回 (真)
    }

    方法 关闭 <公开 类型 = 逻辑型 注释 = "正常收尾并写出全部内容; 调用后文档不可再用, 但仍需 释放。与 放弃 二选一。">
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_document_close((sk_document_t*)@<句柄>);
        返回 (真)
    }

    方法 放弃 <公开 类型 = 逻辑型 注释 = "中途放弃, 不写出内容(已写入的字节仍留在写流里); 与 关闭 二选一, 且都在 释放 之前。">
    {
        变量 句柄 <类型 = 变整数>
        句柄 = 对象指针
        @ sk_document_abort((sk_document_t*)@<句柄>);
        返回 (真)
    }

    方法 释放 <公开 类型 = 逻辑型 注释 = "仅减引用计数; 应先 关闭 或 放弃; 可重复调用。">
    {
        变量 旧指针 <类型 = 变整数>
        如果 (对象指针 == 0)
        {
            返回 (真)
        }
        如果 (是否拥有句柄 == 假)
        {
            对象指针 = 0
            返回 (真)
        }
        旧指针 = 对象指针
        @ sk_document_unref((sk_document_t*)@<旧指针>);
        对象指针 = 0
        返回 (真)
    }

    方法 类_清理 <公开 注释 = "对象销毁回调: 不做任何事(句柄由调用方显式 释放)。">
    {
    }

    方法 是否有效 <公开 类型 = 逻辑型 注释 = "句柄是否有效(非 0)。" 折叠 @嵌入式方法 = "">
    {
        @ (@sn<this>.@n<Skia文档.对象指针> != 0)
    }
}
