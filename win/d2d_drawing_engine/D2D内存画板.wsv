    方法 自动重画 <公开 属性读 类型 = 逻辑型 注释 = "兼容火山画板：内存画板天然保存绘制结果，因此始终返回真。">
    {
        返回 (真)
    }

    方法 自动重画 <公开 属性写 注释 = "兼容火山画板：内存画板天然保存绘制结果，此属性保留用于兼容，设置值会被忽略。">
    参数 是否自动重画 <类型 = 逻辑型>
    {
    }

    方法 清除 <公开 注释 = "兼容火山画板：清除指定区域；默认清除整张画板为透明。">
    参数 清除区左边坐标 <类型 = 整数 @默认值 = 0>
    参数 清除区顶边坐标 <类型 = 整数 @默认值 = 0>
    参数 清除区宽度 <类型 = 整数 @默认值 = -1>
    参数 清除区高度 <类型 = 整数 @默认值 = -1>
    {
        清空区域 (清除区左边坐标, 清除区顶边坐标, 清除区宽度, 清除区高度, D2D颜色.透明 ())
    }

    方法 画图片 <公开 类型 = 逻辑型 注释 = "兼容火山画板：绘制 位图对象类。图片画出方法参数保留但内存版使用 D2D alpha 绘制。">
    参数 所欲绘制的位图 <类型 = 位图对象类>
    参数 图片左边画出位置 <类型 = 整数>
    参数 图片顶边画出位置 <类型 = 整数>
    参数 图片画出宽度 <类型 = 整数 @默认值 = -1>
    参数 图片画出高度 <类型 = 整数 @默认值 = -1>
    参数 图片画出方法 <类型 = 整数 注释 = "兼容参数，当前仅按普通透明混合绘制。" @默认值 = 0>
    {
        返回 (绘制位图对象 (所欲绘制的位图, 图片左边画出位置, 图片顶边画出位置, 图片画出宽度, 图片画出高度))
    }

    方法 置底图文件 <公开 类型 = 逻辑型 注释 = "兼容火山画板：内存版将图片文件直接绘制到画板左上角。支持 png、bmp、gif、jpg、ico、svg。">
    参数 所欲设置的位图文件名 <类型 = 文本型>
    {
        返回 (绘制图片文件 (所欲设置的位图文件名, 0, 0, 宽度, 高度))
    }

    方法 置底图数据 <公开 类型 = 逻辑型 注释 = "兼容火山画板：内存版将图片字节集直接绘制到画板左上角。支持 png、bmp、gif、jpg、ico、svg。">
    参数 所欲设置的位图文件数据 <类型 = 字节集类>
    {
        返回 (绘制图片数据 (所欲设置的位图文件数据, 0, 0, 宽度, 高度))
    }

    方法 复制 <公开 类型 = 逻辑型 注释 = "兼容火山画板：复制到另一个 D2D兼容内存画板；复制方法参数保留但当前按普通透明混合复制。">
    参数 欲复制区域的左边 <类型 = 整数 @默认值 = 0>
    参数 欲复制区域的顶边 <类型 = 整数 @默认值 = 0>
    参数 欲复制区域的宽度 <类型 = 整数 @默认值 = -1>
    参数 欲复制区域的高度 <类型 = 整数 @默认值 = -1>
    参数 复制到的目的画板 <类型 = D2D兼容内存画板>
    参数 欲复制到位置左边 <类型 = 整数 @默认值 = 0>
    参数 欲复制到位置顶边 <类型 = 整数 @默认值 = 0>
    参数 复制方法 <类型 = 整数 @默认值 = 0>
    {
        返回 (复制到 (复制到的目的画板, 欲复制区域的左边, 欲复制区域的顶边, 欲复制区域的宽度, 欲复制区域的高度, 欲复制到位置左边, 欲复制到位置顶边))
    }

    方法 取图片 <公开 类型 = 逻辑型 注释 = "兼容火山画板：取回画板内容到 位图对象类。">
    参数 所取回图片 <类型 = 位图对象类>
    参数 输出宽度 <类型 = 整数 @默认值 = 0>
    参数 输出高度 <类型 = 整数 @默认值 = 0>
    {
        返回 (取位图对象 (所取回图片, 输出宽度, 输出高度))
    }

