<火山程序 类型 = "通常" 版本 = 1 />

包 火山.D2D绘制引擎 <注释 = "D2D 内存画板封装。独立离屏绘制，不依赖 MFC 组件或窗口句柄。"
        注释 = "系统依赖同 D2D绘制引擎：Windows SDK、Direct2D、DirectWrite、WIC；SVG 使用本类库随带 lunasvg/plutovg。"
        @视窗.外部头文件 = "native\\d2d_memory_canvas.hpp" @视窗.外部源文件 = "native\\d2d_memory_canvas.cpp">

类 D2D图片编码格式 <公开 注释 = "取出画板字节集时使用的图片编码格式。" 折叠>
{
    常量 PNG <公开 类型 = 整数 值 = 0 注释 = "0.PNG，默认值，支持透明通道。">
    常量 BMP <公开 类型 = 整数 值 = 1 注释 = "1.BMP。">
    常量 JPG <公开 类型 = 整数 值 = 2 注释 = "2.JPG/JPEG，不保留透明通道。">
    常量 GIF <公开 类型 = 整数 值 = 3 注释 = "3.GIF，静态首帧输出。">
    常量 TIFF <公开 类型 = 整数 值 = 4 注释 = "4.TIFF。">
}

类 D2D画板画笔类型 <公开 注释 = "内存画板画笔类型。" 折叠>
{
    常量 实线 <公开 类型 = 整数 值 = 0 注释 = "0.实线，默认值。">
    常量 空笔 <公开 类型 = 整数 值 = 1 注释 = "1.不描边。">
}

类 D2D画板刷子类型 <公开 注释 = "内存画板填充刷子类型。" 折叠>
{
    常量 颜色刷子 <公开 类型 = 整数 值 = 0 注释 = "0.纯色填充，默认值。">
    常量 空刷子 <公开 类型 = 整数 值 = 1 注释 = "1.不填充。">
}

类 D2D内存画板 <公开 注释 = "全功能 D2D 离屏内存画板。支持 D2D 图元、文本、WIC 图片、SVG 图片、导出字节集和位图对象类。">
{

    #
    # @ @m<DECLARE_REF_OBJECT_CLASS_WITH_DATA> (volcano_d2d::MemoryCanvas)

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建内存画板。宽高为逻辑单位，内部自动按 取屏幕DPI() 放大物理像素；默认背景为透明；默认画笔黑色1、刷子白色、文本黑色。">
    参数 宽度 <类型 = 整数 注释 = "画板逻辑宽度；取屏幕DPI()为1时等同像素。">
    参数 高度 <类型 = 整数 注释 = "画板逻辑高度；取屏幕DPI()为1时等同像素。">
    参数 背景颜色 <类型 = D2D颜色 注释 = "初始背景色；需要透明时传入 D2D颜色.透明()。">
    {
        返回 (创建按DPI比例 (宽度, 高度, 背景颜色, 取屏幕DPI ()))
    }

    方法 销毁 <公开 注释 = "释放内存画板、D2D目标、HBITMAP和相关资源。" @嵌入式方法 = "">
    {
        @ @sn<this>.data().Destroy()
    }

    方法 是否可用 <公开 类型 = 逻辑型 @嵌入式方法 = "">
    {
        @ @sn<this>.data().IsReady()
    }

    方法 调整尺寸 <公开 类型 = 逻辑型 注释 = "按当前 取屏幕DPI() 重建画板尺寸，会清空原内容。默认背景为透明。">
    参数 宽度 <类型 = 整数 注释 = "画板逻辑宽度；取屏幕DPI()为1时等同像素。">
    参数 高度 <类型 = 整数 注释 = "画板逻辑高度；取屏幕DPI()为1时等同像素。">
    参数 背景颜色 <类型 = D2D颜色 注释 = "重建后的背景色；需要透明时传入 D2D颜色.透明()。">
    {
        返回 (调整尺寸按DPI比例 (宽度, 高度, 背景颜色, 取屏幕DPI ()))
    }

    方法 创建按DPI比例 <类型 = 逻辑型 @嵌入式方法 = "">
    参数 宽度 <类型 = 整数>
    参数 高度 <类型 = 整数>
    参数 背景颜色 <类型 = D2D颜色>
    参数 DPI比例 <类型 = 小数>
    {
        @ @sn<this>.data().Create(@<宽度>, @<高度>, @<DPI比例>, @<背景颜色>)
    }

    方法 调整尺寸按DPI比例 <类型 = 逻辑型 @嵌入式方法 = "">
    参数 宽度 <类型 = 整数>
    参数 高度 <类型 = 整数>
    参数 背景颜色 <类型 = D2D颜色>
    参数 DPI比例 <类型 = 小数>
    {
        @ @sn<this>.data().Resize(@<宽度>, @<高度>, @<DPI比例>, @<背景颜色>)
    }

    方法 宽度 <公开 属性读 类型 = 整数 注释 = "画板逻辑宽度；取屏幕DPI()为1时等同像素。" @嵌入式方法 = "">
    {
        @ @sn<this>.data().Width()
    }

    方法 高度 <公开 属性读 类型 = 整数 注释 = "画板逻辑高度；取屏幕DPI()为1时等同像素。" @嵌入式方法 = "">
    {
        @ @sn<this>.data().Height()
    }

    方法 开始绘制 <公开 注释 = "开始批量绘制。大量连续操作时先调用本方法，结束后调用 结束绘制，可减少 BeginDraw/EndDraw 开销。" @嵌入式方法 = "">
    {
        @ @sn<this>.data().BeginDraw()
    }

    方法 结束绘制 <公开 类型 = 逻辑型 注释 = "结束批量绘制；返回假表示 D2D 提交失败。" @嵌入式方法 = "">
    {
        @ SUCCEEDED(@sn<this>.data().EndDraw())
    }

    方法 刷新 <公开 @嵌入式方法 = "">
    {
        @ @sn<this>.data().Flush()
    }

    方法 清空 <公开 注释 = "清空整张画板。默认颜色：透明。" @嵌入式方法 = "">
    参数 颜色 <类型 = D2D颜色 注释 = "清空颜色；需要透明时传入 D2D颜色.透明()。">
    {
        @ @sn<this>.data().Clear(@<颜色>)
    }

    方法 清空区域 <公开 注释 = "用指定颜色填充一块区域；宽高为 -1 时延伸到画板右/下边。默认颜色：透明。" @嵌入式方法 = "">
    参数 左 <类型 = 整数 @默认值 = 0>
    参数 顶 <类型 = 整数 @默认值 = 0>
    参数 宽度 <类型 = 整数 @默认值 = -1>
    参数 高度 <类型 = 整数 @默认值 = -1>
    参数 颜色 <类型 = D2D颜色 注释 = "填充颜色；需要透明时传入 D2D颜色.透明()。">
    {
        @ @sn<this>.data().ClearRect(@<左>, @<顶>, @<宽度>, @<高度>, @<颜色>)
    }

    方法 置画笔 <公开 注释 = "设置当前画笔。画笔类型：0.实线，1.空笔；默认值：0。" @嵌入式方法 = "">
    参数 颜色 <类型 = D2D颜色 注释 = "画笔颜色。默认黑色。">
    参数 粗细 <类型 = 单精度小数 注释 = "画笔粗细，单位像素；小于等于0时按1处理。" @默认值 = 1.0>
    参数 类型 <类型 = 整数 注释 = "0.实线，1.空笔。默认值：0。" @默认值 = D2D画板画笔类型.实线>
    {
        @ @sn<this>.data().SetPen(@<颜色>, static_cast<float>(@<粗细>), @<类型>)
    }

    方法 置刷子 <公开 注释 = "设置当前填充刷子。刷子类型：0.颜色刷子，1.空刷子；默认值：0。" @嵌入式方法 = "">
    参数 颜色 <类型 = D2D颜色 注释 = "刷子颜色。默认白色。">
    参数 类型 <类型 = 整数 注释 = "0.颜色刷子，1.空刷子。默认值：0。" @默认值 = D2D画板刷子类型.颜色刷子>
    {
        @ @sn<this>.data().SetBrush(@<颜色>, @<类型>)
    }

    方法 置文本颜色 <公开 @嵌入式方法 = "">
    参数 颜色 <类型 = D2D颜色 注释 = "默认黑色。">
    {
        @ @sn<this>.data().SetTextColor(@<颜色>)
    }

    方法 置文本背景颜色 <公开 注释 = "设置文本背景色。默认透明。" @嵌入式方法 = "">
    参数 颜色 <类型 = D2D颜色 注释 = "默认透明背景可传入 D2D颜色.透明()。">
    {
        @ @sn<this>.data().SetTextBackgroundColor(@<颜色>)
    }

    方法 置字体 <公开 注释 = "设置文本字体。默认：微软雅黑、16、常规。" @嵌入式方法 = "">
    参数 字体名 <类型 = 文本型 @默认值 = "微软雅黑">
    参数 字号 <类型 = 单精度小数 @默认值 = 16.0>
    参数 粗细 <类型 = 整数 注释 = "DWRITE_FONT_WEIGHT，默认值400。" @默认值 = D2D字体粗细.常规>
    参数 样式 <类型 = 整数 注释 = "0.正常，1.倾斜，2.斜体。默认值：0。" @默认值 = D2D字体样式.正常>
    {
        @ @sn<this>.data().SetFont(@<字体名>.GetText(), static_cast<float>(@<字号>), @<粗细>, @<样式>)
    }

    方法 取点 <公开 类型 = 整数 注释 = "返回指定像素点颜色，COLORREF格式；越界返回 -1。" @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ @sn<this>.data().GetPixel(@<横坐标>, @<纵坐标>)
    }

    方法 画点 <公开 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    参数 颜色 <类型 = D2D颜色>
    {
        @ @sn<this>.data().DrawPoint(@<横坐标>, @<纵坐标>, @<颜色>)
    }

    方法 画直线 <公开 @嵌入式方法 = "">
    参数 起点X <类型 = 整数>
    参数 起点Y <类型 = 整数>
    参数 终点X <类型 = 整数>
    参数 终点Y <类型 = 整数>
    {
        @ @sn<this>.data().DrawLine(@<起点X>, @<起点Y>, @<终点X>, @<终点Y>)
    }

    方法 画矩形 <公开 注释 = "使用当前画笔描边、当前刷子填充。" @嵌入式方法 = "">
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 右 <类型 = 整数>
    参数 底 <类型 = 整数>
    {
        @ @sn<this>.data().DrawRectangle(@<左>, @<顶>, @<右>, @<底>)
    }

    方法 填充矩形 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 右 <类型 = 整数>
    参数 底 <类型 = 整数>
    {
        @ @sn<this>.data().FillRectangle(@<左>, @<顶>, @<右>, @<底>)
    }

    方法 画椭圆 <公开 注释 = "使用当前画笔描边、当前刷子填充。" @嵌入式方法 = "">
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 右 <类型 = 整数>
    参数 底 <类型 = 整数>
    {
        @ @sn<this>.data().DrawEllipse(@<左>, @<顶>, @<右>, @<底>)
    }

    方法 填充椭圆 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 右 <类型 = 整数>
    参数 底 <类型 = 整数>
    {
        @ @sn<this>.data().FillEllipse(@<左>, @<顶>, @<右>, @<底>)
    }

    方法 画圆角矩形 <公开 注释 = "使用当前画笔描边、当前刷子填充。圆角高度为 -1 时等于圆角宽度。" @嵌入式方法 = "">
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 右 <类型 = 整数>
    参数 底 <类型 = 整数>
    参数 圆角宽度 <类型 = 整数>
    参数 圆角高度 <类型 = 整数 @默认值 = -1>
    {
        @ @sn<this>.data().DrawRoundRect(@<左>, @<顶>, @<右>, @<底>, @<圆角宽度>, @<圆角高度>)
    }

    方法 填充圆角矩形 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 右 <类型 = 整数>
    参数 底 <类型 = 整数>
    参数 圆角宽度 <类型 = 整数>
    参数 圆角高度 <类型 = 整数 @默认值 = -1>
    {
        @ @sn<this>.data().FillRoundRect(@<左>, @<顶>, @<右>, @<底>, @<圆角宽度>, @<圆角高度>)
    }

    方法 画多边形 <公开 注释 = "整数数组按 x1,y1,x2,y2... 存放；顶点数为 -1 时使用数组内全部点。" @嵌入式方法 = "">
    参数 多边形顶点数组 <类型 = 整数数组类>
    参数 顶点数目 <类型 = 整数 @默认值 = -1>
    {
        @ ([&]() { const CMArray<INT>& __pts = @<多边形顶点数组>.data(); int __count = @<顶点数目>; if (__count < 0 || __count > (int)(__pts.GetCount() / 2)) __count = (int)(__pts.GetCount() / 2); @sn<this>.data().DrawPolygon((const int*)__pts.GetData(), __count); }())
    }

    方法 填充多边形 <公开 注释 = "整数数组按 x1,y1,x2,y2... 存放；顶点数为 -1 时使用数组内全部点。" @嵌入式方法 = "">
    参数 多边形顶点数组 <类型 = 整数数组类>
    参数 顶点数目 <类型 = 整数 @默认值 = -1>
    {
        @ ([&]() { const CMArray<INT>& __pts = @<多边形顶点数组>.data(); int __count = @<顶点数目>; if (__count < 0 || __count > (int)(__pts.GetCount() / 2)) __count = (int)(__pts.GetCount() / 2); @sn<this>.data().FillPolygon((const int*)__pts.GetData(), __count); }())
    }

    方法 置写出位置 <公开 @嵌入式方法 = "">
    参数 横向写出位置 <类型 = 整数 @默认值 = 数值范围.最大整数值>
    参数 纵向写出位置 <类型 = 整数 @默认值 = 数值范围.最大整数值>
    {
        @ @sn<this>.data().SetWritePos(@<横向写出位置>, @<纵向写出位置>)
    }

    方法 写文本行 <公开 注释 = "在当前写出位置写出文本并换行。" @嵌入式方法 = "">
    参数 内容 <@匹配类型 = 通用基本型>
    参数 行间距 <类型 = 整数 @默认值 = 2>
    {
        @ @sn<this>.data().DrawTextAt(INT_MAX, INT_MAX, @an<CVolString>(@<内容>).GetText(), @<行间距>)
    }

    方法 写出 <公开 注释 = "在当前写出位置写出文本，不强制换行。" @嵌入式方法 = "">
    参数 内容 <@匹配类型 = 通用基本型>
    参数 行间距 <类型 = 整数 @默认值 = 2>
    {
        @ @sn<this>.data().DrawTextAt(INT_MAX, INT_MAX, @an<CVolString>(@<内容>).GetText(), -1)
    }

    方法 定位写出 <公开 注释 = "在指定位置写出文本，不改变已有布局规则。" @嵌入式方法 = "">
    参数 横向写出位置 <类型 = 整数 @默认值 = 数值范围.最大整数值>
    参数 纵向写出位置 <类型 = 整数 @默认值 = 数值范围.最大整数值>
    参数 内容 <@匹配类型 = 通用基本型>
    参数 行间距 <类型 = 整数 @默认值 = 2>
    {
        @ ([&]() { int __writeX = @<横向写出位置>; int __writeY = @<纵向写出位置>; int __x = __writeX == INT_MAX ? 0 : __writeX; int __y = __writeY == INT_MAX ? 0 : __writeY; @sn<this>.data().DrawTextAt(__x, __y, @an<CVolString>(@<内容>).GetText(), -1); }())
    }

    方法 绘制文本 <公开 注释 = "在矩形中绘制文本。水平/垂直对齐：0.居中，1.左/上，2.右/下；默认居中。" @嵌入式方法 = "">
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 右 <类型 = 整数>
    参数 底 <类型 = 整数>
    参数 内容 <类型 = 文本型>
    参数 水平对齐 <类型 = 整数 注释 = "0.居中，1.左对齐，2.右对齐。默认值：0。" @默认值 = 0>
    参数 垂直对齐 <类型 = 整数 注释 = "0.居中，1.上对齐，2.下对齐。默认值：0。" @默认值 = 0>
    参数 自动换行 <类型 = 逻辑型 @默认值 = 真>
    {
        @ @sn<this>.data().DrawTextInRect(@<左>, @<顶>, @<右>, @<底>, @<内容>.GetText(), @<水平对齐>, @<垂直对齐>, @<自动换行>)
    }

    方法 取宽度 <公开 类型 = 整数 注释 = "返回文本绘制宽度，单位像素。" @嵌入式方法 = "">
    参数 内容 <@匹配类型 = 通用基本型>
    {
        @ @sn<this>.data().TextWidth(@an<CVolString>(@<内容>).GetText())
    }

    方法 取高度 <公开 类型 = 整数 注释 = "返回文本绘制高度，单位像素。" @嵌入式方法 = "">
    参数 内容 <@匹配类型 = 通用基本型>
    {
        @ @sn<this>.data().TextHeight(@an<CVolString>(@<内容>).GetText())
    }

    方法 绘制图片文件 <公开 类型 = 逻辑型 注释 = "绘制图片文件。支持 WIC 可解码格式：png、bmp、gif、jpg、ico等；svg 自动走 SVG 渲染。" @嵌入式方法 = "">
    参数 文件名 <类型 = 文本型>
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 宽度 <类型 = 整数 注释 = "-1 使用图片原宽度。" @默认值 = -1>
    参数 高度 <类型 = 整数 注释 = "-1 使用图片原高度。" @默认值 = -1>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    参数 插值模式 <类型 = 整数 @默认值 = D2D位图插值模式.线性>
    {
        @ @sn<this>.data().DrawImageFile(@<文件名>.GetText(), @<左>, @<顶>, @<宽度>, @<高度>, @<不透明度>, @<插值模式>)
    }

    方法 绘制图片数据 <公开 类型 = 逻辑型 注释 = "绘制图片字节集。支持 png、bmp、gif、jpg、ico 等 WIC 格式；svg 文本数据自动走 SVG 渲染。" @嵌入式方法 = "">
    参数 图片数据 <类型 = 字节集类>
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 宽度 <类型 = 整数 @默认值 = -1>
    参数 高度 <类型 = 整数 @默认值 = -1>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    参数 插值模式 <类型 = 整数 @默认值 = D2D位图插值模式.线性>
    {
        @ { auto& __data = @<图片数据>;
        @ @sn<this>.data().DrawImageData(__data.GetPtr(), (int)__data.GetSize(), @<左>, @<顶>, @<宽度>, @<高度>, @<不透明度>, @<插值模式>); }
    }

    方法 绘制SVG文件 <公开 类型 = 逻辑型 注释 = "绘制 SVG 文件。宽高为 -1 时使用 SVG 自身尺寸或默认尺寸。" @嵌入式方法 = "">
    参数 文件名 <类型 = 文本型>
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 宽度 <类型 = 整数 @默认值 = -1>
    参数 高度 <类型 = 整数 @默认值 = -1>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    参数 插值模式 <类型 = 整数 @默认值 = D2D位图插值模式.线性>
    {
        @ @sn<this>.data().DrawSvgFile(@<文件名>.GetText(), @<左>, @<顶>, @<宽度>, @<高度>, @<不透明度>, @<插值模式>)
    }

    方法 绘制SVG数据 <公开 类型 = 逻辑型 注释 = "绘制 SVG 字节集文本。" @嵌入式方法 = "">
    参数 SVG数据 <类型 = 字节集类>
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 宽度 <类型 = 整数 @默认值 = -1>
    参数 高度 <类型 = 整数 @默认值 = -1>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    参数 插值模式 <类型 = 整数 @默认值 = D2D位图插值模式.线性>
    {
        @ { auto& __data = @<SVG数据>;
        @ @sn<this>.data().DrawSvgData(__data.GetPtr(), (int)__data.GetSize(), @<左>, @<顶>, @<宽度>, @<高度>, @<不透明度>, @<插值模式>); }
    }

    方法 绘制位图对象 <公开 类型 = 逻辑型 注释 = "绘制火山 位图对象类。" @嵌入式方法 = "">
    参数 位图 <类型 = 位图对象类>
    参数 左 <类型 = 整数>
    参数 顶 <类型 = 整数>
    参数 宽度 <类型 = 整数 @默认值 = -1>
    参数 高度 <类型 = 整数 @默认值 = -1>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    参数 插值模式 <类型 = 整数 @默认值 = D2D位图插值模式.线性>
    {
        @ @sn<this>.data().DrawHBitmap((HBITMAP)@<位图>.GetGDIHandle(), @<左>, @<顶>, @<宽度>, @<高度>, @<不透明度>, @<插值模式>)
    }

    方法 复制到 <公开 类型 = 逻辑型 注释 = "把本画板内容复制到另一个 D2D内存画板。" @嵌入式方法 = "">
    参数 目的画板 <类型 = D2D内存画板>
    参数 源左 <类型 = 整数 @默认值 = 0>
    参数 源顶 <类型 = 整数 @默认值 = 0>
    参数 源宽度 <类型 = 整数 @默认值 = -1>
    参数 源高度 <类型 = 整数 @默认值 = -1>
    参数 目标左 <类型 = 整数 @默认值 = 0>
    参数 目标顶 <类型 = 整数 @默认值 = 0>
    参数 目标宽度 <类型 = 整数 @默认值 = -1>
    参数 目标高度 <类型 = 整数 @默认值 = -1>
    {
        @ @sn<this>.data().CopyTo(@<目的画板>.data(), @<源左>, @<源顶>, @<源宽度>, @<源高度>, @<目标左>, @<目标顶>, @<目标宽度>, @<目标高度>)
    }

    方法 取图片数据 <公开 类型 = 字节集类 注释 = "把画板编码为图片字节集。格式：0.PNG，1.BMP，2.JPG，3.GIF，4.TIFF；默认 PNG。质量仅 JPG 使用，默认90。">
    参数 格式 <类型 = 整数 注释 = "0.PNG，1.BMP，2.JPG，3.GIF，4.TIFF。默认值：0。" @默认值 = D2D图片编码格式.PNG>
    参数 质量 <类型 = 整数 注释 = "JPG质量 1-100，默认值：90。" @默认值 = 90>
    {
        变量 图片数据 <类型 = 字节集类>
        D2D编码图片数据 (图片数据, 格式, 质量)
        返回 (图片数据)
    }

    方法 取PNG数据 <公开 类型 = 字节集类 注释 = "把画板编码为 PNG 字节集，保留透明通道。">
    {
        返回 (取图片数据 (D2D图片编码格式.PNG, 90))
    }

    方法 D2D编码图片数据 <@嵌入式方法 = "">
    参数 输出数据 <类型 = 字节集类>
    参数 格式 <类型 = 整数>
    参数 质量 <类型 = 整数>
    {
        @ CVolMem* __d2dOutMem = &@<输出数据>;
        @ std::vector<unsigned char> __d2dBytes;
        @ __d2dOutMem->Free();
        @ if (@sn<this>.data().EncodeToMemory(@<格式>, @<质量>, __d2dBytes)) {
        @     void* __d2dPtr = __d2dOutMem->Alloc((INT_P)__d2dBytes.size(), TRUE);
        @     if (__d2dPtr && !__d2dBytes.empty()) memcpy(__d2dPtr, __d2dBytes.data(), __d2dBytes.size());
        @ }
    }

    方法 取位图对象 <公开 类型 = 逻辑型 注释 = "取出画板当前内容到 位图对象类。输出宽高为0时使用原尺寸。" @嵌入式方法 = "">
    参数 输出位图 <类型 = 位图对象类>
    参数 输出宽度 <类型 = 整数 @默认值 = 0>
    参数 输出高度 <类型 = 整数 @默认值 = 0>
    {
        @ @<输出位图.置位图句柄值> ((INT_P)@sn<this>.data().CloneHBitmap(@<输出宽度>, @<输出高度>), TRUE)
    }

    方法 保存到文件 <公开 类型 = 逻辑型 注释 = "保存画板图片到文件。格式：0.PNG，1.BMP，2.JPG，3.GIF，4.TIFF；默认 PNG。" @嵌入式方法 = "">
    参数 文件名 <类型 = 文本型>
    参数 格式 <类型 = 整数 注释 = "0.PNG，1.BMP，2.JPG，3.GIF，4.TIFF。默认值：0。" @默认值 = D2D图片编码格式.PNG>
    参数 质量 <类型 = 整数 注释 = "JPG质量 1-100，默认值：90。" @默认值 = 90>
    {
        @ @sn<this>.data().SaveToFile(@<文件名>.GetText(), @<格式>, @<质量>)
    }

    方法 取错误码 <公开 类型 = 整数 @嵌入式方法 = "">
    {
        @ (int)@sn<this>.data().LastResult()
    }

    方法 取错误文本 <公开 类型 = 文本型 @嵌入式方法 = "">
    {
        @ @an<CVolString>(@sn<this>.data().LastErrorText().c_str())
    }
}

类 D2D兼容内存画板 <公开 折叠 基础类 = D2D内存画板 注释 = "接口尽量兼容火山视窗 画板 组件的离屏内存画板。不是组件，不创建窗口，组件特有事件/句柄/可视属性不提供。">
{
    变量 当前画笔颜色 <类型 = D2D颜色>
    变量 当前画笔颜色值 <类型 = 整数 值 = 0>
    变量 当前画笔粗细 <类型 = 整数 值 = 1>
    变量 当前刷子颜色 <类型 = D2D颜色>
    变量 当前刷子颜色值 <类型 = 整数 值 = 16777215>
    变量 当前文本颜色值 <类型 = 整数 值 = 0>
    变量 当前背景颜色值 <类型 = 整数 值 = -1>
    变量 当前画笔类型 <类型 = 整数 值 = 0>
    变量 当前刷子类型 <类型 = 整数 值 = 0>

    方法 画板宽度 <公开 属性读 类型 = 整数 注释 = "兼容火山画板：返回画板宽度，单位逻辑尺寸；取屏幕DPI()为1时等同像素。">
    {
        返回 (宽度)
    }

    方法 画板高度 <公开 属性读 类型 = 整数 注释 = "兼容火山画板：返回画板高度，单位逻辑尺寸；取屏幕DPI()为1时等同像素。">
    {
        返回 (高度)
    }

    方法 画笔颜色 <公开 属性写 注释 = "兼容火山画板：设置画笔颜色，默认黑色。" @值细节类型 = 颜色>
    参数 颜色值 <类型 = 整数>
    {
        当前画笔颜色值 = 颜色值
        当前画笔颜色 = D2D颜色.从整数 (颜色值)
        置画笔 (当前画笔颜色, 当前画笔粗细, 当前画笔类型)
    }

    方法 画笔颜色 <公开 属性读 类型 = 整数 注释 = "兼容火山画板：返回当前画笔颜色。">
