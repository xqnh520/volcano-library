    {
        状态标题颜色值3 = 新颜色
        状态标题已设置3 = 真
        刷新 ()
    }

    方法 普通边框颜色 <公开 属性读 类型 = 整数 注释 = "读取普通状态边框颜色。未设置时使用按钮内置边框颜色。边框宽度为 0 时不会显示。">
    {
        返回 (状态边框颜色值0)
    }

    方法 普通边框颜色 <公开 属性写 注释 = "设置普通状态边框颜色，并标记普通边框颜色已设置。边框宽度为 0 时不会显示。" @视窗.设置时机 = 组件创建前后 @值细节类型 = 颜色支持默认>
    参数 新颜色 <类型 = 整数 注释 = "普通状态边框颜色。">
    {
        状态边框颜色值0 = 新颜色
        状态边框已设置0 = 真
        刷新 ()
    }

    方法 悬停边框颜色 <公开 属性读 类型 = 整数 注释 = "读取悬停状态边框颜色。未设置时沿用普通边框颜色。">
    {
        返回 (状态边框颜色值1)
    }

    方法 悬停边框颜色 <公开 属性写 注释 = "设置悬停状态边框颜色，并标记悬停边框颜色已设置。" @视窗.设置时机 = 组件创建前后 @值细节类型 = 颜色支持默认>
    参数 新颜色 <类型 = 整数 注释 = "悬停状态边框颜色。">
    {
        状态边框颜色值1 = 新颜色
        状态边框已设置1 = 真
        刷新 ()
    }

    方法 按下边框颜色 <公开 属性读 类型 = 整数 注释 = "读取按下状态边框颜色。未设置时优先沿用悬停边框颜色，再沿用普通边框颜色。">
    {
        返回 (状态边框颜色值2)
    }

    方法 按下边框颜色 <公开 属性写 注释 = "设置按下状态边框颜色，并标记按下边框颜色已设置。" @视窗.设置时机 = 组件创建前后 @值细节类型 = 颜色支持默认>
    参数 新颜色 <类型 = 整数 注释 = "按下状态边框颜色。">
    {
        状态边框颜色值2 = 新颜色
        状态边框已设置2 = 真
        刷新 ()
    }

    方法 禁用边框颜色 <公开 属性读 类型 = 整数 注释 = "读取禁用状态边框颜色。未设置时沿用普通边框颜色或内置边框默认色。">
    {
        返回 (状态边框颜色值3)
    }

    方法 禁用边框颜色 <公开 属性写 注释 = "设置禁用状态边框颜色，并标记禁用边框颜色已设置。" @视窗.设置时机 = 组件创建前后 @值细节类型 = 颜色支持默认>
    参数 新颜色 <类型 = 整数 注释 = "禁用状态边框颜色。">
    {
        状态边框颜色值3 = 新颜色
        状态边框已设置3 = 真
        刷新 ()
    }

    方法 置配色 <公开 注释 = "一次性设置按钮各状态颜色。调用后按钮使用自定义配色，不再使用默认配色。">
    参数 普通颜色 <类型 = 整数 注释 = "按钮普通状态背景色。">
    参数 悬停颜色 <类型 = 整数 注释 = "鼠标悬停在按钮上时的背景色。">
    参数 按下颜色 <类型 = 整数 注释 = "鼠标按下按钮时的背景色。">
    参数 禁用颜色 <类型 = 整数 注释 = "按钮被禁止时的背景色。">
    参数 文字颜色 <类型 = 整数 注释 = "按钮可用状态标题颜色。">
    参数 禁用文字颜色 <类型 = 整数 注释 = "按钮被禁止时标题颜色。">
    参数 边框颜色 <类型 = 整数 注释 = "按钮边框颜色；边框宽度为 0 时不显示。">
    {
        自定义配色值 = 真
        普通颜色值 = 普通颜色
        悬停颜色值 = 悬停颜色
        按下颜色值 = 按下颜色
        禁用颜色值 = 禁用颜色
        文字颜色值 = 文字颜色
        禁用文字颜色值 = 禁用文字颜色
        边框颜色值 = 边框颜色
        刷新 ()
    }

    方法 置状态颜色 <公开 注释 = "设置指定D2D按钮状态的背景、标题和边框颜色。每类颜色都可独立决定是否覆盖；未覆盖的状态会按回退规则沿用其它状态或内置默认值。">
    参数 状态 <类型 = 整数 注释 = "D2D按钮状态，见 D2D按钮状态：0 普通，1 悬停，2 按下，3 禁用。">
    参数 背景颜色 <类型 = 整数 注释 = "状态背景色。">
    参数 设置背景 <类型 = 逻辑型 注释 = "真表示覆盖此状态背景色，假表示背景色继续沿用回退规则。">
    参数 标题颜色 <类型 = 整数 注释 = "状态标题文字颜色。">
    参数 设置标题 <类型 = 逻辑型 注释 = "真表示覆盖此状态标题颜色，假表示标题色继续沿用回退规则。">
    参数 边框颜色 <类型 = 整数 注释 = "状态边框颜色。">
    参数 设置边框 <类型 = 逻辑型 注释 = "真表示覆盖此状态边框颜色，假表示边框色继续沿用回退规则。">
    {
        如果 (状态 == D2D按钮状态.普通)
        {
            状态背景颜色值0 = 背景颜色
            状态标题颜色值0 = 标题颜色
            状态边框颜色值0 = 边框颜色
            状态背景已设置0 = 设置背景
            状态标题已设置0 = 设置标题
            状态边框已设置0 = 设置边框
        }
        如果 (状态 == D2D按钮状态.悬停)
        {
            状态背景颜色值1 = 背景颜色
            状态标题颜色值1 = 标题颜色
            状态边框颜色值1 = 边框颜色
            状态背景已设置1 = 设置背景
            状态标题已设置1 = 设置标题
            状态边框已设置1 = 设置边框
        }
        如果 (状态 == D2D按钮状态.按下)
        {
            状态背景颜色值2 = 背景颜色
            状态标题颜色值2 = 标题颜色
            状态边框颜色值2 = 边框颜色
            状态背景已设置2 = 设置背景
            状态标题已设置2 = 设置标题
            状态边框已设置2 = 设置边框
        }
        如果 (状态 == D2D按钮状态.禁用)
        {
            状态背景颜色值3 = 背景颜色
            状态标题颜色值3 = 标题颜色
            状态边框颜色值3 = 边框颜色
            状态背景已设置3 = 设置背景
            状态标题已设置3 = 设置标题
            状态边框已设置3 = 设置边框
        }
        刷新 ()
    }

    方法 置图标数据 <公开 注释 = "运行时动态设置按钮图标字节数据。支持常见 SVG path 文本和 WIC 可解码位图数据；调用后会覆盖内部图标字节集，后续绘制直接使用这份数据。">
    参数 新数据 <类型 = 字节集类 注释 = "SVG/PNG/JPG 等图标文件的完整字节数据。传入空字节集可清除当前图标。">
    {
        图标数据值 = 新数据
        刷新 ()
    }

    方法 置状态图标数据 <公开 注释 = "运行时动态设置指定D2D按钮状态的图标字节数据。未设置的状态会按回退规则沿用其它状态图标；空字节集表示此状态不单独设置图标。">
    参数 状态 <类型 = 整数 注释 = "D2D按钮状态，见 D2D按钮状态：0 普通，1 悬停，2 按下，3 禁用。">
    参数 新数据 <类型 = 字节集类 注释 = "SVG/PNG/JPG 等图标文件的完整字节数据。">
    {
        如果 (状态 == D2D按钮状态.普通)
        {
            图标数据值 = 新数据
        }
        如果 (状态 == D2D按钮状态.悬停)
        {
            悬停图标数据值 = 新数据
        }
        如果 (状态 == D2D按钮状态.按下)
        {
            按下图标数据值 = 新数据
        }
        如果 (状态 == D2D按钮状态.禁用)
        {
            禁用图标数据值 = 新数据
        }
        刷新 ()
    }

    方法 D2D初始化 <公开 类型 = 逻辑型 注释 = "内部方法：在窗口组件创建完毕后绑定当前 HWND、创建轻量 D2D 组件并安装自动重画。通常不需要用户手动调用。">
    参数 组件类型 <类型 = 整数 注释 = "轻量组件类型，见 D2D组件类型：1 面板，2 按钮，3 文本块，4 进度条，5 复选框，6 滑块，7 标签栏。按钮内部传入 D2D组件类型.按钮。">
    {
        变量 选项 <类型 = D2D渲染选项>
        D2D已初始化 = 假
        D2D组件类型值 = 组件类型
        选项 = D2D渲染选项.默认选项 ()
        如果 (D2D引擎.创建到窗口Ex (取窗口句柄 (), 0, 0, 选项) == 假)
        {
            返回 (假)
        }
        D2D组件 = D2D组件工具.创建组件 (D2D引擎, D2D组件类型值)
        D2D已初始化 = 真
        D2D同步属性 ()
        返回 (D2D引擎.安装自动重画Ex2 (D2D取回调对象指针 (), D2D取绘制回调指针 (), D2D取鼠标回调指针 (), D2D取键盘回调指针 ()))
    }

    方法 D2D同步属性 <公开 注释 = "内部方法：把继承的标题、字体、可视、禁止等基础属性，以及按钮扩展外观属性同步到 D2D 绘制对象。通常不需要用户手动调用。">
    {
        如果 (D2D已初始化 == 假)
        {
            返回
        }
        D2D组件工具.组件置像素矩形 (D2D引擎, D2D组件, 0.0, 0.0, 取用户区宽度 (), 取用户区高度 ())
        D2D组件工具.组件置文本 (D2D引擎, D2D组件, 标题)
        D2D组件工具.组件置启用 (D2D引擎, D2D组件, D2D引擎.窗口是否启用 (取窗口句柄 ()))
        D2D组件工具.组件置可见 (D2D引擎, D2D组件, D2D引擎.窗口是否可视 (取窗口句柄 ()))
        D2D组件工具.组件置按钮外观 (D2D引擎, D2D组件, 圆角值, 边框宽度值)
        D2D组件工具.组件置按钮字体描述 (D2D引擎, D2D组件, 字体)
        D2D组件工具.组件置按钮布局 (D2D引擎, D2D组件, 水平边距值, 垂直边距值, 图标间距值, 图标位置值, 水平对齐值, 自动换行值)
        D2D组件工具.组件置选中 (D2D引擎, D2D组件, 已选中值)
        D2D组件工具.组件置按钮选项 (D2D引擎, D2D组件, 外观样式值, 可切换值, 已获得焦点值, 默认按钮值, D2D颜色.从整数 (焦点颜色值), 焦点线宽值)
        D2D组件工具.组件置按钮效果 (D2D引擎, D2D组件, 按下偏移值, 阴影偏移X值, 阴影偏移Y值, 阴影透明度值, 渐变高光值, 垂直对齐值)
        D2D组件工具.组件置按钮图标数据 (D2D引擎, D2D组件, 图标数据值, 图标大小值, D2D颜色.从整数 (图标颜色值), 使用图标颜色值)
        D2D组件工具.组件置按钮状态图标数据 (D2D引擎, D2D组件, D2D按钮状态.悬停, 悬停图标数据值, 图标大小值, D2D颜色.从整数 (图标颜色值), 使用图标颜色值)
        D2D组件工具.组件置按钮状态图标数据 (D2D引擎, D2D组件, D2D按钮状态.按下, 按下图标数据值, 图标大小值, D2D颜色.从整数 (图标颜色值), 使用图标颜色值)
        D2D组件工具.组件置按钮状态图标数据 (D2D引擎, D2D组件, D2D按钮状态.禁用, 禁用图标数据值, 图标大小值, D2D颜色.从整数 (图标颜色值), 使用图标颜色值)
        如果 (自定义配色值)
        {
            D2D组件工具.组件置按钮配色 (D2D引擎, D2D组件, D2D颜色.从整数 (普通颜色值), D2D颜色.从整数 (悬停颜色值), D2D颜色.从整数 (按下颜色值), D2D颜色.从整数 (禁用颜色值), D2D颜色.从整数 (文字颜色值), D2D颜色.从整数 (禁用文字颜色值), D2D颜色.从整数 (边框颜色值))
        }
        D2D组件工具.组件置按钮状态颜色 (D2D引擎, D2D组件, D2D按钮状态.普通, D2D颜色.从整数 (状态背景颜色值0), 状态背景已设置0, D2D颜色.从整数 (状态标题颜色值0), 状态标题已设置0, D2D颜色.从整数 (状态边框颜色值0), 状态边框已设置0)
        D2D组件工具.组件置按钮状态颜色 (D2D引擎, D2D组件, D2D按钮状态.悬停, D2D颜色.从整数 (状态背景颜色值1), 状态背景已设置1, D2D颜色.从整数 (状态标题颜色值1), 状态标题已设置1, D2D颜色.从整数 (状态边框颜色值1), 状态边框已设置1)
        D2D组件工具.组件置按钮状态颜色 (D2D引擎, D2D组件, D2D按钮状态.按下, D2D颜色.从整数 (状态背景颜色值2), 状态背景已设置2, D2D颜色.从整数 (状态标题颜色值2), 状态标题已设置2, D2D颜色.从整数 (状态边框颜色值2), 状态边框已设置2)
        D2D组件工具.组件置按钮状态颜色 (D2D引擎, D2D组件, D2D按钮状态.禁用, D2D颜色.从整数 (状态背景颜色值3), 状态背景已设置3, D2D颜色.从整数 (状态标题颜色值3), 状态标题已设置3, D2D颜色.从整数 (状态边框颜色值3), 状态边框已设置3)
    }

    方法 刷新 <公开 注释 = "同步当前属性并请求按钮重画。修改多个属性后可调用本方法立即刷新显示。">
    {
        如果 (D2D已初始化 == 假)
        {
            返回
        }
        D2D同步属性 ()
        D2D引擎.请求重画 (假)
    }

    方法 D2D销毁 <公开 注释 = "内部方法：释放轻量 D2D 组件、卸载自动重画并销毁渲染资源。通常由对象清理过程自动调用。">
    {
        如果 (D2D已初始化 == 真)
        {
            D2D组件工具.销毁组件 (D2D引擎, D2D组件)
            D2D已初始化 = 假
        }
        D2D引擎.卸载自动重画 ()
        D2D引擎.销毁 ()
    }

    方法 类_清理 <注释 = "对象清理入口。组件销毁时自动释放 D2D 组件和渲染资源，用户通常不需要调用。">
    {
        D2D销毁 ()
    }

    方法 D2D取回调对象指针 <类型 = 通用指针 注释 = "内部方法：返回当前火山对象指针，供原生自动重画回调转回本对象使用。" @嵌入式方法 = "">
    {
        @ &@sn<this>
    }

    方法 D2D取绘制回调指针 <类型 = 通用指针 注释 = "内部方法：返回原生绘制回调函数指针，供自动重画系统在 WM_PAINT 等绘制时调用。" @嵌入式方法 = "">
    {
        @ reinterpret_cast<void*>(&D2D控件绘制回调)
    }

    方法 D2D取鼠标回调指针 <类型 = 通用指针 注释 = "内部方法：返回原生鼠标回调函数指针，用于把鼠标进入、移动、按下、放开等状态同步给 D2D 组件。" @嵌入式方法 = "">
    {
        @ reinterpret_cast<void*>(&D2D控件鼠标回调)
    }

    方法 D2D取键盘回调指针 <类型 = 通用指针 注释 = "内部方法：返回原生键盘/焦点回调函数指针，用于空格、回车和焦点环。" @嵌入式方法 = "">
    {
        @ reinterpret_cast<void*>(&D2D控件键盘回调)
    }

    方法 D2D绘制内部 <公开 注释 = "内部方法：由自动重画回调调用，负责同步属性、清除背景并绘制当前 D2D 轻量组件。用户通常不需要调用。">
    {
        如果 (D2D已初始化 == 假)
        {
            返回
        }
        如果 (D2D引擎.是否可用 () == 假)
        {
            返回
        }
        D2D同步属性 ()
        D2D引擎.开始绘制 ()
        D2D引擎.清除 (D2D颜色.创建 (0.94, 0.95, 0.94, 1))
        D2D组件工具.绘制组件 (D2D引擎, D2D组件)
        D2D引擎.结束绘制 ()
    }

    方法 D2D鼠标内部 <公开 注释 = "内部方法：由原生鼠标回调调用，负责更新按钮悬停、按下状态，并在有效单击时触发 被单击 事件。用户通常不需要调用。">
    参数 横坐标 <类型 = 整数 注释 = "鼠标相对按钮客户区左上角的 X 坐标，单位为实际像素。">
    参数 纵坐标 <类型 = 整数 注释 = "鼠标相对按钮客户区左上角的 Y 坐标，单位为实际像素。">
    参数 事件类型 <类型 = 整数 注释 = "鼠标事件类型，见 D2D鼠标事件类型：0 移动，1 左键按下，2 左键放开，3 离开。">
    {
        变量 已处理 <类型 = 逻辑型>
        如果 (D2D已初始化 == 假)
        {
            返回
        }
        已处理 = D2D组件工具.组件鼠标事件 (D2D引擎, D2D组件, 横坐标, 纵坐标, 事件类型)
        如果 (事件类型 == D2D鼠标事件类型.左键放开)
        {
            如果 (已处理)
            {
                已选中值 = D2D组件工具.组件取选中 (D2D引擎, D2D组件)
                被单击 ()
            }
        }
    }

    方法 D2D键盘内部 <公开 注释 = "内部方法：由原生键盘回调调用，负责焦点环、空格/回车按压状态，并在键盘激活时触发 被单击。用户通常不需要调用。">
    参数 事件类型 <类型 = 整数 注释 = "键盘或焦点事件类型，见 D2D键盘事件类型：0 键按下，1 键放开，2 获得焦点，3 失去焦点。">
    参数 键码 <类型 = 整数 注释 = "Windows 虚拟键码；焦点事件为 0。">
    {
        变量 已触发 <类型 = 逻辑型>
        如果 (D2D已初始化 == 假)
        {
            返回
        }
        如果 (事件类型 == D2D键盘事件类型.获得焦点)
        {
            已获得焦点值 = 真
        }
        如果 (事件类型 == D2D键盘事件类型.失去焦点)
        {
            已获得焦点值 = 假
        }
        已触发 = D2D组件工具.组件键盘事件 (D2D引擎, D2D组件, 事件类型, 键码)
        已选中值 = D2D组件工具.组件取选中 (D2D引擎, D2D组件)
        如果 (已触发)
        {
            被单击 ()
        }
    }
}

类 D2D按钮 <公开 基础类 = D2D窗口组件基类
        @视窗.窗口组件 = "category = \"D2D绘制组件\"\ndefault_event = \"被单击\"\ndefault_size = \"120, 38\"">
{
    方法 窗口组件_组件创建完毕 <接收事件 类型 = 整数 注释 = "内部事件接收：窗口组件创建完成后初始化按钮对应的 D2D 轻量组件。用户不需要手动调用。">
    参数 来源对象 <类型 = 窗口组件 注释 = "触发创建完毕事件的窗口组件对象。">
    参数 标记值 <类型 = 整数 注释 = "火山窗口组件创建事件传入的标记值。">
    参数 父组件 <类型 = 窗口组件 注释 = "当前按钮所属的父窗口或父组件。">
    参数 组件ID <类型 = 整数 注释 = "当前按钮窗口组件的 ID。">
    {
        D2D初始化 (D2D组件类型.按钮)
        返回 (0)
    }
}



