<火山程序 类型 = "通常" 版本 = 1 />

包 火山.D2D绘制引擎 <注释 = "D2D真实窗口组件扩展。此文件独立于核心绘制引擎，便于隔离IDE解析风险。">

类 D2D组件类型 <公开 折叠 注释 = "D2D 轻量自绘组件类型；组件附着在调用方提供的 HWND 上。">
{
    常量 面板 <公开 类型 = 整数 值 = 1>
    常量 按钮 <公开 类型 = 整数 值 = 2>
    常量 文本块 <公开 类型 = 整数 值 = 3>
    常量 进度条 <公开 类型 = 整数 值 = 4>
    常量 复选框 <公开 类型 = 整数 值 = 5>
    常量 滑块 <公开 类型 = 整数 值 = 6>
    常量 标签栏 <公开 类型 = 整数 值 = 7>
}

类 D2D按钮图标位置 <公开 折叠 注释 = "按钮图标相对标题的位置。">
{
    常量 左侧 <公开 类型 = 整数 值 = 0 注释 = "图标显示在标题左侧，标题和图标整体按 水平对齐 排版。">
    常量 右侧 <公开 类型 = 整数 值 = 1 注释 = "图标显示在标题右侧，标题和图标整体按 水平对齐 排版。">
    常量 上方 <公开 类型 = 整数 值 = 2 注释 = "图标显示在标题上方，适合较高按钮或图文纵向布局。">
    常量 下方 <公开 类型 = 整数 值 = 3 注释 = "图标显示在标题下方，适合图文纵向布局。">
}

类 D2D按钮水平对齐 <公开 折叠 注释 = "按钮内容的水平对齐方式。对只有标题、只有图标、图标加标题三种情况都生效。">
{
    常量 居中 <公开 类型 = 整数 值 = 0 注释 = "按钮内容在按钮客户区居中排列。">
    常量 左对齐 <公开 类型 = 整数 值 = 1 注释 = "按钮内容靠左排列，并保留水平边距。">
    常量 右对齐 <公开 类型 = 整数 值 = 2 注释 = "按钮内容靠右排列，并保留水平边距。">
}

类 D2D按钮垂直对齐 <公开 折叠 注释 = "按钮内容的垂直对齐方式。对只有标题、只有图标、图标加标题三种情况都生效。">
{
    常量 居中 <公开 类型 = 整数 值 = 0 注释 = "按钮内容在按钮客户区垂直居中排列。">
    常量 上对齐 <公开 类型 = 整数 值 = 1 注释 = "按钮内容靠上排列，并保留垂直边距。">
    常量 下对齐 <公开 类型 = 整数 值 = 2 注释 = "按钮内容靠下排列，并保留垂直边距。">
}

类 D2D按钮状态 <公开 折叠 注释 = "按钮视觉状态。状态颜色和状态图标均使用本枚举。未设置的状态会按按钮内置回退规则沿用其它状态。">
{
    常量 普通 <公开 类型 = 整数 值 = 0 注释 = "普通状态。其它状态未设置时最终回退到本状态或内置默认值。">
    常量 悬停 <公开 类型 = 整数 值 = 1 注释 = "鼠标悬停状态。未设置时沿用普通状态。">
    常量 按下 <公开 类型 = 整数 值 = 2 注释 = "鼠标按下状态。未设置时优先沿用悬停状态，再沿用普通状态。">
    常量 禁用 <公开 类型 = 整数 值 = 3 注释 = "按钮禁用状态。未设置时沿用普通状态或内置禁用默认值。">
}

类 D2D组件工具 <公开 折叠 注释 = "D2D 轻量组件工具。依赖 D2D绘制引擎，但 D2D绘制引擎 不反向依赖组件。"
        @视窗.外部头文件 = "native\\d2d_components.hpp"
        @视窗.外部源文件 = "native\\d2d_components.cpp">
{

    方法 创建组件容器 <公开 静态 类型 = 通用指针 注释 = "创建 D2D 组件容器。容器销毁时会连带销毁子组件。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    {
        @ volcano_d2d::CreateUiContainer()
    }

    方法 创建组件 <公开 静态 类型 = 通用指针 注释 = "创建轻量 D2D 自绘组件，类型见 D2D组件类型。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件类型 <类型 = 整数 注释 = "组件类型，见 D2D组件类型：1 面板，2 按钮，3 文本块，4 进度条，5 复选框，6 滑块，7 标签栏。">
    {
        @ volcano_d2d::CreateUiComponent(@<组件类型>)
    }

    方法 销毁组件 <公开 静态 注释 = "销毁单个组件。已加入容器并由容器托管的子组件不要单独销毁。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    {
        @ volcano_d2d::DestroyUiComponent((volcano_d2d::UiComponent*)@<组件>)
    }

    方法 组件加入 <公开 静态 注释 = "把子组件加入容器，由容器统一绘制和分发鼠标事件。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 容器 <类型 = 通用指针>
    参数 子组件 <类型 = 通用指针>
    {
        @ volcano_d2d::UiAddChild((volcano_d2d::UiContainer*)@<容器>, (volcano_d2d::UiComponent*)@<子组件>)
    }

    方法 组件清空 <公开 静态 注释 = "清空容器并销毁其中子组件。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 容器 <类型 = 通用指针>
    {
        @ volcano_d2d::UiClearChildren((volcano_d2d::UiContainer*)@<容器>)
    }

    方法 组件置矩形 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    {
        @ volcano_d2d::UiSetBounds((volcano_d2d::UiComponent*)@<组件>, volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>))
    }

    方法 组件置像素矩形 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    {
        @ volcano_d2d::UiSetPixelBounds(@<引擎>.data(), (volcano_d2d::UiComponent*)@<组件>, volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>))
    }

    方法 组件置文本 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 文本 <类型 = 文本型>
    {
        @ volcano_d2d::UiSetText((volcano_d2d::UiComponent*)@<组件>, @<文本>.GetText())
    }

    方法 组件置数值 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 数值 <类型 = 单精度小数>
    {
        @ volcano_d2d::UiSetValue((volcano_d2d::UiComponent*)@<组件>, @<数值>)
    }

    方法 组件置范围 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 最小值 <类型 = 单精度小数>
    参数 最大值 <类型 = 单精度小数>
    {
        @ volcano_d2d::UiSetRange((volcano_d2d::UiComponent*)@<组件>, @<最小值>, @<最大值>)
    }

    方法 组件置启用 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 启用 <类型 = 逻辑型>
    {
        @ volcano_d2d::UiSetEnabled((volcano_d2d::UiComponent*)@<组件>, @<启用>)
    }

    方法 组件置可见 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 可见 <类型 = 逻辑型>
    {
        @ volcano_d2d::UiSetVisible((volcano_d2d::UiComponent*)@<组件>, @<可见>)
    }

    方法 组件置选中 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 选中 <类型 = 逻辑型>
    {
        @ volcano_d2d::UiSetChecked((volcano_d2d::UiComponent*)@<组件>, @<选中>)
    }

    方法 组件置按钮外观 <公开 静态 注释 = "设置按钮圆角和边框宽度。尺寸参数单位为 DIP，底层绘制时会按当前 DPI 换算到实际像素。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 圆角 <类型 = 单精度小数 注释 = "按钮圆角半径，单位 DIP；0 表示直角。">
    参数 边框宽度 <类型 = 单精度小数 注释 = "按钮边框宽度，单位 DIP；0 表示不绘制边框。">
    {
        @ volcano_d2d::UiSetButtonMetrics((volcano_d2d::UiComponent*)@<组件>, @<圆角>, @<边框宽度>)
    }

    方法 组件置按钮字体 <公开 静态 注释 = "直接设置按钮标题字体名称、字号和粗细。通常优先使用 组件置按钮字体描述 来响应火山视窗字体描述文本。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 字体名称 <类型 = 文本型 注释 = "字体家族名称，如 宋体、Arial。">
    参数 字号 <类型 = 单精度小数 注释 = "字体尺寸，单位为磅。">
    参数 字体粗细 <类型 = 整数 注释 = "DirectWrite 字体粗细值，常用值见 D2D字体粗细。">
    {
        @ volcano_d2d::UiSetButtonFont((volcano_d2d::UiComponent*)@<组件>, @<字体名称>.GetText(), @<字号>, @<字体粗细>)
    }

    方法 组件置按钮字体描述 <公开 静态 注释 = "按火山视窗字体描述文本设置按钮标题字体。格式为：字体名, 字体尺寸, 是否粗体, 是否斜体, 是否下划线, 是否删除线, 旋转角度。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 字体描述 <类型 = 文本型 注释 = "字体描述文本，如 \"宋体, 10\" 或 \"宋体, 10, 0, 1, 1, 0, 100\"。">
    {
        @ volcano_d2d::UiSetButtonFontDescriptor((volcano_d2d::UiComponent*)@<组件>, @<字体描述>.GetText())
    }

    方法 组件置按钮配色 <公开 静态 注释 = "设置按钮普通、悬停、按下、禁用等状态的背景和文字颜色。用于按钮组件的 置配色 方法。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 普通颜色 <类型 = D2D颜色 注释 = "按钮普通状态背景色。">
    参数 悬停颜色 <类型 = D2D颜色 注释 = "鼠标悬停在按钮上时的背景色。">
    参数 按下颜色 <类型 = D2D颜色 注释 = "鼠标按下按钮时的背景色。">
    参数 禁用颜色 <类型 = D2D颜色 注释 = "按钮被禁止时的背景色。">
    参数 文字颜色 <类型 = D2D颜色 注释 = "按钮可用状态标题颜色。">
    参数 禁用文字颜色 <类型 = D2D颜色 注释 = "按钮被禁止时标题颜色。">
    参数 边框颜色 <类型 = D2D颜色 注释 = "按钮边框颜色。边框宽度为 0 时不会显示。">
    {
        @ volcano_d2d::UiSetButtonColors((volcano_d2d::UiComponent*)@<组件>, @<普通颜色>, @<悬停颜色>, @<按下颜色>, @<禁用颜色>, @<文字颜色>, @<禁用文字颜色>, @<边框颜色>)
    }

    方法 组件置按钮状态颜色 <公开 静态 注释 = "设置按钮某个状态的背景、标题和边框颜色。每类颜色都可独立决定是否覆盖；未覆盖的状态按 D2D按钮状态 回退规则沿用其它状态或内置默认值。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 状态 <类型 = 整数 注释 = "D2D按钮状态，见 D2D按钮状态：0 普通，1 悬停，2 按下，3 禁用。">
    参数 背景颜色 <类型 = D2D颜色 注释 = "此状态背景色。">
    参数 设置背景 <类型 = 逻辑型 注释 = "真表示覆盖此状态背景色，假表示此状态背景沿用回退规则。">
    参数 标题颜色 <类型 = D2D颜色 注释 = "此状态标题文字颜色。">
    参数 设置标题 <类型 = 逻辑型 注释 = "真表示覆盖此状态标题颜色，假表示此状态标题颜色沿用回退规则。">
    参数 边框颜色 <类型 = D2D颜色 注释 = "此状态边框颜色。">
    参数 设置边框 <类型 = 逻辑型 注释 = "真表示覆盖此状态边框颜色，假表示此状态边框颜色沿用回退规则。">
    {
        @ volcano_d2d::UiSetButtonStateColors((volcano_d2d::UiComponent*)@<组件>, @<状态>, @<背景颜色>, @<设置背景>, @<标题颜色>, @<设置标题>, @<边框颜色>, @<设置边框>)
    }

    方法 组件置按钮布局 <公开 静态 注释 = "设置按钮标题和图标的排版参数。尺寸参数单位为 DIP，底层绘制时会按当前 DPI 换算到实际像素。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 水平边距 <类型 = 单精度小数 注释 = "内容区左右内边距，单位 DIP。">
    参数 垂直边距 <类型 = 单精度小数 注释 = "内容区上下内边距，单位 DIP。">
    参数 图标间距 <类型 = 单精度小数 注释 = "图标与标题之间的间距，单位 DIP。">
    参数 图标位置 <类型 = 整数 注释 = "图标相对标题的位置，见 D2D按钮图标位置：0 左侧，1 右侧，2 上方，3 下方。">
    参数 水平对齐 <类型 = 整数 注释 = "按钮内容水平对齐方式，见 D2D按钮水平对齐：0 居中，1 左对齐，2 右对齐。对只有标题、只有图标、图标加标题三种情况都生效。">
    参数 自动换行 <类型 = 逻辑型 注释 = "标题超出可用宽度时是否允许自动换行。默认为假。">
    {
        @ volcano_d2d::UiSetButtonLayout((volcano_d2d::UiComponent*)@<组件>, @<水平边距>, @<垂直边距>, @<图标间距>, @<图标位置>, @<水平对齐>, @<自动换行>)
    }

    方法 组件置按钮选项 <公开 静态 注释 = "设置按钮预设样式、可切换状态、焦点环和默认按钮外观。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 外观样式 <类型 = 整数 注释 = "按钮预设外观：0 主按钮，1 次按钮，2 描边按钮，3 幽灵按钮，4 危险按钮。">
    参数 可切换 <类型 = 逻辑型 注释 = "真表示单击或键盘激活后自动切换选中状态。">
    参数 获得焦点 <类型 = 逻辑型 注释 = "当前是否绘制焦点环。">
    参数 默认按钮 <类型 = 逻辑型 注释 = "真表示绘制默认按钮强调外观。">
    参数 焦点颜色 <类型 = D2D颜色 注释 = "焦点环颜色。">
    参数 焦点线宽 <类型 = 单精度小数 注释 = "焦点环线宽，单位 DIP；0 表示不绘制焦点环。">
    {
        @ volcano_d2d::UiSetButtonOptions((volcano_d2d::UiComponent*)@<组件>, @<外观样式>, @<可切换>, @<获得焦点>, @<默认按钮>, @<焦点颜色>, @<焦点线宽>)
    }

    方法 组件置按钮效果 <公开 静态 注释 = "设置按钮细节效果：按下内容位移、投影、渐变高光和垂直对齐。尺寸参数单位为 DIP。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 按下偏移 <类型 = 单精度小数 注释 = "按下时标题和图标的位移，单位 DIP；0 表示不位移。">
    参数 阴影偏移X <类型 = 单精度小数 注释 = "按钮投影横向偏移，单位 DIP；与 阴影偏移Y 同为 0 时不绘制投影。">
    参数 阴影偏移Y <类型 = 单精度小数 注释 = "按钮投影纵向偏移，单位 DIP。">
    参数 阴影透明度 <类型 = 单精度小数 注释 = "投影透明度，范围 0 到 1；0 表示不绘制投影。">
    参数 渐变高光 <类型 = 逻辑型 注释 = "真表示背景使用轻微纵向渐变，使按钮更有质感。">
    参数 垂直对齐 <类型 = 整数 注释 = "D2D按钮垂直对齐方式，见 D2D按钮垂直对齐：0 居中，1 上对齐，2 下对齐。">
    {
        @ volcano_d2d::UiSetButtonEffects((volcano_d2d::UiComponent*)@<组件>, @<按下偏移>, @<阴影偏移X>, @<阴影偏移Y>, @<阴影透明度>, @<渐变高光>, @<垂直对齐>)
    }

    方法 组件置按钮图标 <公开 静态 注释 = "从外部文件路径设置按钮图标。保留给底层测试使用；正式按钮属性建议使用 视窗文件资源 类型的 图标文件，并通过 组件置按钮图标数据 载入。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 图标文件 <类型 = 文本型 注释 = "SVG/PNG/JPG 等图标文件路径。为空时清除图标。">
    参数 图标大小 <类型 = 单精度小数 注释 = "图标边长，单位 DIP；为 0 时按标题显示高度自适应。">
    参数 图标颜色 <类型 = D2D颜色 注释 = "启用 使用图标颜色 时用于替换 SVG path 颜色。">
    参数 使用图标颜色 <类型 = 逻辑型 注释 = "是否用 图标颜色 统一给 SVG path 着色。位图图标不受此项影响。">
    {
        @ volcano_d2d::UiSetButtonIcon((volcano_d2d::UiComponent*)@<组件>, @<图标文件>.GetText(), @<图标大小>, @<图标颜色>, @<使用图标颜色>)
    }

    方法 组件置按钮图标数据 <公开 静态 注释 = "从字节集设置按钮图标数据。支持 WIC 可解码位图数据和常见 SVG path 文本数据；用于配合 视窗文件资源 + 文件资源到字节集，避免运行时依赖外部文件。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 图标数据 <类型 = 字节集类 注释 = "图标文件资源读出的完整字节数据。为空时清除图标。">
    参数 图标大小 <类型 = 单精度小数 注释 = "图标边长，单位 DIP；为 0 时按标题显示高度自适应。">
    参数 图标颜色 <类型 = D2D颜色 注释 = "启用 使用图标颜色 时用于替换 SVG path 颜色。">
    参数 使用图标颜色 <类型 = 逻辑型 注释 = "是否用 图标颜色 统一给 SVG path 着色。位图图标不受此项影响。">
    {
        @ { auto& __iconData = @<图标数据>;
        @ volcano_d2d::UiSetButtonIconData((volcano_d2d::UiComponent*)@<组件>, __iconData.GetPtr(), (int)__iconData.GetSize(), @<图标大小>, @<图标颜色>, @<使用图标颜色>); }
    }

    方法 组件置按钮状态图标数据 <公开 静态 注释 = "设置按钮某个状态的图标字节数据。未设置的状态会按回退规则沿用其它状态图标；运行时动态换图标时应覆盖对应状态的字节集。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针 注释 = "由 创建组件 返回的按钮组件指针。">
    参数 状态 <类型 = 整数 注释 = "D2D按钮状态，见 D2D按钮状态：0 普通，1 悬停，2 按下，3 禁用。">
    参数 图标数据 <类型 = 字节集类 注释 = "SVG/PNG/JPG 等图标文件的完整字节数据。为空表示此状态不单独设置图标。">
    参数 图标大小 <类型 = 单精度小数 注释 = "图标边长，单位 DIP；为 0 时按标题显示高度自适应。">
    参数 图标颜色 <类型 = D2D颜色 注释 = "启用 使用图标颜色 时用于替换 SVG path 颜色。">
    参数 使用图标颜色 <类型 = 逻辑型 注释 = "是否用 图标颜色 统一给 SVG path 着色。位图图标不受此项影响。">
    {
        @ { auto& __iconData = @<图标数据>;
        @ volcano_d2d::UiSetButtonStateIconData((volcano_d2d::UiComponent*)@<组件>, @<状态>, __iconData.GetPtr(), (int)__iconData.GetSize(), @<图标大小>, @<图标颜色>, @<使用图标颜色>); }
    }

    方法 组件取选中 <公开 静态 类型 = 逻辑型 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    {
        @ volcano_d2d::UiChecked((volcano_d2d::UiComponent*)@<组件>)
    }

    方法 组件取数值 <公开 静态 类型 = 单精度小数 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    {
        @ volcano_d2d::UiValue((volcano_d2d::UiComponent*)@<组件>)
    }

    方法 绘制组件 <公开 静态 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    {
        @ volcano_d2d::UiDraw(@<引擎>.data(), (volcano_d2d::UiComponent*)@<组件>)
    }

    方法 组件鼠标事件 <公开 静态 类型 = 逻辑型 @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    参数 事件类型 <类型 = 整数 注释 = "鼠标事件类型，见 D2D鼠标事件类型：0 移动，1 左键按下，2 左键放开，3 离开。">
    {
        @ volcano_d2d::UiMouseEvent(@<引擎>.data(), (volcano_d2d::UiComponent*)@<组件>, @<横坐标>, @<纵坐标>, @<事件类型>)
    }

    方法 组件键盘事件 <公开 静态 类型 = 逻辑型 注释 = "向轻量组件转发键盘或焦点事件；当空格/回车完成按钮激活时返回真。" @嵌入式方法 = "">
    参数 引擎 <类型 = D2D绘制引擎>
    参数 组件 <类型 = 通用指针>
    参数 事件类型 <类型 = 整数 注释 = "键盘事件类型：0 键按下，1 键放开，2 获得焦点，3 失去焦点。">
    参数 键码 <类型 = 整数 注释 = "Windows 虚拟键码；焦点事件传 0。">
    {
        @ volcano_d2d::UiKeyEvent(@<引擎>.data(), (volcano_d2d::UiComponent*)@<组件>, @<事件类型>, @<键码>)
    }
}


类 D2D按钮外观样式 <公开 折叠 注释 = "按钮预设外观样式。状态颜色仍可通过各状态颜色属性覆盖。">
{
    常量 主按钮 <公开 类型 = 整数 值 = 0 注释 = "实心主按钮，使用默认强调色或自定义状态色。">
    常量 次按钮 <公开 类型 = 整数 值 = 1 注释 = "浅底按钮，标题和边框使用强调色。">
    常量 描边按钮 <公开 类型 = 整数 值 = 2 注释 = "透明背景加描边，悬停和按下时显示轻微底色。">
    常量 幽灵按钮 <公开 类型 = 整数 值 = 3 注释 = "无边框透明按钮，适合工具栏或低强调操作。">
    常量 危险按钮 <公开 类型 = 整数 值 = 4 注释 = "红色危险操作按钮。若设置了普通背景颜色，则按自定义状态色优先。">
}

类 D2D键盘事件类型 <公开 折叠 注释 = "D2D 组件窗口转发的键盘和焦点事件。">
{
    常量 键按下 <公开 类型 = 整数 值 = 0 注释 = "按键被按下。">
    常量 键放开 <公开 类型 = 整数 值 = 1 注释 = "按键被放开。">
    常量 获得焦点 <公开 类型 = 整数 值 = 2 注释 = "宿主窗口组件获得输入焦点。">
    常量 失去焦点 <公开 类型 = 整数 值 = 3 注释 = "宿主窗口组件失去输入焦点。">
}

类 D2D窗口组件基类 <公开 基础类 = 窗口组件 注释 = "真实火山/MFC窗口组件上的D2D自绘基类，先用于叶子控件。"
        @视窗.外部源文件 = "native\\d2d_volcano_leaf_control.cpp">
{

    # @begin
    # <> <include>
    # void @an<_OnInitExtra> ();
    # virtual BOOL CreateMfcControl (CVolNativeWndCreateParam* pCreateParam) override;
    # <> </include>
    # @end
    # @ static void D2D控件绘制回调(void* self)
    # @ {
    # @     reinterpret_cast<@sn<current_class>*>(self)->@<D2D绘制内部>();
    # @ }
    # @ static void D2D控件鼠标回调(void* self, int x, int y, int type)
    # @ {
    # @     reinterpret_cast<@sn<current_class>*>(self)->@<D2D鼠标内部>(x, y, type);
    # @ }
    # @ static void D2D控件键盘回调(void* self, int type, int key)
    # @ {
    # @     reinterpret_cast<@sn<current_class>*>(self)->@<D2D键盘内部>(type, key);
    # @ }

    变量 D2D引擎 <类型 = D2D绘制引擎>
    变量 D2D组件 <类型 = 通用指针>
    变量 D2D组件类型值 <类型 = 整数 值 = 2>
    变量 D2D已初始化 <类型 = 逻辑型 值 = 假>
    变量 圆角值 <类型 = 单精度小数 值 = 8>
    变量 边框宽度值 <类型 = 单精度小数 值 = 0>
