    {
        @ ([&]() -> ID2D1Bitmap* { auto& __data = @<图片数据>; ID2D1Bitmap* __bitmap = nullptr; @sn<this>.data().LoadBitmapFromMemory(__data.GetPtr(), (int)__data.GetSize(), &__bitmap); return __bitmap; }())
    }

