    参数 插值模式 <类型 = 整数 @默认值 = D2D位图插值模式.线性>
    {
        @ @sn<this>.data().DrawBitmap((ID2D1Bitmap*)@<位图>, volcano_d2d::MakeRect(@<目标左>, @<目标顶>, @<目标右>, @<目标底>), @<不透明度>, @<插值模式>, volcano_d2d::MakeRect(@<源左>, @<源顶>, @<源右>, @<源底>))
    }

    方法 创建位图画刷 <公开 类型 = 通用指针 注释 = "从位图创建 ID2D1BitmapBrush*，可用于填充任意图形。" @嵌入式方法 = "">
    参数 位图 <类型 = 通用指针>
    参数 横向延展 <类型 = 整数 @默认值 = D2D延展模式.平铺>
    参数 纵向延展 <类型 = 整数 @默认值 = D2D延展模式.平铺>
    参数 插值模式 <类型 = 整数 @默认值 = D2D位图插值模式.线性>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ volcano_d2d::CreateBitmapBrushPtr(@sn<this>.data(), (ID2D1Bitmap*)@<位图>, @<横向延展>, @<纵向延展>, @<插值模式>, @<不透明度>)
    }

    方法 取位图宽度 <公开 类型 = 整数 @嵌入式方法 = "">
    参数 位图 <类型 = 通用指针>
    {
        @ @sn<this>.data().BitmapWidth((ID2D1Bitmap*)@<位图>)
    }

    方法 取位图高度 <公开 类型 = 整数 @嵌入式方法 = "">
    参数 位图 <类型 = 通用指针>
    {
        @ @sn<this>.data().BitmapHeight((ID2D1Bitmap*)@<位图>)
    }

    方法 创建文本格式 <公开 类型 = 通用指针 注释 = "返回 IDWriteTextFormat*。" @嵌入式方法 = "">
    参数 字体名 <类型 = 文本型 @默认值 = "微软雅黑">
    参数 字号 <类型 = 单精度小数 @默认值 = 16.0>
    参数 粗细 <类型 = 整数 @默认值 = D2D字体粗细.常规>
    参数 样式 <类型 = 整数 @默认值 = D2D字体样式.正常>
    参数 拉伸 <类型 = 整数 @默认值 = 5>
    参数 区域 <类型 = 文本型 @默认值 = "zh-cn">
    {
        @ volcano_d2d::CreateTextFormatPtr(@sn<this>.data(), (const wchar_t*)@<字体名>.GetText(), @<字号>, @<粗细>, @<样式>, @<拉伸>, (const wchar_t*)@<区域>.GetText())
    }

    方法 文本格式置对齐 <公开 @嵌入式方法 = "">
    参数 文本格式 <类型 = 通用指针>
    参数 对齐 <类型 = 整数>
    {
        @ @sn<this>.data().SetTextAlignment((IDWriteTextFormat*)@<文本格式>, @<对齐>)
    }

    方法 文本格式置段落对齐 <公开 @嵌入式方法 = "">
    参数 文本格式 <类型 = 通用指针>
    参数 对齐 <类型 = 整数>
    {
        @ @sn<this>.data().SetParagraphAlignment((IDWriteTextFormat*)@<文本格式>, @<对齐>)
    }

    方法 文本格式置换行 <公开 @嵌入式方法 = "">
    参数 文本格式 <类型 = 通用指针>
    参数 换行模式 <类型 = 整数>
    {
        @ @sn<this>.data().SetWordWrapping((IDWriteTextFormat*)@<文本格式>, @<换行模式>)
    }

    方法 创建文本布局 <公开 类型 = 通用指针 注释 = "返回 IDWriteTextLayout*，用于复杂文本排版后绘制。" @嵌入式方法 = "">
    参数 文本 <类型 = 文本型>
    参数 文本格式 <类型 = 通用指针>
    参数 最大宽度 <类型 = 单精度小数>
    参数 最大高度 <类型 = 单精度小数>
    {
        @ volcano_d2d::CreateTextLayoutPtr(@sn<this>.data(), (const wchar_t*)@<文本>.GetText(), (IDWriteTextFormat*)@<文本格式>, @<最大宽度>, @<最大高度>)
    }

    方法 取文本布局度量 <公开 类型 = D2D文本度量 注释 = "返回 IDWriteTextLayout 的宽高、行数等度量。" @嵌入式方法 = "">
    参数 文本布局 <类型 = 通用指针>
    {
        @ volcano_d2d::TextLayoutMetricsValue(@sn<this>.data(), (IDWriteTextLayout*)@<文本布局>)
    }

    方法 文本布局点取字符位置 <公开 类型 = 整数 注释 = "对 IDWriteTextLayout 做命中测试，返回坐标处字符位置；失败返回 -1。" @嵌入式方法 = "">
    参数 文本布局 <类型 = 通用指针>
    参数 横坐标 <类型 = 单精度小数>
    参数 纵坐标 <类型 = 单精度小数>
    {
        @ volcano_d2d::TextLayoutHitTextPosition(@sn<this>.data(), (IDWriteTextLayout*)@<文本布局>, @<横坐标>, @<纵坐标>)
    }

    方法 画刷绘制文本布局 <公开 @嵌入式方法 = "">
    参数 文本布局 <类型 = 通用指针>
    参数 画刷 <类型 = 通用指针>
    参数 横坐标 <类型 = 单精度小数>
    参数 纵坐标 <类型 = 单精度小数>
    参数 选项 <类型 = 整数 @默认值 = D2D绘制文本选项.无>
    {
        @ @sn<this>.data().DrawTextLayout(volcano_d2d::MakePoint(@<横坐标>, @<纵坐标>), (IDWriteTextLayout*)@<文本布局>, (ID2D1Brush*)@<画刷>, @<选项>)
    }

    方法 绘制文本 <公开 @嵌入式方法 = "">
    参数 文本 <类型 = 文本型>
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    参数 字体名 <类型 = 文本型 @默认值 = "微软雅黑">
    参数 字号 <类型 = 单精度小数 @默认值 = 16.0>
    参数 粗细 <类型 = 整数 @默认值 = D2D字体粗细.常规>
    参数 样式 <类型 = 整数 @默认值 = D2D字体样式.正常>
    参数 水平对齐 <类型 = 整数 @默认值 = D2D文本对齐.左>
    参数 垂直对齐 <类型 = 整数 @默认值 = D2D段落对齐.顶部>
    {
        @ @sn<this>.data().DrawTextSimple((const wchar_t*)@<文本>.GetText(), volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<颜色>, (const wchar_t*)@<字体名>.GetText(), @<字号>, @<粗细>, @<样式>, @<水平对齐>, @<垂直对齐>)
    }

    方法 绘制装饰文本 <公开 注释 = "绘制带下划线、删除线、旋转和可选换行的文本。" @嵌入式方法 = "">
    参数 文本 <类型 = 文本型>
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    参数 字体名 <类型 = 文本型 @默认值 = "微软雅黑">
    参数 字号 <类型 = 单精度小数 @默认值 = 16.0>
    参数 粗细 <类型 = 整数 @默认值 = D2D字体粗细.常规>
    参数 样式 <类型 = 整数 @默认值 = D2D字体样式.正常>
    参数 下划线 <类型 = 逻辑型 @默认值 = 假>
    参数 删除线 <类型 = 逻辑型 @默认值 = 假>
    参数 旋转角度 <类型 = 单精度小数 注释 = "旋转角度，单位度；默认值：0。" @默认值 = 0.0>
    参数 水平对齐 <类型 = 整数 注释 = "0.左，1.右，2.居中，3.两端；默认值：0。" @默认值 = D2D文本对齐.左>
    参数 垂直对齐 <类型 = 整数 注释 = "0.顶部，1.底部，2.居中；默认值：0。" @默认值 = D2D段落对齐.顶部>
    参数 自动换行 <类型 = 逻辑型 @默认值 = 真>
    {
        @ @sn<this>.data().DrawTextDecorated((const wchar_t*)@<文本>.GetText(), volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<颜色>, (const wchar_t*)@<字体名>.GetText(), @<字号>, @<粗细>, @<样式>, @<下划线>, @<删除线>, @<旋转角度>, @<水平对齐>, @<垂直对齐>, @<自动换行>)
    }

    方法 创建图层 <公开 类型 = 通用指针 注释 = "返回 ID2D1Layer*。" @嵌入式方法 = "">
    {
        @ volcano_d2d::CreateLayerPtr(@sn<this>.data())
    }

    方法 压入图层 <公开 @嵌入式方法 = "">
    参数 图层 <类型 = 通用指针>
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ @sn<this>.data().PushLayer(volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), (ID2D1Layer*)@<图层>, @<不透明度>)
    }

    方法 弹出图层 <公开 @嵌入式方法 = "">
    {
        @ @sn<this>.data().PopLayer()
    }

    方法 压入裁剪 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 抗锯齿模式 <类型 = 整数 @默认值 = D2D抗锯齿模式.单个图元>
    {
        @ @sn<this>.data().PushAxisAlignedClip(volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<抗锯齿模式>)
    }

    方法 弹出裁剪 <公开 @嵌入式方法 = "">
    {
        @ @sn<this>.data().PopAxisAlignedClip()
    }

    方法 创建绘制状态 <公开 类型 = 通用指针 注释 = "返回 ID2D1DrawingStateBlock*。" @嵌入式方法 = "">
    {
        @ volcano_d2d::CreateDrawingStateBlockPtr(@sn<this>.data())
    }

    方法 保存绘制状态 <公开 @嵌入式方法 = "">
    参数 状态 <类型 = 通用指针>
    {
        @ @sn<this>.data().SaveDrawingState((ID2D1DrawingStateBlock*)@<状态>)
    }

    方法 恢复绘制状态 <公开 @嵌入式方法 = "">
    参数 状态 <类型 = 通用指针>
    {
        @ @sn<this>.data().RestoreDrawingState((ID2D1DrawingStateBlock*)@<状态>)
    }

    方法 取错误码 <公开 类型 = 整数 @嵌入式方法 = "">
    {
        @ (int)@sn<this>.data().LastResult()
    }

    方法 取错误文本 <公开 类型 = 文本型 @嵌入式方法 = "">
    {
        @ @an<CVolString>(@sn<this>.data().LastErrorText().c_str())
    }

