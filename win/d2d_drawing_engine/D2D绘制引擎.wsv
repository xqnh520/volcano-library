    {
        @ @sn<this>.data().DrawBitmap((ID2D1Bitmap*)@<位图>, volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<不透明度>, @<插值模式>, volcano_d2d::MakeRect(0, 0, 0, 0))
