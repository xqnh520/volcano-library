类 D2D矩阵 <公开 注释 = "D2D1_MATRIX_3X2_F。" 折叠 @别名 = "volcano_d2d::Matrix" @别名类型 = 本地值类型>
{
    变量 M11 <公开 类型 = 单精度小数 @输出名 = "m11">
    变量 M12 <公开 类型 = 单精度小数 @输出名 = "m12">
    变量 M21 <公开 类型 = 单精度小数 @输出名 = "m21">
    变量 M22 <公开 类型 = 单精度小数 @输出名 = "m22">
    变量 DX <公开 类型 = 单精度小数 @输出名 = "dx">
    变量 DY <公开 类型 = 单精度小数 @输出名 = "dy">

    方法 单位矩阵 <公开 静态 类型 = D2D矩阵 @嵌入式方法 = "">
    {
        @ volcano_d2d::MakeIdentityMatrix()
    }

    方法 平移 <公开 静态 类型 = D2D矩阵 @嵌入式方法 = "">
    参数 横向 <类型 = 单精度小数>
    参数 纵向 <类型 = 单精度小数>
    {
        @ volcano_d2d::MakeTranslationMatrix(@<横向>, @<纵向>)
    }

    方法 缩放 <公开 静态 类型 = D2D矩阵 @嵌入式方法 = "">
    参数 横向比例 <类型 = 单精度小数>
    参数 纵向比例 <类型 = 单精度小数>
    参数 中心X <类型 = 单精度小数 @默认值 = 0.0>
    参数 中心Y <类型 = 单精度小数 @默认值 = 0.0>
    {
        @ volcano_d2d::MakeScaleMatrix(@<横向比例>, @<纵向比例>, @<中心X>, @<中心Y>)
    }

    方法 旋转 <公开 静态 类型 = D2D矩阵 @嵌入式方法 = "">
    参数 角度 <类型 = 单精度小数 注释 = "旋转角度，单位度。">
    参数 中心X <类型 = 单精度小数 @默认值 = 0.0>
    参数 中心Y <类型 = 单精度小数 @默认值 = 0.0>
    {
        @ volcano_d2d::MakeRotationMatrix(@<角度>, @<中心X>, @<中心Y>)
    }

    方法 斜切 <公开 静态 类型 = D2D矩阵 @嵌入式方法 = "">
    参数 横向角度 <类型 = 单精度小数>
    参数 纵向角度 <类型 = 单精度小数>
    参数 中心X <类型 = 单精度小数 @默认值 = 0.0>
    参数 中心Y <类型 = 单精度小数 @默认值 = 0.0>
    {
        @ volcano_d2d::MakeSkewMatrix(@<横向角度>, @<纵向角度>, @<中心X>, @<中心Y>)
    }

    方法 相乘 <公开 静态 类型 = D2D矩阵 @嵌入式方法 = "">
    参数 前矩阵 <类型 = D2D矩阵>
    参数 后矩阵 <类型 = D2D矩阵>
    {
        @ volcano_d2d::MultiplyMatrix(@<前矩阵>, @<后矩阵>)
    }
}

