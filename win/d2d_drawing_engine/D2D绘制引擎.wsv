    {
        @ @sn<this>.data().WriteFactory()
    }

    方法 取WIC工厂指针 <公开 类型 = 通用指针 @嵌入式方法 = "">
    {
        @ @sn<this>.data().WicFactory()
    }

    方法 取渲染目标指针 <公开 类型 = 通用指针 @嵌入式方法 = "">
    {
        @ @sn<this>.data().Target()
    }
