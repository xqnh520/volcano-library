类 D2D渲染选项 <公开 注释 = "创建窗口渲染目标时使用的完整选项。" 折叠 @别名 = "volcano_d2d::RenderOptions" @别名类型 = 本地值类型>
{
    变量 工厂类型 <公开 类型 = 整数 @输出名 = "factoryType">
    变量 调试级别 <公开 类型 = 整数 @输出名 = "debugLevel">
    变量 渲染目标类型 <公开 类型 = 整数 @输出名 = "renderTargetType">
    变量 特性级别 <公开 类型 = 整数 @输出名 = "featureLevel">
    变量 呈现选项 <公开 类型 = 整数 @输出名 = "presentOptions">
    变量 透明模式 <公开 类型 = 整数 @输出名 = "alphaMode">
    变量 像素格式 <公开 类型 = 整数 @输出名 = "pixelFormat">
    变量 DPI横向 <公开 类型 = 单精度小数 @输出名 = "dpiX">
    变量 DPI纵向 <公开 类型 = 单精度小数 @输出名 = "dpiY">
    变量 GDI兼容 <公开 类型 = 逻辑型 @输出名 = "gdiCompatible">

    方法 默认选项 <公开 静态 类型 = D2D渲染选项 @嵌入式方法 = "">
    {
        @ volcano_d2d::RenderOptions()
    }
}

类 D2D绘制引擎 <公开
        注释 = "窗口级 Direct2D 绘制引擎；依赖 Windows 桌面 HWND、Direct2D、DirectWrite、WIC 和 Windows SDK，要求 C++17 编译。编译缺头文件/库时安装 Windows SDK；老 Windows 7/Server 2008 R2 缺图形组件时安装 Platform Update。此类不依赖上层控件封装，可单独用于原生窗口绘制。">
{

    #
    # @ @m<DECLARE_REF_OBJECT_CLASS_WITH_DATA> (volcano_d2d::Engine)

    方法 创建到窗口 <公开 类型 = 逻辑型 注释 = "用默认选项创建 HWND 渲染目标。宽高为 0 时自动取客户区尺寸。" @嵌入式方法 = "">
    参数 窗口句柄 <类型 = 变整数>
    参数 宽度 <类型 = 整数 @默认值 = 0>
    参数 高度 <类型 = 整数 @默认值 = 0>
    {
        @ volcano_d2d::RenderOptions options; SUCCEEDED(@sn<this>.data().CreateForHwnd((HWND)@<窗口句柄>, @<宽度>, @<高度>, options))
    }

    方法 创建到窗口Ex <公开 类型 = 逻辑型 注释 = "用完整选项创建 HWND 渲染目标。宽高为 0 时自动取客户区尺寸。" @嵌入式方法 = "">
    参数 窗口句柄 <类型 = 变整数>
    参数 宽度 <类型 = 整数 @默认值 = 0>
    参数 高度 <类型 = 整数 @默认值 = 0>
    参数 选项 <类型 = D2D渲染选项>
    {
        @ SUCCEEDED(@sn<this>.data().CreateForHwnd((HWND)@<窗口句柄>, @<宽度>, @<高度>, @<选项>))
    }

    方法 销毁 <公开 注释 = "释放渲染目标、工厂与所有内部临时资源。" @嵌入式方法 = "">
    {
        @ @sn<this>.data().Destroy()
    }

    方法 是否可用 <公开 类型 = 逻辑型 @嵌入式方法 = "">
    {
        @ @sn<this>.data().IsReady()
    }

    方法 窗口是否启用 <公开 类型 = 逻辑型 @嵌入式方法 = "">
    参数 窗口句柄 <类型 = 变整数>
    {
        @ ::IsWindowEnabled((HWND)@<窗口句柄>) != FALSE
    }

    方法 窗口是否可视 <公开 类型 = 逻辑型 @嵌入式方法 = "">
    参数 窗口句柄 <类型 = 变整数>
    {
        @ ::IsWindowVisible((HWND)@<窗口句柄>) != FALSE
    }

    方法 调整尺寸 <公开 类型 = 逻辑型 注释 = "窗口大小变化时调用。宽高为 0 时自动取客户区。" @嵌入式方法 = "">
    参数 宽度 <类型 = 整数 @默认值 = 0>
    参数 高度 <类型 = 整数 @默认值 = 0>
    {
        @ SUCCEEDED(@sn<this>.data().Resize(@<宽度>, @<高度>))
    }

    方法 请求重画 <公开 注释 = "通知当前绑定的窗口句柄需要重画。建议在宿主绘画事件中实际执行绘制。" @嵌入式方法 = "">
    参数 擦除背景 <类型 = 逻辑型 @默认值 = 假>
    {
        @ @sn<this>.data().Invalidate(@<擦除背景>)
    }

    方法 立即重画 <公开 注释 = "立即更新当前绑定的窗口句柄。通常在请求重画之后调用。" @嵌入式方法 = "">
    {
        @ @sn<this>.data().UpdateNow()
    }

    方法 安装自动重画 <公开 类型 = 逻辑型 注释 = "挂接当前绑定 HWND 的 WM_PAINT/WM_SIZE，在重画时回调指定绘制函数。绘制回调原型: void (*)(void*)。" @嵌入式方法 = "">
    参数 回调对象 <类型 = 通用指针>
    参数 绘制回调 <类型 = 通用指针>
    {
        @ @sn<this>.data().InstallAutoRepaint(@<回调对象>, reinterpret_cast<volcano_d2d::PaintCallback>(@<绘制回调>))
    }

    方法 安装自动重画Ex <公开 类型 = 逻辑型 注释 = "安装自动重画并接收鼠标回调。鼠标回调原型: void (*)(void*, int x, int y, int type)。" @嵌入式方法 = "">
    参数 回调对象 <类型 = 通用指针>
    参数 绘制回调 <类型 = 通用指针>
    参数 鼠标回调 <类型 = 通用指针>
    {
        @ @sn<this>.data().InstallAutoRepaint(@<回调对象>, reinterpret_cast<volcano_d2d::PaintCallback>(@<绘制回调>), nullptr, reinterpret_cast<volcano_d2d::MouseCallback>(@<鼠标回调>))
    }

    方法 安装自动重画Ex2 <公开 类型 = 逻辑型 注释 = "安装自动重画并接收鼠标、键盘和焦点回调。键盘回调原型: void (*)(void*, int type, int key)。" @嵌入式方法 = "">
    参数 回调对象 <类型 = 通用指针>
    参数 绘制回调 <类型 = 通用指针>
    参数 鼠标回调 <类型 = 通用指针>
    参数 键盘回调 <类型 = 通用指针>
    {
        @ @sn<this>.data().InstallAutoRepaint(@<回调对象>, reinterpret_cast<volcano_d2d::PaintCallback>(@<绘制回调>), nullptr, reinterpret_cast<volcano_d2d::MouseCallback>(@<鼠标回调>), reinterpret_cast<volcano_d2d::KeyCallback>(@<键盘回调>))
    }

    方法 卸载自动重画 <公开 注释 = "恢复当前绑定 HWND 原窗口过程。" @嵌入式方法 = "">
    {
        @ @sn<this>.data().UninstallAutoRepaint()
    }

    方法 开始绘制 <公开 @嵌入式方法 = "">
    {
        @ @sn<this>.data().BeginDraw()
    }

    方法 结束绘制 <公开 类型 = 逻辑型 注释 = "返回假且错误码为 D2DERR_RECREATE_TARGET 时，应销毁并重新创建。" @嵌入式方法 = "">
    {
        @ SUCCEEDED(@sn<this>.data().EndDraw())
    }

    方法 刷新 <公开 @嵌入式方法 = "">
    {
        @ @sn<this>.data().Flush()
    }

    方法 清除 <公开 @嵌入式方法 = "">
    参数 颜色 <类型 = D2D颜色>
    {
        @ @sn<this>.data().Clear(@<颜色>)
    }

    方法 置DPI <公开 @嵌入式方法 = "">
    参数 横向DPI <类型 = 单精度小数>
    参数 纵向DPI <类型 = 单精度小数>
    {
        @ @sn<this>.data().SetDpi(@<横向DPI>, @<纵向DPI>)
    }

    方法 置变换 <公开 @嵌入式方法 = "">
    参数 矩阵 <类型 = D2D矩阵>
    {
        @ @sn<this>.data().SetTransform(@<矩阵>)
    }

    方法 重置变换 <公开 @嵌入式方法 = "">
    {
        @ @sn<this>.data().ResetTransform()
    }

    方法 置抗锯齿模式 <公开 @嵌入式方法 = "">
    参数 模式 <类型 = 整数>
    {
        @ @sn<this>.data().SetAntialiasMode(@<模式>)
    }

    方法 置文本抗锯齿模式 <公开 @嵌入式方法 = "">
    参数 模式 <类型 = 整数>
    {
        @ @sn<this>.data().SetTextAntialiasMode(@<模式>)
    }

    方法 置标签 <公开 @嵌入式方法 = "">
    参数 标签1 <类型 = 长整数>
    参数 标签2 <类型 = 长整数>
    {
        @ @sn<this>.data().SetTags((UINT64)@<标签1>, (UINT64)@<标签2>)
    }

    方法 绘制直线 <公开 @嵌入式方法 = "">
    参数 起点横坐标 <类型 = 单精度小数>
    参数 起点纵坐标 <类型 = 单精度小数>
    参数 终点横坐标 <类型 = 单精度小数>
    参数 终点纵坐标 <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    参数 线宽 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ @sn<this>.data().DrawLine(volcano_d2d::MakePoint(@<起点横坐标>, @<起点纵坐标>), volcano_d2d::MakePoint(@<终点横坐标>, @<终点纵坐标>), @<颜色>, @<线宽>)
    }

    方法 绘制矩形 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    参数 线宽 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ @sn<this>.data().DrawRectangle(volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<颜色>, @<线宽>)
    }

    方法 填充矩形 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    {
        @ @sn<this>.data().FillRectangle(volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<颜色>)
    }

    方法 绘制圆角矩形 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 圆角X <类型 = 单精度小数>
    参数 圆角Y <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    参数 线宽 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ @sn<this>.data().DrawRoundedRectangle(volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<圆角X>, @<圆角Y>, @<颜色>, @<线宽>)
    }

    方法 填充圆角矩形 <公开 @嵌入式方法 = "">
    参数 左 <类型 = 单精度小数>
    参数 顶 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    参数 底 <类型 = 单精度小数>
    参数 圆角X <类型 = 单精度小数>
    参数 圆角Y <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    {
        @ @sn<this>.data().FillRoundedRectangle(volcano_d2d::MakeRect(@<左>, @<顶>, @<右>, @<底>), @<圆角X>, @<圆角Y>, @<颜色>)
    }

    方法 绘制椭圆 <公开 @嵌入式方法 = "">
    参数 中心X <类型 = 单精度小数>
    参数 中心Y <类型 = 单精度小数>
    参数 半径X <类型 = 单精度小数>
    参数 半径Y <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    参数 线宽 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ @sn<this>.data().DrawEllipse(volcano_d2d::MakePoint(@<中心X>, @<中心Y>), @<半径X>, @<半径Y>, @<颜色>, @<线宽>)
    }

    方法 填充椭圆 <公开 @嵌入式方法 = "">
    参数 中心X <类型 = 单精度小数>
    参数 中心Y <类型 = 单精度小数>
    参数 半径X <类型 = 单精度小数>
    参数 半径Y <类型 = 单精度小数>
    参数 颜色 <类型 = D2D颜色>
    {
        @ @sn<this>.data().FillEllipse(volcano_d2d::MakePoint(@<中心X>, @<中心Y>), @<半径X>, @<半径Y>, @<颜色>)
    }

    方法 创建纯色画刷 <公开 类型 = 通用指针 注释 = "返回 ID2D1SolidColorBrush*，用 释放对象 释放。" @嵌入式方法 = "">
    参数 颜色 <类型 = D2D颜色>
    参数 不透明度 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ volcano_d2d::CreateSolidBrushPtr(@sn<this>.data(), @<颜色>, @<不透明度>)
    }

    方法 创建描边样式 <公开 类型 = 通用指针 注释 = "返回 ID2D1StrokeStyle*，用 释放对象 释放。" @嵌入式方法 = "">
    参数 起点线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 终点线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 虚线线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 线连接 <类型 = 整数 @默认值 = D2D线连接样式.斜接>
    参数 斜接限制 <类型 = 单精度小数 @默认值 = 10.0>
    参数 虚线样式 <类型 = 整数 @默认值 = D2D虚线样式.实线>
    参数 虚线偏移 <类型 = 单精度小数 @默认值 = 0.0>
    {
        @ volcano_d2d::CreateStrokeStylePtr(@sn<this>.data(), @<起点线帽>, @<终点线帽>, @<虚线线帽>, @<线连接>, @<斜接限制>, @<虚线样式>, @<虚线偏移>)
    }

    方法 创建自定义虚线样式2段 <公开 类型 = 通用指针 注释 = "创建两段自定义虚线样式，返回 ID2D1StrokeStyle*。" @嵌入式方法 = "">
    参数 实线长度 <类型 = 单精度小数>
    参数 空白长度 <类型 = 单精度小数>
    参数 起点线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 终点线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 虚线线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 线连接 <类型 = 整数 @默认值 = D2D线连接样式.斜接>
    参数 斜接限制 <类型 = 单精度小数 @默认值 = 10.0>
    参数 虚线偏移 <类型 = 单精度小数 @默认值 = 0.0>
    {
        @ volcano_d2d::CreateCustomStrokeStyle2Ptr(@sn<this>.data(), @<实线长度>, @<空白长度>, @<起点线帽>, @<终点线帽>, @<虚线线帽>, @<线连接>, @<斜接限制>, @<虚线偏移>)
    }

    方法 创建自定义虚线样式4段 <公开 类型 = 通用指针 注释 = "创建四段自定义虚线样式，返回 ID2D1StrokeStyle*。" @嵌入式方法 = "">
    参数 段1 <类型 = 单精度小数>
    参数 段2 <类型 = 单精度小数>
    参数 段3 <类型 = 单精度小数>
    参数 段4 <类型 = 单精度小数>
    参数 起点线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 终点线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 虚线线帽 <类型 = 整数 @默认值 = D2D线帽样式.平直>
    参数 线连接 <类型 = 整数 @默认值 = D2D线连接样式.斜接>
    参数 斜接限制 <类型 = 单精度小数 @默认值 = 10.0>
    参数 虚线偏移 <类型 = 单精度小数 @默认值 = 0.0>
    {
        @ volcano_d2d::CreateCustomStrokeStyle4Ptr(@sn<this>.data(), @<段1>, @<段2>, @<段3>, @<段4>, @<起点线帽>, @<终点线帽>, @<虚线线帽>, @<线连接>, @<斜接限制>, @<虚线偏移>)
    }

    方法 创建线性渐变画刷2色 <公开 类型 = 通用指针 注释 = "创建两色线性渐变画刷，返回 ID2D1LinearGradientBrush*。" @嵌入式方法 = "">
    参数 起点X <类型 = 单精度小数>
    参数 起点Y <类型 = 单精度小数>
    参数 终点X <类型 = 单精度小数>
    参数 终点Y <类型 = 单精度小数>
    参数 起点颜色 <类型 = D2D颜色>
    参数 终点颜色 <类型 = D2D颜色>
    {
        @ volcano_d2d::CreateLinearGradientBrush2Ptr(@sn<this>.data(), volcano_d2d::MakePoint(@<起点X>, @<起点Y>), volcano_d2d::MakePoint(@<终点X>, @<终点Y>), @<起点颜色>, @<终点颜色>)
    }

    方法 创建线性渐变画刷3色 <公开 类型 = 通用指针 注释 = "创建三色线性渐变画刷，返回 ID2D1LinearGradientBrush*。" @嵌入式方法 = "">
    参数 起点X <类型 = 单精度小数>
    参数 起点Y <类型 = 单精度小数>
    参数 终点X <类型 = 单精度小数>
    参数 终点Y <类型 = 单精度小数>
    参数 起点颜色 <类型 = D2D颜色>
    参数 中间位置 <类型 = 单精度小数>
    参数 中间颜色 <类型 = D2D颜色>
    参数 终点颜色 <类型 = D2D颜色>
    {
        @ volcano_d2d::CreateLinearGradientBrush3Ptr(@sn<this>.data(), volcano_d2d::MakePoint(@<起点X>, @<起点Y>), volcano_d2d::MakePoint(@<终点X>, @<终点Y>), @<起点颜色>, @<中间位置>, @<中间颜色>, @<终点颜色>)
    }

    方法 创建径向渐变画刷2色 <公开 类型 = 通用指针 注释 = "创建两色径向渐变画刷，返回 ID2D1RadialGradientBrush*。" @嵌入式方法 = "">
    参数 中心X <类型 = 单精度小数>
    参数 中心Y <类型 = 单精度小数>
    参数 原点偏移X <类型 = 单精度小数>
    参数 原点偏移Y <类型 = 单精度小数>
    参数 半径X <类型 = 单精度小数>
    参数 半径Y <类型 = 单精度小数>
    参数 中心颜色 <类型 = D2D颜色>
    参数 边缘颜色 <类型 = D2D颜色>
    {
        @ volcano_d2d::CreateRadialGradientBrush2Ptr(@sn<this>.data(), volcano_d2d::MakePoint(@<中心X>, @<中心Y>), volcano_d2d::MakePoint(@<原点偏移X>, @<原点偏移Y>), @<半径X>, @<半径Y>, @<中心颜色>, @<边缘颜色>)
    }

    方法 创建径向渐变画刷3色 <公开 类型 = 通用指针 注释 = "创建三色径向渐变画刷，返回 ID2D1RadialGradientBrush*。" @嵌入式方法 = "">
    参数 中心X <类型 = 单精度小数>
    参数 中心Y <类型 = 单精度小数>
    参数 原点偏移X <类型 = 单精度小数>
    参数 原点偏移Y <类型 = 单精度小数>
    参数 半径X <类型 = 单精度小数>
    参数 半径Y <类型 = 单精度小数>
    参数 中心颜色 <类型 = D2D颜色>
    参数 中间位置 <类型 = 单精度小数>
    参数 中间颜色 <类型 = D2D颜色>
    参数 边缘颜色 <类型 = D2D颜色>
    {
        @ volcano_d2d::CreateRadialGradientBrush3Ptr(@sn<this>.data(), volcano_d2d::MakePoint(@<中心X>, @<中心Y>), volcano_d2d::MakePoint(@<原点偏移X>, @<原点偏移Y>), @<半径X>, @<半径Y>, @<中心颜色>, @<中间位置>, @<中间颜色>, @<边缘颜色>)
    }

    方法 释放对象 <公开 注释 = "释放本类返回的 COM 指针。" @嵌入式方法 = "">
    参数 对象指针 <类型 = 通用指针>
    {
        @ @sn<this>.data().ReleaseUnknown((IUnknown*)@<对象指针>)
    }

    方法 画刷置透明度 <公开 @嵌入式方法 = "">
    参数 画刷 <类型 = 通用指针>
    参数 不透明度 <类型 = 单精度小数>
    {
