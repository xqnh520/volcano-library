类 D2D颜色 <公开 注释 = "RGBA 颜色，范围 0.0 到 1.0。" 折叠 @别名 = "volcano_d2d::Color" @别名类型 = 本地值类型>
{
    变量 红 <公开 类型 = 单精度小数 @输出名 = "r">
    变量 绿 <公开 类型 = 单精度小数 @输出名 = "g">
    变量 蓝 <公开 类型 = 单精度小数 @输出名 = "b">
    变量 透明度 <公开 类型 = 单精度小数 @输出名 = "a">

    方法 创建 <公开 静态 类型 = D2D颜色 @嵌入式方法 = "">
    参数 红值 <类型 = 单精度小数>
    参数 绿值 <类型 = 单精度小数>
    参数 蓝值 <类型 = 单精度小数>
    参数 透明度值 <类型 = 单精度小数 @默认值 = 1.0>
    {
        @ volcano_d2d::MakeColor(@<红值>, @<绿值>, @<蓝值>, @<透明度值>)
    }

    方法 透明 <公开 静态 类型 = D2D颜色 @嵌入式方法 = "">
    {
        @ volcano_d2d::MakeColor(0, 0, 0, 0)
    }

    方法 白色 <公开 静态 类型 = D2D颜色 @嵌入式方法 = "">
    {
        @ volcano_d2d::MakeColor(1, 1, 1, 1)
    }

    方法 黑色 <公开 静态 类型 = D2D颜色 @嵌入式方法 = "">
    {
        @ volcano_d2d::MakeColor(0, 0, 0, 1)
    }

    方法 浅蓝 <公开 静态 类型 = D2D颜色 @嵌入式方法 = "">
    {
        @ volcano_d2d::MakeColor(0.26f, 0.58f, 0.94f, 1)
    }

    方法 从整数 <公开 静态 类型 = D2D颜色 注释 = "把火山/Windows 颜色整数值转换为 D2D RGBA 颜色。颜色整数按 COLORREF 低字节红色、中字节绿色、高字节蓝色处理。" @嵌入式方法 = "">
    参数 颜色值 <类型 = 整数 注释 = "火山颜色整数值，可来自颜色类常量或设计器颜色属性。">
    {
        @ volcano_d2d::MakeColorFromColorRef(@<颜色值>)
    }
}

