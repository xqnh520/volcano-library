<火山程序 类型 = "通常" 版本 = 1 />

包 火山.D2D绘制引擎 <注释 = "Direct2D / DirectWrite / WIC 绘制引擎封装。" 注释 = "火山语法依据官方火山视窗文本格式；封装组织参考 PIV 三方库的外部头文件/源文件 + 嵌入式方法风格。"
        注释 = "系统依赖：Windows 桌面 HWND 环境，编译期需要 Windows SDK 中的 d2d1.h、dwrite.h、wincodec.h 以及 d2d1.lib、dwrite.lib、windowscodecs.lib；Windows SDK 下载页：https://developer.microsoft.com/windows/downloads/windows-sdk/"
        注释 = "运行环境：Direct2D、DirectWrite、WIC 为 Windows 图形组件。Windows 10/11 与新版 Windows Server 通常系统自带；Windows 7 SP1 / Windows Server 2008 R2 SP1 若缺少 Direct2D/DirectWrite 更新，请安装微软 Platform Update，下载页：https://www.microsoft.com/download/details.aspx?id=36805"
        注释 = "通常不需要安装旧 DirectX End-User Runtime 来获得 Direct2D；只有程序另用 D3DX/XAudio/XInput 等旧 DirectX SDK 组件时才考虑安装 DirectX End-User Runtime，下载页：https://www.microsoft.com/download/details.aspx?id=35"
        注释 = "SVG 依赖：lunasvg/plutovg 源码随本类库一起编译，通常不需要额外安装 SVG 运行库；若编译器不支持 C++17，请升级 VS/Windows SDK 工具链或移除 SVG 桥接源文件。" 注释 = ""
        注释 = "水淼使用AI封装。如需封装类库，有偿联系水淼QQ897687648提供开源地址，一般200元一个，复杂或耗时库酌情高价。"
        @视窗.头文件搜寻目录 = "native\r\nnative\\third_party\\lunasvg\\include\r\nnative\\third_party\\lunasvg\\source\r\nnative\\third_party\\lunasvg\\plutovg\\include\r\nnative\\third_party\\lunasvg\\plutovg\\source"
        @视窗.外部头文件 = "native\\d2d_engine.hpp"
        @视窗.外部源文件 = "native\\d2d_engine.cpp\r\nnative\\lunasvg_bridge.cpp\r\nnative\\third_party\\lunasvg\\source\\graphics.cpp\r\nnative\\third_party\\lunasvg\\source\\lunasvg.cpp\r\nnative\\third_party\\lunasvg\\source\\svgelement.cpp\r\nnative\\third_party\\lunasvg\\source\\svggeometryelement.cpp\r\nnative\\third_party\\lunasvg\\source\\svglayoutstate.cpp\r\nnative\\third_party\\lunasvg\\source\\svgpaintelement.cpp\r\nnative\\third_party\\lunasvg\\source\\svgparser.cpp\r\nnative\\third_party\\lunasvg\\source\\svgproperty.cpp\r\nnative\\third_party\\lunasvg\\source\\svgrenderstate.cpp\r\nnative\\third_party\\lunasvg\\source\\svgtextelement.cpp\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-blend.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-canvas.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-font.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-ft-math.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-ft-raster.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-ft-stroker.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-matrix.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-paint.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-path.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-rasterize.c\r\nnative\\third_party\\lunasvg\\plutovg\\source\\plutovg-surface.c"
        @视窗.附加编译参数 = "cpp: /std:c++17"
        @视窗.预定义宏 = "UNICODE,_UNICODE,D2D_ENGINE_VOLCANO,LUNASVG_BUILD_STATIC,PLUTOVG_BUILD_STATIC,_CRT_SECURE_NO_WARNINGS,WINVER=0x0601,_WIN32_WINNT=0x0601,NTDDI_VERSION=0x06010000">

