        引擎.绘制文本 ("图元与变换：颜色版图元会复用内部临时画刷，适合高频绘制。", 36, 150, 720, 182, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.10, 0.12, 1), "微软雅黑", 16, 火山.D2D绘制引擎.D2D字体粗细.半粗)
        引擎.填充矩形 (48, 210, 168, 290, 火山.D2D绘制引擎.D2D颜色.创建 (0.91, 0.72, 0.22, 1))
        引擎.绘制矩形 (48, 210, 168, 290, 火山.D2D绘制引擎.D2D颜色.创建 (0.22, 0.18, 0.08, 1), 3)
        引擎.填充圆角矩形 (204, 210, 344, 290, 18, 18, 火山.D2D绘制引擎.D2D颜色.创建 (0.25, 0.58, 0.82, 1))
        引擎.绘制圆角矩形 (204, 210, 344, 290, 18, 18, 火山.D2D绘制引擎.D2D颜色.创建 (0.07, 0.20, 0.34, 1), 2)
        引擎.填充椭圆 (438, 250, 62, 42, 火山.D2D绘制引擎.D2D颜色.创建 (0.88, 0.34, 0.30, 1))
        引擎.绘制直线 (540, 210, 700, 292, 火山.D2D绘制引擎.D2D颜色.创建 (0.10, 0.14, 0.18, 1), 4)
        状态 = 引擎.创建绘制状态 ()
        引擎.保存绘制状态 (状态)
        矩阵 = 火山.D2D绘制引擎.D2D矩阵.单位矩阵 ()
        矩阵.M11 = 0.86
        矩阵.M12 = 0.50
        矩阵.M21 = -0.50
        矩阵.M22 = 0.86
        矩阵.DX = 220
        矩阵.DY = 344
