        引擎.填充矩形 (60, 220, 700, 540, 火山.D2D绘制引擎.D2D颜色.创建 (0.10, 0.14, 0.18, 1))
        引擎.填充椭圆 (220, 380, 170, 170, 火山.D2D绘制引擎.D2D颜色.创建 (0.32, 0.72, 0.88, 0.82))
        引擎.填充椭圆 (520, 380, 170, 170, 火山.D2D绘制引擎.D2D颜色.创建 (0.94, 0.64, 0.22, 0.82))
        引擎.弹出裁剪 ()
        引擎.弹出图层 ()
        引擎.绘制圆角矩形 (80, 250, 680, 510, 14, 14, 火山.D2D绘制引擎.D2D颜色.创建 (0.02, 0.04, 0.06, 1), 2)
        引擎.释放对象 (图层)
    }

    方法 绘制组件页 <公开>
    {
        引擎.绘制文本 ("组件库示例：宿主仍是普通窗口，D2D 组件只附着 HWND 做自绘、命中测试和状态反馈。", 36, 150, 720, 180, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.10, 0.12, 1), "微软雅黑", 16, 火山.D2D绘制引擎.D2D字体粗细.半粗)
        D2D组件工具.组件置数值 (引擎, 组件进度, D2D组件工具.组件取数值 (引擎, 组件滑块))
        D2D组件工具.绘制组件 (引擎, 组件根)
        如果 (D2D组件工具.组件取选中 (引擎, 组件复选) == 真)
        {
            引擎.绘制文本 ("复选框已选中，滑块会同步进度条。", 360, 286, 670, 316, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.36, 0.24, 1), "微软雅黑", 14)
        }
        如果 (D2D组件工具.组件取选中 (引擎, 组件复选) == 假)
        {
            引擎.绘制文本 ("复选框未选中，MFC 窗口事件仍照常触发。", 360, 286, 670, 316, 火山.D2D绘制引擎.D2D颜色.创建 (0.36, 0.18, 0.08, 1), "微软雅黑", 14)
        }
    }

    方法 绘制设计器组件页 <公开>
    {
        引擎.绘制文本 ("设计器组件：当前稳定版先保留轻量D2D组件层；真实窗口组件类需要逐项验证后再恢复。", 36, 150, 720, 180, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.10, 0.12, 1), "微软雅黑", 16, 火山.D2D绘制引擎.D2D字体粗细.半粗)
        引擎.绘制文本 ("避免再次破坏WSV解析：后续会一次只增加一个组件类，并在IDE确认可解析后继续。", 72, 556, 690, 590, 火山.D2D绘制引擎.D2D颜色.创建 (0.26, 0.30, 0.31, 1), "微软雅黑", 14)
    }

    方法 绘制内存画板页 <公开>
    {
        变量 画板 <类型 = 火山.D2D绘制引擎.D2D内存画板>
        变量 图片数据 <类型 = 字节集类>
        变量 预览位图 <类型 = 通用指针>
        变量 输出位图 <类型 = 位图对象类>
        引擎.绘制文本 ("全功能内存画板：离屏 D2D 绘制、SVG/传统图片绘制、PNG 字节集与位图对象输出。", 36, 150, 720, 180, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.10, 0.12, 1), "微软雅黑", 16, 火山.D2D绘制引擎.D2D字体粗细.半粗)
        如果 (画板.创建 (360, 240, 火山.D2D绘制引擎.D2D颜色.创建 (1, 1, 1, 0)) == 假)
        {
            引擎.绘制文本 ("内存画板创建失败：" + 画板.取错误文本 (), 60, 230, 700, 270, 火山.D2D绘制引擎.D2D颜色.创建 (0.60, 0.10, 0.08, 1), "微软雅黑", 15)
            返回
        }

        画板.开始绘制 ()
        画板.清空 (火山.D2D绘制引擎.D2D颜色.创建 (0.97, 0.98, 0.96, 1))
        画板.置刷子 (火山.D2D绘制引擎.D2D颜色.创建 (0.92, 0.66, 0.24, 1))
        画板.置画笔 (火山.D2D绘制引擎.D2D颜色.创建 (0.28, 0.20, 0.08, 1), 2)
        画板.画圆角矩形 (24, 22, 180, 110, 18, 18)
        画板.置刷子 (火山.D2D绘制引擎.D2D颜色.创建 (0.20, 0.56, 0.74, 0.92))
        画板.画椭圆 (186, 32, 326, 132)
        画板.置画笔 (火山.D2D绘制引擎.D2D颜色.创建 (0.12, 0.16, 0.20, 1), 3)
        画板.画直线 (28, 150, 330, 174)
        画板.置字体 ("微软雅黑", 20, 火山.D2D绘制引擎.D2D字体粗细.半粗)
        画板.置文本颜色 (火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.12, 0.16, 1))
        画板.绘制文本 (32, 184, 328, 226, "D2D内存画板 + SVG/PNG/JPG/ICO", 0, 0, 真)
        画板.绘制SVG文件 ("svg图标\\GPT.svg", 242, 54, 62, 62)
        画板.结束绘制 ()

        图片数据 = 画板.取PNG数据 ()
        画板.取位图对象 (输出位图)
        预览位图 = 引擎.载入位图数据 (图片数据)
        如果 (预览位图 != 0)
        {
            引擎.绘制位图 (预览位图, 72, 220, 432, 460)
            引擎.释放对象 (预览位图)
        }
        引擎.绘制文本 ("左侧预览来自内存画板导出的 PNG 字节集，再由 D2D 引擎从内存载入绘制。", 468, 238, 704, 314, 火山.D2D绘制引擎.D2D颜色.创建 (0.10, 0.14, 0.16, 1), "微软雅黑", 14)
        引擎.绘制文本 ("同时已调用 取位图对象，可交给火山 位图对象类 使用。", 468, 332, 704, 392, 火山.D2D绘制引擎.D2D颜色.创建 (0.24, 0.35, 0.25, 1), "微软雅黑", 14)
        引擎.绘制文本 ("取点(32,32) COLORREF = " + 到文本 (画板.取点 (32, 32)), 468, 410, 704, 448, 火山.D2D绘制引擎.D2D颜色.创建 (0.22, 0.22, 0.22, 1), "微软雅黑", 13)
        画板.销毁 ()
    }

    方法 绘制兼容内存画板页 <公开>
    {
        变量 源画板 <类型 = 火山.D2D绘制引擎.D2D兼容内存画板>
        变量 目标画板 <类型 = 火山.D2D绘制引擎.D2D兼容内存画板>
        变量 图片数据 <类型 = 字节集类>
        变量 预览位图 <类型 = 通用指针>
        引擎.绘制文本 ("兼容火山画板接口的内存画板：保留常用画板方法命名，但不创建窗口组件。", 36, 150, 720, 180, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.10, 0.12, 1), "微软雅黑", 16, 火山.D2D绘制引擎.D2D字体粗细.半粗)
        源画板.创建 (300, 210, 火山.D2D绘制引擎.D2D颜色.创建 (0.99, 0.99, 0.97, 1))
        目标画板.创建 (300, 210, 火山.D2D绘制引擎.D2D颜色.创建 (0.93, 0.96, 0.98, 1))

        源画板.画笔颜色 = 30 + 70 * 256 + 100 * 65536
        源画板.画笔粗细 = 3
        源画板.刷子颜色 = 234 + 205 * 256 + 92 * 65536
        源画板.画矩形 (28, 28, 132, 102)
        源画板.刷子颜色 = 90 + 170 * 256 + 190 * 65536
        源画板.画椭圆 (158, 34, 266, 124)
        源画板.文本颜色 = 26 + 34 * 256 + 40 * 65536
        源画板.置字体 ("微软雅黑", 18, 火山.D2D绘制引擎.D2D字体粗细.半粗)
        源画板.定位写出 (38, 150, "兼容：画矩形/画椭圆/写出/复制")
        源画板.绘制SVG文件 ("svg图标\\GPT.svg", 214, 134, 48, 48)
        源画板.复制 (0, 0, -1, -1, 目标画板, 0, 0)
        目标画板.定位写出 (34, 176, "复制到第二张内存画板")

        图片数据 = 目标画板.取图片数据 ()
        预览位图 = 引擎.载入位图数据 (图片数据)
        如果 (预览位图 != 0)
        {
            引擎.绘制位图 (预览位图, 84, 226, 384, 436)
            引擎.释放对象 (预览位图)
        }
        引擎.绘制文本 ("这一页使用 D2D兼容内存画板，方法名尽量贴近火山视窗画板：清除、画点、画直线、画矩形、画椭圆、写出、画图片、复制、取图片。组件事件和窗口句柄类接口在内存版中省略。", 430, 234, 704, 400, 火山.D2D绘制引擎.D2D颜色.创建 (0.10, 0.14, 0.16, 1), "微软雅黑", 14, 火山.D2D绘制引擎.D2D字体粗细.常规, 火山.D2D绘制引擎.D2D字体样式.正常, 火山.D2D绘制引擎.D2D文本对齐.左, 火山.D2D绘制引擎.D2D段落对齐.顶部)
        源画板.销毁 ()
        目标画板.销毁 ()
    }

    方法 绘制高级能力页 <公开>
    {
        变量 矩形几何 <类型 = 通用指针>
        变量 椭圆几何 <类型 = 通用指针>
        变量 相交几何 <类型 = 通用指针>
        变量 排除几何 <类型 = 通用指针>
        变量 扩宽几何 <类型 = 通用指针>
        变量 蓝刷 <类型 = 通用指针>
        变量 橙刷 <类型 = 通用指针>
        变量 深刷 <类型 = 通用指针>
        变量 文本格式 <类型 = 通用指针>
        变量 文本布局 <类型 = 通用指针>
        变量 度量 <类型 = 火山.D2D绘制引擎.D2D文本度量>
        变量 字符位置 <类型 = 整数>
        变量 旋转矩阵 <类型 = 火山.D2D绘制引擎.D2D矩阵>

        引擎.绘制文本 ("高级能力：几何布尔/扩宽轮廓、矩阵辅助、文本布局度量与命中测试。", 36, 150, 720, 180, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.10, 0.12, 1), "微软雅黑", 16, 火山.D2D绘制引擎.D2D字体粗细.半粗)

        矩形几何 = 引擎.创建圆角矩形几何 (70, 224, 252, 354, 28, 28)
        椭圆几何 = 引擎.创建椭圆几何 (206, 286, 88, 72)
        相交几何 = 引擎.创建合并几何 (矩形几何, 椭圆几何, 火山.D2D绘制引擎.D2D几何合并模式.相交)
        排除几何 = 引擎.创建合并几何 (矩形几何, 椭圆几何, 火山.D2D绘制引擎.D2D几何合并模式.排除)
        扩宽几何 = 引擎.创建扩宽几何 (椭圆几何, 16)
        蓝刷 = 引擎.创建线性渐变画刷2色 (70, 224, 252, 354, 火山.D2D绘制引擎.D2D颜色.创建 (0.20, 0.56, 0.74, 0.72), 火山.D2D绘制引擎.D2D颜色.创建 (0.12, 0.30, 0.52, 0.72))
        橙刷 = 引擎.创建纯色画刷 (火山.D2D绘制引擎.D2D颜色.创建 (0.94, 0.58, 0.20, 0.88))
        深刷 = 引擎.创建纯色画刷 (火山.D2D绘制引擎.D2D颜色.创建 (0.10, 0.12, 0.14, 1))
        引擎.画刷填充路径 (排除几何, 蓝刷)
        引擎.画刷填充路径 (相交几何, 橙刷)
        引擎.画刷绘制路径 (扩宽几何, 深刷, 2)
        引擎.绘制文本 ("布尔：排除 + 相交；椭圆扩宽为可填充轮廓", 72, 368, 340, 414, 火山.D2D绘制引擎.D2D颜色.创建 (0.18, 0.20, 0.20, 1), "微软雅黑", 13)

        旋转矩阵 = 火山.D2D绘制引擎.D2D矩阵.旋转 (-10, 484, 292)
        引擎.置变换 (旋转矩阵)
        引擎.填充圆角矩形 (398, 238, 570, 338, 18, 18, 火山.D2D绘制引擎.D2D颜色.创建 (0.18, 0.48, 0.36, 0.88))
        引擎.绘制装饰文本 ("矩阵旋转 + 下划线", 414, 270, 554, 316, 火山.D2D绘制引擎.D2D颜色.白色 (), "微软雅黑", 17, 火山.D2D绘制引擎.D2D字体粗细.半粗, 火山.D2D绘制引擎.D2D字体样式.正常, 真, 假, 0, 火山.D2D绘制引擎.D2D文本对齐.居中, 火山.D2D绘制引擎.D2D段落对齐.居中)
        引擎.重置变换 ()

        文本格式 = 引擎.创建文本格式 ("微软雅黑", 15, 火山.D2D绘制引擎.D2D字体粗细.常规)
        文本布局 = 引擎.创建文本布局 ("文本布局可测量宽高、行数，并能把坐标命中到字符位置。", 文本格式, 280, 80)
        度量 = 引擎.取文本布局度量 (文本布局)
        字符位置 = 引擎.文本布局点取字符位置 (文本布局, 88, 22)
        引擎.画刷绘制文本布局 (文本布局, 深刷, 390, 392)
        引擎.绘制文本 ("宽=" + 到文本 (度量.宽度) + " 高=" + 到文本 (度量.高度) + " 行数=" + 到文本 (度量.行数) + " 命中位置=" + 到文本 (字符位置), 390, 482, 706, 522, 火山.D2D绘制引擎.D2D颜色.创建 (0.18, 0.20, 0.20, 1), "微软雅黑", 13)

        引擎.释放对象 (矩形几何)
        引擎.释放对象 (椭圆几何)
        引擎.释放对象 (相交几何)
        引擎.释放对象 (排除几何)
        引擎.释放对象 (扩宽几何)
        引擎.释放对象 (蓝刷)
        引擎.释放对象 (橙刷)
        引擎.释放对象 (深刷)
        引擎.释放对象 (文本格式)
        引擎.释放对象 (文本布局)
    }

    方法 销毁 <公开>
    {
        D2D组件工具.销毁组件 (引擎, 组件根)
        引擎.卸载自动重画 ()
        引擎.销毁 ()
    }
}
