<火山程序 类型 = "通常" 版本 = 1 />

包 火山.D2D绘制引擎.示例

类 启动类 <公开 基础类 = 窗口程序类>
{
    变量 主窗口 <类型 = D2D示例主窗口 标题 = "D2D 绘制引擎示例">

    方法 启动方法 <公开 类型 = 整数>
    {

        主窗口.创建主窗口 ()
        返回 (1)
    }
}

类 D2D示例主窗口 <公开 基础类 = 窗口 注释 = "D2D 绘制引擎测试窗口。" @视窗.布局 = "client_size = \"760, 640\"" 标题 = "D2D 绘制引擎示例" 窗口边框 = 普通可调边框>
{
    变量 示例 <类型 = D2D窗口绘制示例>
    变量 设计器D2D按钮 <类型 = 火山.D2D绘制引擎.D2D按钮 @视窗.布局 = "id = 101\r\npos = \"72, 173, 315, 145\"" 标题 = "真实D2D按钮"
            字体 = "微软雅黑, 20, 1, 0, 0, 0, 0" 标准鼠标指针 = 手型 提示信息 = "1111" 可停留焦点 = 真 允许文件拖放 = 真 图标位置 = 0 图标大小 = 60 水平对齐 = 0
            普通图标 = "svg图标\\GPT.svg" 圆角 = 10 边框宽度 = 5 焦点线宽 = 0 渐变高光 = 真>

    方法 窗口_创建完毕 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = 窗口>
    参数 标记值 <类型 = 整数>
    {
        示例.创建 (取窗口句柄 ())
        示例.安装自动重画 ()
        同步设计器组件可视 ()
        返回 (0)
    }

    方法 D2D窗口绘制示例_页被改变 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = D2D窗口绘制示例>
    参数 标记值 <类型 = 整数>
    参数 新页 <类型 = 整数>
    {
        同步设计器组件可视 ()
        返回 (0)
    }

    方法 窗口_尺寸被改变 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = 窗口>
    参数 标记值 <类型 = 整数>
    {
        示例.调整尺寸 (取用户区宽度 (), 取用户区高度 ())
        示例.请求重画 ()
        同步设计器组件可视 ()
        返回 (0)
    }

    方法 窗口_将被销毁 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = 窗口>
    参数 标记值 <类型 = 整数>
    {
        示例.销毁 ()
        返回 (0)
    }

    方法 同步设计器组件可视 <公开>
    {
        变量 显示设计器页 <类型 = 逻辑型>
        显示设计器页 = 示例.取当前页 () == 7
        设计器D2D按钮.可视 = 显示设计器页
        如果 (显示设计器页)
        {
            设计器D2D按钮.提到前方 ()
            设计器D2D按钮.刷新 ()
        }
    }

    方法 D2D按钮_被单击 <接收事件 类型 = 整数>
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    {
        如果 (来源对象 == 设计器D2D按钮)
        {
            调试输出 ("单击", 到文本 (来源对象.左边) + "," + 到文本 (来源对象.顶边) + "," + 到文本 (来源对象.宽度) + "," + 到文本 (来源对象.高度), 来源对象.标题, 来源对象.已选中)
        }
        返回 (0)
    }

    方法 D2D按钮_鼠标位置被移动 <接收事件 类型 = 整数 注释 = "当鼠标位置被移动时事件被触发" 返回值注释 = "本事件的处理方法如果返回非0整数值,表明事件已经得到处理且不再需要后续处理.">
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    参数 横向位置 <类型 = 整数 注释 = "事件触发时的鼠标横向坐标位置,相对所处用户区的左边.">
    参数 纵向位置 <类型 = 整数 注释 = "事件触发时的鼠标纵向坐标位置,相对所处用户区的顶边.">
    参数 辅助键状态 <类型 = 整数 注释 = "事件触发时的辅助键组合状态,为\"辅助键状态\"类中各常量值的组合.">
    {
        // 如果 (来源对象 == 设计器D2D按钮)
        {
            // 调试输出 ("按钮上移动", 横向位置, 纵向位置)
        }
        返回 (0)
    }

    方法 D2D按钮_鼠标左键被按下 <接收事件 类型 = 整数 注释 = "当鼠标左键被按下时事件被触发" 返回值注释 = "本事件的处理方法如果返回非0整数值,表明事件已经得到处理且不再需要后续处理.">
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    参数 横向位置 <类型 = 整数 注释 = "事件触发时的鼠标横向坐标位置,相对所处用户区的左边.">
    参数 纵向位置 <类型 = 整数 注释 = "事件触发时的鼠标纵向坐标位置,相对所处用户区的顶边.">
    参数 辅助键状态 <类型 = 整数 注释 = "事件触发时的辅助键组合状态,为\"辅助键状态\"类中各常量值的组合.">
    {
        如果 (来源对象 == 设计器D2D按钮)
        {
            调试输出 ("按钮按下", 来源对象.标题)
        }
        返回 (0)
    }

    方法 D2D按钮_鼠标左键被放开 <接收事件 类型 = 整数 注释 = "当鼠标左键被放开时事件被触发" 返回值注释 = "本事件的处理方法如果返回非0整数值,表明事件已经得到处理且不再需要后续处理.">
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    参数 横向位置 <类型 = 整数 注释 = "事件触发时的鼠标横向坐标位置,相对所处用户区的左边.">
    参数 纵向位置 <类型 = 整数 注释 = "事件触发时的鼠标纵向坐标位置,相对所处用户区的顶边.">
    参数 辅助键状态 <类型 = 整数 注释 = "事件触发时的辅助键组合状态,为\"辅助键状态\"类中各常量值的组合.">
    {
        如果 (来源对象 == 设计器D2D按钮)
        {
            调试输出 ("按钮放开", 来源对象.标题)

        }
        返回 (0)
    }

    方法 D2D按钮_获得焦点 <接收事件 类型 = 整数 注释 = "  当本组件获得输入焦点后发送此事件." 注释 = "  所谓\"输入焦点\",即当前用户按键操作所对应的目标组件. 譬如: 用户正在编辑框中输入文本,"
            注释 = "那么此编辑框就具有输入焦点,因为它将获得目前用户所进行的所有按键操作. 所谓\"获得\"或者" 注释 = "\"失去\"输入焦点,即当前用户按键操作所对应的目标对象发生转移. 譬如: 用户现在正在编辑框1"
            注释 = "中输入文本,突然使用鼠标或其它方法切换到了编辑框2上去继续输入,那么此时编辑框1就\"失去\"" 注释 = "了输入焦点,编辑框2就\"获得\"了输入焦点,因为在此以后用户所进行的所有按键操作都将被"
            注释 = "编辑框2所获得." 返回值注释 = "本事件的处理方法如果返回非0整数值,表明事件已经得到处理且不再需要后续处理.">
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    {
        如果 (来源对象 == 设计器D2D按钮)
        {
            调试输出 ("获得焦点", 来源对象.标题)
        }
        返回 (0)
    }

    方法 D2D按钮_失去焦点 <接收事件 类型 = 整数 注释 = "  当本组件失去输入焦点后发送此事件." 注释 = "  所谓\"输入焦点\",即当前用户按键操作所对应的目标组件. 譬如: 用户正在编辑框中输入文本,"
            注释 = "那么此编辑框就具有输入焦点,因为它将获得目前用户所进行的所有按键操作. 所谓\"获得\"或者" 注释 = "\"失去\"输入焦点,即当前用户按键操作所对应的目标对象发生转移. 譬如: 用户现在正在编辑框1"
            注释 = "中输入文本,突然使用鼠标或其它方法切换到了编辑框2上去继续输入,那么此时编辑框1就\"失去\"" 注释 = "了输入焦点,编辑框2就\"获得\"了输入焦点,因为在此以后用户所进行的所有按键操作都将被"
            注释 = "编辑框2所获得." 返回值注释 = "本事件的处理方法如果返回非0整数值,表明事件已经得到处理且不再需要后续处理.">
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    {
        如果 (来源对象 == 设计器D2D按钮)
        {
            调试输出 ("失去焦点", 来源对象.标题)

        }
        返回 (0)
    }

    方法 D2D按钮_按下某键 <接收事件 类型 = 整数 注释 = "当用户按下某个按键时事件被触发" 返回值注释 = "本事件的处理方法如果返回非0整数值,表明事件已经得到处理且不再需要后续处理.">
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    参数 键代码 <类型 = 整数 注释 = "为\"按键码\"类中的常量值,注意不包括辅助键组合状态值.">
    参数 辅助键状态 <类型 = 整数 注释 = "事件触发时的辅助键组合状态,为\"辅助键状态\"类中各常量值的组合.">
    {
        如果 (来源对象 == 设计器D2D按钮)
        {
            调试输出 ("按下按键", 键代码)
        }
        返回 (0)
    }

    方法 D2D按钮_文件被拖放 <接收事件 类型 = 整数 注释 = "当文件被拖放到本窗口组件上后,将发送本事件." 注释 = "注意: 仅当\"允许文件拖放\"属性被设置为真时,本事件才会被发送.">
    参数 来源对象 <类型 = D2D按钮 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    参数 所拖放文件 <类型 = 文本数组类 注释 = "提供所有被拖放到本组件上的文件名,数组成员数必定大于0.">
    {
        如果 (来源对象 == 设计器D2D按钮)
        {
            调试输出 (所拖放文件)
        }
        返回 (0)
    }
}

类 D2D窗口绘制示例 <公开 注释 = "把这些调用放到窗口创建、尺寸改变和绘制事件中即可。">
{

    #
    # @ static void D2D自动绘制回调(void* self)
    # @ {
    # @     reinterpret_cast<@sn<current_class>*>(self)->@<绘制>();
    # @ }
    # @ static void D2D鼠标回调(void* self, int x, int y, int type)
    # @ {
    # @     reinterpret_cast<@sn<current_class>*>(self)->@<鼠标点击>(x, y, type);
    # @ }

    变量 引擎 <公开 类型 = 火山.D2D绘制引擎.D2D绘制引擎>
    变量 当前页 <类型 = 整数 值 = 0>
    变量 组件根 <类型 = 通用指针>
    变量 组件进度 <类型 = 通用指针>
    变量 组件滑块 <类型 = 通用指针>
    变量 组件复选 <类型 = 通用指针>

    方法 页被改变 <公开 定义事件 类型 = 整数>
    参数 新页 <类型 = 整数>

    方法 创建 <公开 类型 = 逻辑型>
    参数 窗口句柄 <类型 = 变整数>
    {
        变量 选项 <类型 = 火山.D2D绘制引擎.D2D渲染选项>
        选项 = 火山.D2D绘制引擎.D2D渲染选项.默认选项 ()
        选项.工厂类型 = 火山.D2D绘制引擎.D2D工厂类型.单线程
        选项.渲染目标类型 = 火山.D2D绘制引擎.D2D渲染目标类型.默认
        选项.GDI兼容 = 假
        如果 (引擎.创建到窗口Ex (窗口句柄, 0, 0, 选项) == 真)
        {
            创建组件示例 ()
            返回 (真)
        }
        返回 (假)
    }

    方法 取回调对象指针 <类型 = 通用指针 @嵌入式方法 = "">
    {
        @ &@sn<this>
    }

    方法 取绘制回调指针 <类型 = 通用指针 @嵌入式方法 = "">
    {
        @ reinterpret_cast<void*>(&D2D自动绘制回调)
    }

    方法 取鼠标回调指针 <类型 = 通用指针 @嵌入式方法 = "">
    {
        @ reinterpret_cast<void*>(&D2D鼠标回调)
    }

    方法 安装自动重画 <公开 类型 = 逻辑型>
    {
        返回 (引擎.安装自动重画Ex (取回调对象指针 (), 取绘制回调指针 (), 取鼠标回调指针 ()))
    }

    方法 取当前页 <公开 类型 = 整数>
    {
        返回 (当前页)
    }

    方法 取标签页 <类型 = 整数 @嵌入式方法 = "">
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    {
        @ volcano_d2d::HitTestDemoTab(@<横坐标>, @<纵坐标>)
    }

    方法 鼠标点击 <公开>
    参数 横坐标 <类型 = 整数>
    参数 纵坐标 <类型 = 整数>
    参数 类型 <类型 = 整数>
    {
        变量 页 <类型 = 整数>
        D2D组件工具.组件鼠标事件 (引擎, 组件根, 横坐标, 纵坐标, 类型)
        如果 (类型 == 火山.D2D绘制引擎.D2D鼠标事件类型.左键按下)
        {
            页 = 取标签页 (横坐标, 纵坐标)
            如果 (页 >= 0)
            {
                当前页 = 页
                页被改变 (当前页)
                请求重画 ()
            }
        }
    }

    方法 创建组件示例 <公开>
    {
        变量 面板 <类型 = 通用指针>
        变量 按钮 <类型 = 通用指针>
        变量 文本块 <类型 = 通用指针>
        组件根 = D2D组件工具.创建组件容器 (引擎)
        面板 = D2D组件工具.创建组件 (引擎, 火山.D2D绘制引擎.D2D组件类型.面板)
        D2D组件工具.组件置矩形 (引擎, 面板, 40, 182, 720, 560)
        D2D组件工具.组件置文本 (引擎, 面板, "D2D 组件层：复用窗口 HWND，保留 MFC 原属性与事件，扩展自绘状态。")
        D2D组件工具.组件加入 (引擎, 组件根, 面板)

        按钮 = D2D组件工具.创建组件 (引擎, 火山.D2D绘制引擎.D2D组件类型.按钮)
        D2D组件工具.组件置矩形 (引擎, 按钮, 72, 248, 214, 292)
        D2D组件工具.组件置文本 (引擎, 按钮, "D2D 按钮")
        D2D组件工具.组件加入 (引擎, 组件根, 按钮)

        组件复选 = D2D组件工具.创建组件 (引擎, 火山.D2D绘制引擎.D2D组件类型.复选框)
        D2D组件工具.组件置矩形 (引擎, 组件复选, 72, 318, 320, 350)
        D2D组件工具.组件置文本 (引擎, 组件复选, "复选框：点击可切换")
        D2D组件工具.组件置选中 (引擎, 组件复选, 真)
        D2D组件工具.组件加入 (引擎, 组件根, 组件复选)

        组件进度 = D2D组件工具.创建组件 (引擎, 火山.D2D绘制引擎.D2D组件类型.进度条)
        D2D组件工具.组件置矩形 (引擎, 组件进度, 360, 252, 666, 278)
        D2D组件工具.组件置范围 (引擎, 组件进度, 0, 100)
        D2D组件工具.组件置数值 (引擎, 组件进度, 64)
        D2D组件工具.组件加入 (引擎, 组件根, 组件进度)

        组件滑块 = D2D组件工具.创建组件 (引擎, 火山.D2D绘制引擎.D2D组件类型.滑块)
        D2D组件工具.组件置矩形 (引擎, 组件滑块, 360, 328, 666, 356)
        D2D组件工具.组件置范围 (引擎, 组件滑块, 0, 100)
        D2D组件工具.组件置数值 (引擎, 组件滑块, 42)
        D2D组件工具.组件加入 (引擎, 组件根, 组件滑块)

        文本块 = D2D组件工具.创建组件 (引擎, 火山.D2D绘制引擎.D2D组件类型.文本块)
        D2D组件工具.组件置矩形 (引擎, 文本块, 72, 410, 666, 500)
        D2D组件工具.组件置文本 (引擎, 文本块, "这些组件不是替换 MFC 控件，而是绘制在任意窗口/控件句柄上。宿主仍可继续使用火山视窗/MFC 的标题、尺寸、可见、启用、焦点和原有事件；D2D 层负责更细腻的绘制、命中测试与状态表现。")
        D2D组件工具.组件加入 (引擎, 组件根, 文本块)
    }

    方法 请求重画 <公开>
    {
        引擎.请求重画 (假)
    }

    方法 调整尺寸 <公开>
    参数 宽度 <类型 = 整数>
    参数 高度 <类型 = 整数>
    {
        引擎.调整尺寸 (宽度, 高度)
    }

    方法 绘制 <公开>
    {
        如果 (引擎.是否可用 () == 假)
        {
            返回
        }

        引擎.开始绘制 ()
        引擎.清除 (火山.D2D绘制引擎.D2D颜色.创建 (0.96, 0.97, 0.95, 1))
        绘制标题区 ()
        绘制标签栏 ()
        如果 (当前页 == 0)
        {
            绘制总览页 ()
        }
        如果 (当前页 == 1)
        {
            绘制图元变换页 ()
        }
        如果 (当前页 == 2)
        {
            绘制画刷位图页 ()
        }
        如果 (当前页 == 3)
        {
            绘制路径几何页 ()
        }
        如果 (当前页 == 4)
        {
            绘制文本页 ()
        }
        如果 (当前页 == 5)
        {
            绘制裁剪状态页 ()
        }
        如果 (当前页 == 6)
        {
            绘制组件页 ()
        }
        如果 (当前页 == 7)
        {
            绘制设计器组件页 ()
        }
        如果 (当前页 == 8)
        {
            绘制内存画板页 ()
        }
        如果 (当前页 == 9)
        {
            绘制兼容内存画板页 ()
        }
        如果 (当前页 == 10)
        {
            绘制高级能力页 ()
        }
        引擎.结束绘制 ()
    }

    方法 绘制标题区 <公开>
    {
        变量 标题画刷 <类型 = 通用指针>
        标题画刷 = 引擎.创建线性渐变画刷3色 (24, 82, 720, 82, 火山.D2D绘制引擎.D2D颜色.创建 (0.08, 0.22, 0.36, 1), 0.48, 火山.D2D绘制引擎.D2D颜色.创建 (0.11, 0.42, 0.55, 1), 火山.D2D绘制引擎.D2D颜色.创建 (0.23, 0.55, 0.32, 1))
        引擎.画刷填充圆角矩形 (标题画刷, 24, 76, 720, 128, 10, 10)
        引擎.释放对象 (标题画刷)
        引擎.绘制文本 ("Direct2D / DirectWrite / WIC 示例浏览器", 44, 86, 690, 118, 火山.D2D绘制引擎.D2D颜色.白色 (), "微软雅黑", 22, 火山.D2D绘制引擎.D2D字体粗细.半粗)
    }

    方法 绘制标签栏 <公开>
    {
        绘制标签 (0, "总览", 24, 88)
        绘制标签 (1, "图元", 88, 152)
        绘制标签 (2, "画刷", 152, 216)
        绘制标签 (3, "路径", 216, 280)
        绘制标签 (4, "文本", 280, 344)
        绘制标签 (5, "裁剪", 344, 408)
        绘制标签 (6, "组件", 408, 472)
        绘制标签 (7, "设计器", 472, 536)
        绘制标签 (8, "内存", 536, 600)
        绘制标签 (9, "兼容", 600, 664)
        绘制标签 (10, "高级", 664, 728)
    }

    方法 绘制标签 <公开>
    参数 索引 <类型 = 整数>
    参数 标题 <类型 = 文本型>
    参数 左 <类型 = 单精度小数>
    参数 右 <类型 = 单精度小数>
    {
        如果 (当前页 == 索引)
        {
            引擎.填充圆角矩形 (左 + 3, 24, 右 - 3, 62, 8, 8, 火山.D2D绘制引擎.D2D颜色.创建 (0.09, 0.35, 0.50, 1))
            引擎.绘制文本 (标题, 左 + 8, 33, 右 - 8, 56, 火山.D2D绘制引擎.D2D颜色.白色 (), "微软雅黑", 14, 火山.D2D绘制引擎.D2D字体粗细.半粗, 火山.D2D绘制引擎.D2D字体样式.正常, 火山.D2D绘制引擎.D2D文本对齐.居中)
            返回
        }
        引擎.填充圆角矩形 (左 + 3, 24, 右 - 3, 62, 8, 8, 火山.D2D绘制引擎.D2D颜色.创建 (1, 1, 1, 0.76))
        引擎.绘制圆角矩形 (左 + 3, 24, 右 - 3, 62, 8, 8, 火山.D2D绘制引擎.D2D颜色.创建 (0.68, 0.72, 0.70, 1), 1)
        引擎.绘制文本 (标题, 左 + 8, 33, 右 - 8, 56, 火山.D2D绘制引擎.D2D颜色.创建 (0.10, 0.14, 0.16, 1), "微软雅黑", 14, 火山.D2D绘制引擎.D2D字体粗细.常规, 火山.D2D绘制引擎.D2D字体样式.正常, 火山.D2D绘制引擎.D2D文本对齐.居中)
    }

    方法 绘制总览页 <公开>
    {
