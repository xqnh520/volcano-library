<火山程序 类型 = "通常" 版本 = 1 />

包 火山.mDNS工具库 <注释 = "mDNS/Bonjour DNS-SD wrapper. Copy mdns_toolkit to plugins\\vprj_win\\classlib\\user and reference mdns_toolkit.vgrp."
        @视窗.头文件搜寻目录 = "native"
        @视窗.外部头文件 = "native\\mdns_bridge.h"
        @视窗.外部库.x64 = "bin\\x64\\mdns_bridge.lib"
        @视窗.附属文件.x64 = "bin\\x64\\mdns_bridge.dll, bin\\x64\\dnssd.dll">

类 mDNS事件类型 <公开 折叠>
{
    变量 无事件 <公开 静态 类型 = 整数 值 = 0>
    变量 已注册 <公开 静态 类型 = 整数 值 = 1>
    变量 服务上线 <公开 静态 类型 = 整数 值 = 2>
    变量 服务下线 <公开 静态 类型 = 整数 值 = 3>
    变量 已解析 <公开 静态 类型 = 整数 值 = 4>
    变量 地址结果 <公开 静态 类型 = 整数 值 = 5>
    变量 错误 <公开 静态 类型 = 整数 值 = 100>
}

类 mDNS工具 <公开 折叠>
{
    变量 句柄 <类型 = 变整数>

    方法 创建 <公开 类型 = 逻辑型 注释 = "创建mDNS操作句柄.">
    {
        如果 (句柄 != 0)
        {
            返回 (真)
        }
        句柄 = 底层_创建 ()
        返回 (句柄 != 0)
    }

    方法 关闭 <公开 注释 = "关闭浏览和注册操作,保留对象句柄.">
    {
        如果 (句柄 != 0)
        {
            底层_关闭 (句柄)
        }
    }

    方法 销毁 <公开 注释 = "释放mDNS句柄,窗口销毁前应调用.">
    {
        如果 (句柄 != 0)
        {
            底层_销毁 (句柄)
            句柄 = 0
        }
    }

    方法 注册服务 <公开 类型 = 整数 注释 = "发布一个本机服务. 服务类型示例: _http._tcp, _workstation._tcp. TXT格式: key=value;key2=value2.">
    参数 名称 <类型 = 文本型>
    参数 服务类型 <类型 = 文本型>
    参数 端口 <类型 = 整数>
    参数 文本记录 <类型 = 文本型 @默认值 = "">
    参数 域名 <类型 = 文本型 @默认值 = "local.">
    参数 主机名 <类型 = 文本型 @默认值 = "">
    {
        如果 (句柄 == 0)
        {
            如果 (取反 (创建 ()))
            {
                返回 (-1)
            }
        }
        返回 (底层_注册服务 (句柄, 名称, 服务类型, 域名, 主机名, (短整数) 端口, 文本记录))
    }

    方法 浏览服务 <公开 类型 = 整数 注释 = "开始浏览指定服务类型. 服务类型示例: _http._tcp.">
    参数 服务类型 <类型 = 文本型>
    参数 域名 <类型 = 文本型 @默认值 = "local.">
    {
        如果 (句柄 == 0)
        {
            如果 (取反 (创建 ()))
            {
                返回 (-1)
            }
        }
        返回 (底层_浏览服务 (句柄, 服务类型, 域名))
    }

    方法 解析服务 <公开 类型 = 整数 注释 = "解析浏览结果里的服务.">
    参数 网卡索引 <类型 = 整数>
    参数 名称 <类型 = 文本型>
    参数 服务类型 <类型 = 文本型>
    参数 域名 <类型 = 文本型>
    {
        如果 (句柄 == 0)
        {
            返回 (-1)
        }
        返回 (底层_解析服务 (句柄, 网卡索引, 名称, 服务类型, 域名))
    }

    方法 轮询 <公开 类型 = 整数 注释 = "处理DNS-SD异步结果. 建议用时钟每100-300ms调用一次. 0表示成功; -65568表示本次无数据/超时.">
    参数 超时毫秒 <类型 = 整数 @默认值 = 0>
    {
        如果 (句柄 == 0)
        {
            返回 (-1)
        }
        返回 (底层_轮询 (句柄, 超时毫秒))
    }

    方法 取事件 <公开 类型 = 整数 注释 = "弹出一个事件并设为当前事件. 返回mDNS事件类型.无事件表示当前无事件.">
    {
        如果 (句柄 == 0)
        {
            返回 (mDNS事件类型.无事件)
        }
        返回 (底层_弹出事件 (句柄))
    }

    方法 当前事件文本 <公开 静态 类型 = 文本型>
    {
        返回 (底层_当前事件文本 ())
    }

    方法 错误文本 <公开 静态 类型 = 文本型>
    参数 错误码 <类型 = 整数>
    {
        返回 (底层_错误文本2 (错误码))
    }

    方法 最后错误 <公开 静态 类型 = 整数>
    {
        返回 (底层_最后错误 ())
    }

    方法 当前事件错误码 <公开 静态 类型 = 整数>
    {
        返回 (底层_当前事件错误码 ())
    }

    方法 当前事件网卡索引 <公开 静态 类型 = 整数>
    {
        返回 (底层_当前事件网卡索引 ())
    }

    方法 当前事件端口 <公开 静态 类型 = 整数>
    {
        返回 (底层_当前事件端口 ())
    }

    方法 当前事件名称 <公开 静态 类型 = 文本型>
    {
        返回 (底层_当前事件名称 ())
    }

    方法 当前事件服务类型 <公开 静态 类型 = 文本型>
    {
        返回 (底层_当前事件服务类型 ())
    }

    方法 当前事件域名 <公开 静态 类型 = 文本型>
    {
        返回 (底层_当前事件域名 ())
    }

    方法 当前事件主机名 <公开 静态 类型 = 文本型>
    {
        返回 (底层_当前事件主机名 ())
    }

    方法 当前事件地址 <公开 静态 类型 = 文本型>
    {
        返回 (底层_当前事件地址 ())
    }

    方法 当前事件文本记录 <公开 静态 类型 = 文本型>
    {
        返回 (底层_当前事件文本记录 ())
    }

    方法 底层_创建 <私有 静态 类型 = 变整数 @嵌入式方法 = "">
    {
        @ (intptr_t)mdns_create()
    }

    方法 底层_销毁 <私有 静态 @嵌入式方法 = "">
    参数 操作句柄 <类型 = 变整数>
    {
        @ mdns_destroy((MdnsHandle)(intptr_t)@<操作句柄>)
    }

    方法 底层_关闭 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    参数 操作句柄 <类型 = 变整数>
    {
        @ mdns_close((MdnsHandle)(intptr_t)@<操作句柄>)
    }

    方法 底层_轮询 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    参数 操作句柄 <类型 = 变整数>
    参数 超时毫秒 <类型 = 整数>
    {
        @ mdns_poll((MdnsHandle)(intptr_t)@<操作句柄>, @<超时毫秒>)
    }

    方法 底层_弹出事件 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    参数 操作句柄 <类型 = 变整数>
    {
        @ mdns_pop_event((MdnsHandle)(intptr_t)@<操作句柄>)
    }

    方法 底层_当前事件文本 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    {
        @ mdns_current_event_text()
    }

    方法 底层_错误文本2 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    参数 错误码 <类型 = 整数>
    {
        @ mdns_error_text_ptr(@<错误码>)
    }

    方法 底层_最后错误 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    {
        @ mdns_last_error()
    }

    方法 底层_当前事件错误码 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    {
        @ mdns_current_event_error()
    }

    方法 底层_当前事件网卡索引 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    {
        @ mdns_current_event_interface_index()
    }

    方法 底层_当前事件端口 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    {
        @ mdns_current_event_port()
    }

    方法 底层_当前事件名称 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    {
        @ mdns_current_event_name()
    }

    方法 底层_当前事件服务类型 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    {
        @ mdns_current_event_service_type()
    }

    方法 底层_当前事件域名 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    {
        @ mdns_current_event_domain()
    }

    方法 底层_当前事件主机名 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    {
        @ mdns_current_event_host()
    }

    方法 底层_当前事件地址 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    {
        @ mdns_current_event_address()
    }

    方法 底层_当前事件文本记录 <私有 静态 类型 = 文本型 @嵌入式方法 = "">
    {
        @ mdns_current_event_txt()
    }

    方法 底层_注册服务 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    参数 操作句柄 <类型 = 变整数>
    参数 名称 <类型 = 文本型>
    参数 服务类型 <类型 = 文本型>
    参数 域名 <类型 = 文本型>
    参数 主机名 <类型 = 文本型>
    参数 端口 <类型 = 短整数>
    参数 文本记录 <类型 = 文本型>
    {
        @ mdns_register_service((MdnsHandle)(intptr_t)@<操作句柄>, @<名称>.GetText(), @<服务类型>.GetText(), @<域名>.GetText(), @<主机名>.GetText(), (uint16_t)@<端口>, @<文本记录>.GetText())
    }

    方法 底层_浏览服务 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    参数 操作句柄 <类型 = 变整数>
    参数 服务类型 <类型 = 文本型>
    参数 域名 <类型 = 文本型>
    {
        @ mdns_browse_services((MdnsHandle)(intptr_t)@<操作句柄>, @<服务类型>.GetText(), @<域名>.GetText())
    }

    方法 底层_解析服务 <私有 静态 类型 = 整数 @嵌入式方法 = "">
    参数 操作句柄 <类型 = 变整数>
    参数 网卡索引 <类型 = 整数>
    参数 名称 <类型 = 文本型>
    参数 服务类型 <类型 = 文本型>
    参数 域名 <类型 = 文本型>
    {
        @ mdns_resolve_service((MdnsHandle)(intptr_t)@<操作句柄>, @<网卡索引>, @<名称>.GetText(), @<服务类型>.GetText(), @<域名>.GetText())
    }
}
