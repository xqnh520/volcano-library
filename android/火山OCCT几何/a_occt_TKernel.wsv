类 单位换算 <公开 注释 = "单位换算: 原类 Units (libTKernel, 头文件 Units/Units.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 此包提供创建与查询单位词典的全部设施, 以及操纵带单位实数值(量测值)的功能." @禁止创建对象 = 真>
{

    方法 单位文件 <公开 静态 注释 = "单位文件. 原方法: UnitsFile. 官方简介: 定义文件的位置, 该文件包含创建系统已知所有单位的字典所需的全部信息." @嵌入式方法 = "">
    参数 文件 <类型 = 文本型>
    {
        @ com.volcano.occt.Gen_TKernel.Units.UnitsFile (@<文件>)
    }

    方法 词典文件 <公开 静态 注释 = "词典文件. 原方法: LexiconFile. 官方简介: 定义包含词典的文件位置, 该词典用于操作复合单位." @嵌入式方法 = "">
    参数 文件 <类型 = 文本型>
    {
        @ com.volcano.occt.Gen_TKernel.Units.LexiconFile (@<文件>)
    }

    方法 取首个物理量 <公开 静态 类型 = 文本型 注释 = "取首个物理量. 原方法: FirstQuantity. 官方简介: 返回从单位 <aUnit> 找到的第一个物理量字符串." @嵌入式方法 = "">
    参数 单位 <类型 = 文本型>
    {
        @ com.volcano.occt.Gen_TKernel.Units.FirstQuantity (@<单位>)
    }

    方法 转换 <公开 静态 类型 = 小数 注释 = "转换. 原方法: Convert. 官方简介: 把以 <afirstunit> 表示的 <avalue> 转换为 <asecondunit>." @嵌入式方法 = "">
    参数 值 <类型 = 小数>
    参数 起始单位 <类型 = 文本型>
    参数 目标单位 <类型 = 文本型>
    {
        @ com.volcano.occt.Gen_TKernel.Units.Convert (@<值>, @<起始单位>, @<目标单位>)
    }

    方法 转SI <公开 静态 类型 = 小数 注释 = "转SI. 原方法: ToSI." @嵌入式方法 = "">
    参数 数据 <类型 = 小数>
    参数 单位 <类型 = 文本型>
    {
        @ com.volcano.occt.Gen_TKernel.Units.ToSI (@<数据>, @<单位>)
    }

    方法 起始SI <公开 静态 类型 = 小数 注释 = "起始SI. 原方法: FromSI." @嵌入式方法 = "">
    参数 数据 <类型 = 小数>
    参数 单位 <类型 = 文本型>
    {
        @ com.volcano.occt.Gen_TKernel.Units.FromSI (@<数据>, @<单位>)
    }

}
