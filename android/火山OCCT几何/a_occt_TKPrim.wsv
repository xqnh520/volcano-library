    参数 规范化 <类型 = 逻辑型>
    {
        @ com.volcano.occt.Gen_TKPrim.BRepPrimAPI_MakePrism.构造_2 (@<S>, @<D>, @<无穷>, @<复制>, @<规范化>)
    }

