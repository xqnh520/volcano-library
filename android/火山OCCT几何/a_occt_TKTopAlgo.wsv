    参数 输出重心 <类型 = 长整数>
    参数 输出惯量 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKTopAlgo.BRepGProp_Gauss.Compute_3 (@<对象>, @<输出曲面>, @<输出域>, @<位置>, @<极小值>, @<输出质量>, @<输出重心>, @<输出惯量>)
    }

}

