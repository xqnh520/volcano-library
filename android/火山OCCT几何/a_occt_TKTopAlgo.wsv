    {
        @ com.volcano.occt.Gen_TKTopAlgo.BRepExtrema_VertexInspector.SetTol (@<对象>, @<容差>)
    }

    方法 设置当前 <公开 静态 注释 = "设置当前. 原方法: SetCurrent. 官方简介: 设置用于搜索重合的当前点" @嵌入式方法 = "">
