    参数 U索引2 <类型 = 整数>
    参数 V索引1 <类型 = 整数>
    参数 V索引2 <类型 = 整数>
    参数 输出U首个索引 <类型 = "整数 []">
    参数 输出U末个索引 <类型 = "整数 []">
    参数 输出V首个索引 <类型 = "整数 []">
    参数 输出V末个索引 <类型 = "整数 []">
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_BSplineSurface.MovePoint (@<对象>, @<U>, @<V>, @<P>, @<U索引1>, @<U索引2>, @<V索引1>, @<V索引2>, @<输出U首个索引>, @<输出U末个索引>, @<输出V首个索引>, @<输出V末个索引>)
    }

    方法 是否U闭合 <公开 静态 类型 = 逻辑型 注释 = "是否U闭合. 原方法: IsUClosed. 官方简介: 若第一个控制点行与最后一个控制点行相同则返回 true. 容差判据是 gp 包的 Resolution." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
