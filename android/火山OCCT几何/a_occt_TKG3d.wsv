    {
        @ com.volcano.occt.Gen_TKG3d.Geom_ToroidalSurface.UReversedParameter (@<对象>, @<U>)
    }

    方法 V反转参数 <公开 静态 类型 = 小数 注释 = "V反转参数. 原方法: VReversedParameter. 官方简介: 返回 <me> 上参数为 U 的点在 U 反向曲面上的参数. 返回 2.PI - U." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
