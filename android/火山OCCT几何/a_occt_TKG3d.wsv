    {
        @ com.volcano.occt.Gen_TKG3d.Geom_BoundedCurve.DumpJson (@<对象>, @<深度>)
    }

}

类 有界曲面基类 <公开 注释 = "有界曲面基类: 原类 Geom_BoundedSurface (libTKG3d, 头文件 Geom/Geom_BoundedSurface.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 三维空间中有界曲面的根类. 有界曲面由其二维参数空间中的矩形定义, 即 - 其 u 参数, 取值范围在两个有限值 u0 与 u1 之间, 分别称为 \"第一 u 参数\" 和 \"最后 u 参数\", 以及 - 其 v 参数, 取值范围在两个有限值 v0 与 v1 之间, 分别称为 \"第一 v 参数\" 和 \"最后 v 参数\". 曲面由四条作为曲面边界的曲线限定: - 沿 u 参数方向的 u0 与 u1 等参数曲线, 以及 - 沿 v 参数方向的 v0 与 v1 等参数曲线. 有界曲面是有限的. 所有有界曲面的公共行为由 Geom_Surface 类描述. Geom 包提供有界曲面的三种具体实现: - Geom_BezierSurface, - Geom_BSplineSurface, 以及 - Geom_RectangularTrimmedSurface. 前两者实现复杂曲面的著名数学定义, 第三者使用四条等参数曲线裁剪曲面, 即把其参数变化限制在二维参数空间中的矩形内." @禁止创建对象 = 真>
{

}

类 笛卡尔点 <公开 注释 = "笛卡尔点: 原类 Geom_CartesianPoint (libTKG3d, 头文件 Geom/Geom_CartesianPoint.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 描述三维空间中的点. Geom_CartesianPoint 由 gp_Pnt 点定义, 具有 X, Y 和 Z 三个笛卡尔坐标." @禁止创建对象 = 真>
