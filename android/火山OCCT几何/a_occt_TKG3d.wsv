    }

    方法 设置位置 <公开 静态 注释 = "设置位置. 原方法: SetLocation. 官方简介: 修改直线的 \"Location\" 点(原点)." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Line.SetLocation (@<对象>, @<P>)
    }

    方法 设置位置_2 <公开 静态 注释 = "设置位置_2. 原方法: SetPosition. 官方简介: 修改 <me> 的 \"Location\" 与 \"Direction\"." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
