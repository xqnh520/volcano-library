    }

}

类 曲面基类 <公开 注释 = "曲面基类: 原类 Geom_Surface (libTKG3d, 头文件 Geom/Geom_Surface.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 描述三维空间中曲面的公共行为. Geom 包提供许多具体派生曲面的实现, 如平面, 圆柱, 圆锥, 球, 圆环, 线性拉伸曲面, 回转曲面, Bezier 与 B 样条曲面等. 这些曲面的关键特性是参数化. Geom_Surface 演示: - 如何用曲面的参数方程计算参数为 (u, v) 的点, 以及该点处的 1 阶, 2 阶...N 阶导数; - 如何查找曲面每个参数方向上的全局信息(例如连续级别, 曲面是否闭合, 周期性, 参数边界等); - 对曲面应用几何变换或修改朝向时参数如何变化." @禁止创建对象 = 真>
{

    方法 U反转副本 <公开 静态 类型 = 长整数 注释 = "U反转副本. 原方法: UReversed. 官方简介: 反转 <me> 的 U 参数化方向. 曲面的边界不被修改. 返回 <me> 的一个副本." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.UReversed (@<对象>)
    }

    方法 V反转副本 <公开 静态 类型 = 长整数 注释 = "V反转副本. 原方法: VReversed. 官方简介: 反转 <me> 的 V 参数化方向. 曲面的边界不被修改. 返回 <me> 的一个副本." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.VReversed (@<对象>)
    }

    方法 变换参数 <公开 静态 注释 = "变换参数. 原方法: TransformParameters. 官方简介: 计算 <me> 上参数 U,V 的点经变换后在变换曲面上的参数. @code me->Transformed(T)->Value(U',V') @endcode 与 @code me->Value(U,V).Transformed(T) @endcode 是同一个点, 其中 U',V' 是调用 @code me->TransformParameters(U,V,T) @endcode 后 U,V 的新值. 该方法不改变 <U> 与 <V>" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 输出U <类型 = "小数 []">
    参数 输出V <类型 = "小数 []">
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.TransformParameters (@<对象>, @<输出U>, @<输出V>, @<T>)
    }

    方法 参数化变换 <公开 静态 类型 = 长整数 注释 = "参数化变换. 原方法: ParametricTransformation. 官方简介: 返回用于求变换曲面上点的新的参数的 2d 变换. @code me->Transformed(T)->Value(U',V') @endcode 与 @code me->Value(U,V).Transformed(T) @endcode 是同一点, 其中 U',V' 是通过 @code me->ParametricTransformation(T) @endcode 返回的 2d 变换对 U,V 进行变换得到的. 该方法返回恒等变换." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.ParametricTransformation (@<对象>, @<T>)
    }

    方法 U周期 <公开 静态 类型 = 小数 注释 = "U周期. 原方法: UPeriod. 官方简介: 返回该曲面在 u 参数方向上的周期. 若曲面不是 u 周期的则抛出异常." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.UPeriod (@<对象>)
    }

    方法 V周期 <公开 静态 类型 = 小数 注释 = "V周期. 原方法: VPeriod. 官方简介: 返回该曲面在 v 参数方向上的周期. 若曲面不是 v 周期的则抛出异常." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.VPeriod (@<对象>)
    }

    方法 取值 <公开 静态 类型 = 长整数 注释 = "取值. 原方法: Value. 官方简介: 计算曲面上参数为 (U, V) 的点." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 V <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.Value (@<对象>, @<U>, @<V>)
    }

    方法 转储JSON <公开 静态 类型 = 文本型 注释 = "转储JSON. 原方法: DumpJson. 官方简介: 把自身内容转储到流中" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 深度 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_Surface.DumpJson (@<对象>, @<深度>)
    }

}

类 拉伸曲面 <公开 注释 = "拉伸曲面: 原类 Geom_SurfaceOfLinearExtrusion (libTKG3d, 头文件 Geom/Geom_SurfaceOfLinearExtrusion.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 描述线性拉伸曲面(\"拉伸曲面\"), 例如广义圆柱面. 此类曲面通过沿给定方向(称为 \"拉伸方向\", 由单位向量定义)扫掠一条曲线(称为 \"拉伸曲线\" 或 \"基线\")得到. u 参数沿拉伸曲线方向. v 参数沿拉伸方向. u 参数的参数范围由参考曲线定义. v 参数的参数范围为 ] - 无穷, + 无穷 [. 曲线的位置给出 v 参数的原点. 曲面沿 v 参数方向为 \"CN\" 连续的. 线性拉伸曲面的形式一般是直纹面(GeomAbs_RuledForm). 它可以是: - 圆柱面, 如果拉伸曲线是圆或裁剪圆, 且其轴平行于拉伸方向(GeomAbs_CylindricalForm), 或 - 平面, 如果拉伸曲线是直线(GeomAbs_PlanarForm). 注意: 拉伸曲面由原始基曲线的副本构造, 因此曲面被修改时原始曲线不受影响. 警告: 不检测退化曲面. 例如, 当拉伸曲线是直线且拉伸方向平行于该直线时, 会得到退化曲面." @禁止创建对象 = 真>
{

    方法 创建 <公开 静态 类型 = 长整数 注释 = "创建. 原构造器: Geom_SurfaceOfLinearExtrusion. 官方简介: V 是拉伸方向. C 是拉伸曲线. SurfaceOfLinearExtrusion 的形式可以是: . 直纹曲面(RuledForm), . 若拉伸曲线是圆或裁剪圆则为圆柱面(CylindricalForm), . 若拉伸曲线是直线则为平面(PlanarForm). 警告: 不检测退化曲面情形. 例如若曲线 C 是直线且 V 平行于该直线的方向." @嵌入式方法 = "">
    参数 C <类型 = 长整数>
    参数 V <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.构造 (@<C>, @<V>)
    }

    方法 设置方向 <公开 静态 注释 = "设置方向. 原方法: SetDirection. 官方简介: 把 V 赋为该线性拉伸曲面的 \"拉伸方向\"." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 V <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.SetDirection (@<对象>, @<V>)
    }

    方法 设置基曲线 <公开 静态 注释 = "设置基曲线. 原方法: SetBasisCurve. 官方简介: 通过重定义其 \"基础曲线\"(\"被拉伸的曲线\")来修改该线性拉伸曲面." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 C <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.SetBasisCurve (@<对象>, @<C>)
    }

    方法 U反转 <公开 静态 注释 = "U反转. 原方法: UReverse. 官方简介: 改变该线性拉伸曲面在 u 参数方向的朝向. 曲面的边界不改变, 但指定的参数方向被反转. 因此曲面的朝向被反转. 在线性拉伸曲面的情形: - UReverse 反转基础曲线, 且 - VReverse 反转线性拉伸的方向." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.UReverse (@<对象>)
    }

    方法 U反转参数 <公开 静态 类型 = 小数 注释 = "U反转参数. 原方法: UReversedParameter. 官方简介: 计算当反转该线性拉伸曲面的 u 参数方向时, 对于该曲面上 u 参数 U 的任意点, 在修改后曲面上的 u 参数. 对于拉伸曲面: - UReverseParameter 返回以 U 在基础曲线上调用函数 ReversedParameter 给出的反转参数," @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.UReversedParameter (@<对象>, @<U>)
    }

    方法 V反转 <公开 静态 注释 = "V反转. 原方法: VReverse. 官方简介: 改变该线性拉伸曲面在 v 参数方向的朝向. 曲面的边界不改变, 但指定的参数方向被反转. 因此曲面的朝向被反转. 在线性拉伸曲面的情形: - UReverse 反转基础曲线, 且 - VReverse 反转线性拉伸的方向." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.VReverse (@<对象>)
    }

    方法 V反转参数 <公开 静态 类型 = 小数 注释 = "V反转参数. 原方法: VReversedParameter. 官方简介: 计算在线性拉伸曲面上参数为 v 的任意点, 在反转其 v 参数方向时所得修改后曲面上的 v 参数. 对于拉伸曲面, VReverse 返回 -V." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 V <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.VReversedParameter (@<对象>, @<V>)
    }

    方法 取边界 <公开 静态 注释 = "取边界. 原方法: Bounds. 官方简介: 返回该线性拉伸曲面的参数边界 U1, U2, V1 和 V2. 线性拉伸曲面在 v 参数方向上是无限的, 因此: - V1 = Standard_Real::RealFirst() - V2 = Standard_Real::RealLast()." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 输出U1 <类型 = "小数 []">
    参数 输出U2 <类型 = "小数 []">
    参数 输出V1 <类型 = "小数 []">
    参数 输出V2 <类型 = "小数 []">
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.Bounds (@<对象>, @<输出U1>, @<输出U2>, @<输出V1>, @<输出V2>)
    }

    方法 是否U闭合 <公开 静态 类型 = 逻辑型 注释 = "是否U闭合. 原方法: IsUClosed. 官方简介: 若该线性拉伸曲面的 \"基础曲线\" 闭合, 则 IsUClosed 返回 true." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.IsUClosed (@<对象>)
    }

    方法 是否V闭合 <公开 静态 类型 = 逻辑型 注释 = "是否V闭合. 原方法: IsVClosed. 官方简介: IsVClosed 始终返回 false." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.IsVClosed (@<对象>)
    }

    方法 是否U向N阶连续 <公开 静态 类型 = 逻辑型 注释 = "是否U向N阶连续. 原方法: IsCNu. 官方简介: 若该线性拉伸面的 \"basis curve\" 的连续性阶数至少为 N, 则 IsCNu 返回 true. 若 N < 0 则抛出 RangeError." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 N <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.IsCNu (@<对象>, @<N>)
    }

    方法 是否V向N阶连续 <公开 静态 类型 = 逻辑型 注释 = "是否V向N阶连续. 原方法: IsCNv. 官方简介: IsCNv 始终返回 true." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 N <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.IsCNv (@<对象>, @<N>)
    }

    方法 是否U周期 <公开 静态 类型 = 逻辑型 注释 = "是否U周期. 原方法: IsUPeriodic. 官方简介: 若该线性拉伸曲面的 \"基础曲线\" 是周期的, 则 IsUPeriodic 返回 true." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.IsUPeriodic (@<对象>)
    }

    方法 是否V周期 <公开 静态 类型 = 逻辑型 注释 = "是否V周期. 原方法: IsVPeriodic. 官方简介: IsVPeriodic 始终返回 false." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.IsVPeriodic (@<对象>)
    }

    方法 U向等参线 <公开 静态 类型 = 长整数 注释 = "U向等参线. 原方法: UIso. 官方简介: 计算该线性拉伸曲面的 U 等参数曲线. 这是一条平行于拉伸方向, 且经过基准曲线参数 U 处的点的直线." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.UIso (@<对象>, @<U>)
    }

    方法 V向等参线 <公开 静态 类型 = 长整数 注释 = "V向等参线. 原方法: VIso. 官方简介: 计算该线性拉伸曲面的 V 等参数曲线. 该曲线通过把拉伸曲线沿拉伸方向平移量 V 得到." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 V <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.VIso (@<对象>, @<V>)
    }

    方法 取点 <公开 静态 注释 = "取点. 原方法: D0. 官方简介: 计算曲面上的点 P (U, V). 参数 U 是拉伸曲线上的参数. 参数化 V 是线性参数化, 其参数化方向为拉伸方向. 若点在拉伸曲线上, 则 V = 0.0." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 V <类型 = 小数>
    参数 输出P <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG3d.Geom_SurfaceOfLinearExtrusion.D0 (@<对象>, @<U>, @<V>, @<输出P>)
    }

    方法 取一阶导 <公开 静态 注释 = "取一阶导. 原方法: D1. 官方简介: 计算当前点以及 U 和 V 方向上的一阶导数. 若曲面的连续性不是 C1 则抛出 UndefinedDerivative." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 V <类型 = 小数>
    参数 输出P <类型 = 长整数>
