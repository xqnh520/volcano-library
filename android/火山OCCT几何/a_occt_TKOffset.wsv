    }

    方法 曲面上的误差 <公开 静态 类型 = 小数 注释 = "曲面上的误差. 原方法: ErrorOnSurface." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKOffset.BRepOffsetAPI_MakePipe.ErrorOnSurface (@<对象>)
    }

