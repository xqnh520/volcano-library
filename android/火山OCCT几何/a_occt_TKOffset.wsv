        @ com.volcano.occt.Gen_TKOffset.BRepOffsetAPI_MakeEvolved.构造_2 (@<脊线>, @<轮廓>, @<连接类型>, @<轮廓为轴>, @<是否实体>, @<轮廓在脊线上>, @<容差>, @<是否体积>, @<并行运行>)
    }

