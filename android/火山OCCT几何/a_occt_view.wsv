<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.OCCT几何 <注释 = "OpenCASCADE 三维观察组件: 把 几何内核 的网格化结果自绘成可旋转/缩放的视图">

类 三维观察框 <公开 基础类 = 自定义窗口组件 注释 = "★ 把 几何内核 所创建的形状画成可交互的三维视图."
        注释 = "绘制策略: 背面剔除 + 平面着色, 每个可见三角形一次绘制调用, 因只画正面故无需深度排序."
        注释 = "交互: 单指拖动旋转, 双指捏合缩放."
        @文档 = "category = \"窗口组件\""
        @安卓.窗口组件.布局配置 = "native_class = \"@安卓自定义窗口组件\"">
{
    # // 定义方法: 第1个参数等于类名,第2个参数为类名的英文名(自行随意提供),第3个参数不变.
    # @ @m<DEFINE_CONTROL2> (三维观察框, OcctView, @dt<安卓自定义窗口组件>)
    #
    # 公开方法 ---

    方法 装载形状 <公开 类型 = 逻辑型 注释 = "把所指定形状网格化并装入本组件, 成功后自动重绘."
            返回值注释 = "返回真表示装载成功, 返回假表示本地网格化失败.">
    参数 形状句柄 <类型 = 长整数 注释 = "几何内核.建长方体 / 建圆柱 / 布尔减 所返回的句柄.">
    参数 线性偏差 <类型 = 小数 注释 = "网格线性偏差, 越小越密. 演示用 0.5 量级." @默认值 = 0.5>
    {
        变量 计次 <类型 = 整数>
        变量 基址 <类型 = 整数>
        变量 总数 <类型 = 整数>

        成员_网格 = 几何内核.取三角形 (形状句柄, 线性偏差)
        成员_三角形数 = 0
        总数 = 取数组成员数 (成员_网格)
        如果 (总数 < 9)
        {
            重新绘制 ()
            返回 (假)
        }

        成员_三角形数 = 舍入到较小整数 (总数 / 9)

        成员_中心X = 0
        成员_中心Y = 0
        成员_中心Z = 0
        循环 (, 成员_三角形数, 计次)
        {
            基址 = 计次 * 9
            成员_中心X = 成员_中心X + 成员_网格 [基址] + 成员_网格 [基址 + 3] + 成员_网格 [基址 + 6]
            成员_中心Y = 成员_中心Y + 成员_网格 [基址 + 1] + 成员_网格 [基址 + 4] + 成员_网格 [基址 + 7]
            成员_中心Z = 成员_中心Z + 成员_网格 [基址 + 2] + 成员_网格 [基址 + 5] + 成员_网格 [基址 + 8]
        }
        成员_中心X = 成员_中心X / 总数
        成员_中心Y = 成员_中心Y / 总数
        成员_中心Z = 成员_中心Z / 总数

        成员_模型半径 = 取外接半径 ()
        成员_法向系数 = 取法向系数 ()
        重新绘制 ()
        返回 (真)
    }

    方法 复位视角 <公开 注释 = "恢复默认的旋转角度与缩放倍率.">
    {
        成员_偏航 = 0.7
        成员_俯仰 = 0.35
        成员_缩放 = 1
        重新绘制 ()
    }

    方法 取三角形数 <公开 类型 = 整数 注释 = "返回当前已装载的三角形数目, 0 表示还没有装载任何形状.">
    {
        返回 (成员_三角形数)
    }

    # 变量成员 ---

    变量 成员_网格 <类型 = "单精度小数 []" 注释 = "几何内核.取三角形 返回的非索引三角形顶点, 每 9 个成员一个三角形.">
    变量 成员_三角形数 <类型 = 整数 注释 = "当前三角形数目.">
    变量 成员_中心X <类型 = 小数>
    变量 成员_中心Y <类型 = 小数>
    变量 成员_中心Z <类型 = 小数>
    变量 成员_模型半径 <类型 = 小数 值 = 1 注释 = "以模型中心为原点的最大顶点半径, 用作缩放基准.">
    变量 成员_法向系数 <类型 = 小数 值 = 1 注释 = "1 表示本地网格的三角形缠绕给出外法线, -1 表示给出内法线.">
    变量 成员_偏航 <类型 = 小数 值 = 0.7 注释 = "绕 Z 轴转角, 弧度.">
    变量 成员_俯仰 <类型 = 小数 值 = 0.35 注释 = "绕 X 轴转角, 弧度.">
    变量 成员_缩放 <类型 = 小数 值 = 1>
    变量 成员_画笔对象 <类型 = 画笔类 反锯齿 = 真 注释 = "自绘用画笔, 每画一个三角形前按其亮度改一次颜色.">
    变量 成员_顶点数组 <参考 类型 = 浮点小数数组 注释 = "复用的 6 成员顶点数组(3 顶点 x 横/纵), 每次画一个三角形.">
    变量 成员_按下横 <类型 = 小数>
    变量 成员_按下纵 <类型 = 小数>
    变量 成员_按下偏航 <类型 = 小数>
    变量 成员_按下俯仰 <类型 = 小数>
    变量 成员_双指中 <类型 = 逻辑型 注释 = "真表示当前处于两指捏合缩放过程中.">
    变量 成员_起始间距 <类型 = 小数>
    变量 成员_起始缩放 <类型 = 小数>

    # 内部方法 ---

    方法 取外接半径 <类型 = 小数 注释 = "求所有顶点到模型中心的最大距离.">
    {
        变量 结果 <类型 = 小数>
        变量 顶点数 <类型 = 整数>
        变量 计次 <类型 = 整数>
        变量 横 <类型 = 小数>
        变量 纵 <类型 = 小数>
        变量 高 <类型 = 小数>

        结果 = 0.001
        顶点数 = 成员_三角形数 * 3
        循环 (, 顶点数, 计次)
        {
            横 = 成员_网格 [计次 * 3] - 成员_中心X
            纵 = 成员_网格 [计次 * 3 + 1] - 成员_中心Y
            高 = 成员_网格 [计次 * 3 + 2] - 成员_中心Z
            横 = 求平方根 (横 * 横 + 纵 * 纵 + 高 * 高)
            如果 (横 > 结果)
            {
                结果 = 横
            }
        }
        返回 (结果)
    }

    方法 取法向系数 <类型 = 小数 注释 = "判定三角形缠绕给出的是外法线还是内法线."
            注释 = "闭合网格的各面法线与面心点积之和为正时, 说明法线朝外, 故由网格数据自身定符号,"
            注释 = "不把剔除方向写死在源码里(本地网格的缠绕约定随 OCCT 版本而变).">
    {
        变量 结果 <类型 = 小数>
        变量 累计 <类型 = 小数>
        变量 计次 <类型 = 整数>
        变量 基址 <类型 = 整数>
        变量 甲x <类型 = 小数>
        变量 甲y <类型 = 小数>
        变量 甲z <类型 = 小数>
        变量 乙x <类型 = 小数>
        变量 乙y <类型 = 小数>
        变量 乙z <类型 = 小数>
        变量 丙x <类型 = 小数>
        变量 丙y <类型 = 小数>
        变量 丙z <类型 = 小数>
        变量 法x <类型 = 小数>
        变量 法y <类型 = 小数>
        变量 法z <类型 = 小数>

        累计 = 0
        循环 (, 成员_三角形数, 计次)
        {
            基址 = 计次 * 9
            甲x = 成员_网格 [基址] - 成员_中心X
            甲y = 成员_网格 [基址 + 1] - 成员_中心Y
            甲z = 成员_网格 [基址 + 2] - 成员_中心Z
            乙x = 成员_网格 [基址 + 3] - 成员_中心X
            乙y = 成员_网格 [基址 + 4] - 成员_中心Y
            乙z = 成员_网格 [基址 + 5] - 成员_中心Z
            丙x = 成员_网格 [基址 + 6] - 成员_中心X
            丙y = 成员_网格 [基址 + 7] - 成员_中心Y
            丙z = 成员_网格 [基址 + 8] - 成员_中心Z

            法x = (乙y - 甲y) * (丙z - 甲z) - (乙z - 甲z) * (丙y - 甲y)
            法y = (乙z - 甲z) * (丙x - 甲x) - (乙x - 甲x) * (丙z - 甲z)
            法z = (乙x - 甲x) * (丙y - 甲y) - (乙y - 甲y) * (丙x - 甲x)
            累计 = 累计 + 法x * (甲x + 乙x + 丙x) + 法y * (甲y + 乙y + 丙y) + 法z * (甲z + 乙z + 丙z)
        }

        结果 = 1
        如果 (累计 <= 0)
        {
            结果 = 0 - 结果
        }
        返回 (结果)
    }

    方法 取两指间距 <类型 = 小数>
    参数 触摸动作事件 <类型 = 动作事件类>
    {
        变量 横 <类型 = 小数>
        变量 纵 <类型 = 小数>

        横 = 触摸动作事件.取横坐标 (0) - 触摸动作事件.取横坐标 (1)
        纵 = 触摸动作事件.取纵坐标 (0) - 触摸动作事件.取纵坐标 (1)
        返回 (求平方根 (横 * 横 + 纵 * 纵))
    }

    方法 通知_测量内容尺寸 <公开 @虚拟方法 = 可覆盖>
    参数 需要测量内容宽度 <类型 = 逻辑型>
    参数 需要测量内容高度 <类型 = 逻辑型>
    参数 结果尺寸 <类型 = 尺寸类>
    {
        如果 (需要测量内容宽度)
        {
            结果尺寸.宽度 = DP到像素2 (240)
        }
        如果 (需要测量内容高度)
        {
            结果尺寸.高度 = DP到像素2 (180)
        }
    }

    方法 通知_绘制内容 <公开 @虚拟方法 = 可覆盖>
    参数 画板对象 <类型 = 画板类>
    {
        变量 计次 <类型 = 整数>
        变量 基址 <类型 = 整数>
        变量 中心横 <类型 = 小数>
        变量 中心纵 <类型 = 小数>
        变量 比例 <类型 = 小数>
        变量 半径 <类型 = 小数>
        变量 正A <类型 = 小数>
        变量 余A <类型 = 小数>
        变量 正B <类型 = 小数>
        变量 余B <类型 = 小数>
        变量 甲x <类型 = 小数>
        变量 甲y <类型 = 小数>
        变量 甲z <类型 = 小数>
        变量 乙x <类型 = 小数>
        变量 乙y <类型 = 小数>
        变量 乙z <类型 = 小数>
        变量 丙x <类型 = 小数>
        变量 丙y <类型 = 小数>
        变量 丙z <类型 = 小数>
        变量 法x <类型 = 小数>
        变量 法y <类型 = 小数>
        变量 法z <类型 = 小数>
        变量 长度 <类型 = 小数>
        变量 亮度 <类型 = 小数>
        变量 灰度 <类型 = 整数>

        如果 (成员_三角形数 > 0)
        {
            如果 (成员_顶点数组 == 空对象)
            {
                成员_顶点数组 = 浮点小数数组.创建 (6)
            }
            半径 = 成员_模型半径
            如果 (半径 < 0.001)
            {
                半径 = 0.001
            }
            中心横 = (小数)取宽度 () / 2
            中心纵 = (小数)取高度 () / 2
            比例 = 中心横
            如果 (中心纵 < 比例)
            {
                比例 = 中心纵
            }
            比例 = 比例 * 0.85 / 半径 * 成员_缩放
            正A = 求正弦 (成员_偏航)
            余A = 求余弦 (成员_偏航)
            正B = 求正弦 (成员_俯仰)
            余B = 求余弦 (成员_俯仰)

            循环 (, 成员_三角形数, 计次)
            {
                基址 = 计次 * 9
                // 先绕 Z(偏航)再绕 X(俯仰); 屏幕纵轴向下, 故投影时取负的旋转后纵坐标.
                甲x = 成员_网格 [基址] - 成员_中心X
                甲y = 成员_网格 [基址 + 1] - 成员_中心Y
                甲z = 成员_网格 [基址 + 2] - 成员_中心Z
                长度 = 甲x * 余A - 甲y * 正A
                甲y = 甲x * 正A + 甲y * 余A
                甲x = 长度
                长度 = 甲y * 余B - 甲z * 正B
                甲z = 甲y * 正B + 甲z * 余B
                甲y = 长度

                乙x = 成员_网格 [基址 + 3] - 成员_中心X
                乙y = 成员_网格 [基址 + 4] - 成员_中心Y
                乙z = 成员_网格 [基址 + 5] - 成员_中心Z
                长度 = 乙x * 余A - 乙y * 正A
                乙y = 乙x * 正A + 乙y * 余A
                乙x = 长度
                长度 = 乙y * 余B - 乙z * 正B
                乙z = 乙y * 正B + 乙z * 余B
                乙y = 长度

                丙x = 成员_网格 [基址 + 6] - 成员_中心X
                丙y = 成员_网格 [基址 + 7] - 成员_中心Y
                丙z = 成员_网格 [基址 + 8] - 成员_中心Z
                长度 = 丙x * 余A - 丙y * 正A
                丙y = 丙x * 正A + 丙y * 余A
                丙x = 长度
                长度 = 丙y * 余B - 丙z * 正B
                丙z = 丙y * 正B + 丙z * 余B
                丙y = 长度

                法x = (乙y - 甲y) * (丙z - 甲z) - (乙z - 甲z) * (丙y - 甲y)
                法y = (乙z - 甲z) * (丙x - 甲x) - (乙x - 甲x) * (丙z - 甲z)
                法z = (乙x - 甲x) * (丙y - 甲y) - (乙y - 甲y) * (丙x - 甲x)
                // 统一成外法线: z > 0 即朝向观察者(观察点位于 +Z 方向的无穷远).
                法x = 法x * 成员_法向系数
                法y = 法y * 成员_法向系数
                法z = 法z * 成员_法向系数
                如果 (法z > 0)
                {
                    长度 = 求平方根 (法x * 法x + 法y * 法y + 法z * 法z)
                    如果 (长度 < 0.000001)
                    {
                        亮度 = 0
                    }
                    否则
                    {
                        // 固定方向光 (0.35, 0.35, 0.87), 已归一化.
                        亮度 = (法x * 0.35 + 法y * 0.35 + 法z * 0.87) / 长度
                        如果 (亮度 < 0)
                        {
                            亮度 = 0
                        }
                    }
                    灰度 = 舍入到较小整数 (55 + 185 * 亮度)
                    // ARGB 高位 alpha 必须写成 -16777216(即 0xFF000000 的有符号形态),
                    // 漏掉这一项时透明度为 0, 画出来什么都看不见.
                    成员_画笔对象.颜色 = -16777216 + 灰度 * 65536 + 灰度 * 256 + 灰度

                    成员_顶点数组.置成员 (0, 中心横 + 甲x * 比例)
                    成员_顶点数组.置成员 (1, 中心纵 - 甲y * 比例)
                    成员_顶点数组.置成员 (2, 中心横 + 乙x * 比例)
                    成员_顶点数组.置成员 (3, 中心纵 - 乙y * 比例)
                    成员_顶点数组.置成员 (4, 中心横 + 丙x * 比例)
                    成员_顶点数组.置成员 (5, 中心纵 - 丙y * 比例)
                    // 后三组数组全部传空对象时, "被索引三角形数目"必须传 0 而不是 -1:
                    // 生成物在 -1 分支无条件读该数组的 length, 空对象会直接 NPE.
                    画板对象.绘制平面模型 (三角形记录格式.顺序, 成员_顶点数组, 0, 3, 空对象, 0, 空对象, 0, 空对象, 0, 0, 成员_画笔对象)
                }
            }
        }
    }

    方法 通知_被触摸 <公开 类型 = 逻辑型 注释 = "单指拖动旋转, 双指捏合缩放." @虚拟方法 = 可覆盖>
    参数 触摸动作事件 <类型 = 动作事件类>
    {
        变量 当前横 <类型 = 小数>
        变量 当前纵 <类型 = 小数>
        变量 间距 <类型 = 小数>

        如果 (触摸动作事件.触点数量 >= 2)
        {
            如果 (触摸动作事件.动作 == 动作类型.多点按下 || 取反 (成员_双指中))
            {
                成员_双指中 = 真
                成员_起始间距 = 取两指间距 (触摸动作事件)
                成员_起始缩放 = 成员_缩放
            }
            否则
            {
                如果 (成员_起始间距 > 0.001)
                {
                    间距 = 取两指间距 (触摸动作事件)
                    如果 (间距 > 0.001)
                    {
                        成员_缩放 = 成员_起始缩放 * (间距 / 成员_起始间距)
                        如果 (成员_缩放 < 0.1)
                        {
                            成员_缩放 = 0.1
                        }
                        如果 (成员_缩放 > 8)
                        {
                            成员_缩放 = 8
                        }
                        重新绘制 ()
                    }
                }
            }
        }
        否则
        {
            成员_双指中 = 假
            如果 (触摸动作事件.动作 == 动作类型.按下)
            {
                成员_按下横 = 触摸动作事件.取横坐标 (0)
                成员_按下纵 = 触摸动作事件.取纵坐标 (0)
                成员_按下偏航 = 成员_偏航
                成员_按下俯仰 = 成员_俯仰
            }
            否则 (触摸动作事件.动作 == 动作类型.移动)
            {
                当前横 = 触摸动作事件.取横坐标 (0)
                当前纵 = 触摸动作事件.取纵坐标 (0)
                成员_偏航 = 成员_按下偏航 + (当前横 - 成员_按下横) * 0.012
                成员_俯仰 = 成员_按下俯仰 + (当前纵 - 成员_按下纵) * 0.012
                重新绘制 ()
            }
        }
        返回 (真)
    }
}
