<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.OCCT几何 <注释 = "二维观察组件: 把 DXF文件 读入的实体表自绘成可平移/缩放的二维视图">

类 二维观察框 <公开 基础类 = 自定义窗口组件 注释 = "★ 把 DXF文件 读入的二维实体表 (线/圆/弧/多段线/点) 画成可交互的二维视图."
        注释 = "绘制策略: 全部实体统一离散为线段, 每帧一次 画板类.画一批直线2 批量绘制; 圆/弧按整圆 64 段离散, 点画小十字."
        注释 = "交互: 单指拖动平移, 双指捏合缩放; 缩放倍率钳制在自适应视图基准的 0.02~50 倍."
        @文档 = "category = \"窗口组件\""
        @安卓.窗口组件.布局配置 = "native_class = \"@安卓自定义窗口组件\"">
{
    # // 定义方法: 第1个参数等于类名,第2个参数为类名的英文名(自行随意提供),第3个参数不变.
    # @ @m<DEFINE_CONTROL2> (二维观察框, Cad2dView, @dt<安卓自定义窗口组件>)
    #
    # 公开方法 ---

    方法 装载实体 <公开 类型 = 逻辑型 注释 = "把 DXF文件 读入的实体表装入本组件, 成功后自动适应视图并重绘."
            返回值注释 = "返回真表示装载成功; 返回假表示实体表为空或格式不符 (解析原因见 DXF文件.取错误).">
    参数 实体表 <类型 = "小数 []" 注释 = "DXF文件.读入文件 / 读入文本 / 取示例表 所返回的实体表.">
    {
        成员_实体表 = 实体表
        成员_实体数 = 0
        成员_线数 = 0
        成员_圆数 = 0
        成员_弧数 = 0
        成员_多段线数 = 0
        成员_点数 = 0
        取实体计数 ()
        如果 (成员_实体数 <= 0)
        {
            重新绘制 ()
            返回 (假)
        }
        取包围盒 ()
        计算段容量 ()
        适应视图 ()
        返回 (真)
    }

    方法 适应视图 <公开 注释 = "按全部实体的包围盒把内容缩放到视口中央 (85% 幅面), 并以此缩放倍率作为缩放上下限基准.">
    {
        变量 幅宽 <类型 = 小数>
        变量 幅高 <类型 = 小数>
        变量 视宽 <类型 = 小数>
        变量 视高 <类型 = 小数>
        变量 基准 <类型 = 小数>

        成员_视图中心X = (成员_最小X + 成员_最大X) / 2
        成员_视图中心Y = (成员_最小Y + 成员_最大Y) / 2
        幅宽 = 成员_最大X - 成员_最小X
        幅高 = 成员_最大Y - 成员_最小Y
        视宽 = (小数)取宽度 ()
        视高 = (小数)取高度 ()
        如果 (视宽 <= 0 || 视高 <= 0)
        {
            视宽 = DP到像素2 (240)
            视高 = DP到像素2 (180)
        }
        基准 = 幅宽
        如果 (幅高 > 基准)
        {
            基准 = 幅高
        }
        如果 (基准 < 0.000001)
        {
            成员_适应缩放 = 1
        }
        否则
        {
            成员_适应缩放 = 视宽
            如果 (视高 < 成员_适应缩放)
            {
                成员_适应缩放 = 视高
            }
            成员_适应缩放 = 成员_适应缩放 * 0.85 / 基准
        }
        成员_缩放 = 成员_适应缩放
        重新绘制 ()
    }

    方法 置缩放 <公开 注释 = "设置绝对缩放倍率 (像素/世界单位), 自动钳制到自适应基准的 0.02~50 倍.">
    参数 新缩放 <类型 = 小数>
    {
        成员_缩放 = 钳制缩放 (新缩放)
        重新绘制 ()
    }

    方法 取缩放 <公开 类型 = 小数 注释 = "返回当前缩放倍率 (像素/世界单位), 0 表示尚未成功装载.">
    {
        返回 (成员_缩放)
    }

    方法 取实体总数 <公开 类型 = 整数 注释 = "返回当前实体表内的实体总数, 0 表示尚未装载.">
    {
        返回 (成员_实体数)
    }

    方法 取分类计数 <公开 类型 = 整数 注释 = "按实体型别统计个数.">
    参数 型别 <类型 = 整数 注释 = "1=线, 2=圆, 3=弧, 4=多段线, 5=点; 其它值返回 0.">
    {
        如果 (型别 == 1)
        {
            返回 (成员_线数)
        }
        否则 (型别 == 2)
        {
            返回 (成员_圆数)
        }
        否则 (型别 == 3)
        {
            返回 (成员_弧数)
        }
        否则 (型别 == 4)
        {
            返回 (成员_多段线数)
        }
        否则 (型别 == 5)
        {
            返回 (成员_点数)
        }
        返回 (0)
    }

    # 变量成员 ---

    变量 成员_实体表 <类型 = "小数 []" 注释 = "DXF文件 返回的扁平化实体表 (协议见 DXF文件 类注释).">
    变量 成员_实体数 <类型 = 整数 注释 = "当前实体表内实体总数.">
    变量 成员_线数 <类型 = 整数>
    变量 成员_圆数 <类型 = 整数>
    变量 成员_弧数 <类型 = 整数>
    变量 成员_多段线数 <类型 = 整数>
    变量 成员_点数 <类型 = 整数>
    变量 成员_最小X <类型 = 小数 注释 = "全部实体在世界坐标系中的包围盒.">
    变量 成员_最小Y <类型 = 小数>
    变量 成员_最大X <类型 = 小数>
    变量 成员_最大Y <类型 = 小数>
    变量 成员_视图中心X <类型 = 小数 注释 = "视口中心对应的世界坐标.">
    变量 成员_视图中心Y <类型 = 小数>
    变量 成员_缩放 <类型 = 小数 注释 = "像素/世界单位; 装载成功后等于 成员_适应缩放.">
    变量 成员_适应缩放 <类型 = 小数 值 = 1 注释 = "自适应视图时的缩放倍率, 用作缩放上下限基准.">
    变量 成员_屏幕数组 <参考 类型 = 浮点小数数组 注释 = "装载时按线段总数一次性创建, 绘制时复用, 每 4 个成员一条线段.">
    变量 成员_写指针 <类型 = 整数 注释 = "绘制时 成员_屏幕数组 的当前写入位置 (成员索引).">
    变量 成员_数组容量 <类型 = 整数 注释 = "成员_屏幕数组 的成员个数, 装载时随数组一并确定 (数组类无法用 取数组成员数 求长度).">
    变量 成员_中心横像素 <类型 = 小数 注释 = "绘制时视口中心 (像素坐标).">
    变量 成员_中心纵像素 <类型 = 小数>
    变量 成员_画笔对象 <类型 = 画笔类 反锯齿 = 真 注释 = "自绘用画笔.">
    变量 成员_按下横 <类型 = 小数>
    变量 成员_按下纵 <类型 = 小数>
    变量 成员_按下中心X <类型 = 小数>
    变量 成员_按下中心Y <类型 = 小数>
    变量 成员_双指中 <类型 = 逻辑型 注释 = "真表示当前处于两指捏合缩放过程中.">
    变量 成员_起始间距 <类型 = 小数>
    变量 成员_起始缩放 <类型 = 小数>

    # 内部方法 ---

    方法 取实体计数 <注释 = "扫描实体表统计实体总数与五类个数; 结构不完整时只统计能完整走完的实体.">
    {
        变量 表长 <类型 = 整数>
        变量 总数 <类型 = 整数>
        变量 下标 <类型 = 整数>
        变量 计次 <类型 = 整数>
        变量 型别 <类型 = 整数>
        变量 数据数 <类型 = 整数>

        成员_实体数 = 0
        成员_线数 = 0
        成员_圆数 = 0
        成员_弧数 = 0
        成员_多段线数 = 0
        成员_点数 = 0
        如果 (成员_实体表 == 空对象)
        {
            返回
        }
        表长 = 取数组成员数 (成员_实体表)
        如果 (表长 < 2)
        {
            返回
        }
        总数 = 舍入到较小整数 (成员_实体表 [0])
        下标 = 1
        循环 (, 总数, 计次)
        {
            如果 (下标 + 1 >= 表长)
            {
                跳出循环
            }
            型别 = 舍入到较小整数 (成员_实体表 [下标])
            数据数 = 舍入到较小整数 (成员_实体表 [下标 + 1])
            如果 (下标 + 2 + 数据数 > 表长)
            {
                跳出循环
            }
            成员_实体数 = 成员_实体数 + 1
            如果 (型别 == 1)
            {
                成员_线数 = 成员_线数 + 1
            }
            否则 (型别 == 2)
            {
                成员_圆数 = 成员_圆数 + 1
            }
            否则 (型别 == 3)
            {
                成员_弧数 = 成员_弧数 + 1
            }
            否则 (型别 == 4)
            {
                成员_多段线数 = 成员_多段线数 + 1
            }
            否则 (型别 == 5)
            {
                成员_点数 = 成员_点数 + 1
            }
            下标 = 下标 + 2 + 数据数
        }
    }

    方法 取包围盒 <注释 = "扫描实体表计算世界坐标包围盒; 圆弧按两端点加象限穿越点精确拓展.">
    {
        变量 表长 <类型 = 整数>
        变量 下标 <类型 = 整数>
        变量 计次 <类型 = 整数>
        变量 型别 <类型 = 整数>
        变量 数据数 <类型 = 整数>
        变量 顶点数 <类型 = 整数>
        变量 计点 <类型 = 整数>
        变量 圆心横 <类型 = 小数>
        变量 圆心纵 <类型 = 小数>
        变量 半径 <类型 = 小数>
        变量 起始角 <类型 = 小数>
        变量 扫过 <类型 = 小数>
        变量 象限角 <类型 = 小数>
        变量 偏角 <类型 = 小数>
        变量 角系数 <类型 = 小数>

        成员_最小X = 1000000000000000000.0
        成员_最小Y = 1000000000000000000.0
        成员_最大X = 0 - 1000000000000000000.0
        成员_最大Y = 0 - 1000000000000000000.0
        表长 = 取数组成员数 (成员_实体表)
        角系数 = 数学运算类.PI / 180
        下标 = 1
        循环 (, 成员_实体数, 计次)
        {
            如果 (下标 + 1 >= 表长)
            {
                跳出循环
            }
            型别 = 舍入到较小整数 (成员_实体表 [下标])
            数据数 = 舍入到较小整数 (成员_实体表 [下标 + 1])
            如果 (下标 + 2 + 数据数 > 表长)
            {
                跳出循环
            }
            如果 (型别 == 1)
            {
                扩展包围盒 (成员_实体表 [下标 + 2], 成员_实体表 [下标 + 3])
                扩展包围盒 (成员_实体表 [下标 + 4], 成员_实体表 [下标 + 5])
            }
            否则 (型别 == 2)
            {
                圆心横 = 成员_实体表 [下标 + 2]
                圆心纵 = 成员_实体表 [下标 + 3]
                半径 = 成员_实体表 [下标 + 4]
                扩展包围盒 (圆心横 - 半径, 圆心纵 - 半径)
                扩展包围盒 (圆心横 + 半径, 圆心纵 + 半径)
            }
            否则 (型别 == 3)
            {
                圆心横 = 成员_实体表 [下标 + 2]
                圆心纵 = 成员_实体表 [下标 + 3]
                半径 = 成员_实体表 [下标 + 4]
                起始角 = 成员_实体表 [下标 + 5]
                扫过 = 成员_实体表 [下标 + 6] - 起始角
                如果 (扫过 <= 0)
                {
                    扫过 = 扫过 + 360
                }
                如果 (扫过 > 360)
                {
                    扫过 = 360
                }
                扩展包围盒 (圆心横 + 半径 * 求余弦 (起始角 * 角系数), 圆心纵 + 半径 * 求正弦 (起始角 * 角系数))
                扩展包围盒 (圆心横 + 半径 * 求余弦 ((起始角 + 扫过) * 角系数), 圆心纵 + 半径 * 求正弦 ((起始角 + 扫过) * 角系数))
                循环 (, 4, 计点)
                {
                    象限角 = 计点 * 90
                    偏角 = 象限角 - 起始角
                    偏角 = 偏角 - 360 * 舍入到较小整数 (偏角 / 360)
                    如果 (偏角 <= 扫过 + 0.0001)
                    {
                        扩展包围盒 (圆心横 + 半径 * 求余弦 (象限角 * 角系数), 圆心纵 + 半径 * 求正弦 (象限角 * 角系数))
                    }
                }
            }
            否则 (型别 == 4)
            {
                顶点数 = 舍入到较小整数 (成员_实体表 [下标 + 3])
                循环 (, 顶点数, 计点)
                {
                    如果 (下标 + 5 + 计点 * 2 >= 表长)
                    {
                        跳出循环
                    }
                    扩展包围盒 (成员_实体表 [下标 + 4 + 计点 * 2], 成员_实体表 [下标 + 4 + 计点 * 2 + 1])
                }
            }
            否则 (型别 == 5)
            {
                扩展包围盒 (成员_实体表 [下标 + 2], 成员_实体表 [下标 + 3])
            }
            下标 = 下标 + 2 + 数据数
        }
        如果 (成员_最大X < 成员_最小X)
        {
            成员_最小X = 0
            成员_最小Y = 0
            成员_最大X = 0
            成员_最大Y = 0
        }
    }

    方法 扩展包围盒 <注释 = "用世界坐标点扩展包围盒.">
    参数 横 <类型 = 小数>
    参数 纵 <类型 = 小数>
    {
        如果 (横 < 成员_最小X)
        {
            成员_最小X = 横
        }
        如果 (横 > 成员_最大X)
        {
            成员_最大X = 横
        }
        如果 (纵 < 成员_最小Y)
        {
            成员_最小Y = 纵
        }
        如果 (纵 > 成员_最大Y)
        {
            成员_最大Y = 纵
        }
    }

    方法 计算段容量 <注释 = "统计全部实体离散后的线段总数, 并一次性创建容量足够的屏幕坐标数组 (每条线段 4 个坐标).">
    {
        变量 表长 <类型 = 整数>
        变量 下标 <类型 = 整数>
        变量 计次 <类型 = 整数>
        变量 型别 <类型 = 整数>
        变量 数据数 <类型 = 整数>
        变量 顶点数 <类型 = 整数>
        变量 闭合标志 <类型 = 整数>
        变量 扫过 <类型 = 小数>
        变量 段数 <类型 = 整数>

        段数 = 0
        表长 = 取数组成员数 (成员_实体表)
        下标 = 1
        循环 (, 成员_实体数, 计次)
        {
            如果 (下标 + 1 >= 表长)
            {
                跳出循环
            }
            型别 = 舍入到较小整数 (成员_实体表 [下标])
            数据数 = 舍入到较小整数 (成员_实体表 [下标 + 1])
            如果 (下标 + 2 + 数据数 > 表长)
            {
                跳出循环
            }
            如果 (型别 == 1)
            {
                段数 = 段数 + 1
            }
            否则 (型别 == 2)
            {
                段数 = 段数 + 取弧段数 (360)
            }
            否则 (型别 == 3)
            {
                扫过 = 成员_实体表 [下标 + 6] - 成员_实体表 [下标 + 5]
                如果 (扫过 <= 0)
                {
                    扫过 = 扫过 + 360
                }
                如果 (扫过 > 360)
                {
                    扫过 = 360
                }
                段数 = 段数 + 取弧段数 (扫过)
            }
            否则 (型别 == 4)
            {
                顶点数 = 舍入到较小整数 (成员_实体表 [下标 + 3])
                闭合标志 = 舍入到较小整数 (成员_实体表 [下标 + 2])
                如果 (顶点数 >= 2)
                {
                    段数 = 段数 + 顶点数 - 1
                }
                如果 (闭合标志 == 1 && 顶点数 > 2)
                {
                    段数 = 段数 + 1
                }
            }
            否则 (型别 == 5)
            {
                段数 = 段数 + 2
            }
            下标 = 下标 + 2 + 数据数
        }
        如果 (段数 < 1)
        {
            段数 = 1
        }
        成员_数组容量 = 段数 * 4
        成员_屏幕数组 = 浮点小数数组.创建 (成员_数组容量)
    }

    方法 取弧段数 <类型 = 整数 注释 = "按弧扫过角度求离散线段数: 整圆 64 段, 最少 2 段.">
    参数 扫过角度 <类型 = 小数>
    {
        变量 段数 <类型 = 整数>

        段数 = 舍入到较大整数 (64 * 扫过角度 / 360)
        如果 (段数 < 2)
        {
            段数 = 2
        }
        返回 (段数)
    }

    方法 钳制缩放 <类型 = 小数 注释 = "把缩放倍率钳制在自适应视图基准的 0.02~50 倍之间.">
    参数 原值 <类型 = 小数>
    {
        变量 值 <类型 = 小数>
        变量 下限 <类型 = 小数>
        变量 上限 <类型 = 小数>

        值 = 原值
        如果 (成员_适应缩放 <= 0)
        {
            成员_适应缩放 = 1
        }
        下限 = 成员_适应缩放 * 0.02
        上限 = 成员_适应缩放 * 50
        如果 (值 < 下限)
        {
            值 = 下限
        }
        否则
        {
            如果 (值 > 上限)
            {
                值 = 上限
            }
        }
        返回 (值)
    }

    方法 加线段 <注释 = "把一条屏幕坐标线段追加写入屏幕数组; 数组已满时静默丢弃.">
    参数 横1 <类型 = 小数>
    参数 纵1 <类型 = 小数>
    参数 横2 <类型 = 小数>
    参数 纵2 <类型 = 小数>
    {
        如果 (成员_写指针 + 4 > 成员_数组容量)
        {
            返回
        }
        成员_屏幕数组.置成员 (成员_写指针, 横1)
        成员_屏幕数组.置成员 (成员_写指针 + 1, 纵1)
        成员_屏幕数组.置成员 (成员_写指针 + 2, 横2)
        成员_屏幕数组.置成员 (成员_写指针 + 3, 纵2)
        成员_写指针 = 成员_写指针 + 4
    }

    方法 通知_测量内容尺寸 <公开 @虚拟方法 = 可覆盖>
    参数 需要测量内容宽度 <类型 = 逻辑型>
    参数 需要测量内容高度 <类型 = 逻辑型>
    参数 结果尺寸 <类型 = 尺寸类>
    {
        如果 (需要测量内容宽度)
        {
            结果尺寸.宽度 = DP到像素2 (240)
        }
        如果 (需要测量内容高度)
        {
            结果尺寸.高度 = DP到像素2 (180)
        }
    }

    方法 通知_绘制内容 <公开 @虚拟方法 = 可覆盖>
    参数 画板对象 <类型 = 画板类>
    {
        变量 表长 <类型 = 整数>
        变量 下标 <类型 = 整数>
        变量 计次 <类型 = 整数>
        变量 型别 <类型 = 整数>
        变量 数据数 <类型 = 整数>
        变量 顶点数 <类型 = 整数>
        变量 闭合标志 <类型 = 整数>
        变量 圆心横 <类型 = 小数>
        变量 圆心纵 <类型 = 小数>
        变量 半径 <类型 = 小数>
        变量 起始角 <类型 = 小数>
        变量 扫过 <类型 = 小数>
        变量 角系数 <类型 = 小数>
        变量 段数 <类型 = 整数>
        变量 段计次 <类型 = 整数>
        变量 角度 <类型 = 小数>
        变量 甲横 <类型 = 小数>
        变量 甲纵 <类型 = 小数>
        变量 乙横 <类型 = 小数>
        变量 乙纵 <类型 = 小数>
        变量 点计次 <类型 = 整数>
        变量 首横 <类型 = 小数>
        变量 首纵 <类型 = 小数>
        变量 臂长 <类型 = 小数>

        如果 (成员_实体数 <= 0 || 成员_屏幕数组 == 空对象)
        {
            返回
        }
        成员_中心横像素 = (小数)取宽度 () / 2
        成员_中心纵像素 = (小数)取高度 () / 2
        成员_画笔对象.颜色 = -16777216
        成员_画笔对象.笔划宽度 = 1
        成员_写指针 = 0
        角系数 = 数学运算类.PI / 180
        表长 = 取数组成员数 (成员_实体表)
        下标 = 1
        循环 (, 成员_实体数, 计次)
        {
            如果 (下标 + 1 >= 表长)
            {
                跳出循环
            }
            型别 = 舍入到较小整数 (成员_实体表 [下标])
            数据数 = 舍入到较小整数 (成员_实体表 [下标 + 1])
            如果 (下标 + 2 + 数据数 > 表长)
            {
                跳出循环
            }
            如果 (型别 == 1)
            {
                甲横 = 成员_中心横像素 + (成员_实体表 [下标 + 2] - 成员_视图中心X) * 成员_缩放
                甲纵 = 成员_中心纵像素 - (成员_实体表 [下标 + 3] - 成员_视图中心Y) * 成员_缩放
                乙横 = 成员_中心横像素 + (成员_实体表 [下标 + 4] - 成员_视图中心X) * 成员_缩放
                乙纵 = 成员_中心纵像素 - (成员_实体表 [下标 + 5] - 成员_视图中心Y) * 成员_缩放
                加线段 (甲横, 甲纵, 乙横, 乙纵)
            }
            否则 (型别 == 2)
            {
                圆心横 = 成员_实体表 [下标 + 2]
                圆心纵 = 成员_实体表 [下标 + 3]
                半径 = 成员_实体表 [下标 + 4]
                段数 = 取弧段数 (360)
                甲横 = 成员_中心横像素 + (圆心横 + 半径 - 成员_视图中心X) * 成员_缩放
                甲纵 = 成员_中心纵像素 - (圆心纵 - 成员_视图中心Y) * 成员_缩放
                循环 (, 段数, 段计次)
                {
                    角度 = 2 * 数学运算类.PI * (段计次 + 1) / 段数
                    乙横 = 成员_中心横像素 + (圆心横 + 半径 * 求余弦 (角度) - 成员_视图中心X) * 成员_缩放
                    乙纵 = 成员_中心纵像素 - (圆心纵 + 半径 * 求正弦 (角度) - 成员_视图中心Y) * 成员_缩放
                    加线段 (甲横, 甲纵, 乙横, 乙纵)
                    甲横 = 乙横
                    甲纵 = 乙纵
                }
            }
            否则 (型别 == 3)
            {
                圆心横 = 成员_实体表 [下标 + 2]
                圆心纵 = 成员_实体表 [下标 + 3]
                半径 = 成员_实体表 [下标 + 4]
                起始角 = 成员_实体表 [下标 + 5]
                扫过 = 成员_实体表 [下标 + 6] - 起始角
                如果 (扫过 <= 0)
                {
                    扫过 = 扫过 + 360
                }
                如果 (扫过 > 360)
                {
                    扫过 = 360
                }
                段数 = 取弧段数 (扫过)
                甲横 = 成员_中心横像素 + (圆心横 + 半径 * 求余弦 (起始角 * 角系数) - 成员_视图中心X) * 成员_缩放
                甲纵 = 成员_中心纵像素 - (圆心纵 + 半径 * 求正弦 (起始角 * 角系数) - 成员_视图中心Y) * 成员_缩放
                循环 (, 段数, 段计次)
                {
                    角度 = (起始角 + 扫过 * (段计次 + 1) / 段数) * 角系数
                    乙横 = 成员_中心横像素 + (圆心横 + 半径 * 求余弦 (角度) - 成员_视图中心X) * 成员_缩放
                    乙纵 = 成员_中心纵像素 - (圆心纵 + 半径 * 求正弦 (角度) - 成员_视图中心Y) * 成员_缩放
                    加线段 (甲横, 甲纵, 乙横, 乙纵)
                    甲横 = 乙横
                    甲纵 = 乙纵
                }
            }
            否则 (型别 == 4)
            {
                闭合标志 = 舍入到较小整数 (成员_实体表 [下标 + 2])
                顶点数 = 舍入到较小整数 (成员_实体表 [下标 + 3])
                如果 (顶点数 >= 2)
                {
                    甲横 = 成员_中心横像素 + (成员_实体表 [下标 + 4] - 成员_视图中心X) * 成员_缩放
                    甲纵 = 成员_中心纵像素 - (成员_实体表 [下标 + 5] - 成员_视图中心Y) * 成员_缩放
                    首横 = 甲横
                    首纵 = 甲纵
                    循环 (, 顶点数 - 1, 点计次)
                    {
                        如果 (下标 + 7 + 点计次 * 2 >= 表长)
                        {
                            跳出循环
                        }
                        乙横 = 成员_中心横像素 + (成员_实体表 [下标 + 6 + 点计次 * 2] - 成员_视图中心X) * 成员_缩放
                        乙纵 = 成员_中心纵像素 - (成员_实体表 [下标 + 7 + 点计次 * 2] - 成员_视图中心Y) * 成员_缩放
                        加线段 (甲横, 甲纵, 乙横, 乙纵)
                        甲横 = 乙横
                        甲纵 = 乙纵
                    }
                    如果 (闭合标志 == 1 && 顶点数 > 2)
                    {
                        加线段 (甲横, 甲纵, 首横, 首纵)
                    }
                }
            }
            否则 (型别 == 5)
            {
                甲横 = 成员_中心横像素 + (成员_实体表 [下标 + 2] - 成员_视图中心X) * 成员_缩放
                甲纵 = 成员_中心纵像素 - (成员_实体表 [下标 + 3] - 成员_视图中心Y) * 成员_缩放
                臂长 = DP到像素2 (5)
                加线段 (甲横 - 臂长, 甲纵, 甲横 + 臂长, 甲纵)
                加线段 (甲横, 甲纵 - 臂长, 甲横, 甲纵 + 臂长)
            }
            下标 = 下标 + 2 + 数据数
        }
        如果 (成员_写指针 >= 4)
        {
            画板对象.画一批直线2 (成员_屏幕数组, 0, 舍入到较小整数 (成员_写指针 / 4), 成员_画笔对象)
        }
    }

    方法 取两指间距 <类型 = 小数>
    参数 触摸动作事件 <类型 = 动作事件类>
    {
        变量 横 <类型 = 小数>
        变量 纵 <类型 = 小数>

        横 = 触摸动作事件.取横坐标 (0) - 触摸动作事件.取横坐标 (1)
        纵 = 触摸动作事件.取纵坐标 (0) - 触摸动作事件.取纵坐标 (1)
        返回 (求平方根 (横 * 横 + 纵 * 纵))
    }

    方法 通知_被触摸 <公开 类型 = 逻辑型 注释 = "单指拖动平移, 双指捏合缩放." @虚拟方法 = 可覆盖>
    参数 触摸动作事件 <类型 = 动作事件类>
    {
        变量 当前横 <类型 = 小数>
        变量 当前纵 <类型 = 小数>
        变量 间距 <类型 = 小数>

        如果 (触摸动作事件.触点数量 >= 2)
        {
            如果 (触摸动作事件.动作 == 动作类型.多点按下 || 取反 (成员_双指中))
            {
                成员_双指中 = 真
                成员_起始间距 = 取两指间距 (触摸动作事件)
                成员_起始缩放 = 成员_缩放
            }
            否则
            {
                如果 (成员_起始间距 > 0.001)
                {
                    间距 = 取两指间距 (触摸动作事件)
                    如果 (间距 > 0.001)
                    {
                        成员_缩放 = 钳制缩放 (成员_起始缩放 * (间距 / 成员_起始间距))
                        重新绘制 ()
                    }
                }
            }
        }
        否则
        {
            成员_双指中 = 假
            如果 (触摸动作事件.动作 == 动作类型.按下)
            {
                成员_按下横 = 触摸动作事件.取横坐标 (0)
                成员_按下纵 = 触摸动作事件.取纵坐标 (0)
                成员_按下中心X = 成员_视图中心X
                成员_按下中心Y = 成员_视图中心Y
            }
            否则 (触摸动作事件.动作 == 动作类型.移动)
            {
                当前横 = 触摸动作事件.取横坐标 (0)
                当前纵 = 触摸动作事件.取纵坐标 (0)
                如果 (成员_缩放 > 0.000001)
                {
                    成员_视图中心X = 成员_按下中心X - (当前横 - 成员_按下横) / 成员_缩放
                    成员_视图中心Y = 成员_按下中心Y + (当前纵 - 成员_按下纵) / 成员_缩放
                }
                重新绘制 ()
            }
        }
        返回 (真)
    }
}
