<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.OCCT几何 <注释 = "DXF 文件读入器: 解析 ASCII DXF 中的二维实体子集 (线/圆/弧/多段线/点)">

类 DXF文件 <公开 注释 = "★ 读取 ASCII DXF 文件中的二维实体子集, 输出扁平化实体表 (小数数组)."
        注释 = "实体表协议: [实体总数, (型别, 数据个数, 数据...)*实体总数], 失败返回 [-1]."
        注释 = "型别: 1=直线[4: 起点x,起点y,终点x,终点y]; 2=圆[3: 圆心x,圆心y,半径];"
        注释 = "3=圆弧[5: 圆心x,圆心y,半径,起始角(度),终止角(度)]; 4=多段线[2+2k: 闭合标志, 顶点数, 坐标x,y...]; 5=点[2: x,y]."
        注释 = "解析只消费数字组码, 图层名等字符串一律跳过, 因此文件是 UTF-8 还是 GBK 都不影响解析结果."
        注释 = "实体表可直接交给 二维观察框.装载实体 显示; 解析失败时用 取错误 读取原因 (读后清空)."
        @禁止创建对象 = 真
        @java.外部源文件 = "java\\DxfReader.java">
{
    方法 读入文件 <公开 静态 类型 = "小数 []" 注释 = "读取并解析 ASCII DXF 文件 (R12 及以上均可, 只扫描 ENTITIES 段)."
            返回值注释 = "返回实体表; 失败返回只含一个成员 -1 的数组, 原因用 取错误 读取." @嵌入式方法 = "">
    参数 文件路径 <类型 = 文本型 注释 = "DXF 文件的绝对路径.">
    {
        @ com.volcano.occt.DxfReader.parse (@<文件路径>)
    }

    方法 读入文本 <公开 静态 类型 = "小数 []" 注释 = "解析一段 DXF 文本, 语义与 读入文件 相同, 供内容已在内存中的场合使用." @嵌入式方法 = "">
    参数 DXF文本 <类型 = 文本型>
    {
        @ com.volcano.occt.DxfReader.parseText (@<DXF文本>)
    }

    方法 取示例表 <公开 静态 类型 = "小数 []" 注释 = "内置演示图形的实体表 (线4/圆2/弧1/多段线3/点2, 共 12 个), 不依赖任何外部文件." @嵌入式方法 = "">
    {
        @ com.volcano.occt.DxfReader.demoTable ()
    }

    方法 取错误 <公开 静态 类型 = 文本型 注释 = "读取并清空最近一次解析错误, 空文本表示没有错误." @嵌入式方法 = "">
    {
        @ com.volcano.occt.DxfReader.lastError ()
    }
}
