    参数 深度 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Circle.DumpJson (@<对象>, @<深度>)
    }

}

类 平面圆锥曲线基类 <公开 注释 = "平面圆锥曲线基类: 原类 Geom2d_Conic (libTKG2d, 头文件 Geom2d/Geom2d_Conic.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 抽象类 Conic 描述平面空间中圆锥曲线的公共行为, 特别是其一般特征. Geom2d 包提供四个具体的圆锥曲线类: Geom2d_Circle, Geom2d_Ellipse, Geom2d_Hyperbola 与 Geom2d_Parabola. 圆锥曲线用坐标系(gp_Ax22d 对象)在平面中定位, 其原点为圆锥曲线的中心(抛物线则为顶点). 该坐标系是圆锥曲线的局部坐标系. 它赋予圆锥曲线显式朝向, 决定参数沿曲线增加的方向. 局部坐标系的 \"X 轴\" 还定义圆锥曲线参数的原点." @禁止创建对象 = 真>
{

    方法 设置轴 <公开 静态 注释 = "设置轴. 原方法: SetAxis. 官方简介: 修改该圆锥曲线, 通过把 theA 赋为其轴来部分重定义其局部坐标系" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 A <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.SetAxis (@<对象>, @<A>)
    }

    方法 设置X轴 <公开 静态 注释 = "设置X轴. 原方法: SetXAxis. 官方简介: 把轴 theA 的原点与单位向量赋给该圆锥曲线局部坐标系的原点与 X Direction. 该圆锥曲线局部坐标系的另一个单位向量被重新计算为垂直于 theA, 且不改变局部坐标系的朝向(右手系或左手系)." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 AX <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.SetXAxis (@<对象>, @<AX>)
    }

    方法 设置Y轴 <公开 静态 注释 = "设置Y轴. 原方法: SetYAxis. 官方简介: 把轴 theA 的原点与单位向量赋给该圆锥曲线局部坐标系的原点与 Y Direction. 该圆锥曲线局部坐标系的另一个单位向量被重新计算为垂直于 theA, 且不改变局部坐标系的朝向(右手系或左手系)." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 AY <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.SetYAxis (@<对象>, @<AY>)
    }

    方法 设置位置 <公开 静态 注释 = "设置位置. 原方法: SetLocation. 官方简介: 修改该圆锥曲线, 通过把 theP 赋为其原点来部分重定义其局部坐标系." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.SetLocation (@<对象>, @<P>)
    }

    方法 X轴 <公开 静态 类型 = 长整数 注释 = "X轴. 原方法: XAxis. 官方简介: 返回二次曲线的 \"XAxis\". 该轴定义二次曲线参数化的原点. 该轴与 \"Yaxis\" 定义二次曲线的局部坐标系. -C++: return const&" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.XAxis (@<对象>)
    }

    方法 Y轴 <公开 静态 类型 = 长整数 注释 = "Y轴. 原方法: YAxis. 官方简介: 返回圆锥曲线的 \"YAxis\". \"YAxis\" 垂直于 \"Xaxis\"." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.YAxis (@<对象>)
    }

    方法 位置 <公开 静态 类型 = 长整数 注释 = "位置. 原方法: Location. 官方简介: 返回二次曲线的位置点. 对于圆, 椭圆和双曲线, 它是二次曲线的中心. 对于抛物线, 它是抛物线的顶点." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.Location (@<对象>)
    }

    方法 位置_2 <公开 静态 类型 = 长整数 注释 = "位置_2. 原方法: Position. 官方简介: 返回圆锥曲线的局部坐标系." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.Position (@<对象>)
    }

    方法 反转 <公开 静态 注释 = "反转. 原方法: Reverse. 官方简介: 反转 <me> 的参数化方向. 圆锥曲线的局部坐标系会被修改." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.Reverse (@<对象>)
    }

    方法 连续性 <公开 静态 类型 = 整数 注释 = "连续性. 原方法: Continuity. 官方简介: 返回 GeomAbs_CN, 即任何圆锥曲线的全局连续性." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.Continuity (@<对象>)
    }

    方法 是否CN <公开 静态 类型 = 逻辑型 注释 = "是否CN. 原方法: IsCN. 官方简介: 返回 True, 圆锥曲线的连续性阶为无穷." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 N <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.IsCN (@<对象>, @<N>)
    }

    方法 转储JSON <公开 静态 类型 = 文本型 注释 = "转储JSON. 原方法: DumpJson. 官方简介: 把自身内容转储到流中" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 深度 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Conic.DumpJson (@<对象>, @<深度>)
    }

}

类 平面曲线基类 <公开 注释 = "平面曲线基类: 原类 Geom2d_Curve (libTKG2d, 头文件 Geom2d/Geom2d_Curve.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 抽象类 Curve 描述二维空间中曲线的公共行为. Geom2d 包提供众多具体派生曲线类, 包括直线, 圆, 二次曲线, Bezier 或 BSpline 曲线等. 这些曲线的主要特征在于它们是参数化的. Geom2d_Curve 类展示: - 如何使用曲线的参数方程计算参数为 u 的点, 以及该点处的切向量和 2, 3,..., N 阶导数向量; - 如何获取曲线的一般信息(例如连续阶, 封闭特性, 周期性, 参数域边界); - 当对曲线施加几何变换或反转曲线朝向时参数如何变化. 所有曲线必须具有几何连续性: 曲线至少为 \"C0\". 通常, 这一属性在构造时或编辑曲线时检查. 若非如此, 文档会明确说明. 警告: Geom2d 包不阻止构造长度为零或自相交的曲线." @禁止创建对象 = 真>
{

    方法 变换参数 <公开 静态 类型 = 小数 注释 = "变换参数. 原方法: TransformedParameter. 官方简介: 计算该曲线上参数 U 处的点在经 T 变换后的曲线上的参数. 注: 该函数通常返回 U, 但可被重定义(例如对于直线)." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Curve.TransformedParameter (@<对象>, @<U>, @<T>)
    }

    方法 参数化变换 <公开 静态 类型 = 小数 注释 = "参数化变换. 原方法: ParametricTransformation. 官方简介: 返回施加变换 T 时计算该曲线参数变换所需的系数. 该系数是曲线上某点的参数与经 T 变换后的新曲线上变换点的参数之比. 注意: 该函数一般返回 1., 但它可以被重定义(例如在直线上)." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Curve.ParametricTransformation (@<对象>, @<T>)
    }

    方法 反转副本 <公开 静态 类型 = 长整数 注释 = "反转副本. 原方法: Reversed. 官方简介: 创建反转副本. 改变该曲线的朝向. 第一与最后参数不改变, 但曲线的参数方向被反转. 若曲线有界: - 初始曲线的起点变为反转曲线的终点, 且 - 初始曲线的终点变为反转曲线的起点. - Reversed 创建新曲线." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Curve.Reversed (@<对象>)
    }

    方法 周期 <公开 静态 类型 = 小数 注释 = "周期. 原方法: Period. 官方简介: 返回该曲线的周期. 若曲线非周期则抛出异常" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Curve.Period (@<对象>)
    }

    方法 取值 <公开 静态 类型 = 长整数 注释 = "取值. 原方法: Value. 官方简介: 计算 <me> 上参数 U 处的点. 若曲线是周期的, 则返回的点是 P(U), 其中 U = Ustart + (U - Uend), Ustart 与 Uend 是该曲线的参数边界." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Curve.Value (@<对象>, @<U>)
    }

    方法 转储JSON <公开 静态 类型 = 文本型 注释 = "转储JSON. 原方法: DumpJson. 官方简介: 把自身内容转储到流中" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 深度 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Curve.DumpJson (@<对象>, @<深度>)
    }

}

类 平面方向基类 <公开 注释 = "平面方向基类: 原类 Geom2d_Direction (libTKG2d, 头文件 Geom2d/Geom2d_Direction.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: Direction 类描述一个永不为空的向量, 即单位向量." @禁止创建对象 = 真>
{

    方法 创建 <公开 静态 类型 = 长整数 注释 = "创建. 原构造器: Geom2d_Direction. 官方简介: 用两个笛卡尔坐标创建单位向量." @嵌入式方法 = "">
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.构造 (@<X>, @<Y>)
    }

    方法 创建_2 <公开 静态 类型 = 长整数 注释 = "创建_2. 原构造器: Geom2d_Direction. 官方简介: 创建 <me> 的持久副本." @嵌入式方法 = "">
    参数 V <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.构造_2 (@<V>)
    }

    方法 设置坐标 <公开 静态 注释 = "设置坐标. 原方法: SetCoord. 官方简介: 把坐标 X 和 Y 赋给该单位向量, 然后归一化它. 若 Sqrt(X*X + Y*Y) 小于或等于 gp::Resolution() 则抛出 Standard_ConstructionError 异常." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 X <类型 = 小数>
    参数 Y <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.SetCoord (@<对象>, @<X>, @<Y>)
    }

    方法 二维设置方向 <公开 静态 注释 = "二维设置方向. 原方法: SetDir2d. 官方简介: 把 gp_Dir2d 单位向量 V 转换为该单位向量." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 V <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.SetDir2d (@<对象>, @<V>)
    }

    方法 设置X <公开 静态 注释 = "设置X. 原方法: SetX. 官方简介: 为单位向量的 X 坐标赋值, 然后对其归一化. 异常: 若所赋的值使向量的模变得小于或等于 gp::Resolution() 则抛出 Standard_ConstructionError." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 X <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.SetX (@<对象>, @<X>)
    }

    方法 设置Y <公开 静态 注释 = "设置Y. 原方法: SetY. 官方简介: 为单位向量的 Y 坐标赋值, 然后对其归一化. 异常: 若所赋的值使向量的模变得小于或等于 gp::Resolution() 则抛出 Standard_ConstructionError." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 Y <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.SetY (@<对象>, @<Y>)
    }

    方法 二维方向 <公开 静态 类型 = 长整数 注释 = "二维方向. 原方法: Dir2d. 官方简介: 把该单位向量转换为 gp_Dir2d 单位向量." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.Dir2d (@<对象>)
    }

    方法 模长 <公开 静态 类型 = 小数 注释 = "模长. 原方法: Magnitude. 官方简介: 返回 1.0" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.Magnitude (@<对象>)
    }

    方法 平方模长 <公开 静态 类型 = 小数 注释 = "平方模长. 原方法: SquareMagnitude. 官方简介: 返回 1.0" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.SquareMagnitude (@<对象>)
    }

    方法 叉积副本 <公开 静态 类型 = 小数 注释 = "叉积副本. 原方法: Crossed. 官方简介: 计算 <me> 与 <Other> 之间的叉积." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 另一个 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.Crossed (@<对象>, @<另一个>)
    }

    方法 变换 <公开 静态 注释 = "变换. 原方法: Transform. 官方简介: 对该单位向量施加变换 T, 然后归一化." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.Transform (@<对象>, @<T>)
    }

    方法 复制 <公开 静态 类型 = 长整数 注释 = "复制. 原方法: Copy. 官方简介: 创建一个新对象, 它是该单位向量的副本." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Direction.Copy (@<对象>)
    }

}

类 平面椭圆 <公开 注释 = "平面椭圆: 原类 Geom2d_Ellipse (libTKG2d, 头文件 Geom2d/Geom2d_Ellipse.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 描述平面(二维空间)中的椭圆. 椭圆由其长半轴和短半轴定义, 并且如同任何二次曲线一样, 借助坐标系(gp_Ax22d 对象)定位在平面中, 其中: - 原点是椭圆中心, - \"X 方向\" 定义长轴, 且 - \"Y 方向\" 定义短轴. 该坐标系是椭圆的局部坐标系. 局部坐标系的朝向(正向或反向)赋予椭圆显式朝向, 决定参数沿椭圆增大的方向. Geom2d_Ellipse 椭圆按角度参数化: P(U) = O + MajorRad*Cos(U)*XDir + MinorRad*Sin(U)*YDir 其中: - P 是参数 U 的点, - O, XDir 和 YDir 分别是其局部坐标系的原点, \"X 方向\" 和 \"Y 方向\", - MajorRad 和 MinorRad 是椭圆的长半轴和短半轴. 因此局部坐标系的 \"X 轴\" 定义椭圆参数的原点. 椭圆是封闭且周期的曲线. 周期为 2.*Pi, 参数范围为 [ 0,2.*Pi [. 另见 GCE2d_MakeEllipse, 它提供更复杂的椭圆构造函数; gp_Ax22d; gp_Elips2d, 它们是等效的非参数化数据结构." @禁止创建对象 = 真>
{

    方法 创建 <公开 静态 类型 = 长整数 注释 = "创建. 原构造器: Geom2d_Ellipse. 官方简介: 通过转换 gp_Elips2d 椭圆 E 创建椭圆." @嵌入式方法 = "">
    参数 E <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.构造 (@<E>)
    }

    方法 创建_2 <公开 静态 类型 = 长整数 注释 = "创建_2. 原构造器: Geom2d_Ellipse. 官方简介: 创建由其长半径与短半径 MajorRadius 与 MinorRadius 定义的椭圆, 并在平面中由其长轴 MajorAxis 定位; 椭圆的中心是 MajorAxis 的原点, MajorAxis 的单位向量是椭圆局部坐标系的 \"X 方向\"; 若 Sense 为 true(默认值)则该坐标系是正向的, 若 Sense 为 false 则是反向的. 警告: 不禁止创建 MajorRadius = MinorRadius 的椭圆. 异常: 若以下情形则抛出 Standard_ConstructionError: - MajorRadius 小于 MinorRadius, 或 - MinorRadius 小于 0." @嵌入式方法 = "">
    参数 长轴 <类型 = 长整数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    参数 方向 <类型 = 逻辑型>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.构造_2 (@<长轴>, @<长半径>, @<短半径>, @<方向>)
    }

    方法 创建_3 <公开 静态 类型 = 长整数 注释 = "创建_3. 原构造器: Geom2d_Ellipse. 官方简介: 创建由其长半径与短半径 MajorRadius 与 MinorRadius 定义的椭圆, 其中坐标系统 Axis 定位该椭圆并定义其在平面中的朝向, 使得: - 椭圆的中心是 Axis 的原点, - Axis 的 \"X Direction\" 定义椭圆的长轴, - Axis 的 \"Y Direction\" 定义椭圆的短轴, - Axis 的朝向(正向或反向)给出椭圆的朝向. 警告: 不禁止创建 MajorRadius = MinorRadius 的椭圆. 异常: 若以下情形则抛出 Standard_ConstructionError: - MajorRadius 小于 MinorRadius, 或 - MinorRadius 小于 0." @嵌入式方法 = "">
    参数 轴 <类型 = 长整数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.构造_3 (@<轴>, @<长半径>, @<短半径>)
    }

    方法 二维设置椭圆 <公开 静态 注释 = "二维设置椭圆. 原方法: SetElips2d. 官方简介: 把 gp_Elips2d 椭圆 E 转换为该椭圆." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 E <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.SetElips2d (@<对象>, @<E>)
    }

    方法 设置长半径 <公开 静态 注释 = "设置长半径. 原方法: SetMajorRadius. 官方简介: 为椭圆的长半轴赋值. 在以下情况抛出 Standard_ConstructionError: - 该椭圆的长半轴变得小于短半轴, 或 - MinorRadius 小于 0." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 长半径 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.SetMajorRadius (@<对象>, @<长半径>)
    }

    方法 设置短半径 <公开 静态 注释 = "设置短半径. 原方法: SetMinorRadius. 官方简介: 为椭圆的短半轴赋值. 在以下情况抛出 Standard_ConstructionError: - 该椭圆的长半轴变得小于短半轴, 或 - MinorRadius 小于 0." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 短半径 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.SetMinorRadius (@<对象>, @<短半径>)
    }

    方法 二维椭圆 <公开 静态 类型 = 长整数 注释 = "二维椭圆. 原方法: Elips2d. 官方简介: 把该椭圆转换为 gp_Elips2d 椭圆." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Elips2d (@<对象>)
    }

    方法 反转参数 <公开 静态 类型 = 小数 注释 = "反转参数. 原方法: ReversedParameter. 官方简介: 计算该椭圆上参数 U 的点在反向椭圆上的参数. 对于椭圆, 返回值为: 2.*Pi - U." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.ReversedParameter (@<对象>, @<U>)
    }

    方法 准线1 <公开 静态 类型 = 长整数 注释 = "准线1. 原方法: Directrix1. 官方简介: 计算该椭圆的准线. 该准线是在局部平面(Z = 0)内垂直于椭圆 XAxis 的直线, 与椭圆中心的距离为 d = MajorRadius / e, 其中 e 是椭圆的离心率. 该直线平行于 \"YAxis\". directrix1 与 \"XAxis\" 的交点是 directrix1 的 \"位置点\". 该点位于 \"XAxis\" 的正侧. 若 Eccentricity = 0.0 则抛出 ConstructionError. (椭圆退化为圆)" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Directrix1 (@<对象>)
    }

    方法 准线2 <公开 静态 类型 = 长整数 注释 = "准线2. 原方法: Directrix2. 官方简介: 该直线由 \"Directrix1\" 关于椭圆的 \"YAxis\" 的对称变换得到. 若 Eccentricity = 0.0 则抛出 ConstructionError. (椭圆退化为圆)." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Directrix2 (@<对象>)
    }

    方法 离心率 <公开 静态 类型 = 小数 注释 = "离心率. 原方法: Eccentricity. 官方简介: 返回椭圆在 0.0 与 1.0 之间的离心率. 若 f 是椭圆中心与 Focus1 之间的距离, 则离心率 e = f / MajorRadius. 若 MajorRadius = 0 则返回 0" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Eccentricity (@<对象>)
    }

    方法 焦距 <公开 静态 类型 = 小数 注释 = "焦距. 原方法: Focal. 官方简介: 计算焦距. 焦距是椭圆的中心与一个焦点之间的距离." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Focal (@<对象>)
    }

    方法 焦点1 <公开 静态 类型 = 长整数 注释 = "焦点1. 原方法: Focus1. 官方简介: 返回椭圆的第一焦点. 该焦点位于椭圆 \"X 轴\" 的正侧." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Focus1 (@<对象>)
    }

    方法 焦点2 <公开 静态 类型 = 长整数 注释 = "焦点2. 原方法: Focus2. 官方简介: 返回椭圆的第二焦点. 该焦点位于椭圆 \"X 轴\" 的负侧." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Focus2 (@<对象>)
    }

    方法 长半径 <公开 静态 类型 = 小数 注释 = "长半径. 原方法: MajorRadius. 官方简介: 返回该椭圆的长半轴." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.MajorRadius (@<对象>)
    }

    方法 短半径 <公开 静态 类型 = 小数 注释 = "短半径. 原方法: MinorRadius. 官方简介: 返回该椭圆的短半轴." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.MinorRadius (@<对象>)
    }

    方法 参数 <公开 静态 类型 = 小数 注释 = "参数. 原方法: Parameter. 官方简介: 计算该椭圆的参数. 该值由公式 p = (1 - e * e) * MajorRadius 给出, 其中 e 是椭圆的离心率. 若 MajorRadius = 0 则返回 0" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Parameter (@<对象>)
    }

    方法 首个参数 <公开 静态 类型 = 小数 注释 = "首个参数. 原方法: FirstParameter. 官方简介: 返回该椭圆第一个参数的值. 该值为 0.0, 给出该椭圆的起点. 椭圆的起点与终点重合." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.FirstParameter (@<对象>)
    }

    方法 末个参数 <公开 静态 类型 = 小数 注释 = "末个参数. 原方法: LastParameter. 官方简介: 返回该椭圆最后一个参数的值. 该值为 2.*Pi, 给出该椭圆的终点. 椭圆的起点与终点重合." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.LastParameter (@<对象>)
    }

    方法 是否闭合 <公开 静态 类型 = 逻辑型 注释 = "是否闭合. 原方法: IsClosed. 官方简介: 返回 True." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.IsClosed (@<对象>)
    }

    方法 是否周期 <公开 静态 类型 = 逻辑型 注释 = "是否周期. 原方法: IsPeriodic. 官方简介: 返回 True." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.IsPeriodic (@<对象>)
    }

    方法 取点 <公开 静态 注释 = "取点. 原方法: D0. 官方简介: 在 P 中返回参数 U 的点. P = C + MajorRadius * Cos (U) * XDir + MinorRadius * Sin (U) * YDir, 其中 C 是椭圆的中心, XDir 是 \"XAxis\" 的方向, \"YDir\" 是椭圆的 \"YAxis\"." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 输出P <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.D0 (@<对象>, @<U>, @<输出P>)
    }

    方法 取一阶导 <公开 静态 注释 = "取一阶导. 原方法: D1." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 输出P <类型 = 长整数>
    参数 输出V1 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.D1 (@<对象>, @<U>, @<输出P>, @<输出V1>)
    }

    方法 取二阶导 <公开 静态 注释 = "取二阶导. 原方法: D2. 官方简介: 返回参数 U 的点 P. 向量 V1 与 V2 是该点处的一阶与二阶导数." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 输出P <类型 = 长整数>
    参数 输出V1 <类型 = 长整数>
    参数 输出V2 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.D2 (@<对象>, @<U>, @<输出P>, @<输出V1>, @<输出V2>)
    }

    方法 取三阶导 <公开 静态 注释 = "取三阶导. 原方法: D3. 官方简介: 返回参数 U 的点 P, 以及一阶, 二阶和三阶导数 V1, V2 和 V3." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 输出P <类型 = 长整数>
    参数 输出V1 <类型 = 长整数>
    参数 输出V2 <类型 = 长整数>
    参数 输出V3 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.D3 (@<对象>, @<U>, @<输出P>, @<输出V1>, @<输出V2>, @<输出V3>)
    }

    方法 取N阶导 <公开 静态 类型 = 长整数 注释 = "取N阶导. 原方法: DN. 官方简介: 对于该椭圆的参数 U 点, 计算 N 阶导数对应的向量. 若 N 小于 1 则抛出 Standard_RangeError." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 U <类型 = 小数>
    参数 N <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.DN (@<对象>, @<U>, @<N>)
    }

    方法 变换 <公开 静态 注释 = "变换. 原方法: Transform. 官方简介: 对该椭圆施加变换 T." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Transform (@<对象>, @<T>)
    }

    方法 复制 <公开 静态 类型 = 长整数 注释 = "复制. 原方法: Copy. 官方简介: 创建一个新对象, 它是该椭圆的副本." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.Copy (@<对象>)
    }

    方法 转储JSON <公开 静态 类型 = 文本型 注释 = "转储JSON. 原方法: DumpJson. 官方简介: 把自身内容转储到流中" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 深度 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Ellipse.DumpJson (@<对象>, @<深度>)
    }

}

类 平面几何基类 <公开 注释 = "平面几何基类: 原类 Geom2d_Geometry (libTKG2d, 头文件 Geom2d/Geom2d_Geometry.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 二维空间中的通用抽象类 Geometry 描述所有几何实体的公共行为." @禁止创建对象 = 真>
{

    方法 镜像 <公开 静态 注释 = "镜像. 原方法: Mirror. 官方简介: 对几何对象执行关于点 P 的对称变换, P 是对称中心." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Geometry.Mirror (@<对象>, @<P>)
    }

    方法 镜像_2 <公开 静态 注释 = "镜像_2. 原方法: Mirror. 官方简介: 对几何体执行关于定位轴的对称变换, 该定位轴是对称轴." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 A <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Geometry.Mirror_2 (@<对象>, @<A>)
    }

    方法 旋转 <公开 静态 注释 = "旋转. 原方法: Rotate. 官方简介: 旋转几何. P 是旋转中心. Ang 是以弧度表示的旋转角度值." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P <类型 = 长整数>
    参数 角度 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Geometry.Rotate (@<对象>, @<P>, @<角度>)
    }

    方法 缩放 <公开 静态 注释 = "缩放. 原方法: Scale. 官方简介: 缩放几何体. S 是缩放值." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P <类型 = 长整数>
    参数 S <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Geometry.Scale (@<对象>, @<P>, @<S>)
    }

    方法 平移 <公开 静态 注释 = "平移. 原方法: Translate. 官方简介: 平移几何体. V 是平移向量." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 V <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Geometry.Translate (@<对象>, @<V>)
    }

    方法 平移_2 <公开 静态 注释 = "平移_2. 原方法: Translate. 官方简介: 把几何体从点 P1 平移到点 P2." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P1 <类型 = 长整数>
    参数 P2 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Geometry.Translate_2 (@<对象>, @<P1>, @<P2>)
    }

    方法 镜像副本 <公开 静态 类型 = 长整数 注释 = "镜像副本. 原方法: Mirrored." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Geometry.Mirrored (@<对象>, @<P>)
    }

    方法 镜像副本_2 <公开 静态 类型 = 长整数 注释 = "镜像副本_2. 原方法: Mirrored." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 A <类型 = 长整数>
