    }

    方法 是否闭合 <公开 静态 类型 = 逻辑型 注释 = "是否闭合. 原方法: IsClosed. 官方简介: 返回 False" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Line.IsClosed (@<对象>)
    }

    方法 是否周期 <公开 静态 类型 = 逻辑型 注释 = "是否周期. 原方法: IsPeriodic. 官方简介: 返回 False" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKG2d.Geom2d_Line.IsPeriodic (@<对象>)
    }

