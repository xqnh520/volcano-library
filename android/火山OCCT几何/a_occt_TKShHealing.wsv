    参数 边 <类型 = 长整数>
    参数 序号 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Set (@<对象>, @<边>, @<序号>)
    }

    方法 反转 <公开 静态 注释 = "反转. 原方法: Reverse. 官方简介: 反转列表的方向以及每条边的朝向. 当线框没有缝合边或面不可用时, 应调用此方法" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Reverse (@<对象>)
    }

    方法 反转_2 <公开 静态 注释 = "反转_2. 原方法: Reverse. 官方简介: 反转列表的顺序与每条边的朝向. 面是缝合边交换 pcurve 所必需的(第一个 pcurve 对应朝向 FORWARD, 第二个对应 REVERSED; 当边被反转时, 必须交换 pcurve). 若 face 为 NULL, 则不进行交换." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 面 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Reverse_2 (@<对象>, @<面>)
    }

    方法 边数 <公开 静态 类型 = 整数 注释 = "边数. 原方法: NbEdges. 官方简介: 返回当前记录的边数量" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.NbEdges (@<对象>)
