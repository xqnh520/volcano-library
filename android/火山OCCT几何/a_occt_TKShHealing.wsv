类 形状构建替换器 <公开 注释 = "形状构建替换器: 原类 ShapeBuild_ReShape (libTKShHealing, 头文件 ShapeBuild/ShapeBuild_ReShape.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 通过对形状的某些部件执行预定义替换来重建形状." @禁止创建对象 = 真>
{

    方法 创建 <公开 静态 类型 = 长整数 注释 = "创建. 原构造器: ShapeBuild_ReShape. 官方简介: 返回空 Reshape" @嵌入式方法 = "">
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeBuild_ReShape.构造 ()
    }

    方法 应用 <公开 静态 类型 = 长整数 注释 = "应用. 原方法: Apply. 官方简介: 对形状施加替换请求" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 形状 <类型 = 长整数>
    参数 直到 <类型 = 整数>
    参数 构建模式 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeBuild_ReShape.Apply (@<对象>, @<形状>, @<直到>, @<构建模式>)
    }

    方法 应用_2 <公开 静态 类型 = 长整数 注释 = "应用_2. 原方法: Apply. 官方简介: 对形状施加替换请求." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 形状 <类型 = 长整数>
    参数 直到 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeBuild_ReShape.Apply_2 (@<对象>, @<形状>, @<直到>)
    }

    方法 状态 <公开 静态 类型 = 整数 注释 = "状态. 原方法: Status. 官方简介: 返回形状的完整替换状态 0 : 未记录, <newsh> = 原始 <shape> < 0: 待移除, <newsh> 为 NULL > 0: 待替换, <newsh> 是新项 若 <last> 为 False, 则直接返回该形状在映射中记录的状态与新形状; 若为 True 且状态 > 0, 则递归搜索最后的状态与新形状." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 形状 <类型 = 长整数>
    参数 输出新形状 <类型 = 长整数>
    参数 末个 <类型 = 逻辑型>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeBuild_ReShape.Status (@<对象>, @<形状>, @<输出新形状>, @<末个>)
    }

    方法 状态_2 <公开 静态 类型 = 逻辑型 注释 = "状态_2. 原方法: Status. 官方简介: 查询最后一次调用 Apply(shape,enum) 的状态. OK : 没有(子)形状被替换或移除 DONE1: 源(起始)形状被替换 DONE2: 源(起始)形状被移除 DONE3: 一些子形状被替换 DONE4: 一些子形状被移除 FAIL1: 由于子形状类型错误, 一些替换未完成" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 状态 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeBuild_ReShape.Status_2 (@<对象>, @<状态>)
    }

}

类 曲线投影构建 <公开 注释 = "曲线投影构建: 原类 ShapeConstruct_ProjectCurveOnSurface (libTKShHealing, 头文件 ShapeConstruct/ShapeConstruct_ProjectCurveOnSurface.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 本工具提供把三维曲线投影到曲面以计算参数曲线(pcurve)的方法. 投影由 23 个或更多点完成(对 B 样条该数目按以下规则改变: 总点数不少于段数 * (次数 + 1); 从 23 开始递归增加, 每次加 22 直到满足条件). 等参数情形(曲线对应曲面上 U=常量 或 V=常量)以给定精度识别." @禁止创建对象 = 真>
{

    方法 创建 <公开 静态 类型 = 长整数 注释 = "创建. 原构造器: ShapeConstruct_ProjectCurveOnSurface. 官方简介: 空构造函数." @嵌入式方法 = "">
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.构造 ()
    }

    方法 初始化 <公开 静态 注释 = "初始化. 原方法: Init. 官方简介: 用所有必要参数初始化对象, 即曲面与精度" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 曲面 <类型 = 长整数>
    参数 精度 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.Init (@<对象>, @<曲面>, @<精度>)
    }

    方法 初始化_2 <公开 静态 注释 = "初始化_2. 原方法: Init. 官方简介: 用所有必要参数初始化对象, 即曲面与精度" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 曲面 <类型 = 长整数>
    参数 精度 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.Init_2 (@<对象>, @<曲面>, @<精度>)
    }

    方法 设置曲面 <公开 静态 注释 = "设置曲面. 原方法: SetSurface. 官方简介: 载入曲面(以 Geom_Surface 形式)以在其上投影" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 曲面 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.SetSurface (@<对象>, @<曲面>)
    }

    方法 设置曲面_2 <公开 静态 注释 = "设置曲面_2. 原方法: SetSurface. 官方简介: 载入曲面(以 ShapeAnalysis_Surface 形式)以在其上投影" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 曲面 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.SetSurface_2 (@<对象>, @<曲面>)
    }

    方法 设置精度 <公开 静态 注释 = "设置精度. 原方法: SetPrecision. 官方简介: 设置当前精度值" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 精度 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.SetPrecision (@<对象>, @<精度>)
    }

    方法 构建曲线模式 <公开 静态 类型 = 逻辑型 注释 = "构建曲线模式. 原方法: BuildCurveMode. 官方简介: 返回(可修改的)构造三维曲线模式, 默认为 False. 若为 True, 当投影曲线已通过插值重新计算时, 三维曲线也通过插值重建." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.BuildCurveMode (@<对象>)
    }

    方法 调整退化接缝模式 <公开 静态 类型 = 整数 注释 = "调整退化接缝模式. 原方法: AdjustOverDegenMode. 官方简介: 返回(可修改的)标志, 指定把位于缝合边上的部分 pcurve 调整到参数空间的哪一侧. 这在非常罕见的情况下是必需的: 待投影的 3d 曲线部分沿带奇异性的闭合曲面(如球面)上的缝合边延伸, 经过退化点并部分位于曲面的内部区域." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.AdjustOverDegenMode (@<对象>)
    }

    方法 状态 <公开 静态 类型 = 逻辑型 注释 = "状态. 原方法: Status. 官方简介: 返回最近一次 Perform 的状态" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 状态 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.Status (@<对象>, @<状态>)
    }

    方法 执行 <公开 静态 类型 = 逻辑型 注释 = "执行. 原方法: Perform. 官方简介: 使用专用算法计算 3d 曲线到曲面的投影. 若投影器失败则返回 False, 否则, 若 pcurve 计算成功则返回 True. 输出 2D 曲线保证在区间 [First, Last] 上与输入 3D 曲线同参数. 若输出曲线位于一条直线上, 则在同参数条件满足的情形返回无限直线. TolFirst 与 TolLast 是输入 3D 曲线两端处的公差." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 输出c3d <类型 = "长整数 []">
    参数 首个 <类型 = 小数>
    参数 末个 <类型 = 小数>
    参数 输出c2d <类型 = "长整数 []">
    参数 起始容差 <类型 = 小数>
    参数 终止容差 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.Perform (@<对象>, @<输出c3d>, @<首个>, @<末个>, @<输出c2d>, @<起始容差>, @<终止容差>)
    }

    方法 按投影库执行 <公开 静态 类型 = 逻辑型 注释 = "按投影库执行. 原方法: PerformByProjLib. 官方简介: 使用 ProjLib 的标准算法计算 3d 曲线到曲面的投影. 若标准投影器失败、抛出异常或被曲面的参数边界截断曲线, 则返回 False. 否则, 若 pcurve 计算成功, 则返回 True. continuity, maxdeg 与 nbinterval 是调用 Approx_CurveOnSurface 的参数. 若 nbinterval 等于 -1(默认), 则该值根据源 3d 曲线与曲面计算." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 输出c3d <类型 = "长整数 []">
    参数 首个 <类型 = 小数>
    参数 末个 <类型 = 小数>
    参数 输出c2d <类型 = "长整数 []">
    参数 连续性 <类型 = 整数>
    参数 最大阶次 <类型 = 整数>
    参数 区间数 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeConstruct_ProjectCurveOnSurface.PerformByProjLib (@<对象>, @<输出c3d>, @<首个>, @<末个>, @<输出c2d>, @<连续性>, @<最大阶次>, @<区间数>)
    }

}

类 线框数据 <公开 注释 = "线框数据: 原类 ShapeExtend_WireData (libTKShHealing, 头文件 ShapeExtend/ShapeExtend_WireData.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 此类提供把线框作为有序边列表处理所需的数据结构, 这是许多算法所要求的. 此类的优势在于它允许处理不正确的线框. ShapeExtend_WireData 类的对象可以由 TopoDS_Wire 初始化, 并可转换回 TopoDS_Wire. 线框中的边由其序号定义. 提供了按给定序号访问, 添加和移除边的操作. 对整个线框, 还提供循环置换和反转(同时反转所有边的朝向和边的顺序)操作. 此类还提供一个方法检查线框中的边是否为缝合边(若线框位于某个面上). 此类按引用处理. 这种做法具有以下优势: 1. 共享此类对象极大地优化了以该类形式存储的线框上并行执行的分析与修复过程. 修复工具(如 ShapeFix_Wire)使用分析工具(如 ShapeAnalysis_Wire)逐个修复问题. 共享可以避免每次用修改后的 ShapeExtend_WireData 重新初始化分析工具, 从而节省一定时间. 2. 不复制内容. ShapeExtend_WireData 类对象尺寸相当大, 如果该类按值处理, 把它作为函数结果返回将导致额外的内容复制. 此外, 该类作为字段存储在其他类中, 而这些类又作为函数结果返回, 只存储指向 ShapeExtend_WireData 的句柄可节省时间和内存." @禁止创建对象 = 真>
{

    方法 创建 <公开 静态 类型 = 长整数 注释 = "创建. 原构造器: ShapeExtend_WireData. 官方简介: 空构造器, 创建不含边的空线框" @嵌入式方法 = "">
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.构造 ()
    }

    方法 创建_2 <公开 静态 类型 = 长整数 注释 = "创建_2. 原构造器: ShapeExtend_WireData. 官方简介: 构造器, 从 TopoDS_Wire 初始化数据. 调用 Init(wire,chained)." @嵌入式方法 = "">
    参数 线框 <类型 = 长整数>
    参数 链式 <类型 = 逻辑型>
    参数 流形模式 <类型 = 逻辑型>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.构造_2 (@<线框>, @<链式>, @<流形模式>)
    }

    方法 初始化 <公开 静态 注释 = "初始化. 原方法: Init. 官方简介: 从另一个 WireData 复制数据" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 另一个 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Init (@<对象>, @<另一个>)
    }

    方法 初始化_2 <公开 静态 类型 = 逻辑型 注释 = "初始化_2. 原方法: Init. 官方简介: 加载已存在的线框. 若 <chained> 为 True(默认), 则边按 TopoDS_Iterator 探查它们的顺序添加. 否则, 若 <chained> 为 False, 则线框由 BRepTools_WireExplorer 探查, 并保证边将顺序相连. 备注: 在后一种情况下可能无法找到所有边(因为 BRepTools_WireExplorer 对不连通线框和带缝合边的线框的局限)." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 线框 <类型 = 长整数>
    参数 链式 <类型 = 逻辑型>
    参数 流形模式 <类型 = 逻辑型>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Init_2 (@<对象>, @<线框>, @<链式>, @<流形模式>)
    }

    方法 清除 <公开 静态 注释 = "清除. 原方法: Clear. 官方简介: 清除关于线框的数据." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Clear (@<对象>)
    }

    方法 计算接缝 <公开 静态 注释 = "计算接缝. 原方法: ComputeSeams. 官方简介: 计算缝合边的列表. 默认情况下(直接调用), 强制执行计算. 对于间接调用(来自 IsSeam), 仅当尚未完成或边列表已改变时才重做. 备注: 缝合边是在列表中出现两次的边, 一次为 FORWARD, 一次为 REVERSED. 每个朝向都有自己的 PCurve, FORWARD 的那个必须首先设置." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 强制执行 <类型 = 逻辑型>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.ComputeSeams (@<对象>, @<强制执行>)
    }

    方法 设置末边 <公开 静态 注释 = "设置末边. 原方法: SetLast. 官方简介: 做循环置换, 以便把第 <num> 条边置于末尾" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 序号 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.SetLast (@<对象>, @<序号>)
    }

    方法 设置退化末个 <公开 静态 注释 = "设置退化末个. 原方法: SetDegeneratedLast. 官方简介: 当线框包含至少一条退化边时, 将其设为最后一条. 注意: 例如, 处理 pcurve 时这很有用: 由于 DGNR 的 pcurve 无法从其 3D 部分计算(不存在该部分), 需在其他边计算并串联之后再计算该 pcurve." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.SetDegeneratedLast (@<对象>)
    }

    方法 添加 <公开 静态 注释 = "添加. 原方法: Add. 官方简介: 向正在定义的(尚未结束的)线框添加一条边. 这是添加边的普通基本函数. <num> = 0 (D): 追加到末尾 <num> = 1: 前插到开头 否则, 插入到 <num> 之前 备注: 空边被直接忽略" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 边 <类型 = 长整数>
    参数 序号 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Add (@<对象>, @<边>, @<序号>)
    }

    方法 添加_2 <公开 静态 注释 = "添加_2. 原方法: Add. 官方简介: 添加整条线框, 视为边的列表 备注: 假定线框是有序的(使用 TopoDS_Iterator)" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 线框 <类型 = 长整数>
    参数 序号 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Add_2 (@<对象>, @<线框>, @<序号>)
    }

    方法 添加_3 <公开 静态 注释 = "添加_3. 原方法: Add. 官方简介: 以 WireData 形式添加线框" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 线框 <类型 = 长整数>
    参数 序号 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Add_3 (@<对象>, @<线框>, @<序号>)
    }

    方法 添加_4 <公开 静态 注释 = "添加_4. 原方法: Add. 官方简介: 添加边或线框并调用相应的 Add 方法" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 形状 <类型 = 长整数>
    参数 序号 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.Add_4 (@<对象>, @<形状>, @<序号>)
    }

    方法 添加有向 <公开 静态 注释 = "添加有向. 原方法: AddOriented. 官方简介: 按 <mode> 向 <me> 的起点或终点添加边 0: 添加到终点, 正向 1: 添加到终点, 反向 2: 添加到起点, 正向 3: 添加到起点, 反向 < 0: 不添加" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 边 <类型 = 长整数>
    参数 模式 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKShHealing.ShapeExtend_WireData.AddOriented (@<对象>, @<边>, @<模式>)
    }

    方法 添加有向_2 <公开 静态 注释 = "添加有向_2. 原方法: AddOriented. 官方简介: 按 <mode> 向 <me> 的起点或终点添加线框 0: 添加到终点, 正向 1: 添加到终点, 反向 2: 添加到起点, 正向 3: 添加到起点, 反向 < 0: 不添加" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 线框 <类型 = 长整数>
