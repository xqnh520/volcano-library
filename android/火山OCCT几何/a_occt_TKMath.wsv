    }

    方法 X <公开 静态 类型 = 小数 注释 = "X. 原方法: X. 官方简介: 对于该单位向量, 返回其 X 坐标." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Dir2d.X (@<对象>)
    }

    方法 Y <公开 静态 类型 = 小数 注释 = "Y. 原方法: Y. 官方简介: 对于该单位向量, 返回其 Y 坐标." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Dir2d.Y (@<对象>)
    }

    方法 XY <公开 静态 类型 = 长整数 注释 = "XY. 原方法: XY. 官方简介: 对于该单位向量, 返回其两个坐标组成的数对. 方向之间的比较 精度值是输入数据." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Dir2d.XY (@<对象>)
    }

    方法 是否相等 <公开 静态 类型 = 逻辑型 注释 = "是否相等. 原方法: IsEqual. 官方简介: 若两个向量具有相同方向则返回 True, 即该单位向量与单位向量 theOther 之间的夹角小于或等于 theAngularTolerance." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 另一个 <类型 = 长整数>
    参数 角度容差 <类型 = 小数>
