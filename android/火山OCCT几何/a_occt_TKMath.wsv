    }

    方法 齐次矢量部分 <公开 静态 类型 = 长整数 注释 = "齐次矢量部分. 原方法: HVectorialPart. 官方简介: 计算该变换的齐次向量部分. 它是一个 3*3 矩阵, 不包含缩放系数. 换言之, 该变换的向量部分等于其齐次向量部分乘以缩放系数. 该矩阵的系数必须乘以缩放系数才能得到该变换的系数." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.HVectorialPart (@<对象>)
    }

    方法 取值 <公开 静态 类型 = 小数 注释 = "取值. 原方法: Value. 官方简介: 返回变换矩阵的系数. 它是 3 行 X 4 列的矩阵. 该系数包含缩放因子. 若 theRow < 1 或 theRow > 3 或 theCol < 1 或 theCol > 4 则抛出 OutOfRange" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.Value (@<对象>, @<行>, @<列>)
    }

    方法 反转 <公开 静态 注释 = "反转. 原方法: Invert." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.Invert (@<对象>)
    }

    方法 反向 <公开 静态 类型 = 长整数 注释 = "反向. 原方法: Inverted. 官方简介: 计算反转变换 若变换的矩阵不可逆, 即缩放系数小于或等于 gp 包的 Resolution, 则抛出异常. 计算 T 与 <me> 复合的变换. 在 C++ 实现中你也可以写 Tcomposed = <me> * T. 示例: @code gp_Trsf T1, T2, Tcomp; ............... Tcomp = T2.Multiplied(T1); // or (Tcomp = T2 * T1) gp_Pnt P1(10.,3.,4.); gp_Pnt P2 = P1.Transformed(Tcomp); // using Tcomp gp_Pnt P3 = P1.Transformed(T1); // using T1 then T2 P3.Transform(T2); // P3 = P2 !!! @endcode" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.Inverted (@<对象>)
    }

    方法 相乘副本 <公开 静态 类型 = 长整数 注释 = "相乘副本. 原方法: Multiplied." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.Multiplied (@<对象>, @<T>)
    }

    方法 相乘 <公开 静态 注释 = "相乘. 原方法: Multiply. 官方简介: 计算 <me> 与 theT 复合的变换. <me> = <me> * theT" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.Multiply (@<对象>, @<T>)
    }

    方法 预相乘 <公开 静态 注释 = "预相乘. 原方法: PreMultiply. 官方简介: 计算 <me> 与 T 复合的变换. <me> = theT * <me>" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.PreMultiply (@<对象>, @<T>)
    }

    方法 幂 <公开 静态 注释 = "幂. 原方法: Power." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 N <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Trsf.Power (@<对象>, @<N>)
