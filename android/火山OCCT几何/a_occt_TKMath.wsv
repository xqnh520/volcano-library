        @ com.volcano.occt.Gen_TKMath.gp_Dir2d.Dot (@<对象>, @<另一个>)
    }

    方法 反转 <公开 静态 注释 = "反转. 原方法: Reverse." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Dir2d.Reverse (@<对象>)
