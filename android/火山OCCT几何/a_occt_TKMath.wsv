    }

    方法 变换_3 <公开 静态 类型 = 长整数 注释 = "变换_3. 原方法: Trsf." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf.Trsf (@<对象>)
    }

    方法 转储JSON <公开 静态 类型 = 文本型 注释 = "转储JSON. 原方法: DumpJson. 官方简介: 把自身内容转储到流中" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 深度 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf.DumpJson (@<对象>, @<深度>)
    }

}

