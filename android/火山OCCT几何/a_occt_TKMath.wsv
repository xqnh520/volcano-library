        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.IsSingular (@<对象>)
    }

    方法 成形 <公开 静态 类型 = 整数 注释 = "成形. 原方法: Form. 官方简介: 返回变换的性质. 它可以是恒等变换、旋转、平移、镜像变换(关于点或轴)、缩放变换、复合变换或某种其他类型的变换." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Form (@<对象>)
    }

    方法 平移部分 <公开 静态 类型 = 长整数 注释 = "平移部分. 原方法: TranslationPart. 官方简介: 返回 GTrsf2d 的平移部分." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.TranslationPart (@<对象>)
    }

    方法 矢量部分 <公开 静态 类型 = 长整数 注释 = "矢量部分. 原方法: VectorialPart. 官方简介: 计算 GTrsf2d 的向量部分. 返回的 Matrix 是 2*2 矩阵." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.VectorialPart (@<对象>)
    }

    方法 取值 <公开 静态 类型 = 小数 注释 = "取值. 原方法: Value. 官方简介: 返回变换的全局矩阵系数. 若 theRow < 1 或 theRow > 2 或 theCol < 1 或 theCol > 3 则抛出 OutOfRange" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 行 <类型 = 整数>
    参数 列 <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Value (@<对象>, @<行>, @<列>)
    }

    方法 反转 <公开 静态 注释 = "反转. 原方法: Invert." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Invert (@<对象>)
    }

    方法 反向 <公开 静态 类型 = 长整数 注释 = "反向. 原方法: Inverted. 官方简介: 计算逆变换. 若变换的矩阵不可逆则抛出异常." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Inverted (@<对象>)
    }

    方法 相乘副本 <公开 静态 类型 = 长整数 注释 = "相乘副本. 原方法: Multiplied. 官方简介: 计算 theT 与 <me> 复合的变换. 在 C++ 实现中你也可以写 Tcomposed = <me> * theT. 示例: @code gp_GTrsf2d T1, T2, Tcomp; ............... //composition : Tcomp = T2.Multiplied(T1); // or (Tcomp = T2 * T1) // transformation of a point gp_XY P(10.,3.); gp_XY P1(P); Tcomp.Transforms(P1); //using Tcomp gp_XY P2(P); T1.Transforms(P2); //using T1 then T2 T2.Transforms(P2); // P1 = P2 !!! @endcode" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Multiplied (@<对象>, @<T>)
    }

    方法 相乘 <公开 静态 注释 = "相乘. 原方法: Multiply." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Multiply (@<对象>, @<T>)
    }

    方法 预相乘 <公开 静态 注释 = "预相乘. 原方法: PreMultiply. 官方简介: 计算变换 theT 与该变换的乘积, 并把结果赋给该变换: this = theT * this" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 T <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.PreMultiply (@<对象>, @<T>)
    }

    方法 幂 <公开 静态 注释 = "幂. 原方法: Power." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 N <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Power (@<对象>, @<N>)
    }

    方法 幂副本 <公开 静态 类型 = 长整数 注释 = "幂副本. 原方法: Powered. 官方简介: 计算以下变换复合 <me> * <me> * .......* <me>, 共 theN 次. 若 theN = 0 则 <me> = 单位变换; 若 theN < 0 则 <me> = <me>.Inverse() *...........* <me>.Inverse()." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 N <类型 = 整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Powered (@<对象>, @<N>)
    }

    方法 变换 <公开 静态 注释 = "变换. 原方法: Transforms." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 输出坐标 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Transforms (@<对象>, @<输出坐标>)
    }

    方法 变换副本 <公开 静态 类型 = 长整数 注释 = "变换副本. 原方法: Transformed." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 坐标 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Transformed (@<对象>, @<坐标>)
    }

    方法 变换_2 <公开 静态 注释 = "变换_2. 原方法: Transforms. 官方简介: 把该变换应用于坐标: - 数对 Coord, 或 - X 与 Y." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 输出X <类型 = "小数 []">
    参数 输出Y <类型 = "小数 []">
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Transforms_2 (@<对象>, @<输出X>, @<输出Y>)
    }

    方法 二维变换 <公开 静态 类型 = 长整数 注释 = "二维变换. 原方法: Trsf2d. 官方简介: 把该变换转换为 gp_Trsf2d 变换. 若该变换无法转换, 即其形式为 gp_Other, 则抛出 Standard_ConstructionError 异常." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_GTrsf2d.Trsf2d (@<对象>)
    }

}

类 双曲线基元 <公开 注释 = "双曲线基元: 原类 gp_Hypr (libTKMath, 头文件 gp/gp_Hypr.hxx). 方法均为静态封装, 句柄用 OCCT核心.释放句柄 释放." 注释 = "官方简介: 描述三维空间中的双曲线分支. 双曲线由其长半轴和短半轴定义, 并借助坐标系(gp_Ax2 对象)定位在空间中, 其中: - 原点是双曲线中心, - \"X 方向\" 定义双曲线的长轴, 且 - \"Y 方向\" 定义双曲线的短轴. 该坐标系的原点, \"X 方向\" 和 \"Y 方向\" 一起定义双曲线所在的平面. 该坐标系是双曲线的 \"局部坐标系\". 在此坐标系中, 双曲线的方程为: X*X/(MajorRadius**2)-Y*Y/(MinorRadius**2) = 1.0 所描述的双曲线分支位于长轴的正侧. 局部坐标系的 \"主方向\" 是垂直于双曲线平面的法向量. 该向量赋予双曲线隐式朝向. 我们把局部坐标系的 \"主轴\" 称为双曲线的 \"轴\". 下图显示双曲线所在平面, 以及用函数 OtherBranch, ConjugateBranch1 和 ConjugateBranch2 构造的三条双曲线分支各自的相对位置: @code ^YAxis | FirstConjugateBranch | Other | Main --------------------- C ------------------------------>XAxis Branch | Branch | | SecondConjugateBranch | ^YAxis @endcode 警告: 长半轴可以小于短半轴. 另见 gce_MakeHypr, 它提供更复杂的双曲线构造函数; Geom_Hyperbola, 它提供构造双曲线的附加函数, 特别是处理双曲线的参数方程." @禁止创建对象 = 真>
{

    方法 创建 <公开 静态 类型 = 长整数 注释 = "创建. 原构造器: gp_Hypr. 官方简介: 创建一条未定义的双曲线." @嵌入式方法 = "">
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.构造 ()
    }

    方法 创建_2 <公开 静态 类型 = 长整数 注释 = "创建_2. 原构造器: gp_Hypr. 官方简介: 创建半径为 theMajorRadius 与 theMinorRadius 的双曲线, 由坐标系统 theA2 在空间中定位, 使得: - theA2 的原点是双曲线的中心, - theA2 的 \"X Direction\" 定义双曲线的长轴, 即长半径 theMajorRadius 沿该轴测量, 且 - theA2 的 \"Y Direction\" 定义双曲线的短轴, 即短半径 theMinorRadius 沿该轴测量. 注意: 该类不阻止创建以下双曲线: - theMajorAxis 等于 theMinorAxis, 或 - theMajorAxis 小于 theMinorAxis. 异常: 若 theMajorAxis 或 theMinorAxis 为负则抛出 Standard_ConstructionError. 若 theMajorRadius < 0.0 或 theMinorRadius < 0.0 则抛出 ConstructionError 若 theMajorRadius < 0.0 或 theMinorRadius < 0.0 则抛出异常" @嵌入式方法 = "">
    参数 A2 <类型 = 长整数>
    参数 长半径 <类型 = 小数>
    参数 短半径 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.构造_2 (@<A2>, @<长半径>, @<短半径>)
    }

    方法 设置轴 <公开 静态 注释 = "设置轴. 原方法: SetAxis. 官方简介: 修改该双曲线, 重新定义其局部坐标系, 使得: - 其原点与 \"main Direction\" 变为轴 theA1 的原点与方向(\"X Direction\" 与 \"Y Direction\" 随后按任意 gp_Ax2 的方式重新计算). 若 theA1 的方向平行于该双曲线 \"XAxis\" 的方向则抛出 ConstructionError." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 A1 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.SetAxis (@<对象>, @<A1>)
    }

    方法 设置位置 <公开 静态 注释 = "设置位置. 原方法: SetLocation. 官方简介: 通过重新定义局部坐标系使原点变为 theP 来修改该双曲线." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 P <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.SetLocation (@<对象>, @<P>)
    }

    方法 设置长半径 <公开 静态 注释 = "设置长半径. 原方法: SetMajorRadius. 官方简介: 修改该双曲线的长半径. 若 theMajorRadius 为负则抛出 Standard_ConstructionError 异常." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 长半径 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.SetMajorRadius (@<对象>, @<长半径>)
    }

    方法 设置短半径 <公开 静态 注释 = "设置短半径. 原方法: SetMinorRadius. 官方简介: 修改该双曲线的短半径. 若 theMinorRadius 为负则抛出 Standard_ConstructionError 异常." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 短半径 <类型 = 小数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.SetMinorRadius (@<对象>, @<短半径>)
    }

    方法 设置位置_2 <公开 静态 注释 = "设置位置_2. 原方法: SetPosition. 官方简介: 通过重定义该双曲线的局部坐标系使其成为 A2 来修改该双曲线." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    参数 A2 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.SetPosition (@<对象>, @<A2>)
    }

    方法 渐近线1 <公开 静态 类型 = 长整数 注释 = "渐近线1. 原方法: Asymptote1. 官方简介: 在双曲线的局部坐标系中, 双曲线的方程为 (X*X)/(A*A) - (Y*Y)/(B*B) = 1.0, 第一条渐近线的方程为 Y = (B/A)*X, 其中 A 是长半径, B 是短半径. 若 MajorRadius = 0.0 则抛出 ConstructionError." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Asymptote1 (@<对象>)
    }

    方法 渐近线2 <公开 静态 类型 = 长整数 注释 = "渐近线2. 原方法: Asymptote2. 官方简介: 在双曲线的局部坐标系中, 双曲线的方程为 (X*X)/(A*A) - (Y*Y)/(B*B) = 1.0, 第一条渐近线的方程为 Y = -(B/A)*X. 其中 A 是长半径, B 是短半径. 若 MajorRadius = 0.0 则抛出 ConstructionError." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Asymptote2 (@<对象>)
    }

    方法 轴 <公开 静态 类型 = 长整数 注释 = "轴. 原方法: Axis. 官方简介: 返回通过中心且垂直于该双曲线所在平面的轴." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Axis (@<对象>)
    }

    方法 共轭分支1 <公开 静态 类型 = 长整数 注释 = "共轭分支1. 原方法: ConjugateBranch1. 官方简介: 计算位于 <me> 的 \"YAxis\" 正侧的双曲线分支." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.ConjugateBranch1 (@<对象>)
    }

    方法 共轭分支2 <公开 静态 类型 = 长整数 注释 = "共轭分支2. 原方法: ConjugateBranch2. 官方简介: 计算位于 <me> 的 \"YAxis\" 负侧的双曲线分支." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.ConjugateBranch2 (@<对象>)
    }

    方法 准线1 <公开 静态 类型 = 长整数 注释 = "准线1. 原方法: Directrix1. 官方简介: 该准线是在局部平面(Z = 0)内垂直于双曲线 XAxis 的直线, 与双曲线中心的距离为 d = MajorRadius / e, 其中 e 是双曲线的离心率. 该直线平行于 \"YAxis\". directrix1 与 \"XAxis\" 的交点是 directrix1 的 \"位置点\". 该点位于 \"XAxis\" 的正侧." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Directrix1 (@<对象>)
    }

    方法 准线2 <公开 静态 类型 = 长整数 注释 = "准线2. 原方法: Directrix2. 官方简介: 该直线由 \"Directrix1\" 关于双曲线 \"Y 轴\" 作对称变换得到." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Directrix2 (@<对象>)
    }

    方法 离心率 <公开 静态 类型 = 小数 注释 = "离心率. 原方法: Eccentricity. 官方简介: 返回双曲线的离心率(e > 1). 若 f 是双曲线位置与 Focus1 之间的距离, 则离心率 e = f / MajorRadius. 若 MajorRadius = 0.0 则抛出 DomainError" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Eccentricity (@<对象>)
    }

    方法 焦距 <公开 静态 类型 = 小数 注释 = "焦距. 原方法: Focal. 官方简介: 计算焦距. 它是双曲线的两个焦点之间的距离." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Focal (@<对象>)
    }

    方法 焦点1 <公开 静态 类型 = 长整数 注释 = "焦点1. 原方法: Focus1. 官方简介: 返回双曲线的第一焦点. 该焦点位于双曲线 \"X 轴\" 的正侧." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Focus1 (@<对象>)
    }

    方法 焦点2 <公开 静态 类型 = 长整数 注释 = "焦点2. 原方法: Focus2. 官方简介: 返回双曲线的第二焦点. 该焦点位于双曲线 \"X 轴\" 的负侧." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Focus2 (@<对象>)
    }

    方法 位置 <公开 静态 类型 = 长整数 注释 = "位置. 原方法: Location. 官方简介: 返回双曲线的定位点. 它是 \"XAxis\" 与 \"YAxis\" 的交点." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Location (@<对象>)
    }

    方法 长半径 <公开 静态 类型 = 小数 注释 = "长半径. 原方法: MajorRadius. 官方简介: 返回双曲线的长半径. 它是双曲线 \"XAxis\" 上的半径." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.MajorRadius (@<对象>)
    }

    方法 短半径 <公开 静态 类型 = 小数 注释 = "短半径. 原方法: MinorRadius. 官方简介: 返回双曲线的短半径. 它是双曲线 \"YAxis\" 上的半径." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.MinorRadius (@<对象>)
    }

    方法 另一个分支 <公开 静态 类型 = 长整数 注释 = "另一个分支. 原方法: OtherBranch. 官方简介: 返回把 <me> 关于其 \"YAxis\" 作对称变换得到的双曲线分支." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.OtherBranch (@<对象>)
    }

    方法 参数 <公开 静态 类型 = 小数 注释 = "参数. 原方法: Parameter. 官方简介: 返回 p = (e * e - 1) * MajorRadius, 其中 e 是双曲线的离心率. 若 MajorRadius = 0.0 则抛出 DomainError" @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
        @ com.volcano.occt.Gen_TKMath.gp_Hypr.Parameter (@<对象>)
    }

    方法 位置_2 <公开 静态 类型 = 长整数 注释 = "位置_2. 原方法: Position. 官方简介: 返回双曲线的坐标系." @嵌入式方法 = "">
    参数 对象 <类型 = 长整数>
    {
