<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.组件.MP图表

类 MP图表基础类 <公开 基础类 = 窗口组件 注释 = "★ 封装自 MPAndroidChart v3.1.0 com.github.mikephil.charting.charts.Chart."
        @安卓.外部库 = "src\\libs\\MPChartLib-release.aar" @禁止创建对象 = 真 @java.导入 = "com.github.mikephil.charting.charts.Chart" @安卓.编译时系统需求 = 28>
{

    # @ @m<DEFINE_ABS_CONTROL2> (MP图表基础类, Chart, com.github.mikephil.charting.charts.Chart)
    #

    方法 支持值选中监听 <公开 属性写 注释 = "设置当前图表是否把选中回调发成火山事件. 未开启则不发事件.">
    参数 是否监听 <类型 = 逻辑型>
    {
        @ if (@<是否监听>){
        @     GetChart ().setOnChartValueSelectedListener(new com.github.mikephil.charting.listener.OnChartValueSelectedListener(){
        @         @Override public void onValueSelected(com.github.mikephil.charting.data.Entry e, com.github.mikephil.charting.highlight.Highlight h) { @<值内容被选中>(e, h); }
        @         @Override public void onNothingSelected() { @<值内容脱离选中>(); }
        @     });
        @ }else{
        @     GetChart ().setOnChartValueSelectedListener(null);
        @ }
    }

    方法 值内容被选中 <公开 定义事件 类型 = 整数 注释 = "图表中的数据点被选中时响应.">
    参数 数据点 <类型 = MP数据点类 注释 = "被选中的数据点.">
    参数 高亮信息 <类型 = MP高亮信息类 注释 = "本次选中对应的高亮信息.">

    方法 值内容脱离选中 <公开 定义事件 类型 = 整数 注释 = "图表中的数据点脱离选中状态时响应.">


