类 XUI范围滑块 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.picker.XRangeSlider)."
        @文档 = "category = \"XUI.选择器\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.picker.XRangeSlider\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.xrs_verticalPadding\n        shown_name = \"控件的垂直间距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_insideRangeLineColor\n        shown_name = \"选中范围的线条颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xrs_outsideRangeLineColor\n        shown_name = \"不在选中范围的线条颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xrs_insideRangeLineStrokeWidth\n        shown_name = \"选中范围的线条宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_outsideRangeLineStrokeWidth\n        shown_name = \"不在选中范围的线条宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_min\n        shown_name = \"滑块选择的最小值\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.xrs_max\n        shown_name = \"滑块选择的最大值\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.xrs_sliderIcon\n        shown_name = \"滑块的图标\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.xrs_sliderIconFocus\n        shown_name = \"滑块触摸时的图标\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.xrs_isLineRound\n        shown_name = \"线条是否有圆角\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.xrs_isShowBubble\n        shown_name = \"是否显示数字气泡\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.xrs_isFitColor\n        shown_name = \"是否自适应气泡和数字文字的颜色\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.xrs_bubbleResource\n        shown_name = \"气泡的背景资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.xrs_numberTextColor\n        shown_name = \"气泡数字的文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xrs_numberTextSize\n        shown_name = \"气泡数字的文字大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_numberMarginBottom\n        shown_name = \"气泡距离底部的距离\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_isShowRuler\n        shown_name = \"是否显示刻度尺\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.xrs_rulerColor\n        shown_name = \"刻度尺的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xrs_rulerTextColor\n        shown_name = \"刻度尺文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xrs_rulerTextSize\n        shown_name = \"刻度尺文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_rulerMarginTop\n        shown_name = \"刻度尺刻度距离顶部的距离\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_rulerDividerHeight\n        shown_name = \"刻度尺刻度的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_rulerTextMarginTop\n        shown_name = \"刻度尺刻度文字距离上部的距离\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xrs_rulerInterval\n        shown_name = \"刻度尺刻度的间隔\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = ten\n            shown_name = \"ten\"\n        }\n        item\n        {\n            name = twenty\n            shown_name = \"twenty\"\n        }\n        item\n        {\n            name = forty\n            shown_name = \"forty\"\n        }\n        item\n        {\n            name = fifty\n            shown_name = \"fifty\"\n        }\n        item\n        {\n            name = hundred\n            shown_name = \"hundred\"\n        }\n    }\n}">
