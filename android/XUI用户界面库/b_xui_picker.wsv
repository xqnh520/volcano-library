类 XUI刻度尺 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.picker.RulerView)."
        @文档 = "category = \"XUI.选择器\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.picker.RulerView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.rv_rulerHeight\n        shown_name = \"尺子的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_rulerToResultGap\n        shown_name = \"尺子距离结果的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_scaleGap\n        shown_name = \"刻度间距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_scaleLimit\n        shown_name = \"相邻2个刻度之间的数量\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.rv_scaleCount\n        shown_name = \"刻度数\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.rv_firstScale\n        shown_name = \"默认选中的刻度\"\n        data_type = double\n    }\n    attr\n    {\n        name = app.rv_maxScale\n        shown_name = \"最大刻度\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.rv_minScale\n        shown_name = \"最小刻度\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.rv_bgColor\n        shown_name = \"背景色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rv_smallScaleColor\n        shown_name = \"小刻度的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rv_midScaleColor\n        shown_name = \"中刻度的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rv_largeScaleColor\n        shown_name = \"大刻度的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rv_scaleNumColor\n        shown_name = \"刻度数的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rv_resultNumColor\n        shown_name = \"结果字体的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rv_unit\n        shown_name = \"单位\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.rv_unitColor\n        shown_name = \"单位颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rv_smallScaleStroke\n        shown_name = \"小刻度的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_midScaleStroke\n        shown_name = \"中刻度的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_largeScaleStroke\n        shown_name = \"大刻度的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_resultNumTextSize\n        shown_name = \"结果字体大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_scaleNumTextSize\n        shown_name = \"刻度字体大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_unitTextSize\n        shown_name = \"单位字体大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.rv_showScaleResult\n        shown_name = \"是否显示结果值\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.rv_isBgRoundRect\n        shown_name = \"背景是否圆角\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.rv_roundRadius\n        shown_name = \"圆角大小\"\n        data_type = double\n        detail_type = dim\n    }\n}">
