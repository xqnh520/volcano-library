    }

    方法 取原生对象 <公开 类型 = 对象类 注释 = "返回底层 SuperTextView 原生对象，供嵌入行调用未封装的方法。" @嵌入式方法 = "">
    {
        @ @sn<this>.GetXUISuperTextView ()
    }
