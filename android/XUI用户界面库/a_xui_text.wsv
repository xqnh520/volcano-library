    方法 右侧文字颜色 <公开 属性写 @值细节类型 = 颜色 注释 = "用法：设置XUI超级文本框的右侧文字颜色, 传入新值后立刻生效。 参数：新颜色=整数。 返回：无。 原方法：XUI超级文本框.setRightTextColor()">
    参数 新颜色 <类型 = 整数>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setRightTextColor (@<新颜色>))
    }

    方法 左侧图标 <公开 属性写 注释 = "设置左侧图标（资源 ID）。">
    参数 图标资源 <类型 = 整数>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setLeftIcon (@<图标资源>))
    }

    方法 右侧图标 <公开 属性写 注释 = "设置右侧图标（资源 ID）。">
    参数 图标资源 <类型 = 整数>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setRightIcon (@<图标资源>))
    }

    方法 取中间编辑框内容 <公开 类型 = 文本型 注释 = "返回中间编辑框中的内容。" @嵌入式方法 = "">
    {
        @ @sn<this>.GetXUISuperTextView ().getCenterEditValue ()
    }

    方法 选中状态 <公开 属性读 类型 = 逻辑型 注释 = "返回右侧复选框是否选中。" @嵌入式方法 = "">
    {
        @ @sn<this>.GetXUISuperTextView ().getCheckBoxIsChecked ()
    }

    方法 选中状态 <公开 属性写 注释 = "设置右侧复选框选中状态。">
    参数 新状态 <类型 = 逻辑型>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setCheckBoxChecked (@<新状态>))
    }

    方法 开关状态 <公开 属性读 类型 = 逻辑型 注释 = "返回右侧开关是否打开。" @嵌入式方法 = "">
    {
        @ @sn<this>.GetXUISuperTextView ().getSwitchIsChecked ()
