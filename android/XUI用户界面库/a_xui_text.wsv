<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.XUI <注释 = "XUI 安卓 UI 工具库封装" @文档 = "category = \"XUI\"">

类 XUI超级文本框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.textview.supertextview.SuperTextView)." 注释 = "支持左中右三列、每列上中下三段文字与图标的组合行组件。"
        @文档 = "category = \"XUI.文本\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.textview.supertextview.SuperTextView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.sLeftTextString\n        shown_name = \"左侧文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.sCenterTextString\n        shown_name = \"中间文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.sRightTextString\n        shown_name = \"右侧文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.sLeftTextColor\n        shown_name = \"左侧文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sCenterTextColor\n        shown_name = \"中间文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sRightTextColor\n        shown_name = \"右侧文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sLeftTextSize\n        shown_name = \"左侧文字大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sDividerLineColor\n        shown_name = \"分割线颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sDividerLineHeight\n        shown_name = \"分割线高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sUseRipple\n        shown_name = \"启用涟漪效果\"\n        data_type = boolean\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUI超级文本框, XUISuperTextView, com.xuexiang.xui.widget.textview.supertextview.SuperTextView)

    # 属性 ---

    方法 左边文字 <公开 属性读 类型 = 文本型 @嵌入式方法 = "" 注释 = "用法：读取XUI超级文本框的左边文字当前值。 参数：无。 返回：文本型。 原方法：XUI超级文本框.getLeftString()">
    {
        @ @sn<this>.GetXUISuperTextView ().getLeftString ()
    }

    方法 左边文字 <公开 属性写 注释 = "用法：设置XUI超级文本框的左边文字, 传入新值后立刻生效。 参数：新文字=文本。 返回：无。 原方法：XUI超级文本框.setLeftString()">
    参数 新文字 <类型 = 文本型>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setLeftString (@<新文字>))
    }

    方法 中间文字 <公开 属性读 类型 = 文本型 @嵌入式方法 = "" 注释 = "用法：读取XUI超级文本框的中间文字当前值。 参数：无。 返回：文本型。 原方法：XUI超级文本框.getCenterString()">
    {
        @ @sn<this>.GetXUISuperTextView ().getCenterString ()
    }

    方法 中间文字 <公开 属性写 注释 = "用法：设置XUI超级文本框的中间文字, 传入新值后立刻生效。 参数：新文字=文本。 返回：无。 原方法：XUI超级文本框.setCenterString()">
    参数 新文字 <类型 = 文本型>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setCenterString (@<新文字>))
    }

    方法 右边文字 <公开 属性读 类型 = 文本型 @嵌入式方法 = "" 注释 = "用法：读取XUI超级文本框的右边文字当前值。 参数：无。 返回：文本型。 原方法：XUI超级文本框.getRightString()">
    {
        @ @sn<this>.GetXUISuperTextView ().getRightString ()
    }

    方法 右边文字 <公开 属性写 注释 = "用法：设置XUI超级文本框的右边文字, 传入新值后立刻生效。 参数：新文字=文本。 返回：无。 原方法：XUI超级文本框.setRightString()">
    参数 新文字 <类型 = 文本型>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setRightString (@<新文字>))
    }

