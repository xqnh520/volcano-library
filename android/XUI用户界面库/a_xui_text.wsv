    参数 新文字 <类型 = 文本型>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setCenterTopString (@<新文字>))
    }

    方法 中下文字 <公开 属性写 注释 = "设置中间下方文字。">
    参数 新文字 <类型 = 文本型>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setCenterBottomString (@<新文字>))
    }

    方法 右上文字 <公开 属性写 注释 = "设置右上角文字。">
    参数 新文字 <类型 = 文本型>
    {
        @ @m<RUN_UI_ACTION> (GetXUISuperTextView ().setRightTopString (@<新文字>))
