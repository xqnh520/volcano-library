类 XUI圆形进度视图 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.progress.CircleProgressView)."
        @文档 = "category = \"XUI.进度\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.progress.CircleProgressView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.cpv_start_progress\n        shown_name = \"起始进度\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.cpv_end_progress\n        shown_name = \"终止进度\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.cpv_start_color\n        shown_name = \"渐变效果的起始颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.cpv_end_color\n        shown_name = \"渐变效果的终止颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.cpv_isTracked\n        shown_name = \"是否显示轨迹背景\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.cpv_track_width\n        shown_name = \"轨迹宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.cpv_progress_width\n        shown_name = \"进度条的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.cpv_track_color\n        shown_name = \"轨迹背景的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.cpv_progress_duration\n        shown_name = \"动画时长\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.cpv_progress_textVisibility\n        shown_name = \"是否显示进度值文本\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.cpv_progress_textColor\n        shown_name = \"进度值的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.cpv_progress_textSize\n        shown_name = \"进度值的文本字体大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.cpv_animate_type\n        shown_name = \"动画类型\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = AccelerateDecelerateInterpolator\n            shown_name = \"AccelerateDecelerateInterpolator\"\n        }\n        item\n        {\n            name = LinearInterpolator\n            shown_name = \"LinearInterpolator\"\n        }\n        item\n        {\n            name = AccelerateInterpolator\n            shown_name = \"AccelerateInterpolator\"\n        }\n        item\n        {\n            name = DecelerateInterpolator\n            shown_name = \"DecelerateInterpolator\"\n        }\n        item\n        {\n            name = OvershootInterpolator\n            shown_name = \"OvershootInterpolator\"\n        }\n    }\n    attr\n    {\n        name = app.cpv_isFilled\n        shown_name = \"是否内部填充\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.cpv_circle_broken\n        shown_name = \"是选择圆形还是弧形进度条[true:\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.cpv_isGraduated\n        shown_name = \"圆弧是否是分层级的\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.cpv_scaleZone_width\n        shown_name = \"指示条的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.cpv_scaleZone_length\n        shown_name = \"指示条的长度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.cpv_scaleZone_corner_radius\n        shown_name = \"指示条的圆角\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.cpv_scaleZone_padding\n        shown_name = \"指示条的padding\"\n        data_type = double\n        detail_type = dim\n    }\n}">
