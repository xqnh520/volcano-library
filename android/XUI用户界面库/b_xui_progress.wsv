   {\n            name = LinearInterpolator\n            shown_name = \"LinearInterpolator\"\n        }\n        item\n        {\n            name = AccelerateInterpolator\n            shown_name = \"AccelerateInterpolator\"\n        }\n        item\n        {\n            name = DecelerateInterpolator\n            shown_name = \"DecelerateInterpolator\"\n        }\n        item\n        {\n            name = OvershootInterpolator\n            shown_name = \"OvershootInterpolator\"\n        }\n    }\n    attr\n    {\n        name = app.hpv_corner_radius\n        shown_name = \"圆角半径\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.hpv_text_padding_bottom\n        shown_name = \"文字距离view的padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.hpv_text_movedEnable\n        shown_name = \"设置进度值是否跟随控件动画移动\"\n        data_type = boolean\n    }\n}">
