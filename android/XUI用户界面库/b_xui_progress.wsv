类 XUI评分条 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.progress.ratingbar.RatingBar)."
        @文档 = "category = \"XUI.进度\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.progress.ratingbar.RatingBar\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.srb_numStars\n        shown_name = \"总共最大的星级数\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.srb_minimumStars\n        shown_name = \"最小星级数\"\n        data_type = double\n    }\n    attr\n    {\n        name = app.srb_rating\n        shown_name = \"当前的星级\"\n        data_type = double\n    }\n    attr\n    {\n        name = app.srb_starPadding\n        shown_name = \"星星之间的间距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.srb_drawableEmpty\n        shown_name = \"星星为空时的图案\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.srb_drawableFilled\n        shown_name = \"星星填充时的图案\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.srb_isIndicator\n        shown_name = \"是否只是指示器\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.srb_scrollable\n        shown_name = \"是否可以滑动设置评分\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.srb_clickable\n        shown_name = \"是否可以点击设置评分\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.srb_clearRatingEnabled\n        shown_name = \"重复点击是否可以清空评分\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.srb_starWidth\n        shown_name = \"星星的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.srb_starHeight\n        shown_name = \"星星的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.srb_stepSize\n        shown_name = \"星星的进度单位\"\n        data_type = double\n    }\n}">
