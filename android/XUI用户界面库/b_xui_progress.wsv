类 XUIMaterial进度条 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.progress.materialprogressbar.MaterialProgressBar)."
        @文档 = "category = \"XUI.进度\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.progress.materialprogressbar.MaterialProgressBar\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.mpb_progressStyle\n        shown_name = \"进度条的样式：环形或水平\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = circular\n            shown_name = \"circular\"\n        }\n        item\n        {\n            name = horizontal\n            shown_name = \"horizontal\"\n        }\n    }\n    attr\n    {\n        name = app.mpb_setBothDrawables\n        shown_name = \"无论进度 determinate\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.mpb_useIntrinsicPadding\n        shown_name = \"是否使用进度条内部的padding\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.mpb_showProgressBackground\n        shown_name = \"进度条是否必须有背景\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.mpb_determinateCircularProgressStyle\n        shown_name = \"进度确定的环形进度条样式：norma\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = normal\n            shown_name = \"normal\"\n        }\n        item\n        {\n            name = dynamic\n            shown_name = \"dynamic\"\n        }\n    }\n    attr\n    {\n        name = app.mpb_progressTint\n        shown_name = \"进度条的主色调\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.mpb_progressTintMode\n        shown_name = \"进度条色调的叠加模式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = src_over\n            shown_name = \"src_over\"\n        }\n        item\n        {\n            name = src_in\n            shown_name = \"src_in\"\n        }\n        item\n        {\n            name = src_atop\n            shown_name = \"src_atop\"\n        }\n        item\n        {\n            name = multiply\n            shown_name = \"multiply\"\n        }\n        item\n        {\n            name = screen\n            shown_name = \"screen\"\n        }\n        item\n        {\n            name = add\n            shown_name = \"add\"\n        }\n    }\n    attr\n    {\n        name = app.mpb_secondaryProgressTint\n        shown_name = \"进度条的次色调\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.mpb_secondaryProgressTintMode\n        shown_name = \"进度条次色调的叠加模式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = src_over\n            shown_name = \"src_over\"\n        }\n        item\n        {\n            name = src_in\n            shown_name = \"src_in\"\n        }\n        item\n        {\n            name = src_atop\n            shown_name = \"src_atop\"\n        }\n        item\n        {\n            name = multiply\n            shown_name = \"multiply\"\n        }\n        item\n        {\n            name = screen\n            shown_name = \"screen\"\n        }\n        item\n        {\n            name = add\n            shown_name = \"add\"\n        }\n    }\n    attr\n    {\n        name = app.mpb_progressBackgroundTint\n        shown_name = \"进度条背景的色调\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.mpb_progressBackgroundTintMode\n        shown_name = \"进度条背景色调的叠加模式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = src_over\n            shown_name = \"src_over\"\n        }\n        item\n        {\n            name = src_in\n            shown_name = \"src_in\"\n        }\n        item\n        {\n            name = src_atop\n            shown_name = \"src_atop\"\n        }\n        item\n        {\n            name = multiply\n            shown_name = \"multiply\"\n        }\n        item\n        {\n            name = screen\n            shown_name = \"screen\"\n        }\n        item\n        {\n            name = add\n            shown_name = \"add\"\n        }\n    }\n    attr\n    {\n        name = app.mpb_indeterminateTint\n        shown_name = \"不确定进度的进度条色调\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.mpb_indeterminateTintMode\n        shown_name = \"不确定进度的进度条色调的叠加模式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = src_over\n            shown_name = \"src_over\"\n        }\n        item\n        {\n            name = src_in\n            shown_name = \"src_in\"\n        }\n        item\n        {\n            name = src_atop\n            shown_name = \"src_atop\"\n        }\n        item\n        {\n            name = multiply\n            shown_name = \"multiply\"\n        }\n        item\n        {\n            name = screen\n            shown_name = \"screen\"\n        }\n        item\n        {\n            name = add\n            shown_name = \"add\"\n        }\n    }\n}">
