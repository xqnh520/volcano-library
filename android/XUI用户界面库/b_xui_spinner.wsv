类 XUI下拉菜单 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.spinner.DropDownMenu)."
        @文档 = "category = \"XUI.下拉框\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.spinner.DropDownMenu\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.ddm_dividerColor\n        shown_name = \"菜单垂直分割线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ddm_dividerWidth\n        shown_name = \"菜单垂直分割线的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ddm_dividerMargin\n        shown_name = \"菜单垂直分割线的Margin\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ddm_underlineColor\n        shown_name = \"菜单底线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ddm_underlineHeight\n        shown_name = \"菜单底线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ddm_maskColor\n        shown_name = \"半透明遮罩颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ddm_menuTextSize\n        shown_name = \"菜单文字的字体大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ddm_menuTextPaddingHorizontal\n        shown_name = \"菜单文字水平padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ddm_menuTextPaddingVertical\n        shown_name = \"菜单文字垂直padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ddm_menuTextSelectedColor\n        shown_name = \"菜单文字选中的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ddm_menuTextUnselectedColor\n        shown_name = \"菜单文字未选中的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ddm_menuSelectedIcon\n        shown_name = \"菜单选择时的图标\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.ddm_menuUnselectedIcon\n        shown_name = \"菜单未选择时的图标\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.ddm_menuBackgroundColor\n        shown_name = \"菜单的背景颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ddm_menuHeightPercent\n        shown_name = \"选择菜单的高度/屏幕高度 占比\"\n        data_type = double\n    }\n}">
