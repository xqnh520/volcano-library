类 XUI可编辑下拉框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.spinner.editspinner.EditSpinner)."
        @文档 = "category = \"XUI.下拉框\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.spinner.editspinner.EditSpinner\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.es_hint\n        shown_name = \"输入提示\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.es_height\n        shown_name = \"输入框的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.es_textSize\n        shown_name = \"输入框的字体大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.es_textColor\n        shown_name = \"输入框的字体颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.es_arrowMargin\n        shown_name = \"箭头图标的margin\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.es_arrowImage\n        shown_name = \"箭头图标的资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.es_background\n        shown_name = \"输入框的背景\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.es_maxLine\n        shown_name = \"maxLine\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.es_dropdown_bg\n        shown_name = \"下拉框 下拉条目的背景\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.es_enable\n        shown_name = \"输入下拉框是否可编辑\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.es_maxLength\n        shown_name = \"输入下拉框可输入的最大字符长度\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.es_maxEms\n        shown_name = \"输入下拉框可输入的最大字符宽度\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.es_isShowFilterData\n        shown_name = \"输入下拉框在输入时是否显示筛选到的信\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.es_isFilterKey\n        shown_name = \"输入下拉框显示筛选信息时\"\n        data_type = boolean\n    }\n}">
