类 XUIMaterial下拉框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.spinner.materialspinner.MaterialSpinner)."
        @文档 = "category = \"XUI.下拉框\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.spinner.materialspinner.MaterialSpinner\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.ms_arrow_image\n        shown_name = \"下拉框箭头的资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.ms_arrow_tint\n        shown_name = \"下拉框箭头的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ms_hide_arrow\n        shown_name = \"下拉框是否有箭头\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.ms_background_color\n        shown_name = \"下拉框背景的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ms_background_selector\n        shown_name = \"下拉框背景点击的效果\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.ms_text_color\n        shown_name = \"下拉框字体的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.ms_dropdown_max_height\n        shown_name = \"下拉框 下拉条目最大的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ms_dropdown_height\n        shown_name = \"下拉框 下拉条目的样式\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.ms_dropdown_bg\n        shown_name = \"下拉框 下拉条目的背景\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.ms_in_dialog\n        shown_name = \"是否在dialog中\"\n        data_type = boolean\n    }\n}">
