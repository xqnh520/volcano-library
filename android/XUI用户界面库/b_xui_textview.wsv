        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.textview.supertextview.SuperButton\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.sGravity\n        shown_name = \"sGravity\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = center\n            shown_name = \"center\"\n        }\n        item\n        {\n            name = left\n            shown_name = \"left\"\n        }\n        item\n        {\n            name = right\n            shown_name = \"right\"\n        }\n        item\n        {\n            name = top\n            shown_name = \"top\"\n        }\n        item\n        {\n            name = bottom\n            shown_name = \"bottom\"\n        }\n    }\n    attr\n    {\n        name = app.sShapeType\n        shown_name = \"sShapeType\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = rectangle\n            shown_name = \"rectangle\"\n        }\n        item\n        {\n            name = oval\n            shown_name = \"oval\"\n        }\n        item\n        {\n            name = line\n            shown_name = \"line\"\n        }\n        item\n        {\n            name = ring\n            shown_name = \"ring\"\n        }\n    }\n    attr\n    {\n        name = app.sSolidColor\n        shown_name = \"sSolidColor\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sSelectorPressedColor\n        shown_name = \"sSelectorPressedCo\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sSelectorDisableColor\n        shown_name = \"sSelectorDisableCo\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sSelectorNormalColor\n        shown_name = \"sSelectorNormalCol\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sCornersRadius\n        shown_name = \"sCornersRadius\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sCornersTopLeftRadius\n        shown_name = \"sCornersTopLeftRad\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sCornersTopRightRadius\n        shown_name = \"sCornersTopRightRa\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sCornersBottomLeftRadius\n        shown_name = \"sCornersBottomLeft\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sCornersBottomRightRadius\n        shown_name = \"sCornersBottomRigh\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sStrokeWidth\n        shown_name = \"sStrokeWidth\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sStrokeDashWidth\n        shown_name = \"sStrokeDashWidth\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sStrokeDashGap\n        shown_name = \"sStrokeDashGap\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sStrokeColor\n        shown_name = \"sStrokeColor\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sSizeWidth\n        shown_name = \"sSizeWidth\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sSizeHeight\n        shown_name = \"sSizeHeight\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sGradientOrientation\n        shown_name = \"sGradientOrientati\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = TOP_BOTTOM\n            shown_name = \"TOP_BOTTOM\"\n        }\n        item\n        {\n            name = TR_BL\n            shown_name = \"TR_BL\"\n        }\n        item\n        {\n            name = RIGHT_LEFT\n            shown_name = \"RIGHT_LEFT\"\n        }\n        item\n        {\n            name = BR_TL\n            shown_name = \"BR_TL\"\n        }\n        item\n        {\n            name = BOTTOM_TOP\n            shown_name = \"BOTTOM_TOP\"\n        }\n        item\n        {\n            name = BL_TR\n            shown_name = \"BL_TR\"\n        }\n        item\n        {\n            name = LEFT_RIGHT\n            shown_name = \"LEFT_RIGHT\"\n        }\n        item\n        {\n            name = TL_BR\n            shown_name = \"TL_BR\"\n        }\n    }\n    attr\n    {\n        name = app.sGradientCenterX\n        shown_name = \"sGradientCenterX\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sGradientCenterY\n        shown_name = \"sGradientCenterY\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sGradientGradientRadius\n        shown_name = \"sGradientGradientR\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.sGradientStartColor\n        shown_name = \"sGradientStartColo\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sGradientCenterColor\n        shown_name = \"sGradientCenterCol\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sGradientEndColor\n        shown_name = \"sGradientEndColor\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.sGradientUseLevel\n        shown_name = \"sGradientUseLevel\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.sUseSelector\n        shown_name = \"sUseSelector\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.sGradientType\n        shown_name = \"sGradientType\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = linear\n            shown_name = \"linear\"\n        }\n        item\n        {\n            name = radial\n            shown_name = \"radial\"\n        }\n        item\n        {\n            name = sweep\n            shown_name = \"sweep\"\n        }\n    }\n}">
