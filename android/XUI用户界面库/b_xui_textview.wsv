类 XUI展开更多文本框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.textview.ReadMoreTextView)."
        @文档 = "category = \"XUI.文本\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.textview.ReadMoreTextView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.rmtv_trimExpandedText\n        shown_name = \"展开显示的文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.rmtv_trimCollapsedText\n        shown_name = \"折叠显示的文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.rmtv_ellipsize\n        shown_name = \"文字过长显示符号\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.rmtv_showTrimExpandedText\n        shown_name = \"是否显示展开的文字\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.rmtv_colorClickableText\n        shown_name = \"折叠/展开按钮文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.rmtv_trimLines\n        shown_name = \"最多显示的行数\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.rmtv_trimLength\n        shown_name = \"最多显示的字符串长度\"\n        data_type = int\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUI展开更多文本框, ReadMoreTextView, com.xuexiang.xui.widget.textview.ReadMoreTextView)

