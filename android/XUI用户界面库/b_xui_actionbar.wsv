<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.XUI <注释 = "XUI 安卓 UI 工具库封装" @文档 = "category = \"XUI\"">


类 XUI标题栏 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.actionbar.TitleBar)."
        @文档 = "category = \"XUI.标题栏\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.actionbar.TitleBar\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.tb_barHeight\n        shown_name = \"标题栏的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_immersive\n        shown_name = \"是否是沉浸式标题栏\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.tb_actionPadding\n        shown_name = \"左右图标和文字的padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_sideTextPadding\n        shown_name = \"标题栏两侧控件的padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_sideTextColor\n        shown_name = \"标题栏左侧文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tb_titleTextColor\n        shown_name = \"标题栏标题文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tb_subTitleTextColor\n        shown_name = \"标题栏副标题文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tb_actionTextColor\n        shown_name = \"标题栏右侧文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tb_centerGravity\n        shown_name = \"中间title的对齐方式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = center\n            shown_name = \"center\"\n        }\n        item\n        {\n            name = left\n            shown_name = \"left\"\n        }\n        item\n        {\n            name = right\n            shown_name = \"right\"\n        }\n    }\n    attr\n    {\n        name = app.tb_sideTextSize\n        shown_name = \"标题栏左侧文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_titleTextSize\n        shown_name = \"标题栏标题文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_subTitleTextSize\n        shown_name = \"标题栏副标题文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_actionTextSize\n        shown_name = \"标题栏右侧文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_leftImageResource\n        shown_name = \"文字的内容以及图标内容\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.tb_leftText\n        shown_name = \"标题栏左侧的文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.tb_titleText\n        shown_name = \"标题栏标题的文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.tb_subTitleText\n        shown_name = \"标题栏副标题的文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.tb_dividerColor\n        shown_name = \"标题栏分割线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tb_dividerHeight\n        shown_name = \"标题栏分割线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tb_useThemeColor\n        shown_name = \"标题栏背景色是否使用主题颜色\"\n        data_type = boolean\n    }\n}">
{
