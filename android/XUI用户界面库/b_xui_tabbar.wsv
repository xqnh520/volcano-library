类 XUI多标签控件 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.tabbar.MultiTabControlView)."
        @文档 = "category = \"XUI.标签栏\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.tabbar.MultiTabControlView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.tcv_textSize\n        shown_name = \"文字字体的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tcv_unselectedTextColor\n        shown_name = \"没选中的文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tcv_selectedTextColor\n        shown_name = \"选中的文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tcv_unselectedColor\n        shown_name = \"没选中的背景颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tcv_selectedColor\n        shown_name = \"选中的背景颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.tcv_strokeWidth\n        shown_name = \"边框宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tcv_item_padding\n        shown_name = \"选项卡间的padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tcv_item_padding_horizontal\n        shown_name = \"选项卡水平间的padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tcv_item_padding_vertical\n        shown_name = \"选项卡垂直间的padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.tcv_equalWidth\n        shown_name = \"是否等宽显示\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.tcv_stretch\n        shown_name = \"是否伸展开\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.tcv_defaultSelection\n        shown_name = \"默认选中项的索引\"\n        data_type = int\n    }\n}">
