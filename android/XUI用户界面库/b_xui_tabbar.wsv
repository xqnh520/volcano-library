<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.XUI <注释 = "XUI 安卓 UI 工具库封装" @文档 = "category = \"XUI\"">


类 XUI简易指示器 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.tabbar.EasyIndicator)."
        @文档 = "category = \"XUI.标签栏\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.tabbar.EasyIndicator\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.indicator_width\n        shown_name = \"指示器\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_height\n        shown_name = \"指示器的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_background\n        shown_name = \"指示器（2）\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.indicator_textSize\n        shown_name = \"指示器文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_select_textSize\n        shown_name = \"指示器选中时文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_selected_color\n        shown_name = \"指示器选中时的背景颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.indicator_normal_color\n        shown_name = \"指示器未选中时的背景颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.indicator_line_show\n        shown_name = \"是否显示底部指示器\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.indicator_line_height\n        shown_name = \"指示器底部的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_line_width\n        shown_name = \"指示器底部的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_line_color\n        shown_name = \"指示器指示线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.indicator_line_res\n        shown_name = \"指示器指示线的资源\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.indicator_bottom_line_color\n        shown_name = \"指示器底部指示线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.indicator_bottom_line_height\n        shown_name = \"指示器底部指示线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_vertical_line_w\n        shown_name = \"指示器垂直分割线的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_vertical_line_h\n        shown_name = \"指示器垂直分割线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.indicator_vertical_line_color\n        shown_name = \"指示器垂直分割线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUI简易指示器, EasyIndicator, com.xuexiang.xui.widget.tabbar.EasyIndicator)

    方法 取原生对象 <公开 类型 = 对象类 注释 = "返回底层原生对象，供调用未封装的方法。" @嵌入式方法 = "">
