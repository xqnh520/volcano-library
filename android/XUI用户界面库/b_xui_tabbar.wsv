类 XUI垂直标签布局 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.tabbar.VerticalTabLayout)."
        @文档 = "category = \"XUI.标签栏\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.tabbar.VerticalTabLayout\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.vtl_indicator_color\n        shown_name = \"指示器的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.vtl_indicator_width\n        shown_name = \"指示器的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.vtl_indicator_corners\n        shown_name = \"指示器圆角角度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.vtl_indicator_gravity\n        shown_name = \"指示器的对齐方式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = left\n            shown_name = \"left\"\n        }\n        item\n        {\n            name = right\n            shown_name = \"right\"\n        }\n        item\n        {\n            name = fill\n            shown_name = \"fill\"\n        }\n    }\n    attr\n    {\n        name = app.vtl_tab_margin\n        shown_name = \"tab间的空隙\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.vtl_tab_mode\n        shown_name = \"tab的模式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = fixed\n            shown_name = \"fixed\"\n        }\n        item\n        {\n            name = scrollable\n            shown_name = \"scrollable\"\n        }\n    }\n    attr\n    {\n        name = app.vtl_tab_height\n        shown_name = \"tab的高度\"\n        data_type = double\n        detail_type = dim\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUI垂直标签布局, VerticalTabLayout, com.xuexiang.xui.widget.tabbar.VerticalTabLayout)

