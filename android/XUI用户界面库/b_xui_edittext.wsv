类 XUI多行编辑框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.edittext.MultiLineEditText)."
        @文档 = "category = \"XUI.编辑框\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.edittext.MultiLineEditText\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.mlet_maxCount\n        shown_name = \"最大输入文字的数目\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.mlet_ignoreCnOrEn\n        shown_name = \"是否忽略中英文的差异\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.mlet_hintText\n        shown_name = \"输入框提示文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.mlet_hintTextColor\n        shown_name = \"输入框提示文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.mlet_contentPadding\n        shown_name = \"输入框的padding\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.mlet_contentBackground\n        shown_name = \"输入框背景\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.mlet_contentText\n        shown_name = \"输入框的内容\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.mlet_contentTextSize\n        shown_name = \"输入框文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.mlet_contentTextColor\n        shown_name = \"输入框文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.mlet_contentViewHeight\n        shown_name = \"输入框的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.mlet_isFixHeight\n        shown_name = \"输入框的高度是否是固定高度\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.mlet_showSurplusNumber\n        shown_name = \"统计数字显示剩余数目\"\n        data_type = boolean\n    }\n}">
