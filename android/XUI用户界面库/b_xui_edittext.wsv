        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.edittext.verify.VerifyCodeEditText\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.vcet_number\n        shown_name = \"输入框的数量\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.vcet_width\n        shown_name = \"每一个输入框的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.vcet_is_divide_equally\n        shown_name = \"平分每个输入框的宽度\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.vcet_text_color\n        shown_name = \"输入框文字颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.vcet_text_size\n        shown_name = \"输入框文字大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.vcet_bg_focus\n        shown_name = \"输入框获取焦点时背景\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.vcet_bg_normal\n        shown_name = \"输入框没有焦点时背景\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.vcet_is_pwd\n        shown_name = \"是否是密码模式\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.vcet_pwd_radius\n        shown_name = \"密码模式时\"\n        data_type = double\n        detail_type = dim\n    }\n}">
