类 XUIMaterial编辑框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.edittext.materialedittext.MaterialEditText)."
        @文档 = "category = \"XUI.编辑框\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.edittext.materialedittext.MaterialEditText\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.met_baseColor\n        shown_name = \"线和文字的基础颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_primaryColor\n        shown_name = \"高亮样式的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_floatingLabel\n        shown_name = \"悬浮提示文字的样式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = none\n            shown_name = \"none\"\n        }\n        item\n        {\n            name = normal\n            shown_name = \"normal\"\n        }\n        item\n        {\n            name = highlight\n            shown_name = \"highlight\"\n        }\n    }\n    attr\n    {\n        name = app.met_errorColor\n        shown_name = \"出现错误时文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_allowEmpty\n        shown_name = \"是否允许输入为空\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_errorEmpty\n        shown_name = \"为空的错误提示\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.met_minCharacters\n        shown_name = \"最少文字的限制\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.met_maxCharacters\n        shown_name = \"最多文字的限制\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.met_singleLineEllipsis\n        shown_name = \"底部文字是否显示单行\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_minBottomTextLines\n        shown_name = \"底部文字最小的行数\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.met_helperText\n        shown_name = \"在底部的辅助文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.met_helperTextColor\n        shown_name = \"辅助文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_accentTypeface\n        shown_name = \"强调文字的字体\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.met_typeface\n        shown_name = \"输入框字体\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.met_floatingLabelText\n        shown_name = \"自定义悬浮提示文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.met_floatingLabelPadding\n        shown_name = \"输入框文字与悬浮提示文字的间距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.met_hideUnderline\n        shown_name = \"隐藏底线\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_underlineColor\n        shown_name = \"输入框底线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_underlineHeight\n        shown_name = \"输入框底线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.met_underlineHeightFocused\n        shown_name = \"输入框聚焦时底线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.met_autoValidate\n        shown_name = \"是否自动校验\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_iconLeft\n        shown_name = \"左侧图标资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.met_iconRight\n        shown_name = \"右侧图标资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.met_iconPadding\n        shown_name = \"图标与输入区域的距离\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.met_clearButton\n        shown_name = \"是否使用清除按钮\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_passWordButton\n        shown_name = \"是否使用显示密码按钮\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_isAsteriskStyle\n        shown_name = \"密码输入框文字的样式是否是“*”\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_floatingLabelTextSize\n        shown_name = \"悬浮提示文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.met_floatingLabelTextColor\n        shown_name = \"悬浮提示文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_bottomTextSize\n        shown_name = \"底部提示文字的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.met_floatingLabelAlwaysShown\n        shown_name = \"悬浮提示一直显示\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_helperTextAlwaysShown\n        shown_name = \"是否一直显示辅助性文字\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_floatingLabelAnimating\n        shown_name = \"是否使用动画显示悬浮提示\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_textColor\n        shown_name = \"输入文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_textColorHint\n        shown_name = \"提示文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.met_validateOnFocusLost\n        shown_name = \"是否失去焦点后自动校验\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_checkCharactersCountAtBeginning\n        shown_name = \"是否在文字显示的时候开始计算文字的数\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.met_regexp\n        shown_name = \"校验的正则表达式\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.met_errorMessage\n        shown_name = \"校验不通过的提示信息\"\n        data_type = string\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUIMaterial编辑框, MaterialEditText, com.xuexiang.xui.widget.edittext.materialedittext.MaterialEditText)

