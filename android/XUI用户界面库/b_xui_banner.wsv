类 XUI横幅布局 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.banner.recycler.BannerLayout)."
        @文档 = "category = \"XUI.横幅\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.banner.recycler.BannerLayout\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.bl_interval\n        shown_name = \"轮播间隔\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.bl_showIndicator\n        shown_name = \"是否显示轮播索引\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.bl_orientation\n        shown_name = \"轮播的方向\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = horizontal\n            shown_name = \"horizontal\"\n        }\n        item\n        {\n            name = vertical\n            shown_name = \"vertical\"\n        }\n    }\n    attr\n    {\n        name = app.bl_autoPlaying\n        shown_name = \"是否是自动轮播\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.bl_indicatorSelectedSrc\n        shown_name = \"轮播索引选中的效果\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.bl_indicatorUnselectedSrc\n        shown_name = \"轮播索引未选中的效果\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.bl_indicatorSize\n        shown_name = \"轮播索引的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.bl_indicatorSelectedColor\n        shown_name = \"轮播索引选中的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.bl_indicatorUnselectedColor\n        shown_name = \"轮播索引未选中的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.bl_indicatorSpace\n        shown_name = \"索引器之间的间隔\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.bl_indicatorMarginLeft\n        shown_name = \"索引器的左侧边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.bl_indicatorMarginRight\n        shown_name = \"索引器的右侧边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.bl_indicatorMarginBottom\n        shown_name = \"索引器的底部边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.bl_indicatorGravity\n        shown_name = \"索引器的对齐方式\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = left\n            shown_name = \"left\"\n        }\n        item\n        {\n            name = center\n            shown_name = \"center\"\n        }\n        item\n        {\n            name = right\n            shown_name = \"right\"\n        }\n    }\n    attr\n    {\n        name = app.bl_itemSpace\n        shown_name = \"轮播图之间的间距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.bl_centerScale\n        shown_name = \"图片缩放系数\"\n        data_type = double\n    }\n    attr\n    {\n        name = app.bl_moveSpeed\n        shown_name = \"轮播速度\"\n        data_type = double\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUI横幅布局, BannerLayout, com.xuexiang.xui.widget.banner.recycler.BannerLayout)

    方法 取原生对象 <公开 类型 = 对象类 注释 = "返回底层原生对象，供调用未封装的方法。" @嵌入式方法 = "">
    {
        @ @sn<this>.GetBannerLayout ()
    }

    方法 XUI透明度 <公开 属性读 类型 = 小数 @嵌入式方法 = "" 注释 = "用法：读取XUI横幅布局的XUI透明度当前值。 参数：无。 返回：小数。 原方法：XUI横幅布局.getAlpha()">
