<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.XUI <注释 = "XUI 安卓 UI 工具库封装" @文档 = "category = \"XUI\"">


类 XUI状态视图 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.popupwindow.status.StatusView)."
        @文档 = "category = \"XUI.弹窗\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.popupwindow.status.StatusView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.sv_dismissOnComplete\n        shown_name = \"是否自动隐藏当是完成状态的时候\"\n        data_type = boolean\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUI状态视图, StatusView, com.xuexiang.xui.widget.popupwindow.status.StatusView)

    方法 取原生对象 <公开 类型 = 对象类 注释 = "返回底层原生对象，供调用未封装的方法。" @嵌入式方法 = "">
    {
        @ @sn<this>.GetStatusView ()
    }

    方法 XUI透明度 <公开 属性读 类型 = 小数 @嵌入式方法 = "" 注释 = "用法：读取XUI状态视图的XUI透明度当前值。 参数：无。 返回：小数。 原方法：XUI状态视图.getAlpha()">
    {
        @ (double)@sn<this>.GetStatusView ().getAlpha ()
    }

    方法 XUI透明度 <公开 属性写 注释 = "用法：设置XUI状态视图的XUI透明度, 传入新值后立刻生效。 参数：新值=小数。 返回：无。 原方法：XUI状态视图.setAlpha()">
    参数 新值 <类型 = 小数>
    {
        @ @m<RUN_UI_ACTION> (GetStatusView ().setAlpha ((float) @<新值>))
    }

    方法 XUI启用状态 <公开 属性读 类型 = 逻辑型 @嵌入式方法 = "" 注释 = "用法：读取XUI状态视图的XUI启用状态当前值。 参数：无。 返回：逻辑型。 原方法：XUI状态视图.isEnabled()">
    {
        @ @sn<this>.GetStatusView ().isEnabled ()
    }

    方法 XUI启用状态 <公开 属性写 注释 = "用法：设置XUI状态视图的XUI启用状态, 传入新值后立刻生效。 参数：新值=真/假。 返回：无。 原方法：XUI状态视图.setEnabled()">
    参数 新值 <类型 = 逻辑型>
    {
        @ @m<RUN_UI_ACTION> (GetStatusView ().setEnabled (@<新值>))
    }

