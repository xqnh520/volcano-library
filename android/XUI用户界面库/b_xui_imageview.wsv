类 XUI图标图片框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.imageview.IconImageView)."
        @文档 = "category = \"XUI.图片\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.imageview.IconImageView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.iiv_icon_res\n        shown_name = \"图标的资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.iiv_icon_scale\n        shown_name = \"图标缩放的比例\"\n        data_type = double\n    }\n    attr\n    {\n        name = app.iiv_is_show\n        shown_name = \"图标是否显示\"\n        data_type = boolean\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUI图标图片框, IconImageView, com.xuexiang.xui.widget.imageview.IconImageView)

