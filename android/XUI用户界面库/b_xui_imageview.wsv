类 XUI圆角图片框 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.imageview.RadiusImageView)."
        @文档 = "category = \"XUI.图片\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.imageview.RadiusImageView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.riv_border_width\n        shown_name = \"边框宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.riv_border_color\n        shown_name = \"边框的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.riv_selected_mask_color\n        shown_name = \"选中时\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.riv_selected_border_color\n        shown_name = \"边框选中时的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.riv_selected_border_width\n        shown_name = \"边框选中时的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.riv_corner_radius\n        shown_name = \"圆角的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.riv_is_oval\n        shown_name = \"是否是椭圆形\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.riv_is_circle\n        shown_name = \"图片是否是圆形的\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.riv_is_touch_select_mode_enabled\n        shown_name = \"图片是否可触摸选中\"\n        data_type = boolean\n    }\n}">
