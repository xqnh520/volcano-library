<火山程序 类型 = "通常" 版本 = 1 />

包 火山.安卓.XUI <注释 = "XUI 安卓 UI 工具库封装" @文档 = "category = \"XUI\"">


类 XUIMaterial搜索视图 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.searchview.MaterialSearchView)."
        @文档 = "category = \"XUI.搜索\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.searchview.MaterialSearchView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.msv_searchBackground\n        shown_name = \"搜索框背景资源的id\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.msv_searchVoiceIcon\n        shown_name = \"语音按钮图标的资源id\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.msv_searchClearIcon\n        shown_name = \"清空按钮图标的资源id\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.msv_searchBackIcon\n        shown_name = \"返回按钮图标的资源id\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.msv_searchSuggestionIcon\n        shown_name = \"搜索提示图标的资源id\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.msv_searchSuggestionBackground\n        shown_name = \"搜索提示的背景资源的id\"\n        data_type = int\n    }\n}">
{
    # @ @m<DEFINE_CONTROL2> (XUIMaterial搜索视图, MaterialSearchView, com.xuexiang.xui.widget.searchview.MaterialSearchView)

    方法 取原生对象 <公开 类型 = 对象类 注释 = "返回底层原生对象，供调用未封装的方法。" @嵌入式方法 = "">
    {
        @ @sn<this>.GetMaterialSearchView ()
    }

