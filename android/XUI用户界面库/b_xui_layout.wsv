类 XUI按钮 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.layout.XUIButton)."
        @文档 = "category = \"XUI.布局\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.layout.XUIButton\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.xui_bottomDividerHeight\n        shown_name = \"底部分割线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_bottomDividerColor\n        shown_name = \"底部分割线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xui_bottomDividerInsetLeft\n        shown_name = \"底部分割线左侧的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_bottomDividerInsetRight\n        shown_name = \"底部分割线右侧的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_topDividerHeight\n        shown_name = \"顶部分割线的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_topDividerColor\n        shown_name = \"顶部分割线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xui_topDividerInsetLeft\n        shown_name = \"顶部分割线左侧的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_topDividerInsetRight\n        shown_name = \"顶部分割线右侧的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_leftDividerWidth\n        shown_name = \"左侧分割线的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_leftDividerColor\n        shown_name = \"左侧分割线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xui_leftDividerInsetTop\n        shown_name = \"左侧分割线顶部的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_leftDividerInsetBottom\n        shown_name = \"左侧分割线底部的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_rightDividerWidth\n        shown_name = \"右侧分割线的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_rightDividerColor\n        shown_name = \"右侧分割线的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xui_rightDividerInsetTop\n        shown_name = \"右侧分割线顶部的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_rightDividerInsetBottom\n        shown_name = \"右侧分割线底部的边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_radius\n        shown_name = \"圆角度数\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_borderColor\n        shown_name = \"边框颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xui_borderWidth\n        shown_name = \"边框宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_outerNormalColor\n        shown_name = \"21版本下\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.xui_hideRadiusSide\n        shown_name = \"隐藏圆角的类型\"\n        data_type = string\n        detail_type = enum\n        item\n        {\n            name = none\n            shown_name = \"none\"\n        }\n        item\n        {\n            name = top\n            shown_name = \"top\"\n        }\n        item\n        {\n            name = right\n            shown_name = \"right\"\n        }\n        item\n        {\n            name = bottom\n            shown_name = \"bottom\"\n        }\n        item\n        {\n            name = left\n            shown_name = \"left\"\n        }\n    }\n    attr\n    {\n        name = app.xui_showBorderOnlyBeforeL\n        shown_name = \"是否显示边框\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.xui_shadowElevation\n        shown_name = \"阴影的大小\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_useThemeGeneralShadowElevation\n        shown_name = \"是否使用主题的阴影大小\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.xui_shadowAlpha\n        shown_name = \"阴影的透明度\"\n        data_type = double\n    }\n    attr\n    {\n        name = app.xui_outlineInsetTop\n        shown_name = \"轮廓的顶部边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_outlineInsetLeft\n        shown_name = \"轮廓的左侧边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_outlineInsetRight\n        shown_name = \"轮廓的右侧边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_outlineInsetBottom\n        shown_name = \"轮廓的底部边距\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.xui_outlineExcludePadding\n        shown_name = \"轮廓是否使用内边距\"\n        data_type = boolean\n    }\n}">
