类 XUI按钮视图 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.button.ButtonView)."
        @文档 = "category = \"XUI.按钮\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.button.ButtonView\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.textSolidColor\n        shown_name = \"按钮的填充颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.textSelectedSolidColor\n        shown_name = \"按钮的选中颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.textStrokeColor\n        shown_name = \"按钮的边框颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.textStrokeWidth\n        shown_name = \"按钮的边框的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.textRadius\n        shown_name = \"按钮的边角角度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.textLeftTopRadius\n        shown_name = \"textLeftTopRadius\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.textLeftBottomRadius\n        shown_name = \"textLeftBottomRadi\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.textRightTopRadius\n        shown_name = \"textRightTopRadius\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.textRightBottomRadius\n        shown_name = \"textRightBottomRad\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.textDrawable\n        shown_name = \"按钮的图标\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.textNormalTextColor\n        shown_name = \"按钮的文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.textSelectedTextColor\n        shown_name = \"按钮的文字点击时的颜色\"\n        data_type = string\n        detail_type = color\n    }\n}">
