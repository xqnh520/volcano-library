类 XUI开关按钮 <公开 基础类 = 窗口组件 注释 = "★ 本类封装自 XUI 1.2.2 (com.xuexiang.xui.widget.button.switchbutton.SwitchButton)."
        @文档 = "category = \"XUI.按钮\""
        @安卓.窗口组件.布局配置 = "native_class = com.xuexiang.xui.widget.button.switchbutton.SwitchButton\ncategory = \"XUI组件\"\ndefault_event = \"被单击\"\nself\n{\n    attr\n    {\n        name = app.swb_thumbDrawable\n        shown_name = \"滑动块的图片资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.swb_thumbColor\n        shown_name = \"滑动块的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.swb_thumbMargin\n        shown_name = \"滑动块的Margin\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_thumbMarginTop\n        shown_name = \"thumbMarginTop\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_thumbMarginBottom\n        shown_name = \"thumbMarginBottom\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_thumbMarginLeft\n        shown_name = \"thumbMarginLeft\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_thumbMarginRight\n        shown_name = \"thumbMarginRight\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_thumbWidth\n        shown_name = \"滑动块的宽度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_thumbHeight\n        shown_name = \"滑动块的高度\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_thumbRadius\n        shown_name = \"滑动块的边角\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_backRadius\n        shown_name = \"开关背景的边角\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_backDrawable\n        shown_name = \"开关的背景图片资源\"\n        data_type = string\n        detail_type = drawable_res_file\n    }\n    attr\n    {\n        name = app.swb_backColor\n        shown_name = \"开关的背景颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.swb_fadeBack\n        shown_name = \"当开关进行切换的时候\"\n        data_type = boolean\n    }\n    attr\n    {\n        name = app.swb_thumbRangeRatio\n        shown_name = \"开关和滑动块所占宽度的比例\"\n        data_type = double\n    }\n    attr\n    {\n        name = app.swb_animationDuration\n        shown_name = \"切换时\"\n        data_type = int\n    }\n    attr\n    {\n        name = app.swb_tintColor\n        shown_name = \"提示文字的颜色\"\n        data_type = string\n        detail_type = color\n    }\n    attr\n    {\n        name = app.swb_textOn\n        shown_name = \"开关开时的文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.swb_textOff\n        shown_name = \"开关关时的文字\"\n        data_type = string\n    }\n    attr\n    {\n        name = app.swb_textThumbInset\n        shown_name = \"textThumbInset\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_textExtra\n        shown_name = \"文字多余的空间\"\n        data_type = double\n        detail_type = dim\n    }\n    attr\n    {\n        name = app.swb_textAdjust\n        shown_name = \"textAdjust\"\n        data_type = double\n        detail_type = dim\n    }\n}">
