        @java.后缀文本 = "implements com.xuexiang.xui.widget.picker.widget.listener.OnOptionsSelectListener">
{
    # @begin
    # @Override public boolean onOptionsSelect (android.view.View v, int option1, int option2, int option3) {
    #     return (@<选项被选择> (option1, option2, option3) != 0);
    # }
    # @end

    方法 选项被选择 <公开 定义事件 类型 = 整数 注释 = "点击“确定”时触发；返回非0表示确认，返回0表示取消。">
    参数 选项1 <类型 = 整数 注释 = "第1列当前选中项索引（从0开始）。">
    参数 选项2 <类型 = 整数 注释 = "第2列当前选中项索引。">
    参数 选项3 <类型 = 整数 注释 = "第3列当前选中项索引。">
}


